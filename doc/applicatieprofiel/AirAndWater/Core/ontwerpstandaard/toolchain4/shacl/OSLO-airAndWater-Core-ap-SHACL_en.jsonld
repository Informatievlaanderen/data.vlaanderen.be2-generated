      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "Eg a Slice through a set of life expectancy figures could be a subset for gender=male which would allow eg to explore the regional variation of the life expectancy for this particular gender (and compare this variation with that of another Slice for gender=female).  For a more detailed description of this class see the W3C Data Cube Ontology."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Denotes a subset of a DataSet defined by fixing all but one (or a small subset) of the dimensional values, component properties on the Slice."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
