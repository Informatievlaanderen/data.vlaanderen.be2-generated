    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "Sensors respond to a stimulus, eg a change in the environment, or Input data composed from the results of prior Observations, and generate a result. Sensors can be hosted by Platforms. Examples: accelerometers, gyroscopes, barameters, magnetometers etc, typically mounted on a smartphone (which acts as Platform). Other examples include the human eyes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure to make an Observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
