@prefix dc: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#> rdfs:member <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecordShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusResourceShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DistributieShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DataserviceShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#JuridischeBepalingShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#PlaatsShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#HerkomstVerklaringShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#VoorbeeldweergaveShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerieShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#RechtsgrondShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#StandaardShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#LicentieDocumentShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#AgentShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#RelatieQualificatieShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#TijdsperiodeShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#FrequentieShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#StringShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#IdentificatorShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatetimeShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#ContactinfoShape>,
    <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#ContactpuntShape> .

<https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een agent kan op verschillende wijzen interageren met de beschreven entiteiten. Voorbeelden zijn beheerder, uitgever, maker, enz."@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de kardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "De naam van de agent."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Agent.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de agent."@nl;
    shacl:maxCount "n";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path foaf:name
  ];
  shacl:targetClass dc:Agent .

<https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecordShape> a shacl:NodeShape;
  rdfs:label "Catalogus Record"@nl;
  <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://www.w3.org/TR/vocab-dcat-3#Class:Catalog_Record\">DCAT</a>]."@nl;
  rdfs:comment "Een record in een catalogus beschrijft de registratie van één resource in de catalogus."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator van het record in de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Identificator>;
    shacl:description "De unieke identificator van het record in de catalogus."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanmaakdatum"@nl;
    rdfs:comment "De datum van (formele) opname van de bijbehorende dataset of dataservice in de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Aanmaakdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum van (formele) opname van de bijbehorende dataset of dataservice in de catalogus."@nl;
    shacl:maxCount "1";
    shacl:name "aanmaakdatum"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de kardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "De naam van het record in de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van het record in de catalogus."@nl;
    shacl:maxCount "n";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "wijzigingsdatum"@nl;
    rdfs:comment "De meest recente datum waarop het record in de catalogus is gewijzigd, bijgewerkt of aangepast."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Wijzigingsdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De meest recente datum waarop het record in de catalogus is gewijzigd, bijgewerkt of aangepast."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "wijzigingsdatum"@nl;
    shacl:path dc:modified
  ], [
    a shacl:PropertyShape;
    rdfs:label "bron metadata record landingspagina"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik bij voorkeur de eigenschap ‘bron-metadatarecord’ om een machineleesbare vorm te delen."@nl;
    rdfs:comment "Een webpagina waarop het bron-metadatarecord in menselijk leesbare vorm wordt weergegeven."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.BronMetadataRecordLandingspagina>;
    shacl:class rdfs:Resource;
    shacl:description "Een webpagina waarop het bron-metadatarecord in menselijk leesbare vorm wordt weergegeven."@nl;
    shacl:maxCount "1";
    shacl:name "bron metadata record landingspagina"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#bronMetadataRecordLandingspagina>
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    rdfs:comment "Een alternatieve identificator (een andere identificator dan de unieke identificator) voor een record in de catalogus kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (een andere identificator dan de unieke identificator) voor een record in de catalogus kan hier beschreven worden."@nl;
    shacl:maxCount "n";
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "conform"@nl;
    <http://purl.org/vocab/vann/usageNote> "Eén van de URIs voor erkende metadata standaarden: <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat\">metadata DCAT</a>, <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL\">DCAT-AP Vlaanderen</a> of <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL\">GeoDCAT-AP Vlaanderen</a>."@nl;
    rdfs:comment "De (meta)datastandaard volgens welke het hoofdonderwerp van het catalogusrecord is beschreven."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Conform>;
    shacl:class dc:Standard;
    shacl:description "De (meta)datastandaard volgens welke het hoofdonderwerp van het catalogusrecord is beschreven."@nl;
    shacl:maxCount "n";
    shacl:name "conform"@nl;
    shacl:path dc:conformsTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "bron metadatarecord"@nl;
    rdfs:comment "Het record in een andere catalogus waarvan deze record en de beschrijvingen van het bijhorende hoofdonderwerp van afgeleid zijn."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.BronMetadatarecord>;
    shacl:class rdfs:Resource;
    shacl:description "Het record in een andere catalogus waarvan deze record en de beschrijvingen van het bijhorende hoofdonderwerp van afgeleid zijn."@nl;
    shacl:maxCount "1";
    shacl:name "bron metadatarecord"@nl;
    shacl:path dc:source
  ], [
    a shacl:PropertyShape;
    rdfs:label "hoofdonderwerp"@nl;
    rdfs:comment "De resource (dataset of dataservice) beschreven in het record."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Hoofdonderwerp>;
    shacl:description "De resource (dataset of dataservice) beschreven in het record."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "hoofdonderwerp"@nl;
    shacl:or ([shacl:class dcat:Resource] [shacl:class dcat:Dataset] [shacl:class dcat:DataService]);
    shacl:path foaf:primaryTopic
  ];
  shacl:targetClass dcat:CatalogRecord .

<https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusResourceShape> a shacl:NodeShape;
  rdfs:label "Catalogus Resource"@nl;
  <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://www.w3.org/TR/vocab-dcat-3#Class:Resource\">DCAT</a>]."@nl;
  rdfs:comment "Een bron (resource) gepubliceerd of beheerd door één agent."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "uitgever"@nl;
    rdfs:comment "De uitgever van de catalogus (de entiteit die verantwoordelijk is voor het beschikbaar stellen van de catalogus)."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusResource.Uitgever>;
    shacl:class dc:Agent;
    shacl:description "De uitgever van de catalogus (de entiteit die verantwoordelijk is voor het beschikbaar stellen van de catalogus)."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "uitgever"@nl;
    shacl:path dc:publisher
  ], [
    a shacl:PropertyShape;
    rdfs:label "relatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "[zie <a href=\"https://www.w3.org/TR/vocab-dcat-3/\">DCAT</a>]."@nl;
    rdfs:comment "Een verband tussen twee resources."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusResource.Relatie>;
    shacl:description "Een verband tussen twee resources."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "relatie"@nl;
    shacl:or ([shacl:class dcat:Resource] [shacl:class dcat:Dataset] [shacl:class dcat:DataService]);
    shacl:path dc:relation
  ];
  shacl:targetClass dcat:Resource,
    dcat:Dataset,
    dcat:DataService .

<https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusShape> a shacl:NodeShape;
  rdfs:label "Catalogus"@nl;
  <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://www.w3.org/TR/vocab-dcat-3#Class:Catalog\">DCAT</a>]."@nl;
  rdfs:comment "Een beheerde verzameling van metadata over resources (zoals datasets en dataservices in de context van een datacatalogus)."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator voor de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Identificator>;
    shacl:description "De unieke identificator voor de catalogus."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de kardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "De naam van de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de catalogus."@nl;
    shacl:maxCount "n";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de kardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "Een bondige tekstuele omschrijving van de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een bondige tekstuele omschrijving van de catalogus."@nl;
    shacl:maxCount "n";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinformatie"@nl;
    rdfs:comment "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Contactinformatie>;
    shacl:class vcard:Kind;
    shacl:description "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de catalogus."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "contactinformatie"@nl;
    shacl:path dcat:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "licentie"@nl;
    <http://purl.org/vocab/vann/usageNote> """De licentie voor het Vlaams Open Data Portaal is vastgelegd op https://data.vlaanderen.be/id/licentie/creative-commons-zero-verklaring/v1.0 . 
<br/>
Meer informatie zie <a href=\"#wettelijkeinformatie\">hieronder</a>."""@nl;
    rdfs:comment "De licentie van de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Licentie>;
    shacl:class dc:LicenseDocument;
    shacl:description "De licentie van de catalogus."@nl;
    shacl:maxCount "1";
    shacl:name "licentie"@nl;
    shacl:path dc:license
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    rdfs:comment "Een alternatieve identificator (dan de unieke identificator) voor de catalogus kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (dan de unieke identificator) voor de catalogus kan hier beschreven worden."@nl;
    shacl:maxCount "n";
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "record"@nl;
    rdfs:comment "Een record beschrijft de registratie van één enkele dataset of dataservice die onderdeel is van de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Record>;
    shacl:class dcat:CatalogRecord;
    shacl:description "Een record beschrijft de registratie van één enkele dataset of dataservice die onderdeel is van de catalogus."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "record"@nl;
    shacl:path dcat:record
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgever"@nl;
    rdfs:comment "De uitgever van de catalogus (de entiteit die verantwoordelijk is voor het beschikbaar stellen van de catalogus)."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Uitgever>;
    shacl:class dc:Agent;
    shacl:description "De uitgever van de catalogus (de entiteit die verantwoordelijk is voor het beschikbaar stellen van de catalogus)."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "uitgever"@nl;
    shacl:path dc:publisher
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft Dataset"@nl;
    rdfs:comment "Een dataset die deel uitmaakt van de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.HeeftDataset>;
    shacl:class dcat:Dataset;
    shacl:description "Een dataset die deel uitmaakt van de catalogus."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "heeft Dataset"@nl;
    shacl:path dcat:dataset
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft DataService"@nl;
    rdfs:comment "Een dataservice die deel uitmaakt van de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.HeeftDataservice>;
    shacl:class dcat:DataService;
    shacl:description "Een dataservice die deel uitmaakt van de catalogus."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "heeft DataService"@nl;
    shacl:path dcat:service
  ];
  shacl:targetClass dcat:Catalog .

<https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> """De DCAT contactinformatie is gebaseerd op <a href=\"https://www.w3.org/TR/vcard-rdf\">vCard</a>. In het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/#Contactinfo\">generiek basis</a> volgt men de Europese Core Vocabularies.

Om het verband tussen beiden zichtbaar te maken in het UML model, is de generiek-basis Contactinfo als generalisatie van de vCard Contactinfo (DCAT perspectief) opgenomen."""@nl;
  rdfs:comment "Een beschrijving van contactinformatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "e-mail"@nl;
    <http://purl.org/vocab/vann/usageNote> "[Een e-mail adres in de vorm van een mailto URI volgens de standaard <a href=\"https://tools.ietf.org/html/rfc6068\">hier</a>]."@nl;
    rdfs:comment "Het e-mailadres waarmee een gebruiker contact kan opnemen voor informatie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Contactinfo.E-mail>;
    shacl:class rdfs:Resource;
    shacl:description "Het e-mailadres waarmee een gebruiker contact kan opnemen voor informatie."@nl;
    shacl:maxCount "1";
    shacl:name "e-mail"@nl;
    shacl:path vcard:hasEmail
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactpagina"@nl;
    <http://purl.org/vocab/vann/usageNote> "E.g. de webpagina van de servicedesk van de organisatie."@nl;
    rdfs:comment "Een webpagina die ofwel toelaat om contact op te nemen (via b.v. een webformulier) of die informatie bevat hoe men contact kan opnemen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Contactinfo.Contactpagina>;
    shacl:class rdfs:Resource;
    shacl:description "Een webpagina die ofwel toelaat om contact op te nemen (via b.v. een webformulier) of die informatie bevat hoe men contact kan opnemen."@nl;
    shacl:maxCount "1";
    shacl:name "contactpagina"@nl;
    shacl:path foaf:page
  ];
  shacl:targetClass vcard:Kind .

<https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#ContactpuntShape> a shacl:NodeShape;
  rdfs:label "Contactpunt"@nl;
