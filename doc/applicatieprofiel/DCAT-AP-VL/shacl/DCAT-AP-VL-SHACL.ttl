    schema:ContactPoint .

<https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DataserviceShape> a shacl:NodeShape;
  rdfs:label "Dataservice"@nl;
  <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Class:Data_Service\">DCAT</a>]."@nl;
  rdfs:comment "Een verzameling van operaties die ofwel toegang bieden tot één of meer datasets ofwel een dataverwerkingsdoel hebben."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de kardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "Een bondige tekstuele omschrijving van de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een bondige tekstuele omschrijving van de dataservice."@nl;
    shacl:maxCount "n";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "versie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voor dataservices wordt dikwijls <a href=\"https://semver.org/lang/nl/\">semantisch versioneren</a> gebruikt. Bij het deployen van services wordt aangeraden om enkel de major version op te nemen in de endpointURL. De versieinformatie die hier opgegeven wordt komt best overeen met de versie die beschikbaar is in de endpointURL."@nl;
    rdfs:comment "Een unieke aanduiding van een variant van de dataservice door middel van een versienummer of -naam van de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Versie>;
    shacl:datatype xsd:string;
    shacl:description "Een unieke aanduiding van een variant van de dataservice door middel van een versienummer of -naam van de dataservice."@nl;
    shacl:maxCount "1";
    shacl:name "versie"@nl;
    shacl:path dcat:version
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator van de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Identificator>;
    shacl:description "De unieke identificator van de dataservice."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "trefwoord"@nl;
    <http://purl.org/vocab/vann/usageNote> """De meertaligheid is hier verschillend als voor een beschrijvende eigenschap. 
De taal van elk trefwoord moet aangeduid worden. Echter is het niet de verwachting dat elk trefwoord in elke taal vertaald wordt. Ook is het niet zo dat er slechts 1 trefwoord per taal is. Er kunnen (zullen) er meerdere zijn."""@nl;
    rdfs:comment "Een trefwoord of tag die de bron beschrijft."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Trefwoord>;
    shacl:datatype rdf:langString;
    shacl:description "Een trefwoord of tag die de bron beschrijft."@nl;
    shacl:maxCount "n";
    shacl:name "trefwoord"@nl;
    shacl:path dcat:keyword
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de kardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "De naam van de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de dataservice."@nl;
    shacl:maxCount "n";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinformatie"@nl;
    rdfs:comment "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Contactinformatie>;
    shacl:class vcard:Kind;
    shacl:description "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de dataservice."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "contactinformatie"@nl;
    shacl:path dcat:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "endpointURL"@nl;
    <http://purl.org/vocab/vann/usageNote> "Om in lijn te zijn met DCAT-AP is er een waarde verplicht voor de endpointURL. Wanneer het effectieve endpoint URL niet publiekelijk kan gedeeld worden dan kan dit ingevuld worden met ofwel de root URL van het endpoint ofwel een URL waarop men informatie vindt hoe men de waarde kan bekomen."@nl;
    rdfs:comment "De rootlocatie of het primaire endpoint van de dienst (een web-resolvable URI)."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Endpointurl>;
    shacl:class rdfs:Resource;
    shacl:description "De rootlocatie of het primaire endpoint van de dienst (een web-resolvable URI)."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "endpointURL"@nl;
    shacl:path dcat:endpointURL
  ], [
    a shacl:PropertyShape;
    rdfs:label "endpointbeschrijving"@nl;
    rdfs:comment "Een beschrijving van de diensten die beschikbaar zijn via de endpoints, met inbegrip van e.g. hun operaties, parameters."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Endpointbeschrijving>;
    shacl:class rdfs:Resource;
    shacl:description "Een beschrijving van de diensten die beschikbaar zijn via de endpoints, met inbegrip van e.g. hun operaties, parameters."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "endpointbeschrijving"@nl;
    shacl:path dcat:endpointDescription
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina"@nl;
    rdfs:comment "Een algemene webpagina waarnaar kan worden genavigeerd in een webbrowser, met algemene aanvullende informatie over de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Landingspagina>;
    shacl:class rdfs:Resource;
    shacl:description "Een algemene webpagina waarnaar kan worden genavigeerd in een webbrowser, met algemene aanvullende informatie over de dataservice."@nl;
    shacl:maxCount "n";
    shacl:name "landingspagina"@nl;
    shacl:path dcat:landingPage
  ], [
    a shacl:PropertyShape;
    rdfs:label "ontwikkelingstoestand"@nl;
    <http://purl.org/vocab/vann/usageNote> "Op verschillende momenten tijdens de ontwikkeling van een dataservice wordt de dataservice geëvalueerd."@nl;
    rdfs:comment "De ontwikkelingstoestand waarin de dataservice is gedeployed."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Ontwikkelingstoestand>;
    shacl:class skos:Concept;
    shacl:description "De ontwikkelingstoestand waarin de dataservice is gedeployed."@nl;
    shacl:maxCount "1";
    shacl:name "ontwikkelingstoestand"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#ontwikkelingstoestand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina voor authenticatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap capteert een onderdeel van de beschrijvende informatie over de service beschreven in de landingspagina. Enkel te gebruiken indien men kan verwijzen naar een sectie of een aparte pagina waar deze specifieke informatie beschikbaar is."@nl;
    rdfs:comment "Een verwijzing naar de landingspagina met de specifieke informatie over de authenticatie voor de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.LandingspaginaVoorAuthenticatie>;
    shacl:class rdfs:Resource;
    shacl:description "Een verwijzing naar de landingspagina met de specifieke informatie over de authenticatie voor de dataservice."@nl;
    shacl:maxCount "1";
    shacl:name "landingspagina voor authenticatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#landingspaginaVoorAuthenticatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "levensfase"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het gebruik hiervan is voornamelijk belangrijk wanneer men de dataservice wil uit dienst nemen. Het tijdig aangeven dat een dienst op zijn einde loopt en dat de gebruiker moet overschakelen op de nieuwe dienst is een best practice in service management."@nl;
    rdfs:comment "De levensfase waarin de dataservice zich bevindt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Levensfase>;
    shacl:class skos:Concept;
    shacl:description "De levensfase waarin de dataservice zich bevindt."@nl;
    shacl:maxCount "1";
    shacl:name "levensfase"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#levensfase>
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina voor statusinformatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap capteert een onderdeel van de beschrijvende informatie over de service beschreven in de landingspagina. Enkel te gebruiken indien men kan verwijzen naar een sectie of een aparte pagina waar deze specifieke informatie beschikbaar is."@nl;
    rdfs:comment "Een verwijzing naar de statuspagina van de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.LandingspaginaVoorStatusinformatie>;
    shacl:class rdfs:Resource;
    shacl:description "Een verwijzing naar de statuspagina van de dataservice."@nl;
    shacl:maxCount "1";
    shacl:name "landingspagina voor statusinformatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#landingspaginaVoorStatusinformatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    rdfs:comment "Een alternatieve identificator (een andere identificator dan de unieke identificator) voor een record in de catalogus kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (een andere identificator dan de unieke identificator) voor een record in de catalogus kan hier beschreven worden."@nl;
    shacl:maxCount "n";
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegankelijkheid"@nl;
    <http://purl.org/vocab/vann/usageNote> """Gebruik enkel de waarden PUBLIC en NON_PUBLIC uit de codelijst, waarbij PUBLIC staat voor het gebruiken van de dataservice is zonder voorwaarden, terwijl NON_PUBLIC betekent dat het gebruiken van de dataservice gebonden is aan voorwaarden. 
 
Condities die uitsluitend bedoeld zijn om de correcte werking van de dataservice te waarborgen (zoals het voorkomen van DDoS-aanvallen en oneigenlijk gebruik), bijvoorbeeld via authenticatie en autorisatie, worden niet als toegangsbeperkende voorwaarden beschouwd. Leiden zij echter tot een voorafgaande toetsing (bijv. is de organisatie bekend, is er een betalingscontract afgesloten) voordat toegang wordt verleend, dan zijn dit wel toegangsbeperkende voorwaarden."""@nl;
    rdfs:comment "De toegankelijkheid voor de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Toegankelijkheid>;
    shacl:class skos:Concept;
    shacl:description "De toegankelijkheid voor de dataservice."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "toegankelijkheid"@nl;
    shacl:path dc:accessRights
  ], [
    a shacl:PropertyShape;
    rdfs:label "conform aan protocol"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap capteert de technische specificatie waaraan de service voldoet, e.g. WFS, SPARQL, SOAP…"@nl;
    rdfs:comment "Een protocol waaraan de dataservice voldoet."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.ConformAanProtocol>;
    shacl:class dc:Standard;
    shacl:description "Een protocol waaraan de dataservice voldoet."@nl;
    shacl:maxCount "n";
    shacl:name "conform aan protocol"@nl;
    shacl:path dc:conformsTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "statuut"@nl;
    rdfs:comment "Een aanduiding van op welke basis de catalogusresource beschikbaar is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Statuut>;
    shacl:class skos:Concept;
    shacl:description "Een aanduiding van op welke basis de catalogusresource beschikbaar is."@nl;
    shacl:maxCount "n";
    shacl:name "statuut"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#statuut>
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina voor gebruiksinformatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap capteert een onderdeel van de beschrijvende informatie over de service beschreven in de landingspagina. Enkel te gebruiken indien men kan verwijzen naar een sectie of een aparte pagina waar deze specifieke informatie beschikbaar is."@nl;
    rdfs:comment "Een verwijzing naar de landingspagina met de specifieke informatie over het gebruik van de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.LandingspaginaVoorGebruiksinformatie>;
    shacl:class rdfs:Resource;
    shacl:description "Een verwijzing naar de landingspagina met de specifieke informatie over het gebruik van de dataservice."@nl;
    shacl:maxCount "1";
    shacl:name "landingspagina voor gebruiksinformatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#landingspaginaVoorGebruiksinformatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechten"@nl;
    <http://purl.org/vocab/vann/usageNote> "Met deze eigenschap kunnen rechten uitgedrukt worden zoals copyright of specifieke gebruiksbepalingen. Ook SLA en SLO  informatie kan hier opgenomen worden. Indien deze rechten reeds opgenomen zijn in de licentie dan moeten ze hier niet herhaald worden."@nl;
    rdfs:comment "Bepalingen van juridische aard die gelden op de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Rechten>;
    shacl:class dc:RightsStatement;
    shacl:description "Bepalingen van juridische aard die gelden op de dataservice."@nl;
    shacl:maxCount "n";
    shacl:name "rechten"@nl;
    shacl:path dc:rights
  ], [
    a shacl:PropertyShape;
    rdfs:label "thema"@nl;
    <http://purl.org/vocab/vann/usageNote> "De codelijst is de Belgische thema codelijst, welke 1 op 1 mapbaar is naar de Europese."@nl;
    rdfs:comment "De hoofdcategorie waartoe de dataservice behoort."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Thema>;
    shacl:class skos:Concept;
    shacl:description "De hoofdcategorie waartoe de dataservice behoort."@nl;
    shacl:maxCount "n";
    shacl:name "thema"@nl;
    shacl:path dcat:theme
  ], [
    a shacl:PropertyShape;
    rdfs:label "licentie"@nl;
    rdfs:comment "De licentie van de dataservice."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Licentie>;
    shacl:class dc:LicenseDocument;
    shacl:description "De licentie van de dataservice."@nl;
    shacl:maxCount "1";
    shacl:name "licentie"@nl;
    shacl:path dc:license
  ], [
    a shacl:PropertyShape;
    rdfs:label "creatiedatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de dataservice voor het eerst werd geactiveerd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Creatiedatum>;
    shacl:description "Het tijdsmoment waarop de dataservice voor het eerst werd geactiveerd."@nl;
    shacl:maxCount "1";
    shacl:name "creatiedatum"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:created
  ], [
    a shacl:PropertyShape;
    rdfs:label "wijzigingsdatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de dataservice werd gewijzigd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Wijzigingsdatum>;
    shacl:description "Het tijdsmoment waarop de dataservice werd gewijzigd."@nl;
    shacl:maxCount "1";
    shacl:name "wijzigingsdatum"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:modified
  ], [
    a shacl:PropertyShape;
    rdfs:label "publicatiedatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de dataservice werd gepubliceerd door de uitgever."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Publicatiedatum>;
    shacl:description "Het tijdsmoment waarop de dataservice werd gepubliceerd door de uitgever."@nl;
    shacl:maxCount "1";
    shacl:name "publicatiedatum"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "biedt informatie aan over"@nl;
    rdfs:comment "De data die via deze dataservice worden aangeboden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.BiedtInformatieAanOver>;
    shacl:class dcat:Dataset;
    shacl:description "De data die via deze dataservice worden aangeboden."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "biedt informatie aan over"@nl;
    shacl:path dcat:servesdataset
  ];
  shacl:targetClass dcat:DataService .

<https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerieShape> a shacl:NodeShape;
  rdfs:label "Dataset Serie"@nl;
  <http://purl.org/vocab/vann/usageNote> """In DCAT-AP VL 3.0 worden datasetseries opgevat in hun zuivere betekenis: een verzameling van datasets die dezelfde specificaties delen, waarbij de enige variërende eigenschap typisch ruimte of tijd/versie is. Dit sluit nauw aan bij ISO 19115-1 en INSPIRE, waar een datasetserie wordt gedefinieerd als een collectie datasets met een gemeenschappelijke productspecificatie. Deze zuivere vorm wordt in DCAT-AP VL 3.0 volledig ondersteund. 
<br/>
Daarnaast bestaan in de praktijk verschillende tussenvormen - zoals verzamelingen van datasets over eenzelfde thema, verzamelingen van datasets, series en services, of collecties gebaseerd op bron- of eigenschapsgelijkheid. Deze structuren hebben een grotere “vrijheidsgraad” (variatie in versie, gebied, specificaties, brontypes of eigenschappen) en voldoen daardoor niet aan de formele definitie van datasetseries. Deze tussenvormen worden daarom niet als datasetseries ondersteund, maar wel vindbaar gemaakt via passende DCAT-structuren (bv. thema-gebaseerde groepering of catalogusstructuren). 
<br/>
Voor complexe of expliciet gestructureerde groeperingen is de correcte representatie een (sub)catalogus, waarbij de verbindende eigenschap expliciet door de catalogus zelf wordt bepaald. Subcatalogi worden wél ondersteund in DCAT-AP VL 3.0."""@nl;
  rdfs:comment "Een verzameling die onafhankelijk gepubliceerde datasets groepeert rond gedeelde eigenschappen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een bondige tekstuele bescrhijving van de Dataset Serie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Beschrijving>;
    shacl:description "Een bondige tekstuele bescrhijving van de Dataset Serie."@nl;
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "De naam van de dataset serie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Titel>;
    shacl:description "De naam van de dataset serie."@nl;
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator van de dataset serie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Identificator>;
    shacl:description "De unieke identificator van de dataset serie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinformatie"@nl;
    rdfs:comment "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de Dataset Serie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Contactinformatie>;
    shacl:class vcard:Kind;
    shacl:description "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de Dataset Serie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "contactinformatie"@nl;
    shacl:path dcat:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "belanghebbende wetgeving"@nl;
    rdfs:comment "De wetgeving die aanzet tot het aanmaken of het beheren van de Dataset Serie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.BelanghebbendeWetgeving>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "De wetgeving die aanzet tot het aanmaken of het beheren van de Dataset Serie."@nl;
    shacl:name "belanghebbende wetgeving"@nl;
    shacl:path <http://data.europa.eu/r5r/applicableLegislation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "periodiciteit"@nl;
    <http://purl.org/vocab/vann/usageNote> "De periodiciteit van een dataset serie is niet gelijk aan de periodiciteit van de datasets in de verzameling."@nl;
    rdfs:comment "De maat waarmee de dataset serie wordt bijgewerkt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Periodiciteit>;
    shacl:class dc:Frequency;
    shacl:description "De maat waarmee de dataset serie wordt bijgewerkt."@nl;
    shacl:maxCount "1";
    shacl:name "periodiciteit"@nl;
    shacl:path dc:accrualPeriodicity
  ], [
    a shacl:PropertyShape;
    rdfs:label "publicatie datum"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit is het moment wanneer de dataset serie voor het eerst publiekelijk kenbaar gemaakt is. Het is niet noodzakelijk gekijk aan de publicatie datum van de oudste dataset in de verzameling."@nl;
    rdfs:comment "Het tijdsmoment waarop de dataset serie werd gepubliceerd door de uitgever."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.PublicatieDatum>;
    shacl:description "Het tijdsmoment waarop de dataset serie werd gepubliceerd door de uitgever."@nl;
    shacl:maxCount "1";
    shacl:name "publicatie datum"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "wijzigingsdatum"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit is niet noodzakelijk hetzelfde moment als de meest recente wijzigingsdatum van de datasets die de dataset serie bevat."@nl;
    rdfs:comment "Het meest recente moment waarop de dataset series is bijgewerkt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Wijzigingsdatum>;
    shacl:description "Het meest recente moment waarop de dataset series is bijgewerkt."@nl;
    shacl:maxCount "1";
    shacl:name "wijzigingsdatum"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:modified
  ], [
    a shacl:PropertyShape;
    rdfs:label "geografische dekking"@nl;
    <http://purl.org/vocab/vann/usageNote> "Wanneer geografische dekking een dimensie is in de datasetserie, moet de geografische dekking van elke dataset in de collectie deel uitmaken van de geografisch dekking. Er wordt een waarde met een open einde aanbevolen, b.v. EU of een alomvattende bouding box dat de verwachte waarden bevat."@nl;
    rdfs:comment "Het geografische gebied waarover de dataset serie informatie heeft."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.GeografischeDekking>;
    shacl:class dc:Location;
    shacl:description "Het geografische gebied waarover de dataset serie informatie heeft."@nl;
    shacl:name "geografische dekking"@nl;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "temporele dekking"@nl;
    rdfs:comment "De tijdsperiode die de dataset serie bestrijkt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.TemporeleDekking>;
    shacl:class dc:PeriodOfTime;
    shacl:description "De tijdsperiode die de dataset serie bestrijkt."@nl;
    shacl:name "temporele dekking"@nl;
    shacl:path dc:temporal
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    rdfs:comment "Een alternatieve identificator (dan de unieke identificator) voor een dataset serie kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (dan de unieke identificator) voor een dataset serie kan hier beschreven worden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgever"@nl;
    rdfs:comment "De uitgever, de entiteit die verantwoordelijk is voor het beschikbaar stellen, van de resource in de catalogus."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Uitgever>;
    shacl:class dc:Agent;
    shacl:description "De uitgever, de entiteit die verantwoordelijk is voor het beschikbaar stellen, van de resource in de catalogus."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "uitgever"@nl;
    shacl:path dc:publisher
  ];
  shacl:targetClass dcat:DatasetSeries .

<https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#DatasetShape> a shacl:NodeShape;
  rdfs:label "Dataset"@nl;
  <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://www.w3.org/TR/vocab-dcat-3\">DCAT</a>]."@nl;
  rdfs:comment "Een verzameling gegevens, gepubliceerd of samengesteld door één agent, en beschikbaar voor toegang of download in één of meerdere voorstellingswijzen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "versie"@nl;
    rdfs:comment "Een unieke aanduiding van een variant van de dataset door middel van een versienummer of -naam van de dataset."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Versie>;
    shacl:datatype xsd:string;
    shacl:description "Een unieke aanduiding van een variant van de dataset door middel van een versienummer of -naam van de dataset."@nl;
    shacl:maxCount "1";
    shacl:name "versie"@nl;
    shacl:path dcat:version
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de kardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "Een bondige tekstuele omschrijving van de dataset."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een bondige tekstuele omschrijving van de dataset."@nl;
    shacl:maxCount "n";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "trefwoord"@nl;
    <http://purl.org/vocab/vann/usageNote> """De meertaligheid is hier verschillend als voor een beschrijvende eigenschap. 
De taal van elk trefwoord moet aangeduid worden. Echter is het niet de verwachting dat elk trefwoord in elke taal vertaald wordt. Ook is het niet zo dat er slechts 1 trefwoord per taal is. Er kunnen (zullen) er meerdere zijn."""@nl;
    rdfs:comment "Een trefwoord of tag die de resource beschrijft."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Trefwoord>;
    shacl:datatype rdf:langString;
    shacl:description "Een trefwoord of tag die de resource beschrijft."@nl;
    shacl:maxCount "n";
    shacl:name "trefwoord"@nl;
    shacl:path dcat:keyword
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de kardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "De naam van de dataset."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de dataset."@nl;
    shacl:maxCount "n";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator van de dataset."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Identificator>;
    shacl:description "De unieke identificator van de dataset."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegankelijkheid"@nl;
    <http://purl.org/vocab/vann/usageNote> """Gebruik enkel de waarden PUBLIC en NON_PUBLIC uit de codelijst.
Deze waarden geven een invulling weer voor \"Openbaarheid van Bestuur\".
De waarde NON_PUBLIC geeft aan dat er (wettelijke) beperkingen zijn die verhinderen dat er vrije toegang tot de informatie gegeven wordt. Voorbeelden van zulke beperkingen zijn staatsgeheimen, persoonsgebonden informatie, economische concurrentie, ..."""@nl;
    rdfs:comment "De toegankelijkheid voor de dataset."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Toegankelijkheid>;
    shacl:class skos:Concept;
    shacl:description "De toegankelijkheid voor de dataset."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "toegankelijkheid"@nl;
    shacl:path dc:accessRights
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    rdfs:comment "Een alternatieve identificator (dan de unieke identificator) voor een dataset kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (dan de unieke identificator) voor een dataset kan hier beschreven worden."@nl;
    shacl:maxCount "n";
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "conform"@nl;
    rdfs:comment "Een standaard, schema, applicatieprofiel, vocabularium, CRS, ... waaraan de dataset voldoet."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Conform>;
    shacl:class dc:Standard;
    shacl:description "Een standaard, schema, applicatieprofiel, vocabularium, CRS, ... waaraan de dataset voldoet."@nl;
    shacl:maxCount "n";
    shacl:name "conform"@nl;
    shacl:path dc:conformsTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorbeeldweergave"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een voorbeeldweergave of thumbnail heeft als doel de vindbaarheid van de dataset te verhogen. Het is geen accurate weergave van de data die de dataset bevat."@nl;
    rdfs:comment "Een verkleinde weergave van een afbeelding die de dataset illustreert."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Voorbeeldweergave>;
    shacl:class dcat:Distribution;
    shacl:description "Een verkleinde weergave van een afbeelding die de dataset illustreert."@nl;
    shacl:maxCount "n";
    shacl:name "voorbeeldweergave"@nl;
    shacl:path <http://www.w3.org/ns/adms#sample>
  ], [
    a shacl:PropertyShape;
    rdfs:label "statuut"@nl;
    rdfs:comment "Een aanduiding van op welke basis de catalogusresource beschikbaar is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Statuut>;
    shacl:class skos:Concept;
    shacl:description "Een aanduiding van op welke basis de catalogusresource beschikbaar is."@nl;
    shacl:maxCount "n";
    shacl:name "statuut"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#statuut>
  ], [
    a shacl:PropertyShape;
    rdfs:label "thema"@nl;
    <http://purl.org/vocab/vann/usageNote> "De codelijst is de Belgische thema codelijst, welke 1 op 1 mapbaar is naar de Europese."@nl;
    rdfs:comment "De hoofdcategorie waartoe de dataset behoort."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Thema>;
    shacl:class skos:Concept;
    shacl:description "De hoofdcategorie waartoe de dataset behoort."@nl;
    shacl:maxCount "n";
    shacl:name "thema"@nl;
    shacl:path dcat:theme
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina"@nl;
    <http://purl.org/vocab/vann/usageNote> "De mapping zal de landingspagina invullen met de URL naar de metadata voorstelling waarvan de dataset is afgeleid."@nl;
    rdfs:comment "Een algemene webpagina waarnaar kan worden genavigeerd in een webbrowser, met algemene informatie over de dataset, zijn distributies en/of aanvullende informatie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Landingspagina>;
    shacl:class rdfs:Resource;
    shacl:description "Een algemene webpagina waarnaar kan worden genavigeerd in een webbrowser, met algemene informatie over de dataset, zijn distributies en/of aanvullende informatie."@nl;
    shacl:maxCount "n";
    shacl:name "landingspagina"@nl;
    shacl:path dcat:landingPage
  ], [
    a shacl:PropertyShape;
    rdfs:label "publicatiedatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de dataset werd gepubliceerd door de uitgever."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Publicatiedatum>;
    shacl:description "Het tijdsmoment waarop de dataset werd gepubliceerd door de uitgever."@nl;
    shacl:maxCount "1";
    shacl:name "publicatiedatum"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "herkomst"@nl;
    <http://purl.org/vocab/vann/usageNote> "De verwachte waarde is een webpagina (URL) die de ontstaansgeschiedenis van de dataset beschrijft."@nl;
    rdfs:comment "De ontstaansgeschiedenis van een dataset."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Herkomst>;
    shacl:class dc:ProvenanceStatement;
    shacl:description "De ontstaansgeschiedenis van een dataset."@nl;
    shacl:maxCount "n";
    shacl:name "herkomst"@nl;
    shacl:path dc:provenance
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinformatie"@nl;
    rdfs:comment "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de dataset."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Contactinformatie>;
    shacl:class vcard:Kind;
    shacl:description "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de dataset."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "contactinformatie"@nl;
    shacl:path dcat:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "wijzigingsdatum"@nl;
    <http://purl.org/vocab/vann/usageNote> "[zie <a href=\"https://www.w3.org/TR/vocab-dcat-3/#Property:resource_update_date\">DCAT</a>]."@nl;
    rdfs:comment "Het tijdsmoment waarop de dataset werd geactualiseerd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Wijzigingsdatum>;
    shacl:description "Het tijdsmoment waarop de dataset werd geactualiseerd."@nl;
    shacl:maxCount "1";
    shacl:name "wijzigingsdatum"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:modified
  ], [
    a shacl:PropertyShape;
    rdfs:label "creatiedatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de dataset ontstaan is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Creatiedatum>;
    shacl:description "Het tijdsmoment waarop de dataset ontstaan is."@nl;
    shacl:maxCount "1";
    shacl:name "creatiedatum"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:created
  ], [
    a shacl:PropertyShape;
    rdfs:label "geografische dekking"@nl;
    rdfs:comment "Het geografische gebied waarover de dataset informatie heeft."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.GeografischeDekking>;
    shacl:class dc:Location;
    shacl:description "Het geografische gebied waarover de dataset informatie heeft."@nl;
    shacl:maxCount "n";
    shacl:name "geografische dekking"@nl;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "distributie"@nl;
    rdfs:comment "Een beschikbare distributie van de dataset."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Distributie>;
    shacl:class dcat:Distribution;
    shacl:description "Een beschikbare distributie van de dataset."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "distributie"@nl;
    shacl:path dcat:distribution
  ], [
    a shacl:PropertyShape;
    rdfs:label "eigenaar"@nl;
    <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#dataset-rights-holder\">GeoDCAT-AP</a>]."@nl;
    rdfs:comment "De agent die de eigendomsrechten heeft?"@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Eigenaar>;
    shacl:class dc:Agent;
    shacl:description "De agent die de eigendomsrechten heeft?"@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "eigenaar"@nl;
    shacl:path dc:rightsHolder
  ], [
