  {
    "@id": "_:df_7_59",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Gebruik enkel de waarden PUBLIC en NON_PUBLIC uit de codelijst, waarbij PUBLIC staat voor het gebruiken van de dataservice is zonder voorwaarden, terwijl NON_PUBLIC betekent dat het gebruiken van de dataservice gebonden is aan voorwaarden. \n \nCondities die uitsluitend bedoeld zijn om de correcte werking van de dataservice te waarborgen (zoals het voorkomen van DDoS-aanvallen en oneigenlijk gebruik), bijvoorbeeld via authenticatie en autorisatie, worden niet als toegangsbeperkende voorwaarden beschouwd. Leiden zij echter tot een voorafgaande toetsing (bijv. is de organisatie bekend, is er een betalingscontract afgesloten) voordat toegang wordt verleend, dan zijn dit wel toegangsbeperkende voorwaarden."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De toegankelijkheid voor de dataservice."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "toegankelijkheid"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL/#Dataservice.Toegankelijkheid"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "De toegankelijkheid voor de dataservice."
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@value": "1"
      }
    ],
