{
  "title": "Meter",
  "type": "object",
  "description": "Instrument bedoeld om iets te meten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Meter)",
      "pattern": "^Meter$"
    },
    "fabrikant": {
      "$ref": "#/components/schemas/Meter.fabrikant"
    },
    "model": {
      "$ref": "#/components/schemas/Meter.model"
    },
    "heeftFabrieksnummer": {
      "$ref": "#/components/schemas/Meter.heeftFabrieksnummer"
    },
    "heeftFirmwareVersion": {
      "$ref": "#/components/schemas/Meter.heeftFirmwareVersion"
    },
    "heeftHardwareVersie": {
      "$ref": "#/components/schemas/Meter.heeftHardwareVersie"
    },
    "heeftVersie": {
      "$ref": "#/components/schemas/Meter.heeftVersie"
    },
    "werktopRadiofrequentie": {
      "$ref": "#/components/schemas/Meter.werktopRadiofrequentie"
    },
    "vereistStroom": {
      "$ref": "#/components/schemas/Meter.vereistStroom"
    },
    "identificator": {
      "type": "array",
      "description": "Identificator van de meter. Bijvoorbeeld uniek serienummer van de digitale watermeter. Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "verbruiksadres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    },
    "type": {
      "type": "array",
      "description": "Toestel of Agent (inclusief Personen of software) waarmee Observaties gemaakt worden. Lijst van Systeemtype items.",
      "items": {
        "$ref": "#/components/schemas/Systeemtype"
      },
      "minItems": 1
    },
    "implementeert": {
      "$ref": "#/components/schemas/Observatieprocedure"
    },
    "uitgevoerdeObservatie": {
      "type": "array",
      "description": "Observatie die met de Sensor is uitrgevoerd. Lijst van Observatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Observatie"
          },
          {
            "$ref": "#/components/schemas/IndividueelVerbruikObservatie"
          },
          {
            "$ref": "#/components/schemas/GeaggregeerdVerbruikObservatie"
          },
          {
            "$ref": "#/components/schemas/MeterstaatObservatie"
          },
          {
            "$ref": "#/components/schemas/StatistischeObservatie"
          },
          {
            "$ref": "#/components/schemas/IndividueelVerbruikTijdreeksobservatie"
          },
          {
            "$ref": "#/components/schemas/GeaggregeerdVerbruikTijdreeksobservatie"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Observatie": "#/components/schemas/Observatie",
            "IndividueelVerbruikObservatie": "#/components/schemas/IndividueelVerbruikObservatie",
            "GeaggregeerdVerbruikObservatie": "#/components/schemas/GeaggregeerdVerbruikObservatie",
            "MeterstaatObservatie": "#/components/schemas/MeterstaatObservatie",
            "StatistischeObservatie": "#/components/schemas/StatistischeObservatie",
            "IndividueelVerbruikTijdreeksobservatie": "#/components/schemas/IndividueelVerbruikTijdreeksobservatie",
            "GeaggregeerdVerbruikTijdreeksobservatie": "#/components/schemas/GeaggregeerdVerbruikTijdreeksobservatie"
          }
        }
      },
      "minItems": 1
    },
    "observeert": {
      "type": "array",
      "description": "Kenmerk dat door de Sensor wordt geobserveerd. Lijst van Kenmerktype items.",
      "items": {
        "$ref": "#/components/schemas/Kenmerktype"
      },
      "minItems": 1
    },
    "functie": {
      "type": "array",
      "description": "Tastbaar Object ontworpen om een specifieke Taak mee uit te voeren. Lijst van Functie items.",
      "items": {
        "$ref": "#/components/schemas/Functie"
      },
      "minItems": 1
    },
    "taak": {
      "type": "array",
      "description": "Functie die het Toestel kan uitvoeren met het oog op het uitvoeren van een taak. Lijst van Taak items.",
      "items": {
        "$ref": "#/components/schemas/Taak"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "heeftFabrieksnummer",
    "heeftFirmwareVersion",
    "heeftHardwareVersie",
    "heeftVersie",
    "werktopRadiofrequentie",
    "vereistStroom",
    "identificator",
    "verbruiksadres",
    "implementeert",
    "observeert",
    "functie",
    "taak"
  ]
}