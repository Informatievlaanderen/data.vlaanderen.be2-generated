{
  "title": "MeterZone",
  "type": "object",
  "description": "Delimited geographic area over which aggregated statistics are calculated, within which one or more consumption observation(s) fall.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse MeterZone)",
      "pattern": "^MeterZone$"
    },
    "numberOfMeters": {
      "$ref": "#/components/schemas/MeterZone.numberOfMeters"
    },
    "meterType": {
      "$ref": "#/components/schemas/MeterType"
    },
    "placeName": {
      "$ref": "#/components/schemas/MeterZone.placeName"
    },
    "geometry": {
      "$ref": "#/components/schemas/Geometry"
    },
    "identifier": {
      "$ref": "#/components/schemas/Identifier"
    },
    "type": {
      "$ref": "#/components/schemas/DomainObjectType"
    }
  },
  "required": [
    "@type",
    "numberOfMeters",
    "meterType",
    "identifier"
  ]
}