{
  "title": "Observatieverzameling",
  "type": "object",
  "description": "Collectie van Observaties met dezelfde kenmerken.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Observatieverzameling)",
      "pattern": "^Observatieverzameling$"
    },
    "geobserveerdObject": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Object"
        },
        {
          "$ref": "#/components/schemas/Domeinobject"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Object": "#/components/schemas/Object",
          "Domeinobject": "#/components/schemas/Domeinobject"
        }
      }
    },
    "uitgevoerdMetSensor": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Sensor"
        },
        {
          "$ref": "#/components/schemas/Meter"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Sensor": "#/components/schemas/Sensor",
          "Meter": "#/components/schemas/Meter"
        }
      }
    },
    "geobserveerdKenmerk": {
      "$ref": "#/components/schemas/Kenmerktype"
    },
    "fenomeentijd": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/TemporeleEntiteit"
        },
        {
          "$ref": "#/components/schemas/Moment"
        },
        {
          "$ref": "#/components/schemas/Periode"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "TemporeleEntiteit": "#/components/schemas/TemporeleEntiteit",
          "Moment": "#/components/schemas/Moment",
          "Periode": "#/components/schemas/Periode"
        }
      }
    },
    "resultaatTijd": {
      "$ref": "#/components/schemas/Moment"
    },
    "gebruikteProcedure": {
      "$ref": "#/components/schemas/Observatieprocedure"
    },
    "parameter": {
      "$ref": "#/components/schemas/BenoemdeWaarde"
    },
    "heeftLid": {
      "type": "array",
      "description": "Observatie die deel uitmaakt van de collectie. Lijst van Observatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Observatie"
          },
          {
            "$ref": "#/components/schemas/IndividueelVerbruikObservatie"
          },
          {
            "$ref": "#/components/schemas/GeaggregeerdVerbruikObservatie"
          },
          {
            "$ref": "#/components/schemas/MeterstaatObservatie"
          },
          {
            "$ref": "#/components/schemas/StatistischeObservatie"
          },
          {
            "$ref": "#/components/schemas/IndividueelVerbruikTijdreeksobservatie"
          },
          {
            "$ref": "#/components/schemas/GeaggregeerdVerbruikTijdreeksobservatie"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Observatie": "#/components/schemas/Observatie",
            "IndividueelVerbruikObservatie": "#/components/schemas/IndividueelVerbruikObservatie",
            "GeaggregeerdVerbruikObservatie": "#/components/schemas/GeaggregeerdVerbruikObservatie",
            "MeterstaatObservatie": "#/components/schemas/MeterstaatObservatie",
            "StatistischeObservatie": "#/components/schemas/StatistischeObservatie",
            "IndividueelVerbruikTijdreeksobservatie": "#/components/schemas/IndividueelVerbruikTijdreeksobservatie",
            "GeaggregeerdVerbruikTijdreeksobservatie": "#/components/schemas/GeaggregeerdVerbruikTijdreeksobservatie"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "heeftLid"
  ]
}