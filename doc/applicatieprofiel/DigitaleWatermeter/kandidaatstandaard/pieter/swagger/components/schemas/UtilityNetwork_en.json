{
  "title": "UtilityNetwork",
  "type": "object",
  "description": "Collection of network elements of one type of utility service.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse UtilityNetwork)",
      "pattern": "^UtilityNetwork$"
    },
    "geographicalName": {
      "type": "array",
      "description": "Name by which the network is known. Lijst van LangString items.",
      "items": {
        "$ref": "#/components/schemas/UtilityNetwork.geographicalName"
      },
      "minItems": 1
    },
    "authorityRole": {
      "type": "array",
      "description": "Parties authorized to manage, operate or own the Utility Network. Lijst van Agent items.",
      "items": {
        "$ref": "#/components/schemas/Agent"
      },
      "minItems": 1
    },
    "utilityNetworkType": {
      "$ref": "#/components/schemas/UtilityNetworkTypeValue"
    },
    "supplyArea": {
      "$ref": "#/components/schemas/SupplyArea"
    }
  },
  "required": [
    "@type",
    "authorityRole",
    "utilityNetworkType"
  ]
}