<https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#ActiviteittypeShape> a shacl:NodeShape;
  rdfs:label "ActiviteitType"@nl;
  rdfs:comment "De aard van de activiteit."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Straatnaam vh adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Adresvoorstelling.Straatnaam>;
    shacl:class rdf:langString;
    shacl:description "Straatnaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam vh adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Adresvoorstelling.Gemeentenaam>;
    shacl:class rdf:langString;
    shacl:description "Gemeentenaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Adresvoorstelling.Land>;
    shacl:class rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactInfo"@nl;
    rdfs:comment "Informatie waarmee de Agent gecontacteerd kan worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Agent.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie waarmee de Agent gecontacteerd kan worden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "contactInfo"@nl;
    shacl:path <http://data.europa.eu/m8g/hasContactPoint>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Identificator van het object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Agent.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het object."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#Identifier>
  ];
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#BewijsShape> a shacl:NodeShape;
  rdfs:label "Bewijs"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het kader van publieke dienstverlening gaat het meestal om administratieve documenten of ingevulde aanvraagformulieren. Zonder het nodige Bewijs kan de dienstverlening niet worden afgeleverd. Soms levert de Output van een Publieke Dienstverlening het Bewijs nodig voor een andere Publieke Dienstverlening."@nl;
  rdfs:comment "Elk stuk waarmee kan worden aangetoond dat men aan een CriteriumVereiste voldoet."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/m8g/Evidence> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen,mailen etc."@nl;
  rdfs:comment "Informatie zoals email,telefoon,adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam van bvb de persoon die men kan contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Contactinfo.Contactnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van bvb de persoon die men kan contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactnaam"@nl;
    shacl:path foaf:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Contactinfo.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schema:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "fax"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Faxnummer waarnaar men kan faxen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Contactinfo.Fax>;
    shacl:datatype xsd:string;
    shacl:description "Faxnummer waarnaar men kan faxen."@nl;
    shacl:maxCount "1";
    shacl:name "fax"@nl;
    shacl:path schema:faxNumber
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Contactinfo.Telefoon>;
    shacl:datatype xsd:string;
    shacl:description "Telefoonnummer waarop men kan bellen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schema:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "website"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Website waarnaar men kan surfen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Contactinfo.Website>;
    shacl:datatype xsd:anyURI;
    shacl:description "Website waarnaar men kan surfen."@nl;
    shacl:maxCount "1";
    shacl:name "website"@nl;
    shacl:path foaf:page
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanschrijfvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb De heer/Mevrouw, Excellentie, Dokter…"@nl;
    rdfs:comment "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Contactinfo.Aanschrijfvorm>;
    shacl:class rdf:langString;
    shacl:description "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    shacl:maxCount "1";
    shacl:name "aanschrijfvorm"@nl;
    shacl:path <http://ww.w3.org/2006/vcard/ns#honorific-prefix>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Contactinfo.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven of bezoeken."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ];
  shacl:targetClass schema:ContactPoint .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#CriteriumvereisteShape> a shacl:NodeShape;
  rdfs:label "Criteriumvereiste"@nl;
  <http://purl.org/vocab/vann/usageNote> "Niet elke publieke dienstverlening is voor iedereen noodzakelijk of nuttig. Bv werkloosheidsuitkeringen zijn enkel noodzakelijk voor werklozen."@nl;
  rdfs:comment "Criterium dat toelaat te bepalen of een gebruiker recht heeft op een dienstverlening of deze mag gebruiken."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/m8g/CriterionRequirement> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#DoubleShape> a shacl:NodeShape;
  rdfs:label "Double";
  shacl:closed false;
  shacl:targetClass xsd:double .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#ErkenningShape> a shacl:NodeShape;
  rdfs:label "Erkenning"@nl;
  rdfs:comment "De aanduiding door een bevoegde instelling waarbij wordt vastgesteld dat een persoon of instelling aan bepaalde eisen voldoet, al dan niet tijdelijk."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "activiteit"@nl;
    rdfs:comment "Type activiteit die door een organisatie wordt uitgeoefend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Erkenning.Activiteit>;
    shacl:class skos:Concept;
    shacl:description "Type activiteit die door een organisatie wordt uitgeoefend."@nl;
    shacl:name "activiteit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/FeitelijkeVerenigingen#Erkenning.activiteit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geldigheidsperiode"@nl;
    rdfs:comment "Tijdsinterval waarbinnen de erkenning van toepassing is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Erkenning.Geldigheidsperiode>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Tijdsinterval waarbinnen de erkenning van toepassing is."@nl;
    shacl:maxCount "1";
    shacl:name "geldigheidsperiode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/FeitelijkeVerenigingen#geldigheidsperiode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Erkenningstype kan zowel door een naam of een code omschreven worden. De naam is dan bv. erkend als 'sportvereniging', en de code is bv. '20'. Deze code is een fictieve code, die betekenis kan hebben bij de publieke organisatie die de erkenning uitgeeft."@nl;
    rdfs:comment "De aard van de erkenning."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Erkenning.Type>;
    shacl:class skos:Concept;
    shacl:description "De aard van de erkenning."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een beknopte omschrijving van de erkenning."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Erkenning.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "Een beknopte omschrijving van de erkenning."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendDoor"@nl;
    rdfs:comment "Verwijzing naar de organisatie die de erkenning heeft toegekend aan de feitelijke vereniging."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Erkenning.Toegekenddoor>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "Verwijzing naar de organisatie die de erkenning heeft toegekend aan de feitelijke vereniging."@nl;
    shacl:minCount "1";
    shacl:name "toegekendDoor"@nl;
