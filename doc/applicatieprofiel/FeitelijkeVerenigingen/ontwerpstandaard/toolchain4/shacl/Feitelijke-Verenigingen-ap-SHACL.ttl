<https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#PubliekedienstverleningShape> a shacl:NodeShape;
  rdfs:label "PubliekeDienstverlening"@nl;
  <http://purl.org/vocab/vann/usageNote> "De dienstverlening vormt een aanbod (dat dus niet noodzakelijk wordt gebruikt). Ze houdt niet noodzakelijk het opnemen van een recht in,de dienstverlening kan de gebruiker ook toelaten een verplichting te vervullen."@nl;
  rdfs:comment "Een publieke dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen hiervan."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "kost"@nl;
    rdfs:comment "Kostprijs verbonden aan het gebruik van de publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Publiekedienstverlening.Kost>;
    shacl:class <http://data.europa.eu/m8g/Cost>;
    shacl:description "Kostprijs verbonden aan het gebruik van de publieke dienstverlening."@nl;
    shacl:name "kost"@nl;
    shacl:path <http://data.europa.eu/m8g/hasCost>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Officiële naam van de publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Publiekedienstverlening.Naam>;
    shacl:class rdf:langString;
    shacl:description "Officiële naam van de publieke dienstverlening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Beschrijving zoals ze zichtbaar voor de gebruikers van de dienstencataloog. Voorkeur gaat naar gedetailleerde beschrijvingen."@nl;
    rdfs:comment "Beschrijving vd publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Publiekedienstverlening.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "Beschrijving vd publieke dienstverlening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "produceert"@nl;
    rdfs:comment "Het werkelijke resultaat van de uitvoering vd Publieke Dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Publiekedienstverlening.Produceert>;
    shacl:class <https://data.europa.eu/m8g/Output>;
    shacl:description "Het werkelijke resultaat van de uitvoering vd Publieke Dienstverlening."@nl;
    shacl:name "produceert"@nl;
    shacl:path <https://purl.org/vocab/cpsv#produces>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftVerantwoordelijke"@nl;
    rdfs:comment "Publieke organisatie die verantwoordelijk is voor het aanbieden en beheren van de publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/FeitelijkeVerenigingen/ontwerpstandaard/toolchain4#Publiekedienstverlening.Heeftverantwoordelijke>;
