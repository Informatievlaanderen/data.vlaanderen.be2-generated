    <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#TijdsmomentShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#ContactpuntShape> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een agent kan op verschillende wijzen interageren met de beschreven entiteiten. Voorbeelden zijn beheerder,uitgever,maker,enz."@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "De naam van de agent."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Agent.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de agent."@nl;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path foaf:name
  ];
  shacl:targetClass dc:Agent .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecordShape> a shacl:NodeShape;
  rdfs:label "Catalogus Record"@nl;
  rdfs:comment "Een record in een catalogus beschrijft de registratie van één resource in de catalogus."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanmaakdatum"@nl;
    rdfs:comment "De datum van (formele) opname van de bijbehorende dataset of dataservice in de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Aanmaakdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum van (formele) opname van de bijbehorende dataset of dataservice in de catalogus."@nl;
    shacl:maxCount 1;
    shacl:name "aanmaakdatum"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "bron metadatarecord"@nl;
    <http://purl.org/vocab/vann/usageNote> "Hiermee vindt men de ISO metadata terug waarvan de GeoDCAT-AP Vlaanderen beschrijving is afgeleid."@nl;
    rdfs:comment "De record in een andere catalogus waarvan deze record en de beschrijvingen van het bijhorende hoofdonderwerp van afgeleid zijn."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.BronMetadatarecord>;
    shacl:datatype xsd:anyURI;
    shacl:description "De record in een andere catalogus waarvan deze record en de beschrijvingen van het bijhorende hoofdonderwerp van afgeleid zijn."@nl;
    shacl:maxCount 1;
    shacl:name "bron metadatarecord"@nl;
    shacl:path dc:source
  ], [
    a shacl:PropertyShape;
    rdfs:label "bron metadata record landingspagina"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bij voorkeur, zet in op de eigenschap bron metadata record, om een machine leesbare vorm te delen."@nl;
    rdfs:comment "Een webpagina in een menselijk leesbare vorm van de bron metadata record."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.BronMetadataRecordLandingspagina>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een webpagina in een menselijk leesbare vorm van de bron metadata record."@nl;
    shacl:maxCount 1;
    shacl:name "bron metadata record landingspagina"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#bronMetadataRecordLandingspagina>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator van het record in de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Identificator>;
    shacl:description "De unieke identificator van het record in de catalogus."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "De naam van het record in de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van het record in de catalogus."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "wijzigingsdatum"@nl;
    rdfs:comment "De meest recente datum waarop de record in de catalogus is gewijzigd, bijgewerkt of aangepast."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Wijzigingsdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De meest recente datum waarop de record in de catalogus is gewijzigd, bijgewerkt of aangepast."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "wijzigingsdatum"@nl;
    shacl:path dc:modified
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    rdfs:comment "Een alternatieve identificator (dan de unieke identificator) voor een record in de catalogus kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (dan de unieke identificator) voor een record in de catalogus kan hier beschreven worden."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "conform"@nl;
    <http://purl.org/vocab/vann/usageNote> "Eén van de URIs voor erkende metadata standaarden: <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat\">metadata DCAT</a>, <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/DCAT-AP-VL\">DCAT-AP Vlaanderen</a> of <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL\">GeoDCAT-AP Vlaanderen</a>."@nl;
    rdfs:comment """De (metadata) standaard volgens welke
regels het hoofdonderwerp waarnaar de
Catalogus Record verwijst, beschreven
wordt."""@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Conform>;
    shacl:class dc:Standard;
    shacl:description """De (metadata) standaard volgens welke
regels het hoofdonderwerp waarnaar de
Catalogus Record verwijst, beschreven
wordt."""@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "conform"@nl;
    shacl:path dc:conformsTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "hoofdonderwerp"@nl;
    rdfs:comment "De resource (dataset of dataservice) beschreven in het record."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusRecord.Hoofdonderwerp>;
    shacl:description "De resource (dataset of dataservice) beschreven in het record."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "hoofdonderwerp"@nl;
    shacl:or ([shacl:class dcat:Resource] [shacl:class dcat:DataService] [shacl:class dcat:Dataset]);
    shacl:path foaf:primaryTopic
  ];
  shacl:targetClass dcat:CatalogRecord .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusResourceShape> a shacl:NodeShape;
  rdfs:label "Catalogus Resource"@nl;
  <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Class:Resource\">DCAT</a>]."@nl;
  rdfs:comment "Een bron (resource) gepubliceerd of beheerd door één agent."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "relatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "[zie <a href=\"https://www.w3.org/TR/vocab-dcat-2/#qualified-forms\">DCAT</a>]."@nl;
    rdfs:comment "Een verband tussen twee resources."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusResource.Relatie>;
    shacl:description "Een verband tussen twee resources."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "relatie"@nl;
    shacl:or ([shacl:class dcat:Resource] [shacl:class dcat:DataService] [shacl:class dcat:Dataset]);
    shacl:path dc:relation
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgever"@nl;
    rdfs:comment "De uitgever, de entiteit die verantwoordelijk is voor het beschikbaar stellen, van de resource in de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusResource.Uitgever>;
    shacl:class dc:Agent;
    shacl:description "De uitgever, de entiteit die verantwoordelijk is voor het beschikbaar stellen, van de resource in de catalogus."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "uitgever"@nl;
    shacl:path dc:publisher
  ];
  shacl:targetClass dcat:DataService,
    dcat:Resource,
    dcat:Dataset .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CatalogusShape> a shacl:NodeShape;
  rdfs:label "Catalogus"@nl;
  <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Class:Catalog\">DCAT</a>]."@nl;
  rdfs:comment "Een beheerde verzameling van metadata over resources (zoals datasets en dataservices in de context van een datacatalogus)."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "Een bondige tekstuele omschrijving van de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een bondige tekstuele omschrijving van de catalogus."@nl;
    shacl:minCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator voor de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Identificator>;
    shacl:description "De unieke identificator voor de catalogus."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde. [Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Property:resource_title\">DCAT</a>]."@nl;
    rdfs:comment "De naam van de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de catalogus."@nl;
    shacl:minCount 1;
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    rdfs:comment "Een alternatieve identificator (dan de unieke identificator) voor de catalogus kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (dan de unieke identificator) voor de catalogus kan hier beschreven worden."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinformatie"@nl;
    rdfs:comment "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Contactinformatie>;
    shacl:class vcard:Kind;
    shacl:description "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de catalogus."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "contactinformatie"@nl;
    shacl:path dcat:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "licentie"@nl;
    <http://purl.org/vocab/vann/usageNote> """De licentie voor het Vlaams Open Data Portaal is vastgelegd op https://data.vlaanderen.be/id/licentie/creative-commons-zero-verklaring/v1.0 . 
<br/>
Meer informatie zie <a href=\"#wettelijkeinformatie\">hieronder</a>."""@nl;
    rdfs:comment "De licentie van de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Licentie>;
    shacl:class dc:LicenseDocument;
    shacl:description "De licentie van de catalogus."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "licentie"@nl;
    shacl:path dc:license
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft Dataset"@nl;
    rdfs:comment "Een dataset die deel uitmaakt van de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.HeeftDataset>;
    shacl:class dcat:Dataset;
    shacl:description "Een dataset die deel uitmaakt van de catalogus."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "heeft Dataset"@nl;
    shacl:path dcat:dataset
  ], [
    a shacl:PropertyShape;
    rdfs:label "record"@nl;
    rdfs:comment "Een record beschrijft de registratie van één enkele dataset of dataservice die onderdeel is van de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Record>;
    shacl:class dcat:CatalogRecord;
    shacl:description "Een record beschrijft de registratie van één enkele dataset of dataservice die onderdeel is van de catalogus."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "record"@nl;
    shacl:path dcat:record
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft DataService"@nl;
    rdfs:comment "Een dataservice die deel uitmaakt van de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.HeeftDataService>;
    shacl:class dcat:DataService;
    shacl:description "Een dataservice die deel uitmaakt van de catalogus."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "heeft DataService"@nl;
    shacl:path dcat:service
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgever"@nl;
    rdfs:comment "De uitgever, de entiteit die verantwoordelijk is voor het beschikbaar stellen, van de catalogus."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Catalogus.Uitgever>;
    shacl:class dc:Agent;
    shacl:description "De uitgever, de entiteit die verantwoordelijk is voor het beschikbaar stellen, van de catalogus."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "uitgever"@nl;
    shacl:path dc:publisher
  ];
  shacl:targetClass dcat:Catalog .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#CodeShape> a shacl:NodeShape;
  rdfs:label "Code"@nl;
  rdfs:comment "Een idee of concept,een denkeenheid."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> """De DCAT contact informatie is gebaseerd op <a href=\"https://www.w3.org/TR/vcard-rdf\">vCard</a>. In het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/#Contactinfo\">generiek basis</a> volgt men de Europese Core Vocabularies. Deze overlappen elkaar en omdat de metadata voor doelgroepen die het ene of het andere verwachten, zal de mapping beide aanmaken.   

Om het verband tussen beiden zichtbaar te maken in het UML model, is de generiek-basis Contactinfo als generalisatie van de vCard Contactinfo (DCAT perspectief) opgenomen."""@nl;
  rdfs:comment "Een beschrijving van contactinformatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactpagina"@nl;
    <http://purl.org/vocab/vann/usageNote> "B.v. de webpagina van de servicedesk van de organisatie."@nl;
    rdfs:comment "Een webpagina die ofwel toelaat om contact op te nemen (via b.v. een webformulier) of die informatie bevat hoe men contact kan opnemen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Contactinfo.Contactpagina>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een webpagina die ofwel toelaat om contact op te nemen (via b.v. een webformulier) of die informatie bevat hoe men contact kan opnemen."@nl;
    shacl:maxCount 1;
    shacl:name "contactpagina"@nl;
    shacl:path foaf:page
  ], [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een email adres in de vorm van een mailto URI volgens de standaard https://tools.ietf.org/html/rfc6068 ."@nl;
    rdfs:comment "Het emailadres waarmee een gebruiker contact kan opnemen voor informatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Contactinfo.Email>;
    shacl:datatype xsd:anyURI;
    shacl:description "Het emailadres waarmee een gebruiker contact kan opnemen voor informatie."@nl;
    shacl:maxCount 1;
    shacl:name "email"@nl;
    shacl:path vcard:hasEmail
  ];
  shacl:targetClass vcard:Kind .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#ContactpuntShape> a shacl:NodeShape;
  rdfs:label "Contactpunt"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen,mailen etc."@nl;
  rdfs:comment "Informatie zoals email,telefoon,adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:targetClass vcard:Kind,
    schema:ContactPoint .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DataserviceShape> a shacl:NodeShape;
  rdfs:label "Dataservice"@nl;
  <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Class:Data_Service\">DCAT</a>]."@nl;
  rdfs:comment "Een verzameling van operaties die ofwel toegang bieden tot één of meer datasets ofwel een dataverwerkingsdoel hebben."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "Een bondige tekstuele omschrijving van de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een bondige tekstuele omschrijving van de dataservice."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "creatiedatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de dataservice voor het eerst werd geactiveerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Creatiedatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het tijdsmoment waarop de dataservice voor het eerst werd geactiveerd."@nl;
    shacl:maxCount 1;
    shacl:name "creatiedatum"@nl;
    shacl:path dc:created
  ], [
    a shacl:PropertyShape;
    rdfs:label "endpointbeschrijving"@nl;
    rdfs:comment "Een beschrijving van de diensten die beschikbaar zijn via de end-points, met inbegrip van hun operaties, parameters, enz."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Endpointbeschrijving>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een beschrijving van de diensten die beschikbaar zijn via de end-points, met inbegrip van hun operaties, parameters, enz."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "endpointbeschrijving"@nl;
    shacl:path dcat:endpointDescription
  ], [
    a shacl:PropertyShape;
    rdfs:label "endpointURL"@nl;
    rdfs:comment "De rootlocatie of het primaire endpoint van de dienst (een web-resolvable URI)."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.EndpointURL>;
    shacl:datatype xsd:anyURI;
    shacl:description "De rootlocatie of het primaire endpoint van de dienst (een web-resolvable URI)."@nl;
    shacl:maxCount 1;
    shacl:name "endpointURL"@nl;
    shacl:path dcat:endpointURL
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator van de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Identificator>;
    shacl:description "De unieke identificator van de dataservice."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina"@nl;
    rdfs:comment "Een algemene webpagina waarnaar kan worden genavigeerd in een webbrowser, met algemene aanvullende informatie over de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Landingspagina>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een algemene webpagina waarnaar kan worden genavigeerd in een webbrowser, met algemene aanvullende informatie over de dataservice."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "landingspagina"@nl;
    shacl:path dcat:landingPage
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina voor authenticatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap capteert een onderdeel van de beschrijvende informatie over de service beschreven in de landingspagina. Enkel te gebruiken indien men kan verwijzen naar een sectie of een aparte pagina waar deze specifieke informatie beschikbaar is."@nl;
    rdfs:comment "Een verwijzing naar de landingspagina met de specifieke informatie over de authenticatie voor de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.LandingspaginaVoorAuthenticatie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een verwijzing naar de landingspagina met de specifieke informatie over de authenticatie voor de dataservice."@nl;
    shacl:maxCount 1;
    shacl:name "landingspagina voor authenticatie"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#landingspaginaVoorAuthenticatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina voor gebruiksinformatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap capteert een onderdeel van de beschrijvende informatie over de service beschreven in de landingspagina. Enkel te gebruiken indien men kan verwijzen naar een sectie of een aparte pagina waar deze specifieke informatie beschikbaar is."@nl;
    rdfs:comment "Een verwijzing naar de landingspagina met de specifieke informatie over het gebruik van de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.LandingspaginaVoorGebruiksinformatie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een verwijzing naar de landingspagina met de specifieke informatie over het gebruik van de dataservice."@nl;
    shacl:maxCount 1;
    shacl:name "landingspagina voor gebruiksinformatie"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#landingspaginaVoorGebruiksinformatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina voor statusinformatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap capteert een onderdeel van de beschrijvende informatie over de service beschreven in de landingspagina. Enkel te gebruiken indien men kan verwijzen naar een sectie of een aparte pagina waar deze specifieke informatie beschikbaar is."@nl;
    rdfs:comment "Een verwijzing naar de statuspagina van de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.LandingspaginaVoorStatusinformatie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een verwijzing naar de statuspagina van de dataservice."@nl;
    shacl:maxCount 1;
    shacl:name "landingspagina voor statusinformatie"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#landingspaginaVoorStatusinformatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "publicatiedatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de service werd gepubliceerd door de uitgever."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Publicatiedatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het tijdsmoment waarop de service werd gepubliceerd door de uitgever."@nl;
    shacl:maxCount 1;
    shacl:name "publicatiedatum"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "De naam van de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de dataservice."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:minCount 1;
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "trefwoord"@nl;
    <http://purl.org/vocab/vann/usageNote> "De meertaligheid is hier verschillend als voor een beschrijvende eigenschap. De taal van elk trefwoord moet aangeduidt worden. Echter het is niet de verwachting dat elk trefwoord in elke taal vertaald wordt. Ook is het niet zo dat er slecht 1 trefwoord per taal is. Er kunnen (zullen) er meerderen zijn."@nl;
    rdfs:comment "Een trefwoord of tag die de resource beschrijft."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Trefwoord>;
    shacl:datatype rdf:langString;
    shacl:description "Een trefwoord of tag die de resource beschrijft."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "trefwoord"@nl;
    shacl:path dcat:keyword
  ], [
    a shacl:PropertyShape;
    rdfs:label "versie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voor dataservices wordt dikwijls <a href=\"https://semver.org/lang/nl/\">semantisch versioneren</a> gebruikt. Bij het deployen van services wordt aangeraden om enkel de major version op te nemen in de endpointurl. De versieinformatie die hier opgegeven wordt komt best overeen met de versie die beschikbaar is in de endpointurl."@nl;
    rdfs:comment "Een unieke aanduiding van een variant van de dataservice door middel van een versienummer of -naam van de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Versie>;
    shacl:datatype xsd:string;
    shacl:description "Een unieke aanduiding van een variant van de dataservice door middel van een versienummer of -naam van de dataservice."@nl;
    shacl:maxCount 1;
    shacl:name "versie"@nl;
    shacl:path owl:versionInfo
  ], [
    a shacl:PropertyShape;
    rdfs:label "wijzigingsdatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de dataservice werd gewijzigd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Wijzigingsdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het tijdsmoment waarop de dataservice werd gewijzigd."@nl;
    shacl:maxCount 1;
    shacl:name "wijzigingsdatum"@nl;
    shacl:path dc:modified
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    rdfs:comment "Een alternatieve identificator (dan de unieke identificator) voor een dataservice kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (dan de unieke identificator) voor een dataservice kan hier beschreven worden."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "conform aan protocol"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap capteert de technische specificatie waaraan de service voldoet. Voorbeelden zijn WFS, SPARQL, SOAP,…."@nl;
    rdfs:comment "Een protocol waaraan de dataservice voldoet."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.ConformAanProtocol>;
    shacl:class dc:Standard;
    shacl:description "Een protocol waaraan de dataservice voldoet."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "conform aan protocol"@nl;
    shacl:path dc:conformsTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinformatie"@nl;
    rdfs:comment "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Contactinformatie>;
    shacl:class vcard:Kind;
    shacl:description "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de dataservice."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "contactinformatie"@nl;
    shacl:path dcat:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "geografische dekking"@nl;
    <http://purl.org/vocab/vann/usageNote> "Indien men het geografische gebied wil aangeven van de data die de dataservice aanbiedt, dan moet men dit aangeven in de overeenkomstige eigenschap van de gerelateerde dataset(s)."@nl;
    rdfs:comment "Het geografische gebied waarvoor deze dataservice van toepassing is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.GeografischeDekking>;
    shacl:class dc:Location;
    shacl:description "Het geografische gebied waarvoor deze dataservice van toepassing is."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "geografische dekking"@nl;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "levensfase"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het gebruik hiervan is voornamelijk belangrijk wanneer men de data service wil uit dienst nemen. Het tijdig aangeven dat een dienst op zijn einde loopt en dat de gebruiker moet overschakelen op de nieuwe dienst is een onderdeel van goed service management."@nl;
    rdfs:comment "De levensfase waarin de dataservice zich bevindt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Levensfase>;
    shacl:class skos:Concept;
    shacl:description "De levensfase waarin de dataservice zich bevindt."@nl;
    shacl:maxCount 1;
    shacl:name "levensfase"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#levensfase>
  ], [
    a shacl:PropertyShape;
    rdfs:label "licentie"@nl;
    rdfs:comment "De licentie van de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Licentie>;
    shacl:class dc:LicenseDocument;
    shacl:description "De licentie van de dataservice."@nl;
    shacl:maxCount 1;
    shacl:name "licentie"@nl;
    shacl:path dc:license
  ], [
    a shacl:PropertyShape;
    rdfs:label "ontwikkelingstoestand"@nl;
    <http://purl.org/vocab/vann/usageNote> "Op verschillende momenten tijdens de ontwikkeling van een data service wordt de data service geëvalueerd."@nl;
    rdfs:comment "De ontwikkelingstoestand waarin de dataservice is gedeployed."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Ontwikkelingstoestand>;
    shacl:class skos:Concept;
    shacl:description "De ontwikkelingstoestand waarin de dataservice is gedeployed."@nl;
    shacl:maxCount 1;
    shacl:name "ontwikkelingstoestand"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#ontwikkelingstoestand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechten"@nl;
    <http://purl.org/vocab/vann/usageNote> "Met deze eigenschap kunnen rechten uitgedrukt worden zoals copyright of specifieke gebruiksbepalingen. Ook SLA en SLO  informatie kan hier opgenomen worden. Indien deze rechten reeds opgenomen zijn in de licentie dan moeten ze niet hier herhaald worden."@nl;
    rdfs:comment "Bepalingen van juridische aard die gelden op de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Rechten>;
    shacl:class dc:RightsStatement;
    shacl:description "Bepalingen van juridische aard die gelden op de dataservice."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "rechten"@nl;
    shacl:path dc:rights
  ], [
    a shacl:PropertyShape;
    rdfs:label "service categorie"@nl;
    rdfs:comment "De categorie waartoe de dataservice behoort."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.ServiceCategorie>;
    shacl:class skos:Concept;
    shacl:description "De categorie waartoe de dataservice behoort."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "service categorie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#servicecategorie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "service type"@nl;
    rdfs:comment """Het type waartoe de
dataservice behoort."""@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.ServiceType>;
    shacl:class skos:Concept;
    shacl:description """Het type waartoe de
dataservice behoort."""@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "service type"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#servicetype>
  ], [
    a shacl:PropertyShape;
    rdfs:label "statuut"@nl;
    rdfs:comment "Een aanduiding van op welke basis de catalogusresource beschikbaar is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Statuut>;
    shacl:class skos:Concept;
    shacl:description "Een aanduiding van op welke basis de catalogusresource beschikbaar is."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "statuut"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#statuut>
  ], [
    a shacl:PropertyShape;
    rdfs:label "thema"@nl;
    rdfs:comment "De hoofdcategorie waartoe de dataservice behoort."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Thema>;
    shacl:class skos:Concept;
    shacl:description "De hoofdcategorie waartoe de dataservice behoort."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "thema"@nl;
    shacl:path dcat:theme
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegankelijkheid"@nl;
    <http://purl.org/vocab/vann/usageNote> """Gebruik enkel de waarden PUBLIC en NON_PUBLIC uit de codelijst, waarbij PUBLIC staat voor het gebruiken van de dataservice is zonder voorwaarden, terwijl NON_PUBLIC betekent dat het gebruiken van de service gebonden is aan voorwaarden. 
 
De condities die enkel als doel hebben om de correcte werking van de dataservice te ondersteunen (vermijden van DDOS aanvallen, vermijden van oneigenlijk gebruik, ...) zoals het toepassen van authenticatie en authorisatie worden beschouwd als zonder voorwaarden. Indien echter dit leidt tot een een toetsing (bv. is de organisatie gekend, is er een betalingscontract afgesloten, ...) voorafgaand aan de verlening van de toegang dan zijn dit wel toegangsbeperkende voorwaarden. Voor gebruik zie http://publications.europa.eu/resource/authority/access-right."""@nl;
    rdfs:comment "De toegankelijkheid voor de dataservice."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.Toegankelijkheid>;
    shacl:class skos:Concept;
    shacl:description "De toegankelijkheid voor de dataservice."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "toegankelijkheid"@nl;
    shacl:path dc:accessRights
  ], [
    a shacl:PropertyShape;
    rdfs:label "biedt informatie aan over"@nl;
    rdfs:comment "De data die via deze dataservice worden aangeboden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataservice.BiedtInformatieAanOver>;
    shacl:class dcat:Dataset;
    shacl:description "De data die via deze dataservice worden aangeboden."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "biedt informatie aan over"@nl;
    shacl:path dcat:servesdataset
  ];
  shacl:targetClass dcat:DataService .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerieShape> a shacl:NodeShape;
  rdfs:label "Dataset Serie"@nl;
  <http://purl.org/vocab/vann/usageNote> """In DCAT-AP VL 3.0 worden Dataset Serie opgevat in hun zuivere betekenis: een verzameling van datasets die dezelfde specificaties delen, waarbij de enige variërende eigenschap typisch ruimte of tijd/versie is. Dit sluit nauw aan bij ISO 19115-1 en INSPIRE, waar een datasetserie wordt gedefinieerd als een collectie datasets met een gemeenschappelijke productspecificatie. Deze zuivere vorm wordt in DCAT-AP VL 3.0 volledig ondersteund. 
<br/>
Daarnaast bestaan in de praktijk verschillende tussenvormen - zoals verzamelingen van datasets over eenzelfde thema, verzamelingen van datasets, series en services, of collecties gebaseerd op bron- of eigenschapsgelijkheid. Deze structuren hebben een grotere “vrijheidsgraad” (variatie in versie, gebied, specificaties, brontypes of eigenschappen) en voldoen daardoor niet aan de formele definitie van Dataset Serie. Deze tussenvormen worden daarom niet als Dataset Serie ondersteund, maar wel vindbaar gemaakt via passende DCAT-structuren (bv. thema-gebaseerde groepering of catalogusstructuren). 
<br/>
Voor complexe of expliciet gestructureerde groeperingen is de correcte representatie een (sub)catalogus, waarbij de verbindende eigenschap expliciet door de catalogus zelf wordt bepaald. Subcatalogi worden wél ondersteund in DCAT-AP VL 3.0."""@nl;
  rdfs:comment "Een verzameling die onafhankelijk gepubliceerde datasets groepeert rond gedeelde eigenschappen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een bondige tekstuele beschrijving van de Dataset Serie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een bondige tekstuele beschrijving van de Dataset Serie."@nl;
    shacl:minCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator van de Dataset Serie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Identificator>;
    shacl:description "De unieke identificator van de Dataset Serie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "De naam van de Dataset Serie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de Dataset Serie."@nl;
    shacl:minCount 1;
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    rdfs:comment "Een alternatieve identificator (dan de unieke identificator) voor een Dataset Serie kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (dan de unieke identificator) voor een Dataset Serie kan hier beschreven worden."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "belanghebbende wetgeving"@nl;
    rdfs:comment "De wetgeving die aanzet tot het aanmaken of het beheren van de Dataset Serie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.BelanghebbendeWetgeving>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "De wetgeving die aanzet tot het aanmaken of het beheren van de Dataset Serie."@nl;
    shacl:name "belanghebbende wetgeving"@nl;
    shacl:path <http://data.europa.eu/r5r/applicableLegislation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinformatie"@nl;
    rdfs:comment "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de Dataset Serie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Contactinformatie>;
    shacl:class vcard:Kind;
    shacl:description "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de Dataset Serie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "contactinformatie"@nl;
    shacl:path dcat:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "geografische dekking"@nl;
    <http://purl.org/vocab/vann/usageNote> "Wanneer geografische dekking een dimensie is in de Dataset Serie moet de geografische dekking van elke dataset in de collectie deel uitmaken van de geografisch dekking. Er wordt een waarde met een open einde aanbevolen, b.v. EU of een alomvattende bouding box dat de verwachte waarden bevat."@nl;
    rdfs:comment "Het geografische gebied waarover de Dataset Serie informatie heeft."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.GeografischeDekking>;
    shacl:class dc:Location;
    shacl:description "Het geografische gebied waarover de Dataset Serie informatie heeft."@nl;
    shacl:name "geografische dekking"@nl;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "periodiciteit"@nl;
    <http://purl.org/vocab/vann/usageNote> "De periodiciteit van een Dataset Serie is niet gelijk aan de periodiciteit van de datasets in de verzameling."@nl;
    rdfs:comment "De maat waarmee de Dataset Serie wordt bijgewerkt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Periodiciteit>;
    shacl:class dc:Frequency;
    shacl:description "De maat waarmee de Dataset Serie wordt bijgewerkt."@nl;
    shacl:maxCount 1;
    shacl:name "periodiciteit"@nl;
    shacl:path dc:accrualPeriodicity
  ], [
    a shacl:PropertyShape;
    rdfs:label "publicatie datum"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit is het moment wanneer de Dataset Serie voor het eerst publiekelijk kenbaar gemaakt is. Het is niet noodzakelijk gekijk aan de publicatie datum van de oudste dataset in de verzameling."@nl;
    rdfs:comment "Het tijdsmoment waarop de Dataset Serie werd gepubliceerd door de uitgever."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.PublicatieDatum>;
    shacl:description "Het tijdsmoment waarop de Dataset Serie werd gepubliceerd door de uitgever."@nl;
    shacl:maxCount 1;
    shacl:name "publicatie datum"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "temporele dekking"@nl;
    rdfs:comment "De tijdsperiode die de Dataset Serie bestrijkt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.TemporeleDekking>;
    shacl:class dc:PeriodOfTime;
    shacl:description "De tijdsperiode die de Dataset Serie bestrijkt."@nl;
    shacl:name "temporele dekking"@nl;
    shacl:path dc:temporal
  ], [
    a shacl:PropertyShape;
    rdfs:label "wijzigingsdatum"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit is niet noodzakelijk hetzelfde moment als de meest recente wijzigingsdatum van de datasets die de Dataset Serie bevat."@nl;
    rdfs:comment "Het meest recente moment waarop de Dataset Serie is bijgewerkt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Wijzigingsdatum>;
    shacl:description "Het meest recente moment waarop de Dataset Serie is bijgewerkt."@nl;
    shacl:maxCount 1;
    shacl:name "wijzigingsdatum"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:modified
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgever";
    rdfs:comment "De uitgever, de entiteit die verantwoordelijk is voor het beschikbaar stellen, van de Dataset Serie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetSerie.Uitgever>;
    shacl:class dc:Agent;
    shacl:description "De uitgever, de entiteit die verantwoordelijk is voor het beschikbaar stellen, van de Dataset Serie."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "uitgever";
    shacl:path dc:publisher
  ];
  shacl:targetClass dcat:DatasetSeries .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DatasetShape> a shacl:NodeShape;
  rdfs:label "Dataset"@nl;
  <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Class:Dataset\">DCAT</a>]."@nl;
  rdfs:comment "Een verzameling gegevens,gepubliceerd of samengesteld door één agent,en beschikbaar voor toegang of download in één of meerdere voorstellingswijzen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "Een bondige tekstuele omschrijving van de dataset."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een bondige tekstuele omschrijving van de dataset."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:minCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "creatiedatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de dataset ontstaan is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Creatiedatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het tijdsmoment waarop de dataset ontstaan is."@nl;
    shacl:maxCount 1;
    shacl:name "creatiedatum"@nl;
    shacl:path dc:created
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator van de dataset."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Identificator>;
    shacl:description "De unieke identificator van de dataset."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina"@nl;
    <http://purl.org/vocab/vann/usageNote> "De mapping zal de landingspagina invullen met de URL naar de metadata voorstelling waarvan de dataset is afgeleid."@nl;
    rdfs:comment "Een algemene webpagina waarnaar kan worden genavigeerd in een webbrowser, met algemene informatie over de dataset, zijn distributies en/of aanvullende informatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Landingspagina>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een algemene webpagina waarnaar kan worden genavigeerd in een webbrowser, met algemene informatie over de dataset, zijn distributies en/of aanvullende informatie."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "landingspagina"@nl;
    shacl:path dcat:landingPage
  ], [
    a shacl:PropertyShape;
    rdfs:label "publicatiedatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de dataset werd gepubliceerd door de uitgever."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Publicatiedatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het tijdsmoment waarop de dataset werd gepubliceerd door de uitgever."@nl;
    shacl:maxCount 1;
    shacl:name "publicatiedatum"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "De naam van de dataset."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de dataset."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:minCount 1;
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "trefwoord"@nl;
    <http://purl.org/vocab/vann/usageNote> "De meertaligheid is hier verschillend als voor een beschrijvende eigenschap. De taal van elk trefwoord moet aangeduidt worden. Echter het is niet de verwachting dat elk trefwoord in elke taal vertaald wordt. Ook is het niet zo dat er slecht 1 trefwoord per taal is. Er kunnen (zullen) er meerdere zijn."@nl;
    rdfs:comment "Een trefwoord of tag die de resource beschrijft."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Trefwoord>;
    shacl:datatype rdf:langString;
    shacl:description "Een trefwoord of tag die de resource beschrijft."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "trefwoord"@nl;
    shacl:path dcat:keyword
  ], [
    a shacl:PropertyShape;
    rdfs:label "versie"@nl;
    rdfs:comment "Een unieke aanduiding van een variant van de dataset door middel van een versienummer of -naam van de dataset."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Versie>;
    shacl:datatype xsd:string;
    shacl:description "Een unieke aanduiding van een variant van de dataset door middel van een versienummer of -naam van de dataset."@nl;
    shacl:maxCount 1;
    shacl:name "versie"@nl;
    shacl:path dcat:version
  ], [
    a shacl:PropertyShape;
    rdfs:label "wijzigingsdatum"@nl;
    rdfs:comment "Het tijdsmoment waarop de dataset werd geactualiseerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Wijzigingsdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het tijdsmoment waarop de dataset werd geactualiseerd."@nl;
    shacl:maxCount 1;
    shacl:name "wijzigingsdatum"@nl;
    shacl:path dc:modified
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    rdfs:comment "Een alternatieve identificator (dan de unieke identificator) voor een dataset kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (dan de unieke identificator) voor een dataset kan hier beschreven worden."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "conform"@nl;
    rdfs:comment "Een standaard, schema, applicatieprofiel, vocabularium, CRS, ... waaraan de dataset voldoet."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Conform>;
    shacl:class dc:Standard;
    shacl:description "Een standaard, schema, applicatieprofiel, vocabularium, CRS, ... waaraan de dataset voldoet."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "conform"@nl;
    shacl:path dc:conformsTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinformatie"@nl;
    rdfs:comment "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de dataset."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Contactinformatie>;
    shacl:class vcard:Kind;
    shacl:description "De relevante contactinformatie waarmee een eindgebruiker in contact kan treden met de verantwoordelijken van de dataset."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "contactinformatie"@nl;
    shacl:path dcat:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "GEMET concept"@nl;
    rdfs:comment """De rubriek waartoe de
dataset behoort volgens de
GEMET thesaurus."""@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.GEMETConcept>;
    shacl:class skos:Concept;
    shacl:description """De rubriek waartoe de
dataset behoort volgens de
GEMET thesaurus."""@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "GEMET concept"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#gEMETconcept>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geografische dekking"@nl;
    rdfs:comment "Het geografische gebied waarover de dataset informatie heeft."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.GeografischeDekking>;
    shacl:class dc:Location;
    shacl:description "Het geografische gebied waarover de dataset informatie heeft."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:minCount 1;
    shacl:name "geografische dekking"@nl;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "herkomst"@nl;
    <http://purl.org/vocab/vann/usageNote> "De verwachte waarde is een webpagina (URL) die de ontstaansgeschiedenis van de dataset beschrijft."@nl;
    rdfs:comment "De ontstaansgeschiedenis van een dataset."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Herkomst>;
    shacl:class dc:ProvenanceStatement;
    shacl:description "De ontstaansgeschiedenis van een dataset."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "herkomst"@nl;
    shacl:path dc:provenance
  ], [
    a shacl:PropertyShape;
    rdfs:label "INSPIRE thema"@nl;
    rdfs:comment """De rubriek waartoe de
dataset behoort volgens de
INSPIRE thema's."""@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.INSPIREThema>;
    shacl:class skos:Concept;
    shacl:description """De rubriek waartoe de
dataset behoort volgens de
INSPIRE thema's."""@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "INSPIRE thema"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#iNSPIREthema>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ISO categorie"@nl;
    rdfs:comment """De rubriek waartoe de
dataset behoort volgens de
afspraken in de ISO-
standaard voor
geografische metadata."""@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.ISOCategorie>;
    shacl:class skos:Concept;
    shacl:description """De rubriek waartoe de
dataset behoort volgens de
afspraken in de ISO-
standaard voor
geografische metadata."""@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "ISO categorie"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#iSOcategorie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ruimtelijke resolutie"@nl;
    rdfs:comment "Het detailniveau van de dataset."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.RuimtelijkeResolutie>;
    shacl:class <http://www.w3.org/ns/dqv#QualityMeasurement>;
    shacl:description "Het detailniveau van de dataset."@nl;
    shacl:maxCount 1;
    shacl:name "ruimtelijke resolutie"@nl;
    shacl:path <http://www.w3.org/ns/dqv#hasQualityMeasurement>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ruimtelijk voorstellingstype"@nl;
    rdfs:comment "Het primaire ruimtelijke voorstellingstype waarin de data in de dataset wordt beheerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.RuimtelijkVoorstellingstype>;
    shacl:class skos:Concept;
    shacl:description "Het primaire ruimtelijke voorstellingstype waarin de data in de dataset wordt beheerd."@nl;
    shacl:maxCount 1;
    shacl:name "ruimtelijk voorstellingstype"@nl;
    shacl:path <http://www.w3.org/ns/adms#representionTechnique>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "De progressie in het samenstellen van de dataset."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Status>;
    shacl:class skos:Concept;
    shacl:description "De progressie in het samenstellen van de dataset."@nl;
    shacl:maxCount 1;
    shacl:name "status"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "statuut"@nl;
    rdfs:comment "Een aanduiding van op welke basis de catalogusresource beschikbaar is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Statuut>;
    shacl:class skos:Concept;
    shacl:description "Een aanduiding van op welke basis de catalogusresource beschikbaar is."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "statuut"@nl;
    shacl:path <http://data.vlaanderen.be/ns/metadata-dcat#statuut>
  ], [
    a shacl:PropertyShape;
    rdfs:label "thema"@nl;
    rdfs:comment "De hoofdcategorie waartoe de dataset behoort."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Thema>;
    shacl:class skos:Concept;
    shacl:description "De hoofdcategorie waartoe de dataset behoort."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "thema"@nl;
    shacl:path dcat:theme
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegankelijkheid"@nl;
    <http://purl.org/vocab/vann/usageNote> """Gebruik enkel de waarden PUBLIC en NON_PUBLIC uit de codelijst.
Deze waarden geven een invulling weer voor \"Openbaarheid van Bestuur\".
De waarde NON_PUBLIC geeft aan dat er (wettelijke) beperkingen zijn die verhinderen dat er vrije toegang tot de informatie gegeven wordt. Voorbeelden van zulke beperkingen zijn staatsgeheimen, persoonsgebonden informatie, economische concurrentie, ..."""@nl;
    rdfs:comment "De toegankelijkheid voor de dataset."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Toegankelijkheid>;
    shacl:class skos:Concept;
    shacl:description "De toegankelijkheid voor de dataset."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "toegankelijkheid"@nl;
    shacl:path dc:accessRights
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorbeeldweergave"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een voorbeeldweergave of thumbnail heeft als doel de vindbaarheid van de dataset te verhogen. Het is geen accurate weergave van de data die de dataset bevat."@nl;
    rdfs:comment "Een verkleinde weergave van een afbeelding die de dataset illustreert."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Voorbeeldweergave>;
    shacl:class dcat:Distribution;
    shacl:description "Een verkleinde weergave van een afbeelding die de dataset illustreert."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "voorbeeldweergave"@nl;
    shacl:path <http://www.w3.org/ns/adms#sample>
  ], [
    a shacl:PropertyShape;
    rdfs:label "distributie"@nl;
    rdfs:comment "Een beschikbare distributie van de dataset."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Distributie>;
    shacl:class dcat:Distribution;
    shacl:description "Een beschikbare distributie van de dataset."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "distributie"@nl;
    shacl:path dcat:distribution
  ], [
    a shacl:PropertyShape;
    rdfs:label "inserie";
    rdfs:comment "Een Dataset Serie waartoe de dataset behoort."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Inserie>;
    shacl:class dcat:DatasetSeries;
    shacl:description "Een Dataset Serie waartoe de dataset behoort."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "inserie";
    shacl:path dcat:inSeries
  ], [
    a shacl:PropertyShape;
    rdfs:label "eigenaar"@nl;
    rdfs:comment "De agent die de eigendomsrechten heeft."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Dataset.Eigenaar>;
    shacl:class dc:Agent;
    shacl:description "De agent die de eigendomsrechten heeft."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "eigenaar"@nl;
    shacl:path dc:rightsHolder
  ];
  shacl:targetClass dcat:Dataset .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DateTimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DecimalShape> a shacl:NodeShape;
  rdfs:label "Decimal";
  shacl:closed false;
  shacl:targetClass xsd:decimal .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#DistributieShape> a shacl:NodeShape;
  rdfs:label "Distributie"@nl;
  <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Class:Distribution\">DCAT</a>]."@nl;
  rdfs:comment "Een specifieke voorstellingswijze van een dataset,gekenmerkt door één of meerdere eigenschappen zoals taal,media-type of formaat,schematische organisatie,temporele en ruimtelijke resolutie,granulariteit,..."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "downloadURL"@nl;
    <http://purl.org/vocab/vann/usageNote> "De URL start het downloaden van de distributie. [Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Property:distribution_download_url\">DCAT</a>]."@nl;
    rdfs:comment "De URL waar de data gedownload kan worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.DownloadURL>;
    shacl:datatype xsd:anyURI;
    shacl:description "De URL waar de data gedownload kan worden."@nl;
    shacl:maxCount 1;
    shacl:name "downloadURL"@nl;
    shacl:path dcat:downloadURL
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De unieke identificator van de distributie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.Identificator>;
    shacl:description "De unieke identificator van de distributie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "identificator"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde."@nl;
    rdfs:comment "De naam van de distributie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de distributie."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegangsURL"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze url kan zowel verwijzen naar een beschrijvende pagina over hoe toegang tot de data kan verkregen worden als naar een directe link waarmee het downloaden van de distributie gestart kan worden. In het tweede geval wordt ook de eigenschap downloadURL bijkomend ingevuld. [Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Property:distribution_access_url\">DCAT</a>]."@nl;
    rdfs:comment "Een URL waar de data kan gevonden worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.ToegangsURL>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een URL waar de data kan gevonden worden."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "toegangsURL"@nl;
    shacl:path dcat:accessURL
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "De mapping van ISO metadata kan resulteren in een bijkomende alternatieve identificator. Bepaalde distributies zijn downloadbaar vanuit een geografische data service met kennis van de identificator van deze distributie. B.v. de laag bepaald een volledige datasetdistributie in een WMS. Deze identificator is een lokale benaming in de context van de geassocieerde dataservice."@nl;
    rdfs:comment "Een alternatieve identificator (dan de unieke identificator) voor een distributie kan hier beschreven worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (dan de unieke identificator) voor een distributie kan hier beschreven worden."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "conform"@nl;
    rdfs:comment """Een standaard, schema, implementatie-
model, applicatieprofiel, vocabularium
waaraan de distributie voldoet."""@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.Conform>;
    shacl:class dc:Standard;
    shacl:description """Een standaard, schema, implementatie-
model, applicatieprofiel, vocabularium
waaraan de distributie voldoet."""@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "conform"@nl;
    shacl:path dc:conformsTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "formaat"@nl;
    rdfs:comment "Het bestandsformaat waarin de data wordt gedeeld."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.Formaat>;
    shacl:class skos:Concept;
    shacl:description "Het bestandsformaat waarin de data wordt gedeeld."@nl;
    shacl:maxCount 1;
    shacl:name "formaat"@nl;
    shacl:path dc:format
  ], [
    a shacl:PropertyShape;
    rdfs:label "licentie"@nl;
    rdfs:comment "De licentie van de distributie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.Licentie>;
    shacl:class dc:LicenseDocument;
    shacl:description "De licentie van de distributie."@nl;
    shacl:maxCount 1;
    shacl:name "licentie"@nl;
    shacl:path dc:license
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechten"@nl;
    <http://purl.org/vocab/vann/usageNote> "Met deze eigenschap kunnen rechten uitgedrukt worden zoals bronvermeldingen, copyright of specifieke gebruiksbepalingen. Indien deze rechten reeds opgenomen zijn in de licentie dan moeten ze niet hier herhaald worden."@nl;
    rdfs:comment "Bepalingen van juridische aard die gelden op de distributie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.Rechten>;
    shacl:class dc:RightsStatement;
    shacl:description "Bepalingen van juridische aard die gelden op de distributie."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "rechten"@nl;
    shacl:path dc:rights
  ], [
    a shacl:PropertyShape;
    rdfs:label "wordt aangeboden door"@nl;
    rdfs:comment "Een dataservice die deze distributie aanbiedt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.WordtAangebodenDoor>;
    shacl:class dcat:DataService;
    shacl:description "Een dataservice die deze distributie aanbiedt."@nl;
    shacl:maxCount "n"^^xsd:integer;
    shacl:name "wordt aangeboden door"@nl;
    shacl:path dcat:accessService
  ], [
    a shacl:PropertyShape;
    rdfs:label "verdeler"@nl;
    <http://purl.org/vocab/vann/usageNote> "[Zie <a href=\"https://semiceu.github.io/GeoDCAT-AP/releases/2.0.0/#responsible-party-and-metadata-point-of-contact---dataset-responsible-party-and-metadata-point-of-contact\">GeoDCAT-AP</a>]."@nl;
    rdfs:comment "De agent die instaat voor de verdeling."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Distributie.Verdeler>;
    shacl:class dc:Agent;
    shacl:description "De agent die instaat voor de verdeling."@nl;
    shacl:maxCount 1;
    shacl:name "verdeler"@nl;
    shacl:path <http://data.europa.eu/930/distributor>
  ];
  shacl:targetClass dcat:Distribution .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#GestructureerdeIdentificatorShape> a shacl:NodeShape;
  rdfs:label "Gestructureerde Identificator"@nl;
  rdfs:comment "Identificator van een object opgesplitst in zijn onderdelen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lokale identificator"@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren binnen de naamruimte."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#GestructureerdeIdentificator.LokaleIdentificator>;
    shacl:datatype xsd:string;
    shacl:description "String gebruikt om het object uniek te identificeren binnen de naamruimte."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "lokale identificator"@nl;
    shacl:path <http://data.vlaanderen.be/ns/generiek#lokaleIdentificator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naamruimte"@nl;
    <http://purl.org/vocab/vann/usageNote> "Laat toe om objecten met dezelfde identificator maar van verschillend type en/of afkomstig uit verschillende domeinen uiteen te houden. In praktijk bv een uri samengesteld uit betekenisvolle elementen zoals een domeinnaam, type en concept (bv https://data.vlaanderen.be/id/adres/)."@nl;
    rdfs:comment "String die toegvoegd wordt aan de lokaleidentificator om deze globaal uniek te maken."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#GestructureerdeIdentificator.Naamruimte>;
    shacl:datatype xsd:string;
    shacl:description "String die toegvoegd wordt aan de lokaleidentificator om deze globaal uniek te maken."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naamruimte"@nl;
    shacl:path <http://data.vlaanderen.be/ns/generiek#naamruimte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "versieidentificator"@nl;
    rdfs:comment "Identificator van de specifieke versie van een object."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#GestructureerdeIdentificator.Versieidentificator>;
    shacl:datatype xsd:string;
    shacl:description "Identificator van de specifieke versie van een object."@nl;
    shacl:maxCount 1;
    shacl:name "versieidentificator"@nl;
    shacl:path <http://data.vlaanderen.be/ns/generiek#versieIdentificator>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/generiek#GestructureerdeIdentificator> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#HerkomstVerklaringShape> a shacl:NodeShape;
  rdfs:label "Herkomst Verklaring"@nl;
  <http://purl.org/vocab/vann/usageNote> "De ontstaansgeschiedenis  kan één enkele stap of een sequentie van stappen omvatten. De opdeling in een aaneengeschakeling van stappen werd buiten scope gehouden.  Daarom is elke instantie van deze klasse een web toegankelijke pagina die de ontstaansgeschiedenis beschrijft."@nl;
  rdfs:comment "Informatie over ontstaansgeschiedenis van een resource."@nl;
  shacl:closed false;
  shacl:targetClass dc:ProvenanceStatement .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "notatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type vd string slaat op het identifierscheme (incl de version ervan), de string zelf op de eigenlijke identifier. Zie definitie Identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Identificator.Notatie>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount 1;
    shacl:name "notatie"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door String"@nl;
    rdfs:comment "Naam vd agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Identificator.ToegekendDoorString>;
    shacl:datatype xsd:string;
    shacl:description "Naam vd agent die de identificator heeft toegekend."@nl;
    shacl:maxCount 1;
    shacl:name "toegekend door String"@nl;
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend op"@nl;
    rdfs:comment "Tijdstip waarop de identificator werd uitgegeven."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Identificator.ToegekendOp>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount 1;
    shacl:name "toegekend op"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "gestructureerde identificator"@nl;
    rdfs:comment "Identificator vh object opgesplitst in zijn onderdelen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/GEODCAT-AP-VL/erkendestandaard/2026-02-12#Identificator.GestructureerdeIdentificator>;
    shacl:class <http://data.vlaanderen.be/ns/generiek#GestructureerdeIdentificator>;
    shacl:description "Identificator vh object opgesplitst in zijn onderdelen."@nl;
    shacl:maxCount 1;
    shacl:name "gestructureerde identificator"@nl;
    shacl:path <http://data.vlaanderen.be/ns/generiek#gestructureerdeIdentificator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door"@nl;
