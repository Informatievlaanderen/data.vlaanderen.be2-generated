{
  "title": "Dataservice",
  "type": "object",
  "description": "Een verzameling van operaties die ofwel toegang bieden tot één of meer datasets ofwel een dataverwerkingsdoel hebben.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Dataservice)",
      "pattern": "^Dataservice$"
    },
    "beschrijving": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Een bondige tekstuele omschrijving van de dataservice. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "creatiedatum": {
      "type": "object",
      "description": "Het tijdsmoment waarop de dataservice voor het eerst werd geactiveerd.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "endpointbeschrijving": {
      "type": "object",
      "description": "Een beschrijving van de diensten die beschikbaar zijn via de end-points, met inbegrip van hun operaties, parameters, enz.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "endpointURL": {
      "type": "object",
      "description": "De rootlocatie of het primaire endpoint van de dienst (een web-resolvable URI).",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "identificator": {
      "type": "object",
      "description": "De unieke identificator van de dataservice.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "landingspagina": {
      "type": "array",
      "description": "Lijst van URi items.",
      "items": {
        "type": "object",
        "description": "Een algemene webpagina waarnaar kan worden genavigeerd in een webbrowser, met algemene aanvullende informatie over de dataservice.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "@id"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "landingspaginaVoorAuthenticatie": {
      "type": "object",
      "description": "Een verwijzing naar de landingspagina met de specifieke informatie over de authenticatie voor de dataservice. Deze eigenschap capteert een onderdeel van de beschrijvende informatie over de service beschreven in de landingspagina. Enkel te gebruiken indien men kan verwijzen naar een sectie of een aparte pagina waar deze specifieke informatie beschikbaar is.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "landingspaginaVoorGebruiksinformatie": {
      "type": "object",
      "description": "Een verwijzing naar de landingspagina met de specifieke informatie over het gebruik van de dataservice. Deze eigenschap capteert een onderdeel van de beschrijvende informatie over de service beschreven in de landingspagina. Enkel te gebruiken indien men kan verwijzen naar een sectie of een aparte pagina waar deze specifieke informatie beschikbaar is.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "landingspaginaVoorStatusinformatie": {
      "type": "object",
      "description": "Een verwijzing naar de statuspagina van de dataservice Deze eigenschap capteert een onderdeel van de beschrijvende informatie over de service beschreven in de landingspagina. Enkel te gebruiken indien men kan verwijzen naar een sectie of een aparte pagina waar deze specifieke informatie beschikbaar is.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "publicatiedatum": {
      "type": "object",
      "description": "Het tijdsmoment waarop de service werd gepubliceerd door de uitgever.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "titel": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "De naam van de dataservice. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "trefwoord": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Een trefwoord of tag die de resource beschrijft. De meertaligheid is hier verschillend als voor een beschrijvende eigenschap. De taal van elk trefwoord moet aangeduidt worden. Echter het is niet de verwachting dat elk trefwoord in elke taal vertaald wordt. Ook is het niet zo dat er slecht 1 trefwoord per taal is. Er kunnen (zullen) er meerderen zijn.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "versie": {
      "type": "object",
      "description": "Een unieke aanduiding van een variant van de dataservice door middel van een versienummer of -naam van de dataservice. Voor dataservices wordt dikwijls <a href=\"https://semver.org/lang/nl/\">semantisch versioneren</a> gebruikt. Bij het deployen van services wordt aangeraden om enkel de major version op te nemen in de endpointurl. De versieinformatie die hier opgegeven wordt komt best overeen met de versie die beschikbaar is in de endpointurl.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "wijzigingsdatum": {
      "type": "object",
      "description": "Het tijdsmoment waarop de dataservice werd gewijzigd",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "alternatieveIdentificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1,
      "maxItems": null
    },
    "conformAanProtocol": {
      "type": "array",
      "description": "Lijst van Standaard items.",
      "items": {
        "$ref": "#/components/schemas/Standaard"
      },
      "minItems": 1,
      "maxItems": null
    },
    "contactinformatie": {
      "$ref": "#/components/schemas/Contactinfo"
    },
    "geografischeDekking": {
      "type": "array",
      "description": "Lijst van Plaats items.",
      "items": {
        "$ref": "#/components/schemas/Plaats"
      },
      "minItems": 1,
      "maxItems": null
    },
    "levensfase": {
      "$ref": "#/components/schemas/Code"
    },
    "licentie": {
      "$ref": "#/components/schemas/LicentieDocument"
    },
    "ontwikkelingstoestand": {
      "$ref": "#/components/schemas/Code"
    },
    "rechten": {
      "type": "array",
      "description": "Lijst van JuridischeBepaling items.",
      "items": {
        "$ref": "#/components/schemas/JuridischeBepaling"
      },
      "minItems": 1,
      "maxItems": null
    },
    "serviceCategorie": {
      "type": "array",
      "description": "Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1,
      "maxItems": null
    },
    "serviceType": {
      "type": "array",
      "description": "Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1,
      "maxItems": null
    },
    "statuut": {
      "type": "array",
      "description": "Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1,
      "maxItems": null
    },
    "thema": {
      "type": "array",
      "description": "Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1,
      "maxItems": null
    },
    "toegankelijkheid": {
      "$ref": "#/components/schemas/Code"
    },
    "biedtInformatieAanOver": {
      "type": "array",
      "description": "Lijst van Dataset items.",
      "items": {
        "$ref": "#/components/schemas/Dataset"
      },
      "minItems": 1,
      "maxItems": null
    },
    "relatie": {
      "type": "array",
      "description": "Lijst van CatalogusResource items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/CatalogusResource"
          },
          {
            "$ref": "#/components/schemas/Dataservice"
          },
          {
            "$ref": "#/components/schemas/Dataset"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "CatalogusResource": "#/components/schemas/CatalogusResource",
            "Dataservice": "#/components/schemas/Dataservice",
            "Dataset": "#/components/schemas/Dataset"
          }
        }
      },
      "minItems": 1,
      "maxItems": null
    },
    "uitgever": {
      "$ref": "#/components/schemas/Agent"
    }
  },
  "required": [
    "@type",
    "endpointbeschrijving",
    "identificator",
    "titel",
    "contactinformatie",
    "toegankelijkheid",
    "uitgever"
  ]
}