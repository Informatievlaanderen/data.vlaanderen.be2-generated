{
  "title": "Resolutie",
  "type": "object",
  "description": "De maat van detail waaronder data zijn bewaard.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Resolutie)",
      "pattern": "^Resolutie$"
    },
    "waarde": {
      "type": "object",
      "description": "De waarde van resolutie gemeten volgens de bijhorende methode.",
      "properties": {
        "@value": {
          "type": "string",
          "pattern": "(+|-)?([0-9]+(.[0-9]*)?|.[0-9]+)"
        },
        "@type": {
          "type": "string",
          "pattern": "^Decimal$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "resolutieMethode": {
      "$ref": "#/components/schemas/Code"
    }
  },
  "required": [
    "@type",
    "waarde",
    "resolutieMethode"
  ]
}