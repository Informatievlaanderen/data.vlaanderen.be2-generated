{
  "title": "Dataset",
  "type": "object",
  "description": "Een verzameling gegevens, gepubliceerd of samengesteld door één agent, en beschikbaar voor toegang of download in één of meerdere voorstellingswijzen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Dataset)",
      "pattern": "^Dataset$"
    },
    "versie": {
      "type": "object",
      "description": "Een unieke aanduiding van een variant van de dataset door middel van een versienummer of -naam van de dataset.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "beschrijving": {
      "type": "array",
      "description": "Lijst van TaalString items.",
      "items": {
        "type": "object",
        "description": "Een bondige tekstuele omschrijving van de dataset. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "trefwoord": {
      "type": "array",
      "description": "Lijst van TaalString items.",
      "items": {
        "type": "object",
        "description": "Een trefwoord of tag die de resource beschrijft. De meertaligheid is hier verschillend als voor een beschrijvende eigenschap. De taal van elk trefwoord moet aangeduidt worden. Echter het is niet de verwachting dat elk trefwoord in elke taal vertaald wordt. Ook is het niet zo dat er slecht 1 trefwoord per taal is. Er kunnen (zullen) er meerderen zijn.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "titel": {
      "type": "array",
      "description": "Lijst van TaalString items.",
      "items": {
        "type": "object",
        "description": "De naam van de dataset. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "identificator": {
      "type": "object",
      "description": "De unieke identificator van de dataset.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "publicatiedatum": {
      "type": "object",
      "description": "Het tijdsmoment waarop de dataset werd gepubliceerd door de uitgever.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "wijzigingsdatum": {
      "type": "object",
      "description": "Het tijdsmoment waarop de dataset werd geactualiseerd",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "creatiedatum": {
      "type": "object",
      "description": "Het tijdsmoment waarop de dataset ontstaan is.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "toegankelijkheid": {
      "$ref": "#/components/schemas/Code"
    },
    "alternatieveIdentificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1,
      "maxItems": null
    },
    "conform": {
      "type": "array",
      "description": "Lijst van Standaard items.",
      "items": {
        "$ref": "#/components/schemas/Standaard"
      },
      "minItems": 1,
      "maxItems": null
    },
    "ruimtelijkVoorstellingstype": {
      "$ref": "#/components/schemas/Code"
    },
    "voorbeeldweergave": {
      "type": "array",
      "description": "Lijst van Voorbeeldweergave items.",
      "items": {
        "$ref": "#/components/schemas/Voorbeeldweergave"
      },
      "minItems": 1,
      "maxItems": null
    },
    "status": {
      "$ref": "#/components/schemas/Code"
    },
    "statuut": {
      "type": "array",
      "description": "Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1,
      "maxItems": null
    },
    "thema": {
      "type": "array",
      "description": "Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1,
      "maxItems": null
    },
    "landingspagina": {
      "type": "array",
      "description": "Lijst van URI items.",
      "items": {
        "$ref": "#/components/schemas/URI"
      },
      "minItems": 1,
      "maxItems": null
    },
    "ruimtelijkeResolutie": {
      "$ref": "#/components/schemas/Resolutie"
    },
    "iSOCategorie": {
      "type": "array",
      "description": "Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1,
      "maxItems": null
    },
    "iNSPIREThema": {
      "type": "array",
      "description": "Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1,
      "maxItems": null
    },
    "gEMETConcept": {
      "type": "array",
      "description": "Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1,
      "maxItems": null
    },
    "herkomst": {
      "type": "array",
      "description": "Lijst van HerkomstVerklaring items.",
      "items": {
        "$ref": "#/components/schemas/HerkomstVerklaring"
      },
      "minItems": 1,
      "maxItems": null
    },
    "contactinformatie": {
      "$ref": "#/components/schemas/Contactinfo"
    },
    "geografischeDekking": {
      "type": "array",
      "description": "Lijst van Plaats items.",
      "items": {
        "$ref": "#/components/schemas/Plaats"
      },
      "minItems": 1,
      "maxItems": null
    },
    "distributie": {
      "type": "array",
      "description": "Lijst van Distributie items.",
      "items": {
        "$ref": "#/components/schemas/Distributie"
      },
      "minItems": 1,
      "maxItems": null
    },
    "eigenaar": {
      "type": "array",
      "description": "Lijst van Agent items.",
      "items": {
        "$ref": "#/components/schemas/Agent"
      },
      "minItems": 1,
      "maxItems": null
    },
    "inserie": {
      "type": "array",
      "description": "Lijst van DatasetSerie items.",
      "items": {
        "$ref": "#/components/schemas/DatasetSerie"
      },
      "minItems": 1,
      "maxItems": null
    },
    "uitgever": {
      "$ref": "#/components/schemas/Agent"
    },
    "relatie": {
      "type": "array",
      "description": "Lijst van CatalogusResource items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/CatalogusResource"
          },
          {
            "$ref": "#/components/schemas/Dataset"
          },
          {
            "$ref": "#/components/schemas/Dataservice"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "CatalogusResource": "#/components/schemas/CatalogusResource",
            "Dataset": "#/components/schemas/Dataset",
            "Dataservice": "#/components/schemas/Dataservice"
          }
        }
      },
      "minItems": 1,
      "maxItems": null
    }
  },
  "required": [
    "@type",
    "beschrijving",
    "titel",
    "identificator",
    "toegankelijkheid",
    "contactinformatie",
    "geografischeDekking",
    "uitgever"
  ]
}