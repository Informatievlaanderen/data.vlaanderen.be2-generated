{
  "title": "CatalogusRecord",
  "type": "object",
  "description": "Een record in een catalogus beschrijft de registratie van één resource in de catalogus.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse CatalogusRecord)",
      "pattern": "^CatalogusRecord$"
    },
    "aanmaakdatum": {
      "type": "object",
      "description": "De datum van (formele) opname van de bijbehorende dataset of dataservice in de catalogus.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "bronMetadatarecord": {
      "type": "object",
      "description": "De record in een andere catalogus waarvan deze record en de beschrijvingen van het bijhorende hoofdonderwerp van afgeleid zijn. Hiermee vindt men de ISO metadata terug waarvan de GeoDCAT-AP Vlaanderen beschrijving is afgeleid.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bronMetadataRecordLandingspagina": {
      "type": "object",
      "description": "Een webpagina in een menselijk leesbare vorm van de bron metadata record. Bij voorkeur, zet in op de eigenschap bron metadata record, om een machine leesbare vorm te delen.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "identificator": {
      "type": "object",
      "description": "De unieke identificator van het record in de catalogus.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "titel": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "De naam van het record in de catalogus. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "wijzigingsdatum": {
      "type": "object",
      "description": "De meest recente datum waarop de record in de catalogus is gewijzigd, bijgewerkt of aangepast.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "alternatieveIdentificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1,
      "maxItems": null
    },
    "conform": {
      "type": "array",
      "description": "Lijst van Standaard items.",
      "items": {
        "$ref": "#/components/schemas/Standaard"
      },
      "minItems": 1,
      "maxItems": null
    },
    "hoofdonderwerp": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/CatalogusResource"
        },
        {
          "$ref": "#/components/schemas/Dataservice"
        },
        {
          "$ref": "#/components/schemas/Dataset"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "CatalogusResource": "#/components/schemas/CatalogusResource",
          "Dataservice": "#/components/schemas/Dataservice",
          "Dataset": "#/components/schemas/Dataset"
        }
      }
    }
  },
  "required": [
    "@type",
    "identificator",
    "wijzigingsdatum",
    "hoofdonderwerp"
  ]
}