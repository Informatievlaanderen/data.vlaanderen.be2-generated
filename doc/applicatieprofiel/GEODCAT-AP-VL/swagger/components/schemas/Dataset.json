{
  "title": "Dataset",
  "type": "object",
  "description": "Een verzameling gegevens,gepubliceerd of samengesteld door één agent,en beschikbaar voor toegang of download in één of meerdere voorstellingswijzen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Dataset)",
      "pattern": "^Dataset$"
    },
    "beschrijving": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Een bondige tekstuele omschrijving van de dataset. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "creatiedatum": {
      "type": "object",
      "description": "Het tijdsmoment waarop de dataset ontstaan is.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "identificator": {
      "type": "object",
      "description": "De unieke identificator van de dataset.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "landingspagina": {
      "type": "array",
      "description": "Lijst van URi items.",
      "items": {
        "type": "object",
        "description": "Een algemene webpagina waarnaar kan worden genavigeerd in een webbrowser, met algemene informatie over de dataset, zijn distributies en/of aanvullende informatie. De mapping zal de landingspagina invullen met de URL naar de metadata voorstelling waarvan de dataset is afgeleid.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "@id"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "publicatiedatum": {
      "type": "object",
      "description": "Het tijdsmoment waarop de dataset werd gepubliceerd door de uitgever.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "titel": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "De naam van de dataset. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "trefwoord": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Een trefwoord of tag die de resource beschrijft. De meertaligheid is hier verschillend als voor een beschrijvende eigenschap. De taal van elk trefwoord moet aangeduidt worden. Echter het is niet de verwachting dat elk trefwoord in elke taal vertaald wordt. Ook is het niet zo dat er slecht 1 trefwoord per taal is. Er kunnen (zullen) er meerdere zijn.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "versie": {
      "type": "object",
      "description": "Een unieke aanduiding van een variant van de dataset door middel van een versienummer of -naam van de dataset.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "wijzigingsdatum": {
      "type": "object",
      "description": "Het tijdsmoment waarop de dataset werd geactualiseerd",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "conform": {
      "type": "array",
      "description": "Lijst van Standaard items.",
      "items": {
        "$ref": "#/components/schemas/Standaard"
      },
      "minItems": 1,
      "maxItems": null
    },
    "contactinformatie": {
      "$ref": "#/components/schemas/Contactinfo"
    },
    "geografischeDekking": {
      "type": "array",
      "description": "Lijst van Plaats items.",
      "items": {
        "$ref": "#/components/schemas/Plaats"
      },
      "minItems": 1,
      "maxItems": null
    },
    "herkomst": {
      "type": "array",
      "description": "Lijst van HerkomstVerklaring items.",
      "items": {
        "$ref": "#/components/schemas/HerkomstVerklaring"
      },
      "minItems": 1,
      "maxItems": null
    },
    "ruimtelijkeResolutie": {
      "$ref": "#/components/schemas/Resolutie"
    },
    "voorbeeldweergave": {
      "type": "array",
      "description": "Lijst van Voorbeeldweergave items.",
      "items": {
        "$ref": "#/components/schemas/Voorbeeldweergave"
      },
      "minItems": 1,
      "maxItems": null
    },
    "distributie": {
      "type": "array",
      "description": "Lijst van Distributie items.",
      "items": {
        "$ref": "#/components/schemas/Distributie"
      },
      "minItems": 1,
      "maxItems": null
    },
    "inserie": {
      "type": "array",
      "description": "Lijst van DatasetSerie items.",
      "items": {
        "$ref": "#/components/schemas/DatasetSerie"
      },
      "minItems": 1,
      "maxItems": null
    },
    "relatie": {
      "type": "array",
      "description": "Lijst van CatalogusResource items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/CatalogusResource"
          },
          {
            "$ref": "#/components/schemas/Dataservice"
          },
          {
            "$ref": "#/components/schemas/Dataset"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "CatalogusResource": "#/components/schemas/CatalogusResource",
            "Dataservice": "#/components/schemas/Dataservice",
            "Dataset": "#/components/schemas/Dataset"
          }
        }
      },
      "minItems": 1,
      "maxItems": null
    }
  },
  "required": [
    "@type",
    "beschrijving",
    "identificator",
    "titel",
    "contactinformatie",
    "geografischeDekking"
  ]
}