{
  "title": "DatasetSerie",
  "type": "object",
  "description": "Een verzameling die onafhankelijk gepubliceerde datasets groepeert rond gedeelde eigenschappen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse DatasetSerie)",
      "pattern": "^DatasetSerie$"
    },
    "beschrijving": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Een bondige tekstuele beschrijving van de Dataset Serie.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "identificator": {
      "type": "object",
      "description": "De unieke identificator van de Dataset Serie.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "titel": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "De naam van de Dataset Serie.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "alternatieveIdentificator": {
      "$ref": "#/components/schemas/Identificator"
    },
    "belanghebbendeWetgeving": {
      "type": "array",
      "description": "Lijst van Rechtsgrond items.",
      "items": {
        "$ref": "#/components/schemas/Rechtsgrond"
      },
      "minItems": 1
    },
    "contactinformatie": {
      "$ref": "#/components/schemas/Contactinfo"
    },
    "geografischeDekking": {
      "type": "array",
      "description": "Lijst van Plaats items.",
      "items": {
        "$ref": "#/components/schemas/Plaats"
      },
      "minItems": 1
    },
    "periodiciteit": {
      "$ref": "#/components/schemas/Frequentie"
    },
    "publicatieDatum": {
      "type": "object",
      "description": "Het tijdsmoment waarop de Dataset Serie werd gepubliceerd door de uitgever. Dit is het moment wanneer de Dataset Serie voor het eerst publiekelijk kenbaar gemaakt is. Het is niet noodzakelijk gekijk aan de publicatie datum van de oudste dataset in de verzameling.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "temporeleDekking": {
      "type": "array",
      "description": "Lijst van Tijdsperiode items.",
      "items": {
        "$ref": "#/components/schemas/Tijdsperiode"
      },
      "minItems": 1
    },
    "wijzigingsdatum": {
      "type": "object",
      "description": "Het meest recente moment waarop de Dataset Serie is bijgewerkt. Dit is niet noodzakelijk hetzelfde moment als de meest recente wijzigingsdatum van de datasets die de Dataset Serie bevat.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "uitgever": {
      "type": "array",
      "description": "Lijst van Agent items.",
      "items": {
        "$ref": "#/components/schemas/Agent"
      },
      "minItems": 1,
      "maxItems": null
    }
  },
  "required": [
    "@type",
    "beschrijving",
    "identificator",
    "titel",
    "alternatieveIdentificator",
    "contactinformatie"
  ]
}