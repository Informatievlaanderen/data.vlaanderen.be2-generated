{
  "title": "Distributie",
  "type": "object",
  "description": "Een specifieke voorstellingswijze van een dataset, gekenmerkt door één of meerdere eigenschappen zoals taal, media-type of formaat, schematische organisatie, temporele en ruimtelijke resolutie, granulariteit, ...",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Distributie)",
      "pattern": "^Distributie$"
    },
    "identificator": {
      "type": "object",
      "description": "De unieke identificator van de distributie.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "titel": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "De naam van de distributie. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "downloadURL": {
      "type": "object",
      "description": "De URL waar de data gedownload kan worden. [Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Property:distribution_download_url\">DCAT</a>]",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "toegangsURL": {
      "type": "object",
      "description": "Een URL waar de data kan gevonden worden. [Zie <a href=\"https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/#Property:distribution_access_url\">DCAT</a>]",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "rechten": {
      "type": "array",
      "description": "Lijst van JuridischeBepaling items.",
      "items": {
        "$ref": "#/components/schemas/JuridischeBepaling"
      },
      "minItems": 1,
      "maxItems": null
    },
    "alternatieveIdentificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1,
      "maxItems": null
    },
    "formaat": {
      "$ref": "#/components/schemas/Code"
    },
    "licentie": {
      "$ref": "#/components/schemas/LicentieDocument"
    },
    "conform": {
      "type": "array",
      "description": "Lijst van Standaard items.",
      "items": {
        "$ref": "#/components/schemas/Standaard"
      },
      "minItems": 1,
      "maxItems": null
    },
    "wordtAangebodenDoor": {
      "type": "array",
      "description": "Lijst van Dataservice items.",
      "items": {
        "$ref": "#/components/schemas/Dataservice"
      },
      "minItems": 1,
      "maxItems": null
    },
    "verdeler": {
      "$ref": "#/components/schemas/Agent"
    }
  },
  "required": [
    "@type",
    "identificator",
    "toegangsURL"
  ]
}