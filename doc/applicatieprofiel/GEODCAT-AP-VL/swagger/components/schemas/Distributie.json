{
  "title": "Distributie",
  "type": "object",
  "description": "Een specifieke voorstellingswijze van een dataset,gekenmerkt door één of meerdere eigenschappen zoals taal,media-type of formaat,schematische organisatie,temporele en ruimtelijke resolutie,granulariteit,...",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Distributie)",
      "pattern": "^Distributie$"
    },
    "downloadURL": {
      "type": "object",
      "description": "De URL waar de data gedownload kan worden. De URL start het downloaden van de distributie.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "identificator": {
      "type": "object",
      "description": "De unieke identificator van de distributie.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "titel": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "De naam van de distributie. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "toegangsURL": {
      "type": "object",
      "description": "Een URL waar de data kan gevonden worden. Deze url kan zowel verwijzen naar een beschrijvende pagina over hoe toegang tot de data kan verkregen worden als naar een directe link waarmee het downloaden van de distributie gestart kan worden. In het tweede geval wordt ook de eigenschap downloadURL bijkomend ingevuld.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "alternatieveIdentificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1,
      "maxItems": null
    },
    "conform": {
      "type": "array",
      "description": "Lijst van Standaard items.",
      "items": {
        "$ref": "#/components/schemas/Standaard"
      },
      "minItems": 1,
      "maxItems": null
    },
    "formaat": {
      "$ref": "#/components/schemas/Code"
    },
    "licentie": {
      "$ref": "#/components/schemas/LicentieDocument"
    },
    "rechten": {
      "type": "array",
      "description": "Lijst van JuridischeBepaling items.",
      "items": {
        "$ref": "#/components/schemas/JuridischeBepaling"
      },
      "minItems": 1,
      "maxItems": null
    },
    "wordtAangebodenDoor": {
      "type": "array",
      "description": "Lijst van Dataservice items.",
      "items": {
        "$ref": "#/components/schemas/Dataservice"
      },
      "minItems": 1,
      "maxItems": null
    }
  },
  "required": [
    "@type",
    "identificator",
    "toegangsURL"
  ]
}