{
  "title": "Plaats",
  "type": "object",
  "description": "Een ruimtelijk gebied dat geïdentificeerd wordt door zijn benaming of geografische beschrijving.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Plaats)",
      "pattern": "^Plaats$"
    },
    "boundingBox": {
      "type": "array",
      "description": "Lijst van Literal items.",
      "items": {
        "type": "object",
        "description": "De afgrenzing van een plaats als een geografische rechthoek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "centroïDe": {
      "type": "array",
      "description": "Lijst van Literal items.",
      "items": {
        "type": "object",
        "description": "Het geografische middelpunt van een plaats.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "geometrie": {
      "type": "array",
      "description": "Lijst van Literal items.",
      "items": {
        "type": "object",
        "description": "De geografische beschrijving van een plaats.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "plaatsnaam": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Een eenduidige, beknopte beschrijving die de plaats benoemt. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    }
  },
  "required": [
    "@type"
  ]
}