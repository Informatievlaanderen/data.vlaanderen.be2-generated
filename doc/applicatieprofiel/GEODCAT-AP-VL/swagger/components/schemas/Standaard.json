{
  "title": "Standaard",
  "type": "object",
  "description": "Een specificatie of document dat een referentie vormt waartegen men een entiteit,of het gebruik ervan kan aftoetsen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Standaard)",
      "pattern": "^Standaard$"
    },
    "titel": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "De naam van de standaard. Omwille van de meertaligheid kunnen er meerdere waarden zijn. De gewenste interpretatie van de cardinaliteit is: per taal slechts 1 waarde.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1,
      "maxItems": null
    },
    "versie": {
      "type": "object",
      "description": "De versie van de standaard.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "voorkeurslabel": {
      "type": "object",
      "description": "Een afkorting, of notatie waaronder de\r\nstandaard bekend is. Bijvoorbeeld voor ISO standaarden kan dit het nummer zijn.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "beschrijving": {
      "type": "object",
      "description": "Een bondige tekstuele omschrijving van de standaard.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "publicatiedatum": {
      "type": "object",
      "description": "De datum waarop de standaard werd\ngepubliceerd.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "specificatieURL": {
      "type": "object",
      "description": "Een URL waarop men de specificatie kan\nvinden.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "type": {
      "type": "array",
      "description": "Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1,
      "maxItems": null
    }
  },
  "required": [
    "@type"
  ]
}