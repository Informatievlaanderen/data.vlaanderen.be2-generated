{
  "title": "Standaard",
  "type": "object",
  "description": "Een specificatie of document dat een referentie vormt waartegen men een entiteit,of het gebruik ervan kan aftoetsen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Standaard)",
      "pattern": "^Standaard$"
    },
    "versie": {
      "type": "object",
      "description": "De versie van de standaard",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "voorkeurslabel": {
      "type": "object",
      "description": "Een afkorting, of notatie waaronder de\r\nstandaard bekend is. Bijvoorbeeld voor ISO standaarden kan dit het nummer zijn.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "publicatiedatum": {
      "type": "object",
      "description": "De datum waarop de standaard werd\r\ngepubliceerd",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "specificatieURL": {
      "type": "object",
      "description": "Een URL waarop men de specificatie kan\r\nvinden",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    }
  },
  "required": [
    "@type"
  ]
}