{
  "title": "Voorbeeldweergave",
  "type": "object",
  "description": "Een afbeelding ter illustratie van de geassocieerde data.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Voorbeeldweergave)",
      "pattern": "^Voorbeeldweergave$"
    },
    "downloadURL": {
      "type": "object",
      "description": "De URL waar de afbeelding gedownload kan worden.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    }
  },
  "required": [
    "@type",
    "downloadURL"
  ]
}