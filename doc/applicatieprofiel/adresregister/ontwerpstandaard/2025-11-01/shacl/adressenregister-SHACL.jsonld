  {
    "@id": "https://data.test-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/2025-11-01#AgentShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Agent"
      }
    ],
