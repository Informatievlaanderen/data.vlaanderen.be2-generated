  {
    "@id": "https://data.test-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/2025-11-01#GebouweenheidShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De kleinste eenheid binnen een gebouw die geschikt is voor woon-, bedrijfsmatige, of recreatieve doeleinden en die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde circulatieruimte. Een gebouweenheid is in functioneel opzicht zelfstandig. Daarnaast kan een gebouweenheid ook een gemeenschappelijk deel zijn."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Gebouweenheid"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/gebouw#Gebouweenheid"
      }
    ]
  },
  {
    "@id": "https://data.test-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/2025-11-01#GebouwShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een gesloten en/of overdekt, bovengronds of ondergronds bouwwerk, dat dient of bestemd is, ofwel om mensen, dieren en voorwerpen onder te brengen, ofwel om economische goederen te vervaardigen of diensten te verstrekken. Een gebouw verwijst naar gelijk welke structuur die op blijvende wijze op een terrein opgetrokken of gebouwd wordt."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Gebouw"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_2_51"
      },
      {
        "@id": "_:df_2_52"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/gebouw#Gebouw"
      }
    ]
  },
  {
    "@id": "https://data.test-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/2025-11-01#GemeentenaamShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Adrescomponent die verwijst naar de naam van een gemeente, het is te zeggen het kleinste administratieve deel van het Belgisch grondgebied waarvan de grenzen enkel door de wetgever kunnen worden gewijzigd."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Gemeentenaam"
      }
    ],
