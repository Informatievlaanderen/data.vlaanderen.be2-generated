{
  "title": "BelgischAdres",
  "type": "object",
  "description": "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid, een ligplaats, een standplaats of een perceel op basis van een gemeentenaam, een straatnaam, een huisnummer en eventueel een busnummer en een postcode.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse BelgischAdres)",
      "pattern": "^BelgischAdres$"
    },
    "busnummer": {
      "$ref": "#/components/schemas/BelgischAdres.busnummer"
    },
    "huisnummer": {
      "$ref": "#/components/schemas/BelgischAdres.huisnummer"
    },
    "officieelToegekend": {
      "$ref": "#/components/schemas/BelgischAdres.officieelToegekend"
    },
    "positie": {
      "$ref": "#/components/schemas/GeografischePositie"
    },
    "status": {
      "$ref": "#/components/schemas/Statuswaarde"
    },
    "isVerrijktMet": {
      "$ref": "#/components/schemas/Adresuitbreiding"
    },
    "heeftGemeentenaam": {
      "$ref": "#/components/schemas/Gemeentenaam"
    },
    "toegeschrevenAan": {
      "$ref": "#/components/schemas/Gemeente"
    },
    "heeftStraatnaam": {
      "$ref": "#/components/schemas/Straatnaam"
    },
    "heeftPostinfo": {
      "$ref": "#/components/schemas/Postinfo"
    },
    "isToegekendAan": {
      "type": "array",
      "description": "Adresseerbaar object waaraan het adres is toegekend. Lijst van AdresseerbaarObject items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Ligplaats"
          },
          {
            "$ref": "#/components/schemas/Standplaats"
          },
          {
            "$ref": "#/components/schemas/Gebouweenheid"
          },
          {
            "$ref": "#/components/schemas/Perceel"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Ligplaats": "#/components/schemas/Ligplaats",
            "Standplaats": "#/components/schemas/Standplaats",
            "Gebouweenheid": "#/components/schemas/Gebouweenheid",
            "Perceel": "#/components/schemas/Perceel"
          }
        }
      },
      "minItems": 1
    },
    "identificator": {
      "type": "array",
      "description": "Identificator van het object. Bij implementatie in RDF is de uri van het object de identificator. Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "huisnummer",
    "officieelToegekend",
    "positie",
    "status",
    "heeftGemeentenaam",
    "toegeschrevenAan",
    "heeftStraatnaam",
    "heeftPostinfo",
    "identificator"
  ]
}