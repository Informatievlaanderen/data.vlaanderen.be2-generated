      {
        "@id": "_:df_8_52"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/gebouw#Gebouw"
      }
    ]
  },
  {
