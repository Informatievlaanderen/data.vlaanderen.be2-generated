<https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#AdreslocatorShape> a shacl:NodeShape;
  rdfs:label "Adreslocator"@nl;
  rdfs:comment "Menselijk leesbare aanduiding of naam die een gebruiker of applicatie toelaat om het adres te onderscheiden van naburige adressen in de straat, de administratieve eenheid etc waarin het adres ligt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanduiding"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Alfanumerieke code die de locator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adreslocator.Aanduiding>;
    shacl:class <https://data.vlaanderen.be/ns/adres#Locatieaanduiding>;
    shacl:description "Alfanumerieke code die de locator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    shacl:name "aanduiding"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#aanduiding>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam of omschrijving vh het geografisch object dat de locator aanduidt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adreslocator.Naam>;
    shacl:class <https://data.vlaanderen.be/ns/adres#Locatienaam>;
    shacl:description "Naam of omschrijving vh het geografisch object dat de locator aanduidt."@nl;
    shacl:name "naam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#naam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "niveau"@nl;
    <http://purl.org/vocab/vann/usageNote> "Waarbij het niveau staat voor de geografische granulariteit vd locator: zo verwijzen locators vh type huisnummer doorgaans naar het gebouw terwijl busnummers naar een deel vh gebouw verwijzen."@nl;
    rdfs:comment "Het niveau waarnaar de locator verwijst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adreslocator.Niveau>;
    shacl:class skos:Concept;
    shacl:description "Het niveau waarnaar de locator verwijst."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "niveau"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#niveau>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#Adreslocator> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#AdresseerbaarObjectShape> a shacl:NodeShape;
  rdfs:label "Adresseerbaar Object"@nl;
  <http://purl.org/vocab/vann/usageNote> "Is abstract, ttz het type adresseerbaar object moet altijd worden opgegeven (vb gebouweenheid, perceel)."@nl;
  rdfs:comment "Geografisch object dat met een adres kan worden geïdentificeerd."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#AdresseerbaarObject> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#AdresuitbreidingShape> a shacl:NodeShape;
  rdfs:label "Adresuitbreiding"@nl;
  <http://purl.org/vocab/vann/usageNote> "Gegevens die officieel geen deel uitmaken ve adres, bv de verdieping of de provincie..."@nl;
  rdfs:comment "Bijkomende gegevens mbt het adres."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "adreslocator"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Bijkomende adreslocator."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresuitbreiding.Adreslocator>;
    shacl:class <https://data.vlaanderen.be/ns/adres#Adreslocator>;
    shacl:description "Bijkomende adreslocator."@nl;
    shacl:name "adreslocator"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#adreslocator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volledig adres"@nl;
    <http://purl.org/vocab/vann/usageNote> "Vermijdt fouten tgv het opsplitsen ve adres in zijn onderdelen. Geeft de voorgeschreven volgorde vd verschillende onderdelen weer."@nl;
    rdfs:comment "Het complete adres in één string, al dan niet geformatteerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresuitbreiding.VolledigAdres>;
    shacl:class rdf:langString;
    shacl:description "Het complete adres in één string, al dan niet geformatteerd."@nl;
    shacl:name "volledig adres"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#volledigAdres>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is gelegen in"@nl;
    rdfs:comment "Plaats of gebied waarbinnen het Adres gelegen is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresuitbreiding.IsGelegenIn>;
    shacl:class dc:Location;
    shacl:description "Plaats of gebied waarbinnen het Adres gelegen is."@nl;
    shacl:name "is gelegen in"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#adresIsGelegenIn>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#Adresuitbreiding> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv als attribuut ve persoon of gebouw... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding tbv Belgische adressen."@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding tbv Belgische adressen."@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatieaanduiding"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Alfanumerieke code die de adreslocator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Locatieaanduiding>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code die de adreslocator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    shacl:name "locatieaanduiding"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorDesignator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postbus"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Postbusnummer in een postkantoor."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Postbus>;
    shacl:datatype xsd:string;
    shacl:description "Postbusnummer in een postkantoor."@nl;
    shacl:maxCount "1";
    shacl:name "postbus"@nl;
    shacl:path <http://www.w3.org/ns/locn#poBox>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 1"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Hoogste Administratieve eenheid vh adres, doorgaans een land."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.AdministratieveEenheidNiveau1>;
    shacl:class rdf:langString;
    shacl:description "Hoogste Administratieve eenheid vh adres, doorgaans een land."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 1"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL1>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 2"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "De regio vh adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.AdministratieveEenheidNiveau2>;
    shacl:class rdf:langString;
    shacl:description "De regio vh adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 2"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL2>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adresgebied"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb de naam vh gehucht waarin het adres ligt."@nl;
    rdfs:comment "Naam ve geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Adresgebied>;
    shacl:class rdf:langString;
    shacl:description "Naam ve geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is"@nl;
    shacl:maxCount "1";
    shacl:name "adresgebied"@nl;
    shacl:path <http://www.w3.org/ns/locn#addressArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Gemeentenaam vh adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Gemeentenaam>;
    shacl:class rdf:langString;
    shacl:description "Gemeentenaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Land>;
    shacl:class rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatienaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam of omschrijving vh het geografisch object dat de adreslocator aanduidt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Locatienaam>;
    shacl:class rdf:langString;
    shacl:description "Naam of omschrijving vh het geografisch object dat de adreslocator aanduidt."@nl;
    shacl:name "locatienaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/adresregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Postnaam>;
    shacl:class rdf:langString;
    shacl:description "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
