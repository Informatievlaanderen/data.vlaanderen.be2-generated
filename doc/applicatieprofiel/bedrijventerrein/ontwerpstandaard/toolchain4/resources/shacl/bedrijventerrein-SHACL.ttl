<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#EconomischGebiedShape> a shacl:NodeShape;
  rdfs:label "Economisch Gebied"@nl;
  rdfs:comment "Een economisch gebied is een gebied dat afgebakend wordt op basis van dichtheid van hoofdzakelijk bebouwde percelen met economische activiteiten, waarbij de dichtheid wordt uitgedrukt in nabijheid of de afstand tussen deze percelen. De afstand tussen deze percelen, de mix van economische activiteiten en het voorkomen van een gedeelde infrastructuur zijn bepalend voor de differentiatie tussen de types economische gebieden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "dominante economische activiteit"@nl;
    rdfs:comment "De voornaamste economische activiteit dat geassocieerd kan worden met het Economisch Gebied"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#EconomischGebied.DominanteEconomischeActiviteit>;
    shacl:class skos:Concept;
    shacl:description "De voornaamste economische activiteit dat geassocieerd kan worden met het Economisch Gebied"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "dominante economische activiteit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bedrijventerrein#dominanteEconomischeActiviteit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is gerelateerd aan economisch gebied"@nl;
    rdfs:comment "Economisch Gebied waarmee het bedrijventerrein kan geassocieerd worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#EconomischGebied.IsGerelateerdAanEconomischGebied>;
    shacl:class <https://data.vlaanderen.be/ns/bedrijventerrein#Bedrijventerrein>;
    shacl:description "Economisch Gebied waarmee het bedrijventerrein kan geassocieerd worden."@nl;
    shacl:name "is gerelateerd aan economisch gebied"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bedrijventerrein#EconomischGebied.isGerelateerdAanEconomischGebied>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/bedrijventerrein#EconomischGebied> .

