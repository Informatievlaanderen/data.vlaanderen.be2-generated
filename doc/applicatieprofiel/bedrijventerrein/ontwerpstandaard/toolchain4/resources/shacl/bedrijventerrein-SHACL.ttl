<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Agent.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path schema:contactPoint
  ];
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#BebouwingShape> a shacl:NodeShape;
  rdfs:label "Bebouwing";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#BedrijventerreinShape> a shacl:NodeShape;
  rdfs:label "Bedrijventerrein"@nl;
  rdfs:comment "Som van alle ruimtelijke eenheden uit de ruimtelijke planningsprocedure en met een economische bestemming vanaf de dossierfase Publicatie in Belgisch Staatsblad. Een bedrijventerrein is altijd de unie van de percelen die ertoe behoren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschikbare kavels"@nl;
    rdfs:comment "Deze eigenschap geeft aan of er al dan niet beschikbare kavels aanwezig zijn op het bedrijventerrein."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerrein.BeschikbareKavels>;
    shacl:datatype xsd:boolean;
    shacl:description "Deze eigenschap geeft aan of er al dan niet beschikbare kavels aanwezig zijn op het bedrijventerrein."@nl;
    shacl:maxCount "1";
    shacl:name "beschikbare kavels"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bedrijventerrein#beschikbareKavels>
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve naam"@nl;
    rdfs:comment "Andere naam waaronder het bedrijventerrein bekend is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerrein.AlternatieveNaam>;
    shacl:datatype rdf:langString;
    shacl:description "Andere naam waaronder het bedrijventerrein bekend is."@nl;
    shacl:maxCount "1";
    shacl:name "alternatieve naam"@nl;
    shacl:path skos:altLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Voorkeursnaam van het Bedrijventerrein."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerrein.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Voorkeursnaam van het Bedrijventerrein."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbare oppervlakte"@nl;
    rdfs:comment "Deze eigenschap geeft aan hoeveel oppervlakte nog beschikbaar is op het bedrijventerrein."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerrein.BeschikbareOppervlakte>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Deze eigenschap geeft aan hoeveel oppervlakte nog beschikbaar is op het bedrijventerrein."@nl;
    shacl:maxCount "1";
    shacl:name "beschikbare oppervlakte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bedrijventerrein#beschikbareOppervlakte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is deel van"@nl;
    rdfs:comment "Geeft aan tot welk Bedrijventerrein de Ontwikkelbare Bedrijvenzone behoort."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerrein.IsDeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/bedrijventerrein#OntwikkelbareBedrijvenzone>;
    shacl:description "Geeft aan tot welk Bedrijventerrein de Ontwikkelbare Bedrijvenzone behoort."@nl;
    shacl:name "is deel van"@nl;
    shacl:path dc:isPartOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "is deel van"@nl;
    rdfs:comment "Geeft aan tot welk Bedrijventerrein het Bedrijventerreinperceel behoort."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerrein.IsDeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/bedrijventerrein#Bedrijventerreinperceel>;
    shacl:description "Geeft aan tot welk Bedrijventerrein het Bedrijventerreinperceel behoort."@nl;
    shacl:minCount 1;
    shacl:name "is deel van"@nl;
    shacl:path dc:isPartOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "is gerelateerd aan economisch gebied"@nl;
    rdfs:comment "Economisch Gebied waarmee het bedrijventerrein kan geassocieerd worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerrein.IsGerelateerdAanEconomischGebied>;
    shacl:class <https://data.vlaanderen.be/ns/bedrijventerrein#EconomischGebied>;
    shacl:description "Economisch Gebied waarmee het bedrijventerrein kan geassocieerd worden."@nl;
    shacl:maxCount 1;
    shacl:name "is gerelateerd aan economisch gebied"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bedrijventerrein#Bedrijventerrein.isGerelateerdAanEconomischGebied>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is deel van"@nl;
    rdfs:comment "Geeft aan tot welk Bedrijventerrein de Beheerde Bedrijvenzone behoort."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerrein.IsDeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/bedrijventerrein#BeheerdeBedrijvenzone>;
    shacl:description "Geeft aan tot welk Bedrijventerrein de Beheerde Bedrijvenzone behoort."@nl;
    shacl:name "is deel van"@nl;
    shacl:path dc:isPartOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "is gerelateerd aan"@nl;
    rdfs:comment "Planningszone waarmee het bedrijventerrein kan geassocieerd worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerrein.IsGerelateerdAan>;
    shacl:class <https://data.vlaanderen.be/ns/bedrijventerrein#Planningszone>;
    shacl:description "Planningszone waarmee het bedrijventerrein kan geassocieerd worden."@nl;
    shacl:minCount 1;
    shacl:name "is gerelateerd aan"@nl;
    shacl:path dc:relation
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/bedrijventerrein#Bedrijventerrein> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#BedrijventerreinperceelShape> a shacl:NodeShape;
  rdfs:label "Bedrijventerreinperceel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dit kunnen business centra, KMO units, aaneengesloten bebouwing, meerdere kadastrale of aktepercelen, ... omvatten."@nl;
  rdfs:comment "Een ruimtelijke eenheid binnen een Bedrijventerrein met eenzelfde gebruik, functie of eigenaar."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "bebouwing"@nl;
    <http://purl.org/vocab/vann/usageNote> "Mogelijke waarden kunnen zijn: bebouwd, onbebouw of infrastructuur."@nl;
    rdfs:comment "Deze eigenschap geeft de aanwezigheid van bebouwing aan op het Bedrijventerreinperceel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerreinperceel.Bebouwing>;
    shacl:class skos:Concept;
    shacl:description "Deze eigenschap geeft de aanwezigheid van bebouwing aan op het Bedrijventerreinperceel."@nl;
    shacl:maxCount "1";
    shacl:name "bebouwing"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bedrijventerrein#bebouwing>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beperking"@nl;
    <http://purl.org/vocab/vann/usageNote> "Mogelijke waarden voor dit attribuut zijn: Te saneren, Fysisch niet realiseerbaar, Waterproblematiek, Mobiliteitsproblematiek, Herziening bestemming, Juridische procedure, Reservegrond, Bevriezing door eigenaar of Bevriezing door overheid."@nl;
    rdfs:comment "Deze eigenschap geeft aan welke mogelijke beperking(en) een bepaald bedrijventerreinperceel momenteel ondervindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerreinperceel.Beperking>;
    shacl:class skos:Concept;
    shacl:description "Deze eigenschap geeft aan welke mogelijke beperking(en) een bepaald bedrijventerreinperceel momenteel ondervindt."@nl;
    shacl:name "beperking"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bedrijventerrein#beperking>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbaarheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Mogelijke waarden voor dit attribuut zijn: Aangeboden, Niet aangeboden of optie."@nl;
    rdfs:comment "Deze eigenschap geeft de beschikbaarheid aan van een Bedrijventerreinperceel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerreinperceel.Beschikbaarheid>;
    shacl:class skos:Concept;
    shacl:description "Deze eigenschap geeft de beschikbaarheid aan van een Bedrijventerreinperceel."@nl;
    shacl:maxCount "1";
    shacl:name "beschikbaarheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bedrijventerrein#beschikbaarheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "functie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Modellering geïnspireerd op INSPIRE HILUCS value en HILUCS percentage."@nl;
    rdfs:comment "De functie geeft de (verschillende) functies aan die men kan terugvinden op het Bedrijventerreinperceel en het percentage van het perceel dat gedekt wordt door elke functie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerreinperceel.Functie>;
    shacl:class <https://data.vlaanderen.be/ns/bedrijventerrein#Functiewaarde>;
    shacl:description "De functie geeft de (verschillende) functies aan die men kan terugvinden op het Bedrijventerreinperceel en het percentage van het perceel dat gedekt wordt door elke functie."@nl;
    shacl:minCount "1";
    shacl:name "functie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bedrijventerrein#functie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "in gebruik"@nl;
    rdfs:comment "Dit attribuut geeft aan in welke mate een Bedrijventerreinperceel in gebruik is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerreinperceel.InGebruik>;
    shacl:class skos:Concept;
    shacl:description "Dit attribuut geeft aan in welke mate een Bedrijventerreinperceel in gebruik is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "in gebruik"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bedrijventerrein#inGebruik>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is deel van"@nl;
    rdfs:comment "Geeft aan tot welk Bedrijventerrein het Bedrijventerreinperceel behoort."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerreinperceel.IsDeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/bedrijventerrein#Bedrijventerrein>;
    shacl:description "Geeft aan tot welk Bedrijventerrein het Bedrijventerreinperceel behoort."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is deel van"@nl;
    shacl:path dc:isPartOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "is gerelateerd aan"@nl;
    rdfs:comment "Bedrijventerreinperceel waarmee de ontwikkelbare bedrijvenzone kan geassocieerd worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#Bedrijventerreinperceel.IsGerelateerdAan>;
    shacl:class <https://data.vlaanderen.be/ns/bedrijventerrein#OntwikkelbareBedrijvenzone>;
    shacl:description "Bedrijventerreinperceel waarmee de ontwikkelbare bedrijvenzone kan geassocieerd worden."@nl;
    shacl:name "is gerelateerd aan"@nl;
    shacl:path dc:relation
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/bedrijventerrein#Bedrijventerreinperceel> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#BeheerdeBedrijvenzoneShape> a shacl:NodeShape;
  rdfs:label "Beheerde Bedrijvenzone"@nl;
  rdfs:comment "Een ruimtelijke eenheid binnen een bedrijventerrein afgebakend door het beheer van een agent."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Voorkeursnaam van de Beheerde bedrijvenzone"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bedrijventerrein/ontwerpstandaard/toolchain4#BeheerdeBedrijvenzone.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Voorkeursnaam van de Beheerde bedrijvenzone"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "is deel van"@nl;
    rdfs:comment "Geeft aan tot welk Bedrijventerrein de Beheerde Bedrijvenzone behoort."@nl;
