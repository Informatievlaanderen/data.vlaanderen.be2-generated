    rdfs:label "geometrie"@nl;
    rdfs:comment "De geometrie overeenkomstig met een bepaald gebied."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Gebied.Geometrie>;
    shacl:class <http://www.opengis.net/ont/sf#Polygon>;
    shacl:description "De geometrie overeenkomstig met een bepaald gebied."@nl;
    shacl:maxCount "1";
