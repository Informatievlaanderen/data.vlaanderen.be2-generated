<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#TerreindeelShape> a shacl:NodeShape;
  rdfs:label "Terreindeel"@nl;
  rdfs:comment "Zichtbare laag van het aardoppervlak, met een gelijkaardige functie, dat geen deel uitmaakt van 'waterdeel'."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "breedte"@nl;
    rdfs:comment "De breedte van het object. In geval van een ongelijkmatige breedte wordt de gemiddelde breedte opgenomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Terreindeel.Breedte>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "De breedte van het object. In geval van een ongelijkmatige breedte wordt de gemiddelde breedte opgenomen."@nl;
    shacl:maxCount "1";
    shacl:name "breedte"@nl;
    shacl:path schemas:width
  ], [
    a shacl:PropertyShape;
    rdfs:label "lengte"@nl;
    rdfs:comment "De lineare grootte van het object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Terreindeel.Lengte>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "De lineare grootte van het object."@nl;
    shacl:maxCount "1";
    shacl:name "lengte"@nl;
    shacl:path <http://open.vocab.org/terms/length>
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorkomen"@nl;
    rdfs:comment "Het voorkomen van het terreindeel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Terreindeel.Voorkomen>;
    shacl:class <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#TerreinVoorkomen>;
    shacl:description "Het voorkomen van het terreindeel."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "voorkomen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#voorkomen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftObstakel"@nl;
    rdfs:comment "Het specifieke Element dat een obstakel vormt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Terreindeel.Heeftobstakel>;
    shacl:description "Het specifieke Element dat een obstakel vormt."@nl;
    shacl:name "heeftObstakel"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/openbaardomein#Element>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infrastructuurelement>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Straatmeubilair>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Fietsstalling>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Zitbank>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#OpenbaarToilet>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infozuil>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Aanplakbord>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#OpenbareVuilnisbak>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Deksel>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#ZichtbaarDekselOfLuik>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Afsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#BestendigeAfsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#NormandischeAfsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Draadafsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Paneelafsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SpandraadKetting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SelectieveAfsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Slagboom>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Toegangspoort>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Rooster>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Straatkolk>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#OpenbareVerlichting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Verlichtingspaal>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#OpenbareStraatverlichtingAanGevelOfMuur>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Lichtpunt>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#Graf>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#Columbarium>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#Urnenveld>]);
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#heeftObstakel>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Terreindeel>,
    <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Voetweg>,
    <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Groenvlak>,
    <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Groendak>,
    <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#BegraafplaatsRij>,
    <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#Strooiweide>,
    <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Trap> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#TerreinvoorkomenShape> a shacl:NodeShape;
  rdfs:label "TerreinVoorkomen"@nl;
  rdfs:comment "Beschrijving van het terrein voorkomen van het terreindeel."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "obstakels"@nl;
    rdfs:comment "Eigenschap die aangeeft of er binnen het beheerdeel al dan niet objecten voorkomen die de vrije werking van machines of andere werktuigen kan verhinderen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Terreinvoorkomen.Obstakels>;
    shacl:class skos:Concept;
    shacl:description "Eigenschap die aangeeft of er binnen het beheerdeel al dan niet objecten voorkomen die de vrije werking van machines of andere werktuigen kan verhinderen."@nl;
    shacl:maxCount "1";
    shacl:name "obstakels"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#obstakels>
  ], [
    a shacl:PropertyShape;
    rdfs:label "talud"@nl;
    <http://purl.org/vocab/vann/usageNote> "Naar GRB-skeletaanvulling detail - WTO1: Teen verharde talud; WTO2: Kruin verharde talud; WTO3: Teen onverharde talud; WTO4: Kruin onverharde talud."@nl;
    rdfs:comment "Een talud is het kunstmatig gedeelte van een vlak van de wegbaan, dijken, spoorbanen, vestingswerken, ... dat een helling (min. 20%, max 80% voor kunstmatig verharde taluds) vertoont en bedoeld voor het opvangen van een hoogteverschil."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Terreinvoorkomen.Talud>;
    shacl:class skos:Concept;
    shacl:description "Een talud is het kunstmatig gedeelte van een vlak van de wegbaan, dijken, spoorbanen, vestingswerken, ... dat een helling (min. 20%, max 80% voor kunstmatig verharde taluds) vertoont en bedoeld voor het opvangen van een hoogteverschil."@nl;
    shacl:maxCount "1";
    shacl:name "talud"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#talud>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#TerreinVoorkomen> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#ToegangspoortShape> a shacl:NodeShape;
  rdfs:label "Toegangspoort"@nl;
  <http://purl.org/vocab/vann/usageNote> "Gerelateerd aan object: GRB WSP: Scharnierpunt hek/poort."@nl;
  rdfs:comment "Een object dat de toegang tot een gebied, zone of terreindeel periodiek kan afsluiten."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Toegangspoort> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Traptussen2straatniveausShape> a shacl:NodeShape;
  rdfs:label "TrapTussen2Straatniveaus"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-skeletaanvulling detail - KNW25: Trap tussen 2 straatniveaus."@nl;
  rdfs:comment "Constructie, niet aanleunend bij een gebouw bestaande uit treden die de verbinding vormt tussen 2 straatpeilen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Trap> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#UriShape> a shacl:NodeShape;
  rdfs:label "URI";
  shacl:closed false;
  shacl:targetClass xsd:anyURI .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#UrnenveldShape> a shacl:NodeShape;
  rdfs:label "Urnenveld"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-skeletoptie groen- en begraafplaatsenbeheer - BPU2: Urnenveld."@nl;
  rdfs:comment "Een urnenveld is een constructie in of op de grond met nissen waarin urnen geplaatst worden."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#Urnenveld> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#VerlichtingspaalShape> a shacl:NodeShape;
  rdfs:label "Verlichtingspaal"@nl;
  <http://purl.org/vocab/vann/usageNote> "Geen lichtpunt (beperkte hoogte). Naar GRB-skeletaanvulling detail - WPI1: Paal; WPI102 verlichting."@nl;
  rdfs:comment "Een openbare lichtpunt op een paal dat gebruikt wordt om de omgeving te verlichten."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Verlichtingspaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#VoetwegShape> a shacl:NodeShape;
  rdfs:label "Voetweg"@nl;
  rdfs:comment "Terreindeel, gebruikt als voetweg of pad, bedoeld om zwakke weggebruikers specifiek binnen surplusgebieden te laten circuleren."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Voetweg> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#ZichtbaardekselofluikShape> a shacl:NodeShape;
  rdfs:label "ZichtbaarDekselOfLuik"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-basis - WRI1: Zichtbaar cirkelvormig putdeksel; WRI2: Zichtbaar vierkant putdeksel."@nl;
  rdfs:comment "Een zichtbaar deksel of luik is een merkteken dat zich in het vlak van de wegbaan bevindt. Het gaat om rechthoekige en veelhoekige luiken waarvan de zijde groter is dan 1,00m en cirkelvormige of vierkante deksels en luiken waarvan de zijde of diameter groter is dan 1,00m."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#ZichtbaarDekselOfLuik> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#ZitbankShape> a shacl:NodeShape;
  rdfs:label "Zitbank"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bron definitie: GRB-skeletaanvulling detail: WSM3: Niet-verplaatsbare zitbank."@nl;
  rdfs:comment "Een openbaar zitmeubel, op een duurzame manier verbonden met het aardoppervlak en gelegen in parken of langsheen de openbare weg."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Zitbank> .
