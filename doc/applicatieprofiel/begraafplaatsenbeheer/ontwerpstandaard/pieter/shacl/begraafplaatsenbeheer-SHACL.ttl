    shacl:maxCount 1;
    shacl:name "beheerder"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#beheerder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eigenaar"@nl;
