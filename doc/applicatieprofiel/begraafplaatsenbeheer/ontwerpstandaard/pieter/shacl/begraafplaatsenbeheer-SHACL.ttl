<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#FietsstallingShape> a shacl:NodeShape;
  rdfs:label "Fietsstalling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-skeletaanvulling detail - WPI16: Fietsstalling. Met het attribuut overdekt als True: GRB-basis - WGA3: Overdekte fietsstalling."@nl;
  rdfs:comment "Een fietsstalling is het geheel aan palen en/of verankeringspunten van een constructie bestemd voor het vastmaken van fietsen, gelegen op het openbare domein."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "afsluitbaar"@nl;
    rdfs:comment "Duidt aan of de fietsstalling al dan niet kan afgesloten worden om toegang voor onbevoegden te verhinderen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Fietsstalling.Afsluitbaar>;
    shacl:datatype xsd:boolean;
    shacl:description "Duidt aan of de fietsstalling al dan niet kan afgesloten worden om toegang voor onbevoegden te verhinderen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "afsluitbaar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#afsluitbaar>
  ], [
    a shacl:PropertyShape;
    rdfs:label "overdekt"@nl;
    rdfs:comment "Duidt aan of de fietsstalling al dan niet overdekt is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Fietsstalling.Overdekt>;
    shacl:datatype xsd:boolean;
    shacl:description "Duidt aan of de fietsstalling al dan niet overdekt is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "overdekt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#overdekt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "capaciteit"@nl;
    rdfs:comment "Geeft aan hoeveel fietsen gestald kunnen worden aan of in de fietsenstalling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Fietsstalling.Capaciteit>;
    shacl:datatype xsd:integer;
    shacl:description "Geeft aan hoeveel fietsen gestald kunnen worden aan of in de fietsenstalling."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "capaciteit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#capaciteit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "fietsdelen"@nl;
    rdfs:comment "Duidt aan of de fietsstalling al dan niet gebruikt wordt voor deelfietsen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Fietsstalling.Fietsdelen>;
    shacl:datatype xsd:boolean;
    shacl:description "Duidt aan of de fietsstalling al dan niet gebruikt wordt voor deelfietsen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "fietsdelen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#fietsdelen>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Fietsstalling> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#FysiekobjectShape> a shacl:NodeShape;
  rdfs:label "FysiekObject"@nl;
  rdfs:comment "De hoofdklasse waar alle objecten die geïnventariseerd kunnen worden van afgeleid worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "begindatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het gebied of object in gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Fysiekobject.Begindatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het gebied of object in gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "begindatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#begindatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het beheerobject uit gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Fysiekobject.Einddatum>;
    shacl:datatype xsd:dateTime;
