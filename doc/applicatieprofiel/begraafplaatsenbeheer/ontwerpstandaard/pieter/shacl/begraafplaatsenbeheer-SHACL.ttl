<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaanreden die de individuele leden ervan overstijgt en kan handelen als agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "alternatieveNaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een commerciële naam of informele naam."@nl;
    rdfs:comment "Andere naam waaronder de organisatie bekend is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Organisatie.Alternatievenaam>;
    shacl:datatype xsd:string;
    shacl:description "Andere naam waaronder de organisatie bekend is."@nl;
    shacl:maxCount "1";
    shacl:name "alternatieveNaam"@nl;
    shacl:path skos:altLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Organisatie.Voorkeursnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon ... die toelaat de Organisatie te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Organisatie.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Informatie zoals email, telefoon ... die toelaat de Organisatie te contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ];
  shacl:targetClass org:Organization .

