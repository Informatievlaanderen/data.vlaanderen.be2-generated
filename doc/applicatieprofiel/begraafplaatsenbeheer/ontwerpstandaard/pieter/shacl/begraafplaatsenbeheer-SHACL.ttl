<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#AanplakbordShape> a shacl:NodeShape;
  rdfs:label "Aanplakbord"@nl;
  <http://purl.org/vocab/vann/usageNote> "Voornamelijk voor reclameborden en verkiezingsdrukwerk. Naar GRB-skeletaanvulling detail - WPI12: Paal signalisatie publiciteit en Wikidata (https://www.wikidata.org/wiki/Q4379881)."@nl;
  rdfs:comment "(Paalvormige en duurzame verankering van) signalisatie langsheen de openbare weg met allerlei aankondigingen, al of niet van commerciële aard, op te plakken."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Aanplakbord> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#AfsluitingShape> a shacl:NodeShape;
  rdfs:label "Afsluiting"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-skeletaanvulling detail - AFS: Afsluiting (afgeleid)."@nl;
  rdfs:comment "Op het terrein ondubbelzinnig aanwijsbare en permanent verankerde scheiding."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Afsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#BestendigeAfsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#NormandischeAfsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Draadafsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Paneelafsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SpandraadKetting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SelectieveAfsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Slagboom>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Toegangspoort> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#AfsluitingspandraadenkettingShape> a shacl:NodeShape;
  rdfs:label "AfsluitingSpandraadEnKetting"@nl;
  <http://purl.org/vocab/vann/usageNote> "Verschilt van een draadafsluiting. Naar GRB-skeletaanvulling detail - AFS: Afsluiting - Spandraad en -ketting."@nl;
  rdfs:comment "Op het terrein ondubbelzinnig aanwijsbare en permanent verankerde scheiding, bestaande uit spandraad en/of kettingen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SpandraadKetting> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#BegraafplaatsShape> a shacl:NodeShape;
  rdfs:label "Begraafplaats"@nl;
  rdfs:comment "Gebied waar stoffelijke resten van overledenen begraven, bijgezet of verstrooid worden, inclusief de gemeenschappelijk gebruikte ruimte."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "actieveLijkbezorging"@nl;
    rdfs:comment "Duidt aan of er al dan niet nog aan actieve lijkbezorging gedaan wordt op de begraafplaats."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Begraafplaats.Actievelijkbezorging>;
    shacl:datatype xsd:boolean;
    shacl:description "Duidt aan of er al dan niet nog aan actieve lijkbezorging gedaan wordt op de begraafplaats."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "actieveLijkbezorging"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/gebied#actieveLijkbezorging>
  ], [
    a shacl:PropertyShape;
    rdfs:label "lichteRecreatie"@nl;
    rdfs:comment "Geeft aan of de begraafplaats al dan niet geschikt is voor lichte recreatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Begraafplaats.Lichterecreatie>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of de begraafplaats al dan niet geschikt is voor lichte recreatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lichteRecreatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/gebied#lichteRecreatie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Begraafplaats> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#BegraafplaatsrijShape> a shacl:NodeShape;
  rdfs:label "BegraafplaatsRij"@nl;
  rdfs:comment "Een rij is een verzameling graven van hetzelfde type. Een rij ligt typisch volledig binnen een bepaald blok."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#BegraafplaatsRij> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#BestendigeafsluitingShape> a shacl:NodeShape;
  rdfs:label "BestendigeAfsluiting"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-skeletaanvulling detail - AFS: Afsluiting."@nl;
  rdfs:comment "Op het terrein ondubbelzinnig aanwijsbare en permanent verankerde scheiding die statisch is in vorm en geen doorgang toelaat."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#BestendigeAfsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#NormandischeAfsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Draadafsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Paneelafsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SpandraadKetting> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#BooleanShape> a shacl:NodeShape;
  rdfs:label "Boolean";
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#CollectieShape> a shacl:NodeShape;
  rdfs:label "Collectie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld, alle objecten op het openbaar domein die bij een verkeersplateau horen maar niet noodzakelijk een rechtstreekse ruimtelijke relatie hebben."@nl;
  rdfs:comment "Een verzameling van individuele objecten waartussen een functionele relatie bestaat."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "Een titel voor de collectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Collectie.Titel>;
    shacl:datatype xsd:string;
    shacl:description "Een titel voor de collectie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "bevat"@nl;
    rdfs:comment "Relatie naar de objecten die deel uitmaken van de collectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Collectie.Bevat>;
    shacl:description "Relatie naar de objecten die deel uitmaken van de collectie."@nl;
    shacl:name "bevat"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/openbaardomein#FysiekObject>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein#Deel>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Terreindeel>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Voetweg>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Groenvlak>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Groendak>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#BegraafplaatsRij>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#Strooiweide>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Trap>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein#Element>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infrastructuurelement>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Straatmeubilair>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Fietsstalling>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Zitbank>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#OpenbaarToilet>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infozuil>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Aanplakbord>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#OpenbareVuilnisbak>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Deksel>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#ZichtbaarDekselOfLuik>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Afsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#BestendigeAfsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#NormandischeAfsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Draadafsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Paneelafsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SpandraadKetting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SelectieveAfsluiting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Slagboom>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Toegangspoort>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Rooster>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Straatkolk>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#OpenbareVerlichting>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Verlichtingspaal>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#OpenbareStraatverlichtingAanGevelOfMuur>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Lichtpunt>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#Graf>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#Columbarium>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#Urnenveld>]);
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#bevat>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein#Collectie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#ColumbariumShape> a shacl:NodeShape;
  rdfs:label "Columbarium"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-skeletoptie groen- en begraafplaatsenbeheer - BPU1: Columbarium."@nl;
  rdfs:comment "Een columbarium is een muur met nissen waarin urnen geplaatst worden."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begraafplaats#Columbarium> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanschrijfvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld De heer/Mevrouw, Excellentie, Dokter..."@nl;
    rdfs:comment "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Contactinfo.Aanschrijfvorm>;
    shacl:datatype rdf:langString;
    shacl:description "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    shacl:maxCount "1";
    shacl:name "aanschrijfvorm"@nl;
    shacl:path vcard:honorific-prefix
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactnaam"@nl;
    rdfs:comment "Naam van bijvoorbeeld de persoon die men kan contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Contactinfo.Contactnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van bijvoorbeeld de persoon die men kan contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactnaam"@nl;
    shacl:path foaf:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Contactinfo.Email>;
