    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beheerder"@nl;
    <http://purl.org/vocab/vann/usageNote> "Tot op team- of dienstniveau."@nl;
    rdfs:comment "Instantie die instaat voor het beheer van het gebied."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/begraafplaatsenbeheer/ontwerpstandaard/pieter#Gebied.Beheerder>;
