<https://data.test-vlaanderen.be/doc/applicatieprofiel/begroeid-voorkomen/ontwerpstandaard/toolchain4/BegroeidVoorkomenShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/begroeid-voorkomen/ontwerpstandaard/toolchain4#BegroeidVoorkomen.SoortnaamNederlands>;
    shacl:datatype rdf:langString;
    shacl:description "Soortnaam in het Nederlands."@nl;
