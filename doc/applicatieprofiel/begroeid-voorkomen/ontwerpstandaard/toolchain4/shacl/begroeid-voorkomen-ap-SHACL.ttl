    shacl:maxCount "1";
    shacl:name "drassigheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#drassigheid>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/begroeid-voorkomen/ontwerpstandaard/toolchain4#BegroeidVoorkomen.WetenschappelijkeSoortnaam>;
