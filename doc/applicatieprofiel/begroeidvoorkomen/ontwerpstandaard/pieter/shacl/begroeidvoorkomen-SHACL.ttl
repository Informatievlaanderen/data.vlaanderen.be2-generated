<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#WisselperkShape> a shacl:NodeShape;
  rdfs:label "Wisselperk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bron definitie: Technisch Vademecum Kruidachtigen Harmonisch Park- en Groenbeheer (ANB). Typische BLOEMPERKEN horen eveneens bij WISSELPERKEN."@nl;
  rdfs:comment "Jaarlijks opnieuw aangelegd begroeiingstype waarbij de sierwaarde centraal staat. De sierwaarde bestaat uit rijkelijk bloeiende planten."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Wisselperk> .
