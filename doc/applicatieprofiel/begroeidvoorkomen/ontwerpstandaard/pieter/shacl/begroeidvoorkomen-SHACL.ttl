<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#GazonShape> a shacl:NodeShape;
  rdfs:label "Gazon"@nl;
  rdfs:comment "Begroeiing zonder bloeiende grassen noch planten, gekenmerkt door een monotoon groen uiterlijk, lage soortendiversiteit en een kort vegetatiedek (enkele centimers hoogte). Een gazon wordt in stand gehouden door een intensief beheer (hoge maaifrequentie)."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Gazon>,
    <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Grindgazon>,
    <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Sportgazon>,
    <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Speelgazon>,
    <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Siergazon> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#GeschorenhaagShape> a shacl:NodeShape;
  rdfs:label "GeschorenHaag"@nl;
  rdfs:comment "Haag die standaard 2 keer per jaar wordt geschoren."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#GeschorenHaag> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#GrasachtigendeprecatedShape> a shacl:NodeShape;
  rdfs:label "GrasachtigenDeprecated"@nl;
  rdfs:comment "Begroeiingen die overheersend bestaat uit grassen (behorende tot de Grassenfamilie, Poaceae)."@nl;
