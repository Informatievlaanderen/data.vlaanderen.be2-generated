    shacl:class skos:Concept;
    shacl:description "Materiaal waaruit de Grasdal is vervaardigd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "materiaal"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#materiaal>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Grasdals> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#GraslandShape> a shacl:NodeShape;
  rdfs:label "Grasland"@nl;
  rdfs:comment "Grazige vegetatie met daarin kruidachtigen die jaarlijks één of meerdere malen per jaar gemaaid of begraasd wordt."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Grasland>,
    <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Bloemenakker> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#GrazigevegetatieShape> a shacl:NodeShape;
  rdfs:label "GrazigeVegetatie"@nl;
  rdfs:comment "Begroeiingen die overheersend bestaat uit grassen (behorende tot de Grassenfamilie, Poaceae)."@nl;
  shacl:closed false;
