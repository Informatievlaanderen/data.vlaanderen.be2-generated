<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#BloemenakkerShape> a shacl:NodeShape;
  rdfs:label "Bloemenakker"@nl;
  rdfs:comment "Grasland dat is ingezaaid met (éénjarige) wilde- of half wilde soorten waarvan de bodem elk jaar moet geschoffeld of geploegd worden."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Bloemenakker> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#BloemenweideShape> a shacl:NodeShape;
  rdfs:label "Bloemenweide"@nl;
  rdfs:comment "Grasland dat is ingezaaid met (meerjarige) wilde- of half wilde soorten."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Bloemenweide> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#BodembedekkendeheestersShape> a shacl:NodeShape;
  rdfs:label "BodembedekkendeHeesters"@nl;
  <http://purl.org/vocab/vann/usageNote> "Definitie naar het technisch vademecum Heesters van het Agentschap voor Natuur en Bos."@nl;
  rdfs:comment "Lage, breed uitgroeiende heesters."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#BodembedekkendeHeesters> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#BodembedekkersShape> a shacl:NodeShape;
  rdfs:label "Bodembedekkers"@nl;
  rdfs:comment "Aangelegd begroeiingstype, doorgaans met vaste planten, die bedoeld is om snel de bodem te bedekken."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Bodembedekkers> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#BolenknolgewassenShape> a shacl:NodeShape;
  rdfs:label "BolEnKnolgewassen"@nl;
  rdfs:comment "Bol- en knolgewassen beschikken over een ondergronds voedselreservoir in de vorm van een bol of een knol. Veelal verschijnen de bovengrondse delen in een specifieke periode van het jaar en kennen zij een geweldige bloei."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#BolEnKnolgewassen> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#BollengraslandShape> a shacl:NodeShape;
  rdfs:label "Bollengrasland"@nl;
  rdfs:comment "Grasland met planten die bloeien voor de groei van de graszode goed op gang komt."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Bollengrasland> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#BomenShape> a shacl:NodeShape;
  rdfs:label "Bomen"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bron definitie: vrij naar CROW in Gegevenscatalogus IMGeo 2.1.1 (definitie BOSPLANTSOEN)."@nl;
  rdfs:comment "Opgaande beplanting van houtachtige gewassen die boomvormend zijn."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Bomen> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#BooleanShape> a shacl:NodeShape;
  rdfs:label "Boolean";
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#BraaklandShape> a shacl:NodeShape;
  rdfs:label "Braakland"@nl;
  rdfs:comment "Tijdelijke eenheid die ongebruikt blijft liggen en nog niet tot ruigte of bos geëvolueerd is."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#Braakland> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/begroeidvoorkomen/ontwerpstandaard/pieter#DrassigheidwaardeShape> a shacl:NodeShape;
  rdfs:label "DrassigheidWaarde"@nl;
  rdfs:comment "De mate van drassigheid."@nl;
  shacl:closed false;
