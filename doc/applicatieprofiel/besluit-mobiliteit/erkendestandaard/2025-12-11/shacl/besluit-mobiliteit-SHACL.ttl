    shacl:description "Periode waarbinnen het verkeersteken niet geldig is."@nl;
    shacl:name "buitenwerkingtreding"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#buitenwerkingtreding>
  ], [
    a shacl:PropertyShape;
    rdfs:label "inwerkingtreding"@nl;
    rdfs:comment "Wanneer het verkeersteken actief is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeersteken.Inwerkingtreding>;
    shacl:class schemas:Schedule;
    shacl:description "Wanneer het verkeersteken actief is."@nl;
    shacl:name "inwerkingtreding"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#inwerkingstijd>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bevat verkeersteken"@nl;
    rdfs:comment "Geeft aan dat een concreet verkeersteken één of meer andere verkeerstekens fysiek bevat, weergeeft of draagt op een specifieke locatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeersteken.BevatVerkeersteken>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken>;
    shacl:description "Geeft aan dat een concreet verkeersteken één of meer andere verkeerstekens fysiek bevat, weergeeft of draagt op een specifieke locatie."@nl;
    shacl:name "bevat verkeersteken"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#bevatVerkeersteken>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#VerkeerstekenconceptShape> a shacl:NodeShape;
  rdfs:label "Verkeerstekenconcept"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het woord 'Concept' verwijst naar de inhoudelijke betekenis zoals opgenomen in een taxonomie,thesaurus of kennissysteem (SKOS). De verkeerstekenconcepten samen vormen een taxonomie."@nl;
  rdfs:comment "Inhoudelijke definitie van de betekenis van een verkeersteken zoals opgenomen in de wegcode."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geldig tot"@nl;
    rdfs:comment "De datum tot en met waarop het concept geldig is. Na deze datum mag het concept niet meer gebruikt worden voor nieuwe verkeerstekens."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeerstekenconcept.GeldigTot>;
    shacl:datatype xsd:date;
    shacl:description "De datum tot en met waarop het concept geldig is. Na deze datum mag het concept niet meer gebruikt worden voor nieuwe verkeerstekens."@nl;
    shacl:maxCount "1";
    shacl:name "geldig tot"@nl;
    shacl:path schema:validUntil
  ], [
    a shacl:PropertyShape;
    rdfs:label "geldig vanaf"@nl;
    rdfs:comment "Het concept mag gebruikt worden vanaf deze datum."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeerstekenconcept.GeldigVanaf>;
    shacl:datatype xsd:date;
    shacl:description "Het concept mag gebruikt worden vanaf deze datum."@nl;
    shacl:maxCount "1";
    shacl:name "geldig vanaf"@nl;
    shacl:path schema:validFrom
  ], [
    a shacl:PropertyShape;
    rdfs:label "AR-plichtig"@nl;
    rdfs:comment "Geeft aan of een aanvullend reglement dient opgesteld en goedgekeurd te worden om een vekeersteken te plaatsen dat gebaseerd is op dit concept."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeerstekenconcept.Ar-plichtig>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of een aanvullend reglement dient opgesteld en goedgekeurd te worden om een vekeersteken te plaatsen dat gebaseerd is op dit concept."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "AR-plichtig"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#Verkeerstekenconcept.ARplichtig>
  ], [
    a shacl:PropertyShape;
    rdfs:label "regelgevend kader"@nl;
    rdfs:comment "Link tussen een verkeerstekenconcept en het regelgevend kader waaronder het valt, zoals bepaald door een specifieke versie van de verkeersregels of wegcode. Dit kader bepaalt de formele betekenis, toepassing en uitvoering van het concept."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeerstekenconcept.RegelgevendKader>;
    shacl:class skos:Concept;
    shacl:description "Link tussen een verkeerstekenconcept en het regelgevend kader waaronder het valt, zoals bepaald door een specifieke versie van de verkeersregels of wegcode. Dit kader bepaalt de formele betekenis, toepassing en uitvoering van het concept."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "regelgevend kader"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#regelgevendKader>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afbeelding"@nl;
    <http://purl.org/vocab/vann/usageNote> "In geval van variabel opschrift kan een default afbeelding gebruikt worden."@nl;
