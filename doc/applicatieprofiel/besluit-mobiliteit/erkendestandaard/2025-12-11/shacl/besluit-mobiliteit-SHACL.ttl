<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#AanvullendReglementOntwerpShape> a shacl:NodeShape;
  rdfs:label "Aanvullend reglement ontwerp"@nl;
  rdfs:comment "Een ontwerpversie van een aanvullend reglement dat de algemene verkeersregels aanpast aan specifieke lokale omstandigheden, opgesteld via ontwerpproces voorafgaand aan officiële goedkeuring."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "label"@nl;
    rdfs:comment "Beschrijvende naam voor het ontwerp."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#AanvullendReglementOntwerp.Label>;
    shacl:datatype xsd:string;
    shacl:description "Beschrijvende naam voor het ontwerp."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "label"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "is ontwerp voor"@nl;
    rdfs:comment "Mobiliteitsmaatregel die deel uitmaakt van het ontwerp"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#AanvullendReglementOntwerp.IsOntwerpVoor>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#AanvullendReglement>;
    shacl:description "Mobiliteitsmaatregel die deel uitmaakt van het ontwerp"@nl;
    shacl:minCount 1;
    shacl:name "is ontwerp voor"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#isOntwerpVoor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bevat maatregel ontwerp"@nl;
    rdfs:comment "Verwijst naar maatregel ontwerp dat beschreven staat in het ontwerp."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#AanvullendReglementOntwerp.BevatMaatregelOntwerp>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit#MobiliteitsmaatregelOntwerp>;
    shacl:description "Verwijst naar maatregel ontwerp dat beschreven staat in het ontwerp."@nl;
    shacl:name "bevat maatregel ontwerp"@nl;
    shacl:path dc:references
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit#AanvullendReglementOntwerp> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#AanvullendReglementShape> a shacl:NodeShape;
  rdfs:label "Aanvullend Reglement"@nl;
  rdfs:comment "Een aanvullend reglement op de politie van het wegverkeer is een besluit met betrekking tot de aanpassing van de algemene wegcode aan plaatselijke omstandigheden met een blijvend of periodiek karakter."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "tijdsinterval"@nl;
    <http://purl.org/vocab/vann/usageNote> "Aanvullend reglement kan uit meerdere periodes bestaan."@nl;
    rdfs:comment "Periode waarbinnen het aanvullend reglement geldig is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#AanvullendReglement.Tijdsinterval>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Periode waarbinnen het aanvullend reglement geldig is."@nl;
    shacl:name "tijdsinterval"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#periode>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#AanvullendReglement> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "volledig adres"@nl;
    rdfs:comment "Het complete adres in één string, al dan niet geformatteerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Adresvoorstelling.VolledigAdres>;
    shacl:datatype rdf:langString;
    shacl:description "Het complete adres in één string, al dan niet geformatteerd."@nl;
    shacl:maxCount "1";
