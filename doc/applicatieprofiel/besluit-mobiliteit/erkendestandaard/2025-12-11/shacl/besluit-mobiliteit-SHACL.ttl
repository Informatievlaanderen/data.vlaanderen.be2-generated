    shacl:path <http://www.w3.org/ns/locn#locatorDesignator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding tbv Belgische adressen."@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Adresvoorstelling.Huisnummer>;
