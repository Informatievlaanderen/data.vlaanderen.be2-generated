<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#VerkeerstekenShape> a shacl:NodeShape;
  rdfs:label "Verkeersteken"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dit kan een verkeersbord,verkeerslicht of wegmarkering zijn. Merk op: het gaat hier om de conceptuele weergave en niet om de fysieke wegsignalisatie op het openbaar domein."@nl;
  rdfs:comment "De voorstelling van een aanwijzing ten behoeve van de weggebruikers die verbonden wordt aan het aankondigen of opleggen van een bepaalde verkeersmaatregel zoals bepaald in de wegcode."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "plaatsbepaling"@nl;
    <http://purl.org/vocab/vann/usageNote> "Komt voort uit het lokaal besluit, bijvoorbeeld aanvullend reglement."@nl;
    rdfs:comment "Tekstuele beschrijving waar het verkeersteken zal komen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeersteken.Plaatsbepaling>;
    shacl:datatype xsd:string;
    shacl:description "Tekstuele beschrijving waar het verkeersteken zal komen."@nl;
    shacl:maxCount "1";
    shacl:name "plaatsbepaling"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#plaatsbepaling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Als value wordt een wkt string opgegeven, bv: \"<http://www.opengis.net/def/crs/OGC/1.3/CRS84> Point(-0.001475 51.477811)\"^^gsp:wktLiteral ."@nl;
    rdfs:comment "de locatie van het verkeersteken in WKT formaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeersteken.Locatie>;
    shacl:description "de locatie van het verkeersteken in WKT formaat."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "locatie"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wettelijke status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: vergund"@nl;
    rdfs:comment "Wettelijke status van het verkeersteken."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeersteken.WettelijkeStatus>;
    shacl:class skos:Concept;
    shacl:description "Wettelijke status van het verkeersteken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "wettelijke status"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken.wettelijkeStatus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adresvoorstelling"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ter hoogte van welk adres het verkeersteken geplaatst wordt. De preciese locatie komt op de opstelling."@nl;
    rdfs:comment "Adresvoorstelling van het verkeersteken."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeersteken.Adresvoorstelling>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adresvoorstelling van het verkeersteken."@nl;
    shacl:maxCount "1";
    shacl:name "adresvoorstelling"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#adresVoorstelling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afbeelding"@nl;
    rdfs:comment "Foto van het verkeersteken."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeersteken.Afbeelding>;
    shacl:class foaf:Document;
    shacl:description "Foto van het verkeersteken."@nl;
    shacl:name "afbeelding"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#grafischeWeergave>
  ], [
    a shacl:PropertyShape;
    rdfs:label "buitenwerkingtreding"@nl;
    rdfs:comment "Periode waarbinnen het verkeersteken niet geldig is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/erkendestandaard/2025-12-11#Verkeersteken.Buitenwerkingtreding>;
