<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/ontwerpstandaard/toolchain4#AanvullendReglementOntwerpShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/ontwerpstandaard/toolchain4#AanvullendReglementOntwerp.Label>;
    shacl:datatype xsd:string;
    shacl:description "Beschrijvende naam voor het ontwerp."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "label"@nl;
    shacl:path dc:title
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/ontwerpstandaard/toolchain4#AanvullendReglementOntwerp.IsOntwerpVoor>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#AanvullendReglement>;
    shacl:description "Mobiliteitsmaatregel die deel uitmaakt van het ontwerp"@nl;
    shacl:minCount "1";
    shacl:name "is ontwerp voor"@nl;
    shacl:path <http://todo.com/AanvullendReglementOntwerp.isOntwerpVoor>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/ontwerpstandaard/toolchain4#AanvullendReglementOntwerp.HeeftVerkeersteken>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken>;
    shacl:description "het verkeersteken dat is opgenomen in het ontwerp"@nl;
    shacl:minCount "1";
    shacl:name "heeft verkeersteken"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#AanvullendReglementOntwerp.heeftVerkeersteken>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit#AanvullendReglementOntwerp> .

