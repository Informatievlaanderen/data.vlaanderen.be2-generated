    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een ontwerpversie van een aanvullend reglement dat de algemene verkeersregels aanpast aan specifieke lokale omstandigheden, opgesteld via ontwerpproces voorafgaand aan officiële goedkeuring."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Aanvullend reglement ontwerp"
      }
