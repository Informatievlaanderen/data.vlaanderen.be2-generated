<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/ontwerpstandaard/toolchain4#AgendapuntShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/ontwerpstandaard/toolchain4#Agendapunt.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Korte beschrijving van het agendapunt."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/ontwerpstandaard/toolchain4#Agendapunt.GeplandOpenbaar>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of het agendapunt al dan niet bedoeld is om openbaar te bespreken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gepland openbaar"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#geplandOpenbaar>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/ontwerpstandaard/toolchain4#Agendapunt.Titel>;
    shacl:datatype xsd:string;
    shacl:description "De naam van het agendapunt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/ontwerpstandaard/toolchain4#Agendapunt.Type>;
    shacl:class skos:Concept;
    shacl:description "Type van het agendapunt."@nl;
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#Agendapunt.type>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/ontwerpstandaard/toolchain4#Agendapunt.RefereertAan>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Agendapunt>;
    shacl:description "Een ander agendapunt waarnaar verwezen wordt vanuit dit agendapunt."@nl;
    shacl:name "refereert aan"@nl;
    shacl:path dc:references
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/ontwerpstandaard/toolchain4#Agendapunt.HeeftOntwerpbesluit>;
    shacl:class foaf:Document;
    shacl:description "Een (mogelijks nog aan te vullen of aan te passen) ontwerp voor het besluit dat uit dit agendapunt zou voortkomen."@nl;
    shacl:name "heeft ontwerpbesluit"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftOntwerpbesluit>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/ontwerpstandaard/toolchain4#Agendapunt.AangebrachtNa>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Agendapunt>;
    shacl:description "Het agendapunt dat op de agenda direct dit agendapunt voorafging."@nl;
    shacl:maxCount "1";
    shacl:name "aangebracht na"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#aangebrachtNa>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#Agendapunt> .

