<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#ZittingShape> a shacl:NodeShape;
  rdfs:label "Zitting"@nl;
  rdfs:comment "Een geformaliseerde samenkomst van de leden van een bestuursorgaan met het doel om de aangelegenheden te regelen waarvoor het bevoegd is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geëindigd op tijdstip"@nl;
    rdfs:comment "Tijdstip waarop de zitting eindigt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Zitting.GeëindigdOpTijdstip>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de zitting eindigt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geëindigd op tijdstip"@nl;
    shacl:path prov:endedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "geplande start"@nl;
    rdfs:comment "Het tijdstip waarop de zitting gepland is om te beginnen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Zitting.GeplandeStart>;
