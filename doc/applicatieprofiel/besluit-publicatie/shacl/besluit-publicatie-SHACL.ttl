<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#StemmingShape> a shacl:NodeShape;
  rdfs:label "Stemming"@nl;
  rdfs:comment "Geformaliseerde handeling waarbij de stemgerechtigde leden van een bestuursorgaan hun keuze te kennen geven."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aantal onthouders"@nl;
    rdfs:comment "Het aantal stemmers dat als onthouding heeft gestemd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.AantalOnthouders>;
    shacl:datatype xsd:integer;
    shacl:description "Het aantal stemmers dat als onthouding heeft gestemd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aantal onthouders"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#aantalOnthouders>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aantal tegenstanders"@nl;
    rdfs:comment "Het aantal stemmers dat als tegenstander heeft gestemd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.AantalTegenstanders>;
    shacl:datatype xsd:integer;
    shacl:description "Het aantal stemmers dat als tegenstander heeft gestemd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aantal tegenstanders"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#aantalTegenstanders>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aantal voorstanders"@nl;
    rdfs:comment "Het aantal stemmers dat als voorstander heeft gestemd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.AantalVoorstanders>;
    shacl:datatype xsd:integer;
    shacl:description "Het aantal stemmers dat als voorstander heeft gestemd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aantal voorstanders"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#aantalVoorstanders>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geheim"@nl;
    rdfs:comment "Geeft aan of de stemming geheim was. Bij een geheime stemming wordt niet individueel bekend gemaakt wie op wat heeft gestemd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.Geheim>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of de stemming geheim was. Bij een geheime stemming wordt niet individueel bekend gemaakt wie op wat heeft gestemd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geheim"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#geheim>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gevolg"@nl;
    rdfs:comment "Het gevolg van de stemming."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.Gevolg>;
    shacl:datatype rdf:langString;
    shacl:description "Het gevolg van de stemming."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gevolg"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#gevolg>
  ], [
    a shacl:PropertyShape;
    rdfs:label "onderwerp"@nl;
    rdfs:comment "De beschrijving van het onderwerp waarover de stemming gaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.Onderwerp>;
    shacl:datatype rdf:langString;
    shacl:description "De beschrijving van het onderwerp waarover de stemming gaat."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "onderwerp"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#onderwerp>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft stemmer"@nl;
    <http://purl.org/vocab/vann/usageNote> "In geval van een niet-geheime stemming kunnen de meer gespecialisseerde versies (bvb. heeft voorstander) gebruikt worden."@nl;
    rdfs:comment "Een mandataris die deelneemt aan de stemming."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.HeeftStemmer>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "Een mandataris die deelneemt aan de stemming."@nl;
    shacl:minCount 1;
    shacl:name "heeft stemmer"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftStemmer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft tegenstander"@nl;
    rdfs:comment "Een mandataris die als tegenstander heeft gestemd op het onderwerp van de stemming."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.HeeftTegenstander>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "Een mandataris die als tegenstander heeft gestemd op het onderwerp van de stemming."@nl;
    shacl:name "heeft tegenstander"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftTegenstander>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft onthouder"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit omvat ook ongeldige stemmen, blanco stemmen of het weigeren om deel te nemen aan de stemming."@nl;
    rdfs:comment "Een mandataris die als onthouder heeft gestemd op het onderwerp van de stemming."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.HeeftOnthouder>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "Een mandataris die als onthouder heeft gestemd op het onderwerp van de stemming."@nl;
    shacl:name "heeft onthouder"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftOnthouder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft voorstander"@nl;
    rdfs:comment "Een mandataris die als voorstander heeft gestemd op het onderwerp van de stemming."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.HeeftVoorstander>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "Een mandataris die als voorstander heeft gestemd op het onderwerp van de stemming."@nl;
    shacl:name "heeft voorstander"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftVoorstander>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft aanwezige"@nl;
    rdfs:comment "Een mandataris (van het orgaan dat de zitting houdt) die aanwezig was tijdens de stemming."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Stemming.HeeftAanwezige>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "Een mandataris (van het orgaan dat de zitting houdt) die aanwezig was tijdens de stemming."@nl;
    shacl:minCount 1;
    shacl:name "heeft aanwezige"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftAanwezige>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#Stemming> .

