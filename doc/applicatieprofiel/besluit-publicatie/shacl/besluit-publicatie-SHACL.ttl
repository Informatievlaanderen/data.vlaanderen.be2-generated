    shacl:description "Het tijdstip waarop de zitting gepland is om te beginnen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geplande start"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#geplandeStart>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gestart op tijdstip"@nl;
    rdfs:comment "Tijdstip waarop de zitting begint."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Zitting.GestartOpTijdstip>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de zitting begint."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gestart op tijdstip"@nl;
    shacl:path prov:startedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "op locatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Wegens digitale vergaderingen, locaties zonder URI of gebrek aan eenduidigheid (bvb: blank node met naam \"Zaal 1B\") zorgen dat deze eigenschap niet verplicht is."@nl;
    rdfs:comment "Locatie waar de zitting plaatsvindt. Doorgaans is dit een zaal in een gebouw."@nl;
