    shacl:description "Locatie waar de zitting plaatsvindt. Doorgaans is dit een zaal in een gebouw."@nl;
    shacl:maxCount "1";
    shacl:name "op locatie"@nl;
    shacl:path prov:atLocation
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft zittingsverslag"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een transcript of audio- of video-opname."@nl;
    rdfs:comment "Een verslag van de zitting."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Zitting.HeeftZittingsverslag>;
