    rdfs:comment "De formele notulen van de zitting."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Zitting.HeeftNotulen>;
