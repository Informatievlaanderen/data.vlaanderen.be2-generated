    shacl:class prov:Location;
    shacl:description "Geografische gebied waarbinnen de bestuurseenheid bepaalde verantwoordelijkheden heeft waarbinnen het bestuurshandelingen kan stellen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "werkingsgebied"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#werkingsgebied>
