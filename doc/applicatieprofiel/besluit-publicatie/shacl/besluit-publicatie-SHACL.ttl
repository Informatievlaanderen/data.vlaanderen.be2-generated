<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#AgendapuntShape> a shacl:NodeShape;
  rdfs:label "Agendapunt"@nl;
  rdfs:comment "Formeel aanvaard te behandelen onderwerp op een zitting."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Korte beschrijving van het agendapunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Agendapunt.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Korte beschrijving van het agendapunt."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "gepland openbaar"@nl;
    rdfs:comment "Geeft aan of het agendapunt al dan niet bedoeld is om openbaar te bespreken."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Agendapunt.GeplandOpenbaar>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of het agendapunt al dan niet bedoeld is om openbaar te bespreken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gepland openbaar"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#geplandOpenbaar>
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "De naam van het agendapunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Agendapunt.Titel>;
    shacl:datatype xsd:string;
    shacl:description "De naam van het agendapunt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Type van het agendapunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Agendapunt.Type>;
    shacl:class skos:Concept;
    shacl:description "Type van het agendapunt."@nl;
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#Agendapunt.type>
  ], [
    a shacl:PropertyShape;
    rdfs:label "refereert aan"@nl;
    rdfs:comment "Een ander agendapunt waarnaar verwezen wordt vanuit dit agendapunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Agendapunt.RefereertAan>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Agendapunt>;
    shacl:description "Een ander agendapunt waarnaar verwezen wordt vanuit dit agendapunt."@nl;
    shacl:name "refereert aan"@nl;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft ontwerpbesluit"@nl;
    rdfs:comment "Een (mogelijks nog aan te vullen of aan te passen) ontwerp voor het besluit dat uit dit agendapunt zou voortkomen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Agendapunt.HeeftOntwerpbesluit>;
    shacl:description "Een (mogelijks nog aan te vullen of aan te passen) ontwerp voor het besluit dat uit dit agendapunt zou voortkomen."@nl;
    shacl:name "heeft ontwerpbesluit"@nl;
    shacl:or ([shacl:class foaf:Document] [shacl:class <http://data.vlaanderen.be/ns/besluit#Besluit>]);
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftOntwerpbesluit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aangebracht na"@nl;
    rdfs:comment "Het agendapunt dat op de agenda direct dit agendapunt voorafging."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Agendapunt.AangebrachtNa>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Agendapunt>;
    shacl:description "Het agendapunt dat op de agenda direct dit agendapunt voorafging."@nl;
    shacl:maxCount 1;
    shacl:name "aangebracht na"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#aangebrachtNa>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#Agendapunt> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent,
    <http://data.vlaanderen.be/ns/mandaat#Mandataris> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#ArtikelShape> a shacl:NodeShape;
  rdfs:label "Artikel"@nl;
  rdfs:comment "Formeel afgebakend onderdeel van een besluit,dat een of meer van de beoogde rechtsgevolgen beschrijft."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "nummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voorbeeld voor onderscheid met titel te verduidelijken: 'Artikel 1' is het nummer, 'Artikel 1 van het Gemeentedecreet' is de titel."@nl;
    rdfs:comment "Het nummer van het artikel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Artikel.Nummer>;
    shacl:datatype xsd:string;
    shacl:description "Het nummer van het artikel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "nummer"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#number>
  ], [
    a shacl:PropertyShape;
    rdfs:label "realiseert"@nl;
    rdfs:comment "De rechtsgrond beschreven door dit artikel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Artikel.Realiseert>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>;
    shacl:description "De rechtsgrond beschreven door dit artikel."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "realiseert"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#realizes>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#Artikel> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BehandelingVanAgendapuntShape> a shacl:NodeShape;
  rdfs:label "Behandeling van Agendapunt"@nl;
  rdfs:comment "De uitvoering van de acties om een agendapunt te verwerken tijdens een zitting."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "openbaar"@nl;
    rdfs:comment "Geeft aan of de bespreking effectief openbaar verlopen is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BehandelingVanAgendapunt.Openbaar>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of de bespreking effectief openbaar verlopen is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "openbaar"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#openbaar>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft aanwezige"@nl;
    rdfs:comment "Een mandataris (van het orgaan dat de zitting houdt) die aanwezig was tijdens (een deel van) de behandeling."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BehandelingVanAgendapunt.HeeftAanwezige>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "Een mandataris (van het orgaan dat de zitting houdt) die aanwezig was tijdens (een deel van) de behandeling."@nl;
    shacl:minCount 1;
    shacl:name "heeft aanwezige"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftAanwezige>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft secretaris"@nl;
    <http://purl.org/vocab/vann/usageNote> "Verplicht te gebruiken wanneer de secretaris tijdens de behandeling van het agendapunt verschilt van de secretaris van de zitting; anders optioneel."@nl;
    rdfs:comment "De mandataris die de rol van secretaris heeft gedurende de behandeling van het agendapunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BehandelingVanAgendapunt.HeeftSecretaris>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "De mandataris die de rol van secretaris heeft gedurende de behandeling van het agendapunt."@nl;
    shacl:maxCount 1;
    shacl:name "heeft secretaris"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftSecretaris>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft voorzitter"@nl;
    <http://purl.org/vocab/vann/usageNote> "Verplicht te gebruiken wanneer de voorzitter tijdens de behandeling van het agendapunt verschilt van de voorzitter van de zitting; anders optioneel."@nl;
    rdfs:comment "De mandataris die de rol als voorzitter heeft gedurende de behandeling van het agendapunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BehandelingVanAgendapunt.HeeftVoorzitter>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "De mandataris die de rol als voorzitter heeft gedurende de behandeling van het agendapunt."@nl;
    shacl:maxCount 1;
    shacl:name "heeft voorzitter"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftVoorzitter>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geeft aanleiding tot"@nl;
    rdfs:comment "Een besluit dat is opgemaakt naar aanleiding van de behandeling van het agendapunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BehandelingVanAgendapunt.GeeftAanleidingTot>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Besluit>;
    shacl:description "Een besluit dat is opgemaakt naar aanleiding van de behandeling van het agendapunt."@nl;
    shacl:name "geeft aanleiding tot"@nl;
    shacl:path prov:generated
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebeurt na"@nl;
    rdfs:comment "Verwijzing naar het voorgaand behandeld agendapunt binnen dezelfde zitting. Laat toe om de volgorde van de behandelingen op te bouwen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BehandelingVanAgendapunt.GebeurtNa>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#BehandelingVanAgendapunt>;
    shacl:description "Verwijzing naar het voorgaand behandeld agendapunt binnen dezelfde zitting. Laat toe om de volgorde van de behandelingen op te bouwen."@nl;
    shacl:maxCount 1;
    shacl:name "gebeurt na"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#gebeurtNa>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft onderwerp"@nl;
    rdfs:comment "Het onderwerp van de activiteit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BehandelingVanAgendapunt.HeeftOnderwerp>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Agendapunt>;
    shacl:description "Het onderwerp van de activiteit."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft onderwerp"@nl;
    shacl:path dc:subject
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft stemming"@nl;
    rdfs:comment "Een stemming die plaatsvond tijdens de behandeling van het agendapunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BehandelingVanAgendapunt.HeeftStemming>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Stemming>;
    shacl:description "Een stemming die plaatsvond tijdens de behandeling van het agendapunt."@nl;
    shacl:name "heeft stemming"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftStemming>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#BehandelingVanAgendapunt> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BesluitShape> a shacl:NodeShape;
  rdfs:label "Besluit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hieronder vallen zowel individuele besluiten (rechtshandelingen met een individueel karakter zoals het toekennen van een subsidie) als besluiten van algemene strekking (beslissingen van algemene reglementaire strekking die niet gericht zijn op een individu maar op een groep, zoals de verkeersregels)."@nl;
  rdfs:comment "De authentieke schriftelijke neerslag van een beslissing van een bestuursorgaan. Deze beslissing houdt een rechtshandeling in waarbij sprake is van een beoogd rechtsgevolg."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een beknopte beschrijving van het besluit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Besluit.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Een beknopte beschrijving van het besluit."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#description>
  ], [
    a shacl:PropertyShape;
    rdfs:label "citeeropschrift"@nl;
    rdfs:comment "De beknopte titel of officiële korte naam van een decreet, wet, besluit... Deze wordt officieel vastgelegd. Deze benaming wordt in de praktijk gebruikt om naar de rechtsgrond te verwijzen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Besluit.Citeeropschrift>;
    shacl:datatype xsd:string;
    shacl:description "De beknopte titel of officiële korte naam van een decreet, wet, besluit... Deze wordt officieel vastgelegd. Deze benaming wordt in de praktijk gebruikt om naar de rechtsgrond te verwijzen."@nl;
    shacl:maxCount "1";
    shacl:name "citeeropschrift"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#title_short>
  ], [
    a shacl:PropertyShape;
    rdfs:label "motivering"@nl;
    rdfs:comment "Beschrijving van de juridische en feitelijke motivering achter de beslissing die wordt uitgedrukt in het besluit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Besluit.Motivering>;
    shacl:datatype rdf:langString;
    shacl:description "Beschrijving van de juridische en feitelijke motivering achter de beslissing die wordt uitgedrukt in het besluit."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "motivering"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#motivering>
  ], [
    a shacl:PropertyShape;
    rdfs:label "publicatiedatum"@nl;
    rdfs:comment "De officiële publicatiedatum van het besluit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Besluit.Publicatiedatum>;
    shacl:datatype xsd:date;
    shacl:description "De officiële publicatiedatum van het besluit."@nl;
    shacl:maxCount "1";
    shacl:name "publicatiedatum"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#date_publication>
  ], [
    a shacl:PropertyShape;
    rdfs:label "realiseert"@nl;
    rdfs:comment "De rechtsgrond beschreven door dit besluit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Besluit.Realiseert>;
    shacl:description "De rechtsgrond beschreven door dit besluit."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "realiseert"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalResource>] [shacl:class <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>]);
    shacl:path <http://data.europa.eu/eli/ontology#realizes>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volgt uit"@nl;
    rdfs:comment "De behandeling van het agendapunt die tot dit besluit heeft geleid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Besluit.VolgtUit>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#BehandelingVanAgendapunt>;
    shacl:description "De behandeling van het agendapunt die tot dit besluit heeft geleid."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "volgt uit"@nl;
    shacl:path prov:wasGeneratedBy
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#Besluit> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#BestuurseenheidShape> a shacl:NodeShape;
  rdfs:label "Bestuurseenheid"@nl;
