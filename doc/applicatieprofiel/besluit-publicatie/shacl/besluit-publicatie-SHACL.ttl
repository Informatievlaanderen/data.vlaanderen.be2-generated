<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#LegaleVerschijningsvormShape> a shacl:NodeShape;
  rdfs:label "Legale Verschijningsvorm"@nl;
  rdfs:comment "Een legale verschijningsvorm is een intellectuele realisatie van een rechtsgrond onder de vorm van een opeenvolging van tekens (meestal alphanumerieke tekens)."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "inhoud"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de beschrijving van een verkeersregel die wordt ingevoerd of de beslissing om een subsidie toe te kennen aan iemand."@nl;
    rdfs:comment "De beschrijving van de beoogde rechtsgevolgen, het zogenaamde beschikkend gedeelte."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#LegaleVerschijningsvorm.Inhoud>;
    shacl:description "De beschrijving van de beoogde rechtsgevolgen, het zogenaamde beschikkend gedeelte."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "inhoud"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path prov:value
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voor een besluit is dit het opschrift, voor een artikel de benaming van het artikel."@nl;
    rdfs:comment "Titel van de legale verschijningsvorm."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#LegaleVerschijningsvorm.Titel>;
    shacl:datatype xsd:string;
    shacl:description "Titel van de legale verschijningsvorm."@nl;
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#title>
  ], [
    a shacl:PropertyShape;
    rdfs:label "taal"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap is aanwezig voor compatibiliteit met European Legislation Identifier (ELI)."@nl;
    rdfs:comment "De taal van de verschijningsvorm."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#LegaleVerschijningsvorm.Taal>;
    shacl:class skos:Concept;
    shacl:description "De taal van de verschijningsvorm."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "taal"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#language>
  ], [
    a shacl:PropertyShape;
    rdfs:label "veranderd door"@nl;
    rdfs:comment "Duidt aan dat deze legale verschijningsvorm een verandering met legale gevolgen heeft ondergaan door een andere legale verschijningsvorm. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#LegaleVerschijningsvorm.VeranderdDoor>;
    shacl:description "Duidt aan dat deze legale verschijningsvorm een verandering met legale gevolgen heeft ondergaan door een andere legale verschijningsvorm. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    shacl:name "veranderd door"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalExpression>] [shacl:class <http://data.vlaanderen.be/ns/besluit#Artikel>] [shacl:class <http://data.vlaanderen.be/ns/besluit#Besluit>]);
    shacl:path <http://data.europa.eu/eli/ontology#changed_by>
  ], [
    a shacl:PropertyShape;
    rdfs:label "corrigeert"@nl;
    rdfs:comment "Duidt aan dat deze legale verschijningsvorm tekstuele veranderingen zonder legale impact aanbrengt in een andere legale verschijningsvorm."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#LegaleVerschijningsvorm.Corrigeert>;
    shacl:description "Duidt aan dat deze legale verschijningsvorm tekstuele veranderingen zonder legale impact aanbrengt in een andere legale verschijningsvorm."@nl;
    shacl:name "corrigeert"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalExpression>] [shacl:class <http://data.vlaanderen.be/ns/besluit#Artikel>] [shacl:class <http://data.vlaanderen.be/ns/besluit#Besluit>]);
    shacl:path <http://data.europa.eu/eli/ontology#corrects>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verandert"@nl;
    rdfs:comment "Duidt aan dat deze legale verschijningsvorm een verandering met legale gevolgen doorvoert op een andere legale verschijningsvorm. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#LegaleVerschijningsvorm.Verandert>;
    shacl:description "Duidt aan dat deze legale verschijningsvorm een verandering met legale gevolgen doorvoert op een andere legale verschijningsvorm. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    shacl:name "verandert"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalExpression>] [shacl:class <http://data.vlaanderen.be/ns/besluit#Artikel>] [shacl:class <http://data.vlaanderen.be/ns/besluit#Besluit>]);
    shacl:path <http://data.europa.eu/eli/ontology#changes>
  ], [
    a shacl:PropertyShape;
    rdfs:label "citeert"@nl;
    rdfs:comment "Een citatie in de wettelijke tekst. Dit omvat zowel woordelijke citaten als citaten in verwijzingen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#LegaleVerschijningsvorm.Citeert>;
    shacl:description "Een citatie in de wettelijke tekst. Dit omvat zowel woordelijke citaten als citaten in verwijzingen."@nl;
    shacl:name "citeert"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalExpression>] [shacl:class <http://data.vlaanderen.be/ns/besluit#Artikel>] [shacl:class <http://data.vlaanderen.be/ns/besluit#Besluit>]);
    shacl:path <http://data.europa.eu/eli/ontology#cites>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gecorrigeerd door"@nl;
    rdfs:comment "Duidt een legale verschijningsvorm aan die een tekstuele verandering zonder legale impact aan deze legale verschijningsvorm aanbrengt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#LegaleVerschijningsvorm.GecorrigeerdDoor>;
    shacl:description "Duidt een legale verschijningsvorm aan die een tekstuele verandering zonder legale impact aan deze legale verschijningsvorm aanbrengt."@nl;
    shacl:name "gecorrigeerd door"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalExpression>] [shacl:class <http://data.vlaanderen.be/ns/besluit#Artikel>] [shacl:class <http://data.vlaanderen.be/ns/besluit#Besluit>]);
    shacl:path <http://data.europa.eu/eli/ontology#corrected_by>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#Artikel>,
    <http://data.europa.eu/eli/ontology#LegalExpression>,
    <http://data.vlaanderen.be/ns/besluit#Besluit> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#MandatarisShape> a shacl:NodeShape;
  rdfs:label "Mandataris"@nl;
  rdfs:comment "Een persoon in zijn rol als houder van een mandaat."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is tijdelijk vervangen door"@nl;
    <http://purl.org/vocab/vann/usageNote> "De periode van vervanging komt overeen met de start-/einddatum van de opname van het mandaat van de vervanger."@nl;
    rdfs:comment "Duidt een mandataris aan die tijdelijk de uitvoering van het mandaat heeft overgenomen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Mandataris.IsTijdelijkVervangenDoor>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "Duidt een mandataris aan die tijdelijk de uitvoering van het mandaat heeft overgenomen."@nl;
    shacl:name "is tijdelijk vervangen door"@nl;
    shacl:path <http://data.vlaanderen.be/ns/mandaat#isTijdelijkVervangenDoor>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/mandaat#Mandataris> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond(besluit)Shape> a shacl:NodeShape;
  rdfs:label "Rechtsgrond (Besluit)"@nl;
  rdfs:comment "Het legale concept van een besluit dat los staat van een bepaalde vorm (het achterliggende idee)."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aangenomen door"@nl;
    rdfs:comment "Het orgaan dat de rechtsgrond heeft goedgekeurd, waardoor er een rechtsgevolg ontstond."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond(besluit).AangenomenDoor>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Bestuursorgaan>;
    shacl:description "Het orgaan dat de rechtsgrond heeft goedgekeurd, waardoor er een rechtsgevolg ontstond."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aangenomen door"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#passed_by>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft deel"@nl;
    rdfs:comment "Duidt een artikel aan van dit besluit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond(besluit).HeeftDeel>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>;
    shacl:description "Duidt een artikel aan van dit besluit."@nl;
    shacl:minCount 1;
    shacl:name "heeft deel"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#has_part>
  ];
  shacl:targetClass <http://data.europa.eu/eli/ontology#LegalResource> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#RechtsgrondShape> a shacl:NodeShape;
  rdfs:label "Rechtsgrond"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een rechtsgrond kan zowel een geheel (bvb: wet,besluit) voorstellen als een onderdeel eruit (bvb: artikel)."@nl;
  rdfs:comment "Een legaal concept dat los staat van een bepaalde vorm (het achterliggende idee)."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "buitenwerkingtreding"@nl;
    rdfs:comment "De laatste dag waarop de regelgeving nog van kracht is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond.Buitenwerkingtreding>;
    shacl:datatype xsd:date;
    shacl:description "De laatste dag waarop de regelgeving nog van kracht is."@nl;
    shacl:maxCount "1";
    shacl:name "buitenwerkingtreding"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#date_no_longer_in_force>
  ], [
    a shacl:PropertyShape;
    rdfs:label "inwerkingtreding"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit is niet hetzelfde als wanneer de regelgeving toepasbaar (in de praktijk uitvoerbaar) wordt. De toepasbaarheid van de regelgeving kan op of na de inwerkingtreding liggen."@nl;
    rdfs:comment "De datum waarop de regelgeving van kracht wordt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond.Inwerkingtreding>;
    shacl:datatype xsd:date;
    shacl:description "De datum waarop de regelgeving van kracht wordt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "inwerkingtreding"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#first_date_entry_in_force>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type document"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: reglement, wet, voorstel."@nl;
    rdfs:comment "Het type van de rechtsgrond."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond.TypeDocument>;
    shacl:class <http://data.europa.eu/eli/ontology#ResourceType>;
    shacl:description "Het type van de rechtsgrond."@nl;
    shacl:minCount "1";
    shacl:name "type document"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#type_document>
  ], [
    a shacl:PropertyShape;
    rdfs:label "veranderd door"@nl;
    rdfs:comment "Duidt aan dat deze rechtsgrond een verandering met legale gevolgen heeft ondergaan door een andere rechtsgrond. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond.VeranderdDoor>;
    shacl:description "Duidt aan dat deze rechtsgrond een verandering met legale gevolgen heeft ondergaan door een andere rechtsgrond. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    shacl:name "veranderd door"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalResource>] [shacl:class <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>]);
    shacl:path <http://data.europa.eu/eli/ontology#changed_by>
  ], [
    a shacl:PropertyShape;
    rdfs:label "corrigeert"@nl;
    rdfs:comment "Duidt aan dat deze rechtsgrond tekstuele veranderingen zonder legale impact aanbrengt in een andere rechtsgrond."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond.Corrigeert>;
    shacl:description "Duidt aan dat deze rechtsgrond tekstuele veranderingen zonder legale impact aanbrengt in een andere rechtsgrond."@nl;
    shacl:name "corrigeert"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalResource>] [shacl:class <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>]);
    shacl:path <http://data.europa.eu/eli/ontology#corrects>
  ], [
    a shacl:PropertyShape;
    rdfs:label "citeert"@nl;
    rdfs:comment "Een citatie in de wettelijke tekst. Dit omvat zowel woordelijke citaten als citaten in verwijzingen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond.Citeert>;
    shacl:description "Een citatie in de wettelijke tekst. Dit omvat zowel woordelijke citaten als citaten in verwijzingen."@nl;
    shacl:name "citeert"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalResource>] [shacl:class <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>]);
    shacl:path <http://data.europa.eu/eli/ontology#cites>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verandert"@nl;
    rdfs:comment "Duidt aan dat deze rechtsgrond een verandering met legale gevolgen doorvoert op een andere rechtsgrond. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond.Verandert>;
    shacl:description "Duidt aan dat deze rechtsgrond een verandering met legale gevolgen doorvoert op een andere rechtsgrond. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    shacl:name "verandert"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalResource>] [shacl:class <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>]);
    shacl:path <http://data.europa.eu/eli/ontology#changes>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gecorrigeerd door"@nl;
    rdfs:comment "Duidt een rechtsgrond aan die een tekstuele verandering zonder legale impact aan deze rechtsgrond aanbrengt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond.GecorrigeerdDoor>;
