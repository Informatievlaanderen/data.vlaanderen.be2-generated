    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftNotulen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft secretaris"@nl;
    rdfs:comment "De mandataris die de rol van secretaris heeft gedurende de zitting."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Zitting.HeeftSecretaris>;
