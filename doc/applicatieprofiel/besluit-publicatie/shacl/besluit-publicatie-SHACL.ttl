    shacl:or ([shacl:class <http://data.europa.eu/eli/ontology#LegalResource>] [shacl:class <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>]);
    shacl:path <http://data.europa.eu/eli/ontology#corrected_by>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft bijlage"@nl;
    rdfs:comment "Een bijlage waarnaar verwezen wordt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Rechtsgrond.HeeftBijlage>;
    shacl:description "Een bijlage waarnaar verwezen wordt."@nl;
