    shacl:name "heeft zittingsverslag"@nl;
    shacl:or ([shacl:class foaf:Document] [shacl:class <http://data.vlaanderen.be/ns/besluit#Besluit>]);
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftZittingsverslag>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft aanwezige bij start"@nl;
    rdfs:comment "Een mandataris (van het bestuursorsgaan die de zitting hield) die aanwezig was bij de start van de zitting."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Zitting.HeeftAanwezigeBijStart>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "Een mandataris (van het bestuursorsgaan die de zitting hield) die aanwezig was bij de start van de zitting."@nl;
    shacl:minCount 1;
    shacl:name "heeft aanwezige bij start"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftAanwezigeBijStart>
  ], [
    a shacl:PropertyShape;
    rdfs:label "behandelt"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook punten die kunnen ingepland worden (voorafgaand aan de zitting) en er eventueel weer afgehaald worden, vallen hieronder."@nl;
    rdfs:comment "Een formeel vastgelegd agendapunt van de zitting."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Zitting.Behandelt>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Agendapunt>;
    shacl:description "Een formeel vastgelegd agendapunt van de zitting."@nl;
    shacl:minCount 1;
    shacl:name "behandelt"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#behandelt>
  ], [
