    shacl:description "De mandataris die de rol van secretaris heeft gedurende de zitting."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft secretaris"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#heeftSecretaris>
  ], [
    a shacl:PropertyShape;
