<https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#DocumentonderdeelShape> a shacl:NodeShape;
  rdfs:label "Documentonderdeel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv artikel,hoofdstuk,paragraaf..."@nl;
  rdfs:comment "Een apart onderdeel van een groter document of verzameld document."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "nummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv nummer vh artikel, paragraaf, hoofdstuk..."@nl;
    rdfs:comment "Nummer vh documentonderdeel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/erkendestandaard/2025-12-11#Documentonderdeel.Nummer>;
