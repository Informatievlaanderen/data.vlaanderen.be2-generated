<https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#AanleidingShape> a shacl:NodeShape;
  rdfs:label "Aanleiding"@nl;
  <http://purl.org/vocab/vann/usageNote> "Vooral aangeraden bij een formele aanleiding."@nl;
  rdfs:comment "Ontstaansgrond van een besluitvormingsaangelegenheid."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een omschrijving van de aanleiding"@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Aanleiding.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Een omschrijving van de aanleiding"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft oorsprong in"@nl;
    <http://purl.org/vocab/vann/usageNote> "bv andere wetgeving."@nl;
    rdfs:comment "Het stuk waarop de aanleiding zich baseert."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Aanleiding.HeeftOorsprongIn>;
    shacl:class <https://data.vlaanderen.be/ns/dossier#Stuk>;
    shacl:description "Het stuk waarop de aanleiding zich baseert."@nl;
    shacl:name "heeft oorsprong in"@nl;
    shacl:path <https://data.vlaanderen.be/ns/besluitvorming#Aanleiding.heeftOorsprongIn>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/besluitvorming#Aanleiding> .

<https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#ActiviteitShape> a shacl:NodeShape;
  rdfs:label "Activiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv het consumeren, verwerken, transformeren, wijzigen, verplaatsen, gebruiken of genereren van entiteiten."@nl;
  rdfs:comment "Handeling van bepaalde duur op of met entiteiten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De naam van de activiteit."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Activiteit.Naam>;
    shacl:datatype xsd:string;
    shacl:description "De naam van de activiteit."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "startdatum"@nl;
    rdfs:comment "De startdatum van de activiteit."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Activiteit.Startdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De startdatum van de activiteit."@nl;
    shacl:maxCount "1";
    shacl:name "startdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#Activiteit.startdatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "De einddatum van de activiteit."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Activiteit.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De einddatum van de activiteit."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#Activiteit.einddatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geplande start"@nl;
    rdfs:comment "Het tijdstip waarop de activiteit gepland is om te beginnen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Activiteit.GeplandeStart>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het tijdstip waarop de activiteit gepland is om te beginnen."@nl;
    shacl:maxCount "1";
    shacl:name "geplande start"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#geplandeStart>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voor subklassen van activiteit zoals Agendering en BehandelingVanAgendapunt  mag de klasse als type worden gebruikt."@nl;
    rdfs:comment "Categorie waartoe deze activiteit behoord."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Activiteit.Type>;
    shacl:class skos:Concept;
    shacl:description "Categorie waartoe deze activiteit behoord."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "genereert"@nl;
    rdfs:comment "Een activiteit kan een stuk genereren."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Activiteit.Genereert>;
    shacl:class <https://data.vlaanderen.be/ns/dossier#Stuk>;
    shacl:description "Een activiteit kan een stuk genereren."@nl;
    shacl:name "genereert"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#genereert>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft deelnemer"@nl;
    rdfs:comment "Persoon of organisatie die binnen een bepaalde rol een verantwoordelijkheid opneemt voor deze activiteit."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Activiteit.HeeftDeelnemer>;
    shacl:class prov:Association;
    shacl:description "Persoon of organisatie die binnen een bepaalde rol een verantwoordelijkheid opneemt voor deze activiteit."@nl;
    shacl:name "heeft deelnemer"@nl;
    shacl:path prov:qualifiedAssociation
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruikt"@nl;
    rdfs:comment "De stukken die werden gebruikt voor de activiteit."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Activiteit.Gebruikt>;
    shacl:class <https://data.vlaanderen.be/ns/dossier#Stuk>;
    shacl:description "De stukken die werden gebruikt voor de activiteit."@nl;
    shacl:name "gebruikt"@nl;
    shacl:path prov:used
  ], [
    a shacl:PropertyShape;
    rdfs:label "was geassocieerd met"@nl;
    rdfs:comment "Een toewijzing van verantwoordelijkheid aan een agent voor een activiteit, wat aangeeft dat de agent een rol in de activiteit had."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Activiteit.WasGeassocieerdMet>;
    shacl:class dc:Agent;
    shacl:description "Een toewijzing van verantwoordelijkheid aan een agent voor een activiteit, wat aangeeft dat de agent een rol in de activiteit had."@nl;
    shacl:minCount 1;
    shacl:name "was geassocieerd met"@nl;
    shacl:path prov:wasAssociatedWith
  ], [
    a shacl:PropertyShape;
    rdfs:label "vindt plaats tijdens"@nl;
    <http://purl.org/vocab/vann/usageNote> "Tijdens een procedurestappen vinden typisch meerdere activiteiten plaats."@nl;
    rdfs:comment "Een activiteit vindt plaats tijdens een procedurestap."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Activiteit.VindtPlaatsTijdens>;
    shacl:class <https://data.vlaanderen.be/ns/dossier#Procedurestap>;
    shacl:description "Een activiteit vindt plaats tijdens een procedurestap."@nl;
    shacl:maxCount 1;
    shacl:name "vindt plaats tijdens"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#vindtPlaatsTijdens>
  ];
  shacl:targetClass prov:Activity .

<https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#AgendaShape> a shacl:NodeShape;
  rdfs:label "Agenda"@nl;
  <http://purl.org/vocab/vann/usageNote> "De agenda behoort niet tot het dossier van de besluitvormingsaangelegenheid"@nl;
  rdfs:comment "Een geordende lijst van agendapunten voor een Vergaderactiviteit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "agenda status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld Ontwerp, Tussentijds goedgekeurd, Definitief, etc."@nl;
    rdfs:comment "De toestand waarin de agenda zich bevindt voor een specifiek type."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agenda.AgendaStatus>;
    shacl:class skos:Concept;
    shacl:description "De toestand waarin de agenda zich bevindt voor een specifiek type."@nl;
    shacl:maxCount "1";
    shacl:name "agenda status"@nl;
    shacl:path <https://data.vlaanderen.be/ns/besluitvorming#agendaStatus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "agenda type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld Spoedeisend, Aanvullend, etc."@nl;
    rdfs:comment "Soort agenda."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agenda.AgendaType>;
    shacl:class skos:Concept;
    shacl:description "Soort agenda."@nl;
    shacl:maxCount "1";
    shacl:name "agenda type"@nl;
    shacl:path <https://data.vlaanderen.be/ns/besluitvorming#agendaType>
  ], [
    a shacl:PropertyShape;
    rdfs:label "behandelt"@nl;
    rdfs:comment "De Agenda die effectief wordt behandeld op de Vergaderactiviteit."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agenda.Behandelt>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Vergaderactiviteit>;
    shacl:description "De Agenda die effectief wordt behandeld op de Vergaderactiviteit."@nl;
    shacl:maxCount 1;
    shacl:name "behandelt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/besluitvorming#Agenda.behandelt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is agenda voor"@nl;
    rdfs:comment "De Vergaderactiviteit waarvoor de Agenda wordt voorbereid."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agenda.IsAgendaVoor>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Vergaderactiviteit>;
    shacl:description "De Vergaderactiviteit waarvoor de Agenda wordt voorbereid."@nl;
    shacl:maxCount 1;
    shacl:name "is agenda voor"@nl;
    shacl:path <https://data.vlaanderen.be/ns/besluitvorming#isAgendaVoor>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/besluitvorming#Agenda> .

<https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#AgendapuntShape> a shacl:NodeShape;
  rdfs:label "Agendapunt"@nl;
  rdfs:comment "Formeel aanvaard te behandelen onderwerp op een vergadering."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "De volledige naam van het agendapunt"@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agendapunt.Titel>;
    shacl:datatype xsd:string;
    shacl:description "De volledige naam van het agendapunt"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Korte beschrijving van het agendapunt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agendapunt.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Korte beschrijving van het agendapunt."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "gepland openbaar"@nl;
    rdfs:comment "Geeft aan of het al dan niet de bedoeling is om het agendapunt publiek te maken."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agendapunt.GeplandOpenbaar>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of het al dan niet de bedoeling is om het agendapunt publiek te maken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gepland openbaar"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#geplandOpenbaar>
  ], [
    a shacl:PropertyShape;
    rdfs:label "korte titel"@nl;
    rdfs:comment "Een verkorte vorm van de naam."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agendapunt.KorteTitel>;
    shacl:datatype xsd:string;
    shacl:description "Een verkorte vorm van de naam."@nl;
    shacl:maxCount "1";
    shacl:name "korte titel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/besluitvorming#korteTitel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Type van het agendapunt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agendapunt.Type>;
    shacl:class skos:Concept;
    shacl:description "Type van het agendapunt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#Agendapunt.type>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is onderdeel van"@nl;
    rdfs:comment "De Agenda waarvan dit Agendapunt een onderdeel is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agendapunt.IsOnderdeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/besluitvorming#Agenda>;
    shacl:description "De Agenda waarvan dit Agendapunt een onderdeel is."@nl;
    shacl:name "is onderdeel van"@nl;
    shacl:path dc:isPartOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "genereert agendapunt"@nl;
    rdfs:comment "Het agendapunt of de agendapunten die werden aangemaakt als gevolg van de agendering."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agendapunt.GenereertAgendapunt>;
    shacl:class <https://data.vlaanderen.be/ns/besluitvorming#Agendering>;
    shacl:description "Het agendapunt of de agendapunten die werden aangemaakt als gevolg van de agendering."@nl;
    shacl:maxCount 1;
    shacl:name "genereert agendapunt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/besluitvorming#Agendapunt.genereertAgendapunt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geagendeerd stuk"@nl;
    rdfs:comment "Een gerelateerd stuk waarnaar wordt verwezen, geciteerd of anderszins aangegeven in het agendapunt"@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agendapunt.GeagendeerdStuk>;
    shacl:class <https://data.vlaanderen.be/ns/dossier#Stuk>;
    shacl:description "Een gerelateerd stuk waarnaar wordt verwezen, geciteerd of anderszins aangegeven in het agendapunt"@nl;
    shacl:name "geagendeerd stuk"@nl;
    shacl:path <https://data.vlaanderen.be/ns/besluitvorming#geagendeerdStuk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vervangt"@nl;
    rdfs:comment "Origineel agendapunt waarvan dit agendapunt een herziening is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agendapunt.Vervangt>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Agendapunt>;
    shacl:description "Origineel agendapunt waarvan dit agendapunt een herziening is."@nl;
    shacl:name "vervangt"@nl;
    shacl:path prov:wasRevisionOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "is aangebracht na"@nl;
    rdfs:comment "Duidt aan dat een agendapunt na een ander agendapunt is aangebracht op een vergadering."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/besluitvorming/erkendestandaard/2025-12-11#Agendapunt.IsAangebrachtNa>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Agendapunt>;
    shacl:description "Duidt aan dat een agendapunt na een ander agendapunt is aangebracht op een vergadering."@nl;
