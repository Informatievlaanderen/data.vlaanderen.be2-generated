<https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#AddresshistoryShape> a shacl:NodeShape;
  rdfs:label "AddressHistory";
  rdfs:comment """Deze historiek tabel koppelt twee historisch gerelateerde entiteiten.
Elke historische entiteit heeft dezelfde structuur: voorganger, opvolger en eventDate. (opgebouwd door BOSA op basis van mutaties verwerkt in de BeSt Address databank)"""@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum gebeurtenis"@nl;
    rdfs:comment "Datum van de mutatie die deze voorganger-opvolgerrelatie creëerde."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Addresshistory.DatumGebeurtenis>;
    shacl:datatype xsd:date;
    shacl:description "Datum van de mutatie die deze voorganger-opvolgerrelatie creëerde."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "datum gebeurtenis"@nl;
    shacl:path <http://todo.com/eventDate>
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorganger"@nl;
    rdfs:comment "De BeSt identifier van de entiteit die de voorganger is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Addresshistory.Voorganger>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "De BeSt identifier van de entiteit die de voorganger is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "voorganger"@nl;
    shacl:path <http://todo.com/predecessor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "opvolger"@nl;
    rdfs:comment "de BeSt identificator van de entiteit die de opvolger is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Addresshistory.Opvolger>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "de BeSt identificator van de entiteit die de opvolger is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "opvolger"@nl;
    shacl:path <http://todo.com/successor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "successor";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Addresshistory.Successor>;
    shacl:class <http://inspire.ec.europa.eu/ont/ad#Address>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "successor";
    shacl:path <http://todo.com/>
  ], [
    a shacl:PropertyShape;
    rdfs:label "predecessor";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Addresshistory.Predecessor>;
    shacl:class <http://inspire.ec.europa.eu/ont/ad#Address>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "predecessor";
    shacl:path <http://todo.com/>
  ];
  shacl:targetClass <http://todo.com/AddressHistory> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#AdresShape> a shacl:NodeShape;
  rdfs:label "Adres"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Huisnummer"@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Huisnummer"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorDesignator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Busnummer"@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die hetzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die hetzelfde huisnummer hebben."@nl;
    shacl:maxCount 1;
    shacl:name "Busnummer"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorDesignator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einde van de levenscyclus van deze versie"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.EindeVanDeLevenscyclusVanDezeVersie>;
    shacl:datatype xsd:dateTime;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "einde van de levenscyclus van deze versie"@nl;
    shacl:path <http://todo.com/endLifespanVersion>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Adres sorteerveld"@nl;
    rdfs:comment "Transformatie van het huisnummer en busnummer (toevoeging van leading 0's) zodat deze waarde kan gesorteerd worden"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.AdresSorteerveld>;
    shacl:datatype xsd:string;
    shacl:description "Transformatie van het huisnummer en busnummer (toevoeging van leading 0's) zodat deze waarde kan gesorteerd worden"@nl;
    shacl:maxCount 1;
    shacl:name "Adres sorteerveld"@nl;
    shacl:path <http://vocab.belgif.be/ns/location#addressSortField>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Officieel toegekend"@nl;
    <http://purl.org/vocab/vann/usageNote> "Als een afwijking wordt vastgesteld, kan de gemeente ambtenaar dit aanpassen naar \"False\"."@nl;
    rdfs:comment "Geeft aan of het adres is toegekend door een officiële instantie (gewoonlijk de gemeente) (True)."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.OfficieelToegekend>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of het adres is toegekend door een officiële instantie (gewoonlijk de gemeente) (True)."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Officieel toegekend"@nl;
    shacl:path <http://todo.com/officiallyAssigned>
  ], [
    a shacl:PropertyShape;
    rdfs:label "begin van de levenscyclus van deze versie"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.BeginVanDeLevenscyclusVanDezeVersie>;
    shacl:datatype xsd:dateTime;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "begin van de levenscyclus van deze versie"@nl;
    shacl:path <http://todo.com/beginLifespanVersion>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Is gehecht aan"@nl;
    rdfs:comment "het Adresseerbaar object waaraan het adres is toegekend."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.IsGehechtAan>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "het Adresseerbaar object waaraan het adres is toegekend."@nl;
    shacl:name "Is gehecht aan"@nl;
    shacl:path <http://todo.com/isAssignedToAddressableObject>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft als post informatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "BeStIdentifier die de postalInfo identificeert waar dit adres zich bevindt"@nl;
    rdfs:comment "BeStIdentifier die de postalInfo identificeert waar dit adres zich bevindt"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.HeeftAlsPostInformatie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "BeStIdentifier die de postalInfo identificeert waar dit adres zich bevindt"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft als post informatie"@nl;
    shacl:path <http://todo.com/hasPostalInfo>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "Huidige status van het adres."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.Status>;
    shacl:class <http://todo.com/Status>;
    shacl:description "Huidige status van het adres."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "status"@nl;
    shacl:path <http://todo.com/status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft als deelgemeente"@nl;
    rdfs:comment "BeStIdentifier die de deelgemeente identificeert waar dit adres zich bevindt. Deelgemeentes zijn op dit ogenblik enkel voor Wallonië beschikbaar."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.HeeftAlsDeelgemeente>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "BeStIdentifier die de deelgemeente identificeert waar dit adres zich bevindt. Deelgemeentes zijn op dit ogenblik enkel voor Wallonië beschikbaar."@nl;
    shacl:maxCount 1;
    shacl:name "heeft als deelgemeente"@nl;
    shacl:path <http://todo.com/hasPartOfMunicipality>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft als straatnaam"@nl;
    rdfs:comment "heeftStraatNaam"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.HeeftAlsStraatnaam>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "heeftStraatNaam"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft als straatnaam"@nl;
    shacl:path <http://todo.com/hasStreetName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft als gemeente"@nl;
    rdfs:comment "BeStIdentifier die de gemeente identificeert waar dit adres zich bevindt. Dit kenmerk is altijd aanwezig."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.HeeftAlsGemeente>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "BeStIdentifier die de gemeente identificeert waar dit adres zich bevindt. Dit kenmerk is altijd aanwezig."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft als gemeente"@nl;
    shacl:path <http://todo.com/hasMunicipality>
  ], [
    a shacl:PropertyShape;
    rdfs:label "code"@nl;
    rdfs:comment "Unieke identificatie"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.Code>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Unieke identificatie"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "code"@nl;
    shacl:path <http://todo.com/code>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Positie"@nl;
    rdfs:comment "Geografische positie aangegeven dmv een punt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.Positie>;
    shacl:class <http://inspire.ec.europa.eu/ont/ad#GeographicPosition>;
    shacl:description "Geografische positie aangegeven dmv een punt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Positie"@nl;
    shacl:path <http://inspire.ec.europa.eu/ont/ad#Address.position>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasStreetName";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.Hasstreetname>;
    shacl:class <http://inspire.ec.europa.eu/ont/ad#ThoroughfareName>;
    shacl:maxCount 1;
