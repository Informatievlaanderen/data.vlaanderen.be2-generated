<https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#DeelgemeenteShape> a shacl:NodeShape;
  rdfs:label "Deelgemeente"@nl;
  rdfs:comment "Een deel van een gemeente, zoals een voormalige gemeente (voorafgaand aan de fusie van de gemeenten) of een wijk."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "code"@nl;
    rdfs:comment "Unieke identificatie; de objectIdentifier is een nummer (niet de NIS-code)"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Deelgemeente.Code>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Unieke identificatie; de objectIdentifier is een nummer (niet de NIS-code)"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "code"@nl;
    shacl:path <http://www.w3.org/ns/adms#Identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van de deelgemeente"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Deelgemeente.Naam>;
    shacl:class <http://vocab.belgif.be/ns/location#GeographicalName>;
    shacl:description "Naam van de deelgemeente"@nl;
    shacl:maxCount 3;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path <http://vocab.belgif.be/ns/location#name>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "Status van de deelgemeente"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Deelgemeente.Status>;
    shacl:class <http://vocab.belgif.be/ns/location#Status>;
    shacl:description "Status van de deelgemeente"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "status"@nl;
    shacl:path <http://vocab.belgif.be/ns/location#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isPartOf";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Deelgemeente.IsPartOf>;
    shacl:class <http://vocab.belgif.be/ns/location#Municipality>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "isPartOf";
    shacl:path <http://todo.com/PartOfMunicipality.isPartOf>
  ];
  shacl:targetClass <http://vocab.belgif.be/ns/location#PartOfMunicipality> .

