<https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#AdresseerbaarObjectShape> a shacl:NodeShape;
  rdfs:label "Adresseerbaar object"@nl;
  rdfs:comment "Ruimtelijk object waaraan een adres kan worden toegekend. De meest voorkomende adresseerbare objecten zijn gebouwen, percelen, gebouwingangen, gemene delen binnen een gebouw etc."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "code";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#AdresseerbaarObject.Code>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "code";
    shacl:path <http://todo.com/code>
  ];
  shacl:targetClass <http://vocab.belgif.be/ns/location#AddressableObject> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#BooleanShape> a shacl:NodeShape;
  rdfs:label "boolean";
  shacl:closed false;
