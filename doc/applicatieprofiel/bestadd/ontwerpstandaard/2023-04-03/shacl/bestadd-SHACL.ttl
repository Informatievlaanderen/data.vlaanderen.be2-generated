<https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#GemeenteShape> a shacl:NodeShape;
  rdfs:label "Gemeente"@nl;
  rdfs:comment "Officiële administratieve zone van het Belgisch grondgebied. De gemeente is het kleinste administratieve deel van het Belgisch grondgebied waarvan de grenzen enkel door de wetgever kunnen worden gewijzigd."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "code"@nl;
    rdfs:comment "Unieke identificatie; de objectIdentifier is momenteel de NIScode"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Gemeente.Code>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Unieke identificatie; de objectIdentifier is momenteel de NIScode"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "code"@nl;
    shacl:path <http://www.w3.org/ns/adms#Identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Gemeentenaam"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Gemeente.Naam>;
    shacl:class <http://vocab.belgif.be/ns/location#GeographicalName>;
    shacl:description "Gemeentenaam"@nl;
    shacl:maxCount 3;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path <http://vocab.belgif.be/ns/location#name>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "Gemeentelijke status"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Gemeente.Status>;
    shacl:class <http://vocab.belgif.be/ns/location#Status>;
    shacl:description "Gemeentelijke status"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "status"@nl;
    shacl:path <http://vocab.belgif.be/ns/location#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isPartOf";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Gemeente.IsPartOf>;
