    shacl:minCount 1;
    shacl:name "geografische naam"@nl;
    shacl:path <http://todo.com/spelling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment """Taal waarin de spelling is geschreven. De taal kan drie waarden hebben en wordt gespecificeerd in de taalcodewaarde (languageCodeValue).
- Nl
- Fr
- De
Elke taal is maximaal één keer per object aanwezig."""@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Geographicalname.Naam>;
    shacl:class <http://todo.com/LanguageCodeValue>;
    shacl:description """Taal waarin de spelling is geschreven. De taal kan drie waarden hebben en wordt gespecificeerd in de taalcodewaarde (languageCodeValue).
- Nl
- Fr
- De
Elke taal is maximaal één keer per object aanwezig."""@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path <http://todo.com/language>
  ];
  shacl:targetClass <http://todo.com/GeographicalName> .

