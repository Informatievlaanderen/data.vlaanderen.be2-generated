  rdfs:label "Coordinates";
  rdfs:comment "Positie uitgedrukt volgens de WGS84 standaard (World Geodetic System 1984 op basis van lengtegraad en breedtegraad)"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lat";
