  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Homoniemtoevoeging"@nl;
    rdfs:comment "Toevoeging aan de straatnaam om een onderscheid te maken tussen 2 straten die dezelfde naam hebben binnen dezelfde gemeente, bijv. e.g. Groenstraat (ANBO), Groenstraat (HOWI)"@nl;
