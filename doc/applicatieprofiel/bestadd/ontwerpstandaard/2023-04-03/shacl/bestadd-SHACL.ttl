<https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#GeographicalNameShape> a shacl:NodeShape;
  rdfs:label "GeographicalName";
  rdfs:comment """Namen zoals gemeentenamen zijn meertalig in België. Er wordt een speciale klasse gebruikt om deze meertalige situatie uit te drukken.
De GeographicalName bestaat uit de volgende subelementen: spelling en talen."""@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment """Taal waarin de spelling is geschreven. De taal kan drie waarden hebben en wordt gespecificeerd in de taalcodewaarde (languageCodeValue).
- Nl
- Fr
- De
Elke taal is maximaal één keer per object aanwezig."""@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#GeographicalName.Naam>;
    shacl:class <http://todo.com/LanguageCodeValue>;
    shacl:description """Taal waarin de spelling is geschreven. De taal kan drie waarden hebben en wordt gespecificeerd in de taalcodewaarde (languageCodeValue).
- Nl
- Fr
- De
Elke taal is maximaal één keer per object aanwezig."""@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path <http://vocab.belgif.be/ns/location#language>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geografische naam"@nl;
    rdfs:comment "De naam uitgeschreven in de gespecifieerde taal"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#GeographicalName.GeografischeNaam>;
    shacl:class <http://todo.com/LanguageCodeValue>;
    shacl:description "De naam uitgeschreven in de gespecifieerde taal"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "geografische naam"@nl;
    shacl:path <http://vocab.belgif.be/ns/location#spelling>
  ];
  shacl:targetClass <http://vocab.belgif.be/ns/location#GeographicalName> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#IdentifierShape> a shacl:NodeShape;
  rdfs:label "Identifier"@nl;
  rdfs:comment """De sleutel van een BeSt-object;  bestaat uit 3 subelementen: namespace, de objectIdentifier en de versionIdentifier.
De \"Identifier\" identificeert op unieke wijze een straatnaam, een gemeente, een adres, enz.
De BeSt-identifier is niet persistent in de"""@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Namespace"@nl;
    rdfs:comment "De naamruimte die de regio's gebruiken om de regio en het elementtype te identificeren"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Identifier.Namespace>;
    shacl:datatype xsd:string;
    shacl:description "De naamruimte die de regio's gebruiken om de regio en het elementtype te identificeren"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Namespace"@nl;
    shacl:path <http://vocab.belgif.be/ns/location#nameSpace>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Identificator van een object"@nl;
    <http://purl.org/vocab/vann/usageNote> "een nummer dat het object binnen de naamruimte eenduidig identificeert."@nl;
    rdfs:comment "Een integer die het middelste deel van de BeSt identifier voorstelt"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Identifier.IdentificatorVanEenObject>;
    shacl:datatype xsd:string;
    shacl:description "Een integer die het middelste deel van de BeSt identifier voorstelt"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Identificator van een object"@nl;
    shacl:path <http://vocab.belgif.be/ns/location#objectIdentifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Identificator van een versie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een versionIdentifier kan een datum/tijdstempel zijn (zoals in Vlaanderen) of een nummer (zoals in Wallonië en Brussel)."@nl;
    rdfs:comment "Versie van de BeSt identifier; laatste deel van de BeSt identifier"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Identifier.IdentificatorVanEenVersie>;
    shacl:datatype xsd:string;
    shacl:description "Versie van de BeSt identifier; laatste deel van de BeSt identifier"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Identificator van een versie"@nl;
    shacl:path <http://vocab.belgif.be/ns/location#versionIdentifier>
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

