    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.Hasmunicipality>;
    shacl:class <http://vocab.belgif.be/ns/location#Municipality>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "hasMunicipality";
    shacl:path <http://todo.com/>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasPartOfMunicipality";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.Haspartofmunicipality>;
    shacl:class <http://vocab.belgif.be/ns/location#PartOfMunicipality>;
    shacl:maxCount 1;
    shacl:name "hasPartOfMunicipality";
    shacl:path <http://todo.com/>
  ], [
    a shacl:PropertyShape;
    rdfs:label "successor";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/bestadd/ontwerpstandaard/2023-04-03#Adres.Successor>;
