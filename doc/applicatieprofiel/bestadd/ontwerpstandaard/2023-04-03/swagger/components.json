{
  "openapi": "3.0.4",
  "info": {
    "title": "Components of OpenAPI",
    "description": "This",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Event": {
        "title": "Event",
        "type": "object",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Event)",
            "pattern": "^Event$"
          },
          "gebeurtenisDatum": {
            "type": "object",
            "description": "Datum van de mutatie die deze voorganger-opvolgerrelatie creëerde.",
            "properties": {
              "@value": {
                "type": "string",
                "format": "date"
              },
              "@type": {
                "type": "string",
                "pattern": "^Date$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "opvolger": {
            "type": "array",
            "description": "Lijst van Identifier items.",
            "items": {
              "$ref": "#/components/schemas/Identifier"
            },
            "minItems": 1
          }
        },
        "required": [
          "@type",
          "gebeurtenisDatum",
          "opvolger"
        ]
      },
      "Gemeente": {
        "title": "Gemeente",
        "type": "object",
        "description": "Officiële administratieve zone van het Belgisch grondgebied. De gemeente is het kleinste administratieve deel van het Belgisch grondgebied waarvan de grenzen enkel door de wetgever kunnen worden gewijzigd.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Gemeente)",
            "pattern": "^Gemeente$"
          },
          "code": {
            "$ref": "#/components/schemas/Identifier"
          },
          "naam": {
            "type": "array",
            "description": "Lijst van GeographicalName items.",
            "items": {
              "$ref": "#/components/schemas/GeographicalName"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "isPartOf": {
            "type": "array",
            "description": "Lijst van Deelgemeente items.",
            "items": {
              "$ref": "#/components/schemas/Deelgemeente"
            },
            "minItems": 1
          }
        },
        "required": [
          "@type",
          "code",
          "naam",
          "status"
        ]
      },
      "Taalcodewaarde": {
        "title": "Taalcodewaarde",
        "type": "object",
        "description": "Geeft aan in welke taal de naam van de gemeente werd geschreven",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Taalcodewaarde)",
            "pattern": "^Taalcodewaarde$"
          }
        },
        "required": [
          "@type"
        ]
      },
      "Adres": {
        "title": "Adres",
        "type": "object",
        "description": "Een adres identificeert op een voor mensen leesbare manier de vaste locatie van een ruimtelijk object  (gebouw, perceel, standplaats, ligplaats). \r\nHiervoor heeft een adres een identificatie, bijvoorbeeld een huisnummer, waarmee een gebruiker het kan onde",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Adres)",
            "pattern": "^Adres$"
          },
          "busnummer": {
            "type": "object",
            "description": "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die hetzelfde huisnummer hebben.",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "huisnummer": {
            "type": "object",
            "description": "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen.",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "officieelToegekend": {
            "type": "object",
            "description": "Geeft aan of het adres is toegekend door een officiële instantie (gewoonlijk de gemeente) (True). Als een afwijking wordt vastgesteld, kan de gemeente ambtenaar dit aanpassen naar \"False\".",
            "properties": {
              "@value": {
                "type": "boolean"
              },
              "@type": {
                "type": "string",
                "pattern": "^Boolean$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "adresSorteerveld": {
            "type": "object",
            "description": "Transformatie van het huisnummer en busnummer (toevoeging van leading 0's) zodat deze waarde kan gesorteerd worden",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "beginVanDeLevenscyclusVanDezeVersie": {
            "type": "object",
            "description": "Geeft aan wanneer het record is aangemaakt in de database van de authentieke bron  Deze lifespan informatie heeft twee doelstellingen: 1. informatie verstrekken over de inhoud van de databank op een bepaald tijdstip. 2. Informatie verstrekken over de vera",
            "properties": {
              "@value": {
                "type": "string",
                "format": "date-time"
              },
              "@type": {
                "type": "string",
                "pattern": "^DateTime$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "eindeVanDeLevenscyclusVanDezeVersie": {
            "type": "object",
            "description": "Geeft aan wanneer het record werd gearchiveerd in de databank van de authentieke bron  Deze lifespan informatie heeft twee doelstellingen: 1. informatie verstrekken over de inhoud van de databank op een bepaald tijdstip. 2. Informatie verstrekken over de",
            "properties": {
              "@value": {
                "type": "string",
                "format": "date-time"
              },
              "@type": {
                "type": "string",
                "pattern": "^DateTime$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "code": {
            "$ref": "#/components/schemas/Identifier"
          },
          "positie": {
            "$ref": "#/components/schemas/GeografischePositie"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "hasPartOfMunicipality": {
            "$ref": "#/components/schemas/Deelgemeente"
          },
          "hasMunicipality": {
            "$ref": "#/components/schemas/Gemeente"
          },
          "hasPostalInfo": {
            "$ref": "#/components/schemas/PostInformatie"
          },
          "isAssignedToAddressableObject": {
            "$ref": "#/components/schemas/AdresseerbaarObject"
          },
          "hasStreetName": {
            "$ref": "#/components/schemas/Straatnaam"
          }
        },
        "required": [
          "@type",
          "huisnummer",
          "officieelToegekend",
          "beginVanDeLevenscyclusVanDezeVersie",
          "eindeVanDeLevenscyclusVanDezeVersie",
          "code",
          "positie",
          "status",
          "hasMunicipality",
          "hasPostalInfo",
          "hasStreetName"
        ]
      },
      "PositieGeometrieMethodeWaarde": {
        "title": "PositieGeometrieMethodeWaarde",
        "type": "object",
        "description": "Geeft aan welke geometrie methode werd gebruikt om de positie te bepalen",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse PositieGeometrieMethodeWaarde)",
            "pattern": "^PositieGeometrieMethodeWaarde$"
          }
        },
        "required": [
          "@type"
        ]
      },
      "Status": {
        "title": "Status",
        "type": "object",
        "description": "De status bevat de status waarde en de geldigheidsperiode (datum van en datum tot)",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Status)",
            "pattern": "^Status$"
          },
          "geldigVanaf": {
            "type": "object",
            "description": "de startdatum vanaf wanneer de entiteit geldig is.",
            "properties": {
              "@value": {
                "type": "string",
                "format": "date"
              },
              "@type": {
                "type": "string",
                "pattern": "^Date$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "geldigTot": {
            "type": "object",
            "description": "de einddatum tot wanneer de entiteit geldig is",
            "properties": {
              "@value": {
                "type": "string",
                "format": "date"
              },
              "@type": {
                "type": "string",
                "pattern": "^Date$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/Statuswaarde"
          }
        },
        "required": [
          "@type",
          "geldigVanaf",
          "status"
        ]
      },
      "PositieSpecificatieWaarde": {
        "title": "PositieSpecificatieWaarde",
        "type": "object",
        "description": "Beschrijving van het type adreseerbaar object waarnaar de adres positie verwijst",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse PositieSpecificatieWaarde)",
            "pattern": "^PositieSpecificatieWaarde$"
          }
        },
        "required": [
          "@type"
        ]
      },
      "AdresseerbaarObject": {
        "title": "AdresseerbaarObject",
        "type": "object",
        "description": "Ruimtelijk object waaraan een adres kan worden toegekend. De meest voorkomende adresseerbare objecten zijn gebouwen, percelen, gebouwingangen, gemene delen binnen een gebouw etc.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse AdresseerbaarObject)",
            "pattern": "^AdresseerbaarObject$"
          },
          "code": {
            "$ref": "#/components/schemas/Identifier"
          }
        },
        "required": [
          "@type",
          "code"
        ]
      },
      "Statuswaarde": {
        "title": "Statuswaarde",
        "type": "object",
        "description": "De status waarde bevat één van de mogelijke status waardes",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Statuswaarde)",
            "pattern": "^Statuswaarde$"
          }
        },
        "required": [
          "@type"
        ]
      },
      "GeografischePositie": {
        "title": "GeografischePositie",
        "type": "object",
        "description": "Geografische positie aangegeven door een punt.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse GeografischePositie)",
            "pattern": "^GeografischePositie$"
          },
          "geometrischPunt": {
            "$ref": "#/components/schemas/Point"
          },
          "positiegeometriemethode": {
            "$ref": "#/components/schemas/PositieGeometrieMethodeWaarde"
          },
          "positiespecificatie": {
            "$ref": "#/components/schemas/PositieSpecificatieWaarde"
          }
        },
        "required": [
          "@type",
          "geometrischPunt",
          "positiegeometriemethode",
          "positiespecificatie"
        ]
      },
      "Deelgemeente": {
        "title": "Deelgemeente",
        "type": "object",
        "description": "Een deel van een gemeente, zoals een voormalige gemeente (voorafgaand aan de fusie van de gemeenten) of een wijk.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Deelgemeente)",
            "pattern": "^Deelgemeente$"
          },
          "code": {
            "$ref": "#/components/schemas/Identifier"
          },
          "naam": {
            "type": "array",
            "description": "Lijst van GeographicalName items.",
            "items": {
              "$ref": "#/components/schemas/GeographicalName"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "isPartOf": {
            "$ref": "#/components/schemas/Gemeente"
          }
        },
        "required": [
          "@type",
          "code",
          "naam",
          "status",
          "isPartOf"
        ]
      },
      "StraatnaamType": {
        "title": "StraatnaamType",
        "type": "object",
        "description": "Aard van de straatnaam.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse StraatnaamType)",
            "pattern": "^StraatnaamType$"
          }
        },
        "required": [
          "@type"
        ]
      },
      "Straatnaam": {
        "title": "Straatnaam",
        "type": "object",
        "description": "Een adrescomponent die de naam is van een passage of een weg van de ene locatie naar een andere.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Straatnaam)",
            "pattern": "^Straatnaam$"
          },
          "homoniemtoevoeging": {
            "type": "object",
            "description": "Toevoeging aan de straatnaam om een onderscheid te maken tussen 2 straten die dezelfde naam hebben binnen dezelfde gemeente, bijv. e.g. Groenstraat (ANBO), Groenstraat (HOWI)",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "beginVanDeLevenscyclusVanDezeVersie": {
            "type": "object",
            "description": "Geeft aan wanneer het record is aangemaakt in de database van de authentieke bron  Deze lifespan informatie heeft twee doelstellingen: 1. informatie verstrekken over de inhoud van de databank op een bepaald tijdstip. 2. Informatie verstrekken over de vera",
            "properties": {
              "@value": {
                "type": "string",
                "format": "date-time"
              },
              "@type": {
                "type": "string",
                "pattern": "^DateTime$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "eindeVanDeLevenscyclusVanDezeVersie": {
            "type": "object",
            "description": "Geeft aan wanneer het record werd gearchiveerd in de databank van de authentieke bron  Deze lifespan informatie heeft twee doelstellingen: 1. informatie verstrekken over de inhoud van de databank op een bepaald tijdstip. 2. Informatie verstrekken over de",
            "properties": {
              "@value": {
                "type": "string",
                "format": "date-time"
              },
              "@type": {
                "type": "string",
                "pattern": "^DateTime$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "code": {
            "$ref": "#/components/schemas/Identifier"
          },
          "name": {
            "type": "array",
            "description": "Lijst van GeographicalName items.",
            "items": {
              "$ref": "#/components/schemas/GeographicalName"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "type": {
            "$ref": "#/components/schemas/StraatnaamType"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "isAssignedByMunicipality": {
            "$ref": "#/components/schemas/Gemeente"
          }
        },
        "required": [
          "@type",
          "homoniemtoevoeging",
          "beginVanDeLevenscyclusVanDezeVersie",
          "eindeVanDeLevenscyclusVanDezeVersie",
          "code",
          "name",
          "type",
          "status",
          "isAssignedByMunicipality"
        ]
      },
      "PostInformatie": {
        "title": "PostInformatie",
        "type": "object",
        "description": "Identificatie van een subset van adressen gecreëerd voor postbedeling. \r\nIn de meeste gevallen valt de postal code samen met de gemeente of stad, maar dit is niet altijd het geval.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse PostInformatie)",
            "pattern": "^PostInformatie$"
          },
          "code": {
            "$ref": "#/components/schemas/Identifier"
          },
          "naam": {
            "type": "array",
            "description": "Lijst van GeographicalName items.",
            "items": {
              "$ref": "#/components/schemas/GeographicalName"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "@type",
          "code",
          "status"
        ]
      },
      "Pos": {
        "title": "Pos",
        "type": "object",
        "description": "De positie uitgedrukt in Lambert72 en de Lambert08-notatie.\r\nIn Lambert-notatie is een locatie gedefinieerd met een X- en Y-coördinaat (dubbels) die de afstand aangeven van een gekozen referentiepunt",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Pos)",
            "pattern": "^Pos$"
          },
          "x": {
            "type": "object",
            "description": "undefined",
            "properties": {
              "@value": {
                "type": "number",
                "format": "double"
              },
              "@type": {
                "type": "string",
                "pattern": "^Double$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "y": {
            "type": "object",
            "description": "undefined",
            "properties": {
              "@value": {
                "type": "number",
                "format": "double"
              },
              "@type": {
                "type": "string",
                "pattern": "^Double$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          }
        },
        "required": [
          "@type",
          "x",
          "y"
        ]
      },
      "Identifier": {
        "title": "Identifier",
        "type": "object",
        "description": "De sleutel van een BeSt-object;  bestaat uit 3 subelementen: namespace, de objectIdentifier en de versionIdentifier.\r\nDe \"Identifier\" identificeert op unieke wijze een straatnaam, een gemeente, een adres, enz.\r\nDe BeSt-identifier is niet persistent in de",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Identifier)",
            "pattern": "^Identifier$"
          },
          "namespace": {
            "type": "object",
            "description": "De naamruimte die de regio's gebruiken om de regio en het elementtype te identificeren",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "identificatorVanEenObject": {
            "type": "object",
            "description": "Een integer die het middelste deel van de BeSt identifier voorstelt een nummer dat het object binnen de naamruimte eenduidig identificeert.",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "identificatorVanEenVersie": {
            "type": "object",
            "description": "Versie van de BeSt identifier; laatste deel van de BeSt identifier Een versionIdentifier kan een datum/tijdstempel zijn (zoals in Vlaanderen) of een nummer (zoals in Wallonië en Brussel).",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          }
        },
        "required": [
          "@type",
          "namespace",
          "identificatorVanEenObject",
          "identificatorVanEenVersie"
        ]
      },
      "Coordinates": {
        "title": "Coordinates",
        "type": "object",
