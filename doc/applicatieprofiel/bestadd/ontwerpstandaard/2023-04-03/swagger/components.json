            ]
          },
          "long": {
            "type": "object",
            "description": "undefined",
            "properties": {
              "@value": {
                "type": "number",
                "format": "double"
              },
              "@type": {
                "type": "string",
                "pattern": "^Double$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          }
        },
        "required": [
          "@type",
          "lat",
          "long"
        ]
      },
      "GeographicalName": {
        "title": "GeographicalName",
        "type": "object",
        "description": "Namen zoals gemeentenamen zijn meertalig in België. Er wordt een speciale klasse gebruikt om deze meertalige situatie uit te drukken.\r\nDe GeographicalName bestaat uit de volgende subelementen: spelling en talen.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse GeographicalName)",
            "pattern": "^GeographicalName$"
          },
          "naam": {
            "$ref": "#/components/schemas/Taalcodewaarde"
          },
          "geografischeNaam": {
            "$ref": "#/components/schemas/Taalcodewaarde"
          }
        },
        "required": [
          "@type",
          "naam",
          "geografischeNaam"
        ]
      },
      "Point": {
        "title": "Point",
        "type": "object",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Point)",
