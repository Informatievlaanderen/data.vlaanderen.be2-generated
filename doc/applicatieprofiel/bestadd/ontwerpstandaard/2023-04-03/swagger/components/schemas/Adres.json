      "description": "Object type (klasse Adres)",
      "pattern": "^Adres$"
    },
    "busnummer": {
      "$ref": "#/components/schemas/Adres.busnummer"
    },
    "huisnummer": {
      "$ref": "#/components/schemas/Adres.huisnummer"
    },
    "officieelToegekend": {
      "$ref": "#/components/schemas/Adres.officieelToegekend"
    },
    "adresSorteerveld": {
      "$ref": "#/components/schemas/Adres.adresSorteerveld"
    },
    "beginVanDeLevenscyclusVanDezeVersie": {
      "$ref": "#/components/schemas/Adres.beginVanDeLevenscyclusVanDezeVersie"
    },
    "eindeVanDeLevenscyclusVanDezeVersie": {
      "$ref": "#/components/schemas/Adres.eindeVanDeLevenscyclusVanDezeVersie"
    },
    "code": {
      "$ref": "#/components/schemas/Identifier"
    },
    "positie": {
      "$ref": "#/components/schemas/GeografischePositie"
    },
    "status": {
      "$ref": "#/components/schemas/Status"
    },
    "isOnderdeelVanDeelgemeente": {
      "$ref": "#/components/schemas/Deelgemeente"
    },
    "heeftGemeente": {
      "$ref": "#/components/schemas/Gemeente"
