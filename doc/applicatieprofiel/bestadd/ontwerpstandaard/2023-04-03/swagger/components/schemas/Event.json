{
  "title": "Event",
  "type": "object",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Event)",
      "pattern": "^Event$"
    },
    "gebeurtenisDatum": {
      "type": "object",
      "description": "Datum van de mutatie die deze voorganger-opvolgerrelatie creëerde.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    }
  },
  "required": [
    "@type",
    "gebeurtenisDatum"
  ]
}