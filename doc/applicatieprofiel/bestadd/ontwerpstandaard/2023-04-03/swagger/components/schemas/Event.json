{
  "title": "Event",
  "type": "object",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Event)",
      "pattern": "^Event$"
    },
    "gebeurtenisDatum": {
      "type": "object",
      "description": "Datum van de mutatie die deze voorganger-opvolgerrelatie creëerde.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "voorganger": {
      "type": "array",
      "description": "Lijst van Identifier items.",
      "items": {
        "$ref": "#/components/schemas/Identifier"
      },
      "minItems": 1
    },
    "opvolger": {
      "type": "array",
      "description": "Lijst van Identifier items.",
      "items": {
        "$ref": "#/components/schemas/Identifier"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "gebeurtenisDatum",
    "voorganger",
    "opvolger"
  ]
}