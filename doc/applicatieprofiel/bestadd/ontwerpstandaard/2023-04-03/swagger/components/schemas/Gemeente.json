{
  "title": "Gemeente",
  "type": "object",
  "description": "Officiële administratieve zone van het Belgisch grondgebied. De gemeente is het kleinste administratieve deel van het Belgisch grondgebied waarvan de grenzen enkel door de wetgever kunnen worden gewijzigd.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Gemeente)",
      "pattern": "^Gemeente$"
    },
    "code": {
      "$ref": "#/components/schemas/Identifier"
    },
    "naam": {
      "type": "array",
      "description": "Gemeentenaam. Lijst van GeografischeNaam items.",
      "items": {
        "$ref": "#/components/schemas/GeografischeNaam"
      },
      "minItems": 1,
      "maxItems": 3
    },
    "status": {
      "$ref": "#/components/schemas/Status"
    }
  },
  "required": [
    "@type",
    "code",
    "naam",
    "status"
  ]
}