{
  "title": "Identifier",
  "type": "object",
  "description": "De sleutel van een BeSt-object;  bestaat uit 3 subelementen: namespace, de objectIdentifier en de versionIdentifier.\nDe \"Identifier\" identificeert op unieke wijze een straatnaam, een gemeente, een adres, enzovoort.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Identifier)",
      "pattern": "^Identifier$"
    },
    "namespace": {
      "$ref": "#/components/schemas/Identifier.namespace"
    },
    "identificatorVanEenObject": {
      "$ref": "#/components/schemas/Identifier.identificatorVanEenObject"
    },
    "identificatorVanEenVersie": {
      "$ref": "#/components/schemas/Identifier.identificatorVanEenVersie"
    }
  },
  "required": [
    "@type",
    "namespace",
    "identificatorVanEenObject",
    "identificatorVanEenVersie"
  ]
}