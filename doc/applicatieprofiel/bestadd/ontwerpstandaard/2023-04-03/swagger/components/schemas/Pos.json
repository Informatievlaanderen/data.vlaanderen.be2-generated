          "type": "number",
          "format": "double"
        },
        "@type": {
          "type": "string",
          "pattern": "^Double$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "y": {
      "type": "object",
      "description": "undefined",
      "properties": {
        "@value": {
          "type": "number",
          "format": "double"
        },
        "@type": {
          "type": "string",
          "pattern": "^Double$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    }
  },
  "required": [
    "@type",
    "x",
    "y"
  ]
