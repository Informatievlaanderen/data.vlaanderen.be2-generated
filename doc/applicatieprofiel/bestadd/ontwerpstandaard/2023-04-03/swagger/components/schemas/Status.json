{
  "title": "Status",
  "type": "object",
  "description": "De status bevat de status waarde en de geldigheidsperiode (datum van en datum tot)",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Status)",
      "pattern": "^Status$"
    },
    "geldigVanaf": {
      "type": "object",
      "description": "de startdatum vanaf wanneer de entiteit geldig is.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "geldigTot": {
      "type": "object",
      "description": "de einddatum tot wanneer de entiteit geldig is",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "status": {
      "$ref": "#/components/schemas/Statuswaarde"
    }
  },
  "required": [
    "@type",
    "geldigVanaf",
    "status"
  ]
}