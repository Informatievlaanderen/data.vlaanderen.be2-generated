{
  "title": "Straatnaam",
  "type": "object",
  "description": "Een adrescomponent die de naam is van een passage of een weg van de ene locatie naar een andere.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Straatnaam)",
      "pattern": "^Straatnaam$"
    },
    "homoniemtoevoeging": {
      "type": "object",
      "description": "Toevoeging aan de straatnaam om een onderscheid te maken tussen 2 straten die dezelfde naam hebben binnen dezelfde gemeente.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "beginVanDeLevenscyclusVanDezeVersie": {
      "type": "object",
      "description": "Geeft aan wanneer het record is aangemaakt in de database van de authentieke bron.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "eindeVanDeLevenscyclusVanDezeVersie": {
      "type": "object",
      "description": "Geeft aan wanneer het record werd gearchiveerd in de databank van de authentieke bron.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "code": {
      "$ref": "#/components/schemas/Identifier"
    },
    "name": {
      "type": "array",
      "description": "Lijst van GeographicalName items.",
      "items": {
        "$ref": "#/components/schemas/GeographicalName"
      },
      "minItems": 1,
      "maxItems": 3
    },
    "type": {
      "$ref": "#/components/schemas/StraatnaamType"
    }
  },
  "required": [
    "@type",
    "homoniemtoevoeging",
    "beginVanDeLevenscyclusVanDezeVersie",
    "eindeVanDeLevenscyclusVanDezeVersie",
    "code",
    "name",
    "type"
  ]
}