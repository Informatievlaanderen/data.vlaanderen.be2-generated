<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bestuurlijk-sanctieregister/ontwerpstandaard/toolchain4#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke Organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "achternaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bestuurlijk-sanctieregister/ontwerpstandaard/toolchain4#Persoon.Achternaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "achternaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv pseudoniem, titel etc."@nl;
    rdfs:comment "Alternatief voor de volledige naam vd persoon."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bestuurlijk-sanctieregister/ontwerpstandaard/toolchain4#Persoon.AlternatieveNaam>;
    shacl:datatype xsd:string;
    shacl:description "Alternatief voor de volledige naam vd persoon."@nl;
    shacl:name "alternatieve naam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#alternatieveNaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geboortenaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "De namen van een persoon kunnen id loop vd tijd wijzigen, bv kan de achternaam wijzigen door huwelijk. De oorspronkelijke naam wordt echter dikwijls ook nog gebruikt."@nl;
    rdfs:comment "Volledige naam vd persoon bij geboorte."@nl;
