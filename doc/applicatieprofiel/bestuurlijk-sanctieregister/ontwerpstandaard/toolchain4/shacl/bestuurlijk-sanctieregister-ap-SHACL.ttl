  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bestuurlijk-sanctieregister/ontwerpstandaard/toolchain4#InwonerschapShape> a shacl:NodeShape;
  rdfs:label "Inwonerschap"@nl;
  rdfs:comment "Het feit dat een persoon verblijf houdt in een plaats of land."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Inwonerschap.GeregistreerdPersoon";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bestuurlijk-sanctieregister/ontwerpstandaard/toolchain4#Inwonerschap.Inwonerschap.geregistreerdpersoon>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Inwonerschap.GeregistreerdPersoon";
    shacl:path <https://data.vlaanderen.be/ns/persoon#Inwonerschap.GeregistreerdPersoon>
  ], [
    a shacl:PropertyShape;
