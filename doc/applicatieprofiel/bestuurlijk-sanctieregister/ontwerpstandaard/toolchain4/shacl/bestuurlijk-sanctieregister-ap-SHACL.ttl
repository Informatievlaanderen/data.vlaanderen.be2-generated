  ], [
    a shacl:PropertyShape;
    rdfs:label "periode"@nl;
    <http://purl.org/vocab/vann/usageNote> "Idealiter wordt een periode meegegeven. Indien niet mogelijk, een datum."@nl;
    rdfs:comment "De periode waarbinnen het Gepleegd Feit heeft plaatsgevonden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bestuurlijk-sanctieregister/ontwerpstandaard/toolchain4#Feit.Periode>;
