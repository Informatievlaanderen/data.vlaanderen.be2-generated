    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bestuurlijk-sanctieregister/ontwerpstandaard/toolchain4#Identificator.ToegekendDoor>;
    shacl:class dc:Agent;
