    shacl:name "contactinfo"@nl;
    shacl:path schema:contactPoint
  ];
  shacl:targetClass org:Organization .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bestuurlijk-sanctieregister/ontwerpstandaard/toolchain4#PeriodeShape> a shacl:NodeShape;
