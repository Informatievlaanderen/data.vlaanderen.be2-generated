    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Opmeting.Uitgevoerddoor>;
    shacl:class dc:Agent;
    shacl:description "Agent die de Opmeting heeft uitgevoerd."@nl;
    shacl:maxCount "1";
    shacl:name "uitgevoerdDoor"@nl;
