<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#OpmetingmethodeShape> a shacl:NodeShape;
  rdfs:label "Opmetingmethode"@nl;
  rdfs:comment "De methode waarmee opmetingen worden gedaan."@nl;
  shacl:closed false;
