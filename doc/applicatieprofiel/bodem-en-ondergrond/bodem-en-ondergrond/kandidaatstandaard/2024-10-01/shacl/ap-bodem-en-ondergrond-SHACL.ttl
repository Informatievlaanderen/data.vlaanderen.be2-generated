    shacl:path <https://data.vlaanderen.be/ns/bodem-en-ondergrond#aanvangspeil>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/bodem-en-ondergrond#BO_RuimtelijkBemonsteringsobject> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#BoringShape> a shacl:NodeShape;
  rdfs:label "Boring"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het vocabularium Bodem & Ondergrond gebruiken we deze klasse louter als generalisatie van Grondboringen en Bodemboringen."@nl;
  rdfs:comment "Het aanbrengen van een gat in iets dmv een boor."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Boring> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#CurveShape> a shacl:NodeShape;
  rdfs:label "Curve"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dimensie is te verstaan in wiskundige zin: het minimum aantal coördinaten nodig om een willekeurig punt voor te stellen dat deel uitmaakt van de primitieve. In het coördinaatsysteem dat door een Curve zelf gevormd wordt volstaat 1 coördinaat om een punt op de Curve te lokaliseren, bv de afstand langs de Curve vanaf het vertrekpunt. Een Curve heeft dus een lengte maar geen breedte of hoogte, wat niet wegneemt dat ze door de 3D ruimte kan kronkelen. Curves worden doorgaans voorgesteld door polylijnen, dit zijn sets van opeenvolgende punten waarbij de tussenliggende punten van de Curve bekomen worden dmv interpolatie. Als de interpolatiemethode lineair is krijg je een Lijnstring (een hoekige lijn die de opeenvolgende punten verbindt middels een rechte lijn), andere manieren om te interpoleren resulteren in circulaire bogen, cubic splines, Bézier curves etc (waarbij de controlepunten niet noodzakelijk op de Curve liggen). Een Curve wordt begrensd door zijn begin- en eindpunt."@nl;
  rdfs:comment "Een 1-dimensionele geometrische primitieve."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#Curve> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#CurvewaardepaarShape> a shacl:NodeShape;
  rdfs:label "CurveWaardepaar"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een CurveWaardepaar beschrijft de geometrie van een stuk van de ruimte voorgesteld door een Curve en de waarde van een continu variërend fenomeen die men voor die Curve heeft vastgesteld. Bv de straatnaam langs een stuk van een wegsegment of de stratigrafie van een diepteinterval bij een boring.OPMERKING: Meer info over deze klasse in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/ruimtelijke-bereiken\">AP Ruimtelijke Bereiken</a>."@nl;
  rdfs:comment "Element van een DiscreetCurveBereik."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19123/2005/CoverageCore#CV_CurveValuePair> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#DirectepositieShape> a shacl:NodeShape;
  rdfs:label "DirectePositie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typisch gebruikt om de geometrie van een ruimtelijk object te beschrijven of de geometrische primitieven (bv punt, Lijn, Vlak...) waaruit dat object is samengesteld. Een DirectePositie kan echter ook op zichzelf staan om een positie in de ruimte te beschrijven. De positie wordt gegeven in een coördinaatreferentiesysteem. Dat referentiesysteem wordt expliciet bij de DirectePositie opgegeven, tenzij deze deel uitmaakt van een ruimtelijk object (bv een geometrische primitieve) waar al een referentiesysteem wordt vermeld. Ter info: Een coördinaatreferentiesysteem verschilt van een indirect ruimtelijk referentiesysteem in die zin dat posities direct dmv coördinaten worden opgegeven ipv indirect door een adres of plaatsnaam."@nl;
  rdfs:comment "Houder van de coördinaten van een positie in een coördinaatreferentiesysteem."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "wkt"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik <a href=\"http://www.opengis.net/ont/geosparql#wktLiteral\">wktliteral</a> als datatype."@nl;
    rdfs:comment "Directe positie uitgedrukt in wkt-formaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Directepositie.Wkt>;
    shacl:datatype rdfs:Literal;
    shacl:description "Directe positie uitgedrukt in wkt-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "wkt"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#asWKT>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gml"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik <a href=\"http://www.opengis.net/ont/geosparql#gmlLiteral\">gmlliteral</a> als datatype."@nl;
    rdfs:comment "Directe positie uitgedrukt in gml-formaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Directepositie.Gml>;
    shacl:datatype rdfs:Literal;
    shacl:description "Directe positie uitgedrukt in gml-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "gml"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#asGML>
  ], [
    a shacl:PropertyShape;
    rdfs:label "opmeting"@nl;
    rdfs:comment "De manier waarop de positie werd bepaald."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Directepositie.Opmeting>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#Opmeting>;
    shacl:description "De manier waarop de positie werd bepaald."@nl;
    shacl:maxCount "1";
    shacl:name "opmeting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#DirectePositie.opmeting>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek#DirectePositie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#ErkenningShape> a shacl:NodeShape;
  rdfs:label "Erkenning"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv de toelating aan een boormaatschappij om Boringen uit te voeren."@nl;
