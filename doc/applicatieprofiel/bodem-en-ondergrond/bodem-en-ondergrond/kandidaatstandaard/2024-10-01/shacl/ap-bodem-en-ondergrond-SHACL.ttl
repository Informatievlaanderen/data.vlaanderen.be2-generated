  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "fractiemetingwaarde"@nl;
    rdfs:comment "Waarde ve individuele Meting in de Meetreeks.."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Fractiemetingresultaat.Fractiemetingwaarde>;
