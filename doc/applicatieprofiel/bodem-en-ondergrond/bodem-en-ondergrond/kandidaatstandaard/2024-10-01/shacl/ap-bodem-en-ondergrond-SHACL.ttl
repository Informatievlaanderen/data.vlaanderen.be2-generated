  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door (String)"@nl;
    rdfs:comment "Naam vd agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Identificator.ToegekendDoor(string)>;
    shacl:datatype xsd:string;
    shacl:description "Naam vd agent die de identificator heeft toegekend."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend door (String)"@nl;
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend op"@nl;
    rdfs:comment "Tijdstip waarop de identificator werd uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Identificator.ToegekendOp>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend op"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door"@nl;
    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Identificator.ToegekendDoor>;
    shacl:class dc:Agent;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend door"@nl;
    shacl:path dc:creator
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#InterpretatieShape> a shacl:NodeShape;
  rdfs:label "Interpretatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de context van Observaties en Metingen is een Interpretatie het resultaat van het toepassen van bestaande kennis op bestaande Observaties. Het onderscheid tussen een Interpretatie en een \"gewone\" Observatie is niet absoluut, in beide gevallen gaat het over het schatten van de waarde van een kenmerk. In het geval van een Interpretatie heeft de Observatie echter meer betekenis (meer \"semantische lading\") omdat er meer theorie en/of verwerking aan te pas komt."@nl;
  rdfs:comment "Persoonlijk beredeneerd oordeel over de betekenis van iets."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Interpretatie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#IntervalShape> a shacl:NodeShape;
  rdfs:label "Interval"@nl;
  <http://purl.org/vocab/vann/usageNote> "Tussen die uiteinden gebeuren dan de Observaties, bv een diepte-interval waarin de bodemsamenstelling wordt bestudeerd."@nl;
  rdfs:comment "Curve, louter bepaald door zijn twee uiteinden."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/DomainSpecificSamplingFeatures#Interval> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#KenmerktypeShape> a shacl:NodeShape;
  rdfs:label "Kenmerktype"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de context van Observaties en Metingen is dit een kenmerk van het geobseveerdObject (of van het bemonsterdObject of een onderdeel daarvan) en in principe van alle instanties van dat type geobserveerdObject. Bv Lichaamstemperatuur, Lithologie, ChemischeSamenstelling (resp van een Persoon, een GeologischeEenheid en - meer indirect - van een Monster genomen op een bepaalde plek in een Rivier). Substitueren door een <a href=\"https://www.w3.org/TR/skos-reference/#Concept\">skos:Concept</a> OF een instantie van een equivalente klasse bvb <a href=\"https://qudt.org/schema/qudt/QuantityKind\">qudt:QuantityKind</a> OF eigen subklasse."@nl;
  rdfs:comment "Klasse die kenmerken van instanties van om het even welk type vertegenwoordigt."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19109/2005/GeneralFeatureModel#GF_PropertyType> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#LaagShape> a shacl:NodeShape;
  rdfs:label "Laag"@nl;
  <http://purl.org/vocab/vann/usageNote> "Tussen die uiteinden gebeuren dan de Observaties, bv het Interval gevormd door de doorsnede van een geologische laag. OPMERKING: We noemen dit laaginterval hier gemakshalve Laag, de werkelijke laag is eerder het type laag en/of driedimensioneel object dat de ganse laag omvat."@nl;
  rdfs:comment "Curve, bepaald door de uiteinden van de doorsnede van een Laagobject."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb een skos:Concept met het laagtype of een Record zoals GecodeerdeLithologieWaarde."@nl;
    rdfs:comment "Verwijzing naar een record dat de laal beschrijft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Laag.Waarde>;
    shacl:class rdfs:Resource;
    shacl:description "Verwijzing naar een record dat de laal beschrijft."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Laag.waarde>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Laag> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#LiteralShape> a shacl:NodeShape;
  rdfs:label "Literal";
  shacl:closed false;
  shacl:targetClass rdfs:Literal .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#LocatieShape> a shacl:NodeShape;
  rdfs:label "Locatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet dit datatype gesubstitueerd worden door klassen of datatypes zoals Geometrie, GeografischeNaam, Adres etc. OPMERKING: Meer info over deze klassen/datatypes in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/\">OSLO Generiek - basis</a>."@nl;
  rdfs:comment "Aanduiding van een geografische positie, dmv coördinaten, een toponiem, een adreslabel, een verwijzing naar een plaats/regio of verwijzing naar een adres."@nl;
  shacl:closed false;
  shacl:targetClass prov:Location .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#MaaiveldShape> a shacl:NodeShape;
  rdfs:label "Maaiveld"@nl;
  rdfs:comment "Het grondoppervlak, waarvan de hoogte vaak opgegeven wordt ten opzichte van een nationaal nul-niveau."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "hoogte"@nl;
    rdfs:comment "Verticale maat naar boven vanaf het grondoppervlak van het maaiveld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Maaiveld.Hoogte>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#DirectePositie>;
    shacl:description "Verticale maat naar boven vanaf het grondoppervlak van het maaiveld."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hoogte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Maaiveld.hoogte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Het type Maaiveld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Maaiveld.Type>;
    shacl:class skos:Concept;
    shacl:description "Het type Maaiveld."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Maaiveld> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#MaaiveldtypeShape> a shacl:NodeShape;
  rdfs:label "Maaiveldtype"@nl;
  shacl:closed false;
