    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Fractiemeting.Fractiemetingresultaat>;
    shacl:class <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Fractiemetingresultaat>;
    shacl:description "Het resultaat van de Fractiemeting."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "fractiemetingresultaat"@nl;
    shacl:path <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.result>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Fractiemeting> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#FractiemetingresultaatShape> a shacl:NodeShape;
  rdfs:label "Fractiemetingresultaat"@nl;
