<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#FractiemetingwaardeShape> a shacl:NodeShape;
  rdfs:label "Fractiemetingwaarde"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een fractie (in de betekenis van \"aandeel\") houdt in dat een range wordt opgegeven voor de waarde vh meetpunt, vandaar de attributen meetpuntOndergrens en meetpuntBovengrens. De ondergrens kan daarbij ook gefixeerd worden, bvb bij een cummulatieve Korrelverdeling waar fractie=f(maximum korreldiameter) en bij oplopende range van korrelgrootte (=diameter van de zeefopeningen) een oplopende fractie krijgt, bvb korreldiameter 0-0.42mm=0%, 0-0.149mm=25% en 0-0.076mm=100%."@nl;
  rdfs:comment "Een Meetreekswaarde met een waarde voor de fractie en een waarde voor de parameter."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "meetpuntOndergrens"@nl;
    rdfs:comment "Ondergrens van een klasse van waarden van meetpunten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Fractiemetingwaarde.Meetpuntondergrens>;
    shacl:class <http://def.isotc211.org/iso19103/2005/UnitsOfMeasure#Measure>;
    shacl:description "Ondergrens van een klasse van waarden van meetpunten."@nl;
    shacl:maxCount "1";
    shacl:name "meetpuntOndergrens"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Meetreekswaarde.meetpuntOndergrens>
  ], [
    a shacl:PropertyShape;
    rdfs:label "meetpuntBovengrens"@nl;
    rdfs:comment "Bovengrens van een klasse van waarden van meetpunten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Fractiemetingwaarde.Meetpuntbovengrens>;
    shacl:class <http://def.isotc211.org/iso19103/2005/UnitsOfMeasure#Measure>;
    shacl:description "Bovengrens van een klasse van waarden van meetpunten."@nl;
    shacl:maxCount "1";
    shacl:name "meetpuntBovengrens"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Meetreekswaarde.meetpuntBovengrens>
  ], [
    a shacl:PropertyShape;
    rdfs:label "meetwaarde"@nl;
    <http://purl.org/vocab/vann/usageNote> "De meetwaarde mag ontbreken om een onderbreking in de meetreeks aan te geven."@nl;
    rdfs:comment "Waarde van de fractie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Fractiemetingwaarde.Meetwaarde>;
    shacl:class <http://def.isotc211.org/iso19103/2005/UnitsOfMeasure#Measure>;
    shacl:description "Waarde van de fractie."@nl;
    shacl:maxCount "1";
    shacl:name "meetwaarde"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Meetreekswaarde.meetwaarde>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Fractiemetingwaarde> .

