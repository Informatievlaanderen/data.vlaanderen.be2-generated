<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#FractiemetingShape> a shacl:NodeShape;
  rdfs:label "Fractiemeting"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dat aandeel wordt \"fractie\" genoemd. Vb is de statistische verdeling van onderwijsniveaus over de bevolking of de verdeling van korreldiameters in een bodemstaal."@nl;
  rdfs:comment "Meetreeks waarbij het aandeel van iets varieert in functie van iets anders."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "meetwaardeparameter"@nl;
    <http://purl.org/vocab/vann/usageNote> "Waarvan de waarde standaard \"fractie\" is."@nl;
    rdfs:comment "Het geobserveerde kenmerk."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Fractiemeting.Meetwaardeparameter>;
    shacl:class <http://def.isotc211.org/iso19109/2005/GeneralFeatureModel#GF_PropertyType>;
    shacl:description "Het geobserveerde kenmerk."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "meetwaardeparameter"@nl;
    shacl:path <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.observedProperty>
  ], [
    a shacl:PropertyShape;
    rdfs:label "fractiemetingresultaat"@nl;
