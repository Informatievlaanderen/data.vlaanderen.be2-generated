    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path <http://def.isotc211.org/iso19123/2005/CoverageCore#CV_GeometryValuePair.value>
  ], [
    a shacl:PropertyShape;
    rdfs:label "laag"@nl;
    rdfs:comment "Overeenstemmend Profielelement."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Bo_curvewaardepaar.Laag>;
    shacl:class <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Profielelement>;
    shacl:description "Overeenstemmend Profielelement."@nl;
    shacl:maxCount "1";
    shacl:name "laag"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bodem-en-ondergrond#BO_Curvewaardepaar.laag>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "Geometrie van het element."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Bo_curvewaardepaar.Geometrie>;
    shacl:class <http://www.opengis.net/ont/sf#Curve>;
    shacl:description "Geometrie van het element."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://def.isotc211.org/iso19123/2005/CoverageCore#CV_CurveValuePair.geometry>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/bodem-en-ondergrond#BO_CurveWaardepaar> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Bo_ruimtelijkbemonsteringsobjectShape> a shacl:NodeShape;
  rdfs:label "BO_RuimtelijkBemonsteringsobject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het gaat over kenmerken die typisch zijn in de context van Bemonstering bv bij Boringen het maaiveld en de diepte."@nl;
  rdfs:comment "RuimtelijkBemonsteringsobject met bijkomende kenmerken relevant voor het domein Bodem en Ondergrond."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "ligging"@nl;
    <http://purl.org/vocab/vann/usageNote> "Naast de geometrie zijn bijkomende aanduidingen vd locatie soms nuttig, bv in het geval ve Boorgat in welke gemeente is geboord."@nl;
    rdfs:comment "De ligging vh Bemonsteringsobject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Bo_ruimtelijkbemonsteringsobject.Ligging>;
    shacl:class prov:Location;
    shacl:description "De ligging vh Bemonsteringsobject."@nl;
    shacl:name "ligging"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bodem-en-ondergrond#BO_RuimtelijkBemonsteringsobject.ligging>
  ], [
    a shacl:PropertyShape;
    rdfs:label "maaiveld"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb nuttig in het geval wanneer men de geometrie van een Boorgat  enkel met xy-coördinaten en diepte weergeeft en afzonderlijk de z-coördinaat van het Maaiveld."@nl;
    rdfs:comment "Ligging van het grondoppervlak."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Bo_ruimtelijkbemonsteringsobject.Maaiveld>;
    shacl:class <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Maaiveld>;
    shacl:description "Ligging van het grondoppervlak."@nl;
    shacl:name "maaiveld"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bodem-en-ondergrond#BO_RuimtelijkBemonsteringsobject.maaiveld>
  ], [
    a shacl:PropertyShape;
    rdfs:label "diepte"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb nuttig in het geval wanneer men enkel de xy-coördinaten van een Boorgat heeft en wil aangeven hoe diep er geboord is."@nl;
    rdfs:comment "Geeft aan tot welke Diepte het Bemonsteringsobject reikt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/bodem-en-ondergrond/kandidaatstandaard/2024-10-01#Bo_ruimtelijkbemonsteringsobject.Diepte>;
    shacl:class <http://def.isotc211.org/iso19103/2005/UnitsOfMeasure#Measure>;
    shacl:description "Geeft aan tot welke Diepte het Bemonsteringsobject reikt."@nl;
    shacl:maxCount "1";
    shacl:name "diepte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/bodem-en-ondergrond#BO_RuimtelijkBemonsteringsobject.diepte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanvangspeil"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb nuttig in het geval wanneer men enkel de xy-coördinaten van een Boorgat heeft en wil aangeven dat het boren boven of onder het Maaiveld is gestart."@nl;
    rdfs:comment "Geeft aan waar tov het Maaiveld het Bemonsteringsobject start."@nl;
