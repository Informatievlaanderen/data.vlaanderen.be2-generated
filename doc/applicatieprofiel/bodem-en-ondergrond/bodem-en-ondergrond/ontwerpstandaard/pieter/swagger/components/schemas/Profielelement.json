{
  "title": "Profielelement",
  "type": "object",
  "description": "Onderdeel van het Profiel.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Profielelement)",
      "pattern": "^Profielelement$"
    },
    "geometrie": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Geometrie"
        },
        {
          "$ref": "#/components/schemas/Curve"
        },
        {
          "$ref": "#/components/schemas/Vlak"
        },
        {
          "$ref": "#/components/schemas/Punt"
        },
        {
          "$ref": "#/components/schemas/3Dobject"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Geometrie": "#/components/schemas/Geometrie",
          "Curve": "#/components/schemas/Curve",
          "Vlak": "#/components/schemas/Vlak",
          "Punt": "#/components/schemas/Punt",
          "3Dobject": "#/components/schemas/3Dobject"
        }
      }
    },
    "positioneleNauwkeurigheid": {
      "type": "array",
      "description": "Lijst van PositioneleNauwkeurigheid items.",
      "items": {
        "$ref": "#/components/schemas/PositioneleNauwkeurigheid"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "gehostPlatform": {
      "type": "array",
      "description": "Lijst van Proces items.",
      "items": {
        "$ref": "#/components/schemas/Proces"
      },
      "minItems": 1
    },
    "herkomst": {
      "$ref": "#/components/schemas/Herkomst"
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "type": {
      "$ref": "#/components/schemas/Bemonsteringsobjecttype"
    },
    "geassocieerdBemonsteringsobject": {
      "type": "array",
      "description": "Lijst van Bemonsteringsobject items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/RuimtelijkBemonsteringsobject"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "RuimtelijkBemonsteringsobject": "#/components/schemas/RuimtelijkBemonsteringsobject"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "geometrie",
    "identificator"
  ]
}