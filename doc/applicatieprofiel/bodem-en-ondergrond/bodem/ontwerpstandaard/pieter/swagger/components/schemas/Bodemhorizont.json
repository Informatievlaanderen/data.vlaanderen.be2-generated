{
  "title": "Bodemhorizont",
  "type": "object",
  "description": "Laag in de bodem met een zekere verticale omvang, min of meer evenwijdig aan het maaiveld en homogeen voor de meeste morfologische en analytische kenmerken en onstaan door pedogene processen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Bodemhorizont)",
      "pattern": "^Bodemhorizont$"
    },
    "laag": {
      "$ref": "#/components/schemas/Bodemlaag"
    },
    "ondergrens2": {
      "type": "object",
      "description": "De tweede ondergrens van het bodemprofielelement. TODO.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "double"
        },
        "@type": {
          "type": "string",
          "pattern": "^Double$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "bovengrens2": {
      "type": "object",
      "description": "De tweede bovengrens van het bodemprofielelement. TODO.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "double"
        },
        "@type": {
          "type": "string",
          "pattern": "^Double$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "geometrie": {
      "$ref": "#/components/schemas/Curve"
    },
    "positioneleNauwkeurigheid": {
      "type": "array",
      "description": "Lijst van PositioneleNauwkeurigheid items.",
      "items": {
        "$ref": "#/components/schemas/PositioneleNauwkeurigheid"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "gehostPlatform": {
      "type": "array",
      "description": "Lijst van Proces items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Proces"
          },
          {
            "$ref": "#/components/schemas/Observatieprocedure"
          },
          {
            "$ref": "#/components/schemas/Sensor"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Proces": "#/components/schemas/Proces",
            "Observatieprocedure": "#/components/schemas/Observatieprocedure",
            "Sensor": "#/components/schemas/Sensor"
          }
        }
      },
      "minItems": 1
    },
    "grensduidelijkheid": {
      "$ref": "#/components/schemas/DiepteIntervalGrensDuidelijkheid"
    },
    "grensregelmatigheid": {
      "$ref": "#/components/schemas/DiepteIntervalGrensregelmatigheid"
    },
    "herkomst": {
      "$ref": "#/components/schemas/Herkomst"
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "type": {
      "$ref": "#/components/schemas/Bemonsteringsobjecttype"
    },
    "ontwerp": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Observatie"
          },
          {
            "$ref": "#/components/schemas/Bodemclassificatie"
          },
          {
            "$ref": "#/components/schemas/Bodemprofielobservatie"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Observatie": "#/components/schemas/Observatie",
            "Bodemclassificatie": "#/components/schemas/Bodemclassificatie",
            "Bodemprofielobservatie": "#/components/schemas/Bodemprofielobservatie"
          }
        }
      },
      "minItems": 1
    },
    "isResultaatVan": {
      "type": "array",
      "description": "Lijst van Bemonstering items.",
      "items": {
        "$ref": "#/components/schemas/Bemonstering"
      },
      "minItems": 1
    },
    "geassocieerdBemonsteringsobject": {
      "type": "array",
      "description": "Lijst van Bemonsteringsobject items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Bodemmonster"
          },
          {
            "$ref": "#/components/schemas/Bodemlocatie"
          },
          {
            "$ref": "#/components/schemas/Bodemprofielelement"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Bodemmonster": "#/components/schemas/Bodemmonster",
            "Bodemlocatie": "#/components/schemas/Bodemlocatie",
            "Bodemprofielelement": "#/components/schemas/Bodemprofielelement"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "geometrie",
    "grensduidelijkheid",
    "grensregelmatigheid",
    "identificator",
    "isResultaatVan"
  ]
}