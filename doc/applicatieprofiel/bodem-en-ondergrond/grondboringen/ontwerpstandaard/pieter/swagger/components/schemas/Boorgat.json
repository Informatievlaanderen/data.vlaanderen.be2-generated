{
  "title": "Boorgat",
  "type": "object",
  "description": "Curve ontstaan door het boren van een gat in een vast medium.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Boorgat)",
      "pattern": "^Boorgat$"
    },
    "boringLengte": {
      "$ref": "#/components/schemas/Maat"
    },
    "aangenomenGrondwaterstand": {
      "$ref": "#/components/schemas/Maat"
    },
    "geometrie": {
      "$ref": "#/components/schemas/Curve"
    },
    "positioneleNauwkeurigheid": {
      "type": "array",
      "description": "Lijst van PositioneleNauwkeurigheid items.",
      "items": {
        "$ref": "#/components/schemas/PositioneleNauwkeurigheid"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "ligging": {
      "type": "array",
      "description": "Lijst van Locatie items.",
      "items": {
        "$ref": "#/components/schemas/Locatie"
      },
      "minItems": 1
    },
    "gehostPlatform": {
      "type": "array",
      "description": "Lijst van Proces items.",
      "items": {
        "$ref": "#/components/schemas/Proces"
      },
      "minItems": 1
    },
    "maaiveld": {
      "type": "array",
      "description": "Lijst van Maaiveld items.",
      "items": {
        "$ref": "#/components/schemas/Maaiveld"
      },
      "minItems": 1
    },
    "diepte": {
      "$ref": "#/components/schemas/Maat"
    },
    "aanvangspeil": {
      "$ref": "#/components/schemas/Maat"
    },
    "boordiameter": {
      "$ref": "#/components/schemas/Boorgatdiameter"
    },
    "bekisting": {
      "$ref": "#/components/schemas/Bekisting"
    },
    "isResultaatVan": {
      "type": "array",
      "description": "Lijst van Bemonstering items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Bemonstering"
          },
          {
            "$ref": "#/components/schemas/Grondboring"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Bemonstering": "#/components/schemas/Bemonstering",
            "Grondboring": "#/components/schemas/Grondboring"
          }
        }
      },
      "minItems": 1
    },
    "herkomst": {
      "$ref": "#/components/schemas/Herkomst"
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "type": {
      "$ref": "#/components/schemas/Bemonsteringsobjecttype"
    },
    "intentie": {
      "type": "array",
      "description": "Lijst van Object items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Bemonsteringsobject"
          },
          {
            "$ref": "#/components/schemas/Domeinobject"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Bemonsteringsobject": "#/components/schemas/Bemonsteringsobject",
            "Domeinobject": "#/components/schemas/Domeinobject"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "geometrie",
    "isResultaatVan",
    "identificator",
    "intentie"
  ]
}