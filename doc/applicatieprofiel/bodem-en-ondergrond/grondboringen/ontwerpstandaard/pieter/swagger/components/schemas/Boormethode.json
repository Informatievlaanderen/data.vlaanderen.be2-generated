{
  "title": "Boormethode",
  "type": "object",
  "description": "Methode waarmee geboord werd in functie van de diepte.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Boormethode)",
      "pattern": "^Boormethode$"
    },
    "startpunt": {
      "$ref": "#/components/schemas/Boringstartpunttype"
    },
    "inclinatietype": {
      "$ref": "#/components/schemas/Boringinclinatietype"
    },
    "methode": {
      "type": "array",
      "description": "Lijst van BoormethodeInterval items.",
      "items": {
        "$ref": "#/components/schemas/BoormethodeInterval"
      },
      "minItems": 1
    },
    "specificatie": {
      "type": "array",
      "description": "Lijst van URI items.",
      "items": {
        "type": "object",
        "description": "Verwijzing naar een document dat de Bemonsteringsprocedure beschrijft.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "@id"
        ]
      },
      "minItems": 1
    },
    "input": {
      "type": "array",
      "description": "Lijst van Input items.",
      "items": {
        "$ref": "#/components/schemas/Input"
      },
      "minItems": 1
    },
    "output": {
      "type": "array",
      "description": "Lijst van Output items.",
      "items": {
        "$ref": "#/components/schemas/Output"
      },
      "minItems": 1
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Lijst van Bemonsteringsproceduretype items.",
      "items": {
        "$ref": "#/components/schemas/Bemonsteringsproceduretype"
      },
      "minItems": 1
    },
    "geïMplementeerdDoor": {
      "type": "array",
      "description": "Lijst van Bemonsteraar items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Bemonsteraar"
          },
          {
            "$ref": "#/components/schemas/Boor"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Bemonsteraar": "#/components/schemas/Bemonsteraar",
            "Boor": "#/components/schemas/Boor"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "methode"
  ]
}