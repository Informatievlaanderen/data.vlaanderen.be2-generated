{
  "title": "Peilmeting",
  "type": "object",
  "description": "Meten van het grondwater niveau.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Peilmeting)",
      "pattern": "^Peilmeting$"
    },
    "diepteTovReferentiepunt": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "pompstatus": {
      "$ref": "#/components/schemas/Pompstatus"
    },
    "piëZometertoestand": {
      "$ref": "#/components/schemas/PiëZometertoestand"
    },
    "peil": {
      "$ref": "#/components/schemas/DirectePositie"
    },
    "referentiepunt": {
      "$ref": "#/components/schemas/Referentiepunt"
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "fenomeentijd": {
      "$ref": "#/components/schemas/TemporeleEntiteit"
    },
    "resultaattijd": {
      "$ref": "#/components/schemas/Moment"
    },
    "geldigeTijd": {
      "$ref": "#/components/schemas/Periode"
    },
    "resultaatkwaliteit": {
      "type": "array",
      "description": "Lijst van Kwaliteitselement items.",
      "items": {
        "$ref": "#/components/schemas/Kwaliteitselement"
      },
      "minItems": 1
    },
    "resultaat": {
      "$ref": "#/components/schemas/Any"
    },
    "type": {
      "type": "array",
      "description": "Lijst van Observatietype items.",
      "items": {
        "$ref": "#/components/schemas/Observatietype"
      },
      "minItems": 1
    },
    "opdracht": {
      "type": "array",
      "description": "Lijst van Opdracht items.",
      "items": {
        "$ref": "#/components/schemas/Opdracht"
      },
      "minItems": 1
    },
    "uitgevoerdDoor": {
      "type": "array",
      "description": "Lijst van Agent items.",
      "items": {
        "$ref": "#/components/schemas/Agent"
      },
      "minItems": 1
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "geassocieerdeObservatie": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Observatie"
          },
          {
            "$ref": "#/components/schemas/Peilmeting"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Observatie": "#/components/schemas/Observatie",
            "Peilmeting": "#/components/schemas/Peilmeting"
          }
        }
      },
      "minItems": 1
    },
    "geobserveerdObject": {
      "$ref": "#/components/schemas/Grondwaterobject"
    },
    "uitgevoerdMetSensor": {
      "$ref": "#/components/schemas/Sensor"
    },
    "gebruikteProcedure": {
      "type": "array",
      "description": "Lijst van Observatieprocedure items.",
      "items": {
        "$ref": "#/components/schemas/Observatieprocedure"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "fenomeentijd",
    "resultaattijd",
    "resultaat",
    "geobserveerdObject",
    "uitgevoerdMetSensor"
  ]
}