{
  "title": "Peilput",
  "type": "object",
  "description": "De term voor een constructie met een grote diameter, waarin grondwaterstand kan gemeten worden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Peilput)",
      "pattern": "^Peilput$"
    },
    "geometrie": {
      "$ref": "#/components/schemas/Curve"
    },
    "positioneleNauwkeurigheid": {
      "type": "array",
      "description": "Lijst van PositioneleNauwkeurigheid items.",
      "items": {
        "$ref": "#/components/schemas/PositioneleNauwkeurigheid"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "gehostPlatform": {
      "type": "array",
      "description": "Lijst van Proces items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Proces"
          },
          {
            "$ref": "#/components/schemas/Observatieprocedure"
          },
          {
            "$ref": "#/components/schemas/Sensor"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Proces": "#/components/schemas/Proces",
            "Observatieprocedure": "#/components/schemas/Observatieprocedure",
            "Sensor": "#/components/schemas/Sensor"
          }
        }
      },
      "minItems": 1
    },
    "putNaBestemming": {
      "$ref": "#/components/schemas/PutNaBestemming"
    },
    "putsoort": {
      "$ref": "#/components/schemas/PutSoort"
    },
    "inGebruik": {
      "$ref": "#/components/schemas/Periode"
    },
    "beheerder": {
      "$ref": "#/components/schemas/Organisatie"
    },
    "ligging": {
      "type": "array",
      "description": "Lijst van Locatie items.",
      "items": {
        "$ref": "#/components/schemas/Locatie"
      },
      "minItems": 1
    },
    "maaiveld": {
      "type": "array",
      "description": "Lijst van Maaiveld items.",
      "items": {
        "$ref": "#/components/schemas/Maaiveld"
      },
      "minItems": 1
    },
    "diepte": {
      "$ref": "#/components/schemas/Diepte"
    },
    "afwerking": {
      "$ref": "#/components/schemas/Peilputafwerking"
    },
    "herkomst": {
      "$ref": "#/components/schemas/Herkomst"
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "type": {
      "$ref": "#/components/schemas/Bemonsteringsobjecttype"
    },
    "ontwerp": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Observatie"
          },
          {
            "$ref": "#/components/schemas/Peilmeting"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Observatie": "#/components/schemas/Observatie",
            "Peilmeting": "#/components/schemas/Peilmeting"
          }
        }
      },
      "minItems": 1
    },
    "isResultaatVan": {
      "type": "array",
      "description": "Lijst van Bemonstering items.",
      "items": {
        "$ref": "#/components/schemas/Bemonstering"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "geometrie",
    "putsoort",
    "identificator",
    "isResultaatVan"
  ]
}