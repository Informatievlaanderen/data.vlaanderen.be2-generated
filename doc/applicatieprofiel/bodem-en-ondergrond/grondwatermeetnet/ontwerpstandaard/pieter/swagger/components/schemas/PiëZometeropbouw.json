        {
          "$ref": "#/components/schemas/Observatie"
        },
        {
          "$ref": "#/components/schemas/Peilmeting"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Observatie": "#/components/schemas/Observatie",
          "Peilmeting": "#/components/schemas/Peilmeting"
        }
      }
    },
    "bovenkantPeilbuis": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Observatie"
        },
        {
          "$ref": "#/components/schemas/Peilmeting"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Observatie": "#/components/schemas/Observatie",
          "Peilmeting": "#/components/schemas/Peilmeting"
        }
      }
    },
    "opvulling": {
      "type": "array",
      "description": "Lijst van OpvullingInterval items.",
