      "minItems": 1
    },
    "tektoniek": {
      "type": "array",
      "description": "Lijst van Tektoniek items.",
      "items": {
        "$ref": "#/components/schemas/Tektoniek"
      },
      "minItems": 1
    },
    "ader": {
      "type": "array",
      "description": "Lijst van Ader items.",
      "items": {
        "$ref": "#/components/schemas/Ader"
      },
      "minItems": 1
    },
    "secundairKenmerk": {
      "type": "array",
      "description": "Lijst van SecundairKenmerk items.",
      "items": {
        "$ref": "#/components/schemas/SecundairKenmerk"
      },
      "minItems": 1
    },
    "fossiel": {
      "type": "array",
