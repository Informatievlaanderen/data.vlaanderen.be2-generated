{
  "title": "Samendrukbaarheidstrap",
  "type": "object",
  "description": "Gemeten hoogte van het Grondmonster bij een bepaalde druk.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Samendrukbaarheidstrap)",
      "pattern": "^Samendrukbaarheidstrap$"
    },
    "trap": {
      "type": "object",
      "description": "Nummer van de meting.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "int64"
        },
        "@type": {
          "type": "string",
          "pattern": "^Integer$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "zwel": {
      "type": "object",
      "description": "Geeft aan of de druk gemeten werd na vermindering van de druk.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "druk": {
      "$ref": "#/components/schemas/Maat"
    },
    "samendrukking": {
      "$ref": "#/components/schemas/Maat"
    }
  },
  "required": [
    "@type",
    "trap",
    "zwel",
    "druk",
    "samendrukking"
  ]
}