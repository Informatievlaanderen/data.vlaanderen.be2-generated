{
  "title": "Schuifweerstandsmeting",
  "type": "object",
  "description": "Resultaat van een Schuifweerstandsproef.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Schuifweerstandsmeting)",
      "pattern": "^Schuifweerstandsmeting$"
    },
    "sigma1Korrelspanning": {
      "type": "object",
      "description": "De maximale hoofdspanning zonder waterspanning. De maximale hoofdspanning is de normaalspanning waaronder het monster staat bij afschuiving (Sigma2) plus de extra druk die bij de proef op het monster is uitgeoefend op dat moment.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "double"
        },
        "@type": {
          "type": "string",
          "pattern": "^Double$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "sigma1Totaalspanning": {
      "type": "object",
      "description": "De maximale hoofdspanning inclusief waterspanning. De maximale hoofdspanning is de normaalspanning waaronder het monster staat bij afschuiving (Sigma2) plus de extra druk die bij de proef op het monster is uitgeoefend op dat moment.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "double"
        },
        "@type": {
          "type": "string",
          "pattern": "^Double$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "sigma3Korrelspanning": {
      "type": "object",
      "description": "De minimale hoofdspanning zonder waterspanning. De minimale hoofdspanning is de normaalspanning waaronder het monster bij aanvang van de proef wordt gezet.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "double"
        },
        "@type": {
          "type": "string",
          "pattern": "^Double$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "sigma3Totaalspanning": {
      "type": "object",
      "description": "De minimale hoofdspanning inclusief waterspanning. De minimale hoofdspanning is de normaalspanning waaronder het monster bij aanvang van de proef wordt gezet.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "double"
        },
        "@type": {
          "type": "string",
          "pattern": "^Double$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "vervorming": {
      "type": "object",
      "description": "Mate van vervorming.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "double"
        },
        "@type": {
          "type": "string",
          "pattern": "^Double$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "breukcriterium": {
      "$ref": "#/components/schemas/Breukcriterium"
    }
  },
  "required": [
    "@type",
    "vervorming",
    "breukcriterium"
  ]
}