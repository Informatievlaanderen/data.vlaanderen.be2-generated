{
  "title": "VvvMeting",
  "type": "object",
  "description": "Individuele meting van de horizontale Doorlatendheid bij veranderlijk verval.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse VvvMeting)",
      "pattern": "^VvvMeting$"
    },
    "volgnummer": {
      "type": "object",
      "description": "Nummer dat de volgorde van de Meting in de Meetreeks aangeeft.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "int64"
        },
        "@type": {
          "type": "string",
          "pattern": "^Integer$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "doorlatendheidscoëFficient": {
      "$ref": "#/components/schemas/Maat"
    },
    "druk": {
      "$ref": "#/components/schemas/Maat"
    }
  },
  "required": [
    "@type",
    "volgnummer",
    "doorlatendheidscoëFficient",
    "druk"
  ]
}