{
  "title": "Bemonsteraar",
  "type": "object",
  "description": "Toestel dat wordt gebruikt door een Bemonsteringsprocedure of deze implementeert om één of meer Bemonsteringsobjecten te bekomen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Bemonsteraar)",
      "pattern": "^Bemonsteraar$"
    },
    "type": {
      "type": "array",
      "description": "Lijst van Systeemtype items.",
      "items": {
        "$ref": "#/components/schemas/Systeemtype"
      },
      "minItems": 1
    },
    "uitgevoerdeBemonstering": {
      "type": "array",
      "description": "Lijst van Bemonstering items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Bemonstering"
          },
          {
            "$ref": "#/components/schemas/Monstervoorbereiding"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Bemonstering": "#/components/schemas/Bemonstering",
            "Monstervoorbereiding": "#/components/schemas/Monstervoorbereiding"
          }
        }
      },
      "minItems": 1
    },
    "implementeert": {
      "type": "array",
      "description": "Lijst van Bemonsteringsprocedure items.",
      "items": {
        "$ref": "#/components/schemas/Bemonsteringsprocedure"
      },
      "minItems": 1
    },
    "capaciteit": {
      "type": "array",
      "description": "Lijst van Systeemvermogen items.",
      "items": {
        "$ref": "#/components/schemas/Systeemvermogen"
      },
      "minItems": 1
    },
    "werkingsbereik": {
      "type": "array",
      "description": "Lijst van Werkingsbereik items.",
      "items": {
        "$ref": "#/components/schemas/Werkingsbereik"
      },
      "minItems": 1
    },
    "overlevingsbereik": {
      "type": "array",
      "description": "Lijst van Overlevingscapaciteit items.",
      "items": {
        "$ref": "#/components/schemas/Overlevingscapaciteit"
      },
      "minItems": 1
    },
    "gehostDoor": {
      "type": "array",
      "description": "Lijst van Platform items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Platform"
          },
          {
            "$ref": "#/components/schemas/Toestel"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Platform": "#/components/schemas/Platform",
            "Toestel": "#/components/schemas/Toestel"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "implementeert"
  ]
}