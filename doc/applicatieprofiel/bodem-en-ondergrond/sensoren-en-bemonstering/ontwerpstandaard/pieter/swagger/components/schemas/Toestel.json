{
  "title": "Toestel",
  "type": "object",
  "description": "Tastbaar Object ontworpen om een specifieke Taak mee uit te voeren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Toestel)",
      "pattern": "^Toestel$"
    },
    "fabrikant": {
      "type": "object",
      "description": "Naam van de fabrikant.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "model": {
      "type": "object",
      "description": "Naam van het model van het Toestel.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "functie": {
      "type": "array",
      "description": "Lijst van Functie items.",
      "items": {
        "$ref": "#/components/schemas/Functie"
      },
      "minItems": 1
    },
    "taak": {
      "type": "array",
      "description": "Lijst van Taak items.",
      "items": {
        "$ref": "#/components/schemas/Taak"
      },
      "minItems": 1
    },
    "capaciteit": {
      "type": "array",
      "description": "Lijst van Systeemvermogen items.",
      "items": {
        "$ref": "#/components/schemas/Systeemvermogen"
      },
      "minItems": 1
    },
    "werkingsbereik": {
      "type": "array",
      "description": "Lijst van Werkingsbereik items.",
      "items": {
        "$ref": "#/components/schemas/Werkingsbereik"
      },
      "minItems": 1
    },
    "overlevingsbereik": {
      "type": "array",
      "description": "Lijst van Overlevingscapaciteit items.",
      "items": {
        "$ref": "#/components/schemas/Overlevingscapaciteit"
      },
      "minItems": 1
    },
    "type": {
      "$ref": "#/components/schemas/Platformtype"
    },
    "gehostDoor": {
      "type": "array",
      "description": "Lijst van Platform items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Platform"
          },
          {
            "$ref": "#/components/schemas/Toestel"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Platform": "#/components/schemas/Platform",
            "Toestel": "#/components/schemas/Toestel"
          }
        }
      },
      "minItems": 1
    },
    "hostVan": {
      "type": "array",
      "description": "Lijst van Systeem items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Systeem"
          },
          {
            "$ref": "#/components/schemas/Bemonsteraar"
          },
          {
            "$ref": "#/components/schemas/Sensor"
          },
          {
            "$ref": "#/components/schemas/Toestel"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Systeem": "#/components/schemas/Systeem",
            "Bemonsteraar": "#/components/schemas/Bemonsteraar",
            "Sensor": "#/components/schemas/Sensor",
            "Toestel": "#/components/schemas/Toestel"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "functie",
    "taak",
    "type"
  ]
}