{
  "title": "Poriedruk",
  "type": "object",
  "description": "Druk die heerst in grondwater.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Poriedruk)",
      "pattern": "^Poriedruk$"
    },
    "u": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "tijdstip": {
      "type": "object",
      "description": "Het punt in de tijd waar de sondering plaatsvindt.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "inclinatie": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "geometrie": {
      "$ref": "#/components/schemas/Domeinobject"
    },
    "waarde": {
      "$ref": "#/components/schemas/Record"
    }
  },
  "required": [
    "@type",
    "tijdstip",
    "geometrie",
    "waarde"
  ]
}