{
  "title": "PostVerwerking",
  "type": "object",
  "description": "Bijkomende gegevens nodig bij de verwerking van de resultaten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse PostVerwerking)",
      "pattern": "^PostVerwerking$"
    },
    "correctieHelling": {
      "type": "object",
      "description": "Geeft aan of er een correctie van de sondeerlengte obijvoorbeeld de hellingsmeting toegepast is.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "volumemassaBoven": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "volumemassaOnder": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    }
  },
  "required": [
    "@type"
  ]
}