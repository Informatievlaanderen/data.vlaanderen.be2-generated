{
  "title": "Sondeergat",
  "type": "object",
  "description": "Het gat dat gemaakt wordt om de sondering uit te voeren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Sondeergat)",
      "pattern": "^Sondeergat$"
    },
    "geometrie": {
      "$ref": "#/components/schemas/Curve"
    },
    "positioneleNauwkeurigheid": {
      "type": "array",
      "description": "Lijst van PositioneleNauwkeurigheid items.",
      "items": {
        "$ref": "#/components/schemas/PositioneleNauwkeurigheid"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "gehostPlatform": {
      "type": "array",
      "description": "Lijst van Proces items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Proces"
          },
          {
            "$ref": "#/components/schemas/Sensor"
          },
          {
            "$ref": "#/components/schemas/Sondeerprocedure"
          },
          {
            "$ref": "#/components/schemas/Observatieprocedure"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Proces": "#/components/schemas/Proces",
            "Sensor": "#/components/schemas/Sensor",
            "Sondeerprocedure": "#/components/schemas/Sondeerprocedure",
            "Observatieprocedure": "#/components/schemas/Observatieprocedure"
          }
        }
      },
      "minItems": 1
    },
    "ligging": {
      "type": "array",
      "description": "Lijst van Locatie items.",
      "items": {
        "$ref": "#/components/schemas/Locatie"
      },
      "minItems": 1
    },
    "maaiveld": {
      "type": "array",
      "description": "Lijst van Maaiveld items.",
      "items": {
        "$ref": "#/components/schemas/Maaiveld"
      },
      "minItems": 1
    },
    "diepte": {
      "$ref": "#/components/schemas/Diepte"
    },
    "herkomst": {
      "$ref": "#/components/schemas/Herkomst"
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "type": {
      "$ref": "#/components/schemas/Bemonsteringsobjecttype"
    },
    "ontwerp": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Observatie"
          },
          {
            "$ref": "#/components/schemas/Sondeertest"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Observatie": "#/components/schemas/Observatie",
            "Sondeertest": "#/components/schemas/Sondeertest"
          }
        }
      },
      "minItems": 1
    },
    "isResultaatVan": {
      "type": "array",
      "description": "Lijst van Bemonstering items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Bemonstering"
          },
          {
            "$ref": "#/components/schemas/Sondering"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Bemonstering": "#/components/schemas/Bemonstering",
            "Sondering": "#/components/schemas/Sondering"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "geometrie",
    "identificator",
    "isResultaatVan"
  ]
}