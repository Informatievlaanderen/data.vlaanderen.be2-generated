{
  "title": "Sondeerprocedure",
  "type": "object",
  "description": "Procedure gevolgd tijdens de CPT.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Sondeerprocedure)",
      "pattern": "^Sondeerprocedure$"
    },
    "sondetraject": {
      "$ref": "#/components/schemas/Sondetraject"
    },
    "methode": {
      "$ref": "#/components/schemas/Sondeermethode"
    },
    "kwaliteit": {
      "type": "array",
      "description": "Lijst van Sondeerkwaliteit items.",
      "items": {
        "$ref": "#/components/schemas/Sondeerkwaliteit"
      },
      "minItems": 1
    },
    "specificatie": {
      "type": "array",
      "description": "Lijst van URI items.",
      "items": {
        "type": "object",
        "description": "Verwijzing naar een document dat de Bemonsteringsprocedure beschrijft.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "@id"
        ]
      },
      "minItems": 1
    },
    "input": {
      "type": "array",
      "description": "Lijst van Input items.",
      "items": {
        "$ref": "#/components/schemas/Input"
      },
      "minItems": 1
    },
    "output": {
      "type": "array",
      "description": "Lijst van Output items.",
      "items": {
        "$ref": "#/components/schemas/Output"
      },
      "minItems": 1
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Lijst van Bemonsteringsproceduretype items.",
      "items": {
        "$ref": "#/components/schemas/Bemonsteringsproceduretype"
      },
      "minItems": 1
    },
    "geïMplementeerdDoor": {
      "type": "array",
      "description": "Lijst van Bemonsteraar items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Bemonsteraar"
          },
          {
            "$ref": "#/components/schemas/Sondeerapparaat"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Bemonsteraar": "#/components/schemas/Bemonsteraar",
            "Sondeerapparaat": "#/components/schemas/Sondeerapparaat"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "sondetraject",
    "methode"
  ]
}