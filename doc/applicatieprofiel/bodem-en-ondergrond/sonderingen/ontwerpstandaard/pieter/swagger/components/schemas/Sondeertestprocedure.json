{
  "title": "Sondeertestprocedure",
  "type": "object",
  "description": "De reeks van instructies die op volgorde uitgevoerd worden voor de sondeertest.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Sondeertestprocedure)",
      "pattern": "^Sondeertestprocedure$"
    },
    "nulpunt": {
      "type": "array",
      "description": "Lijst van Nulpunt items.",
      "items": {
        "$ref": "#/components/schemas/Nulpunt"
      },
      "minItems": 1
    },
    "postverwerking": {
      "$ref": "#/components/schemas/PostVerwerking"
    },
    "techniek": {
      "type": "array",
      "description": "Lijst van Sondeertechniekbereik items.",
      "items": {
        "$ref": "#/components/schemas/Sondeertechniekbereik"
      },
      "minItems": 1
    },
    "specificatie": {
      "type": "array",
      "description": "Lijst van URI items.",
      "items": {
        "type": "object",
        "description": "Verwijzing naar een document dat de Observatieprocedure beschrijft.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "@id"
        ]
      },
      "minItems": 1
    },
    "input": {
      "type": "array",
      "description": "Lijst van Input items.",
      "items": {
        "$ref": "#/components/schemas/Input"
      },
      "minItems": 1
    },
    "output": {
      "type": "array",
      "description": "Lijst van Output items.",
      "items": {
        "$ref": "#/components/schemas/Output"
      },
      "minItems": 1
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Lijst van Observatieproceduretype items.",
      "items": {
        "$ref": "#/components/schemas/Observatieproceduretype"
      },
      "minItems": 1
    },
    "geïMplementeerdMet": {
      "type": "array",
      "description": "Lijst van Sensor items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Sensor"
          },
          {
            "$ref": "#/components/schemas/Sondeerconus"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Sensor": "#/components/schemas/Sensor",
            "Sondeerconus": "#/components/schemas/Sondeerconus"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}