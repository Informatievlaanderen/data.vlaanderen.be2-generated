{
  "title": "Sondering",
  "type": "object",
  "description": "Het bepalen van het draagvermogen van de grond.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Sondering)",
      "pattern": "^Sondering$"
    },
    "datumAanvang": {
      "type": "object",
      "description": "Datum waarop de Sondering uitgevoerd werd. Startdatum indien meerdere dagen.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "operator": {
      "$ref": "#/components/schemas/Agent"
    },
    "uitvoerder": {
      "$ref": "#/components/schemas/Agent"
    },
    "conditie": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "wettelijkKader": {
      "$ref": "#/components/schemas/WettelijkKader"
    },
    "opdracht": {
      "type": "array",
      "description": "Lijst van Opdracht items.",
      "items": {
        "$ref": "#/components/schemas/Opdracht"
      },
      "minItems": 1
    },
    "bemonsteringstijdstip": {
      "$ref": "#/components/schemas/TemporeleEntiteit"
    },
    "uitgevoerdDoor": {
      "type": "array",
      "description": "Lijst van Agent items.",
      "items": {
        "$ref": "#/components/schemas/Agent"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Lijst van Bemonsteringstype items.",
      "items": {
        "$ref": "#/components/schemas/Bemonsteringstype"
      },
      "minItems": 1
    },
    "doel": {
      "type": "array",
      "description": "Lijst van Bemonsteringsdoel items.",
      "items": {
        "$ref": "#/components/schemas/Bemonsteringsdoel"
      },
      "minItems": 1
    },
    "gebruikteProcedure": {
      "type": "array",
      "description": "Lijst van Bemonsteringsprocedure items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Bemonsteringsprocedure"
          },
          {
            "$ref": "#/components/schemas/Sondeerprocedure"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Bemonsteringsprocedure": "#/components/schemas/Bemonsteringsprocedure",
            "Sondeerprocedure": "#/components/schemas/Sondeerprocedure"
          }
        }
      },
      "minItems": 1
    },
    "uitgevoerdMet": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Bemonsteraar"
        },
        {
          "$ref": "#/components/schemas/Sondeerapparaat"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Bemonsteraar": "#/components/schemas/Bemonsteraar",
          "Sondeerapparaat": "#/components/schemas/Sondeerapparaat"
        }
      }
    },
    "resultaat": {
      "type": "array",
      "description": "Lijst van Bemonsteringsobject items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Sondeergat"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Sondeergat": "#/components/schemas/Sondeergat"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "datumAanvang",
    "uitvoerder",
    "bemonsteringstijdstip",
    "uitgevoerdMet",
    "resultaat"
  ]
}