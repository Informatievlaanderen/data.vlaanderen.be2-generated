{
  "title": "Sondetraject",
  "type": "object",
  "description": "Traject van de sonde.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Sondetraject)",
      "pattern": "^Sondetraject$"
    },
    "aantalBuizen": {
      "type": "object",
      "description": "Sondeerlengte van de eerste sondeerstreng, vóór de eerste sondeerbuis werd op geschroefd.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "double"
        },
        "@type": {
          "type": "string",
          "pattern": "^Double$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "diepteIndring": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "diepteKleefvanger": {
      "$ref": "#/components/schemas/DirectePositie"
    },
    "dieptePut": {
      "$ref": "#/components/schemas/DirectePositie"
    },
    "einddiepte": {
      "$ref": "#/components/schemas/DirectePositie"
    },
    "gemetenSondeerlengte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "meetstap": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "dieptePlaatsenVerlengbuis": {
      "$ref": "#/components/schemas/DirectePositie"
    }
  },
  "required": [
    "@type",
    "einddiepte"
  ]
}