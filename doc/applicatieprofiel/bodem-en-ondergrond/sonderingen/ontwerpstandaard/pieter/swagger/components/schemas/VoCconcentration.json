{
  "title": "VoCconcentration",
  "type": "object",
  "description": "Het aantal vluchtige organische stoffen per hoeveelheid oppervlak.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse VoCconcentration)",
      "pattern": "^VoCconcentration$"
    },
    "tijdstip": {
      "type": "object",
      "description": "Het punt in de tijd waar de sondering plaatsvindt.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "inclinatie": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "geometrie": {
      "$ref": "#/components/schemas/Domeinobject"
    },
    "waarde": {
      "$ref": "#/components/schemas/Record"
    }
  },
  "required": [
    "@type",
    "tijdstip",
    "geometrie",
    "waarde"
  ]
}