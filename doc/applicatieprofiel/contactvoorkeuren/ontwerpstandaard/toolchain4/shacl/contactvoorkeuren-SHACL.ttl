    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Verwerkingsactiviteit.Contactkanaal>;
    shacl:class skos:Concept;
    shacl:description "Het kanaal of medium langs waar een gebruiker gecontacteerd kan worden. Bijvoorbeeld sms of e-mail."@nl;
    shacl:minCount "1";
