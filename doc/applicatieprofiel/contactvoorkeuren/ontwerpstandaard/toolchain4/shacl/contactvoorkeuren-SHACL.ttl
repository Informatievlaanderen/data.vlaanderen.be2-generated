<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  rdfs:comment "Gestructureerde voorstelling van een adres."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <http://data.vlaanderen.be/ns/adres#Adresvoorstelling.busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam van het adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <http://data.vlaanderen.be/ns/adres#gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path <http://data.vlaanderen.be/ns/adres#Adresvoorstelling.huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Adresvoorstelling.Land>;
    shacl:datatype rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <http://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Straatnaam van het adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Adresvoorstelling.Straatnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Straatnaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verwijst naar"@nl;
    rdfs:comment "Verwijst naar de identificator (URI) van een adres in het adresregister."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Adresvoorstelling.VerwijstNaar>;
    shacl:class <https://data.vlaanderen.be/ns/adres#Adres>;
    shacl:description "Verwijst naar de identificator (URI) van een adres in het adresregister."@nl;
    shacl:maxCount "1";
    shacl:name "verwijst naar"@nl;
    shacl:path <http://data.vlaanderen.be/ns/adres#verwijstNaar>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> "De agent is de data subject van de Toestemming. De Agent vertegenwoordig de natuurlijk persoon, persoon in een bepaalde hoedanigheid of de organisatie die uitdrukkelijk toestemming verleend."@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon… die toelaat de Agent te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Agent.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie zoals email, telefoon… die toelaat de Agent te contacteren."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path schema:contactPoint
  ];
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#AlgemeneVoorwaardenShape> a shacl:NodeShape;
  rdfs:label "Algemene Voorwaarden"@nl;
  rdfs:comment "Standaardbedingen waarnaar verwezen kan worden bij het opstellen van een schriftelijke overeenkomst. Algemene voorwaarden mogen niet 'onredelijk bezwarend' zijn; dan kunnen ze door de rechter nietig worden verklaard."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/toestemming#AlgemeneVoorwaarden> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#BelgischAdresShape> a shacl:NodeShape;
  rdfs:label "Belgisch Adres"@nl;
  <http://purl.org/vocab/vann/usageNote> "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bv ingangaanduiding, trapaanduiding, verdiepaanduiding...) of een gebouwnaam of kamernaam ed zijn mogelijk dmv een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren mbv het object adresvoorstelling."@nl;
  rdfs:comment "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid, een ligplaats, een standplaats of een perceel op basis van een gemeentenaam, een straatnaam, een huisnummer en eventueel een busnummer en een postcode."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#Adres> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "ContactInfo"@nl;
  rdfs:comment "Informatie zoals email,telefoon,adres die toelaat om iemand te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanschrijfvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb De heer/Mevrouw, Excellentie, Dokter…"@nl;
    rdfs:comment "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Contactinfo.Aanschrijfvorm>;
    shacl:datatype rdf:langString;
    shacl:description "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    shacl:maxCount "1";
    shacl:name "aanschrijfvorm"@nl;
    shacl:path vcard:honorific-prefix
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactnaam"@nl;
    rdfs:comment "Naam van de persoon die men kan contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Contactinfo.Contactnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van de persoon die men kan contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactnaam"@nl;
    shacl:path foaf:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Contactinfo.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schema:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen of smsen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Contactinfo.Telefoon>;
    shacl:datatype xsd:string;
    shacl:description "Telefoonnummer waarop men kan bellen of smsen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schema:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres dat men kan aanschrijven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Contactinfo.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ];
  shacl:targetClass schema:ContactPoint .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#CookieverklaringShape> a shacl:NodeShape;
  rdfs:label "Cookieverklaring"@nl;
  rdfs:comment "Een document met informatie om personen duidelijk te informeren over welke cookies gebruikt worden in een toepassing en voor welke doeleinden."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/toestemming#Cookieverklaring> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#DateShape> a shacl:NodeShape;
  rdfs:label "Date";
  shacl:closed false;
  shacl:targetClass xsd:date .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#DocumentShape> a shacl:NodeShape;
  rdfs:label "Document"@nl;
  rdfs:comment "Document met omstandige informatie over de identiteit van de verantwoordelijke, de geplande verwerkingen, de doelstelling en de wettelijke grond en over de genomen maatregelen om zijn data te beschermen."@nl;
  shacl:closed false;
  shacl:targetClass foaf:Document .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#HoedanigheidShape> a shacl:NodeShape;
  rdfs:label "Hoedanigheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een persoon in zijn functie bij een organisatie kan handelingen stellen, heeft specifieke contactinformatie en heeft mogelijks een andere identificator dan de natuurlijk persoon."@nl;
  rdfs:comment "Een Agent in een bepaalde functie bij een organisatie."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/organisatie#Hoedanigheid> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als Agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "PubliekeOrganisatie.Verwerkersovereenkomst";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Organisatie.Publiekeorganisatie.verwerkersovereenkomst>;
    shacl:class <https://data.vlaanderen.be/ns/toestemming#Verwerkersovereenkomst>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "PubliekeOrganisatie.Verwerkersovereenkomst";
    shacl:path <http://todo.com/PubliekeOrganisatie.Verwerkersovereenkomst>
  ];
  shacl:targetClass org:Organization .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke Organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Een natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#PrivacyverklaringShape> a shacl:NodeShape;
  rdfs:label "Privacyverklaring"@nl;
  rdfs:comment "Een document met informatie om personen duidelijk te informeren over welke privacygevoelige gegevens u verzamelt en met welk doel."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/toestemming#Privacyverklaring> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#PubliekeDienstverleningShape> a shacl:NodeShape;
  rdfs:label "Publieke Dienstverlening"@nl;
  <http://purl.org/vocab/vann/usageNote> "De dienstverlening vormt een aanbod (dat dus niet noodzakelijk wordt gebruikt). Ze houdt niet noodzakelijk het opnemen van een recht in,de dienstverlening kan de gebruiker ook toelaten een verplichting te vervullen."@nl;
  rdfs:comment "Een Publieke Dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen hiervan."@nl;
  shacl:closed false;
  shacl:targetClass <http://purl.org/vocab/cpsv#PublicService> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#PubliekeOrganisatieShape> a shacl:NodeShape;
  rdfs:label "Publieke Organisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "De overheids- en semioverheidsorganisaties die tot men zo tot de publieke sector kan rekenen worden in Europese richtlijn 2003/98/EG \"openbaar lichaam\" genoemd en gedefinieerd als: \"de staat, zijn territoriale lichamen, publiekrechtelijke instellingen, en verenigingen gevormd door een of meer van deze lichamen of een of meer van deze publiekrechtelijke instellingen\". En onder een publiekrechtelijke instelling verstaat men \" iedere instelling die a) is opgericht met het specifieke doel te voorzien in behoeften van algemeen belang die niet van industriële of commerciële aard zijn, en b) rechtspersoonlijkheid heeft, en c) waarvan hetzij de activiteiten in hoofdzaak door de staat of zijn territoriale lichamen of andere publiekrechtelijke instellingen worden gefinancierd, hetzij het beheer is onderworpen aan toezicht door deze laatste, hetzij de leden van het bestuursorgaan, het leidinggevend orgaan of het toezichthoudend orgaan voor meer dan de helft door de staat, zijn territoriale lichamen of andere publiekrechtelijke instellingen zijn aangewezen.\"."@nl;
  rdfs:comment "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector,ongeacht het bestuursniveau waarop dat kader van kracht is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "heeft verwerkersovereenkomst met"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#PubliekeOrganisatie.HeeftVerwerkersovereenkomstMet>;
    shacl:class org:Organization;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft verwerkersovereenkomst met"@nl;
    shacl:path <https://data.vlaanderen.be/ns/toestemming#heeftVerwerkersovereenkomstMet>
  ], [
    a shacl:PropertyShape;
    rdfs:label "PubliekeOrganisatie.Verwerkersovereenkomst";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#PubliekeOrganisatie.Publiekeorganisatie.verwerkersovereenkomst>;
    shacl:class <https://data.vlaanderen.be/ns/toestemming#Verwerkersovereenkomst>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "PubliekeOrganisatie.Verwerkersovereenkomst";
    shacl:path <http://todo.com/PubliekeOrganisatie.Verwerkersovereenkomst>
  ];
  shacl:targetClass <http://data.europa.eu/m8g/PublicOrganisation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#ToestemmingShape> a shacl:NodeShape;
  rdfs:label "Toestemming"@nl;
  rdfs:comment "Een expliciete toestemming,gegeven door een bepaalde Agent die het onderwerp vormt van de persoonlijke informatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gegeven op"@nl;
    rdfs:comment "De datum waarop de toestemming werd verleend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/contactvoorkeuren/ontwerpstandaard/toolchain4#Toestemming.GegevenOp>;
    shacl:datatype xsd:date;
    shacl:description "De datum waarop de toestemming werd verleend."@nl;
    shacl:maxCount "1";
