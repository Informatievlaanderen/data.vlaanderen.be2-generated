    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/pieter#Toevoegingdeel.Toegevoegd>;
    shacl:description "MaterieelDing dat is toegevoegd."@nl;
    shacl:minCount "1";
