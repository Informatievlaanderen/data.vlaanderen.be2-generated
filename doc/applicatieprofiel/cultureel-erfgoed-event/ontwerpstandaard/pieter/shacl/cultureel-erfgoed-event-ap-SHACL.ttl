    shacl:minCount "1";
    shacl:name "uitbreidingVan"@nl;
    shacl:or ([shacl:class crm:E18_Physical_Thing] [shacl:class crm:E78_Collection] [shacl:class crm:E22_Man-Made_Object] [shacl:class crm:E25_Man-Made_Feature]);
    shacl:path crm:P110_augmented
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegevoegd"@nl;
