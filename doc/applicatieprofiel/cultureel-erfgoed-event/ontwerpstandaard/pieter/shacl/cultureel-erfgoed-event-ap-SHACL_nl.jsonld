      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Begin van de evolutie van het Werk, tot de laatste Expressie ervan. Komt niet noodzakelijk overeen met het werkelijk begin maar bijvoorbeeld met het moment waarop een eerste versie van het Werk klaar was."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Activiteit die het ontstaan van een Werk markeert."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Conceptie"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_1_61"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://www.iflastandards.info/fr/frbr/frbroo#F27"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/pieter#ConceptueeldingShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Kan geproduceerd zijn met technologische middelen zoals camera's of computers. Typisch gecreëerd, uitgevonden of bedacht door iemand en dan gedocumenteerd of doorgegeven. Kunnen op meerdere dragers tegelijk bestaan, bijvoorbeeld papier, audio, foto, harde schijf, canvas, menselijk geheugen. Een ConceptueelDing kan niet worden vernietigd, het bestaan ervan stopt pas als het op geen enkele drager nog voorkomt. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Niet-materiële voortbrengselen van de geest of andere door mensen geproduceerde gegevens."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "ConceptueelDing"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/E28_Conceptual_Object"
      },
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object"
      },
      {
        "@id": "https://www.iflastandards.info/fr/frbr/frbroo#F1"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/pieter#ConditiebeoordelingShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Dit kan bijvoorbeeld door inspectie of meting. Standaard attributen zijn conditie en een verwijzing naar het MaterieelDing, maar overgeërfde attributen van Gebeurtenis of Activiteit laten toe om de kwaliteit van de beoordeling te bepalen (bijvoorbeeld wanneer werd ze uitgevoerd en door wie).\n."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Het vaststellen van de staat van een MaterieelDing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Conditiebeoordeling"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
