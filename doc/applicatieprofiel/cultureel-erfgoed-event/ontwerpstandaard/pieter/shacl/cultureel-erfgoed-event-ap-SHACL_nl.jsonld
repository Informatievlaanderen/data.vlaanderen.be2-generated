      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/pieter#ZelfstandigeexpressieShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Een Werk kan gerealiseerd worden door meerdere ZelfstandigeExpressies, maar achter elke ZelfstandigeExpressie zit in principe een Individueel Werk. Bijvoorbeeld een Aggregatiewerk van het type muziekalbum bevat meerdere ZelfstandigeExpressies die elk een Individueel Werk van het type \"song\" realiseren. Onder \"zelfstandig\" of \"compleet\" verstaan we dat de creator deze intentie had, zelfs al heeft hij de expressie misschien nooit volledig afgewerkt."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De immateriële realisatie van een Individueel Werk op een bepaald moment dat als een compleet geheel kan worden beschouwd."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "ZelfstandigeExpressie"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://www.iflastandards.info/fr/frbr/frbroo#F22"
      }
    ]
  },
