      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Gaat bijvoorbeeld over het toevoegen van een element aan een MensgemaaktObject of het opnemen van een item in een GecureerdeCollectie. De toevoeging kan fysiek zijn (bijvoorbeeld diamant in een ring) of louter functioneel (bijvoorbeeld schaakstuk van een schaakset). De integratie kan dusdanig ingrijpend zijn dat het oorspronkelijk deel ophoudt te bestaan of dat het resultaat beschouwd moet worden als een nieuw object.\n."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Uitbreiding, vergroting of verbetering van een MaterieelDing door toevoeging van een deel."
      }
    ],
