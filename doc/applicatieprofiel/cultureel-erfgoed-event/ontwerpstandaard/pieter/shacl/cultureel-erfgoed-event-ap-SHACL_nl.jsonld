  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/pieter#BewaringShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Door een object in Bewaring te nemen is men nog niet de eigenaar, zie Verwerving voor de overdracht van de eigendomstitel. Het vermelden van de Agenten die bij de Bewaring betrokken waren is niet verplicht. Dekt ook gevallen als verlies of diefstal: men blijft dan eigenaar maar heeft het object niet langer onder zijn hoede."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Overdracht van de opslag van een MaterieelDing (bijvoorbeeld een MensgemaaktObject) van de ene Agent naar de andere, bijvoorbeeld van de eigenaar naar een museum."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Bewaring"
      }
    ],
