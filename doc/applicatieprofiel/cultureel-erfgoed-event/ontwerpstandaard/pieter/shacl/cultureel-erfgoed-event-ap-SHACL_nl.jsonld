      },
      {
        "@id": "_:df_1_52"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/E11_Modification"
      },
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/E12_Production"
      },
      {
        "@id": "https://www.iflastandards.info/fr/frbr/frbroo#F28"
      },
      {
        "@id": "https://www.iflastandards.info/fr/frbr/frbroo#F29"
      },
      {
        "@id": "https://www.iflastandards.info/fr/frbr/frbroo#F30"
      },
