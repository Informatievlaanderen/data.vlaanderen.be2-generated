    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Activiteit die leidt tot het onstaan van een ConceptueelDing, bijvoorbeeld een gedicht, tekst, muziek, beelden, films etc."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
