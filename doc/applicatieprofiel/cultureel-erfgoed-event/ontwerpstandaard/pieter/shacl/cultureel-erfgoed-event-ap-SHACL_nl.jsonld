  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/pieter#DingShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Het kan om fysieke voorwerpen gaan maar ook om intellectuele producten. Dingen zijn relatief stabiel in de tijd,kunnen een materiële vorm aannemen of zijn electronisch gecodeerd of zijn logische concepten of structuren."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Afzonderlijk hanteerbaar,identificeerbaar,als eenheid te beschrijven,persistent item."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Ding"
      }
    ],
