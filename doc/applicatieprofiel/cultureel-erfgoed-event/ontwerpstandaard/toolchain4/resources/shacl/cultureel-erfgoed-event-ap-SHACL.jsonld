    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Gaat bv over het toevoegen van een element aan een MensgemaaktObject of het opnemen van een item in een GecureerdeCollectie. De toevoeging kan fysiek zijn (bv diamant in een ring) of louter functioneel (bv schaakstuk van een schaakset). De integratie kan dusdanig ingrijpend zijn dat het oorspronkelijk deel ophoudt te bestaan of dat het resultaat beschouwd moet worden als een nieuw object."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
