  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/toolchain4#ConceptieShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Begin van de evolutie van het Werk, tot de laatste Expressie ervan. Komt niet noodzakelijk overeen met het werkelijk begin maar bv met het moment waarop een eerste versie van het Werk klaar was."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Activiteit die het ontstaan van een Werk markeert."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Conceptie"
      }
    ],
