      {
        "@id": "_:df_8_45"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/E10_Transfer_of_Custody"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/toolchain4#ClassificatieShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Standaard attributen zijn voorzien om het getypeerde Object en het toegekende type op te geven. Daarnaast kan aangegeven worden wie de classificatie uitvoerde en wanneer (via overerving van overeenkomstige attributen van Activiteit en Gebeurtenis), dit is van belang voor geopinieerde classificaties."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Het toekennen van een type aan een Entiteit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Classificatie"
      }
    ],
