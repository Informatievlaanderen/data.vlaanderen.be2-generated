        "@value": "Voorziet rechtstreekse of onrechtstreekse subklassen zoals MensgemaaktObject, Werk, Activiteit, Gebeurtenis etc minimaal van een identificator, een type en een beschrijving."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Abstracte superklasse."
      }
    ],
