  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/toolchain4#CuratieShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Items worden toegevoegd en georganiseerd volgens onderwerp, periode, materiaal, stijl etc. en met het oog op een bepaald doel of publiek. De initiële samenstelling van de collectie wordt beschouwd als een Productie event, maar alles wat daarna komt op het vlak van ontwikkeling, bewaring of promotie valt onder Curatie."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Activiteit die de continuïteit verzekert op het vlak van beheer, behoud en evolutie van een GecureerdeCollectie volgens een impliciet of expliciet plan."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Curatie"
      }
    ],
