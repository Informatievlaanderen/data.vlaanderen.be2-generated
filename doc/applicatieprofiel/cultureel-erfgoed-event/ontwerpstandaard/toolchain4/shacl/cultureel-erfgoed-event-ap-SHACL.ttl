    shacl:description "Waarde van het kenmerk die is toegekend."@nl;
    shacl:name "toegekende waarde"@nl;
    shacl:path crm:P141_assigned
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend aan"@nl;
