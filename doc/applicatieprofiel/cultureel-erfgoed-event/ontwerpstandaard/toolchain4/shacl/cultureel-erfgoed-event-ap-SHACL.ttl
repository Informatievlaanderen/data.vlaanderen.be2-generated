<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/toolchain4#VerhuisShape> a shacl:NodeShape;
  rdfs:label "Verhuis"@nl;
  <http://purl.org/vocab/vann/usageNote> ""@nl;
