  shacl:targetClass crm:E13_Attribute_Assignment .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/toolchain4#ToevoegingDeelShape> a shacl:NodeShape;
  rdfs:label "Toevoeging Deel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Gaat bv over het toevoegen van een element aan een MensgemaaktObject of het opnemen van een item in een GecureerdeCollectie. De toevoeging kan fysiek zijn (bv diamant in een ring) of louter functioneel (bv schaakstuk van een schaakset). De integratie kan dusdanig ingrijpend zijn dat het oorspronkelijk deel ophoudt te bestaan of dat het resultaat beschouwd moet worden als een nieuw object."@nl;
  rdfs:comment "Uitbreiding, vergroting of verbetering van een MaterieelDing door toevoeging van een deel."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "uitbreiding van"@nl;
    rdfs:comment "MaterieelDing waaraan iets is toegevoegd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/toolchain4#ToevoegingDeel.UitbreidingVan>;
    shacl:class crm:E18_Physical_Thing;
    shacl:description "MaterieelDing waaraan iets is toegevoegd."@nl;
    shacl:minCount "1";
    shacl:name "uitbreiding van"@nl;
    shacl:path crm:P110_augmented
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegevoegd"@nl;
    rdfs:comment "MaterieelDing dat is toegevoegd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-event/ontwerpstandaard/toolchain4#ToevoegingDeel.Toegevoegd>;
    shacl:class crm:E18_Physical_Thing;
    shacl:description "MaterieelDing dat is toegevoegd."@nl;
    shacl:minCount "1";
    shacl:name "toegevoegd"@nl;
    shacl:path crm:P111_added
  ];
  shacl:targetClass crm:E79_Part_Addition .

