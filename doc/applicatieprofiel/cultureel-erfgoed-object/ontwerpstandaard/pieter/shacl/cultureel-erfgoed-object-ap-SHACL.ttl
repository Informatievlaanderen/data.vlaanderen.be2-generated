    rdfs:label "omvat"@nl;
    <http://purl.org/vocab/vann/usageNote> "Eerder dan bij een component van een ConceptueelDing, kan het deel van het InformatieObject ool op zichzelf bestaan, bijvoorbeeld een muzieknummer op een album of een gedicht in een bloemlezing."@nl;
    rdfs:comment "Zelfstandig onderdeel van het InformatieObject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Informatieobject.Omvat>;
    shacl:description "Zelfstandig onderdeel van het InformatieObject."@nl;
    shacl:name "omvat"@nl;
    shacl:or ([shacl:class crm:E73_Information_Object] [shacl:class crm:E31_Document] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F22>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F26>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F24>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F25>] [shacl:class crm:E33_Linguistic_Object] [shacl:class crm:E29_Design_or_Procedure] [shacl:class crm:E36_Visual_Item]);
    shacl:path crm:P165_incorporates
  ], [
    a shacl:PropertyShape;
    rdfs:label "drager"@nl;
    rdfs:comment "Het MensgemaaktObject dat het InformatieObject draagt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Informatieobject.Drager>;
    shacl:class crm:E22_Man-Made_Object;
    shacl:description "Het MensgemaaktObject dat het InformatieObject draagt."@nl;
    shacl:name "drager"@nl;
    shacl:path crm:P128i_is_carried_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "drager"@nl;
    rdfs:comment "Het MensgemaaktKenmerk dat het InformatieObject draagt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Informatieobject.Drager>;
    shacl:class crm:E25_Man-Made_Feature;
    shacl:description "Het MensgemaaktKenmerk dat het InformatieObject draagt."@nl;
    shacl:name "drager"@nl;
