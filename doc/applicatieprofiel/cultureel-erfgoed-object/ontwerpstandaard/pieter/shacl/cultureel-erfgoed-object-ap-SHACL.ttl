    shacl:description "Structureel onderdeel van het ConceptueelDing."@nl;
    shacl:name "heeftComponent"@nl;
    shacl:path crm:P148_has_component
  ];
  shacl:targetClass crm:E28_Conceptual_Object .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#ConditieShape> a shacl:NodeShape;
  rdfs:label "Conditie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Geldt voor een bepaalde periode. Slaat op een MaterieelDing,bijvoorbeeld een MensgemaaktObject of -Kenmerk."@nl;
  rdfs:comment "Staat waarin een object zich bevindt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "periode"@nl;
    rdfs:comment "Tijdspanne waarin het object zich in deze Conditie bevindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Conditie.Periode>;
    shacl:datatype <http://id.loc.gov/datatypes/edtf/EDTF>;
    shacl:description "Tijdspanne waarin het object zich in deze Conditie bevindt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "periode"@nl;
    shacl:path crm:P4_has_time-span
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van de Conditie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Conditie.Beschrijving>;
    shacl:class <https://data.vlaanderen.be/ns/cultureel-erfgoed#Beschrijving>;
    shacl:description "Beschrijving van de Conditie."@nl;
    shacl:name "beschrijving"@nl;
    shacl:path crm:P3_has_note
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld als nieuw, goed, beschadigd etc."@nl;
    rdfs:comment "Aard van de Conditie waarin het object zich bevindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Conditie.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de Conditie waarin het object zich bevindt."@nl;
    shacl:name "type"@nl;
    shacl:path crm:P2_has_type
  ];
  shacl:targetClass crm:E3_Condition_State .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#ConditiebeoordelingShape> a shacl:NodeShape;
  rdfs:label "Conditiebeoordeling"@nl;
  <http://purl.org/vocab/vann/usageNote> """Dit kan bijvoorbeeld door inspectie of meting. Standaard attributen zijn conditie en een verwijzing naar het MaterieelDing, maar overgeërfde attributen van Gebeurtenis of Activiteit laten toe om de kwaliteit van de beoordeling te bepalen (bijvoorbeeld wanneer werd ze uitgevoerd en door wie). Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event.
."""@nl;
  rdfs:comment "Het vaststellen van de staat van een MaterieelDing."@nl;
  shacl:closed false;
  shacl:targetClass crm:E14_Condition_Assessment .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam van bijvoorbeeld de persoon die men kan contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Contactinfo.Contactnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van bijvoorbeeld de persoon die men kan contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactnaam"@nl;
    shacl:path foaf:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Contactinfo.Email>;
