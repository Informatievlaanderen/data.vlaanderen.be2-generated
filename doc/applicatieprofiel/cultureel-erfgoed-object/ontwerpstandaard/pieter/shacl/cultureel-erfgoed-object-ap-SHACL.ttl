    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schema:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Contactinfo.Telefoon>;
    shacl:datatype xsd:string;
    shacl:description "Telefoonnummer waarop men kan bellen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schema:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "fax"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Faxnummer waarnaar men kan faxen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Contactinfo.Fax>;
    shacl:datatype xsd:string;
    shacl:description "Faxnummer waarnaar men kan faxen."@nl;
    shacl:maxCount "1";
    shacl:name "fax"@nl;
    shacl:path schema:faxNumber
  ], [
    a shacl:PropertyShape;
    rdfs:label "website"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Website waarnaar men kan surfen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Contactinfo.Website>;
    shacl:datatype xsd:anyURI;
    shacl:description "Website waarnaar men kan surfen."@nl;
    shacl:maxCount "1";
    shacl:name "website"@nl;
    shacl:path foaf:page
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Contactinfo.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven of bezoeken."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ];
  shacl:targetClass schema:ContactPoint .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#CreatieShape> a shacl:NodeShape;
  rdfs:label "Creatie"@nl;
  rdfs:comment "Activiteit die leidt tot het onstaan van een ConceptueelDing, bijvoorbeeld een gedicht, tekst, muziek, beelden, films etc."@nl;
  shacl:closed false;
  shacl:targetClass crm:E65_Creation .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#CuratieShape> a shacl:NodeShape;
  rdfs:label "Curatie"@nl;
  <http://purl.org/vocab/vann/usageNote> """Items worden toegevoegd en georganiseerd volgens onderwerp, periode, materiaal, stijl etc. en met het oog op een bepaald doel of publiek. De initiële samenstelling van de collectie wordt beschouwd als een Productie event, maar alles wat daarna komt op het vlak van ontwikkeling, bewaring of promotie valt onder Curatie. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event.
."""@nl;
  rdfs:comment "Activiteit die de continuïteit verzekert op het vlak van beheer, behoud en evolutie van een GecureerdeCollectie volgens een impliciet of expliciet plan."@nl;
  shacl:closed false;
  shacl:targetClass crm:E87_Curation_Activity .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#DimensieShape> a shacl:NodeShape;
  rdfs:label "Dimensie"@nl;
  <http://purl.org/vocab/vann/usageNote> "De eigenschap is meetbaar met een zekere precisie en kan voorgesteld worden door een waarde,het is te zeggen een punt of gebied in een wiskundige of conceptuele ruimte,zoals een natuurlijk of reëel getal,een RGB-waarde..."@nl;
  rdfs:comment "Kwantificeerbare eigenschap van een Entiteit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "eenheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Te gebruiken als geen standaard eenheid gekend is."@nl;
    rdfs:comment "De eenheid waarin de waarde is uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Dimensie.Eenheid>;
    shacl:datatype xsd:string;
    shacl:description "De eenheid waarin de waarde is uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:name "eenheid"@nl;
    shacl:path schemas:unitText
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van de Dimensie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Dimensie.Beschrijving>;
    shacl:class <https://data.vlaanderen.be/ns/cultureel-erfgoed#Beschrijving>;
    shacl:description "Beschrijving van de Dimensie."@nl;
    shacl:name "beschrijving"@nl;
    shacl:path crm:P3_has_note
  ], [
    a shacl:PropertyShape;
    rdfs:label "standaardEenheid"@nl;
    rdfs:comment "De gestandaardiseerde eenheid waarin de waarde is uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Dimensie.Standaardeenheid>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#StandaardEenheid>;
    shacl:description "De gestandaardiseerde eenheid waarin de waarde is uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:name "standaardEenheid"@nl;
    shacl:path schemas:unitCode
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Aard van de eigenschap die door de Dimensie wordt beschreven, bijvoorbeeld hoogte, gewicht..."@nl;
    rdfs:comment "Grootheid van de Dimensie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Dimensie.Type>;
    shacl:class skos:Concept;
    shacl:description "Grootheid van de Dimensie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path crm:P2_has_type
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Dimensie.Waarde>;
    shacl:class schemas:Number;
    shacl:description "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ];
  shacl:targetClass crm:E54_Dimension .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#DingShape> a shacl:NodeShape;
  rdfs:label "Ding"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het kan om fysieke voorwerpen gaan maar ook om intellectuele producten. Dingen zijn relatief stabiel in de tijd,kunnen een materiële vorm aannemen of zijn electronisch gecodeerd of zijn logische concepten of structuren."@nl;
  rdfs:comment "Afzonderlijk hanteerbaar,identificeerbaar,als eenheid te beschrijven,persistent item."@nl;
  shacl:closed false;
  shacl:targetClass crm:E70_Thing .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#DocumentShape> a shacl:NodeShape;
  rdfs:label "Document"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze uitspraken nemen de vorm aan van tekst, beeld, audio, video, bestand of gelijkaardig. Opgelet: ondanks zijn naam is een computerdocument niet altijd een Document, als het niet echt iets documenteert is het een gewoon Informatieobject (of een subklasse daarvan)."@nl;
  rdfs:comment "Identificeerbaar immaterieel object dat uitspraken bevat over de werkelijkheid."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "documenteert"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld in het geval van een cataloog de Collectie die door de cataloog wordt gedocumenteerd. Maar om het even wat kan gedocumenteerd worden (een Materieel Ding, een Conceptueel Ding, een Gebeurtenis, een Persoon... ), vandaar de associatie met de superklasse Entiteit."@nl;
    rdfs:comment "Entiteit die wordt gedocumenteerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Document.Documenteert>;
    shacl:description "Entiteit die wordt gedocumenteerd."@nl;
    shacl:minCount "1";
    shacl:name "documenteert"@nl;
    shacl:or ([shacl:class <https://wherever/TODO>] [shacl:class crm:E73_Information_Object] [shacl:class crm:E31_Document] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F22>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F26>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F24>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F25>] [shacl:class crm:E33_Linguistic_Object] [shacl:class crm:E29_Design_or_Procedure] [shacl:class crm:E36_Visual_Item] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F1>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F15>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F19>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F17>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F20>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F21>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F18>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F14>] [shacl:class dcmitype:Collection] [shacl:class crm:E78_Collection] [shacl:class crm:E25_Man-Made_Feature] [shacl:class crm:E22_Man-Made_Object]);
    shacl:path crm:P70_documents
  ];
  shacl:targetClass crm:E31_Document .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#EntiteitShape> a shacl:NodeShape;
  rdfs:label "Entiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Voorziet rechtstreekse of onrechtstreekse subklassen zoals MensgemaaktObject,Werk,Activiteit,Gebeurtenis etc minimaal van een identificator,een type en een beschrijving."@nl;
  rdfs:comment "Abstracte superklasse."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van de Entiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Beschrijving van de Entiteit."@nl;
    shacl:name "beschrijving"@nl;
    shacl:path crm:P3_has_note
  ], [
    a shacl:PropertyShape;
    rdfs:label "classificatie"@nl;
    rdfs:comment "De Activiteit waarbij de Entiteit werd geklassificeerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Classificatie>;
    shacl:class crm:E17_Type_Assignment;
    shacl:description "De Activiteit waarbij de Entiteit werd geklassificeerd."@nl;
    shacl:name "classificatie"@nl;
    shacl:path crm:P41i_was_classified_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bij implementatie in RDF is de uri van de Entiteit de identificator. In de eerste plaats bedoeld voor algemeen gebruikte identificatoren, hoeft niet noodzakelijk een technisch id te zijn maar kan bijvoorbeeld ook een naam zijn."@nl;
    rdfs:comment "Identificator van de Entiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van de Entiteit."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isHetOnderwerpVan"@nl;
    rdfs:comment "Werk of Informatieobject of ander Conceptueel Ding dat gaat over deze Entiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Ishetonderwerpvan>;
    shacl:class crm:E28_Conceptual_Object;
    shacl:description "Werk of Informatieobject of ander Conceptueel Ding dat gaat over deze Entiteit."@nl;
    shacl:name "isHetOnderwerpVan"@nl;
    shacl:path crm:P129i_is_subject_of
  ], [
    a shacl:PropertyShape;
    rdfs:label "meting"@nl;
    rdfs:comment "De Activiteit waarbij deze Entiteit werd gemeten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Meting>;
    shacl:class crm:E16_Measurement;
    shacl:description "De Activiteit waarbij deze Entiteit werd gemeten."@nl;
    shacl:name "meting"@nl;
    shacl:path crm:P39i_was_measured_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "toekenning"@nl;
    rdfs:comment "De Activiteit waarbij een kenmerk aan deze Entiteit werd toegekend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Toekenning>;
    shacl:class crm:E13_Attribute_Assignment;
    shacl:description "De Activiteit waarbij een kenmerk aan deze Entiteit werd toegekend."@nl;
    shacl:name "toekenning"@nl;
    shacl:path crm:P140i_was_attributed_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Laat toe om een Entiteit (en dus ook zijn subklassen) verder (of anders) te specialiseren, typisch volgens een of ander hiërarchisch systeem, bijvoorbeeld een taxonomie of een thesaurus."@nl;
    rdfs:comment "Type van de Entiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Type>;
    shacl:class skos:Concept;
    shacl:description "Type van de Entiteit."@nl;
    shacl:name "type"@nl;
    shacl:path crm:P2_has_type
  ], [
    a shacl:PropertyShape;
    rdfs:label "wordtGedocumenteerdDoor"@nl;
    rdfs:comment "Document dat deze Entiteit documenteert."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Wordtgedocumenteerddoor>;
    shacl:class crm:E31_Document;
    shacl:description "Document dat deze Entiteit documenteert."@nl;
    shacl:name "wordtGedocumenteerdDoor"@nl;
    shacl:path crm:P70i_is_documented_in
  ], [
    a shacl:PropertyShape;
    rdfs:label "wordtNaarVerwezenDoor"@nl;
    rdfs:comment "Werk of Informatieobject of ander ConceptueelDing waarin naar de Entiteit wordt verwezen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Wordtnaarverwezendoor>;
    shacl:class crm:E28_Conceptual_Object;
    shacl:description "Werk of Informatieobject of ander ConceptueelDing waarin naar de Entiteit wordt verwezen."@nl;
    shacl:name "wordtNaarVerwezenDoor"@nl;
    shacl:path crm:P67i_is_referred_to_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "wordtUitgebeeldDoor"@nl;
    rdfs:comment "MaterieelDing (bijvoorbeeld een schilderij) dat de Entiteit uitbeeldt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Wordtuitgebeelddoor>;
    shacl:class crm:E18_Physical_Thing;
    shacl:description "MaterieelDing (bijvoorbeeld een schilderij) dat de Entiteit uitbeeldt."@nl;
    shacl:name "wordtUitgebeeldDoor"@nl;
    shacl:path crm:P62i_is_depicted_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "wordtVoorgesteldDoor"@nl;
    rdfs:comment "VisueelItem dat de Entiteit voorstelt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Wordtvoorgestelddoor>;
    shacl:class crm:E36_Visual_Item;
    shacl:description "VisueelItem dat de Entiteit voorstelt."@nl;
    shacl:name "wordtVoorgesteldDoor"@nl;
    shacl:path crm:P138i_has_representation
  ], [
    a shacl:PropertyShape;
    rdfs:label "maaktDeelUitVan"@nl;
