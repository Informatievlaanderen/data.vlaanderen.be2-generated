  <http://purl.org/vocab/vann/usageNote> "TO DO."@nl;
  rdfs:comment "TO DO."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#TypeentiteitShape> a shacl:NodeShape;
  rdfs:label "TypeEntiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "TO DO."@nl;
  rdfs:comment "TO DO."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#TypegrootheidShape> a shacl:NodeShape;
  rdfs:label "TypeGrootheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "TO DO."@nl;
  rdfs:comment "TO DO."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#TypemateriaalShape> a shacl:NodeShape;
  rdfs:label "TypeMateriaal"@nl;
  <http://purl.org/vocab/vann/usageNote> "TO DO."@nl;
