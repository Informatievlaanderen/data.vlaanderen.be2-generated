    shacl:maxCount "1";
    shacl:name "permanenteLocatie"@nl;
    shacl:or ([shacl:class <https://wherever/TODO>] [shacl:class crm:E73_Information_Object] [shacl:class crm:E31_Document] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F22>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F26>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F24>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F25>] [shacl:class crm:E33_Linguistic_Object] [shacl:class crm:E29_Design_or_Procedure] [shacl:class crm:E36_Visual_Item] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F1>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F15>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F19>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F17>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F20>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F21>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F18>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F14>] [shacl:class dcmitype:Collection] [shacl:class crm:E78_Collection] [shacl:class crm:E25_Man-Made_Feature] [shacl:class crm:E22_Man-Made_Object]);
    shacl:path crm:P54_has_current_permanent_location
  ], [
    a shacl:PropertyShape;
    rdfs:label "verhuis"@nl;
    rdfs:comment "Activiteit waarbij het MensgemaaktObject werd verhuisd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Mensgemaaktobject.Verhuis>;
    shacl:class crm:E9_Move;
    shacl:description "Activiteit waarbij het MensgemaaktObject werd verhuisd."@nl;
    shacl:name "verhuis"@nl;
    shacl:path crm:P25i_moved_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "beeldtUit"@nl;
    <http://purl.org/vocab/vann/usageNote> "Onder uitbeelden verstaan we dat het MensgemaaktObject, door zijn uitzicht of vorm, een voorstelling vormt van de betrokken Entiteit."@nl;
    rdfs:comment "Entiteit die door het MensgemaaktObject wordt uitgebeeld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Mensgemaaktobject.Beeldtuit>;
    shacl:description "Entiteit die door het MensgemaaktObject wordt uitgebeeld."@nl;
    shacl:name "beeldtUit"@nl;
    shacl:or ([shacl:class <https://wherever/TODO>] [shacl:class crm:E73_Information_Object] [shacl:class crm:E31_Document] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F22>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F26>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F24>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F25>] [shacl:class crm:E33_Linguistic_Object] [shacl:class crm:E29_Design_or_Procedure] [shacl:class crm:E36_Visual_Item] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F1>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F15>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F19>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F17>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F20>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F21>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F18>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F14>] [shacl:class dcmitype:Collection] [shacl:class crm:E78_Collection] [shacl:class crm:E25_Man-Made_Feature] [shacl:class crm:E22_Man-Made_Object]);
    shacl:path crm:P62_depicts
  ], [
    a shacl:PropertyShape;
    rdfs:label "conditie"@nl;
    rdfs:comment "Beschrijft de Conditie waarin het MensgemaaktKenmerk zich bevindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Mensgemaaktobject.Conditie>;
    shacl:class crm:E3_Condition_State;
    shacl:description "Beschrijft de Conditie waarin het MensgemaaktKenmerk zich bevindt."@nl;
    shacl:name "conditie"@nl;
    shacl:path crm:P44_has_condition
  ], [
    a shacl:PropertyShape;
    rdfs:label "maaktDeelUitVan"@nl;
    rdfs:comment "De GecureerdeCollectie waarvan het MensgemaaktObject deel uitmaakt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Mensgemaaktobject.Maaktdeeluitvan>;
    shacl:class crm:E78_Collection;
    shacl:description "De GecureerdeCollectie waarvan het MensgemaaktObject deel uitmaakt."@nl;
    shacl:name "maaktDeelUitVan"@nl;
    shacl:path crm:P46i_forms_part_of
  ], [
    a shacl:PropertyShape;
    rdfs:label "draagt"@nl;
    rdfs:comment "InformatieObject dat gedragen wordt door het MensgemaaktObject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Mensgemaaktobject.Draagt>;
    shacl:description "InformatieObject dat gedragen wordt door het MensgemaaktObject."@nl;
    shacl:name "draagt"@nl;
    shacl:or ([shacl:class crm:E73_Information_Object] [shacl:class crm:E31_Document] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F22>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F26>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F24>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F25>] [shacl:class crm:E33_Linguistic_Object] [shacl:class crm:E29_Design_or_Procedure] [shacl:class crm:E36_Visual_Item]);
    shacl:path crm:P128_carries
  ];
  shacl:targetClass crm:E22_Man-Made_Object .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#MetingShape> a shacl:NodeShape;
  rdfs:label "Meting"@nl;
  <http://purl.org/vocab/vann/usageNote> """Voorbeelden zijn het vaststellen van de afmetingen van een van een schilderij of het bepalen van zijn geldwaarde of het meten van de looptijd van een film of het tellen van het aantal woorden in een tekst. Naast de standaard attributen (waarmee kan worden aangegeven van welke Entiteit iets wordt gemeten en de vastgestelde Dimensie), zijn ook hier van Gebeurtenis en Activiteit overgeërfde attributen van belang, bijvoorbeeld het tijdstip waarop de Meting plaatsvond. Onder Meting valt niet het afleiden van informatie uit bestaande data, gebruik hiervoor de superklasse Toekenning. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event.
."""@nl;
  rdfs:comment "Vaststelling van kwantitatieve, fysische of andere kenmerken van een Entiteit die systematisch bepaald kunnen worden door middel van een objectieve procedure of door directe observatie."@nl;
  shacl:closed false;
  shacl:targetClass crm:E16_Measurement .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#OntwerpofprocedureShape> a shacl:NodeShape;
  rdfs:label "OntwerpOfProcedure"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het resultaat is een gevolg van doelbewuste menselijke activiteit en kan zowel materieel als immaterieel zijn. Het kan een procedure zijn te volgen bij het uitvoeren van een bepaalde activiteit, het kan een ontwerpschema zijn van een bepaald product, het kan ook een louter intellectuele oefening zijn (maw een ontwerp dat nooit is uitgevoerd)."@nl;
  rdfs:comment "Gedocumenteerd plan voor het uitvoeren van acties met het oog op het bekomen van een resultaat van een bepaalde kwaliteit,vorm of inhoud."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "isGeassocieerdMet"@nl;
    <http://purl.org/vocab/vann/usageNote> "Die bijvoorbeeld een deel is ervan of juist het geheel, die een volgende stap vormt in een procedure, die noodzakelijk is ervoor of die er door geïnspireerd is... Typisch gebruikt om een workflow te beschrijven."@nl;
    rdfs:comment "Associatie met een ander OntwerpOfProcedure."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Ontwerpofprocedure.Isgeassocieerdmet>;
    shacl:class crm:E29_Design_or_Procedure;
    shacl:description "Associatie met een ander OntwerpOfProcedure."@nl;
    shacl:name "isGeassocieerdMet"@nl;
    shacl:path crm:P69_is_associated_with
  ];
  shacl:targetClass crm:E29_Design_or_Procedure .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#OpnameShape> a shacl:NodeShape;
  rdfs:label "Opname"@nl;
  rdfs:comment "Expressie die het resultaat is van een Opnamesessie,bedoeld om wat daarbij geregistreerd werd over te brengen en te bewaren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "creatie"@nl;
    rdfs:comment "Activiteit waarbij de Opname werd gecreëerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Opname.Creatie>;
    shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F29>;
    shacl:description "Activiteit waarbij de Opname werd gecreëerd."@nl;
    shacl:minCount "1";
    shacl:name "creatie"@nl;
    shacl:path <https://www.iflastandards.info/fr/frbr/frbroo#R21i>
  ];
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F26> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#OpnamesessieShape> a shacl:NodeShape;
  rdfs:label "Opnamesessie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Eventueel wordt hierbij een opnameplan gevolgd. De sessie is inclusief eventuele postproductie. De ZelfstandigeExpressie die onstaat is van het type Opname en realiseert een Opnamewerk. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event."@nl;
  rdfs:comment "Het vastleggen van verschijnselen die plaatsvinden in een bepaald tijdsbestek, bijvoorbeeld de live opname van een voorstelling, het filmen van een documentaire."@nl;
  shacl:closed false;
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F29> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#OpnamewerkShape> a shacl:NodeShape;
  rdfs:label "Opnamewerk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Eventueel worden daarbij andere Werken geregistreerd maar die maken geen deel uit van het Opnamewerk, ze zijn net als bij een Containerwerk (het is te zeggen een Publicatiewerk, Voorstelling of Aggregatiewerk) hoogstens deel van de overeenkomstige Opname(expressie). Foto's of film registreren niet noodzakelijk iets (bijvoorbeeld animatiefilm) in welk geval het gewone Werken en geen Opnamewerken zijn."@nl;
  rdfs:comment "Werk gericht op het vastleggen van verschijnselen die plaatsvinden in een bepaald tijdsbestek."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "realisatie"@nl;
    rdfs:comment "Activiteit waarbij het Opnamewerk werd gerealiseerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Opnamewerk.Realisatie>;
    shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F29>;
    shacl:description "Activiteit waarbij het Opnamewerk werd gerealiseerd."@nl;
    shacl:name "realisatie"@nl;
    shacl:path <https://www.iflastandards.info/fr/frbr/frbroo#R22i>
  ];
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F21> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Organisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ];
  shacl:targetClass org:Organization .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#PeriodeShape> a shacl:NodeShape;
  rdfs:label "Periode"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typisch volgt de duur uit het opgeven van een begin- en eindtijd maar ook een individuele tijd heeft een duur (bijvoorbeeld 2020 loopt van 1/1/2020 tot 31/12/2020). Tijden worden door middel van een String weergegeven volgens EDTF-formaat, wat toelaat om te gaan met lagere precisie (bijvoorbeeld enkel het jaartal is gekend), negatieve tijden (x aantal jaar geleden), vastliggende periodes (seizoenen, kwartalen etc), onzekerheid (circa), open intervallen etc."@nl;
  rdfs:comment "Min of meer afgebakende tijdsduur."@nl;
  shacl:closed false;
  shacl:targetClass <http://id.loc.gov/datatypes/edtf/EDTF> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, het is te zeggen met eigen rechtspersoonlijkheid) van de menselijke soort, het is te zeggen een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bijvoorbeeld ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "achternaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam van de persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Persoon.Achternaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam van de persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "achternaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "voornaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Persoon.Voornaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    shacl:minCount "1";
    shacl:name "voornaam"@nl;
    shacl:path foaf:givenName
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#ProductieShape> a shacl:NodeShape;
  rdfs:label "Productie"@nl;
  <http://purl.org/vocab/vann/usageNote> """Bijvoorbeeld het maken van een schilderij. Eenzelfde Activiteit kan meer dan één object doen ontstaan, bijvoorbeeld bij het drukken van een boek. De Productie geldt vanaf het moment dat het object relevant wordt, bijvoorbeeld een canvas van zodra het wordt beschilderd. Ook mogelijk is dat ten gevolge van Productie een object wordt gemaakt ten koste van een ander object (en enkel materie bewaard blijft). Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event.
."""@nl;
  rdfs:comment "Activiteit die leidt tot en slaagt in het ontstaan van een MaterieelDing."@nl;
  shacl:closed false;
  shacl:targetClass crm:E12_Production .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#PublicatieShape> a shacl:NodeShape;
  rdfs:label "Publicatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Er zijn twee vormen van publiceren: fysiek en electronisch. In het eerste geval worden op grote schaal MensgemaakteObjecten geproduceerd (bijvoorbeeld boeken), in het tweede geval MensgemaakteKenmerken (een gedownloade copie op een harde schijf). Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event."@nl;
  rdfs:comment "Activiteit die betrekking heeft op het publiceren, het is te zeggen het verspreiden van expressies naar een groot publiek, bijvoorbeeld in boekvorm of op het web."@nl;
  shacl:closed false;
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F30> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#PublicatieexpressieShape> a shacl:NodeShape;
  rdfs:label "PublicatieExpressie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typisch wordt wat oorspronkelijk louter tekst was grafisch en typografisch vormgegeven en worden illustraties en andere inhoud toegevoegd. Als zodanig bevat een instantie van een PublicatieExpressie alle Expressies nodig voor de uiteindelijke weergave van de publicatie, of die nu visueel, audio of tactiel is."@nl;
  rdfs:comment "Geheel van zaken die uitdrukking geven aan de beslissingen van uitgevers mbt de selectie van de inhoud en de lay-out van publicaties."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "creatie"@nl;
    rdfs:comment "Activiteit waarbij de PublicatieExpressie werd gecreëerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Publicatieexpressie.Creatie>;
    shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F30>;
    shacl:description "Activiteit waarbij de PublicatieExpressie werd gecreëerd."@nl;
    shacl:minCount "1";
    shacl:name "creatie"@nl;
    shacl:path <https://www.iflastandards.info/fr/frbr/frbroo#R24i>
  ];
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F24> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#PublicatiewerkShape> a shacl:NodeShape;
  rdfs:label "Publicatiewerk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typische voorbeelden zijn boeken, tijdschriften, naslagwerken, e-boeken, podcasts, blogs... Is net als een Aggregatiewerk of een Voorstellingswerk een Containerwerk, di een Werk waarvan de Expressie uit Expressies van andere Werken bestaat, bijvoorbeeld teksten, foto's..."@nl;
  rdfs:comment "Werk bedoeld om verspreid te worden voor een groter publiek,in materiële of elektronische vorm en gericht op het weergeven van de Expressies van andere Werken."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "realisatie"@nl;
    rdfs:comment "Activiteit waarbij het Publicatiewerk werd gerealiseerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Publicatiewerk.Realisatie>;
    shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F30>;
    shacl:description "Activiteit waarbij het Publicatiewerk werd gerealiseerd."@nl;
    shacl:name "realisatie"@nl;
    shacl:path <https://www.iflastandards.info/fr/frbr/frbroo#R23i>
  ];
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F19> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#RechtShape> a shacl:NodeShape;
  rdfs:label "Recht"@nl;
  rdfs:comment "Omvat wettelijke privileges met betrekking tot materiële en immateriële dingen en hun afgeleiden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "Titel van het Recht."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Recht.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "Titel van het Recht."@nl;
    shacl:name "titel"@nl;
    shacl:path crm:P102_has_title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van het Recht."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Recht.Beschrijving>;
    shacl:class <https://data.vlaanderen.be/ns/cultureel-erfgoed#Beschrijving>;
    shacl:description "Beschrijving van het Recht."@nl;
    shacl:name "beschrijving"@nl;
    shacl:path crm:P3_has_note
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Soort Recht."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Recht.Type>;
    shacl:class skos:Concept;
    shacl:description "Soort Recht."@nl;
    shacl:name "type"@nl;
    shacl:path crm:P2_has_type
  ], [
    a shacl:PropertyShape;
    rdfs:label "isInBezitVan"@nl;
    rdfs:comment "Recht waarover een Agent beschikt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Recht.Isinbezitvan>;
    shacl:description "Recht waarover een Agent beschikt."@nl;
    shacl:name "isInBezitVan"@nl;
