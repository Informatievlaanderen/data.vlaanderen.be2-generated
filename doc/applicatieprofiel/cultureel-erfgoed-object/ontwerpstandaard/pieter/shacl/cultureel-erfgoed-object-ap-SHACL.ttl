    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Entiteit.Maaktdeeluitvan>;
    shacl:description "De Collectie waar de Entiteit deel van uitmaakt."@nl;
    shacl:name "maaktDeelUitVan"@nl;
    shacl:or ([shacl:class dcmitype:Collection] [shacl:class crm:E78_Collection]);
    shacl:path dc:isPartOf
  ];
  shacl:targetClass crm:E1_CRM_Entity .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#ExpressiecreatieShape> a shacl:NodeShape;
  rdfs:label "ExpressieCreatie"@nl;
  <http://purl.org/vocab/vann/usageNote> """Tevens subklasse van Productie. We gaan er hier immers van uit dat de ExpressieCreatie iets materieel achterlaat, bijvoorbeeld het manuscript van een tekst of een tape met muziek. Gevallen waar dit niet zo is (bijvoorbeeld bij orale tradities zoals het doorvertellen van verhalen) worden buiten beschouwing gelaten (maar kunnen nog steeds als Werk worden geregistreerd). Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event.
."""@nl;
  rdfs:comment "Activiteit die leidt tot het ontstaan van een ZelfstandigeExpressie van een Werk."@nl;
  shacl:closed false;
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F28> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#GecureerdecollectieShape> a shacl:NodeShape;
  rdfs:label "GecureerdeCollectie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typische voorbeelden zijn museumcollecties,archieven,bibliotheekcollecties,digitale bibliotheken. Samengestelde objecten zoals meerluiken of schaaksets die een fysiek of functioneel geheel vormen zijn geen GecureerdeCollecties."@nl;
  rdfs:comment "Verzameling MateriëleDingen die voor een specifiek doel en een bepaald publiek en volgens een ontwikkelingsplan door één of meer personen of organisaties wordt samengesteld en onderhouden (\"gecureerd\" en \"bewaard\" in museumtermen)."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "Titel van de GecureerdeCollectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Gecureerdecollectie.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "Titel van de GecureerdeCollectie."@nl;
    shacl:name "titel"@nl;
    shacl:path crm:P102_has_title
  ], [
    a shacl:PropertyShape;
    rdfs:label "dimensie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de geldwaarde of het aantal items waaruit ze bestaat."@nl;
    rdfs:comment "Beschrijft een Dimensie van de GecureerdeCollectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Gecureerdecollectie.Dimensie>;
    shacl:class crm:E54_Dimension;
    shacl:description "Beschrijft een Dimensie van de GecureerdeCollectie."@nl;
    shacl:name "dimensie"@nl;
    shacl:path crm:P43_has_dimension
  ], [
    a shacl:PropertyShape;
    rdfs:label "gecureerdBij"@nl;
    rdfs:comment "Activiteit waarbij de GecureerdeCollectie gecureerd is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Gecureerdecollectie.Gecureerdbij>;
    shacl:class crm:E87_Curation_Activity;
    shacl:description "Activiteit waarbij de GecureerdeCollectie gecureerd is."@nl;
    shacl:name "gecureerdBij"@nl;
    shacl:path crm:P147i_was_curated_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:comment "Beschrijft de huidige locatie van de GecureerdeCollectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Gecureerdecollectie.Locatie>;
    shacl:class prov:Location;
    shacl:description "Beschrijft de huidige locatie van de GecureerdeCollectie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "locatie"@nl;
    shacl:path crm:P53_has_former_or_current_location
  ], [
    a shacl:PropertyShape;
    rdfs:label "curator"@nl;
    rdfs:comment "Agent die de verantwoordelijkheid van curator van de GecureerdeCollectie aanneemt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Gecureerdecollectie.Curator>;
    shacl:description "Agent die de verantwoordelijkheid van curator van de GecureerdeCollectie aanneemt."@nl;
    shacl:minCount 1;
    shacl:name "curator"@nl;
    shacl:or ([shacl:class dc:Agent] [shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class org:Organization]);
    shacl:path crm:P109_has_current_or_former_curator
  ], [
    a shacl:PropertyShape;
    rdfs:label "bestaatUit"@nl;
    <http://purl.org/vocab/vann/usageNote> "Merk op dat componenten van een MaterieelDing deel kunnen uitmaken van meerdere MateriëleDingen, bijvoorbeeld een object dat tot meerdere collecties behoort."@nl;
    rdfs:comment "Het MensgemaaktObject dat deel uitmaakt van de GecureerdeCollectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Gecureerdecollectie.Bestaatuit>;
    shacl:class crm:E22_Man-Made_Object;
    shacl:description "Het MensgemaaktObject dat deel uitmaakt van de GecureerdeCollectie."@nl;
    shacl:name "bestaatUit"@nl;
    shacl:path crm:P46_is_composed_of
  ], [
    a shacl:PropertyShape;
    rdfs:label "bestaatUit"@nl;
    <http://purl.org/vocab/vann/usageNote> "Merk op dat componenten van een MaterieelDing deel kunnen uitmaken van meerdere MateriëleDingen, bijvoorbeeld een object dat tot meerdere collecties behoort."@nl;
    rdfs:comment "Het MensgemaaktKenmerk dat deel uitmaakt van de GecureerdeCollectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Gecureerdecollectie.Bestaatuit>;
    shacl:class crm:E25_Man-Made_Feature;
    shacl:description "Het MensgemaaktKenmerk dat deel uitmaakt van de GecureerdeCollectie."@nl;
    shacl:name "bestaatUit"@nl;
    shacl:path crm:P46_is_composed_of
  ];
  shacl:targetClass crm:E78_Collection .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#GetalShape> a shacl:NodeShape;
  rdfs:label "Getal"@nl;
  <http://purl.org/vocab/vann/usageNote> "In praktijk de primitieve datatypes waarmee een hoeveelheid kan worden aangeduid,zie xsd datatypes float,double,decimal,integer etc."@nl;
  rdfs:comment "Aanduiding van een hoeveelheid."@nl;
  shacl:closed false;
  shacl:targetClass schemas:Number .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type van de string slaat op het identificatiesysteem (inclusief de versie ervan), de string zelf op de eigenlijke identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Identificator.Identificator>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount "1";
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendDoor (string)"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam van de agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Identificator.Toegekenddoor(string)>;
    shacl:datatype xsd:string;
    shacl:description "Naam van de agent die de identificator heeft toegekend."@nl;
    shacl:maxCount "1";
    shacl:name "toegekendDoor (string)"@nl;
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendOp"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Tijdstip waarop de identificator werd uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Identificator.Toegekendop>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekendOp"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendDoor"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Identificator.Toegekenddoor>;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekendDoor"@nl;
    shacl:or ([shacl:class dc:Agent] [shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class org:Organization]);
    shacl:path dc:creator
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#IndividueelwerkShape> a shacl:NodeShape;
  rdfs:label "IndividueelWerk"@nl;
  <http://purl.org/vocab/vann/usageNote> "De Expressie van een IndividueelWerk stemt er één op één mee overeen, ook als de Expressie in praktijk niet voltooid is. Een IndividueelWerk kan dus maar één Expressie omvatten, dit in tegenstelling tot een Containerwerk zoals bijvoorbeeld een Publicatiewerk of een Voorstellingswerk."@nl;
  rdfs:comment "Werk dat door één ZelfstandigeExpressie kan worden gerealiseerd."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "isGerealiseerdIn"@nl;
    rdfs:comment "ZelfstandigeExpressie die uniek en volledig het IndividueelWerk uitdrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Individueelwerk.Isgerealiseerdin>;
    shacl:description "ZelfstandigeExpressie die uniek en volledig het IndividueelWerk uitdrukt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "isGerealiseerdIn"@nl;
    shacl:or ([shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F22>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F26>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F24>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F25>]);
    shacl:path <https://www.iflastandards.info/fr/frbr/frbroo#R9>
  ];
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F14> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#InformatieobjectShape> a shacl:NodeShape;
  rdfs:label "InformatieObject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Voorbeelden: gedichten,datasets,afbeeldingen,teksten,multimedia-objecten,ontwerpen of procedures,computerprogrammacode,algoritmes of wiskundige formules,kennisgraphs... Kan los van een drager bestaan of op één of meer dragers voorkomen."@nl;
  rdfs:comment "Immaterieel object dat informatie omvat, het is te zeggen gegevens of data waaraan op één of andere manier betekenis is gegeven. Een Informatieobject gaat ergens over (het is propositioneel) en brengt dat over door middel van symbolen (karakters, tekens etc.) of aggregaties daarvan."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "inhoud"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gaat over de informatie die in het InformatieObject zit, al naargelang het geval de tekst, de afbeelding, de programmacode etc."@nl;
    rdfs:comment "De symbolen of aggregaties daarvan die de inhoud van het InformatieObject uitmaken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Informatieobject.Inhoud>;
    shacl:datatype xsd:string;
    shacl:description "De symbolen of aggregaties daarvan die de inhoud van het InformatieObject uitmaken."@nl;
    shacl:name "inhoud"@nl;
    shacl:path crm:P190_has_symbolic_content
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "Titel van het InformatieObject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Informatieobject.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "Titel van het InformatieObject."@nl;
    shacl:name "titel"@nl;
    shacl:path crm:P102_has_title
  ], [
    a shacl:PropertyShape;
    rdfs:label "gaatOver"@nl;
    <http://purl.org/vocab/vann/usageNote> "Niet te verwarren met het attribuut verwijstNaar dat veel algemener is."@nl;
    rdfs:comment "Het onderwerp van het InformatieObject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Informatieobject.Gaatover>;
    shacl:description "Het onderwerp van het InformatieObject."@nl;
    shacl:name "gaatOver"@nl;
    shacl:or ([shacl:class <https://wherever/TODO>] [shacl:class crm:E73_Information_Object] [shacl:class crm:E31_Document] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F22>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F26>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F24>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F25>] [shacl:class crm:E33_Linguistic_Object] [shacl:class crm:E29_Design_or_Procedure] [shacl:class crm:E36_Visual_Item] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F1>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F15>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F19>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F17>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F20>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F21>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F18>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F14>] [shacl:class dcmitype:Collection] [shacl:class crm:E78_Collection] [shacl:class crm:E25_Man-Made_Feature] [shacl:class crm:E22_Man-Made_Object]);
    shacl:path crm:P129_is_about
  ], [
    a shacl:PropertyShape;
    rdfs:label "verwijstNaar"@nl;
    rdfs:comment "Entiteit waarnaar het InformatieObject verwijst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Informatieobject.Verwijstnaar>;
    shacl:description "Entiteit waarnaar het InformatieObject verwijst."@nl;
    shacl:name "verwijstNaar"@nl;
    shacl:or ([shacl:class <https://wherever/TODO>] [shacl:class crm:E73_Information_Object] [shacl:class crm:E31_Document] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F22>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F26>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F24>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F25>] [shacl:class crm:E33_Linguistic_Object] [shacl:class crm:E29_Design_or_Procedure] [shacl:class crm:E36_Visual_Item] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F1>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F15>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F19>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F17>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F20>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F21>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F18>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F14>] [shacl:class dcmitype:Collection] [shacl:class crm:E78_Collection] [shacl:class crm:E25_Man-Made_Feature] [shacl:class crm:E22_Man-Made_Object]);
    shacl:path crm:P67_refers_to
  ], [
