    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Rechtsgrond van het Recht."@nl;
    shacl:maxCount 1;
    shacl:name "gebaseerdOp"@nl;
    shacl:path <http://todo.com/gebaseerdOp>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isVanToepassingOp"@nl;
    rdfs:comment "WettelijkObject waarop het recht van toepassing is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Recht.Isvantoepassingop>;
    shacl:class crm:E72_Legal_Object;
    shacl:description "WettelijkObject waarop het recht van toepassing is."@nl;
    shacl:name "isVanToepassingOp"@nl;
    shacl:path crm:P104i_applies_to
  ];
  shacl:targetClass crm:E30_Right .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#RechtsgrondShape> a shacl:NodeShape;
  rdfs:label "Rechtsgrond"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een rechtsgrond kan zowel een geheel (bijvoorbeeld: wet,besluit) voorstellen als een onderdeel eruit (bijvoorbeeld: artikel)."@nl;
  rdfs:comment "Een legaal concept dat los staat van een bepaalde vorm (het achterliggende idee)."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/eli/ontology#LegalResource> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#SerieelwerkShape> a shacl:NodeShape;
  rdfs:label "SerieelWerk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld tijdschrift,magazine..."@nl;
  rdfs:comment "Periodiek uitgegeven Publicatiewerk."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "uitgaveregel"@nl;
    rdfs:comment "Patroon, frequentie en/of regelmaat waarmee het wordt uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Serieelwerk.Uitgaveregel>;
    shacl:class crm:E29_Design_or_Procedure;
    shacl:description "Patroon, frequentie en/of regelmaat waarmee het wordt uitgegeven."@nl;
    shacl:name "uitgaveregel"@nl;
    shacl:path <https://www.iflastandards.info/fr/frbr/frbroo#R11>
  ];
