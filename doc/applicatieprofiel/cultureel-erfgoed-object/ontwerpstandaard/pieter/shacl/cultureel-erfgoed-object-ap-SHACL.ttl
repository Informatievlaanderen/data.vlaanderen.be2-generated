<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#WettelijkobjectShape> a shacl:NodeShape;
  rdfs:label "WettelijkObject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld het Recht op eigenaarschap."@nl;
  rdfs:comment "Een Materieel- of ConceptueelDing dat aan een Recht onderworpen kan worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "isOnderworpenAan"@nl;
    rdfs:comment "Recht waaraan het WettelijkObject is onderworpen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Wettelijkobject.Isonderworpenaan>;
    shacl:class crm:E30_Right;
    shacl:description "Recht waaraan het WettelijkObject is onderworpen."@nl;
    shacl:name "isOnderworpenAan"@nl;
    shacl:path crm:P104_is_subject_to
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtenhouder"@nl;
    rdfs:comment "Agent die een Recht bezit op het WettelijkObject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Wettelijkobject.Rechtenhouder>;
    shacl:description "Agent die een Recht bezit op het WettelijkObject."@nl;
    shacl:name "rechtenhouder"@nl;
    shacl:or ([shacl:class dc:Agent] [shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class org:Organization]);
    shacl:path crm:P105_right_held_by
  ];
  shacl:targetClass crm:E72_Legal_Object .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#WijzigingShape> a shacl:NodeShape;
  rdfs:label "Wijziging"@nl;
  <http://purl.org/vocab/vann/usageNote> "Productie uit ruw materiaal valt hieronder maar bijvoorbeeld ook behandeling of restauratie van bestaande objecten. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event."@nl;
  rdfs:comment "Activiteit waarbij een MaterieelDing wordt geproduceerd, gewijzigd of veranderd."@nl;
  shacl:closed false;
  shacl:targetClass crm:E11_Modification .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#ZelfstandigeexpressieShape> a shacl:NodeShape;
  rdfs:label "ZelfstandigeExpressie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een Werk kan gerealiseerd worden door meerdere ZelfstandigeExpressies, maar een ZelfstandigeExpressie geeft uitdrukking aan maximaal één Werk. Bijvoorbeeld een Aggregatiewerk van het type muziekalbum bevat meerdere ZelfstandigeExpressies die elk een Individueel Werk van het type \"song\" realiseren. Onder \"zelfstandig\" of \"compleet\" verstaan we dat de creator deze intentie had, zelfs al heeft hij de expressie misschien nooit volledig afgewerkt."@nl;
  rdfs:comment "De immateriële uitdrukking van een Werk,bijvoorbeeld door middel van tekst,muziek,beeld,die op een bepaald moment een geheel vormt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "creatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "En waarop dus voor het eerst uitdrukking werd gegeven aan het werk."@nl;
    rdfs:comment "Activiteit waaropvoor de expressie ontstond."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Zelfstandigeexpressie.Creatie>;
    shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F28>;
    shacl:description "Activiteit waaropvoor de expressie ontstond."@nl;
    shacl:minCount "1";
    shacl:name "creatie"@nl;
    shacl:path <https://www.iflastandards.info/fr/frbr/frbroo#R17i>
  ], [
    a shacl:PropertyShape;
    rdfs:label "realiseert"@nl;
    rdfs:comment "Werk dat door de ZelfstandigeExpressie wordt gerealiseerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Zelfstandigeexpressie.Realiseert>;
    shacl:description "Werk dat door de ZelfstandigeExpressie wordt gerealiseerd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "realiseert"@nl;
    shacl:or ([shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F1>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F15>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F19>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F17>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F20>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F21>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F18>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F14>]);
    shacl:path <https://www.iflastandards.info/fr/frbr/frbroo#R3i>
  ], [
    a shacl:PropertyShape;
    rdfs:label "realiseert"@nl;
    rdfs:comment "IndividueelWerk dat door de ZelfstandigeExpressie wordt gerealiseerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Zelfstandigeexpressie.Realiseert>;
    shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F14>;
    shacl:description "IndividueelWerk dat door de ZelfstandigeExpressie wordt gerealiseerd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "realiseert"@nl;
    shacl:path <https://www.iflastandards.info/fr/frbr/frbroo#R9i>
  ];
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F22>,
    <https://www.iflastandards.info/fr/frbr/frbroo#F26>,
    <https://www.iflastandards.info/fr/frbr/frbroo#F24>,
    <https://www.iflastandards.info/fr/frbr/frbroo#F25> .
