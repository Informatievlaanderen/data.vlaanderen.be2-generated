  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#UriShape> a shacl:NodeShape;
  rdfs:label "URI";
  shacl:closed false;
  shacl:targetClass xsd:anyURI .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#VerhuisShape> a shacl:NodeShape;
  rdfs:label "Verhuis"@nl;
  rdfs:comment "Wijziging in de fysieke locatie van een MensgemaaktObject."@nl;
  shacl:closed false;
  shacl:targetClass crm:E9_Move .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#VernietigingShape> a shacl:NodeShape;
  rdfs:label "Vernietiging"@nl;
  <http://purl.org/vocab/vann/usageNote> """Dit kan intentioneel door mensen worden veroorzaakt of volledig los staan van menselijke activiteit. In het eerste geval is de Gebeurtenis een Activiteit. Eventueel blijft bij de Vernietiging materie behouden waaruit een nieuw MaterieelDing ontstaat. Blijft ondanks de beschadiging het object toch bewaard dan spreken we eerder van een Wijziging. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event.
."""@nl;
  rdfs:comment "Gebeurtenis waarbij een MaterieelDing dusdanig wordt aangetast dat het ophoudt te bestaan."@nl;
  shacl:closed false;
  shacl:targetClass crm:E6_Destruction .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#VerwervingShape> a shacl:NodeShape;
  rdfs:label "Verwerving"@nl;
  <http://purl.org/vocab/vann/usageNote> """De eigendomstitel is een document dat aantoont dat een Agent de wettelijke eigenaar is van het MaterieelDing. Het vermelden van de Agenten die bij de verwerving betrokken waren is niet verplicht. Dekt ook gevallen waar men zich de eigendomstitel toeëigent, bijvoorbeeld bij een vondst of annexatie. Meestal slaat men het object dat men bezit zelf op maar niet altijd, zie Bewaring. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event.
."""@nl;
  rdfs:comment "Overdracht van de eigendomstitel van een MaterieelDing van de ene Agent naar de andere, bijvoorbeeld door een verkoop of een erfenis."@nl;
  shacl:closed false;
  shacl:targetClass crm:E8_Acquisition .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#VerwijderingdeelShape> a shacl:NodeShape;
  rdfs:label "VerwijderingDeel"@nl;
  <http://purl.org/vocab/vann/usageNote> """Gaat bijvoorbeeld over het verwijderen van een element uit een MensgemaaktObject of het wegnemen van een item in een GecureerdeCollectie. De desintegratie kan dusdanig ingrijpend zijn dat het oorspronkelijk geheel ophoudt te bestaan of dat het deel beschouwd moet worden als een nieuw object. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event. 
."""@nl;
  rdfs:comment "Inkrimping van een MaterieelDing door verwijdering van een deel."@nl;
  shacl:closed false;
  shacl:targetClass crm:E80_Part_Removal .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#VisueelitemShape> a shacl:NodeShape;
  rdfs:label "VisueelItem"@nl;
  <http://purl.org/vocab/vann/usageNote> "Staat los van het uiteindelijke uitzicht of de fysieke vorm die het VisueelItem aanneemt (als MaterieelDing). Bijvoorbeeld een logo in een ander formaat, oriëntatie of kleur is nog steeds hetzelfde logo. Laat maw toe om MateriëleDingen met elkaar te koppelen waarop dezelfde visuele symbolen, tekens of afbeeldingen staan, bijvoorbeeld afbeelding van de Mona Lisa op een tas of meerdere afdrukken van eenzelfde foto. Ook handig om digitalisaties van MateriëleDingen door middel van digitale fotografie, flatbed of infrarood scanning voor te stellen."@nl;
  rdfs:comment "Intellectueel of conceptueel deel van een herkenbaar teken of afbeelding."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "steltVoor"@nl;
    <http://purl.org/vocab/vann/usageNote> "Kan meer algemeen verwijzen naar een Entiteit (bijvoorbeeld het VisueelItem stelt Jezus voor) in welk geval het analoog is aan het attribuut beeldtUit van een MensgemaaktObject of -Kenmerk. Kan ook specifieker zijn, bijvoorbeeld het MensgemaaktObject dat is afgebeeld (bijvoorbeeld de scan van een schilderij)."@nl;
    rdfs:comment "Entiteit die door het VisueelItem wordt voorgesteld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Visueelitem.Steltvoor>;
    shacl:description "Entiteit die door het VisueelItem wordt voorgesteld."@nl;
    shacl:name "steltVoor"@nl;
    shacl:or ([shacl:class <https://wherever/TODO>] [shacl:class crm:E73_Information_Object] [shacl:class crm:E31_Document] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F22>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F26>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F24>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F25>] [shacl:class crm:E33_Linguistic_Object] [shacl:class crm:E29_Design_or_Procedure] [shacl:class crm:E36_Visual_Item] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F1>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F15>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F19>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F17>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F20>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F21>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F18>] [shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F14>] [shacl:class dcmitype:Collection] [shacl:class crm:E78_Collection] [shacl:class crm:E25_Man-Made_Feature] [shacl:class crm:E22_Man-Made_Object]);
    shacl:path crm:P138_represents
  ];
  shacl:targetClass crm:E36_Visual_Item .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#VoorstellingShape> a shacl:NodeShape;
  rdfs:label "Voorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> """Hierbij wordt in principe een Voorstellingsplan gevolgd (dat in meer of mindere mate is uitgewerkt en mogelijk enkel improvisatie voorziet). Het is mogelijk om elke individuele Voorstelling apart te beschrijven of deze te beschrijven als één Voorstelling. 
."""@nl;
  rdfs:comment "Het tonen van een artistieke expressie aan een publiek, bijvoorbeeld theater, dans, muziek..."@nl;
  shacl:closed false;
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F31> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#VoorstellingsplanShape> a shacl:NodeShape;
  rdfs:label "Voorstellingsplan"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typisch de aanwijzingen nodig voor theatrale, choreografische of muziekvoorstellingen. Kan bijvoorbeeld gaan over aangepaste tekst van een toneelstuk, choregorafische bewegingen volgens een bepaalde notatie, de muzikale partituur of software-instructies. Het resultaat van een Voorstelling kan in meer of mindere mate uit het Voorstellingsplan worden afgeleid hoewel de instructies beperkt kunnen zijn (en bijvoorbeeld louter improvisatie voorzien)."@nl;
  rdfs:comment "Set van instructies waaraan individuele uitvoeringen van een Voorstelling moeten voldoen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "uitvoering"@nl;
    rdfs:comment "De Voorstelling waarop het uitvoeringsplan is uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Voorstellingsplan.Uitvoering>;
    shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F31>;
    shacl:description "De Voorstelling waarop het uitvoeringsplan is uitgevoerd."@nl;
    shacl:name "uitvoering"@nl;
    shacl:path <https://www.iflastandards.info/fr/frbr/frbroo#R25i>
  ];
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F25> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#VoorstellingswerkShape> a shacl:NodeShape;
  rdfs:label "Voorstellingswerk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Net als Aggregatiewerken of Publicatiewerken is een Voorstellingswerk een Containerwerk,het is te zeggen een Werk waarvan de Expressie Expressies van andere Werken omvat. Bijvoorbeeld de tekst van een toneelvoorstelling,de muziek van een dansvoorstelling."@nl;
  rdfs:comment "Werk gericht op het tonen van artistieke expressies voor een publiek."@nl;
  shacl:closed false;
  shacl:targetClass <https://www.iflastandards.info/fr/frbr/frbroo#F20> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#WerkShape> a shacl:NodeShape;
  rdfs:label "Werk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typische voorbeelden van Werken zijn gedichten, verhalen, muziekcomposities. Een Werk kan uit meerdere Werken bestaan maar het kan ook de uitingen van andere Werken omvatten (is bijvoorbeeld het geval bij een Publicatiewerk). Soms zijn de artistieke/intellectuele uitingen slechts indirect bewijs voor het idee of de ideëen achter een Werk, ze vormen ahw een snapshot van een Werk op een bepaald moment."@nl;
  rdfs:comment "Idee of combinatie van ideeën achter één of meer artistieke of intellectuele Expressies."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "Titel van het Werk."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Werk.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "Titel van het Werk."@nl;
    shacl:name "titel"@nl;
    shacl:path crm:P102_has_title
  ], [
    a shacl:PropertyShape;
    rdfs:label "conceptie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld het krijgen van een opdracht of de beslissing om samen te werken..."@nl;
    rdfs:comment "Activiteit die het onstaan van het Werk in gang heeft gezet."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#Werk.Conceptie>;
    shacl:class <https://www.iflastandards.info/fr/frbr/frbroo#F27>;
    shacl:description "Activiteit die het onstaan van het Werk in gang heeft gezet."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "conceptie"@nl;
