  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#IndividueelwerkShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "De Expressie van een IndividueelWerk stemt er één op één mee overeen, ook als de Expressie in praktijk niet voltooid is. Een IndividueelWerk kan dus maar één Expressie omvatten, dit in tegenstelling tot een Containerwerk zoals bijvoorbeeld een Publicatiewerk of een Voorstellingswerk."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Werk dat door één ZelfstandigeExpressie kan worden gerealiseerd."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "IndividueelWerk"
      }
    ],
