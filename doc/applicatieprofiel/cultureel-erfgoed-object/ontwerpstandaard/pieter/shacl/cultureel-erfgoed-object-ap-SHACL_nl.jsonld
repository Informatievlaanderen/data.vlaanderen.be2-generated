  {
    "@id": "_:df_1_110",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Bijvoorbeeld het Werk is uitgedrukt door middel van een tekst, muziek etc. Is het Werk een IndividueelWerk dan is er één en niet meer dan één ZelfstandigeExpressie die volledig uitdrukking geeft aan het Werk. Gaat het om een ComplexWerk dan geeft de ZelfstandigeExpressie uitdrukking aan een Werk dat deel uitmaakt van het ComplexWerk. In het geval van een Containerwerk (bijvoorbeeld een Publicatiewerk) geeft de ZelfstandigeExpressie uitdrukking aan dit werk of aan een ander werk dat erin is opgenomen (bijvoorbeeld een foto in een boek)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De ZelfstandigeExpressie die uitdrukking geeft aan het Werk."
