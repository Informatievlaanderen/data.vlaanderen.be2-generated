  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#LocatieShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet direct gewerkt worden met Geometrie,GeografischeNaam,Adres etc. Opmerking: een beschrijving van deze mogelijkheden is te vinden in het AP OSLO-Generiek."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Aanduiding van een geografische positie,door middel van coordinaten,een toponiem,een adreslabel,een verwijzing naar een plaats/regio of verwijzing naar een adres."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Locatie"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://www.w3.org/ns/prov#Location"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/pieter#MaterieeldingShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Kunnen fysieke objecten zijn maar ook fysieke kenmerken. Het onderscheid tussen beide is gebaseerd op de natuurlijke begrenzing van het ding. De meeste fysieke objecten (zoals MensgemaaktObject) kunnen verplaatst worden, voor kenmerken (zoals MensgemaaktKenmerk) geldt dat niet, deze zitten vast aan het omliggend materiaal."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Persistent fysiek item met een relatief stabiele vorm,kan mensgemaakt zijn of natuurlijk."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "MaterieelDing"
      }
    ],
