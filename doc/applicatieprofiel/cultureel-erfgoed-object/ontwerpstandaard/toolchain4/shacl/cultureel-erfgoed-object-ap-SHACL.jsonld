        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#TaalobjectShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Een Taalobject staat los van de vorm die het aanneemt (geschreven tekst,opgenomen spraak,gebarentaal). Uitingen in een niet-natuurlijke taal zoals computercode of wiskundige formules worden niet beschouwd als Taalobject maar gewoon als Informatieobject."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Identificeerbare uitdrukking in natuurlijke taal of talen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Taalobject"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_92"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#ToekenningShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Toekenning kan gaan over een Meting, Classificatie of Conditiebeoordeling (de subklassen van deze Activiteit), maar andere mogelijkheden zijn bv het vaststellen van het eigenaarschap, het dateren van het object... Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Event."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Het vaststellen van de waarde van een kenmerk (attribuut of associatie) van een Entiteit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Toekenning"
      }
    ],
