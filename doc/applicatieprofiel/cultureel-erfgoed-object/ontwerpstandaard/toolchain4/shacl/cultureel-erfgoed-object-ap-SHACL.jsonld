  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#AggregatiewerkShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Bv een bloemlezing van gedichten. Dit is een Containerwerk: net als een Publicatiewerk of een Voorstellingswerk omvat de Expressie ve Aggregatiewerk Expressies van andere Werken."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Werk dat de selectie en/of ordening inhoudt van Expressies van andere Werken."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Aggregatiewerk"
      }
    ],
