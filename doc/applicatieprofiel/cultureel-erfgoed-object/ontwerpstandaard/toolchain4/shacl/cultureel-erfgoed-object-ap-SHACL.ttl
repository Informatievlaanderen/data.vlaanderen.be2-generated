    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#MensgemaaktObject.Verhuis>;
    shacl:class crm:E9_Move;
    shacl:description "Activiteit waarbij het MensgemaaktObject werd verhuisd."@nl;
