<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#MensgemaaktObjectShape> a shacl:NodeShape;
  rdfs:label "Mensgemaakt Object"@nl;
  <http://purl.org/vocab/vann/usageNote> "De grens tussen natuurlijk of mensgemaakt is niet precies bepaald. Een steen met inscripties of een opgezette vlinder worden ook beschouwd als door de mens gemaakt."@nl;
  rdfs:comment "Fysiek object ontstaan door een doelbewuste menselijke activiteit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "dimensie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv de afmetingen."@nl;
    rdfs:comment "Beschrijft een Dimensie van het MensgemaaktObject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#MensgemaaktObject.Dimensie>;
    shacl:class crm:E54_Dimension;
    shacl:description "Beschrijft een Dimensie van het MensgemaaktObject."@nl;
    shacl:name "dimensie"@nl;
    shacl:path crm:P43_has_dimension
  ], [
