    shacl:class crm:E14_Condition_Assessment;
    shacl:description "De Activiteit waarbij de Conditie van het MaterieelDing werd beoordeeld."@nl;
    shacl:name "conditiebeoordeling"@nl;
    shacl:path crm:P34i_was_assessed_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "is ingekrompen bij"@nl;
    rdfs:comment "De Activiteit waarbij een deel van het MaterieelDing werd verwijderd."@nl;
