    shacl:class crm:E80_Part_Removal;
    shacl:description "De Activiteit waarbij een deel van het MaterieelDing werd verwijderd."@nl;
    shacl:name "is ingekrompen bij"@nl;
    shacl:path crm:P113i_was_removed_by
