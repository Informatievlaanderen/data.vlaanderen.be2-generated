    rdfs:label "locatie"@nl;
    rdfs:comment "Beschrijft de huidige locatie van het MensgemaaktObject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#MensgemaaktObject.Locatie>;
    shacl:class <https://wherever/TODO>;
    shacl:description "Beschrijft de huidige locatie van het MensgemaaktObject."@nl;
    shacl:maxCount "1";
    shacl:name "locatie"@nl;
    shacl:path crm:P55_has_current_location
  ], [
    a shacl:PropertyShape;
    rdfs:label "materiaal"@nl;
    rdfs:comment "Beschrijft het Materiaal waaruit het MensgemaaktKenmerk bestaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#MensgemaaktObject.Materiaal>;
    shacl:class skos:Concept;
    shacl:description "Beschrijft het Materiaal waaruit het MensgemaaktKenmerk bestaat."@nl;
    shacl:minCount "1";
    shacl:name "materiaal"@nl;
    shacl:path crm:P45_consists_of
  ], [
    a shacl:PropertyShape;
    rdfs:label "permanente locatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit is de plaats die normaal gereserveerd is voor het object, zoals het depot waar het wordt bewaard of het museum waar het in principe wordt tentoongesteld. Objecten worden echter soms uitgeleend aan andere instellingen of maken deel uit van een tijdelijke tentoonstelling waardoor de permanenteLocatie kan verschillen van de huidige locatie."@nl;
    rdfs:comment "Beschrijft de permanente locatie van het MensgemaaktObject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#MensgemaaktObject.PermanenteLocatie>;
    shacl:class <https://wherever/TODO>;
    shacl:description "Beschrijft de permanente locatie van het MensgemaaktObject."@nl;
    shacl:maxCount "1";
    shacl:name "permanente locatie"@nl;
    shacl:path crm:P54_has_current_permanent_location
  ], [
