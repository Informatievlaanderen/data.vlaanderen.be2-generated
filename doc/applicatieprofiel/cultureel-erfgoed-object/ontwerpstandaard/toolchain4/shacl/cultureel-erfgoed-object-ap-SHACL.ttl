    shacl:class crm:E79_Part_Addition;
    shacl:description "De Activiteit waarbij het MaterieelDing werd toegevoegd."@nl;
    shacl:name "is toegevoegd bij"@nl;
    shacl:path crm:P111i_was_added_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "is uitgebreid bij"@nl;
    rdfs:comment "De Activiteit waarbij een deel aan het MaterieelDing werd toegevoegd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#MaterieelDing.IsUitgebreidBij>;
