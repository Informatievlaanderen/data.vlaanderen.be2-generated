    shacl:description "Document dat deze Entiteit documenteert."@nl;
    shacl:name "wordt gedocumenteerd door"@nl;
    shacl:path crm:P70i_is_documented_in
  ], [
    a shacl:PropertyShape;
    rdfs:label "wordt naar verwezen door"@nl;
    rdfs:comment "Werk of Informatieobject of ander ConceptueelDing waarin naar de Entiteit wordt verwezen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#Entiteit.WordtNaarVerwezenDoor>;
