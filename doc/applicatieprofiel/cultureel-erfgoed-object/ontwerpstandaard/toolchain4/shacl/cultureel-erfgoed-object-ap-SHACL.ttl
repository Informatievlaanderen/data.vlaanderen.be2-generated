    shacl:name "wordt naar verwezen door"@nl;
    shacl:path crm:P67i_is_referred_to_by
  ], [
    a shacl:PropertyShape;
    rdfs:label "wordt uitgebeeld door"@nl;
    rdfs:comment "MaterieelDing (bv een schilderij) dat de Entiteit uitbeeldt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultureel-erfgoed-object/ontwerpstandaard/toolchain4#Entiteit.WordtUitgebeeldDoor>;
