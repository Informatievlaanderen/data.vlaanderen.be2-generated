<https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#ActiviteitShape> a shacl:NodeShape;
  rdfs:label "Activiteit"@nl;
  rdfs:comment "Actie die bewust wordt uitgevoerd door een Agent met de bedoeling een cultureel, sociaal of materieel effect teweeg te brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "label"@nl;
    <http://purl.org/vocab/vann/usageNote> "Te gebruiken om zaken die niet met andere codelijsten, datatypes, etc. worden ingevuld aan te vullen."@nl;
    rdfs:comment "Generiek label van de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Label>;
    shacl:description "Generiek label van de Activiteit."@nl;
    shacl:name "label"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <https://www.w3.org/2000/01/rdf-schema#label>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een tekstuele beschrijving van de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een tekstuele beschrijving van de Activiteit."@nl;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "taal"@nl;
    rdfs:comment "Taal waarin de activiteit doorgaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Taal>;
    shacl:description "Taal waarin de activiteit doorgaat."@nl;
    shacl:name "taal"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path schemas:inLanguage
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De naam die de activiteit draagt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam die de activiteit draagt."@nl;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Te gebruiken om zaken te capteren zoals lezing, concert, wandeling en bezoek."@nl;
    rdfs:comment "Het type van activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Type>;
    shacl:class skos:Concept;
    shacl:description "Het type van activiteit."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit datatype mag gesubstitueerd worden door om het even welk ander dat een geografische positie aanduidt, direct of indirect."@nl;
    rdfs:comment "Aanduiding van een geografische positie, dmv coordinaten, een toponiem, een adreslabel, een verwijzing naar een plaats/regio of verwijzing naar een adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Locatie>;
    shacl:class prov:Location;
    shacl:description "Aanduiding van een geografische positie, dmv coordinaten, een toponiem, een adreslabel, een verwijzing naar een plaats/regio of verwijzing naar een adres."@nl;
    shacl:maxCount "1";
    shacl:name "locatie"@nl;
    shacl:path <https://www.w3.org/ns/prov#atLocation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "tijd"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het is enkel mogelijk om ofwel Activiteit.tijd & Activiteit.locatie te gebruiken voor Activiteiten met één aanduiding in tijd & ruimte ofwel Activiteit.ruimtetijd voor meerdere aanduidingen.  Beide gebruiken is niet mogelijk."@nl;
    rdfs:comment "Tijdstip wanneer de activiteit zal plaatsvinden of heeft plaatsgevonden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Tijd>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Tijdstip wanneer de activiteit zal plaatsvinden of heeft plaatsgevonden."@nl;
    shacl:maxCount "1";
    shacl:name "tijd"@nl;
    shacl:path <http://cidoc-crm.org/cidoc-crm/P4_has_time-span>
  ], [
    a shacl:PropertyShape;
    rdfs:label "duur"@nl;
    rdfs:comment "De tijd dat de Activiteit aan d.e gang is en/of voortduurt"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Duur>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "De tijd dat de Activiteit aan d.e gang is en/of voortduurt"@nl;
    shacl:maxCount "1";
    shacl:name "duur"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.duur>
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de aanbieder te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de aanbieder te contacteren."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.contactinfo>
  ], [
    a shacl:PropertyShape;
    rdfs:label "thema"@nl;
    <http://purl.org/vocab/vann/usageNote> "Te gebruiken om zaken aan te geven zoals filosofie, maatschappijkritiek, liefde, dood, etc."@nl;
    rdfs:comment "Waar de Activiteit inhoudelijk over gaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Thema>;
    shacl:class skos:Concept;
    shacl:description "Waar de Activiteit inhoudelijk over gaat."@nl;
    shacl:name "thema"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuurparticipatie#thema>
  ], [
    a shacl:PropertyShape;
    rdfs:label "doelgroep"@nl;
    rdfs:comment "Het bedoelde of verwachte publiek van een Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Doelgroep>;
    shacl:class skos:Concept;
    shacl:description "Het bedoelde of verwachte publiek van een Activiteit."@nl;
    shacl:name "doelgroep"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.doelgroep>
  ], [
    a shacl:PropertyShape;
    rdfs:label "trigger"@nl;
    rdfs:comment "Eigenschap van de Activiteit die bepaald gedrag, gevoel of fysieke reactie kan opwekken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Trigger>;
    shacl:class skos:Concept;
    shacl:description "Eigenschap van de Activiteit die bepaald gedrag, gevoel of fysieke reactie kan opwekken."@nl;
    shacl:name "trigger"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuurparticipatie#trigger>
  ], [
    a shacl:PropertyShape;
    rdfs:label "berichtgeving"@nl;
    rdfs:comment "Berichtgeving rond de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Berichtgeving>;
    shacl:class <https://data.vlaanderen.be/ns/cultuurparticipatie#Berichtgeving>;
    shacl:description "Berichtgeving rond de Activiteit."@nl;
    shacl:name "berichtgeving"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.berichtgeving>
  ], [
    a shacl:PropertyShape;
    rdfs:label "functie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Te gebruiken om conform te zijn met Europese classificatie van culturele activiteiten."@nl;
    rdfs:comment "Doel van de Activiteit binnen een geheel van een systeem of apparaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/cultuurparticipatie/ontwerpstandaard/toolchain4#Activiteit.Functie>;
    shacl:class skos:Concept;
    shacl:description "Doel van de Activiteit binnen een geheel van een systeem of apparaat."@nl;
    shacl:name "functie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.functie>
  ], [
    a shacl:PropertyShape;
