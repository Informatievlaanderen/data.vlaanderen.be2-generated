<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#BeschrijvendresultaatShape> a shacl:NodeShape;
  rdfs:label "BeschrijvendResultaat"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb wanneer geen kwantitatieve beschrijving mogelijk is of ter aanvulling."@nl;
  rdfs:comment "Resultaat van een kwaliteitsbepaling die de kwaliteit tekstueel beschrijft."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "De tekst.."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Beschrijvendresultaat.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "De tekst.."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_DescriptiveResult.statement>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_DescriptiveResult> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#BooleanShape> a shacl:NodeShape;
  rdfs:label "Boolean";
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#BruikbaarheidShape> a shacl:NodeShape;
  rdfs:label "Bruikbaarheid"@nl;
  rdfs:comment "De mate waarin de data aan een gebruikers vereisten voldoet."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19157/2013/DataQuality_2#DQ_UsabilityElement> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#CitatieShape> a shacl:NodeShape;
  rdfs:label "Citatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Zie <a href=\"https://www.iso.org/standard/53798.html\">ISO19115 Metadata</a> voor meer info over deze klasse."@nl;
  rdfs:comment "Een gestandardiseerde referentie naar een resource."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19115/-1/2014/CitationAndResponsiblePartyInformation#CI_Citation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#ConformiteitresultaatShape> a shacl:NodeShape;
  rdfs:label "ConformiteitResultaat"@nl;
  rdfs:comment "Resultaat van een kwaliteitsbepaling die aangeeft of de kwaliteit voldoet aan een vastgelegd niveau."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geaccepteerd"@nl;
    rdfs:comment "Geeft aan of de data al dan niet conform is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Conformiteitresultaat.Geaccepteerd>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of de data al dan niet conform is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geaccepteerd"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_ConformanceResult.pass>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toelichting"@nl;
    rdfs:comment "Verdere uitleg over de conformiteit van de data."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Conformiteitresultaat.Toelichting>;
    shacl:datatype xsd:string;
    shacl:description "Verdere uitleg over de conformiteit van de data."@nl;
    shacl:maxCount "1";
    shacl:name "toelichting"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_ConformanceResult.explanation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "specificatie"@nl;
    rdfs:comment "Verwijzing naar de specifiatie waartegen de data gevalueerd wordt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Conformiteitresultaat.Specificatie>;
    shacl:class <http://def.isotc211.org/iso19115/-1/2014/CitationAndResponsiblePartyInformation#CI_Citation>;
    shacl:description "Verwijzing naar de specifiatie waartegen de data gevalueerd wordt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "specificatie"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_ConformanceResult.specification>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_ConformanceResult> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#EvaluatiemethodeShape> a shacl:NodeShape;
  rdfs:label "EvaluatieMethode"@nl;
  rdfs:comment "Beschrijving van de methode en procedure gevolgd bij de kwaliteitsbepaling."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "tijdstip"@nl;
    rdfs:comment "Tijdstip waarop de evaluatie plaatsvond."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Evaluatiemethode.Tijdstip>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de evaluatie plaatsvond."@nl;
    shacl:name "tijdstip"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityEvaluation#DQ_EvaluationMethod.dateTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "evaluatieMethodeBeschrijving"@nl;
    rdfs:comment "Beschrijving van de evaluatiemethode."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Evaluatiemethode.Evaluatiemethodebeschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Beschrijving van de evaluatiemethode."@nl;
    shacl:maxCount "1";
    shacl:name "evaluatieMethodeBeschrijving"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityEvaluation#DQ_EvaluationMethod.evaluationMethodDescription>
  ], [
    a shacl:PropertyShape;
    rdfs:label "evaluatieProcedure"@nl;
    rdfs:comment "Verwijzing naar de procedure die werd gevolgd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Evaluatiemethode.Evaluatieprocedure>;
    shacl:class <http://def.isotc211.org/iso19115/-1/2014/CitationAndResponsiblePartyInformation#CI_Citation>;
    shacl:description "Verwijzing naar de procedure die werd gevolgd."@nl;
    shacl:maxCount "1";
    shacl:name "evaluatieProcedure"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityEvaluation#DQ_EvaluationMethod.evaluationProcedure>
  ], [
    a shacl:PropertyShape;
    rdfs:label "referentieDoc"@nl;
    rdfs:comment "Verwijzing naar een document dat de methode en/of procedure beschrijft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Evaluatiemethode.Referentiedoc>;
    shacl:class <http://def.isotc211.org/iso19115/-1/2014/CitationAndResponsiblePartyInformation#CI_Citation>;
    shacl:description "Verwijzing naar een document dat de methode en/of procedure beschrijft."@nl;
    shacl:name "referentieDoc"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityEvaluation#DQ_EvaluationMethod.referenceDoc>
  ], [
    a shacl:PropertyShape;
    rdfs:label "evaluatieMethodeType"@nl;
    rdfs:comment "Type van de evaluatiemethode."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Evaluatiemethode.Evaluatiemethodetype>;
    shacl:class skos:Concept;
    shacl:description "Type van de evaluatiemethode."@nl;
    shacl:maxCount "1";
    shacl:name "evaluatieMethodeType"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityEvaluation#DQ_EvaluationMethod.evaluationMethodType>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19157/2013/DataQualityEvaluation#DQ_EvaluationMethod> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#EvaluatiemethodetypeShape> a shacl:NodeShape;
  rdfs:label "EvaluatieMethodeType"@nl;
  rdfs:comment "Het type van de methode die datakwaliteit meet."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem. OPMERKING: Een meer uitgebreide beschrijving is te vinden  in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/\">AP OSLO-Generiek basis</a>."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#KwaliteitselementShape> a shacl:NodeShape;
  rdfs:label "KwaliteitsElement"@nl;
  rdfs:comment "Beschrijving van een bepaald aspect van de kwaliteit van de data."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "standaloneKwaliteitRapportDetails"@nl;
    rdfs:comment "Clausule in het kwaliteitsrapport waarin het kwaliteitselement wordt vermeld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Kwaliteitselement.Standalonekwaliteitrapportdetails>;
    shacl:datatype xsd:string;
    shacl:description "Clausule in het kwaliteitsrapport waarin het kwaliteitselement wordt vermeld."@nl;
    shacl:maxCount "1";
    shacl:name "standaloneKwaliteitRapportDetails"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQuality_2#DQ_Element.standaloneQualityReportDetails>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afgeleidElement"@nl;
    rdfs:comment "Verwijzing naar een Kwaliteitselement waarvan dit element is afgekleid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Kwaliteitselement.Afgeleidelement>;
    shacl:class <http://def.isotc211.org/iso19157/2013/DataQuality_2#DQ_Element>;
    shacl:description "Verwijzing naar een Kwaliteitselement waarvan dit element is afgekleid."@nl;
    shacl:name "afgeleidElement"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQuality_2#DQ_Element.derivedElement>
  ], [
    a shacl:PropertyShape;
    rdfs:label "maat"@nl;
    rdfs:comment "Verwijzing naar de kwaliteitsmaat die werd gebruikt om de kwaliteit uit te drukken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Kwaliteitselement.Maat>;
    shacl:class <http://def.isotc211.org/iso19157/2013/DataQuality_2#DQ_MeasureReference>;
    shacl:description "Verwijzing naar de kwaliteitsmaat die werd gebruikt om de kwaliteit uit te drukken."@nl;
    shacl:maxCount 1;
    shacl:name "maat"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQuality_2#DQ_Element.measure>
  ], [
    a shacl:PropertyShape;
    rdfs:label "resultaat"@nl;
    rdfs:comment "Verwijzing naar het resultaat van de kwaliteitsevaluatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Kwaliteitselement.Resultaat>;
    shacl:class <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_Result>;
    shacl:description "Verwijzing naar het resultaat van de kwaliteitsevaluatie."@nl;
    shacl:minCount 1;
    shacl:name "resultaat"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQuality_2#DQ_Element.result>
  ], [
    a shacl:PropertyShape;
    rdfs:label "evaluatieMethode"@nl;
    rdfs:comment "Verwijzing naar de methode die werd gebruikt om de kwaliteit te evalueren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Kwaliteitselement.Evaluatiemethode>;
    shacl:class <http://def.isotc211.org/iso19157/2013/DataQualityEvaluation#DQ_EvaluationMethod>;
    shacl:description "Verwijzing naar de methode die werd gebruikt om de kwaliteit te evalueren."@nl;
    shacl:maxCount 1;
    shacl:name "evaluatieMethode"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQuality_2#DQ_Element.evaluationMethod>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19157/2013/DataQuality_2#DQ_Element> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#KwaliteitsresultaatShape> a shacl:NodeShape;
  rdfs:label "KwaliteitsResultaat"@nl;
  rdfs:comment "Het resultaat van de evaluatie van de datakwaliteit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "tijdstip"@nl;
    rdfs:comment "Het tijdstip waarop het resultaat bekomen werd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Kwaliteitsresultaat.Tijdstip>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het tijdstip waarop het resultaat bekomen werd."@nl;
    shacl:maxCount "1";
    shacl:name "tijdstip"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_Result.dateTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "resultaatScope"@nl;
    rdfs:comment "Het bereik van het resultaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Kwaliteitsresultaat.Resultaatscope>;
    shacl:class <http://def.isotc211.org/iso19115/-1/2014/CommonClasses#MD_Scope>;
    shacl:description "Het bereik van het resultaat."@nl;
    shacl:maxCount "1";
    shacl:name "resultaatScope"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_Result.resultScope>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_Result> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#KwantitatiefresultaatShape> a shacl:NodeShape;
  rdfs:label "KwantitatiefResultaat"@nl;
  rdfs:comment "Resultaat van een kwaliteitsbepaling met een kwantitatieve waarde als resultaat."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "De kwantiteit van de grootheid die wordt bepaald."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Kwantitatiefresultaat.Waarde>;
    shacl:class <http://def.isotc211.org/iso19103/2005/RecordsAndClassMetadata#Record>;
    shacl:description "De kwantiteit van de grootheid die wordt bepaald."@nl;
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_QuantitativeResult.value>
  ], [
    a shacl:PropertyShape;
    rdfs:label "waardeEenheid"@nl;
    rdfs:comment "De eenheid waarin de waarde wordt uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Kwantitatiefresultaat.Waardeeenheid>;
    shacl:class <http://def.isotc211.org/iso19103/2005/UnitsOfMeasure#UnitOfMeasure>;
    shacl:description "De eenheid waarin de waarde wordt uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:name "waardeEenheid"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_QuantitativeResult.valueUnit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "waardeRecordType"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het datatype kan bvb Integer zijn of een gestructureerd datatype."@nl;
    rdfs:comment "Datatype van de waarde."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#Kwantitatiefresultaat.Waarderecordtype>;
    shacl:class <http://def.isotc211.org/iso19103/2005/RecordsAndClassMetadata#RecordType>;
    shacl:description "Datatype van de waarde."@nl;
    shacl:maxCount "1";
    shacl:name "waardeRecordType"@nl;
    shacl:path <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_QuantitativeResult.valueRecordType>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19157/2013/DataQualityResult#DQ_QuantitativeResult> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#LogischeconsistentieShape> a shacl:NodeShape;
  rdfs:label "LogischeConsistentie"@nl;
  rdfs:comment "De mate waarin voldaan is aan de logische regels van de datastructuur, attributen en associaties."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19157/2013/DataQuality_2#DQ_LogicalConsistency> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/datakwaliteit/ontwerpstandaard/toolchain4#MaateenheidShape> a shacl:NodeShape;
  rdfs:label "Maateenheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Zie <a href=\"https://www.iso.org/standard/56734.html\">ISO19103 Conceptual Schema Language</a> voor meer info over deze klasse. Of substitueer door<a href=\"https://ci.mines-stetienne.fr/lindt/v4/custom_datatypes#ucumunit\">ucum:ucumunit</a> of <a href=\"https://def.isotc211.org/ontologies/iso19103/2015/MeasureTypes.rdf\">iso:UnitOfMeasure.uomIdentifier</a>) of door een <a href=\"https://qudt.org/schema/qudt/Unit\">qudt:Unit</a> of <a href=\"http://www.w3.org/2004/02/skos/core#Concept\">skos:Concept</a>."@nl;
  rdfs:comment "Eenheid waarin een grootheid woirdt uitgedrukt."@nl;
  shacl:closed false;
