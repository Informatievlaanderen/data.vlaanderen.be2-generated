    rdfs:label "te consumeren via"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv kantoor, telefoon, website…"@nl;
    rdfs:comment "Kanaal waarlangs een agent interageert met een publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Kanaal.TeConsumerenVia>;
    shacl:class <http://purl.org/vocab/cpsv#PublicService>;
    shacl:description "Kanaal waarlangs een agent interageert met een publieke dienstverlening."@nl;
    shacl:name "te consumeren via"@nl;
