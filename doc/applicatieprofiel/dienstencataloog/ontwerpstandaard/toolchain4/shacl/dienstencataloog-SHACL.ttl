    rdfs:label "ruimtelijke dekking"@nl;
    <http://purl.org/vocab/vann/usageNote> "Typisch het werkingsgebied van de verantwoordelijke publieke organisatie."@nl;
    rdfs:comment "Gebied waarin de publieke dienstverlening beschikbaar is."@nl;
