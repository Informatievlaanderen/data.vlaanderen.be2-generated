<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Agent(inDeRolVanDienstverlener/participant)Shape> a shacl:NodeShape;
  rdfs:label "Agent (in de rol van dienstverlener/participant)"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "De naam moet gehaald worden bij de instantie vd subklasse (vb voorkeurnaam bij organisatie, volledigeNaam bij persoon)."@nl;
    rdfs:comment "Naam vd agent."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Agent(inDeRolVanDienstverlener/participant).Naam>;
    shacl:datatype xsd:string;
    shacl:description "Naam vd agent."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het adres moet gehaald worden bij de instantie vd subklasse (vb vestigingsadres bij organisatie, verblijfsadres bij persoon)."@nl;
    rdfs:comment "Adres vd agent."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Agent(inDeRolVanDienstverlener/participant).Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres vd agent."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <http://data.europa.eu/m8g/hasAddress>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wordt uitgevoerd door"@nl;
    <http://purl.org/vocab/vann/usageNote> "Staat los van de rol die de bevoegde instantie speelt, kan een externe aannemer zijn."@nl;
    rdfs:comment "Agent die de publieke dienstverlening verstrekt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Agent(inDeRolVanDienstverlener/participant).WordtUitgevoerdDoor>;
    shacl:class <http://purl.org/vocab/cpsv#PublicService>;
    shacl:description "Agent die de publieke dienstverlening verstrekt."@nl;
    shacl:name "wordt uitgevoerd door"@nl;
    shacl:path <http://data.europa.eu/m8g/serviceProvider>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftParticiperende";
    rdfs:comment "Agent die participeert aan de publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Agent(inDeRolVanDienstverlener/participant).Heeftparticiperende>;
    shacl:class <http://purl.org/vocab/cpsv#PublicService>;
    shacl:description "Agent die participeert aan de publieke dienstverlening."@nl;
    shacl:name "heeftParticiperende";
    shacl:path <https://data.vlaanderen.be/ns/dienst#AgentDienstencataloog.heeftParticiperende>
  ];
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is bezit van"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
