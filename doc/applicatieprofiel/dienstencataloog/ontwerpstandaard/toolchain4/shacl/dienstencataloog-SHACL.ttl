    shacl:description "Kostprijs verbonden aan het gebruik van de publieke dienstverlening."@nl;
    shacl:name "kost"@nl;
    shacl:path <http://data.europa.eu/m8g/hasCost>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Officiële naam van de publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#PubliekeDienstverlening.Naam>;
    shacl:class rdf:langString;
    shacl:description "Officiële naam van de publieke dienstverlening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
