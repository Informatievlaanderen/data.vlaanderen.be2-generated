    shacl:description "Officiële naam vd criteriumVereiste."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Aard vd criteriumvereiste."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Criteriumvereiste.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard vd criteriumvereiste."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft criterium"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb inwoner van de gemeente, meer dan 18 jaar etc."@nl;
    rdfs:comment "Criterium waaraan de gebruiker moet voldoen om recht te hebben op een dienstverlening of om een dienstverlening te mogen gebruiken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Criteriumvereiste.HeeftCriterium>;
