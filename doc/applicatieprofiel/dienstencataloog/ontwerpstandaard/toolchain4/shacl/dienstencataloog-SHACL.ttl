<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#KanaalShape> a shacl:NodeShape;
  rdfs:label "Kanaal"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typische voorbeelden: online, telefoon, kantoor…"@nl;
  rdfs:comment "Kanaal waarlangs een agent kan interageren met een publieke dienstverlening."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "openingsuren"@nl;
    <http://purl.org/vocab/vann/usageNote> "Syntax volgens schema.org voor openingsuren. Bv als een dienstverlening telefonisch bereikbaar is tussen 8 en 20u maandag tot zaterdag and tussen 8 en 18u op zondag wordt dit gecodeerd als Ma-za 08:00-20:00, zo 08:00-18:00."@nl;
    rdfs:comment "Uren waarbinnen de publieke dienstverlening beschikbaar is via het kanaal."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Kanaal.Openingsuren>;
    shacl:datatype rdfs:Literal;
    shacl:description "Uren waarbinnen de publieke dienstverlening beschikbaar is via het kanaal."@nl;
    shacl:maxCount "1";
    shacl:name "openingsuren"@nl;
    shacl:path schema:openingHours
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbaarheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv startdatum zonder einddatum voor dienstverlening die nog actief is of een aanduiding van het seizoen waarin de dienstverlening wordt aangeboden. Een ingevulde einddatum geeft aan wanneer de dienstverlening werd beëindigd. Begin- en einddatum volgens ISO8601 syntax."@nl;
    rdfs:comment "Periode waarin de publieke dienstverlening beschikbaar is via het kanaal."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Kanaal.Beschikbaarheid>;
    shacl:class schema:OpeningHoursSpecification;
    shacl:description "Periode waarin de publieke dienstverlening beschikbaar is via het kanaal."@nl;
    shacl:name "beschikbaarheid"@nl;
    shacl:path schema:hoursAvailable
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Aard vh kanaal."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Kanaal.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard vh kanaal."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "is bezit van"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Eigenaar vh kanaal waarlangs de dienstverlening wordt aangeboden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Kanaal.IsBezitVan>;
    shacl:class dc:Agent;
    shacl:description "Eigenaar vh kanaal waarlangs de dienstverlening wordt aangeboden."@nl;
    shacl:name "is bezit van"@nl;
    shacl:path <http://data.europa.eu/m8g/ownedBy>
  ], [
    a shacl:PropertyShape;
    rdfs:label "indien benaderd via"@nl;
    <http://purl.org/vocab/vann/usageNote> "De kost kan bv verschillen al naargelang de publieke dienstverlening online of ter plaatse wordt aangesproken."@nl;
    rdfs:comment "Associeert de kost met het kanaal waarlangs de publieke dienstverlening wordt geconsumeerd."@nl;
