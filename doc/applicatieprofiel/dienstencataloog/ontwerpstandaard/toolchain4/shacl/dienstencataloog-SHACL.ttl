<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#BedrijfsgebeurtenisShape> a shacl:NodeShape;
  rdfs:label "Bedrijfsgebeurtenis"@nl;
  rdfs:comment "Situatie of gebeurtenis die een specifieke behoefte of (wettelijke) vereiste vh bedrijf op een bepaald moment in zijn levenscyclus weergeeft welke vervuld kan worden door het consumeren ve bepaalde publieke dienstverlening."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/m8g/BusinessEvent> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#BewijsShape> a shacl:NodeShape;
  rdfs:label "Bewijs"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het kader van publieke dienstverlening gaat het meestal om administratieve documenten of ingevulde aanvraagformulieren. Zonder het nodige Bewijs kan de dienstverlening niet worden afgeleverd. Soms levert de Output van een Publieke Dienstverlening het Bewijs nodig voor een andere Publieke Dienstverlening."@nl;
  rdfs:comment "Elk stuk waarmee kan worden aangetoond dat men aan een CriteriumVereiste voldoet."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "documentatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb template van een administratief document of aanvraagformulier of aanwijzingen voor het invullen ervan."@nl;
    rdfs:comment "Documentatie gerelateerd ah bewiijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Bewijs.Documentatie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Documentatie gerelateerd ah bewiijs."@nl;
    shacl:name "documentatie"@nl;
    shacl:path foaf:page
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Beschrijving vh bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Bewijs.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "Beschrijving vh bewijs."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Officiële naam vh bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Bewijs.Naam>;
    shacl:class rdf:langString;
    shacl:description "Officiële naam vh bewijs."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "taal"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Taal waarin het aangeboden bewijs moet zijn gesteld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Bewijs.Taal>;
    shacl:class skos:Concept;
    shacl:description "Taal waarin het aangeboden bewijs moet zijn gesteld."@nl;
    shacl:name "taal"@nl;
    shacl:path dc:language
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Aard vh bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Bewijs.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard vh bewijs."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "vereist als input"@nl;
    <http://purl.org/vocab/vann/usageNote> "Indien de bewijsstukken afhangen het kanaal waarmee met de publieke dienstverlening wordt geïnterageerd."@nl;
    rdfs:comment "Bewijsstuk dat moeten voorgelegd worden om de publieke dienstverlening te kunnen gebruiken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Bewijs.VereistAlsInput>;
    shacl:class <http://data.europa.eu/m8g/Channel>;
    shacl:description "Bewijsstuk dat moeten voorgelegd worden om de publieke dienstverlening te kunnen gebruiken."@nl;
    shacl:name "vereist als input"@nl;
    shacl:path <http://purl.org/vocab/cpsv#hasInput>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vereist als input"@nl;
    <http://purl.org/vocab/vann/usageNote> "Als de bewijsstukken afhangen het kanaal waarmee met de publieke dienstverlening wordt geïnterageerd gebruiken we de associatie Kanaal-vereistAlsInput-Bewijs."@nl;
    rdfs:comment "Bewijsstuk dat moeten voorgelegd worden om de publieke dienstverlening te kunnen gebruiken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Bewijs.VereistAlsInput>;
    shacl:class <http://purl.org/vocab/cpsv#PublicService>;
    shacl:description "Bewijsstuk dat moeten voorgelegd worden om de publieke dienstverlening te kunnen gebruiken."@nl;
    shacl:name "vereist als input"@nl;
    shacl:path <http://purl.org/vocab/cpsv#hasInput>
  ];
  shacl:targetClass <http://data.europa.eu/m8g/Evidence> .

