    shacl:name "rol"@nl;
    shacl:path <http://data.europa.eu/m8g/role>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Participatie.PubliekeDienstverlening";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Participatie.Participatie.publiekedienstverlening>;
