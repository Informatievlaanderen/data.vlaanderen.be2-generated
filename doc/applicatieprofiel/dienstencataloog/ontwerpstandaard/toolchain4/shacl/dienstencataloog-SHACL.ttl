<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#CriteriumvereisteShape> a shacl:NodeShape;
  rdfs:label "Criteriumvereiste"@nl;
  <http://purl.org/vocab/vann/usageNote> "Niet elke publieke dienstverlening is voor iedereen noodzakelijk of nuttig. Bv werkloosheidsuitkeringen zijn enkel noodzakelijk voor werklozen."@nl;
  rdfs:comment "Criterium dat toelaat te bepalen of een gebruiker recht heeft op een dienstverlening of deze mag gebruiken."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Officiële naam vd criteriumVereiste."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Criteriumvereiste.Naam>;
