    shacl:class <http://data.europa.eu/m8g/Cost>;
    shacl:description "Associeert de kost met het kanaal waarlangs de publieke dienstverlening wordt geconsumeerd."@nl;
    shacl:name "indien benaderd via"@nl;
    shacl:path <http://data.europa.eu/m8g/ifAccessedThrough>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vereist als input"@nl;
    <http://purl.org/vocab/vann/usageNote> "Indien de bewijsstukken afhangen het kanaal waarmee met de publieke dienstverlening wordt geïnterageerd."@nl;
    rdfs:comment "Bewijsstuk dat moeten voorgelegd worden om de publieke dienstverlening te kunnen gebruiken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#Kanaal.VereistAlsInput>;
