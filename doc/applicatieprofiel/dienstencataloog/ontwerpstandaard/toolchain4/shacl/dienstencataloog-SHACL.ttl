<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#PubliekeDienstverleningShape> a shacl:NodeShape;
  rdfs:label "Publieke Dienstverlening"@nl;
  <http://purl.org/vocab/vann/usageNote> "De dienstverlening vormt een aanbod (dat dus niet noodzakelijk wordt gebruikt). Ze houdt niet noodzakelijk het opnemen van een recht in,de dienstverlening kan de gebruiker ook toelaten een verplichting te vervullen."@nl;
  rdfs:comment "Een publieke dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen hiervan."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "verwerkingstijd"@nl;
    <http://purl.org/vocab/vann/usageNote> "De ISO8601 syntax moet worden gebruikt om de duurtijd te noteren. Bvb 5 jaar is P5Y, 1 maand is P1M."@nl;
    rdfs:comment "Geschatte tijd nodig om de publieke dienstverlening af te leveren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#PubliekeDienstverlening.Verwerkingstijd>;
    shacl:datatype xsd:string;
    shacl:description "Geschatte tijd nodig om de publieke dienstverlening af te leveren."@nl;
    shacl:maxCount "1";
    shacl:name "verwerkingstijd"@nl;
    shacl:path <http://data.europa.eu/m8g/processingTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv commerciële naam, informele naam…"@nl;
    rdfs:comment "Andere naam waaronder de dienstverlening bekend is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#PubliekeDienstverlening.AlternatieveNaam>;
    shacl:class rdf:langString;
    shacl:description "Andere naam waaronder de dienstverlening bekend is."@nl;
    shacl:name "alternatieve naam"@nl;
    shacl:path skos:altLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Beschrijving zoals ze zichtbaar voor de gebruikers van de dienstencataloog. Voorkeur gaat naar gedetailleerde beschrijvingen."@nl;
    rdfs:comment "Beschrijving vd publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#PubliekeDienstverlening.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "Beschrijving vd publieke dienstverlening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    <http://purl.org/vocab/vann/usageNote> "Verschillend van de informatie waarmee de publieke organisatie kan worden gecontacteerd."@nl;
    rdfs:comment "Informatie waarmee de publieke dienstverlening kan worden gecontacteerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstencataloog/ontwerpstandaard/toolchain4#PubliekeDienstverlening.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie waarmee de publieke dienstverlening kan worden gecontacteerd."@nl;
    shacl:maxCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path <http://data.europa.eu/m8g/hasContactPoint>
  ], [
    a shacl:PropertyShape;
    rdfs:label "kost"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Kostprijs verbonden aan het gebruik van de publieke dienstverlening."@nl;
