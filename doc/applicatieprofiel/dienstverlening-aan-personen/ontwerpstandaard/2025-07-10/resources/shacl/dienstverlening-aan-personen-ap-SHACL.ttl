<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#AandoeningShape> a shacl:NodeShape;
  rdfs:label "Aandoening"@nl;
  rdfs:comment "Toestand waarbij het lichaam afwijkt van zijn gezonde toestand. Dit kan zowel lichamelijk of psychisch zijn."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "actief"@nl;
    rdfs:comment "Mate waarin de Aandoening al dan niet aanwezig is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Aandoening.Actief>;
    shacl:datatype xsd:boolean;
    shacl:description "Mate waarin de Aandoening al dan niet aanwezig is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "actief"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand/#Aandoening.actief>
  ], [
    a shacl:PropertyShape;
    rdfs:label "diagnosedatum"@nl;
    rdfs:comment "Datum waarop de aandoening is vastgesteld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Aandoening.Diagnosedatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de aandoening is vastgesteld."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "diagnosedatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand/#Aandoening.diagnosedatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van de vastgestelde aandoening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Aandoening.Naam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van de vastgestelde aandoening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Categorie waartoe een aandoening behoord."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Aandoening.Type>;
    shacl:class skos:Concept;
    shacl:description "Categorie waartoe een aandoening behoord."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/gezondheidstoestand/#Aandoening> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#AandoeningtypeShape> a shacl:NodeShape;
  rdfs:label "Aandoeningtype"@nl;
