  rdfs:label "Tijdschema"@nl;
  <http://purl.org/vocab/vann/usageNote> "Tijdstippen (meervoud) ipv tijdstip (enkelvoud),het gaat maw over iets (bv vergadering,taak,gebeurtenis) dat herhaaldelijk plaatsvindt,typisch volgens een regelmatig patroon (bv repetitie elke vrijdag)."@nl;
