<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#PubliekeDienstverlening(consumptie)Shape> a shacl:NodeShape;
  rdfs:label "Publieke Dienstverlening (consumptie)"@nl;
  <http://purl.org/vocab/vann/usageNote> "Aanknopingspunt voor de datapunten die te maken hebben met de deelname aan een welbepaald Dienstaanbod. Op dit niveau brengt men de afnemers van de dienst in kaart, hun rollen, alsook de specifieke modaliteiten van de dienstverlening t.o.v. de afnemers."@nl;
  rdfs:comment "Het besteden aan of het gebruik van goederen en diensten voor behoeftebevrediging."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "dienstaanbod"@nl;
    rdfs:comment "Linkt een bepaalde consumptie van een dienstverlening (een transactie) met het product uit de dienstencatalogus."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#PubliekeDienstverlening(consumptie).Dienstaanbod>;
    shacl:class <http://purl.org/vocab/cpsv#PublicService>;
    shacl:description "Linkt een bepaalde consumptie van een dienstverlening (een transactie) met het product uit de dienstencatalogus."@nl;
    shacl:maxCount 1;
    shacl:name "dienstaanbod"@nl;
    shacl:path <https://data.vlaanderen.be/ns/transactie#isInstantieVan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "participatie"@nl;
    rdfs:comment "Verwijst naar de afnemers van de dienst, inclusief hun respectieve rollen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#PubliekeDienstverlening(consumptie).Participatie>;
    shacl:class <http://data.europa.eu/m8g/Participation>;
    shacl:description "Verwijst naar de afnemers van de dienst, inclusief hun respectieve rollen."@nl;
    shacl:name "participatie"@nl;
    shacl:path prov:qualifiedAssociation
  ];
  shacl:targetClass <http://purl.org/vocab/cpsv#PublicService> .

