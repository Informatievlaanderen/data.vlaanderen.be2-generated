    a shacl:PropertyShape;
    rdfs:label "frequentie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uit te drukken als een interval volgens iso 8601, bv P1W betekent wekelijks, P2W tweewekelijks, P1D dagelijks..."@nl;
    rdfs:comment "Frequentie waarmee het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Tijdschema.Frequentie>;
    shacl:datatype xsd:string;
    shacl:description "Frequentie waarmee het plaatsvindt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "frequentie"@nl;
    shacl:path schemas:repeatFrequency
  ], [
    a shacl:PropertyShape;
    rdfs:label "per dag"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik de URI's van schema.org, bv https://schema.org/Monday voor maandag. Deze verwijzen door naar Wikidata waar ook de Nederlandse vertaling te vinden is, bv http://www.wikidata.org/entity/Q105 voor maandag."@nl;
    rdfs:comment "Dagen van de week waarop het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Tijdschema.PerDag>;
    shacl:datatype xsd:anyURI;
    shacl:description "Dagen van de week waarop het plaatsvindt."@nl;
    shacl:name "per dag"@nl;
    shacl:path schemas:byDay
  ], [
    a shacl:PropertyShape;
    rdfs:label "per dag van de maand"@nl;
    rdfs:comment "Dagen van de maand waarop het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Tijdschema.PerDagVanDeMaand>;
    shacl:datatype xsd:integer;
    shacl:description "Dagen van de maand waarop het plaatsvindt."@nl;
    shacl:name "per dag van de maand"@nl;
    shacl:path schemas:byMonthDay
  ], [
    a shacl:PropertyShape;
    rdfs:label "per maand"@nl;
    rdfs:comment "Maanden van het jaar waarop het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Tijdschema.PerMaand>;
    shacl:datatype xsd:integer;
    shacl:description "Maanden van het jaar waarop het plaatsvindt."@nl;
    shacl:name "per maand"@nl;
    shacl:path schemas:byMonth
  ], [
    a shacl:PropertyShape;
    rdfs:label "per setpositie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv als iets maandelijks plaatsvindt op maandag om te zeggen dat het bv de eerste maandag is vd maand. Frequentie is dan maandelijks, perDag is Maandag en de perSetpositie is dan 1. Ook negatieve cijfers zijn mogelijk, bv -1 zou aangeven dat het op de laatste maandag vd maand plaatsvindt."@nl;
    rdfs:comment "N-de keer dat iets plaatsvindt uit de verzameling van mogelijke tijdstippen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Tijdschema.PerSetpositie>;
    shacl:datatype xsd:integer;
    shacl:description "N-de keer dat iets plaatsvindt uit de verzameling van mogelijke tijdstippen."@nl;
    shacl:maxCount "1";
    shacl:name "per setpositie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#perSetpositie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "startdatum"@nl;
    rdfs:comment "Datum vanaf wanneer het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Tijdschema.Startdatum>;
    shacl:datatype xsd:date;
    shacl:description "Datum vanaf wanneer het plaatsvindt."@nl;
    shacl:maxCount "1";
    shacl:name "startdatum"@nl;
    shacl:path schemas:startDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "starttijd"@nl;
    rdfs:comment "Tijdstip waarop het start."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Tijdschema.Starttijd>;
    shacl:datatype xsd:time;
    shacl:description "Tijdstip waarop het start."@nl;
    shacl:maxCount "1";
    shacl:name "starttijd"@nl;
    shacl:path schemas:startTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitzonderingsdatum"@nl;
    rdfs:comment "Datums waarop het uitzonderlijk niet plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Tijdschema.Uitzonderingsdatum>;
    shacl:datatype xsd:date;
    shacl:description "Datums waarop het uitzonderlijk niet plaatsvindt."@nl;
    shacl:name "uitzonderingsdatum"@nl;
    shacl:path schemas:exceptDate
  ];
  shacl:targetClass schemas:Schedule .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#TimeShape> a shacl:NodeShape;
  rdfs:label "Time";
  shacl:closed false;
  shacl:targetClass xsd:time .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#ToedieningtypeShape> a shacl:NodeShape;
  rdfs:label "Toedieningtype"@nl;
  rdfs:comment "De wijze waarop een bepaald type medicatie toegediend wordt."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#UitgangregelingShape> a shacl:NodeShape;
  rdfs:label "Uitgangregeling"@nl;
  rdfs:comment "Set van afspraken en regels die zijn opgesteld om het uitgaansgedrag van dienstafnemers te reguleren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "juridisch werk"@nl;
    rdfs:comment "Juridisch Werk dat de Uitgangregeling staaft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Uitgangregeling.JuridischWerk>;
    shacl:class <https://data.vlaanderen.be/ns/wetgeving#JuridischWerk>;
    shacl:description "Juridisch Werk dat de Uitgangregeling staaft."@nl;
    shacl:name "juridisch werk"@nl;
    shacl:path <http://data.europa.eu/m8g/hasSupportingEvidence>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ophaler"@nl;
    rdfs:comment "De Agent die verantwoordelijk is voor een bepaalde ophaling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Uitgangregeling.Ophaler>;
    shacl:class dc:Agent;
    shacl:description "De Agent die verantwoordelijk is voor een bepaalde ophaling."@nl;
    shacl:maxCount "1";
    shacl:name "ophaler"@nl;
    shacl:path prov:agent
  ], [
    a shacl:PropertyShape;
    rdfs:label "plan"@nl;
    rdfs:comment "Kalender waarmee Uitgangregeling in de tijd vastgelegd kan worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Uitgangregeling.Plan>;
    shacl:class schemas:Schedule;
    shacl:description "Kalender waarmee Uitgangregeling in de tijd vastgelegd kan worden."@nl;
    shacl:maxCount "1";
    shacl:name "plan"@nl;
    shacl:path prov:atTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "participatie"@nl;
    rdfs:comment "De Participatie waarop de Uitgangregeling van toepassing is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Uitgangregeling.Participatie>;
    shacl:class <http://data.europa.eu/m8g/Participation>;
    shacl:description "De Participatie waarop de Uitgangregeling van toepassing is."@nl;
    shacl:maxCount 1;
    shacl:name "participatie"@nl;
    shacl:path prov:qualifiedAssociation
  ];
  shacl:targetClass prov:Association .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#UriShape> a shacl:NodeShape;
  rdfs:label "URI";
  shacl:closed false;
  shacl:targetClass xsd:anyURI .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#VestigingShape> a shacl:NodeShape;
  rdfs:label "Vestiging"@nl;
  <http://purl.org/vocab/vann/usageNote> "Meestal zal de vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten,bv een virtueel kantoor met bijbehorend postnummer en telefonische receptie."@nl;
  rdfs:comment "Een kantoor of ander pand waar een organisatie gevestigd is. Organisaties kunnen over meerdere vestigingen verspreid zijn en vestigingen kunnen op meerdere locaties slaan."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Vestiging te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Vestiging.Contactinfo>;
    shacl:class <http://data.europa.eu/m8g/ContactPoint>;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Vestiging te contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path <http://data.europa.eu/m8g/contactPoint>
  ], [
    a shacl:PropertyShape;
    rdfs:label "organisatie"@nl;
    rdfs:comment "Organisatie verantwoordelijk voor de Vestiging."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/dienstverlening-aan-personen/ontwerpstandaard/2025-07-10#Vestiging.Organisatie>;
    shacl:class org:Organization;
    shacl:description "Organisatie verantwoordelijk voor de Vestiging."@nl;
    shacl:maxCount 1;
    shacl:name "organisatie"@nl;
    shacl:path org:siteOf
  ];
  shacl:targetClass org:Site .
