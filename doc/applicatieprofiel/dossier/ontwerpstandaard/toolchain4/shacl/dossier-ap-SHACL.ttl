<https://data.test-vlaanderen.be/doc/applicatieprofiel/dossier/ontwerpstandaard/toolchain4/ActiviteitShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/dossier/ontwerpstandaard/toolchain4#Activiteit.Naam>;
    shacl:datatype xsd:string;
    shacl:description "De naam van de activiteit."@nl;
