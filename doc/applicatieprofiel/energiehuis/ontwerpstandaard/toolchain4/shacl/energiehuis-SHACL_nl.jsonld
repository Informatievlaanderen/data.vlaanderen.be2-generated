    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een financiële tegemoetkoming of subsidie die wordt verstrekt om een specifieke activiteit of investering te ondersteunen en te stimuleren."
      }
    ],
