  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/ontwerpstandaard/toolchain4#AdviesverleningShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Advies kan verleend worden aan alle burgers in het werkingsgebied van het energiehuis, ongeacht de inkomenscategorie."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Dienstverlening op maat. Dit kan in de vorm van een huisbezoek, een uitgebreide intake, advies op afspraak aan het loket, uitgebreide antwoorden op mail, etc."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Adviesverlening"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
