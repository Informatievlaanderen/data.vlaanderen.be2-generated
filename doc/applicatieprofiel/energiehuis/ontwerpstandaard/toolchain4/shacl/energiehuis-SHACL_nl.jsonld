    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Voor energiehuizen omvat dit minstens de basistaken (informeren, begeleiden en adviseren/ondersteunen van burgers) zoals bepaald door de Vlaamse Regering in 2018.Daarnaast is ook kredietverstrekking een basistaak van de energiehuizen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een publieke dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen hiervan."
      }
    ],
