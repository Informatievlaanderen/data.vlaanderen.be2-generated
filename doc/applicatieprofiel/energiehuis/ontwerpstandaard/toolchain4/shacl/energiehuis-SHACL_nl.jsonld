    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Om erkend te worden moeten ze beschikken over rechtspersoonlijkheid, beschikken over de nodige kennis en expertise alsook over de erkenning van de bevoegde diensten om als kredietgever op te treden en voorgesteld zijn door de gemeenten van hun werkingsgebied."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een instantie die op het niveau van één of meer gemeente(n) diensten inzake energie en woningkwaliteit aanbiedt aan de klant, en als dusdanig erkend door de Vlaamse overheid."
      }
    ],
