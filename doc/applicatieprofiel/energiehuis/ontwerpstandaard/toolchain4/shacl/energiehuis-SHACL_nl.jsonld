  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/ontwerpstandaard/toolchain4#InteresseopwekkingShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Dit kan bijvoorbeeld gaan over het verspreiden van flyers, deelnemen aan informatiemarkten, en het onderhouden van een informatieve website om een breed publiek te informeren over de diensten van een energiehuis."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Het verstrekken van algemene, laagdrempelige kennis en richtlijnen via diverse middelen zoals websites, video’s, brochures op grote schaal. Interesse opwekken is gericht op het creëren van bewustwording en het trekken van de aandacht van een breed publiek, zodat zij op de hoogte zijn van iets."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "InteresseOpwekking"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_50"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/energiehuis#InteresseOpwekking"
      }
    ]
