    rdfs:comment "Dag van de week waarvoor de openingsuren geldig zijn."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Openingsurenspecificatie.DagVanWeek>;
