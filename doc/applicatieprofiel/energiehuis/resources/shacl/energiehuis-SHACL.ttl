    shacl:path <https://data.vlaanderen.be/ns/energiehuis#Project.fase>
  ], [
    a shacl:PropertyShape;
    rdfs:label "financiering"@nl;
    rdfs:comment "Project waarvoor de Financiering wordt gebruikt."@nl;
