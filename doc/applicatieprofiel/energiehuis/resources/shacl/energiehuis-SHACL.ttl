<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#BegeleidingShape> a shacl:NodeShape;
  rdfs:label "Begeleiding"@nl;
  <http://purl.org/vocab/vann/usageNote> "De informatieoverdracht in deze fase is strikt persoonlijk, als ook pandgebonden, en niet vrij beschikbaar voor alle burgers. Deze fase is de overkoepelende fase voor 3 subfases: projectontwerp, uitvoering en nazorg."@nl;
  rdfs:comment "Het ondersteunen van een Agent door stapsgewijs te helpen bij het ondernemen van acties of het doorlopen van langdurige trajecten, al dan niet met regelmatige contactmomenten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "De specifieke categorie of vorm van ondersteuning die wordt geboden aan een Agent."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Begeleiding.Type>;
    shacl:class skos:Concept;
    shacl:description "De specifieke categorie of vorm van ondersteuning die wordt geboden aan een Agent."@nl;
    shacl:name "type"@nl;
    shacl:path <https://data.vlaanderen.be/ns/energiehuis#Begeleiding.type>
  ], [
    a shacl:PropertyShape;
    rdfs:label "begeleider"@nl;
    <http://purl.org/vocab/vann/usageNote> "Doorgaans een Persoon van of in naam van het Energiehuis."@nl;
    rdfs:comment "Agent die de Begeleiding uitvoert."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Begeleiding.Begeleider>;
    shacl:class dc:Agent;
    shacl:description "Agent die de Begeleiding uitvoert."@nl;
    shacl:name "begeleider"@nl;
    shacl:path <https://data.vlaanderen.be/ns/energiehuis#begeleider>
  ], [
    a shacl:PropertyShape;
    rdfs:label "fase"@nl;
    rdfs:comment "Fase waarin de Begeleiding zich bevindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Begeleiding.Fase>;
    shacl:class skos:Concept;
    shacl:description "Fase waarin de Begeleiding zich bevindt."@nl;
    shacl:maxCount "1";
    shacl:name "fase"@nl;
    shacl:path <https://data.vlaanderen.be/ns/energiehuis#Begeleiding.fase>
  ], [
    a shacl:PropertyShape;
    rdfs:label "begeleidingVan"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb een Renovatieproject."@nl;
    rdfs:comment "Project dat wordt begeleid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Begeleiding.Begeleidingvan>;
    shacl:class dbo:Project;
    shacl:description "Project dat wordt begeleid."@nl;
    shacl:maxCount 1;
    shacl:name "begeleidingVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/energiehuis#begeleidingVan>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/energiehuis#Begeleiding> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#ConceptShape> a shacl:NodeShape;
  rdfs:label "Concept"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bedoeld om kennis te organiseren, bvb in een codelijst of taxonomie (een zgn ConceptScheme). Zie <a href=\"https://www.w3.org/TR/skos-reference/\">SKOS</a> voor meer informatie."@nl;
