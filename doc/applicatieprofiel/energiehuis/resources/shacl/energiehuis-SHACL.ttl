    shacl:name "verwijst naar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#verwijstNaar>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#AdviesverleningShape> a shacl:NodeShape;
  rdfs:label "Adviesverlening"@nl;
  <http://purl.org/vocab/vann/usageNote> "Advies kan verleend worden aan alle burgers in het werkingsgebied van het energiehuis, ongeacht de inkomenscategorie."@nl;
  rdfs:comment "Dienstverlening op maat. Dit kan in de vorm van een huisbezoek, een uitgebreide intake, advies op afspraak aan het loket, uitgebreide antwoorden op mail, etc."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voor Energiehuizen kan dit bijvoorbeeld betrekking hebben op kennisdeling rond de Mijn VerbouwPremie of Mijn VerbouwLening, afhankelijk van bepaalde informatie over de Agent, maar zonder noodzakelijk verdere vervolgstappen. Meestal is dit op afspraak."@nl;
    rdfs:comment "De specifieke categorie of vorm van advies die wordt geboden aan een Agent."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Adviesverlening.Type>;
    shacl:class skos:Concept;
    shacl:description "De specifieke categorie of vorm van advies die wordt geboden aan een Agent."@nl;
    shacl:name "type"@nl;
    shacl:path <https://data.vlaanderen.be/ns/energiehuis#Adviesverlening.type>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adviesverlener"@nl;
    <http://purl.org/vocab/vann/usageNote> "Doorgaans een Persoon van of in naam van het Energiehuis."@nl;
    rdfs:comment "De Agent die het advies verleent."@nl;
