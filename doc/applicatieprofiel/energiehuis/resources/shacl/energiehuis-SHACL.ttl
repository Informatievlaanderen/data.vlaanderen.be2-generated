    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Openingsurenspecificatie.GeldigTot>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum tot wanneer de opgegeven openingsuren gelden."@nl;
    shacl:maxCount "1";
