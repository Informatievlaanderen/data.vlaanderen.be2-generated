<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "familienaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Persoon.Familienaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "familienaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "gegeven naam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Persoon.GegevenNaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    shacl:minCount "1";
    shacl:name "gegeven naam"@nl;
    shacl:path foaf:givenName
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactpunt"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Persoon te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Persoon.Contactpunt>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Persoon te contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactpunt"@nl;
    shacl:path schema:contactPoint
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#PlaatsShape> a shacl:NodeShape;
  rdfs:label "Plaats"@nl;
  rdfs:comment "Een ruimtelijk gebied of benoemde plaats."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "plaatsnaam"@nl;
    rdfs:comment "Naam van de plaats of van het gebied."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Plaats.Plaatsnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van de plaats of van het gebied."@nl;
    shacl:minCount "1";
    shacl:name "plaatsnaam"@nl;
    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "Geometrie van de plaats of het gebied."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Plaats.Geometrie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "Geometrie van de plaats of het gebied."@nl;
    shacl:maxCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass dc:Location .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#PlaatsbezoekShape> a shacl:NodeShape;
  rdfs:label "Plaatsbezoek"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dit is bv. een bezoek aan een woning in het kader van bv. een renovatiebegeleiding, een advies of het bijwonen van een vergadering van de Vereniging van Mede eigenaars van een appartementsgebouw. We tellen hier zowel het eerste huisbezoek als eventuele opvolgbezoeken of opvolgvergaderingen mee."@nl;
  rdfs:comment "Bezoek van een fysieke locatie door een deskundige met als doel dienstverlening."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb het Adres of de Plaats."@nl;
    rdfs:comment "Locatie waar het Plaatsbezoek plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Plaatsbezoek.Locatie>;
    shacl:class prov:Location;
    shacl:description "Locatie waar het Plaatsbezoek plaatsvindt."@nl;
    shacl:minCount "1";
    shacl:name "locatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/energiehuis#locatie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/energiehuis#Plaatsbezoek> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#PremieShape> a shacl:NodeShape;
  rdfs:label "Premie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een geldbedrag dat wordt toegekend aan huiseigenaren, huurders of bedrijven om hen aan te moedigen energiebesparende maatregelen of duurzame energieoplossingen te implementeren."@nl;
  rdfs:comment "Een financiële tegemoetkoming of subsidie die wordt verstrekt om een specifieke activiteit of investering te ondersteunen en te stimuleren."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/energiehuis#Premie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#ProfessioneelcontactShape> a shacl:NodeShape;
  rdfs:label "ProfessioneelContact"@nl;
  <http://purl.org/vocab/vann/usageNote> "Met professionele contacten bedoelen we alle contacten die een Energiehuis heeft met partnerorganisaties, aannemers en andere partijen die geen klanten zijn."@nl;
  rdfs:comment "Een interactie of verbinding tussen individuen of organisaties binnen een werkcontext."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/energiehuis#ProfessioneelContact> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#ProjectShape> a shacl:NodeShape;
  rdfs:label "Project"@nl;
  rdfs:comment "Tijdelijke onderneming om vastgestelde doelen te bereiken."@nl;
