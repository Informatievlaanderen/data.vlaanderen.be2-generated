    shacl:class skos:Concept;
    shacl:description "Functie waarvoor de gebouweenheid in de realiteit (zoals vastgesteld op het terrein) gebruikt wordt."@nl;
    shacl:maxCount "1";
    shacl:name "functie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#functie>
  ], [
