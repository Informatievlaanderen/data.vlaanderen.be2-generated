    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "publiekeDienstverlening"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dienst#Participatie.publiekeDienstverlening>
  ], [
    a shacl:PropertyShape;
    rdfs:label "agent"@nl;
    rdfs:comment "De agent die deelneemt aan de dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Participatie.Agent>;
    shacl:class dc:Agent;
