<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#ContactShape> a shacl:NodeShape;
  rdfs:label "Contact"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hiermee bedoelen we elke interactie (telefoongesprek, hoe kort ook, verzonden e-mail, formulier, loket bezoek, huisbezoek, ...), inclusief interacties die niet in een CRM geregistreerd worden, maar bijvoorbeeld wel via streepjes geteld worden."@nl;
  rdfs:comment "Elke interactie tussen een organisatie en haar klanten, waarbij informatie, ondersteuning of diensten worden uitgewisseld."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "onderwerp"@nl;
    rdfs:comment "Het specifieke thema of de kwestie die tijdens het Contact wordt besproken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Contact.Onderwerp>;
    shacl:class skos:Concept;
    shacl:description "Het specifieke thema of de kwestie die tijdens het Contact wordt besproken."@nl;
    shacl:name "onderwerp"@nl;
    shacl:path <https://data.vlaanderen.be/ns/energiehuis#Contact.onderwerp>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/energiehuis#Contact> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanschrijfprefix"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb De heer/Mevrouw, Excellentie, Dokter..."@nl;
    rdfs:comment "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Contactinfo.Aanschrijfprefix>;
