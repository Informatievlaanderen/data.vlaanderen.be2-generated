    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiehuis/erkendestandaard/2025-06-19#Gebouweenheid.Status>;
    shacl:class skos:Concept;
    shacl:description "Fase van de levensloop waarin de gebouweenheid zich bevindt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "status"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid.status>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid> .

