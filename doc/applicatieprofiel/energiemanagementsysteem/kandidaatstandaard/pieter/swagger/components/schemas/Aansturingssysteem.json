{
  "title": "Aansturingssysteem",
  "type": "object",
  "description": "Het toestel waarmee iets aangestuurd wordt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Aansturingssysteem)",
      "pattern": "^Aansturingssysteem$"
    },
    "locatie": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Geometrie"
        },
        {
          "$ref": "#/components/schemas/Punt"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Geometrie": "#/components/schemas/Geometrie",
          "Punt": "#/components/schemas/Punt"
        }
      }
    },
    "implementeert": {
      "$ref": "#/components/schemas/Aansturingsprocedure"
    },
    "uitgevoerdeAansturing": {
      "type": "array",
      "description": "Lijst van Aansturing items.",
      "items": {
        "$ref": "#/components/schemas/Aansturing"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Lijst van Systeemtype items.",
      "items": {
        "$ref": "#/components/schemas/Systeemtype"
      },
      "minItems": 1
    },
    "gehostDoor": {
      "type": "array",
      "description": "Lijst van Platform items.",
      "items": {
        "$ref": "#/components/schemas/Platform"
      },
      "minItems": 1
    },
    "heeftDeployment": {
      "type": "array",
      "description": "Lijst van Deployment items.",
      "items": {
        "$ref": "#/components/schemas/Deployment"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "implementeert"
  ]
}