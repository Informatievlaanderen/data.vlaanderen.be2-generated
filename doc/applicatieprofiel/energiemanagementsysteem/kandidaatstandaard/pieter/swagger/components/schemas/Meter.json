{
  "title": "Meter",
  "type": "object",
  "description": "Instrument bedoeld om iets te meten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Meter)",
      "pattern": "^Meter$"
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "verbruiksadres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    },
    "fabrikant": {
      "type": "object",
      "description": "Naam van de fabrikant.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "model": {
      "type": "object",
      "description": "Naam vh model vh Toestel.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "functie": {
      "type": "array",
      "description": "Lijst van Functie items.",
      "items": {
        "$ref": "#/components/schemas/Functie"
      },
      "minItems": 1
    },
    "taak": {
      "type": "array",
      "description": "Lijst van Taak items.",
      "items": {
        "$ref": "#/components/schemas/Taak"
      },
      "minItems": 1
    },
    "type": {
      "$ref": "#/components/schemas/Domeinobjecttype"
    },
    "gehostDoor": {
      "type": "array",
      "description": "Lijst van Platform items.",
      "items": {
        "$ref": "#/components/schemas/Platform"
      },
      "minItems": 1
    },
    "heeftDeployment": {
      "type": "array",
      "description": "Lijst van Deployment items.",
      "items": {
        "$ref": "#/components/schemas/Deployment"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "identificator",
    "verbruiksadres",
    "functie",
    "taak"
  ]
}