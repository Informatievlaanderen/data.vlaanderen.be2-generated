{
  "title": "Object",
  "type": "object",
  "description": "Klasse die instanties van om het even welk type vertegenwoordigt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Object)",
      "pattern": "^Object$"
    },
    "type": {
      "$ref": "#/components/schemas/Domeinobjecttype"
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "identificator"
  ]
}