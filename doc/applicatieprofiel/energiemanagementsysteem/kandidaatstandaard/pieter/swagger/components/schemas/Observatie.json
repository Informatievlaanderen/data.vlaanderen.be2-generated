{
  "title": "Observatie",
  "type": "object",
  "description": "Het vaststellen van de waarde van een bepaald kenmerk van een Object op een bepaald tijdstip of tussen twee tijdstippen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Observatie)",
      "pattern": "^Observatie$"
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "fenomeentijd": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/TemporeleEntiteit"
        },
        {
          "$ref": "#/components/schemas/Moment"
        },
        {
          "$ref": "#/components/schemas/Periode"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "TemporeleEntiteit": "#/components/schemas/TemporeleEntiteit",
          "Moment": "#/components/schemas/Moment",
          "Periode": "#/components/schemas/Periode"
        }
      }
    },
    "resultaat": {
      "$ref": "#/components/schemas/Any"
    },
    "type": {
      "type": "array",
      "description": "Lijst van Observatietype items.",
      "items": {
        "$ref": "#/components/schemas/Observatietype"
      },
      "minItems": 1
    },
    "uitgevoerdDoor": {
      "type": "array",
      "description": "Lijst van Agent items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Persoon"
          },
          {
            "$ref": "#/components/schemas/Organisatie"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Persoon": "#/components/schemas/Persoon",
            "Organisatie": "#/components/schemas/Organisatie"
          }
        }
      },
      "minItems": 1
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "geobserveerdKenmerk": {
      "$ref": "#/components/schemas/ObserveerbaarKenmerk"
    },
    "isLidVan": {
      "type": "array",
      "description": "Lijst van Observatieverzameling items.",
      "items": {
        "$ref": "#/components/schemas/Observatieverzameling"
      },
      "minItems": 1
    },
    "uitgevoerdMetSensor": {
      "$ref": "#/components/schemas/Sensor"
    },
    "gebruikteProcedure": {
      "type": "array",
      "description": "Lijst van Observatieprocedure items.",
      "items": {
        "$ref": "#/components/schemas/Observatieprocedure"
      },
      "minItems": 1
    },
    "geobserveerdObject": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Object"
        },
        {
          "$ref": "#/components/schemas/Toestel"
        },
        {
          "$ref": "#/components/schemas/Aansluiting"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Object": "#/components/schemas/Object",
          "Toestel": "#/components/schemas/Toestel",
          "Aansluiting": "#/components/schemas/Aansluiting"
        }
      }
    }
  },
  "required": [
    "@type",
    "fenomeentijd",
    "resultaat",
    "geobserveerdKenmerk",
    "uitgevoerdMetSensor",
    "geobserveerdObject"
  ]
}