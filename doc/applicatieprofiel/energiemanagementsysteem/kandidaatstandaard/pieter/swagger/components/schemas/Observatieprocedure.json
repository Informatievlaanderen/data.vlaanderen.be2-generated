{
  "title": "Observatieprocedure",
  "type": "object",
  "description": "Een workflow, protocol, plan, algoritme, of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Observatieprocedure)",
      "pattern": "^Observatieprocedure$"
    },
    "specificatie": {
      "type": "array",
      "description": "Lijst van URI items.",
      "items": {
        "type": "object",
        "description": "Verwijzing naar een document dat de Aansturingsprocedure beschrijft.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "@id"
        ]
      },
      "minItems": 1
    },
    "input": {
      "type": "array",
      "description": "Lijst van Input items.",
      "items": {
        "$ref": "#/components/schemas/Input"
      },
      "minItems": 1
    },
    "output": {
      "type": "array",
      "description": "Lijst van Output items.",
      "items": {
        "$ref": "#/components/schemas/Output"
      },
      "minItems": 1
    },
    "parameter": {
      "type": "array",
      "description": "Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Lijst van Aansturingsproceduretype items.",
      "items": {
        "$ref": "#/components/schemas/Aansturingsproceduretype"
      },
      "minItems": 1
    },
    "geïMplementeerdMet": {
      "type": "array",
      "description": "Lijst van Aansturingssysteem items.",
      "items": {
        "$ref": "#/components/schemas/Aansturingssysteem"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
