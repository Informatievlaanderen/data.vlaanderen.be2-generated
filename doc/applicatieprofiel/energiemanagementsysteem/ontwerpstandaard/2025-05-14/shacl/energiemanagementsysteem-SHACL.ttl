    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Toestel.Model>;
    shacl:datatype rdf:langString;
    shacl:description "Naam vh model vh Toestel."@nl;
    shacl:maxCount "1";
    shacl:name "model"@nl;
    shacl:path <https://saref.etsi.org/core/hasModel>
  ], [
