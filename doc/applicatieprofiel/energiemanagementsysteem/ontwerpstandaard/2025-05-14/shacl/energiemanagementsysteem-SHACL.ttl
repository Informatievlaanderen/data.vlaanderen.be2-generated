<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#AansluitingShape> a shacl:NodeShape;
  rdfs:label "Aansluiting"@nl;
  rdfs:comment "Object dat de aansluiting van een kabel of leiding aan een gebouw of een ander fysiek object beschrijft."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "Geometrie van de Knoop."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansluiting.Geometrie>;
    shacl:class <http://www.opengis.net/ont/sf#Point>;
    shacl:description "Geometrie van de Knoop."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <https://vocab.belgif.be/ns/network#Node.geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres van de aansluiting."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansluiting.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres van de aansluiting."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#address>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toebehorentype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Aansluiting is een specialisatie van Toebehoren waarbij het type Toebehoren \"aansluitingspunt\" is."@nl;
    rdfs:comment "Aard van het Toebehoren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansluiting.Toebehorentype>;
    shacl:class skos:Concept;
    shacl:description "Aard van het Toebehoren."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "toebehorentype"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#Connection.appurtenanceType>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Identificator van het element."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansluiting.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het element."@nl;
    shacl:maxCount "1";
    shacl:name "identificator"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afleverpunt"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebouweenheid is 1:1 gelinkt aan een meter of verbruiksplaats van de dienst die geleverd wordt en dus aan een individuele observatie. Een gebouw kan gelinkt zijn aan meerdere gebouweenheden, bv bij een appartementsgebouw."@nl;
    rdfs:comment "Aard van de aansluiting waar een voorziening (electriciteit, water, ...) of dienst geleverd wordt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansluiting.Afleverpunt>;
    shacl:class skos:Concept;
    shacl:description "Aard van de aansluiting waar een voorziening (electriciteit, water, ...) of dienst geleverd wordt."@nl;
    shacl:maxCount "1";
    shacl:name "afleverpunt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/nutsvoorzieningen/meters#afleverpunt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "inNetwerk"@nl;
    rdfs:comment "Nutsvoorzieningnetwerk waartoe het element behoort."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansluiting.Innetwerk>;
    shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityNetwork>;
    shacl:description "Nutsvoorzieningnetwerk waartoe het element behoort."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "inNetwerk"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#inNetwork>
  ];
  shacl:targetClass <https://vocab.belgif.be/ns/utility-services#Connection> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#AansturingShape> a shacl:NodeShape;
  rdfs:label "Aansturing"@nl;
  rdfs:comment "Activiteit waarbij de waarde van een kenmerk van een Object wordt aangepast mbv een Aansturingssysteem."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Identificator van de Aansturing."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturing.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van de Aansturing."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Het soort Aansturing."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturing.Type>;
    shacl:class skos:Concept;
    shacl:description "Het soort Aansturing."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "resultaat"@nl;
    rdfs:comment "De waarde van het aangestuurdKenmerk als resultaat van de Aansturing."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturing.Resultaat>;
    shacl:class rdfs:Resource;
    shacl:description "De waarde van het aangestuurdKenmerk als resultaat van de Aansturing."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "resultaat"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasResult>
  ], [
    a shacl:PropertyShape;
    rdfs:label "parameter"@nl;
    <http://purl.org/vocab/vann/usageNote> "Verschillend van het aangestuurdKenmerk."@nl;
    rdfs:comment "Fenomeen dat activiteit van de Aansturing beInvloedt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturing.Parameter>;
    shacl:class schemas:StructuredValue;
    shacl:description "Fenomeen dat activiteit van de Aansturing beInvloedt."@nl;
    shacl:name "parameter"@nl;
    shacl:path dbo:influencedBy
  ], [
    a shacl:PropertyShape;
    rdfs:label "resultaattijd"@nl;
    rdfs:comment "Tijdstip waarop het resultaat van de Aansturing werd bekomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturing.Resultaattijd>;
    shacl:class <http://www.w3.org/2006/time#TemporalEntity>;
    shacl:description "Tijdstip waarop het resultaat van de Aansturing werd bekomen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "resultaattijd"@nl;
    shacl:path <http://www.w3.org/ns/sosa/resultTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdDoor"@nl;
    rdfs:comment "Agent die de Aansturing heeft uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturing.Uitgevoerddoor>;
    shacl:class dc:Agent;
    shacl:description "Agent die de Aansturing heeft uitgevoerd."@nl;
    shacl:name "uitgevoerdDoor"@nl;
    shacl:path dc:contributor
  ], [
    a shacl:PropertyShape;
    rdfs:label "aangestuurdKenmerk"@nl;
    rdfs:comment "Kenmerk van het aangestuurdObject dat men aanstuurt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturing.Aangestuurdkenmerk>;
    shacl:class <http://www.w3.org/ns/sosa/Property>;
    shacl:description "Kenmerk van het aangestuurdObject dat men aanstuurt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aangestuurdKenmerk"@nl;
    shacl:path <http://www.w3.org/ns/sosa/actsOnProperty>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruikteProcedure"@nl;
    rdfs:comment "De procedure die bij de Aansturing wordt gevolgd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturing.Gebruikteprocedure>;
    shacl:class <http://www.w3.org/ns/sosa/Procedure>;
    shacl:description "De procedure die bij de Aansturing wordt gevolgd."@nl;
    shacl:name "gebruikteProcedure"@nl;
    shacl:path <http://www.w3.org/ns/sosa/usedProcedure>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aangestuurdObject"@nl;
    rdfs:comment "Object dat wordt aangestuurd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturing.Aangestuurdobject>;
    shacl:class <http://www.w3.org/ns/sosa/FeatureOfInterest>;
    shacl:description "Object dat wordt aangestuurd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aangestuurdObject"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasFeatureOfInterest>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdMetAansturingssysteem"@nl;
    rdfs:comment "Aansturingssysteem waarmee de Aansturing is uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturing.Uitgevoerdmetaansturingssysteem>;
    shacl:class <http://www.w3.org/ns/sosa/Actuator>;
    shacl:description "Aansturingssysteem waarmee de Aansturing is uitgevoerd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "uitgevoerdMetAansturingssysteem"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeByActuator>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Actuation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#AansturingsprocedureShape> a shacl:NodeShape;
  rdfs:label "Aansturingsprocedure"@nl;
  rdfs:comment "Stappen die zijn uitgevoerd om de waarde van het aangestuurdKenmerk te bekomen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "specificatie"@nl;
    rdfs:comment "Verwijzing naar een document dat de Aansturingsprocedure beschrijft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturingsprocedure.Specificatie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Verwijzing naar een document dat de Aansturingsprocedure beschrijft."@nl;
    shacl:name "specificatie"@nl;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de Aansturingsprocedure."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturingsprocedure.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de Aansturingsprocedure."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "input"@nl;
    rdfs:comment "Verwijzing naar de Input die de procedure vereist."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturingsprocedure.Input>;
    shacl:class <http://www.w3.org/ns/ssn/Input>;
    shacl:description "Verwijzing naar de Input die de procedure vereist."@nl;
    shacl:name "input"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasInput>
  ], [
    a shacl:PropertyShape;
    rdfs:label "output"@nl;
    rdfs:comment "Verwijzing naar de Output die de procedure genereert."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturingsprocedure.Output>;
    shacl:class <http://www.w3.org/ns/ssn/Output>;
    shacl:description "Verwijzing naar de Output die de procedure genereert."@nl;
    shacl:name "output"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasOutput>
  ], [
    a shacl:PropertyShape;
    rdfs:label "parameter"@nl;
    <http://purl.org/vocab/vann/usageNote> "Verschillend van het aangestuurdKenmerk."@nl;
    rdfs:comment "Fenomeen dat uitvoering van de Aansturingsprocedure beInvloedt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturingsprocedure.Parameter>;
    shacl:class schemas:StructuredValue;
    shacl:description "Fenomeen dat uitvoering van de Aansturingsprocedure beInvloedt."@nl;
    shacl:name "parameter"@nl;
    shacl:path dbo:influencedBy
  ], [
    a shacl:PropertyShape;
    rdfs:label "geïmplementeerdMet"@nl;
    rdfs:comment "Aansturingssysteem waarmee de Aansturingsprocedure is of moet worden uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Aansturingsprocedure.Geïmplementeerdmet>;
    shacl:class <http://www.w3.org/ns/sosa/Actuator>;
    shacl:description "Aansturingssysteem waarmee de Aansturingsprocedure is of moet worden uitgevoerd."@nl;
    shacl:name "geïmplementeerdMet"@nl;
    shacl:path <http://www.w3.org/ns/sosa/implementedBy>
  ];
