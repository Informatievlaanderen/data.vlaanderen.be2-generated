  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Platform> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#ProcedureShape> a shacl:NodeShape;
  rdfs:label "Procedure"@nl;
  <http://purl.org/vocab/vann/usageNote> "In deze context het uitvoeren van Observaties, Bemonstering of de Bediening van Actuators. Neemt in praktijk de vorm aan van een workflow, protocol, plan, algoritme, berekeningswijze etc."@nl;
  rdfs:comment "Vastgelegde of officiële manier om iets te doen."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/sosa/Procedure> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#PuntShape> a shacl:NodeShape;
  rdfs:label "Punt"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dimensie is te verstaan in wiskundige zin: het minimum aantal coördinaten nodig om een willekeurig punt voor te stellen dat deel uitmaakt van de primitieve. In het coördinaatsysteem dat door een Punt zelf gevormd wordt is geen enkele coördinaat nodig, er is immers maar 1 punt. Een Punt heeft daarom geen breedte, lengte of diepte. OPGELET: dat betekent niet dat een Punt geen coördinaten kan hebben in een ander coördinaatysteem, bv xyz-coördinaten in en 3-assig orthogonaal coördinaatsysteem."@nl;
  rdfs:comment "Een 0-dimensionele geometrische primitieve."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#Point> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#SensorShape> a shacl:NodeShape;
  rdfs:label "Sensor"@nl;
  <http://purl.org/vocab/vann/usageNote> "Sensoren genereren een resultaat op basis van een Stimulus, ttz een verandering in de omgeving, of op basis van resultaten van andere Observaties. Ze worden typisch gehost door een Platform. Voorbeelden zijn snelheidsmeters, gyroscopen, barometers, magnetometers gemonteerd op een smart phone. Ook bv het menselijk oog kan beschouwd worden als een Sensor."@nl;
  rdfs:comment "Toestel of Agent (incl Personen of software) waarmee Observaties gemaakt worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:comment "De geometrie van de Sensor."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Sensor.Locatie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "De geometrie van de Sensor."@nl;
    shacl:maxCount "1";
    shacl:name "locatie"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#hasGeometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "implementeert"@nl;
    rdfs:comment "Observatieprocedure die door de Sensor wordt toegepast."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Sensor.Implementeert>;
    shacl:class <http://www.w3.org/ns/sosa/oms/ObservingProcedure>;
    shacl:description "Observatieprocedure die door de Sensor wordt toegepast."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "implementeert"@nl;
    shacl:path <http://www.w3.org/ns/sosa/implements>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdeObservatie"@nl;
    rdfs:comment "Observatie die met de Sensor is uitrgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Sensor.Uitgevoerdeobservatie>;
    shacl:class <http://www.w3.org/ns/sosa/Observation>;
    shacl:description "Observatie die met de Sensor is uitrgevoerd."@nl;
    shacl:name "uitgevoerdeObservatie"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeObservation>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Sensor> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#SysteemShape> a shacl:NodeShape;
  rdfs:label "Systeem"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze componenten kunnen Systemen op zich zijn. In deze context zijn het Systemen die een Observatieprocedure realiseren (typisch een Sensor) of waarmee een Bemonsteringsprocedure wordt uitgevoerd (bv een Boorinstallatie)."@nl;
  rdfs:comment "Samenhangend geheel van componenten die samen één of meer functies vervullen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard vh Systeem."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Systeem.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard vh Systeem."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "gehostDoor"@nl;
    rdfs:comment "Platform waarop het Systeem gehost wordt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Systeem.Gehostdoor>;
    shacl:class <http://www.w3.org/ns/sosa/Platform>;
    shacl:description "Platform waarop het Systeem gehost wordt."@nl;
    shacl:name "gehostDoor"@nl;
    shacl:path <http://www.w3.org/ns/sosa/isHostedBy>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftDeployment"@nl;
    rdfs:comment "De relatie tussen een Systeem en een Deployment om aan te geven dat een Systeem gedeployed is in deze Deployment."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#Systeem.Heeftdeployment>;
    shacl:class <http://www.w3.org/ns/sosa/Deployment>;
    shacl:description "De relatie tussen een Systeem en een Deployment om aan te geven dat een Systeem gedeployed is in deze Deployment."@nl;
    shacl:name "heeftDeployment"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasDeployment>
  ];
  shacl:targetClass <http://www.w3.org/ns/ssn/System> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#TaakShape> a shacl:NodeShape;
  rdfs:label "Taak"@nl;
  rdfs:comment "Doel waarvoor het Toestel is ontworpen (vanuit gebruikersoogpunt)."@nl;
  shacl:closed false;
  shacl:targetClass <https://saref.etsi.org/core/Task> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#TemporeleentiteitShape> a shacl:NodeShape;
  rdfs:label "TemporeleEntiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Die temporele objecten zijn temporele geometrische primitieven zoals Moment of Periode.OPMERKING: Dit datatype is Abstract,gebruik een van de subklassen."@nl;
  rdfs:comment "Abstracte klasse voor temporele objecten."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/2006/time#TemporalEntity> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#ToebehorenShape> a shacl:NodeShape;
  rdfs:label "Toebehoren"@nl;
  <http://purl.org/vocab/vann/usageNote> "Kan als Nutsvoorzieningknoop op zichzelf staan maar is dikwijls gemonteerd op een drager (de Nutsvoorzieningknoopcontainter). Bvb inspectieluik,hydrant,splitter,meter,pomp etc."@nl;
  rdfs:comment "Fysiek puntvormig onderdeel van het Nutsvoorzieningnetwerk."@nl;
  shacl:closed false;
  shacl:targetClass <https://vocab.belgif.be/ns/utility-services#Appurtenance> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/energiemanagementsysteem/ontwerpstandaard/2025-05-14#ToestelShape> a shacl:NodeShape;
  rdfs:label "Toestel"@nl;
  rdfs:comment "Tastbaar Object ontworpen om een specifieke Taak uit te voeren."@nl;
  shacl:closed false;
  shacl:property [
