    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#PeriodeShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#AdresvoorstellingShape> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#AansluitingShape> a shacl:NodeShape;
  rdfs:label "Aansluiting"@nl;
  rdfs:comment "Object dat de aansluiting van een kabel of leiding aan een gebouw of een ander fysiek object beschrijft"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "leveringsadres"@nl;
    rdfs:comment "Adres waarop de Aansluiting betrekking heeft."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Aansluiting.Leveringsadres>;
    shacl:class <https://data.vlaanderen.be/ns/adres#Adres>;
    shacl:description "Adres waarop de Aansluiting betrekking heeft."@nl;
    shacl:name "leveringsadres"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#address>
  ];
  shacl:targetClass <https://vocab.belgif.be/ns/utility-services#Connection> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#ActiviteitShape> a shacl:NodeShape;
  rdfs:label "Activiteit"@nl;
  rdfs:comment "Handeling van bepaalde duur op of met entiteiten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Soort Dossier."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Activiteit.Type>;
    shacl:class skos:Concept;
    shacl:description "Soort Dossier."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "wasGeassocieerdMet"@nl;
    rdfs:comment "Een toewijzing van verantwoordelijkheid aan een agent voor een activiteit, wat aangeeft dat de agent een rol in de activiteit had."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Activiteit.Wasgeassocieerdmet>;
    shacl:class dc:Agent;
    shacl:description "Een toewijzing van verantwoordelijkheid aan een agent voor een activiteit, wat aangeeft dat de agent een rol in de activiteit had."@nl;
    shacl:name "wasGeassocieerdMet"@nl;
    shacl:path prov:wasAssociatedWith
  ], [
    a shacl:PropertyShape;
    rdfs:label "genereert"@nl;
    rdfs:comment "Activiteit die het Stuk heeft voortgebracht."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Activiteit.Genereert>;
    shacl:class <https://data.vlaanderen.be/ns/dossier#Stuk>;
    shacl:description "Activiteit die het Stuk heeft voortgebracht."@nl;
    shacl:name "genereert"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#genereert>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vindPlaatsTijdens"@nl;
    rdfs:comment "Verwijzing naar de Zaak in het kader waarvan de Activiteit plaatsvindt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Activiteit.Vindplaatstijdens>;
    shacl:class dbo:Case;
    shacl:description "Verwijzing naar de Zaak in het kader waarvan de Activiteit plaatsvindt."@nl;
    shacl:name "vindPlaatsTijdens"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#vindtPlaatsTijdens>
  ];
  shacl:targetClass prov:Activity,
    <http://www.w3.org/ns/sosa/Observation>,
    <https://data.vlaanderen.be/ns/omgevingsvergunning#Vergunning> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#AdresShape> a shacl:NodeShape;
  rdfs:label "Adres"@nl;
  <http://purl.org/vocab/vann/usageNote> "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bv ingangaanduiding, trapaanduiding, verdiepaanduiding...) of een gebouwnaam of kamernaam ed zijn mogelijk dmv een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren mbv het object adresvoorstelling."@nl;
  rdfs:comment "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid,een ligplaats,een standplaats of een perceel op basis van een gemeentenaam,een straatnaam,een huisnummer en eventueel een busnummer en een postcode."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "isToegekendaan"@nl;
    rdfs:comment "Adresseerbaar object waaraan het adres is toegekend."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Adres.Istoegekendaan>;
    shacl:description "Adresseerbaar object waaraan het adres is toegekend."@nl;
    shacl:name "isToegekendaan"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/adres#AdresseerbaarObject>] [shacl:class <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid>] [shacl:class <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel>]);
    shacl:path <https://data.vlaanderen.be/ns/adres#isToegekendAan>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#Adres> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#AdresseerbaarobjectShape> a shacl:NodeShape;
  rdfs:label "AdresseerbaarObject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Is abstract,ttz het type adresseerbaar object moet altijd worden opgegeven (vb gebouweenheid,perceel)."@nl;
  rdfs:comment "Geografisch object dat met een adres kan worden geïdentificeerd."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#AdresseerbaarObject>,
    <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid>,
    <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv als attribuut ve persoon of gebouw... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres,bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#BestuurlijkeRechtshandelingShape> a shacl:NodeShape;
  rdfs:label "Bestuurlijke Rechtshandeling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Voorbeelden van eenzijdige bestuurlijke rechtshandelingen zijn: besluiten van algemene strekking, uitvaardiging van voorschriften, beschikkingen zoals erkenningen en vergunningen en aktenamen. Breid deze klasse uit met de nodige specilisaties of typeringen."@nl;
  rdfs:comment "Handeling,uitgaande van een bestuur,die de rechtstoestand wijzigt,dan wel belet dat deze wordt gewijzigd."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#BestuurlijkeRechtshandeling> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#BewijsShape> a shacl:NodeShape;
  rdfs:label "Bewijs"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het kader van publieke dienstverlening gaat het meestal om administratieve documenten of ingevulde aanvraagformulieren. Zonder het nodige Bewijs kan de dienstverlening niet worden afgeleverd. Soms levert de Output van een Publieke Dienstverlening het Bewijs nodig voor een andere Publieke Dienstverlening."@nl;
  rdfs:comment "Elk stuk waarmee kan worden aangetoond dat men aan een CriteriumVereiste voldoet."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/m8g/Evidence> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Bim_elementShape> a shacl:NodeShape;
  rdfs:label "BIM_Element"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de context van BIM gaat het over fysieke objecten, inclusief open elementen zoals een muuropeningen. Elementen zijn in principe permanent, tenzij objecten zoals bekisting. Elementen kunnen ter plaatse worden geassembleerd of geprefabriceerd en ter plaatse worden ingebouwd. Meer info over deze klasse in de <a href=\"https://ifc43-docs.standards.buildingsmart.org/IFC/RELEASE/IFC4x3/HTML/ifcproductextension/content.html\">IFC standaard</a>."@nl;
  rdfs:comment "Component van de ruimtelijke structuur van een bouwproject."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van het BIM element."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Bim_element.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van het BIM element."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcElement> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Bim_gebouwShape> a shacl:NodeShape;
  rdfs:label "BIM_Gebouw"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de context van BIM is een Gebouw een basiselement in de hiërarchie van van de componenten die de ruimtelijke structuur van een bouwproject vormen. Meer info over deze klasse in de <a href=\"https://ifc43-docs.standards.buildingsmart.org/IFC/RELEASE/IFC4x3/HTML/ifcproductextension/content.html\">IFC standaard</a>."@nl;
  rdfs:comment "Structuur die onderdak biedt aan de bewoners of inhoud en op een vaste plek staat."@nl;
  shacl:closed false;
  shacl:targetClass <https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcBuilding> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#CollectieShape> a shacl:NodeShape;
  rdfs:label "Collectie"@nl;
  rdfs:comment "Een collectie is een entiteit die structuur geeft aan sommige bestanddelen,die zelf entiteiten zijn. Deze bestanddelen zouden deel uitmaken van de collecties."@nl;
  shacl:closed false;
  shacl:targetClass prov:Collection .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#DossierShape> a shacl:NodeShape;
  rdfs:label "Dossier"@nl;
  rdfs:comment "Samenhangend geheel van stukken die betrekking hebben op een bepaalde zaak."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "bestaatUit"@nl;
    rdfs:comment "Stuk dat deel uitmaakt van het Dossier."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Dossier.Bestaatuit>;
    shacl:class <https://data.vlaanderen.be/ns/dossier#Stuk>;
    shacl:description "Stuk dat deel uitmaakt van het Dossier."@nl;
    shacl:name "bestaatUit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#Dossier.bestaatUit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isNeerslagVan"@nl;
    rdfs:comment "Zaak in het kader waarvan het Dossier wordt aangelegd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Dossier.Isneerslagvan>;
    shacl:class dbo:Case;
    shacl:description "Zaak in het kader waarvan het Dossier wordt aangelegd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "isNeerslagVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#Dossier.isNeerslagVan>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/dossier#Dossier> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#EenheidVanWerkShape> a shacl:NodeShape;
  rdfs:label "Eenheid Van Werk"@nl;
  rdfs:comment "Deze entiteit is bedoeld om de notie van een hoeveelheid werk over te brengen. Het verschilt van Activiteit in die zin dat het een duidelijk einde heeft en gemeten wordt."@nl;
  shacl:closed false;
  shacl:targetClass dbo:UnitOfWork .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#EntiteitShape> a shacl:NodeShape;
  rdfs:label "Entiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het kader van dossier is dit bv. een foto,een document,een audiofragment,..."@nl;
  rdfs:comment "Iets met een duidelijk en onafhankelijk bestaan."@nl;
  shacl:closed false;
  shacl:targetClass prov:Entity .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#GebouwShape> a shacl:NodeShape;
  rdfs:label "Gebouw"@nl;
  rdfs:comment "Een gesloten en/of overdekt, bovengronds of ondergronds bouwwerk, dat dient of bestemd is, ofwel om mensen, dieren en voorwerpen onder te brengen, ofwel om economische goederen te vervaardigen of diensten te verstrekken. Een gebouw verwijst naar gelijk welke structuur die op blijvende wijze op een terrein opgetrokken of gebouwd wordt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "bestaatUit"@nl;
    rdfs:comment "Gebouweenheid die deel uitmaakt van het Gebouw."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Gebouw.Bestaatuit>;
    shacl:class <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid>;
    shacl:description "Gebouweenheid die deel uitmaakt van het Gebouw."@nl;
    shacl:name "bestaatUit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#bestaatUit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ligtOp"@nl;
    rdfs:comment "KadastraalPlanperceel waarop het Gebouw gelegen is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Gebouw.Ligtop>;
    shacl:class <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel>;
    shacl:description "KadastraalPlanperceel waarop het Gebouw gelegen is."@nl;
    shacl:name "ligtOp"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#ligtOp>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/gebouw#Gebouw> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#GebouweenheidShape> a shacl:NodeShape;
  rdfs:label "Gebouweenheid"@nl;
  rdfs:comment "De kleinste eenheid binnen een gebouw die geschikt is voor woon-, bedrijfsmatige, of recreatieve doeleinden en die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde circulatieruimte. Een gebouweenheid is in functioneel opzicht zelfstandig. Daarnaast kan een gebouweenheid ook een gemeenschappelijk deel zijn."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#KadastraalPatrimoniumperceelShape> a shacl:NodeShape;
  rdfs:label "Kadastraal Patrimoniumperceel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze definitie is gealigneerd met de definitie van de Algemene Administratie van de PatrimoniumDocumentatie (AAPD). Kadastraal Patrimoniumperceel komt overeen met de entiteit BasicPropertyUnit uit INSPIRE Cadastral Parcel. De identificator die gedefinieerd kan worden voor een Kadastraal patrimoniumperceel komt overeen met de PatKey. Ter informatie: de PatKey is samengesteld uit de CaPaKey en het partitienummer. Bijvoorbeeld: in Patkey 11111A2222/33B444_P0000 is 11111A2222/33B444 de CaPaKey en P0000 het partitienummer."@nl;
  rdfs:comment "Een onroerend goed of onroerend recht dat in hoofde van één of meerdere titularissen van een zakelijk recht onderworpen is aan een bepaald eigendomsstatuut."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "isGerelateerdAan"@nl;
    rdfs:comment "KadastraalPlanperceel van het KadastraalPatrimoniumperceel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#KadastraalPatrimoniumperceel.Isgerelateerdaan>;
    shacl:class <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel>;
    shacl:description "KadastraalPlanperceel van het KadastraalPatrimoniumperceel."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "isGerelateerdAan"@nl;
    shacl:path dc:relation
  ], [
    a shacl:PropertyShape;
    rdfs:label "agentMetZakelijkRecht"@nl;
    rdfs:comment "Verwijzing naar een Agent die een zakelijk recht heeft op het KadastraalPatrimoniumperceel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#KadastraalPatrimoniumperceel.Agentmetzakelijkrecht>;
    shacl:class dc:Agent;
    shacl:description "Verwijzing naar een Agent die een zakelijk recht heeft op het KadastraalPatrimoniumperceel."@nl;
    shacl:minCount 1;
    shacl:name "agentMetZakelijkRecht"@nl;
    shacl:path <https://data.vlaanderen.be/ns/perceel#agentMetZakelijkRecht>
  ];
