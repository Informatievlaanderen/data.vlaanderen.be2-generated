    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#ObservatieShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#ObservatieverzamelingShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Bim_elementShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Bim_gebouwShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#BewijsShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#AgentShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#KadastraalPlanperceelShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#KadastraalPatrimoniumperceelShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#PubliekeDienstverleningShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#OutputShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#AansluitingShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#RechtsgrondShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#VergunningShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#ToebehorenShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#RuimtelijkeEenheidShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#ObjectShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#EntiteitShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#CollectieShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#EenheidVanWerkShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#BestuurlijkeRechtshandelingShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#ZaakhandelingShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#UnieRgLvShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#MomentShape>,
    <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#DatetimeShape>,
