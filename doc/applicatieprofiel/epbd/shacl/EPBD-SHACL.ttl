    shacl:class <https://data.vlaanderen.be/ns/adres#Adres>;
    shacl:description "Adres dat met het KadastraalPlanperceel geassocieerd is."@nl;
    shacl:name "liggingsadres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#LangstringShape> a shacl:NodeShape;
