    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Observatie.Islidvan>;
    shacl:class <http://www.w3.org/ns/sosa/ObservationCollection>;
    shacl:description "De Observatieverzameling waarvan de Oberservatie deel uitmaakt."@nl;
    shacl:name "isLidVan"@nl;
    shacl:path <http://www.w3.org/ns/sosa/memberOf>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Observation> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#ObservatieverzamelingShape> a shacl:NodeShape;
  rdfs:label "Observatieverzameling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv Observaties die op hetzelfde tijdstip plaatsvonden of hetzelfde Object observeren of door dezelfde sensor zijn gemaakt."@nl;
  rdfs:comment "Collectie van Observaties met dezelfde kenmerken."@nl;
