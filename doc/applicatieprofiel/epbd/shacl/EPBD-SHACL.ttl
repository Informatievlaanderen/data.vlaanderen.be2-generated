  ];
  shacl:targetClass dbo:Project .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#PubliekeDienstverleningShape> a shacl:NodeShape;
  rdfs:label "Publieke Dienstverlening"@nl;
  <http://purl.org/vocab/vann/usageNote> "De dienstverlening vormt een aanbod (dat dus niet noodzakelijk wordt gebruikt). Ze houdt niet noodzakelijk het opnemen van een recht in,de dienstverlening kan de gebruiker ook toelaten een verplichting te vervullen."@nl;
  rdfs:comment "Een publieke dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen hiervan."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de PubliekeDienstverlening."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#PubliekeDienstverlening.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de PubliekeDienstverlening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftverantwoordelijke"@nl;
    rdfs:comment "PubliekeOrganisatie die of in wiens naam de PubliekeDienstverlening wordt verstrekt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#PubliekeDienstverlening.Heeftverantwoordelijke>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "PubliekeOrganisatie die of in wiens naam de PubliekeDienstverlening wordt verstrekt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeftverantwoordelijke"@nl;
    shacl:path <http://data.europa.eu/m8g/hasCompetentAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "produceert"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb een erkenning, financieel voordeel, code, fysiek object…"@nl;
    rdfs:comment "Het werkelijke resultaat van de uitvoering vd publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#PubliekeDienstverlening.Produceert>;
    shacl:class <http://data.europa.eu/m8g/Output>;
    shacl:description "Het werkelijke resultaat van de uitvoering vd publieke dienstverlening."@nl;
    shacl:name "produceert"@nl;
    shacl:path <http://purl.org/vocab/cpsv#produces>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftRechtsgrond"@nl;
    rdfs:comment "Rechtsgrond op basis waarvan de PubliekeDienstverling wordt verleend."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#PubliekeDienstverlening.Heeftrechtsgrond>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Rechtsgrond op basis waarvan de PubliekeDienstverling wordt verleend."@nl;
    shacl:name "heeftRechtsgrond"@nl;
    shacl:path <http://data.europa.eu/m8g/hasLegalResource>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftInput"@nl;
    rdfs:comment "Bewijs dat is voorgelegd om  de PubliekeDienstverlening te kunnen gebruiken."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#PubliekeDienstverlening.Heeftinput>;
    shacl:class <http://data.europa.eu/m8g/Evidence>;
    shacl:description "Bewijs dat is voorgelegd om  de PubliekeDienstverlening te kunnen gebruiken."@nl;
    shacl:name "heeftInput"@nl;
    shacl:path <http://purl.org/vocab/cpsv#hasInput>
  ];
  shacl:targetClass <http://purl.org/vocab/cpsv#PublicService> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#PubliekeorganisatieShape> a shacl:NodeShape;
  rdfs:label "PubliekeOrganisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "De overheids- en semioverheidsorganisaties die tot men zo tot de publieke sector kan rekenen worden in Europese richtlijn 2003/98/EG \"openbaar lichaam\" genoemd en gedefinieerd als: \"de staat, zijn territoriale lichamen, publiekrechtelijke instellingen, en verenigingen gevormd door een of meer van deze lichamen of een of meer van deze publiekrechtelijke instellingen\". En onder een publiekrechtelijke instelling verstaat men \" iedere instelling die a) is opgericht met het specifieke doel te voorzien in behoeften van algemeen belang die niet van industriële of commerciële aard zijn, en b) rechtspersoonlijkheid heeft, en c) waarvan hetzij de activiteiten in hoofdzaak door de staat of zijn territoriale lichamen of andere publiekrechtelijke instellingen worden gefinancierd, hetzij het beheer is onderworpen aan toezicht door deze laatste, hetzij de leden van het bestuursorgaan, het leidinggevend orgaan of het toezichthoudend orgaan voor meer dan de helft door de staat, zijn territoriale lichamen of andere publiekrechtelijke instellingen zijn aangewezen.\"."@nl;
  rdfs:comment "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector,ongeacht het bestuursniveau waarop dat kader van kracht is."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/m8g/PublicOrganisation> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#RechtsgrondShape> a shacl:NodeShape;
  rdfs:label "Rechtsgrond"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een rechtsgrond kan zowel een geheel (bvb: wet,besluit) voorstellen als een onderdeel eruit (bvb: artikel)."@nl;
  rdfs:comment "Een legaal concept dat los staat van een bepaalde vorm (het achterliggende idee)."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/eli/ontology#LegalResource> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#RuimtelijkeEenheidShape> a shacl:NodeShape;
  rdfs:label "Ruimtelijke Eenheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Definitie conform ISO 19152 - Land Administration Domain Model."@nl;
  rdfs:comment "Eén gebied (of meerdere gebieden) van land en/of water,of één enkel volume (of meerdere volumes) ruimte,afgebakend voor een bepaald doel."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/perceel#RuimtelijkeEenheid> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#StukShape> a shacl:NodeShape;
  rdfs:label "Stuk"@nl;
  rdfs:comment "Eenheid van bewijs ter ondersteuning van een feit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "inhoud"@nl;
    rdfs:comment "Een waarde die een directe representatie is van de entiteit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Stuk.Inhoud>;
    shacl:description "Een waarde die een directe representatie is van de entiteit."@nl;
    shacl:maxCount "1";
    shacl:name "inhoud"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path prov:value
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van de output."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Stuk.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Beschrijving van de output."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van het Stuk."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Stuk.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van het Stuk."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "geldigheid"@nl;
    rdfs:comment "Periode waarop de inhoud van het Stuk betrekking heeft."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Stuk.Geldigheid>;
    shacl:class <http://www.w3.org/2006/time#ProperInterval>;
    shacl:description "Periode waarop de inhoud van het Stuk betrekking heeft."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geldigheid"@nl;
    shacl:path dc:coverage
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijft"@nl;
    rdfs:comment "Gebouweenheid waarop het Stuk betrekking heeft."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Stuk.Beschrijft>;
    shacl:class <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid>;
    shacl:description "Gebouweenheid waarop het Stuk betrekking heeft."@nl;
    shacl:name "beschrijft"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#beschrijft>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/dossier#Stuk> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#ToebehorenShape> a shacl:NodeShape;
  rdfs:label "Toebehoren"@nl;
  <http://purl.org/vocab/vann/usageNote> "Kan als Nutsvoorzieningknoop op zichzelf staan maar is dikwijls gemonteerd op een drager (de Nutsvoorzieningknoopcontainter). Bvb inspectieluik,hydrant,splitter,meter,pomp etc."@nl;
  rdfs:comment "Fysiek puntvormig onderdeel van het Nutsvoorzieningnetwerk."@nl;
  shacl:closed false;
  shacl:targetClass <https://vocab.belgif.be/ns/utility-services#Appurtenance> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#UnieRgLvShape> a shacl:NodeShape;
  rdfs:label "Unie RG LV"@nl;
  rdfs:comment "Unie van Rechtsgrond en Legale Verschijningsvorm"@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/wetgeving#UnieRGLV> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#VergunningShape> a shacl:NodeShape;
  rdfs:label "Vergunning"@nl;
  rdfs:comment "De Rechtshandeling, zijnde een beslissing, die toelating inhoudt voor een Activiteit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "zaak"@nl;
    rdfs:comment "De zaak waarin de Zaakhandeling wordt gesteld."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Vergunning.Zaak>;
    shacl:class dbo:Case;
    shacl:description "De zaak waarin de Zaakhandeling wordt gesteld."@nl;
    shacl:maxCount 1;
    shacl:name "zaak"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#zaak>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Vergunning> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#VestigingShape> a shacl:NodeShape;
  rdfs:label "Vestiging"@nl;
  <http://purl.org/vocab/vann/usageNote> "Meestal zal de Vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten,bv een virtueel kantoor met bijbehorend postnummer en telefonische receptie."@nl;
  rdfs:comment "Een kantoor of ander pand waar een Organisatie gevestigd is. Organisaties kunnen over meerdere vestigingen verspreid zijn en vestigingen kunnen op meerdere locaties slaan."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "bestaatUit"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebouweenheid of Perceel."@nl;
    rdfs:comment "AdresseerbaarObject waaruit de Vestiging bestaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#Vestiging.Bestaatuit>;
    shacl:description "AdresseerbaarObject waaruit de Vestiging bestaat."@nl;
    shacl:name "bestaatUit"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/adres#AdresseerbaarObject>] [shacl:class <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid>] [shacl:class <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel>]);
    shacl:path <https://data.vlaanderen.be/ns/organisatie#bestaatUit>
  ];
  shacl:targetClass org:Site .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#ZaakShape> a shacl:NodeShape;
  rdfs:label "Zaak"@nl;
  rdfs:comment "Een zaak is het geheel aan werk gedaan om tot een bestuurlijke of zakelijke beslissing te komen. Een zaak slaat doorgaans neer in een verzameling documenten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
