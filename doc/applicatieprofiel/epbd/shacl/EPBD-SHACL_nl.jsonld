  {
    "@id": "https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#AdresseerbaarobjectShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Is abstract,ttz het type adresseerbaar object moet altijd worden opgegeven (vb gebouweenheid,perceel)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Geografisch object dat met een adres kan worden geïdentificeerd."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
