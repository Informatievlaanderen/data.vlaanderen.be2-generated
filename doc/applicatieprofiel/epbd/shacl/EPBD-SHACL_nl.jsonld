    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "In het kader van dossier is dit bv. een foto,een document,een audiofragment,..."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Iets met een duidelijk en onafhankelijk bestaan."
      }
    ],
