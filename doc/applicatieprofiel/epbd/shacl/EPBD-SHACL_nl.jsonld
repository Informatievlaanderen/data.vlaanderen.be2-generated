    ]
  },
  {
    "@id": "https://data.test-vlaanderen.be/doc/applicatieprofiel/epbd#ProjectShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een project is een, in de tijd en middelen begrensde, activiteit om iets te creëren."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Project"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
