<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#ObservatieShape> a shacl:NodeShape;
  rdfs:label "Observatie"@nl;
  rdfs:comment "Het vaststellen van de waarde van een bepaald kenmerk van een Feature Of Interest op een bepaald tijdstip of tussen twee tijdstippen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
