<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#ActuatieShape> a shacl:NodeShape;
  rdfs:label "Actuatie"@nl;
  rdfs:comment "Het veranderen van de staat van een Feature Of Interest."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerd door"@nl;
    rdfs:comment "De Agent die de Actuatie heeft uitgevoerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Actuatie.UitgevoerdDoor>;
    shacl:class dc:Agent;
    shacl:description "De Agent die de Actuatie heeft uitgevoerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "uitgevoerd door"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeByActuator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft simpel resultaat"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit kan gebruikte worden wanneer een instantie van Resultaat te zwaar is. Dit is het geval wanneer het resultaat bijvoorbeeld de boolean \"true\" is."@nl;
    rdfs:comment "Eenvoudige uitkomst van een actuatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Actuatie.HeeftSimpelResultaat>;
    shacl:class <https://data.vlaanderen.be/ns/erosiepoel#Literal>;
    shacl:description "Eenvoudige uitkomst van een actuatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "heeft simpel resultaat"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasSimpleResult>
  ], [
    a shacl:PropertyShape;
    rdfs:label "feature of interest"@nl;
    rdfs:comment "De Feature Of Interest waarop de Actuatie is uitgevoerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Actuatie.FeatureOfInterest>;
    shacl:class <http://www.w3.org/ns/sosa/FeatureOfInterest>;
    shacl:description "De Feature Of Interest waarop de Actuatie is uitgevoerd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "feature of interest"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasFeatureOfInterest>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Actuation> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#EenheidShape> a shacl:NodeShape;
  rdfs:label "Eenheid"@nl;
  rdfs:comment "Maat waarin een hoeveelheid van een bepaalde grootheid wordt uitgedrukt."@nl;
  shacl:closed false;
  shacl:targetClass <http://qudt.org/2.1/schema/qudt/Unit> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#ErosiebestrijdingsmaatregelShape> a shacl:NodeShape;
  rdfs:label "Erosiebestrijdingsmaatregel"@nl;
  rdfs:comment "Werken of natuurlijke elementen die bodemerosie bestrijden, zoals erosiepoelen en graszones."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschermde zone"@nl;
    rdfs:comment "De zone die beschermd wordt tegen bijvoorbeeld een modderstroom door de Erosiebestrijdingsmaatregel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiebestrijdingsmaatregel.BeschermdeZone>;
    shacl:class <https://data.vlaanderen.be/ns/erosiepoel#Zone>;
    shacl:description "De zone die beschermd wordt tegen bijvoorbeeld een modderstroom door de Erosiebestrijdingsmaatregel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschermde zone"@nl;
    shacl:path <https://data.vlaanderen.be/ns/erosiepoel#Erosiebestrijdingsmaatregel.beschermdeZone>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanvoerzone"@nl;
    rdfs:comment "De zone waarvan water en sediment aangevoerd wordt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiebestrijdingsmaatregel.Aanvoerzone>;
    shacl:class <https://data.vlaanderen.be/ns/erosiepoel#Zone>;
    shacl:description "De zone waarvan water en sediment aangevoerd wordt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aanvoerzone"@nl;
    shacl:path <https://data.vlaanderen.be/ns/erosiepoel#Erosiebestrijdingsmaatregel.aanvoerzone>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afvoerzone"@nl;
    rdfs:comment "De zone waarnaar overtollig water en sediment afgevoerd wordt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiebestrijdingsmaatregel.Afvoerzone>;
    shacl:class <https://data.vlaanderen.be/ns/erosiepoel#Zone>;
    shacl:description "De zone waarnaar overtollig water en sediment afgevoerd wordt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "afvoerzone"@nl;
    shacl:path <https://data.vlaanderen.be/ns/erosiepoel#Erosiebestrijdingsmaatregel.afvoerzone>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:comment "De locatie van een Erosiebestrijdingsmaatregel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiebestrijdingsmaatregel.Locatie>;
    shacl:class prov:Location;
    shacl:description "De locatie van een Erosiebestrijdingsmaatregel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "locatie"@nl;
    shacl:path prov:atLocation
  ], [
    a shacl:PropertyShape;
    rdfs:label "eigenaar"@nl;
    rdfs:comment "Persoon of Organisatie aan wie de Erosiebestrijdingsmaatregel toebehoort."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiebestrijdingsmaatregel.Eigenaar>;
    shacl:class dc:Agent;
    shacl:description "Persoon of Organisatie aan wie de Erosiebestrijdingsmaatregel toebehoort."@nl;
    shacl:minCount "1";
    shacl:name "eigenaar"@nl;
    shacl:path crm:P52_has_current_owner
  ], [
    a shacl:PropertyShape;
    rdfs:label "verantwoordelijke"@nl;
    rdfs:comment "De verantwoordelijke van een Erosiebestrijdingsmaatregel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiebestrijdingsmaatregel.Verantwoordelijke>;
    shacl:class dc:Agent;
    shacl:description "De verantwoordelijke van een Erosiebestrijdingsmaatregel."@nl;
    shacl:minCount "1";
    shacl:name "verantwoordelijke"@nl;
    shacl:path <https://data.vlaanderen.be/ns/erosiepoel#Erosiebestrijdingsmaatregel.verantwoordelijke>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bestaat uit"@nl;
    rdfs:comment "De onderdelen waaruit een Erosiebestrijdingsmaatregel bestaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiebestrijdingsmaatregel.BestaatUit>;
    shacl:class <https://data.vlaanderen.be/ns/erosiepoel#Erosiebestrijdingsmaatregelonderdeel>;
    shacl:description "De onderdelen waaruit een Erosiebestrijdingsmaatregel bestaat."@nl;
    shacl:name "bestaat uit"@nl;
    shacl:path dc:hasPart
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/erosiepoel#Erosiebestrijdingsmaatregel> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#ErosiebestrijdingsmaatregelonderdeelShape> a shacl:NodeShape;
  rdfs:label "Erosiebestrijdingsmaatregelonderdeel"@nl;
  rdfs:comment "Deel van een Erosiebestrijdingsmaatregel."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Classificering van het Erosiebestrijdingsmaatregelonderdeel aan de hand van een gecontroleerde codelijst."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiebestrijdingsmaatregelonderdeel.Type>;
    shacl:class <https://data.vlaanderen.be/ns/erosiepoel#Erosiepoelonderdeel>;
    shacl:description "Classificering van het Erosiebestrijdingsmaatregelonderdeel aan de hand van een gecontroleerde codelijst."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:comment "De locatie van het Erosiebestrijdingsmaatregelonderdeel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiebestrijdingsmaatregelonderdeel.Locatie>;
    shacl:class prov:Location;
    shacl:description "De locatie van het Erosiebestrijdingsmaatregelonderdeel."@nl;
    shacl:maxCount "1";
    shacl:name "locatie"@nl;
    shacl:path prov:atLocation
  ], [
    a shacl:PropertyShape;
    rdfs:label "deel van"@nl;
    rdfs:comment "De Erosiebestrijdingsmaatregel tot welke het onderdeel behoort."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiebestrijdingsmaatregelonderdeel.DeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/erosiepoel#Erosiebestrijdingsmaatregel>;
    shacl:description "De Erosiebestrijdingsmaatregel tot welke het onderdeel behoort."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "deel van"@nl;
    shacl:path dc:isPartOf
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/erosiepoel#Erosiebestrijdingsmaatregelonderdeel> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#ErosiepoelShape> a shacl:NodeShape;
  rdfs:label "Erosiepoel"@nl;
  rdfs:comment "Erosiepoelen vangen afstromend (modder)water op en bufferen het tijdelijk zodat de meegevoerde modder kan bezinken. In een aarden dam met erosiepoel wordt water niet permanent gestockeerd. Bij een volgende regenbui moet er immers terug water kunnen worden opgevangen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "maximaal volume"@nl;
    rdfs:comment "Het maximaal volume voor er sediment en water afvloeit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiepoel.MaximaalVolume>;
    shacl:class <http://qudt.org/schema/qudt/QuantityValue>;
    shacl:description "Het maximaal volume voor er sediment en water afvloeit."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "maximaal volume"@nl;
    shacl:path <https://data.vlaanderen.be/ns/erosiepoel#maxVolume>
  ], [
    a shacl:PropertyShape;
    rdfs:label "dimensie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit kan gebruikt worden voor de lengte, breedte, en diepte van de Erosiepoel."@nl;
    rdfs:comment "Een vaste dimensie van de Erosiepoel net na het uitgraven."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Erosiepoel.Dimensie>;
    shacl:class <http://qudt.org/schema/qudt/Quantity>;
    shacl:description "Een vaste dimensie van de Erosiepoel net na het uitgraven."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "dimensie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/erosiepoel#dimensie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/erosiepoel#Erosiepoel> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#ErosiepoelonderdeelShape> a shacl:NodeShape;
  rdfs:label "Erosiepoelonderdeel"@nl;
  rdfs:comment "Een onderdeel van een erosiepoel, zoals ingang en uitgang."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/erosiepoel#Erosiepoelonderdeel> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#FeatureOfInterestShape> a shacl:NodeShape;
  rdfs:label "Feature Of Interest"@nl;
  rdfs:comment "Het object waarvan de eigenschap wordt geschat of berekend tijdens een observatie om tot een resultaat te komen, of waarvan de eigenschap wordt gemanipuleerd door een actuator, of dat wordt bemonsterd of getransformeerd tijdens een bemonsteringshandeling."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/sosa/FeatureOfInterest> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#GeobserveerdkenmerkShape> a shacl:NodeShape;
  rdfs:label "Geobserveerdkenmerk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Voorbeelden van instanties van deze klasse zijn infiltratiesnelheid, densiteit, vruchtbaarheid, vochtigheid, bodemtype, organisch materiaal, koolstof, grondwaterpeil, vegetatie, en teelt."@nl;
  rdfs:comment "Een kwaliteit van een entiteit. Een aspect van een entiteit dat intrinsiek is aan en niet kan bestaan zonder de entiteit."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/sosa/ObservableProperty> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#GraszoneShape> a shacl:NodeShape;
  rdfs:label "Graszone"@nl;
  rdfs:comment "Een zone met gras om bodemerosie te bestrijden."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/erosiepoel#Graszone> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#HoeveelheidShape> a shacl:NodeShape;
  rdfs:label "Hoeveelheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "De klasse is gelijkaardig aan Resultaat maar heeft een referentie naar het Hoeveelheidstype, terwijl Resultaat geen referentie heeft naar het Geobserveerd Kenmerk. We gebruiken deze klasse in dit applicatieprofiel niet voor uitkomsten van Observaties maar enkel voor de dimensies van een Erosiepoel."@nl;
  rdfs:comment "Het resultaat van een waarneembare eigenschap van een bepaald object, gebeurtenis of fysiek systeem."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het is hoog waarschijnlijk dat elk SSN/SOSA GeobserveerdKenmerk ook een Hoeveelheidtype is als we kijken naar beide definities."@nl;
    rdfs:comment "Meetbare eigenschap die numeriek gemeten en gekwantificeerd kan worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Hoeveelheid.Type>;
    shacl:class <http://qudt.org/schema/qudt/QuantityKind>;
    shacl:description "Meetbare eigenschap die numeriek gemeten en gekwantificeerd kan worden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path <http://qudt.org/schema/qudt/hasQuantityKind>
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Kwantitatieve waarde van de Hoeveelheid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Hoeveelheid.Waarde>;
    shacl:class <http://qudt.org/schema/qudt/QuantityValue>;
    shacl:description "Kwantitatieve waarde van de Hoeveelheid."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "waarde"@nl;
    shacl:path <http://qudt.org/schema/qudt/quantityValue>
  ];
  shacl:targetClass <http://qudt.org/schema/qudt/Quantity> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#HoeveelheidtypeShape> a shacl:NodeShape;
  rdfs:label "Hoeveelheidtype"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het is hoog waarschijnlijk dat elk SSN/SOSA GeobserveerdKenmerk ook een Hoeveelheidtype is als we kijken naar beide definities."@nl;
  rdfs:comment "Meetbare eigenschap die numeriek gemeten en gekwantificeerd kan worden."@nl;
  shacl:closed false;
  shacl:targetClass <http://qudt.org/schema/qudt/QuantityKind> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#KwantitatievewaardeShape> a shacl:NodeShape;
  rdfs:label "Kwantitatievewaarde"@nl;
  rdfs:comment "Dit drukt de grootte en het soort van een hoeveelheid uit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "eenheid"@nl;
    rdfs:comment "Maat waarin een hoeveelheid van een bepaalde grootheid wordt uitgedrukt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Kwantitatievewaarde.Eenheid>;
    shacl:class <http://qudt.org/2.1/schema/qudt/Unit>;
    shacl:description "Maat waarin een hoeveelheid van een bepaalde grootheid wordt uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "eenheid"@nl;
    shacl:path <http://qudt.org/schema/qudt/unit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "numerieke waarde"@nl;
    rdfs:comment "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Kwantitatievewaarde.NumeriekeWaarde>;
    shacl:class <http://www.linkedmodel.org/schema/dtype#numericUnion>;
    shacl:description "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "numerieke waarde"@nl;
    shacl:path <http://qudt.org/schema/qudt/numericValue>
  ];
  shacl:targetClass <http://qudt.org/schema/qudt/QuantityValue> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#LocatieShape> a shacl:NodeShape;
  rdfs:label "Locatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet direct gewerkt worden met Geometrie, GeografischeNaam, Adres etc."@nl;
  rdfs:comment "Aanduiding van een geografische positie, dmv coordinaten, een toponiem, een adreslabel, een verwijzing naar een plaats/regio of verwijzing naar een adres."@nl;
  shacl:closed false;
  shacl:targetClass prov:Location .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#NumeriekeunieShape> a shacl:NodeShape;
