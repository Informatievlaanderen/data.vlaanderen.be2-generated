    shacl:name "einde"@nl;
    shacl:path prov:endedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "feature of interest"@nl;
    rdfs:comment "De Feature Of Interest waarop de Observatie is uitgevoerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Observatie.FeatureOfInterest>;
