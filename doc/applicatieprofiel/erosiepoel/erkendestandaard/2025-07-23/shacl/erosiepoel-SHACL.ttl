    shacl:minCount "1";
    shacl:name "start"@nl;
    shacl:path prov:startedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "einde"@nl;
    rdfs:comment "Moment waarop de Observatie gestopt is."@nl;
