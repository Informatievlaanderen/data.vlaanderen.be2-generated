    shacl:class <https://data.vlaanderen.be/ns/erosiepoel#DateTime>;
    shacl:description "Moment waarop het Onderhoud gestart is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "start"@nl;
