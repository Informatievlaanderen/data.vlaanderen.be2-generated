  ], [
    a shacl:PropertyShape;
    rdfs:label "start"@nl;
    rdfs:comment "Moment waarop de Observatie gestart is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Observatie.Start>;
