    shacl:name "verantwoordelijke"@nl;
    shacl:path <https://data.vlaanderen.be/ns/erosiepoel#Zone.verantwoordelijke>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eigenaar"@nl;
    rdfs:comment "Persoon of Organisatie aan wie de Zone toebehoort."@nl;
