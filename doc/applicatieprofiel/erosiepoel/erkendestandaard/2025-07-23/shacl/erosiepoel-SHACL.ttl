    shacl:class skos:Concept;
    shacl:description "Classificering van het Onderhoud aan de hand van een gecontroleerde codelijst."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
