    shacl:name "feature of interest"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasFeatureOfInterest>
  ], [
    a shacl:PropertyShape;
    rdfs:label "resultaat"@nl;
    rdfs:comment "Het resultaat van de Observatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/erosiepoel/erkendestandaard/2025-07-23#Observatie.Resultaat>;
    shacl:class <http://www.w3.org/ns/sosa/Result>;
    shacl:description "Het resultaat van de Observatie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "resultaat"@nl;
