    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Erosiepoelen vangen afstromend (modder)water op en bufferen het tijdelijk zodat de meegevoerde modder kan bezinken. In een aarden dam met erosiepoel wordt water niet permanent gestockeerd. Bij een volgende regenbui moet er immers terug water kunnen worden opgevangen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
