<https://data.dev-vlaanderen.be/doc/applicatieprofiel/erosiepoel/ontwerpstandaard/toolchain4/ActuatieShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/erosiepoel/ontwerpstandaard/toolchain4#Actuatie.UitgevoerdDoor>;
    shacl:class dc:Agent;
    shacl:description "De Agent die de Actuatie heeft uitgevoerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "uitgevoerd door"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeByActuator>
  ], [
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/erosiepoel/ontwerpstandaard/toolchain4#Actuatie.HeeftSimpelResultaat>;
    shacl:class <https://data.vlaanderen.be/ns/erosiepoel#Literal>;
    shacl:description "Eenvoudige uitkomst van een actuatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "heeft simpel resultaat"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasSimpleResult>
  ], [
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/erosiepoel/ontwerpstandaard/toolchain4#Actuatie.FeatureOfInterest>;
    shacl:class <http://www.w3.org/ns/sosa/FeatureOfInterest>;
    shacl:description "De Feature Of Interest waarop de Actuatie is uitgevoerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "feature of interest"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasFeatureOfInterest>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Actuation> .

