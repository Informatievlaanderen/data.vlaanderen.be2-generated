    shacl:class <https://data.vlaanderen.be/ns/fiets#Fietssegment>;
    shacl:description "De Fietslink waarop een richting wordt toegepast."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "link"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#GerichteLink.link>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/fiets#GerichteFietslink> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type vd string slaat op het identificatiesysteem (incl de versie ervan), de string zelf op de eigenlijke identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Identificator.Identificator>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount "1";
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door (String)"@nl;
    rdfs:comment "Naam vd agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Identificator.ToegekendDoor(string)>;
    shacl:datatype xsd:string;
    shacl:description "Naam vd agent die de identificator heeft toegekend."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend door (String)"@nl;
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend op"@nl;
    rdfs:comment "Tijdstip waarop de identificator werd uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Identificator.ToegekendOp>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend op"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door"@nl;
    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Identificator.ToegekendDoor>;
    shacl:class dc:Agent;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend door"@nl;
    shacl:path dc:creator
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#InfrastructuurelementShape> a shacl:NodeShape;
  rdfs:label "Infrastructuurelement"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hier gaat het over elementen van een fietsinfrastructuur zoals een verkeerslicht voor fietsers of een Fietsstalling en in principe ook de wegbaan waarover kan worden gefietst. Een infrastructuur kan ook niet-materiële aspecten hebben, bvb Verkeersintensiteit of RichtingVerkeer. Tussen beide bestaat een verband, bvb ToegestaneSnelheid (een eigenschap) en de Verkeersborden om die af te dwingen (Infrastructuurelementen). Van de wegen zelf wordt typisch het niet-materiële aspect voorgesteld, dus niet de wegbaan maar het transportnetwerk dat ze vormen."@nl;
  rdfs:comment "Materieel onderdeel van een infrastructuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "Vorm -en of positiekenmerken van het element."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Infrastructuurelement.Geometrie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "Vorm -en of positiekenmerken van het element."@nl;
    shacl:maxCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Unieke identificator van het element."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Infrastructuurelement.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Unieke identificator van het element."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "onderhoud"@nl;
    rdfs:comment "Het onderhoud dat van toepassing is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Infrastructuurelement.Onderhoud>;
    shacl:class <https://data.vlaanderen.be/ns/fiets#Onderhoud>;
    shacl:description "Het onderhoud dat van toepassing is."@nl;
    shacl:maxCount "1";
    shacl:name "onderhoud"@nl;
    shacl:path <https://data.vlaanderen.be/ns/fiets#onderhoud>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Te gebruiken als alternatief voor de subklassen."@nl;
    rdfs:comment "Soort Infrastructuurelement."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Infrastructuurelement.Type>;
    shacl:class <https://data.vlaanderen.be/ns/fiets#Infrastructuurelementtype>;
    shacl:description "Soort Infrastructuurelement."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infrastructuurelement> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#IntegerShape> a shacl:NodeShape;
  rdfs:label "Integer";
  shacl:closed false;
  shacl:targetClass xsd:integer .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#KwantitatievewaardeShape> a shacl:NodeShape;
  rdfs:label "KwantitatieveWaarde"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv de hoogte van een object,het gewicht,de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog,laag ed vallen hier dus niet onder."@nl;
  rdfs:comment "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Kwantitatievewaarde.Waarde>;
    shacl:datatype rdfs:Literal;
    shacl:description "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ], [
    a shacl:PropertyShape;
    rdfs:label "eenheid"@nl;
    rdfs:comment "De eenheid waarin de waarde is uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Kwantitatievewaarde.Eenheid>;
    shacl:class skos:Concept;
    shacl:description "De eenheid waarin de waarde is uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:name "eenheid"@nl;
    shacl:path schemas:unitCode
  ];
  shacl:targetClass schemas:QuantitativeValue .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#LandgebruikShape> a shacl:NodeShape;
  rdfs:label "Landgebruik"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het gebruik voor bepaalde activiteiten, bvb akkerbouw, huisvesting, industrie edm."@nl;
