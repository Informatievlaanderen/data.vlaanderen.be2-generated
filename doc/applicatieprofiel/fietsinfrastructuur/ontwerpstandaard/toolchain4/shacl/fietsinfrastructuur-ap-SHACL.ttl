    shacl:class skos:Concept;
    shacl:description "Het type van Landgebruik."@nl;
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/fiets#Landgebruik> .

