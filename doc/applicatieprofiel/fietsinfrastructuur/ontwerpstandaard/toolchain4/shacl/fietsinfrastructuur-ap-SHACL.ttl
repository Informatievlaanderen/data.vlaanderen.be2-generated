  rdfs:label "LangString";
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#LengteShape> a shacl:NodeShape;
  rdfs:label "Lengte"@nl;
  rdfs:comment "Grootste afmeting van een object."@nl;
