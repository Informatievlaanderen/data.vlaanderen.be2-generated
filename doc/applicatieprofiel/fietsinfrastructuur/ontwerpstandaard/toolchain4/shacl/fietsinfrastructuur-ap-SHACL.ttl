    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Geluid.Waarde>;
    shacl:datatype rdfs:Literal;
    shacl:description "Waarde die het geluidsniveau uitdrukt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ], [
    a shacl:PropertyShape;
    rdfs:label "bron"@nl;
    rdfs:comment "Type geluidsbron."@nl;
