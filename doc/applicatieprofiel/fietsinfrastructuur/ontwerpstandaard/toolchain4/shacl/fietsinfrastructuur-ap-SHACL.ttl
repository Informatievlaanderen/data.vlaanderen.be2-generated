    shacl:description "Het kader waarin de Luchtkwaliteit is gedefinieerd."@nl;
    shacl:maxCount "1";
    shacl:name "kader"@nl;
    shacl:path <https://data.vlaanderen.be/ns/fiets#Luchtkwaliteit.kader>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/fiets#Luchtkwaliteit> .

