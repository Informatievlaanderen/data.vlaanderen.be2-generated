    shacl:class skos:Concept;
    shacl:description "Type geluidsbron."@nl;
    shacl:name "bron"@nl;
    shacl:path <https://data.vlaanderen.be/ns/fiets#bron>
  ], [
    a shacl:PropertyShape;
    rdfs:label "kader"@nl;
    <http://purl.org/vocab/vann/usageNote> "Verwijzing naar een document waarin dat kader wordt gespecifieerd, maw wat onder geluidsniveau precies wordt verstaan en hoe het wordt bepaald."@nl;
    rdfs:comment "Het kader waarin het geluidsniveau is gedefinieerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Geluid.Kader>;
    shacl:class foaf:Document;
    shacl:description "Het kader waarin het geluidsniveau is gedefinieerd."@nl;
    shacl:maxCount "1";
    shacl:name "kader"@nl;
    shacl:path <https://data.vlaanderen.be/ns/fiets#Geluid.kader>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/fiets#Geluid> .

