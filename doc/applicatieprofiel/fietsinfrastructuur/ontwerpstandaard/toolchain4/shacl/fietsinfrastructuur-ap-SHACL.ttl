<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#LijnstringShape> a shacl:NodeShape;
  rdfs:label "LijnString"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een curve is een 1-dimensioneel geometrisch object gedefinieerd als een sequentie van punten. De interpolatie kan op verschillende manieren gebeuren (bv lineair bij een lijnstring)."@nl;
  rdfs:comment "Curve met lineaire interpolatie tussen de punten. Elk opeenvolgend paar punten vormt een lijnsegment. De lijnstring heeft ten minste twee punten."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#LineString> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#LineairereferentieShape> a shacl:NodeShape;
  rdfs:label "LineaireReferentie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Meer specifiek het deel twee opeenvolgende posities op het netwerkelement. Bvb op een netwerkelement van 500 meter het deel tussen de 100 en 400 meter."@nl;
  rdfs:comment "Linkreferentie die verwijst naar een deel van het lineair netwerkelement."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "vanPositie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uitgedrukt in afstand tov het begin van het netwerkelement. Bvb 100meter gerekend vanaf het begin van het netwerkelement. Moet kleiner zijn dan de totPositie en kleiner dan de totale lengte van het netwerkelement."@nl;
    rdfs:comment "Start van het deel van het lineair netwerkelement."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Lineairereferentie.Vanpositie>;
    shacl:class schemas:Distance;
    shacl:description "Start van het deel van het lineair netwerkelement."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "vanPositie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie.vanPositie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "totPositie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uitgedrukt in afstand tov het begin van het netwerkelement. Bvb 400meter gerekend vanaf het begin van het netwerkelement. Moet groter zijn dan de vanPositie en kleiner dan de totale lengte van het netwerkelement."@nl;
    rdfs:comment "Einde van het deel van het lineair netwerkelement."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Lineairereferentie.Totpositie>;
    shacl:class schemas:Distance;
    shacl:description "Einde van het deel van het lineair netwerkelement."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "totPositie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie.totPositie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#LinkShape> a shacl:NodeShape;
  rdfs:label "Link"@nl;
  <http://purl.org/vocab/vann/usageNote> "Meer info over deze klasse in het vocabularium <a href=\"https://data.vlaanderen.be/ns/netwerk/\">OSLO-Netwerk</a>."@nl;
  rdfs:comment "Curvilineair netwerkelement dat twee posities verbindt en een homogeen pad in het Netwerk vertegenwoordigt. De verbonden posities worden voorgesteld door Knopen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Link> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#LinkreferentieShape> a shacl:NodeShape;
  rdfs:label "Linkreferentie"@nl;
  rdfs:comment "Netwerkreferentie die verwijst naar een lineair netwerkelement."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "toepassingsRichting"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb is de snelheidsbeperking geldig voor de ene richting of voor de andere of in beide richtingen. Om de ene richting te onderscheiden van de andere staat \"gelijklopend\" voor de richting die gelijkloopt met de digitalisatierichting van het lineair netwerkelement en \"tegengesteld\" voor de richting die tegengesteld is aan de digitalisatierichting. In het geval de referentie niet slaat op de richting van de link, maar op een fenomeen langs de link (bvb een fietspad of straatverlichting), komt \"gelijklopend\" overeen met de rechterkant en \"tegengesteld\" met de linkerkant."@nl;
    rdfs:comment "Richting van de link waarop de referentie van toepassing is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Linkreferentie.Toepassingsrichting>;
    shacl:class skos:Concept;
    shacl:description "Richting van de link waarop de referentie van toepassing is."@nl;
    shacl:maxCount "1";
    shacl:name "toepassingsRichting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#toepassingsrichting>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Linkreferentie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#LiteralShape> a shacl:NodeShape;
