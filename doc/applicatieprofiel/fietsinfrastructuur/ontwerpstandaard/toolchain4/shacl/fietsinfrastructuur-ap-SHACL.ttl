<https://data.vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4/AdresvoorstellingShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Adresvoorstelling.VolledigAdres>;
    shacl:datatype rdf:langString;
    shacl:description "Het complete adres in één string, al dan niet geformatteerd."@nl;
    shacl:maxCount "1";
    shacl:name "volledig adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#fullAddress>
  ], [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Adresvoorstelling.Postbus>;
