  {
    "@id": "_:df_8_52",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Bvb is de snelheidsbeperking geldig voor de ene richting of voor de andere of in beide richtingen. Om de ene richting te onderscheiden van de andere staat \"gelijklopend\" voor de richting die gelijkloopt met de digitalisatierichting van het lineair netwerkelement en \"tegengesteld\" voor de richting die tegengesteld is aan de digitalisatierichting. In het geval de referentie niet slaat op de richting van de link, maar op een fenomeen langs de link (bvb een fietspad of straatverlichting), komt \"gelijklopend\" overeen met de rechterkant en \"tegengesteld\" met de linkerkant."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Richting van de link waarop de referentie van toepassing is."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "toepassingsRichting"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#Linkreferentie.Toepassingsrichting"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "Richting van de link waarop de referentie van toepassing is."
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@value": "1"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "nl",
        "@value": "toepassingsRichting"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://data.vlaanderen.be/ns/netwerk#toepassingsrichting"
      }
    ]
