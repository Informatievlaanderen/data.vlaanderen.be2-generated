  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/fietsinfrastructuur/ontwerpstandaard/toolchain4#InfrastructuurelementShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Hier gaat het over elementen van een fietsinfrastructuur zoals een verkeerslicht voor fietsers of een Fietsstalling en in principe ook de wegbaan waarover kan worden gefietst. Een infrastructuur kan ook niet-materiële aspecten hebben, bvb Verkeersintensiteit of RichtingVerkeer. Tussen beide bestaat een verband, bvb ToegestaneSnelheid (een eigenschap) en de Verkeersborden om die af te dwingen (Infrastructuurelementen). Van de wegen zelf wordt typisch het niet-materiële aspect voorgesteld, dus niet de wegbaan maar het transportnetwerk dat ze vormen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Materieel onderdeel van een infrastructuur."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Infrastructuurelement"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_79"
      },
      {
        "@id": "_:df_8_87"
      },
      {
        "@id": "_:df_8_88"
      },
      {
        "@id": "_:df_8_128"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infrastructuurelement"
      }
    ]
  },
