<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#DossierShape> a shacl:NodeShape;
  rdfs:label "Dossier"@nl;
  rdfs:comment "Samenhangend geheel van stukken die betrekking hebben op een bepaalde zaak."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
