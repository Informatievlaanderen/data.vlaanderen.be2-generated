  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/financiele-rapportering#Opmerking> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#OprichtingShape> a shacl:NodeShape;
  rdfs:label "Oprichting"@nl;
  rdfs:comment "Gebeurtenis waarbij een organisatie is opgericht."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    rdfs:comment "Datum waarop de oprichting plaatsvond."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Oprichting.Datum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de oprichting plaatsvond."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum"@nl;
    shacl:path dc:date
  ];
  shacl:targetClass <http://data.europa.eu/m8g/FoundationEvent> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Organisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "vestiging"@nl;
    rdfs:comment "Verwijst naar een plek waar de organisatie op een of andere manier, desnoods indirect, aanwezig is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Organisatie.Vestiging>;
    shacl:class org:Site;
    shacl:description "Verwijst naar een plek waar de organisatie op een of andere manier, desnoods indirect, aanwezig is."@nl;
    shacl:maxCount "1";
    shacl:name "vestiging"@nl;
    shacl:path org:hasSite
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Organisatie.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path schema:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "isHetresultaatVan"@nl;
    rdfs:comment "Verwijst naar het verandersinsmoment dat tot de huidige organisatie heeft geleid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Organisatie.Ishetresultaatvan>;
    shacl:class <http://data.europa.eu/m8g/FoundationEvent>;
    shacl:description "Verwijst naar het verandersinsmoment dat tot de huidige organisatie heeft geleid."@nl;
    shacl:maxCount "1";
    shacl:name "isHetresultaatVan"@nl;
    shacl:path org:resultedFrom
  ];
  shacl:targetClass org:Organization .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#PeriodeShape> a shacl:NodeShape;
  rdfs:label "Periode"@nl;
  <http://purl.org/vocab/vann/usageNote> "Vergelijkbaar met een Curve in de ruimte, maar ipv een interval tussen twee punten in de ruimte gaat het hier over een interval tussen twee punten op de tijdsas. De bijbehorende tijdsduur is de temporele afstand tussen die twee punten (vergelijkbaar met de afstand tussen twee punten in de ruimte). OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bv time:Interval uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."@nl;
  rdfs:comment "Een 1-dimensionele geometrische primitieve in de tijd."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Period> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#PeriodetypeShape> a shacl:NodeShape;
  rdfs:label "PeriodeType"@nl;
  rdfs:comment "Het type van de periode. Gaat het om een moment of een duur"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "achternaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Persoon.Achternaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "achternaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "voornaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Persoon.Voornaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    shacl:minCount "1";
    shacl:name "voornaam"@nl;
    shacl:path foaf:givenName
  ], [
    a shacl:PropertyShape;
    rdfs:label "geboortedatum"@nl;
    rdfs:comment "De datum waarop de Persoon werd geboren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Persoon.Geboortedatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop de Persoon werd geboren."@nl;
    shacl:maxCount "1";
    shacl:name "geboortedatum"@nl;
    shacl:path foaf:birthday
  ], [
    a shacl:PropertyShape;
    rdfs:label "woonplaats"@nl;
    rdfs:comment "De plaats waar de Persoon woonachtig is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Persoon.Woonplaats>;
    shacl:class dc:Location;
    shacl:description "De plaats waar de Persoon woonachtig is."@nl;
    shacl:maxCount "1";
    shacl:name "woonplaats"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-info#Persoon.woonplaats>
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Persoon te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Persoon.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Persoon te contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path schema:contactPoint
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#PlaatsShape> a shacl:NodeShape;
  rdfs:label "Plaats"@nl;
  rdfs:comment "Een ruimtelijk gebied of benoemde plaats."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "plaatsnaam"@nl;
