<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#AandelenShape> a shacl:NodeShape;
  rdfs:label "Aandelen"@nl;
  rdfs:comment "Specialisatie van Decimal waarmee het getal van het AandelenDatatype wordt voorgesteld."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/financiele-rapportering#Aandelen> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#AandelendatatypeShape> a shacl:NodeShape;
  rdfs:label "AandelenDatatype"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb voor het aantal aandelen."@nl;
  rdfs:comment "NumeriekDatatype bedoeld om waarden die betrekking hebben op aandelen voor te stellen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "getal"@nl;
    rdfs:comment "Getal waarmee een waarde in dit datatype wordt voorgesteld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Aandelendatatype.Getal>;
    shacl:class <https://data.vlaanderen.be/ns/financiele-rapportering#Aandelen>;
    shacl:description "Getal waarmee een waarde in dit datatype wordt voorgesteld."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "getal"@nl;
    shacl:path schemas:value
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/financiele-rapportering#AandelenDatatype> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Straatnaam vh adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Adresvoorstelling.Straatnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Straatnaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam vh adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Adresvoorstelling.Land>;
    shacl:datatype rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#AnydatatypeShape> a shacl:NodeShape;
  rdfs:label "AnyDatatype"@nl;
  <http://purl.org/vocab/vann/usageNote> "AnyDataType staat voor alle datatypes in XML Schema."@nl;
  rdfs:comment "Dit datatype kan alle mogelijke datatypes bevatten."@nl;
  shacl:closed false;
  shacl:targetClass xsd:anyType .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#BalanstypeShape> a shacl:NodeShape;
  rdfs:label "BalansType"@nl;
  rdfs:comment "Een overzicht van de mogelijke balanstypes zoals debit en credit"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#BooleanShape> a shacl:NodeShape;
  rdfs:label "Boolean";
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#ConceptShape> a shacl:NodeShape;
  rdfs:label "Concept"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijving van een financieel begrip waarop een Feit betrekking kan hebben, bvb Activa, Omzet, Kosten etc. De beschrijving omvat zaken zoals de definitie van het Concept, het verwachte datatype (bvb Monetair), de relatie met andere Concepten (Omzet is bvb een subtype Inkomsten). OPMERKING: Concept kan beschouwd worden als een metaklasse, een klasse waarmee klassen zoals Omzet, Kosten etc gemaakt kunnen worden. Een mogelijke implementatie is dan om deze klassen te definiëren als subklassen van Feit. De subklassen vormen dan samen een Schema of taxonomie."@nl;
  rdfs:comment "Definitie van een type Feit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De naam van het Concept."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Concept.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van het Concept."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "datatype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb Monetair, Aandelen."@nl;
    rdfs:comment "Het datatype van een Feit van dit type.."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Concept.Datatype>;
    shacl:datatype xsd:anyURI;
    shacl:description "Het datatype van een Feit van dit type.."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datatype"@nl;
    shacl:path dc11:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "definitie"@nl;
    rdfs:comment "Definitie van het Concept."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Concept.Definitie>;
    shacl:datatype rdf:langString;
    shacl:description "Definitie van het Concept."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "definitie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Concept.definitie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "label"@nl;
    rdfs:comment "Sleutelwoord toegekend aan het Concept volgens een of ander classificatiesysteem."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Concept.Label>;
    shacl:datatype rdf:langString;
    shacl:description "Sleutelwoord toegekend aan het Concept volgens een of ander classificatiesysteem."@nl;
    shacl:name "label"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Concept.label>
  ], [
    a shacl:PropertyShape;
    rdfs:label "abstract"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit is bvb niet het geval voor een Concept dat parent is van meerdere andere Concepten, bvb Bedrijfsopbrengsten dat opgesplitst wordt in Omzet, Bestellingen, Voorraad etc."@nl;
    rdfs:comment "Geeft aan of een Feit van dit type geïnstantieerd mag worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Concept.Abstract>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of een Feit van dit type geïnstantieerd mag worden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "abstract"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Concept.abstract>
  ], [
    a shacl:PropertyShape;
    rdfs:label "periodeType"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb wordt de periode waarin de Opbrengsten zijn gerealiseerd uitgedrukt als moment (bvb 2020) of als periode (bvb 1/1/2020 tot 31/12/2020)."@nl;
    rdfs:comment "De manier waarop de periode waarop dit type Feit betrekking heeft wordt uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Concept.Periodetype>;
    shacl:class skos:Concept;
    shacl:description "De manier waarop de periode waarop dit type Feit betrekking heeft wordt uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:name "periodeType"@nl;
    shacl:path dc11:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "balansType"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voor monetaire Feiten."@nl;
    rdfs:comment "Geeft aan of een Feit van dit type doorgaans aan de credit of debetkant van een balans wordt weggeschreven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Concept.Balanstype>;
    shacl:class skos:Concept;
    shacl:description "Geeft aan of een Feit van dit type doorgaans aan de credit of debetkant van een balans wordt weggeschreven."@nl;
    shacl:maxCount "1";
    shacl:name "balansType"@nl;
    shacl:path dc11:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "id"@nl;
    rdfs:comment "Identificator van het Concept."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Concept.Id>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het Concept."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "id"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "itemtype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Als de waarde van een Feit uit meerdere onderdelen bestaat is het complex, bvb een tijdsreeks. Maar doorgaans zijn waarden primitief, bvb Integer, String. Ook een Feit met een MonetairDatatype beschouwen we als primitief omdat het een gepredefinieerde structuur heeft (een getal en een valuta als eenheid)."@nl;
    rdfs:comment "Geeft aan of het datatype van dit type Feit primitief of complex is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Concept.Itemtype>;
    shacl:class skos:Concept;
    shacl:description "Geeft aan of het datatype van dit type Feit primitief of complex is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "itemtype"@nl;
    shacl:path dc11:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "geassocieerdMet"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb Opbrengsten is het parent-Concept van Omzet."@nl;
    rdfs:comment "Associatie tussen twee Concepten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Concept.Geassocieerdmet>;
    shacl:class <https://data.vlaanderen.be/ns/financiele-rapportering#Concept>;
