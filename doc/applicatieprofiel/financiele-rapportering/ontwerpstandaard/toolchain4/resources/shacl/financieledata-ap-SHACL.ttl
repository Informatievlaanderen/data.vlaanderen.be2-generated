<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#ContextShape> a shacl:NodeShape;
  rdfs:label "Context"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb de Periode waarin het Feit geldig is (typisch het huidig boekjaar) of andere Dimensies van het Feit zoals het Product of de Regio waarop het Feit van toepassing is, bvb de Omzet van Product X of Y. Slaat op een individueel Feit of is van toepassing op een FinancieelRapport (en dus op de Feiten in dat rapport)."@nl;
  rdfs:comment "Kader waarin een Feit moet geïnterpreteerd worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "scenario"@nl;
    rdfs:comment "Aanvullende informatie over het Feit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Context.Scenario>;
    shacl:datatype xsd:string;
    shacl:description "Aanvullende informatie over het Feit."@nl;
    shacl:maxCount "1";
    shacl:name "scenario"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Context.scenario>
  ], [
    a shacl:PropertyShape;
    rdfs:label "entiteit"@nl;
    <http://purl.org/vocab/vann/usageNote> "In het geval van de jaarrekening gaat het over de onderneming waarvan de jaarrekening wordt neergelegd"@nl;
    rdfs:comment "Organisatie waarop het Feit betrekking heeft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Context.Entiteit>;
    shacl:class org:Organization;
    shacl:description "Organisatie waarop het Feit betrekking heeft."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "entiteit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Context.entiteit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "periode"@nl;
    rdfs:comment "Het moment of de periode waarop het Feit betrekking heeft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Context.Periode>;
    shacl:class <http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Object>;
    shacl:description "Het moment of de periode waarop het Feit betrekking heeft."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "periode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Context.periode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "dimensie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb voor welke periode het Feit geldig is of op welk product het slaat of op welke regio of al deze Dimensies samen. Bvb Omzet123 geldt voor het huidig boekjaar en voor product ABC (Dimensies zijn dus Periode en Product met resp waarde \"huidig boekjaar\" en \"product ABC\").  Omzet 456 in hetzelfde rapport kan bvb gelden voor hetzelfde boekjaar maar voor product DEF."@nl;
    rdfs:comment "Perpectief van waaruit naar het Feit is gekeken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Context.Dimensie>;
    shacl:class <https://data.vlaanderen.be/ns/financiele-rapportering#Dimensie>;
    shacl:description "Perpectief van waaruit naar het Feit is gekeken."@nl;
    shacl:name "dimensie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Context.dimensie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rapport"@nl;
    <http://purl.org/vocab/vann/usageNote> "Om aan te geven tot welk rapport de Context behoort zonder de individuele Feiten te moeten raadplegen. Eenzelfde Context kan immers worden herbruikt voor meerdere Feiten of zelfs voor alle Feiten in een bepaald rapport."@nl;
    rdfs:comment "FinancieelRapport waartoe de Context behoort."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Context.Rapport>;
    shacl:class <https://data.vlaanderen.be/ns/financiele-rapportering#FinancieelRapport>;
    shacl:description "FinancieelRapport waartoe de Context behoort."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "rapport"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#rapport>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/financiele-rapportering#Context> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#DateShape> a shacl:NodeShape;
  rdfs:label "Date";
  shacl:closed false;
  shacl:targetClass xsd:date .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
