  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#DecimalShape> a shacl:NodeShape;
  rdfs:label "Decimal"@nl;
  rdfs:comment "Een getal met een decimaalpunt gevolgd door cijfers die het breukdeel aangeven."@nl;
  shacl:closed false;
  shacl:targetClass xsd:decimal .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#DimensieShape> a shacl:NodeShape;
  rdfs:label "Dimensie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb Opbrensten kunnen gekenmerkt worden door een Locatie die aangeeft in welke regio de Opbrensten zijn verkregen of een Periode die zegt of het om Opbrensten van het huidig of het vorig boekjaar gaat. Soms zijn meerdere van dergelijke kenmerken tegelijk van toepassing, bvb de Opbrengst voor Product X in Regio Y. Dit laat toe om analyses uit te voeren op het niveau van het FinancieelRapport, bvb door Feiten te aggregeren in een dimensie (bvb de Opbrengst voor alle Producten samen per Regio)."@nl;
  rdfs:comment "Onafhankelijk kenmerk waardoor een Feit gekarakteriseerd wordt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb \"huidig boekjaar\" voor een Dimensie vh type Periode."@nl;
    rdfs:comment "Waarde die de Dimensie aanneemt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Dimensie.Waarde>;
    shacl:class xsd:anyType;
    shacl:description "Waarde die de Dimensie aanneemt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ], [
    a shacl:PropertyShape;
    rdfs:label "concept"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb om aan te geven dat het een Dimensie vh type \"Periode\" betreft. OPMERKING: Dimensieoncept kan opgevat worden als een metaklasse, dit kan dus ook geïmplementeerd worden dmv subklassen van Dimensie: als de subklasse bvb Periode is dan is de verwijzing naar het Dimensieconcept niet meer nodig."@nl;
    rdfs:comment "Verwijzing naar het dimensieconcept."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Dimensie.Concept>;
    shacl:class <https://data.vlaanderen.be/ns/financiele-rapportering#Dimensieconcept>;
    shacl:description "Verwijzing naar het dimensieconcept."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "concept"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Dimensie.concept>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/financiele-rapportering#Dimensie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#DimensieconceptShape> a shacl:NodeShape;
  rdfs:label "Dimensieconcept"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijving van een onafhankelijk kenmerk dat een Feit kan karakteriseren, bvb Periode, Locatie etc. Deze beschrijving omvat zaken als de definitie van het Dimensieconcept, het verwacht datatype (bvb DateTime voor Periode, Regio voor Locatie), de relatie met andere Dimensieconcepten etc. OPMERKING: Dimensieconcept kan beschouwd worden als een metaklasse, een klasse waarmee klassen zoals Periode, Product etc gemaakt kunnen worden. Een mogelijke implementatie is dan om deze klassen te definiëren als subklassen van Dimensie. De subklassen vormen dan samen een Dimensieschema of dimensietaxonomie."@nl;
  rdfs:comment "Definitie van een type Dimensie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "de naam van het Dimensieconcept."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Dimensieconcept.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "de naam van het Dimensieconcept."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "datatype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb codelijst Producttype voor Product."@nl;
    rdfs:comment "Het datatype van een Dimensie van dit type."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Dimensieconcept.Datatype>;
    shacl:datatype xsd:anyURI;
    shacl:description "Het datatype van een Dimensie van dit type."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datatype"@nl;
    shacl:path dc11:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "definitie"@nl;
    rdfs:comment "Definitie van het Dimensieconcept."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Dimensieconcept.Definitie>;
    shacl:datatype rdf:langString;
    shacl:description "Definitie van het Dimensieconcept."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "definitie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Dimensieconcept.definitie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "label"@nl;
    rdfs:comment "Sleutelwoord toegekend aan het Dimensieconcept volgens een of ander classificatiesysteem."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Dimensieconcept.Label>;
    shacl:datatype rdf:langString;
