    shacl:class <https://data.vlaanderen.be/ns/financiele-rapportering#Hypercube>;
    shacl:description "Hypercube waarmee Feiten van dit type geassocieerd worden."@nl;
    shacl:name "hypercube"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Concept.hypercube>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/financiele-rapportering#Concept> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#ConceptrelatieShape> a shacl:NodeShape;
