    shacl:name "toegekend door"@nl;
    shacl:path dc:creator
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#InformatieclassificatieShape> a shacl:NodeShape;
