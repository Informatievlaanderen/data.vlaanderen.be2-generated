  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#IntegerShape> a shacl:NodeShape;
