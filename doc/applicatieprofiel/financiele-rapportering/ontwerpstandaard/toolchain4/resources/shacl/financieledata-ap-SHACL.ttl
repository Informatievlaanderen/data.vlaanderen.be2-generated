    shacl:class <https://data.vlaanderen.be/ns/financiele-rapportering#Monetair>;
    shacl:description "Getal waarmee een waarde in dit datatype wordt voorgesteld."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "getal"@nl;
    shacl:path schemas:value
  ];
  shacl:targetClass schemas:MonetaryAmount .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#NeerleggingShape> a shacl:NodeShape;
  rdfs:label "Neerlegging"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het gaat typisch om een wettelijke verplichting, bvb de Neerlegging van een Jaarrekening bij de Nationale Bank van België, bedoeld om inzicht te geven in de financiële positie van de Organisatie waarmee men omgaat."@nl;
  rdfs:comment "Activiteit waarbij een FinancieelRapport officieel wordt ingediend."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    rdfs:comment "De datum waarop het rapport werd neergelegd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Neerlegging.Datum>;
    shacl:class <http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Instant>;
    shacl:description "De datum waarop het rapport werd neergelegd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Neerlegging.datum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "neergelegdBij"@nl;
    rdfs:comment "De Organisatie waarbij het rapport werd neergelegd"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Neerlegging.Neergelegdbij>;
    shacl:class org:Organization;
    shacl:description "De Organisatie waarbij het rapport werd neergelegd"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "neergelegdBij"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Neerlegging.neergelegdBij>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/financiele-rapportering#Neerlegging> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#NietnumeriekdatatypeShape> a shacl:NodeShape;
  rdfs:label "NietNumeriekDatatype"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te substitueren door een niet numeriek datatype uit XML Schema, bvb String, DateTime."@nl;
  rdfs:comment "Datatype bedoeld om waarden voor te stellen die niet wiskundig gemanipuleerd kunnen worden met standaard rekenkundige operatoren."@nl;
  shacl:closed false;
  shacl:targetClass schemas:QualitativeValue .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#NumeriekdatatypeShape> a shacl:NodeShape;
  rdfs:label "NumeriekDatatype"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te substitueren door een numeriek datatype uit XML-schema, bvb Integer, Decimal. OPMERKING: Echter, behalve het getal dat de waarde in dit datatype voorstelt moeten voor NumeriekeDatatypes ook een eenheid, precisie en decimalen worden gegeven."@nl;
  rdfs:comment "Datatype bedoeld om waarden voor te stellen die  wiskundig gemanipuleerd kunnen worden met standaard rekenkundige operatoren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "precisie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb als het getal 2000 is en de precisie is 2, dan kunnen we hoogstens stellen dat het getal tussen 1950 en 2050 ligt. Is de precisie 4 dan is het getal werkelijk 2000."@nl;
    rdfs:comment "Geeft aan hoeveel cijfers in het getal accuraat zijn."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Numeriekdatatype.Precisie>;
    shacl:datatype xsd:integer;
    shacl:description "Geeft aan hoeveel cijfers in het getal accuraat zijn."@nl;
    shacl:maxCount "1";
    shacl:name "precisie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Numeriekdatatype.precisie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "decimalen"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb als het getal 10 is en het aantal decimalen 2 dan mogen we het getal substitueren door 10.00. Het getal 10.001 zou worden afgekapt tot 10.00, 10.0 zou worden vermeerderd tot 10.00 en 10.00 zou 10.00 blijven. OPMERKING: een negatief cijfer is ook mogelijk. Bvb als het getal 11 is en het aantal decimalen -1 dan mogen we het getal substitueren door 10. OPMERKING: Uit de decimalen kan de precisie worden afgeleid. Als bvb het getal 10 is en zijn precisie 2, dan kan 10 gesubstitueerd worden door 10.00 wat een getal is met een precisie 4."@nl;
    rdfs:comment "Geeft aan tot hoeveel cijfers na de komma het getal correct is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Numeriekdatatype.Decimalen>;
    shacl:datatype xsd:integer;
    shacl:description "Geeft aan tot hoeveel cijfers na de komma het getal correct is."@nl;
    shacl:maxCount "1";
    shacl:name "decimalen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#NumeriekDatatype.decimalen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eenheid"@nl;
    rdfs:comment "De eenheid waarin de waarde is uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Numeriekdatatype.Eenheid>;
    shacl:class <https://data.vlaanderen.be/ns/financiele-rapportering#Eenheid>;
    shacl:description "De eenheid waarin de waarde is uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "eenheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#eenheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "getal"@nl;
    rdfs:comment "Getal waarmee de waarde van het NumeriekDatatype wordt voorgesteld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Numeriekdatatype.Getal>;
    shacl:class schemas:Number;
    shacl:description "Getal waarmee de waarde van het NumeriekDatatype wordt voorgesteld."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "getal"@nl;
    shacl:path schemas:value
  ];
  shacl:targetClass schemas:QuantitativeValue .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#OpmerkingShape> a shacl:NodeShape;
  rdfs:label "Opmerking"@nl;
  rdfs:comment "Gedachte of waarneming bij de Validatie van een FinancieelRapport of Dossier."@nl;
