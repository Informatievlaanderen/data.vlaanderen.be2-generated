  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door (String)"@nl;
    rdfs:comment "Naam vd agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Identificator.ToegekendDoor(string)>;
    shacl:datatype xsd:string;
