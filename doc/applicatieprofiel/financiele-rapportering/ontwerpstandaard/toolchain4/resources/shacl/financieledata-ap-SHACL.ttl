    shacl:name "geassocieerdMet"@nl;
    shacl:path <https://data.vlaanderen.be/ns/financiele-rapportering#Concept.geassocieerdMet>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hypercube"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een Hypercube is een set van Dimensies die op een Feit van toepassing kan zijn, bvb Opbrengsten worden uitgesplitst volgens Boekjaar, Product en regio."@nl;
    rdfs:comment "Hypercube waarmee Feiten van dit type geassocieerd worden."@nl;
