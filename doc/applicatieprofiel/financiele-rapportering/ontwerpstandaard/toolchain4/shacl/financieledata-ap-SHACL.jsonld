      {
        "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Publiekedienstverlening.Heeftverantwoordelijke"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "http://data.europa.eu/m8g/PublicOrganisation"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "Publieke organisatie die verantwoordelijk is voor het aanbieden en beheren van de publieke dienstverlening."
      }
    ],
