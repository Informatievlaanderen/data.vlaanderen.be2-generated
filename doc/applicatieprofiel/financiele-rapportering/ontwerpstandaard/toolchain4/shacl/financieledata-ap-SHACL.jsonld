  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#HypercubeShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "De Feiten in een FinancieelRapport worden gerangschikt zoals in een datawarehouse, ttz in rijen en kolommen zoals in een tabel maar dan een tabel in meer dan twee dimensies: een zgn n-dimensionele gegevenskubus. Deze dimensies zijn othogonaal (onafhankelijk van elkaar, bvb Concept, Tijd, Regio... ) vandaar de kubusvorm. Concreet wordt hier onder Hypercube een opsomming verstaan van de Dimensies die een Concept kan hebben, het is maw een uitbreiding van het Schema met een Dimensieschema."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Structuur van de gegevenskubus die het FinancieelRaport vormt."
      }
    ],
