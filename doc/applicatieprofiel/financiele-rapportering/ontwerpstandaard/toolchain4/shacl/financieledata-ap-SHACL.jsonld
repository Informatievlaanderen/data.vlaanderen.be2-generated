  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#DimensieShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Bvb Opbrensten kunnen gekenmerkt worden door een Locatie die aangeeft in welke regio de Opbrensten zijn verkregen of een Periode die zegt of het om Opbrensten van het huidig of het vorig boekjaar gaat. Soms zijn meerdere van dergelijke kenmerken tegelijk van toepassing, bvb de Opbrengst voor Product X in Regio Y. Dit laat toe om analyses uit te voeren op het niveau van het FinancieelRapport, bvb door Feiten te aggregeren in een dimensie (bvb de Opbrengst voor alle Producten samen per Regio)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Onafhankelijk kenmerk waardoor een Feit gekarakteriseerd wordt."
      }
    ],
