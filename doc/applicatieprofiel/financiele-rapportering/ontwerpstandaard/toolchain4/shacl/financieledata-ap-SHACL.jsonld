  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#EenheidShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "OPMERKING: Te substitueren door een URI of een GetypeerdeString. In het eerste geval als naar een op het web gepubliceerde eenheid kan worden verwezen. De eenheden van qudt zijn op die manier gepubliceerd, bvb http://qudt.org/vocab/uni/M voor meter. In het geval van een GetypeerdeString kunnen bvb de UCUM-codes worden gebruikt, de String is dan bvb km/h en het type http://w3id.org/lindt/custom_datatypes#ucumunit. Voor valuta is de ISO 4217 standaard aanbevolen met bvb EUR als String en ISO-4217 als type."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De eenheid waarin de waarde is uitgedrukt."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Eenheid"
      }
    ],
