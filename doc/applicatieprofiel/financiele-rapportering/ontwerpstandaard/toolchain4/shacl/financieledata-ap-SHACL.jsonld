  {
    "@id": "_:df_8_17",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Bvb als het getal 10 is en het aantal decimalen 2 dan mogen we het getal substitueren door 10.00. Het getal 10.001 zou worden afgekapt tot 10.00, 10.0 zou worden vermeerderd tot 10.00 en 10.00 zou 10.00 blijven. OPMERKING: een negatief cijfer is ook mogelijk. Bvb als het getal 11 is en het aantal decimalen -1 dan mogen we het getal substitueren door 10. OPMERKING: Uit de decimalen kan de precisie worden afgeleid. Als bvb het getal 10 is en zijn precisie 2, dan kan 10 gesubstitueerd worden door 10.00 wat een getal is met een precisie 4."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Geeft aan tot hoeveel cijfers na de komma het getal correct is."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "decimalen"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/financiele-rapportering/ontwerpstandaard/toolchain4#Numeriekdatatype.Decimalen"
      }
    ],
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "Geeft aan tot hoeveel cijfers na de komma het getal correct is."
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@value": "1"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "nl",
        "@value": "decimalen"
      }
    ],
