<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#BegraafplaatsShape> a shacl:NodeShape;
  rdfs:label "Begraafplaats"@nl;
  rdfs:comment "Gebied waar stoffelijke resten van overledenen begraven, bijgezet of verstrooid worden, inclusief de gemeenschappelijk gebruikte ruimte."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "actieve lijkbezorging"@nl;
    rdfs:comment "Duidt aan of er al dan niet nog aan actieve lijkbezorging gedaan wordt op de begraafplaats."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Begraafplaats.ActieveLijkbezorging>;
    shacl:datatype xsd:boolean;
    shacl:description "Duidt aan of er al dan niet nog aan actieve lijkbezorging gedaan wordt op de begraafplaats."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "actieve lijkbezorging"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/gebied#actieveLijkbezorging>
  ], [
    a shacl:PropertyShape;
    rdfs:label "lichte recreatie"@nl;
    rdfs:comment "Geeft aan of de begraafplaats al dan niet geschikt is voor lichte recreatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Begraafplaats.LichteRecreatie>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of de begraafplaats al dan niet geschikt is voor lichte recreatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lichte recreatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/gebied#lichteRecreatie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Begraafplaats> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#BooleanShape> a shacl:NodeShape;
  rdfs:label "boolean";
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#BufferzoneShape> a shacl:NodeShape;
  rdfs:label "Bufferzone"@nl;
  rdfs:comment "Een bufferzone is een gebied noodzakelijk om de hinder met naastliggende gebieden te beperken, bijvoorbeeld tussen industrie en woonzone of park."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Bufferzone> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#GebiedShape> a shacl:NodeShape;
  rdfs:label "Gebied"@nl;
  <http://purl.org/vocab/vann/usageNote> "De openbare ruimte wordt geïnterpreteerd zoals aangegeven in het GRB lexicon (Informatie Vlaanderen): \"Ruimte die ten dienste staat van iedereen (algemeen belang), zonder beperking naar specifieke gemeenschappen. De openbare ruimte is principieel voor iedereen toegankelijk\". Voorbeeld: een stadspark is parkzone, om hiermee aan te duiden dat de zone is ontworpen is om recreatie en natuur samen te laten plaatsvinden."@nl;
  rdfs:comment "Een ruimte met daarin objecten in de openbare ruimte die samen een hoofdfunctie hebben."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "begindatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het beheergebied in gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Gebied.Begindatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het beheergebied in gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "begindatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/gebied#begindatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het beheergebied uit gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Gebied.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het beheergebied uit gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/gebied#einddatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Een naam voor het gebied."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Gebied.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Een naam voor het gebied."@nl;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "De geometrie overeenkomstig met een bepaald gebied."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Gebied.Geometrie>;
    shacl:class <http://www.opengis.net/ont/sf#Polygon>;
    shacl:description "De geometrie overeenkomstig met een bepaald gebied."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Gebied> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#GeografischeNaamShape> a shacl:NodeShape;
  rdfs:label "Geografische Naam"@nl;
  rdfs:comment "Benaming toegekend aan of gebruikt voor een geografisch object."@nl;
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#GroenzoneShape> a shacl:NodeShape;
  rdfs:label "Groenzone"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een Groenzone onderscheid zich van Natuur omdat in dit laatste geval het gebied wel een specifieke ecologische functie heeft."@nl;
  rdfs:comment "Een gebied zonder specifieke functie."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Groenzone> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#NatuurShape> a shacl:NodeShape;
  rdfs:label "Natuur"@nl;
  rdfs:comment "Gebied met een ecologische functie"@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Natuur> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#ParkShape> a shacl:NodeShape;
  rdfs:label "Park"@nl;
  <http://purl.org/vocab/vann/usageNote> "Indien een verdere detaillering van parken gewenst is, bijvoorbeeld op basis van hun oppervlakte, kan gekeken worden naar de drempelwaarden voor stedelijk groen zoals gedefinieerd in het Milieurapport Vlaanderen (MIRA)."@nl;
  rdfs:comment "Een onbebouwde en openbare ruimte omgeven door gebouwen en maakt deel uit van het stratennet van een stad of dorp."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Park> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#ParkingShape> a shacl:NodeShape;
  rdfs:label "Parking"@nl;
  rdfs:comment "Hoofdzakelijk buiten de rijbaan gelegen zone, bedoeld voor het langdurig laten stilstaan van een voertuig in parkeervakken, inclusief de gemeenschappelijk gebruikte ruimte van de zone die buiten de parkeervakken."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Parking> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#PleinShape> a shacl:NodeShape;
  rdfs:label "Plein"@nl;
  <http://purl.org/vocab/vann/usageNote> "Op een plein kunnen diverse activiteiten doorgaan, in aanvulling op de verkeersfunctie."@nl;
  rdfs:comment "Een onbebouwde en openbare ruimte, typisch omgeven door gebouwen, dat deel uitmaakt van het stratennet van een stad of gemeente."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Plein> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#RecreatiegebiedShape> a shacl:NodeShape;
  rdfs:label "Recreatiegebied"@nl;
  rdfs:comment "Een gebied met hoofdzakelijk een recreatieve functie, waaronder ook sport en spel."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Recreatiegebied> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#RecyclageparkShape> a shacl:NodeShape;
  rdfs:label "Recyclagepark"@nl;
  rdfs:comment "Zone waar particulieren en KMO's hun afval gescheiden kunnen inzamelen en deponeren."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Recyclagepark> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#SpoorwegShape> a shacl:NodeShape;
  rdfs:label "Spoorweg"@nl;
  rdfs:comment "Zone bedoeld om hoofdzakelijk treinverkeer te kunnen laten plaatsvinden, inclusief de gebieden die de spoorinfrastructuur ondersteunen (vb: spoorbermen)"@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Spoorweg> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#TuinzoneShape> a shacl:NodeShape;
  rdfs:label "Tuinzone"@nl;
  rdfs:comment "Gebied ingericht en/of beheerd als openbare tuin, meestal aanliggend aan gebouwen voor algemeen nut (scholen, jeugdlokalen, religieuze gebouwen, cultuurcentra, politie, brandweer, etc.)"@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Tuinzone> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#VolkstuinShape> a shacl:NodeShape;
  rdfs:label "Volkstuin"@nl;
  rdfs:comment "Gebied aangeduid en bedoeld om tuinbouw te laten plaatsvinden bij particulieren op percelen die niet aan de eigen woning gelegen zijn, inclusief de gemeenschappelijk gebruikte ruimte."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Volkstuin> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#WaterverkeerzoneShape> a shacl:NodeShape;
  rdfs:label "Waterverkeerzone"@nl;
  rdfs:comment "Gebied bedoeld om hoofdzakelijk transport via waterwegen te kunnen laten plaatsvinden, inclusief de gebieden die wezenlijk deel uitmaken van de waterwegen (vb: oevers)."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Waterverkeerzone> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#WegzoneShape> a shacl:NodeShape;
  rdfs:label "Wegzone"@nl;
  rdfs:comment "Gebied bedoeld om hoofdzakelijk voet-, fiets- en/of motorisch verkeer te kunnen laten plaatsvinden."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Wegzone> .
