  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#ParkShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Indien een verdere detaillering van parken gewenst is, bijvoorbeeld op basis van hun oppervlakte, kan gekeken worden naar de drempelwaarden voor stedelijk groen zoals gedefinieerd in het Milieurapport Vlaanderen (MIRA)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een onbebouwde en openbare ruimte omgeven door gebouwen en maakt deel uit van het stratennet van een stad of dorp."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Park"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
