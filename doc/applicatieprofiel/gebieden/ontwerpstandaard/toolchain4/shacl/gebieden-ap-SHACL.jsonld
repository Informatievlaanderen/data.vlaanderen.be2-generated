      {
        "@language": "nl",
        "@value": "Op een plein kunnen diverse activiteiten doorgaan, in aanvulling op de verkeersfunctie."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een onbebouwde en openbare ruimte, typisch omgeven door gebouwen, dat deel uitmaakt van het stratennet van een stad of gemeente."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
