<https://data.test-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#GebiedShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Gebied.Begindatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het beheergebied in gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "begindatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/gebied#begindatum>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Gebied.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het beheergebied uit gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/gebied#einddatum>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Gebied.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Een naam voor het gebied."@nl;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Gebied.Geometrie>;
    shacl:class <http://www.opengis.net/ont/sf#Polygon>;
    shacl:description "De geometrie overeenkomstig met een bepaald gebied."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Gebied> .

