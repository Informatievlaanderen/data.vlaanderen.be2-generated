<https://data.test-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#BegraafplaatsShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Begraafplaats.ActieveLijkbezorging>;
    shacl:datatype xsd:boolean;
    shacl:description "Duidt aan of er al dan niet nog aan actieve lijkbezorging gedaan wordt op de begraafplaats."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "actieve lijkbezorging"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/gebied#actieveLijkbezorging>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/gebieden/ontwerpstandaard/toolchain4#Begraafplaats.LichteRecreatie>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of de begraafplaats al dan niet geschikt is voor lichte recreatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lichte recreatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/gebied#lichteRecreatie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Begraafplaats> .

