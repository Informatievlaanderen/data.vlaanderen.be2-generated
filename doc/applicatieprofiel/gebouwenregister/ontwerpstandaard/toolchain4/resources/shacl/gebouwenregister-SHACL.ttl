<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#AdresseerbaarObjectShape> a shacl:NodeShape;
  rdfs:label "Adresseerbaar Object"@nl;
  <http://purl.org/vocab/vann/usageNote> "Is abstract, ttz het type adresseerbaar object moet altijd worden opgegeven (vb gebouweenheid, perceel)."@nl;
  rdfs:comment "Geografisch object dat met een adres kan worden geïdentificeerd."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is toegekend aan"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Adresseerbaar object waaraan het adres is toegekend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#AdresseerbaarObject.IsToegekendAan>;
    shacl:class <https://data.vlaanderen.be/ns/adres#Adres>;
    shacl:description "Adresseerbaar object waaraan het adres is toegekend."@nl;
    shacl:name "is toegekend aan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#AdresseerbaarObject.isToegekendAan>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#AdresseerbaarObject> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "postnaam"@nl;
    rdfs:comment "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Postnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#postName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Straatnaam vh adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Straatnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Straatnaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volledig adres"@nl;
    rdfs:comment "Het complete adres in één string, al dan niet geformatteerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.VolledigAdres>;
    shacl:datatype rdf:langString;
    shacl:description "Het complete adres in één string, al dan niet geformatteerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "volledig adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#fullAddress>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 1"@nl;
    rdfs:comment "Hoogste Administratieve eenheid vh adres, doorgaans een land."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.AdministratieveEenheidNiveau1>;
    shacl:datatype rdf:langString;
    shacl:description "Hoogste Administratieve eenheid vh adres, doorgaans een land."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 1"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL1>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 2"@nl;
    rdfs:comment "De regio vh adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.AdministratieveEenheidNiveau2>;
    shacl:datatype rdf:langString;
    shacl:description "De regio vh adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 2"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL2>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adresgebied"@nl;
    rdfs:comment "Naam ve geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Adresgebied>;
    shacl:datatype rdf:langString;
    shacl:description "Naam ve geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is"@nl;
    shacl:maxCount "1";
    shacl:name "adresgebied"@nl;
    shacl:path <http://www.w3.org/ns/locn#addressArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding tbv Belgische adressen."@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Gemeentenaam vh adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding tbv Belgische adressen."@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Land>;
    shacl:datatype rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatieaanduiding"@nl;
    rdfs:comment "Alfanumerieke code die de adreslocator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Locatieaanduiding>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code die de adreslocator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    shacl:name "locatieaanduiding"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorDesignator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatienaam"@nl;
    rdfs:comment "Naam of omschrijving vh het geografisch object dat de adreslocator aanduidt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Locatienaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam of omschrijving vh het geografisch object dat de adreslocator aanduidt."@nl;
    shacl:name "locatienaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postbus"@nl;
    rdfs:comment "Postbusnummer in een postkantoor."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Postbus>;
    shacl:datatype xsd:string;
    shacl:description "Postbusnummer in een postkantoor."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "postbus"@nl;
    shacl:path <http://www.w3.org/ns/locn#poBox>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verwijst naar"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit kan enkel voor Belgische adressen aangezien onder adres een Belgisch adres wordt verstaan."@nl;
    rdfs:comment "Adres waarvan de adresvoorstelling is afgeleid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Adresvoorstelling.VerwijstNaar>;
    shacl:class <https://data.vlaanderen.be/ns/adres#Adres>;
    shacl:description "Adres waarvan de adresvoorstelling is afgeleid."@nl;
    shacl:maxCount 1;
    shacl:name "verwijst naar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.verwijstNaar>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#BelgischAdresShape> a shacl:NodeShape;
  rdfs:label "Belgisch Adres"@nl;
  <http://purl.org/vocab/vann/usageNote> "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bv ingangaanduiding, trapaanduiding, verdiepaanduiding...) of een gebouwnaam of kamernaam ed zijn mogelijk dmv een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren mbv het object adresvoorstelling."@nl;
  rdfs:comment "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid, een ligplaats, een standplaats of een perceel op basis van een gemeentenaam, een straatnaam, een huisnummer en eventueel een busnummer en een postcode."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is toegekend aan"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Adresseerbaar object waaraan het adres is toegekend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#BelgischAdres.IsToegekendAan>;
    shacl:class <https://data.vlaanderen.be/ns/adres#AdresseerbaarObject>;
    shacl:description "Adresseerbaar object waaraan het adres is toegekend."@nl;
    shacl:name "is toegekend aan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adres.isToegekendAan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verwijst naar"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit kan enkel voor Belgische adressen aangezien onder adres een Belgisch adres wordt verstaan."@nl;
    rdfs:comment "Adres waarvan de adresvoorstelling is afgeleid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#BelgischAdres.VerwijstNaar>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres waarvan de adresvoorstelling is afgeleid."@nl;
    shacl:name "verwijst naar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adres.verwijstNaar>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#Adres> .

