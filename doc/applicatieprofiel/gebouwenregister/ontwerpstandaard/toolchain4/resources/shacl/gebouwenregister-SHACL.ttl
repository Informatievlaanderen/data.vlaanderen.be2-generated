<https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#2d-gebouwgeometrieShape> a shacl:NodeShape;
  rdfs:label "2D-Gebouwgeometrie"@nl;
  rdfs:comment "Geometrie van het gebouw en metadata over welk deel van het gebouw door de geometrie wordt voorgesteld en hoe deze werd bepaald."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "default"@nl;
    rdfs:comment "Geometrie die moet worden gebruikt bv bij voorstelling op kaart."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#2d-gebouwgeometrie.Default>;
    shacl:datatype xsd:boolean;
    shacl:description "Geometrie die moet worden gebruikt bv bij voorstelling op kaart."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "default"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#default>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "2D- of 2.5D-geometrische voorstelling van het gebouw."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#2d-gebouwgeometrie.Geometrie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "2D- of 2.5D-geometrische voorstelling van het gebouw."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#geometrie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "horizontale referentie"@nl;
    rdfs:comment "Aspect van het object dat door de xy-coördinaten wordt voorgesteld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#2d-gebouwgeometrie.HorizontaleReferentie>;
    shacl:class skos:Concept;
    shacl:description "Aspect van het object dat door de xy-coördinaten wordt voorgesteld."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "horizontale referentie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#horizontaleReferentie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "methode"@nl;
    rdfs:comment "Beschrijving van de manier waarop de geometrie aangemaakt werd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#2d-gebouwgeometrie.Methode>;
    shacl:class skos:Concept;
    shacl:description "Beschrijving van de manier waarop de geometrie aangemaakt werd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "methode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#methode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verticale referentie"@nl;
    rdfs:comment "Aspect van het object dat door de z-coördinaten wordt voorgesteld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#2d-gebouwgeometrie.VerticaleReferentie>;
    shacl:class skos:Concept;
    shacl:description "Aspect van het object dat door de z-coördinaten wordt voorgesteld."@nl;
    shacl:maxCount "1";
    shacl:name "verticale referentie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#verticaleReferentie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/gebouw#2DGebouwgeometrie> .

