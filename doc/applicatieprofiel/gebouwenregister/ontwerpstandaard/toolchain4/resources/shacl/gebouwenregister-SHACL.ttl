    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/gebouwenregister/ontwerpstandaard/toolchain4#Gebouw.AantalOndergrondseVerdiepingen>;
    shacl:datatype xsd:integer;
