<https://data.test-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#ActiviteitShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Activiteit.GeplandeStart>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het tijdstip waarop de activiteit gepland is om te beginnen."@nl;
    shacl:maxCount "1";
    shacl:name "geplande start"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#geplandeStart>
  ];
  shacl:targetClass prov:Activity .

