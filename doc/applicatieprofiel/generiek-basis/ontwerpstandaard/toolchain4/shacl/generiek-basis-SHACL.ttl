<https://data.test-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#ContactinfoShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Aanschrijfvorm>;
    shacl:datatype rdf:langString;
    shacl:description "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    shacl:maxCount "1";
    shacl:name "aanschrijfvorm"@nl;
    shacl:path vcard:honorific-prefix
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Contactnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van bvb de persoon die men kan contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactnaam"@nl;
    shacl:path foaf:name
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schema:email
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Fax>;
    shacl:datatype xsd:string;
    shacl:description "Faxnummer waarnaar men kan faxen."@nl;
    shacl:maxCount "1";
    shacl:name "fax"@nl;
    shacl:path schema:faxNumber
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Website>;
    shacl:datatype xsd:anyURI;
    shacl:description "Website waarnaar men kan surfen."@nl;
    shacl:maxCount "1";
    shacl:name "website"@nl;
    shacl:path foaf:page
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Openingsuren>;
    shacl:datatype rdfs:Literal;
