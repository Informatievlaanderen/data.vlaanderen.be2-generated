<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#ActiviteitShape> a shacl:NodeShape;
  rdfs:label "Activiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv het consumeren,verwerken,transformeren,wijzigen,verplaatsen,gebruiken of genereren van entiteiten."@nl;
  rdfs:comment "Handeling van bepaalde duur op of met entiteiten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geplande start"@nl;
    rdfs:comment "Het tijdstip waarop de activiteit gepland is om te beginnen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Activiteit.GeplandeStart>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het tijdstip waarop de activiteit gepland is om te beginnen."@nl;
    shacl:maxCount "1";
    shacl:name "geplande start"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#geplandeStart>
  ];
  shacl:targetClass prov:Activity .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#AdministratieveEenheidShape> a shacl:NodeShape;
  rdfs:label "Administratieve Eenheid"@nl;
  rdfs:comment "Bestuurlijke eenheid waar een lidstaat rechtsbevoegdheid heeft en/of uitoefent, in het kader van lokaal, regionaal of nationaal bestuur."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek#AdministratieveEenheid> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv als attribuut ve persoon of gebouw... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#BewerkingstypeShape> a shacl:NodeShape;
  rdfs:label "Bewerkingstype";
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Aard vd bewerking die ihkv een activiteit op een entiteit wordt uitgevoerd."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#BooleanShape> a shacl:NodeShape;
  rdfs:label "Boolean";
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanschrijfvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb De heer/Mevrouw, Excellentie, Dokter..."@nl;
    rdfs:comment "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Aanschrijfvorm>;
    shacl:datatype rdf:langString;
    shacl:description "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    shacl:maxCount "1";
    shacl:name "aanschrijfvorm"@nl;
    shacl:path vcard:honorific-prefix
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam van bvb de persoon die men kan contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Contactnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van bvb de persoon die men kan contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactnaam"@nl;
    shacl:path foaf:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schema:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "fax"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Faxnummer waarnaar men kan faxen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Fax>;
    shacl:datatype xsd:string;
    shacl:description "Faxnummer waarnaar men kan faxen."@nl;
    shacl:maxCount "1";
    shacl:name "fax"@nl;
    shacl:path schema:faxNumber
  ], [
    a shacl:PropertyShape;
    rdfs:label "openingsuren"@nl;
    <http://purl.org/vocab/vann/usageNote> "Syntax volgens schema.org voor openingsuren. Bv als contact kan worden opgenomen tussen 8 en 20u maandag tot zaterdag en tussen 8 en 18u op zondag wordt dit gecodeerd als Ma-za 08:00-20:00, zo 08:00-18:00."@nl;
    rdfs:comment "Uren waarbinnen contact kan worden opgenomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Openingsuren>;
    shacl:datatype rdfs:Literal;
    shacl:description "Uren waarbinnen contact kan worden opgenomen."@nl;
    shacl:maxCount "1";
    shacl:name "openingsuren"@nl;
    shacl:path schema:openingHours
  ], [
    a shacl:PropertyShape;
    rdfs:label "website"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Website waarnaar men kan surfen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Website>;
    shacl:datatype xsd:anyURI;
    shacl:description "Website waarnaar men kan surfen."@nl;
    shacl:maxCount "1";
    shacl:name "website"@nl;
    shacl:path foaf:page
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven of bezoeken."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbaarheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv aanduiding van het seizoen waarin contact kan worden opgenomen. Begin- en einddatum volgens ISO8601 syntax."@nl;
    rdfs:comment "Periode waarin contact kan worden opgenomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Beschikbaarheid>;
    shacl:class schemas:OpeningHoursSpecification;
    shacl:description "Periode waarin contact kan worden opgenomen."@nl;
    shacl:maxCount "1";
    shacl:name "beschikbaarheid"@nl;
    shacl:path schema:hoursAvailable
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Contactinfo.Telefoon>;
    shacl:class schemas:OpeningHoursSpecification;
    shacl:description "Telefoonnummer waarop men kan bellen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schema:telephone
  ];
  shacl:targetClass schema:ContactPoint .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#CreatieShape> a shacl:NodeShape;
  rdfs:label "Creatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "De entiteit bestond niet voorafgaand aan de creatie en is daarna beschikbaar voor gebruik."@nl;
  rdfs:comment "Het voltooien vd productie ve nieuwe entiteit dmv een activiteit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "tijdstip"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Tijdstip waarop de creatie vd entiteit plaatsvond."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Creatie.Tijdstip>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de creatie vd entiteit plaatsvond."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "tijdstip"@nl;
    shacl:path prov:atTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "activiteit"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Activiteit die tot de creatie vd entiteit heeft geleid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Creatie.Activiteit>;
    shacl:class prov:Activity;
    shacl:description "Activiteit die tot de creatie vd entiteit heeft geleid."@nl;
    shacl:maxCount "1";
    shacl:name "activiteit"@nl;
    shacl:path prov:activity
  ];
  shacl:targetClass prov:Generation .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#DocumentShape> a shacl:NodeShape;
  rdfs:label "Document"@nl;
  rdfs:comment "Een origineel werk in de brede zin (een verslag, een opname, een boek...)."@nl;
  shacl:closed false;
  shacl:targetClass foaf:Document .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#DocumentonderdeelShape> a shacl:NodeShape;
  rdfs:label "Documentonderdeel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv artikel,hoofdstuk,paragraaf..."@nl;
  rdfs:comment "Een apart onderdeel van een groter document of verzameld document."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "nummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv nummer vh artikel, paragraaf, hoofdstuk..."@nl;
    rdfs:comment "Nummer vh documentonderdeel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Documentonderdeel.Nummer>;
    shacl:datatype xsd:integer;
    shacl:description "Nummer vh documentonderdeel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "nummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#nummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv artikel, paragraaf, hoofdstuk..."@nl;
    rdfs:comment "Aard van het documentonderdeel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Documentonderdeel.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van het documentonderdeel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "is deel van"@nl;
    rdfs:comment "Een verwante bron waarin de beschreven bron fysiek of logisch is opgenomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generiek-basis/ontwerpstandaard/toolchain4#Documentonderdeel.IsDeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#DocumentOnderdeel>;
    shacl:description "Een verwante bron waarin de beschreven bron fysiek of logisch is opgenomen."@nl;
    shacl:name "is deel van"@nl;
    shacl:path dc:isPartOf
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek#DocumentOnderdeel> .

