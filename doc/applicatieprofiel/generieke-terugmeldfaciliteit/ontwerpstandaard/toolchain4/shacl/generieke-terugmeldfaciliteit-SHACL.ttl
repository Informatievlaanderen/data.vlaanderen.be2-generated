<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#ApplicatieShape> a shacl:NodeShape;
  rdfs:label "Applicatie"@nl;
  rdfs:comment "Een artificiële agent in een softwareomgeving."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/melding#Applicatie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#BooleanShape> a shacl:NodeShape;
  rdfs:label "Boolean";
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#ConceptShape> a shacl:NodeShape;
  rdfs:label "Concept"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het is aangeraden de mogelijke waarden voor de stellen als een skos:ConceptScheme (https://www.w3.org/TR/skos-primer/)"@nl;
  rdfs:comment "Een mogelijke waarde voor de Eigenschap."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "label"@nl;
    rdfs:comment "Het geprefereerde label voor het Concept."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Concept.Label>;
    shacl:datatype xsd:string;
    shacl:description "Het geprefereerde label voor het Concept."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "label"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "bronhouder"@nl;
    <http://purl.org/vocab/vann/usageNote> "In dit geval is de bronhouder enkel verantwoordelijk voor een bepaald veld in de dataset. De melding kan naar de desbetreffende organisatie gedispatched worden indien het meldingsobject betrekking heeft op deze eigenschap."@nl;
    rdfs:comment "De bronhouder is verantwoordelijk voor het opnemen van gegevens in de dataset en het bewaken van de kwaliteit daarvan."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Concept.Bronhouder>;
    shacl:class <https://www.w3.org/ns/org#Organization>;
    shacl:description "De bronhouder is verantwoordelijk voor het opnemen van gegevens in de dataset en het bewaken van de kwaliteit daarvan."@nl;
    shacl:maxCount 1;
    shacl:name "bronhouder"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#bronhouder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "mogelijke waarden"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het is aangeraden de mogelijke waarden voor te stellen als een skos:ConceptScheme (https://www.w3.org/TR/skos-primer/)"@nl;
    rdfs:comment "Associeert de Eigenschap met een exhaustieve lijst aan mogelijk waarden (bv. een codelijst)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Concept.MogelijkeWaarden>;
    shacl:class <https://data.vlaanderen.be/ns/melding#Eigenschap>;
    shacl:description "Associeert de Eigenschap met een exhaustieve lijst aan mogelijk waarden (bv. een codelijst)."@nl;
    shacl:minCount 1;
    shacl:name "mogelijke waarden"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#Concept.mogelijkeWaarden>
  ];
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#DatasetShape> a shacl:NodeShape;
  rdfs:label "Dataset"@nl;
  rdfs:comment "De Dataset klasse beschrijft de gegevensbron waarop de terugmelding betrekking heeft."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een beschrijving van de Dataset."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Dataset.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Een beschrijving van de Dataset."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "De titel van een Dataset."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Dataset.Titel>;
    shacl:datatype xsd:string;
    shacl:description "De titel van een Dataset."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftBron"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit attribuut is relevant in het kader van meldingen op concrete informatievelden zoals foutieve of ontbrekende gegevens (terugmeldingen)."@nl;
    rdfs:comment "De bron (Dataset) waar het Meldingsobject in voor komt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Dataset.Heeftbron>;
    shacl:class <https://data.vlaanderen.be/ns/melding#Meldingsobject>;
    shacl:description "De bron (Dataset) waar het Meldingsobject in voor komt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeftBron"@nl;
    shacl:path oa:hasSource
  ], [
    a shacl:PropertyShape;
    rdfs:label "bronhouder"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een dataset kan meerdere bronhouders hebben in geval van decentraal beheer."@nl;
    rdfs:comment "De bronhouder is verantwoordelijk voor het opnemen van gegevens in de dataset en het bewaken van de kwaliteit daarvan."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Dataset.Bronhouder>;
    shacl:class <https://www.w3.org/ns/org#Organization>;
    shacl:description "De bronhouder is verantwoordelijk voor het opnemen van gegevens in de dataset en het bewaken van de kwaliteit daarvan."@nl;
    shacl:maxCount 1;
    shacl:name "bronhouder"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#bronhouder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eigenschap"@nl;
    rdfs:comment "Verwijst naar de Eigenschap die deel uitmaakt van de Dataset."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Dataset.Eigenschap>;
    shacl:class <https://data.vlaanderen.be/ns/melding#Eigenschap>;
    shacl:description "Verwijst naar de Eigenschap die deel uitmaakt van de Dataset."@nl;
    shacl:name "eigenschap"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#Dataset.eigenschap>
  ];
  shacl:targetClass dcmitype:Dataset .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#EigenschapShape> a shacl:NodeShape;
  rdfs:label "Eigenschap"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het kader van meldingen met betrekking op informatievelden met foutieve of ontbrekende gegevens kan de Eigenschap klasse gebruikt worden om voor elke Dataset weer te geven op welke informatievelden kan teruggemeld worden. Elke Eigenschap kan worden toegewezen aan een andere Organisatie die verantwoordelijk is voor het verwerken van de feedback."@nl;
  rdfs:comment "De klasse voor het beschrijven van de data velden waaruit een dataset bestaat."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "label"@nl;
    rdfs:comment "Een label voor de Eigenschap."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Eigenschap.Label>;
    shacl:datatype xsd:string;
    shacl:description "Een label voor de Eigenschap."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "label"@nl;
    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "meldbaar"@nl;
    rdfs:comment "Geeft aan of op de eigenschap kan teruggemeld worden (true) of deze louter ter informatie van de gebruiker wordt getoond (false)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Eigenschap.Meldbaar>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of op de eigenschap kan teruggemeld worden (true) of deze louter ter informatie van de gebruiker wordt getoond (false)."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "meldbaar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#meldbaar>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verplicht"@nl;
    rdfs:comment "True als de eigenschap verplicht mee te sturen is ter informatie van de behandelaar en bronhouder, anders false."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Eigenschap.Verplicht>;
    shacl:datatype xsd:boolean;
    shacl:description "True als de eigenschap verplicht mee te sturen is ter informatie van de behandelaar en bronhouder, anders false."@nl;
    shacl:maxCount "1";
    shacl:name "verplicht"@nl;
    shacl:path <https://www.w3.org/ns/hydra/core#required>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verplicht"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik bij voorkeur een regular expression of primitief datatype zoals een integer, boolean, floating-point nummer, string... Dit geldt als een beperking voor de voorgestelde waarde van een Meldingsobject Attribuut."@nl;
    rdfs:comment "True als de eigenschap verplicht mee te geven is, anders false."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Eigenschap.Verplicht>;
    shacl:datatype xsd:string;
    shacl:description "True als de eigenschap verplicht mee te geven is, anders false."@nl;
    shacl:maxCount "1";
    shacl:name "verplicht"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#verwachtType>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eigenschap"@nl;
    rdfs:comment "Verwijst naar de Eigenschap die deel uitmaakt van de Dataset."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Eigenschap.Eigenschap>;
    shacl:class dcmitype:Dataset;
    shacl:description "Verwijst naar de Eigenschap die deel uitmaakt van de Dataset."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "eigenschap"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#Eigenschap.eigenschap>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bronhouder"@nl;
    <http://purl.org/vocab/vann/usageNote> "In dit geval is de bronhouder enkel verantwoordelijk voor een bepaald veld in de dataset. De melding kan naar de desbetreffende organisatie gedispatched worden indien het meldingsobject betrekking heeft op deze eigenschap."@nl;
    rdfs:comment "De bronhouder is verantwoordelijk voor het opnemen van gegevens in de dataset en het bewaken van de kwaliteit daarvan."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Eigenschap.Bronhouder>;
    shacl:class <https://www.w3.org/ns/org#Organization>;
    shacl:description "De bronhouder is verantwoordelijk voor het opnemen van gegevens in de dataset en het bewaken van de kwaliteit daarvan."@nl;
    shacl:maxCount 1;
    shacl:name "bronhouder"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#bronhouder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "mogelijke waarden"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het is aangeraden de mogelijke waarden voor te stellen als een skos:ConceptScheme (https://www.w3.org/TR/skos-primer/)"@nl;
    rdfs:comment "Associeert de Eigenschap met een exhaustieve lijst aan mogelijk waarden (bv. een codelijst)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Eigenschap.MogelijkeWaarden>;
    shacl:class skos:Concept;
    shacl:description "Associeert de Eigenschap met een exhaustieve lijst aan mogelijk waarden (bv. een codelijst)."@nl;
    shacl:name "mogelijke waarden"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#Eigenschap.mogelijkeWaarden>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/melding#Eigenschap> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#GeometrieShape> a shacl:NodeShape;
  rdfs:label "Geometrie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijft deze kenmerken dmv punten,lijnen,polygonen en coördinaten."@nl;
  rdfs:comment "Vorm- en positiekenmerken van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gml"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#gmlLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in gml-formaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Geometrie.Gml>;
    shacl:description "Geometrie uitgedrukt in gml-formaat."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gml"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.opengis.net/ont/geosparql#asGML>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wkt"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#wktLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in wkt-formaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Geometrie.Wkt>;
    shacl:description "Geometrie uitgedrukt in wkt-formaat."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "wkt"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.opengis.net/ont/geosparql#asWKT>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Geometry> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#GeregistreerdPersoonShape> a shacl:NodeShape;
  rdfs:label "Geregistreerd Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb naam en voornaam) en de Verblijfplaats vd persoon en op belangrijke levensgebeurtenissen zoals geboor"@nl;
  rdfs:comment "Persoon waarvan de gegevens zijn ingeschreven in een register."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    rdfs:comment "Identificatiecode van de persoon in het register."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#GeregistreerdPersoon.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificatiecode van de persoon in het register."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <http://data.vlaanderen.be/ns/persoon#registratie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#HoedanigheidShape> a shacl:NodeShape;
  rdfs:label "Hoedanigheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Laat een Functie toe om te handelen,bv ihkv een Dienstverlening (bv diversiteitsplan wordt opgemaakt door diversieteitsambtenaar)."@nl;
  rdfs:comment "Agent met een Functie."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/organisatie#Hoedanigheid> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#MeldingBodyShape> a shacl:NodeShape;
  rdfs:label "Melding Body"@nl;
  rdfs:comment "De body van de Melding,deze omvat relevante informatie voor de verdere afhandeling van een melding."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap kan gebruikt worden om extra beschrijvende tekst mee te geven over het Meldingsobject."@nl;
    rdfs:comment "Een tekstuele beschrijving van de melding."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#MeldingBody.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Een tekstuele beschrijving van de melding."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "bijlage"@nl;
    <http://purl.org/vocab/vann/usageNote> "Via deze eigenschap is het mogelijk om bv. Foto's of PDF documenten te koppelen aan de Melding."@nl;
    rdfs:comment "Identificeert een resource die aan de MeldingsBody verbonden is en mogelijks speciale verwerking vraagt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#MeldingBody.Bijlage>;
    shacl:datatype xsd:anyURI;
    shacl:description "Identificeert een resource die aan de MeldingsBody verbonden is en mogelijks speciale verwerking vraagt."@nl;
    shacl:maxCount "1";
    shacl:name "bijlage"@nl;
    shacl:path as:attachment
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Wanneer een Agent een Melding aanmaakt kan deze bv. een bounding box tekenen op een map. De geometrie hiervan kan weegegeven worden via de eigenschap geometrie van MeldingBody."@nl;
    rdfs:comment "De relatie tussen de MeldingBody en een geometrie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#MeldingBody.Geometrie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "De relatie tussen de MeldingBody en een geometrie."@nl;
    shacl:maxCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/melding#MeldingBody> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#MeldingsobjectAttribuutShape> a shacl:NodeShape;
