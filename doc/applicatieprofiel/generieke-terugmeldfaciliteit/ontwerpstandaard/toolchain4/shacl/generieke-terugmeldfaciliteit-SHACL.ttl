<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#TijdtoestandShape> a shacl:NodeShape;
  rdfs:label "TijdToestand"@nl;
  rdfs:comment "Een TijdToestand legt de datum en het tijdstip vast waarop het Meldingsobject dient geïnterpreteerd te worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "cached bron"@nl;
    rdfs:comment "Een cached momentopname van de bron op het moment van de vaststelling van de fout of onvolledigheid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Tijdtoestand.CachedBron>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een cached momentopname van de bron op het moment van de vaststelling van de fout of onvolledigheid."@nl;
    shacl:maxCount "1";
    shacl:name "cached bron"@nl;
    shacl:path oa:cachedSource
  ], [
    a shacl:PropertyShape;
    rdfs:label "datum vaststelling"@nl;
    rdfs:comment "De datum en het tijdstip waarop het Meldingsobject moet geïnterpreteerd worden als zijnde van toepassing op de Melding."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Tijdtoestand.DatumVaststelling>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum en het tijdstip waarop het Meldingsobject moet geïnterpreteerd worden als zijnde van toepassing op de Melding."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum vaststelling"@nl;
    shacl:path oa:sourceDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft toestand"@nl;
    rdfs:comment "De relatie tussen het Meldingsobject en een TijdToestand."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Tijdtoestand.HeeftToestand>;
    shacl:class <https://data.vlaanderen.be/ns/melding#Meldingsobject>;
    shacl:description "De relatie tussen het Meldingsobject en een TijdToestand."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft toestand"@nl;
    shacl:path oa:hasState
  ];
  shacl:targetClass oa:TimeState .

