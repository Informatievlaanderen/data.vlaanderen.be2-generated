<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Organisatie-eenheidShape> a shacl:NodeShape;
  rdfs:label "Organisatie-eenheid"@nl;
  rdfs:comment "Een organisatie zoals een afdeling of dienst die deel uitmaakt van de grotere organisatie en zijn bestaansreden daaraan ontleent. Heeft geen juridische status op zich."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is eenheid van"@nl;
    rdfs:comment "Organisatie waarvan de organisatie-eenheid deel uitmaakt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Organisatie-eenheid.IsEenheidVan>;
    shacl:class <https://www.w3.org/ns/org#Organization>;
    shacl:description "Organisatie waarvan de organisatie-eenheid deel uitmaakt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is eenheid van"@nl;
    shacl:path org:unitOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft eenheid"@nl;
    rdfs:comment "Verwijst naar een organisatie-eenheid die deel uitmaakt van de organisatie, bv een afdeling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Organisatie-eenheid.HeeftEenheid>;
    shacl:class <https://www.w3.org/ns/org#Organization>;
    shacl:description "Verwijst naar een organisatie-eenheid die deel uitmaakt van de organisatie, bv een afdeling."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft eenheid"@nl;
    shacl:path org:hasUnit
  ];
  shacl:targetClass org:OrganizationalUnit .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaanreden die de individuele leden ervan overstijgt en kan handelen als Agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is eenheid van"@nl;
    rdfs:comment "Organisatie waarvan de organisatie-eenheid deel uitmaakt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Organisatie.IsEenheidVan>;
    shacl:class org:OrganizationalUnit;
    shacl:description "Organisatie waarvan de organisatie-eenheid deel uitmaakt."@nl;
    shacl:name "is eenheid van"@nl;
    shacl:path org:unitOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft eenheid"@nl;
    rdfs:comment "Verwijst naar een organisatie-eenheid die deel uitmaakt van de organisatie, bv een afdeling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Organisatie.HeeftEenheid>;
    shacl:class org:OrganizationalUnit;
    shacl:description "Verwijst naar een organisatie-eenheid die deel uitmaakt van de organisatie, bv een afdeling."@nl;
    shacl:name "heeft eenheid"@nl;
    shacl:path org:hasUnit
  ], [
    a shacl:PropertyShape;
    rdfs:label "meldingsorganisatie"@nl;
    rdfs:comment "De organisatie die verantwoordelijk is voor de applicatie die werd gebruikt voor de creatie van de melding."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Organisatie.Meldingsorganisatie>;
    shacl:class <https://data.vlaanderen.be/ns/melding#Terugmelding>;
    shacl:description "De organisatie die verantwoordelijk is voor de applicatie die werd gebruikt voor de creatie van de melding."@nl;
    shacl:name "meldingsorganisatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#Organisatie.meldingsorganisatie>
  ];
  shacl:targetClass <https://www.w3.org/ns/org#Organization> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke Organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#PubliekeOrganisatieShape> a shacl:NodeShape;
  rdfs:label "Publieke Organisatie"@nl;
  rdfs:comment "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector,ongeacht het bestuursniveau waarop dat kader van kracht is."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/m8g/PublicOrganisation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#TerugmeldingShape> a shacl:NodeShape;
  rdfs:label "Terugmelding"@nl;
  rdfs:comment "Een terugmelding kan gebruikt worden om bijvoorbeeld een foutief adres te melden op een website of een fout in de digitale weergave van een diploma."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "samenvatting"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap kan gebruikt worden als een tekstveld om de Melding en de informatie die eraan gekoppeld is samen te vatten en de behandeling ervan te vergemakkelijken."@nl;
    rdfs:comment "Een samenvatting van de Melding."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Terugmelding.Samenvatting>;
    shacl:datatype xsd:string;
    shacl:description "Een samenvatting van de Melding."@nl;
    shacl:maxCount "1";
    shacl:name "samenvatting"@nl;
    shacl:path as:summary
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "De titel van de Melding."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Terugmelding.Titel>;
    shacl:datatype xsd:string;
    shacl:description "De titel van de Melding."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "webpagina"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap kan gebruikt worden om een gebruiker door te verwijzen naar een applicatie waar de actuele status van de Melding kan geraadpleegd worden."@nl;
    rdfs:comment "Een doorverwijzing naar een webpagina over deze Melding."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Terugmelding.Webpagina>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een doorverwijzing naar een webpagina over deze Melding."@nl;
    shacl:maxCount "1";
    shacl:name "webpagina"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#webpagina>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft body"@nl;
    rdfs:comment "Het object van deze associatie is een resource die de body van de Melding beschrijft (MeldingBody)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Terugmelding.HeeftBody>;
    shacl:class <https://data.vlaanderen.be/ns/melding#MeldingBody>;
    shacl:description "Het object van deze associatie is een resource die de body van de Melding beschrijft (MeldingBody)."@nl;
    shacl:name "heeft body"@nl;
    shacl:path oa:hasBody
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft status"@nl;
    rdfs:comment "De Status verbonden aan de Melding."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Terugmelding.HeeftStatus>;
    shacl:class <https://data.vlaanderen.be/ns/melding#Meldingstatus>;
    shacl:description "De Status verbonden aan de Melding."@nl;
    shacl:name "heeft status"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#heeftStatus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "meldingstype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Er wordt verwacht dat het meldingstype gedefinieerd is in een codelijst. Het bepalen en ontlsuiten van deze codelijst kan applicatie-specifiek worden ingevuld."@nl;
