    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Meldingstatus.Statusdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum van een Status."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "statusdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#statusdatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Er wordt verwacht dat het status type gedefinieerd is in een codelijst. Het bepalen en ontlsuiten van deze codelijst kan applicatie-specifiek worden ingevuld. Als voorbeeld werd de GTMF status codelijst voorzien."@nl;
    rdfs:comment "Het type van de Status."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Meldingstatus.StatusType>;
    shacl:class skos:Concept;
    shacl:description "Het type van de Status."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "status type"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#statuswaarde>
  ], [
    a shacl:PropertyShape;
    rdfs:label "statuswijziging door"@nl;
    rdfs:comment "De Agent die deze status heeft geactiveerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Meldingstatus.StatuswijzigingDoor>;
    shacl:class dc:Agent;
    shacl:description "De Agent die deze status heeft geactiveerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "statuswijziging door"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#statuswijzigingDoor>
  ];
