<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#MeldingsobjectShape> a shacl:NodeShape;
  rdfs:label "Meldingsobject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het model beschrijft geen attributen voor het Meldingsobject. In de praktijk kan het Meldingsobject beschreven worden aan de hand van instanties van de klasse Eigenschap."@nl;
  rdfs:comment "Het Meldingsobject identificeert een resource,een specifiek deel van een resource,een bepaalde representatie van een resource of een combinatie hiervan welke gebruikt wordt binnen de Melding."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gerelateerde body"@nl;
    <http://purl.org/vocab/vann/usageNote> "Indien de Melding meerdere Meldingsobjecten bevat biedt deze eigenschap de mogelijkheid om te beschrijven welke MeldingBody relevant is voor de behandeling van het Meldingsobject."@nl;
    rdfs:comment "De body van de Melding die betrekking heeft op het Meldingsobject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Meldingsobject.GerelateerdeBody>;
    shacl:class <https://data.vlaanderen.be/ns/melding#Codelijst>;
    shacl:description "De body van de Melding die betrekking heeft op het Meldingsobject."@nl;
    shacl:maxCount "1";
    shacl:name "gerelateerde body"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#gerelateerdeBody>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft eigenschap"@nl;
    rdfs:comment "Refereert naar een Eigenschap die deel uitmaakt van het Meldingsobject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Meldingsobject.HeeftEigenschap>;
    shacl:class <https://data.vlaanderen.be/ns/melding#MeldingsobjectAttribuut>;
    shacl:description "Refereert naar een Eigenschap die deel uitmaakt van het Meldingsobject."@nl;
    shacl:name "heeft eigenschap"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#heeftEigenschap>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Wanneer voor de melding meerdere Meldingsobjecten werden meegegeven die elk door andere Agents worden afgehandeld laat deze eigenschap toe om per Meldingsobject een status mee te geven. De Status van de Melding kan pas behandeld zijn als alle Meldingsobjecten behandeld werden."@nl;
    rdfs:comment "De Status verbonden aan het Meldingsobject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Meldingsobject.HeeftStatus>;
    shacl:class <https://data.vlaanderen.be/ns/melding#Meldingstatus>;
    shacl:description "De Status verbonden aan het Meldingsobject."@nl;
    shacl:name "heeft status"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#heeftStatus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "behandelaar"@nl;
    rdfs:comment "Agent die werd aangewezen om het meldingsobject op te volgen en af te handelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Meldingsobject.Behandelaar>;
    shacl:class <https://www.w3.org/ns/org#Organization>;
    shacl:description "Agent die werd aangewezen om het meldingsobject op te volgen en af te handelen."@nl;
    shacl:minCount 1;
    shacl:name "behandelaar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#behandelaar>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft toestand"@nl;
    rdfs:comment "De relatie tussen het Meldingsobject en een TijdToestand."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Meldingsobject.HeeftToestand>;
    shacl:class oa:TimeState;
    shacl:description "De relatie tussen het Meldingsobject en een TijdToestand."@nl;
    shacl:maxCount 1;
    shacl:name "heeft toestand"@nl;
    shacl:path oa:hasState
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft doelwit"@nl;
    rdfs:comment "De relatie tussen de Melding en het doelwit, het Meldingsobject waarop de melding slaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Meldingsobject.HeeftDoelwit>;
    shacl:class <https://data.vlaanderen.be/ns/melding#Terugmelding>;
    shacl:description "De relatie tussen de Melding en het doelwit, het Meldingsobject waarop de melding slaat."@nl;
    shacl:minCount 1;
    shacl:name "heeft doelwit"@nl;
    shacl:path oa:hasTarget
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftBron"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit attribuut is relevant in het kader van meldingen op concrete informatievelden zoals foutieve of ontbrekende gegevens (terugmeldingen)."@nl;
    rdfs:comment "De bron (Dataset) waar het Meldingsobject in voor komt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#Meldingsobject.Heeftbron>;
    shacl:class dcmitype:Dataset;
    shacl:description "De bron (Dataset) waar het Meldingsobject in voor komt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeftBron"@nl;
    shacl:path oa:hasSource
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/melding#Meldingsobject> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/generieke-terugmeldfaciliteit/ontwerpstandaard/toolchain4#MeldingstatusShape> a shacl:NodeShape;
  rdfs:label "Meldingstatus"@nl;
  <http://purl.org/vocab/vann/usageNote> "De Melding kan gelinkt zijn aan meerdere Status objecten,elk ervan geeft de status op een bepaald tijdstip weer."@nl;
  rdfs:comment "De Status van de Melding in het verwerkingsproces op een bepaald tijdstip."@nl;
