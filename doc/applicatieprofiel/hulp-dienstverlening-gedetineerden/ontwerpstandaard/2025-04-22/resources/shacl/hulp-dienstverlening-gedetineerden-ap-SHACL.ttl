<https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#RealisatorShape> a shacl:NodeShape;
  rdfs:label "Realisator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Met deze klasse wordt verwezen naar alle personen of organisaties die bijgedragen hebben aan het organiseren en plaatsvinden van een Aanbod ongeacht hun rol daarin."@nl;
  rdfs:comment "Persoon of Organisatie die een Aanbod realiseert."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "realisator beleidsveld"@nl;
    rdfs:comment "Specifiek gebied van overheidsbeleid waarin verschillende diensten en agentschappen samenwerken om beleidsdoelen te bereiken. Elk beleidsveld omvat een departement dat verantwoordelijk is voor beleidsvoorbereiding en -ondersteuning, en een of meer agentschappen die de beleidsuitvoering verzorgen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Realisator.RealisatorBeleidsveld>;
    shacl:class skos:Concept;
    shacl:description "Specifiek gebied van overheidsbeleid waarin verschillende diensten en agentschappen samenwerken om beleidsdoelen te bereiken. Elk beleidsveld omvat een departement dat verantwoordelijk is voor beleidsvoorbereiding en -ondersteuning, en een of meer agentschappen die de beleidsuitvoering verzorgen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "realisator beleidsveld"@nl;
    shacl:path <https://data.vlaanderen.be/ns/hulp-dienstverlening-gedetineerden#Realisator.beleidsveld>
  ], [
    a shacl:PropertyShape;
    rdfs:label "realisatie"@nl;
    rdfs:comment "Realisaties waartoe de Realisator bijdraagt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Realisator.Realisatie>;
    shacl:class <https://data.vlaanderen.be/ns/cultuurparticipatie#Realisatie>;
    shacl:description "Realisaties waartoe de Realisator bijdraagt."@nl;
    shacl:name "realisatie"@nl;
    shacl:path prov:wasAssociateFor
  ], [
    a shacl:PropertyShape;
    rdfs:label "gefinancierd door"@nl;
