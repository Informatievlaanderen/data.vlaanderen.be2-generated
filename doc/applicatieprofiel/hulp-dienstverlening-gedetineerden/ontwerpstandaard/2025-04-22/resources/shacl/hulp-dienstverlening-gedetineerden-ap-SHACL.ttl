<https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#AanbodShape> a shacl:NodeShape;
  rdfs:label "Aanbod"@nl;
  rdfs:comment "Het aanbieden van één of meer activiteiten voor gedetineerden rond een specifiek onderwerp of thema."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "taal"@nl;
    <http://purl.org/vocab/vann/usageNote> "Indien de Activiteit in verschillende talen wordt aangeboden, moeten verschillende instanties van Activiteit gebruikt worden."@nl;
    rdfs:comment "Taal waarin het Aanbod doorgaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.Taal>;
    shacl:description "Taal waarin het Aanbod doorgaat."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "taal"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path dc:language
  ], [
    a shacl:PropertyShape;
    rdfs:label "aantal aanmeldingen"@nl;
    <http://purl.org/vocab/vann/usageNote> "Geldige aanmeldingen zijn gedetineerden die voldoen aan de eventuele voorwaarden die van toepassing zijn."@nl;
    rdfs:comment "Aantal gedetineerden die zich hebben aangemeld voor een aanbod. Hierbij kunnen ook aanmeldingen vervat zitten die uiteindelijk niet leiden tot een deelname aan een activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.AantalAanmeldingen>;
    shacl:datatype xsd:integer;
    shacl:description "Aantal gedetineerden die zich hebben aangemeld voor een aanbod. Hierbij kunnen ook aanmeldingen vervat zitten die uiteindelijk niet leiden tot een deelname aan een activiteit."@nl;
    shacl:maxCount "1";
    shacl:name "aantal aanmeldingen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/hulp-dienstverlening-gedetineerden#Aanbod.aantalAanmeldingenDoorGedetineerden>
  ], [
    a shacl:PropertyShape;
    rdfs:label "maximum aantal deelnemers"@nl;
    rdfs:comment "Maximum aantal gedetineerden die kunnen deelnemen aan het Aanbod."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.MaximumAantalDeelnemers>;
    shacl:datatype xsd:integer;
    shacl:description "Maximum aantal gedetineerden die kunnen deelnemen aan het Aanbod."@nl;
    shacl:maxCount "1";
    shacl:name "maximum aantal deelnemers"@nl;
    shacl:path <https://data.vlaanderen.be/ns/hulp-dienstverlening-gedetineerden#Activiteit.maxAantalDeelnemers>
  ], [
    a shacl:PropertyShape;
    rdfs:label "minimum aantal deelnemers"@nl;
    rdfs:comment "Minimum aantal gedetineerden die deelnemen voor het Aanbod kan plaatsvinden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.MinimumAantalDeelnemers>;
    shacl:datatype xsd:integer;
    shacl:description "Minimum aantal gedetineerden die deelnemen voor het Aanbod kan plaatsvinden."@nl;
    shacl:maxCount "1";
    shacl:name "minimum aantal deelnemers"@nl;
    shacl:path <https://data.vlaanderen.be/ns/hulp-dienstverlening-gedetineerden#Activiteit.minAantalDeelnemers>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een tekstuele beschrijving van het Aanbod."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "Een tekstuele beschrijving van het Aanbod."@nl;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "medium"@nl;
    rdfs:comment "Manier waarop het Aanbod plaatsvindt zoals bijvoorbeeld online, fysiek, of hybride."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.Medium>;
    shacl:class skos:Concept;
    shacl:description "Manier waarop het Aanbod plaatsvindt zoals bijvoorbeeld online, fysiek, of hybride."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "medium"@nl;
    shacl:path <https://data.vlaanderen.be/ns/hulp-dienstverlening-gedetineerden#medium>
  ], [
    a shacl:PropertyShape;
    rdfs:label "categorie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit kunnen bijvoorbeeld balsporten of taallessen zijn."@nl;
    rdfs:comment "De classificatie van het Aanbod."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.Categorie>;
    shacl:class skos:Concept;
    shacl:description "De classificatie van het Aanbod."@nl;
    shacl:minCount "1";
    shacl:name "categorie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/hulp-dienstverlening-gedetineerden#categorie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanbod beleidsveld"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voorbeelden van Vlaamse beleidsvelden zijn “Onderwijs“, “Vorming”, “Cultuur“, “Sport“, “Jeugd“, of “Media”."@nl;
    rdfs:comment "Specifiek gebied van overheidsbeleid waarin verschillende diensten en agentschappen samenwerken om beleidsdoelen te bereiken. Elk beleidsveld omvat een departement dat verantwoordelijk is voor beleidsvoorbereiding en -ondersteuning, en een of meer agentschappen die de beleidsuitvoering verzorgen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.AanbodBeleidsveld>;
    shacl:class skos:Concept;
    shacl:description "Specifiek gebied van overheidsbeleid waarin verschillende diensten en agentschappen samenwerken om beleidsdoelen te bereiken. Elk beleidsveld omvat een departement dat verantwoordelijk is voor beleidsvoorbereiding en -ondersteuning, en een of meer agentschappen die de beleidsuitvoering verzorgen."@nl;
    shacl:minCount "1";
    shacl:name "aanbod beleidsveld"@nl;
    shacl:path <https://data.vlaanderen.be/ns/hulp-dienstverlening-gedetineerden#Aanbod.beleidsveld>
  ], [
    a shacl:PropertyShape;
    rdfs:label "intake"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een intake wordt gebruikt om na te gaan of er een match is tussen het aanbod en de persoon die zich heeft aangemeld."@nl;
    rdfs:comment "Het type intake dat plaatsvindt voor een aanbod. Dit kan ook \"geen intake\" zijn."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.Intake>;
    shacl:class skos:Concept;
    shacl:description "Het type intake dat plaatsvindt voor een aanbod. Dit kan ook \"geen intake\" zijn."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "intake"@nl;
    shacl:path <https://data.vlaanderen.be/ns/hulp-dienstverlening-gedetineerden#intake>
  ], [
    a shacl:PropertyShape;
    rdfs:label "participatiegraad"@nl;
    rdfs:comment "Geeft aan in welke mate de gedetineerden betrokken zijn bij de organisatie en realisatie van een Aanbod."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.Participatiegraad>;
    shacl:class skos:Concept;
    shacl:description "Geeft aan in welke mate de gedetineerden betrokken zijn bij de organisatie en realisatie van een Aanbod."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "participatiegraad"@nl;
    shacl:path <https://data.vlaanderen.be/ns/hulp-dienstverlening-gedetineerden#participatiegraad>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van het Aanbod."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.Naam>;
    shacl:class rdf:langString;
    shacl:description "Naam van het Aanbod."@nl;
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "doelgroep"@nl;
    rdfs:comment "Groep van gedetineerden voor de Activiteit bedoeld is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.Doelgroep>;
    shacl:class schemas:Audience;
    shacl:description "Groep van gedetineerden voor de Activiteit bedoeld is."@nl;
    shacl:name "doelgroep"@nl;
    shacl:path schemas:audience
  ], [
    a shacl:PropertyShape;
    rdfs:label "activiteit"@nl;
    rdfs:comment "Concrete Activiteiten die het Aanbod verwezenlijken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.Activiteit>;
    shacl:class crm:E7_Activity;
    shacl:description "Concrete Activiteiten die het Aanbod verwezenlijken."@nl;
    shacl:name "activiteit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.subactiviteit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beïnvloed door"@nl;
    rdfs:comment "Realisatie die een effect heeft op het Aanbod."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.BeïnvloedDoor>;
    shacl:class <https://data.vlaanderen.be/ns/cultuurparticipatie#Realisatie>;
    shacl:description "Realisatie die een effect heeft op het Aanbod."@nl;
    shacl:name "beïnvloed door"@nl;
    shacl:path prov:wasInfluencedBy
  ], [
    a shacl:PropertyShape;
    rdfs:label "infrastructuur"@nl;
    rdfs:comment "Informatie rond de infrastructuur waarrond of waarin het Aanbod doorgaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.Infrastructuur>;
    shacl:class <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Infrastructuur>;
    shacl:description "Informatie rond de infrastructuur waarrond of waarin het Aanbod doorgaat."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "infrastructuur"@nl;
    shacl:path prov:atLocation
  ], [
    a shacl:PropertyShape;
    rdfs:label "gerealiseerd door"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit kan bijvoorbeeld een aanbodverstrekker zijn."@nl;
    rdfs:comment "Realisator die het Aanbod tot stand brengt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Aanbod.GerealiseerdDoor>;
    shacl:class <https://data.vlaanderen.be/ns/cultuurparticipatie#Realisator>;
    shacl:description "Realisator die het Aanbod tot stand brengt."@nl;
    shacl:minCount 1;
    shacl:name "gerealiseerd door"@nl;
    shacl:path <http://cidoc-crm.org/cidoc-crm/P14_carried_out_by>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/hulp-dienstverlening-gedetineerden#Aanbod> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#ActiviteitShape> a shacl:NodeShape;
  rdfs:label "Activiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een Activiteit kan uit één of meerdere sessies bestaan en wordt bewust georganiseerd en uitgevoerd door hulp- of dienstverleners, vrijwilligers, fatikken of anderen in het kader van hulp- en dienstverlening voor gedetineerden. De originele definitie van Activiteit is ruim genoeg om activiteiten voor gedetineerden te omvatten."@nl;
  rdfs:comment "Actie die bewust wordt georganiseerd en uitgevoerd door hulp- of dienstverleners, vrijwilligers, fatikken of anderen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
