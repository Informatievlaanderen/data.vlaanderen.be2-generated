  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het type van voltijdsequivalent, zoals bijvoorbeeld gevangenispersoneel en fatikken."@nl;
    rdfs:comment "Classificering van het VoltijdsequivalentGebruik aan de hand van een gecontroleerde codelijst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#VoltijdsequivalentGebruik.Type>;
