<https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#TijdschemaShape> a shacl:NodeShape;
  rdfs:label "Tijdschema"@nl;
  <http://purl.org/vocab/vann/usageNote> "Tijdstippen (meervoud) ipv tijdstip (enkelvoud),het gaat maw over iets (bv vergadering,taak,gebeurtenis) dat herhaaldelijk plaatsvindt,typisch volgens een regelmatig patroon (bv repetitie elke vrijdag)."@nl;
  rdfs:comment "Overzicht van de tijdstippen waarop iets plaatsvindt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aantal"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv 10 keer vanaf de startdatum."@nl;
    rdfs:comment "Aantal keer dat het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Tijdschema.Aantal>;
    shacl:datatype xsd:integer;
    shacl:description "Aantal keer dat het plaatsvindt."@nl;
    shacl:maxCount "1";
    shacl:name "aantal"@nl;
    shacl:path schemas:repeatCount
  ], [
    a shacl:PropertyShape;
    rdfs:label "duur"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uit te drukken als een interval volgens iso 8601, bv P1D 1 dag, P2H twee uur..."@nl;
    rdfs:comment "Duur van hetgeen plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Tijdschema.Duur>;
    shacl:datatype xsd:duration;
    shacl:description "Duur van hetgeen plaatsvindt."@nl;
    shacl:maxCount "1";
    shacl:name "duur"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#duur>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "Datum tot wanneer het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Tijdschema.Einddatum>;
    shacl:datatype xsd:date;
    shacl:description "Datum tot wanneer het plaatsvindt."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path schemas:endDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "eindtijd"@nl;
    rdfs:comment "Tijdstip waarop het eindigt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Tijdschema.Eindtijd>;
    shacl:datatype xsd:time;
    shacl:description "Tijdstip waarop het eindigt."@nl;
    shacl:maxCount "1";
    shacl:name "eindtijd"@nl;
    shacl:path schemas:endTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "frequentie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uit te drukken als een interval volgens iso 8601, bv P1W betekent wekelijks, P2W tweewekelijks, P1D dagelijks..."@nl;
    rdfs:comment "Frequentie waarmee het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Tijdschema.Frequentie>;
    shacl:datatype xsd:string;
    shacl:description "Frequentie waarmee het plaatsvindt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "frequentie"@nl;
    shacl:path schemas:repeatFrequency
  ], [
    a shacl:PropertyShape;
    rdfs:label "per dag"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik de URI's van schema.org, bv https://schema.org/Monday voor maandag. Deze verwijzen door naar Wikidata waar ook de Nederlandse vertaling te vinden is, bv http://www.wikidata.org/entity/Q105 voor maandag."@nl;
    rdfs:comment "Dagen van de week waarop het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Tijdschema.PerDag>;
    shacl:datatype xsd:anyURI;
    shacl:description "Dagen van de week waarop het plaatsvindt."@nl;
    shacl:name "per dag"@nl;
    shacl:path schemas:byDay
  ], [
    a shacl:PropertyShape;
    rdfs:label "per dag van de maand"@nl;
    rdfs:comment "Dagen van de maand waarop het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Tijdschema.PerDagVanDeMaand>;
    shacl:datatype xsd:integer;
    shacl:description "Dagen van de maand waarop het plaatsvindt."@nl;
    shacl:name "per dag van de maand"@nl;
    shacl:path schemas:byMonthDay
  ], [
    a shacl:PropertyShape;
    rdfs:label "per maand"@nl;
    rdfs:comment "Maanden van het jaar waarop het plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Tijdschema.PerMaand>;
    shacl:datatype xsd:integer;
    shacl:description "Maanden van het jaar waarop het plaatsvindt."@nl;
    shacl:name "per maand"@nl;
    shacl:path schemas:byMonth
  ], [
    a shacl:PropertyShape;
    rdfs:label "per setpositie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv als iets maandelijks plaatsvindt op maandag om te zeggen dat het bv de eerste maandag is vd maand. Frequentie is dan maandelijks, perDag is Maandag en de perSetpositie is dan 1. Ook negatieve cijfers zijn mogelijk, bv -1 zou aangeven dat het op de laatste maandag vd maand plaatsvindt."@nl;
    rdfs:comment "N-de keer dat iets plaatsvindt uit de verzameling van mogelijke tijdstippen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/2025-04-22#Tijdschema.PerSetpositie>;
