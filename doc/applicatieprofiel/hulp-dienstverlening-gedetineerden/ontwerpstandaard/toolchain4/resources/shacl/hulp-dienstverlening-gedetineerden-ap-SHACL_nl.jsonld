  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/hulp-dienstverlening-gedetineerden/ontwerpstandaard/toolchain4#ActiviteitShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Een Activiteit kan uit één of meerdere sessies bestaan en wordt bewust georganiseerd en uitgevoerd door hulp- of dienstverleners, vrijwilligers, fatikken of anderen in het kader van hulp- en dienstverlening voor gedetineerden. De originele definitie van Activiteit is ruim genoeg om activiteiten voor gedetineerden te omvatten."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Actie die bewust wordt georganiseerd en uitgevoerd door hulp- of dienstverleners, vrijwilligers, fatikken of anderen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
