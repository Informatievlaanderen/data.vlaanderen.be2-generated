{
  "title": "Pipe",
  "type": "object",
  "description": "A pipe is a passage of water flowing in a closed conduit (meaning it is not subject to atmospheric pressure).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Pipe)",
      "pattern": "^Pipe$"
    },
    "flowRate": {
      "type": "array",
      "description": "Lijst van QuantityValue items.",
      "items": {
        "$ref": "#/components/schemas/QuantityValue"
      },
      "minItems": 1,
      "maxItems": null
    },
    "classification": {
      "$ref": "#/components/schemas/PipeClassificationType"
    },
    "flowPressure": {
      "$ref": "#/components/schemas/QuantityValue"
    },
    "type": {
      "$ref": "#/components/schemas/PipeType"
    },
    "waterType": {
      "type": "array",
      "description": "Lijst van WaterTypeValue items.",
      "items": {
        "$ref": "#/components/schemas/WaterTypeValue"
      },
      "minItems": 1
    },
    "status": {
      "$ref": "#/components/schemas/Status"
    },
    "geometry": {
      "type": "array",
      "description": "Lijst van Geometry items.",
      "items": {
        "$ref": "#/components/schemas/Geometry"
      },
      "minItems": 1
    },
    "diameter": {
      "$ref": "#/components/schemas/QuantityValue"
    },
    "identifier": {
      "type": "array",
      "description": "Lijst van Identifier items.",
      "items": {
        "$ref": "#/components/schemas/Identifier"
      },
      "minItems": 1
    },
    "address": {
      "type": "array",
      "description": "Lijst van AddressRepresentation items.",
      "items": {
        "$ref": "#/components/schemas/AddressRepresentation"
      },
      "minItems": 1
    },
    "supplies": {
      "type": "array",
      "description": "Lijst van FireHydrant items.",
      "items": {
        "$ref": "#/components/schemas/FireHydrant"
      },
      "minItems": 1
    },
    "isConnectedTo": {
      "type": "array",
      "description": "Lijst van Pipe items.",
      "items": {
        "$ref": "#/components/schemas/Pipe"
      },
      "minItems": 1
    },
    "isOperatedBy": {
      "$ref": "#/components/schemas/Organization"
    }
  },
  "required": [
    "@type",
    "flowRate",
    "geometry",
    "diameter",
    "isOperatedBy"
  ]
}