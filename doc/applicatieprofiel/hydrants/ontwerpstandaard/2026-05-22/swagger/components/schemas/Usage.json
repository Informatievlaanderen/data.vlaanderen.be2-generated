{
  "title": "Usage",
  "type": "object",
  "description": "The use of something.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Usage)",
      "pattern": "^Usage$"
    },
    "date": {
      "type": "object",
      "description": "The time and date on which a Fire Hydrant was used during an emergency intervention.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "performedBy": {
      "$ref": "#/components/schemas/Organization"
    },
    "description": {
      "type": "array",
      "description": "Lijst van LangString items.",
      "items": {
        "$ref": "#/components/schemas/LangString"
      },
      "minItems": 1
    },
    "location": {
      "$ref": "#/components/schemas/Geometry"
    }
  },
  "required": [
    "@type"
  ]
}