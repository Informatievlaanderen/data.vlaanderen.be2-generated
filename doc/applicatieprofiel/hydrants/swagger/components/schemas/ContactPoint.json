{
  "title": "ContactPoint",
  "type": "object",
  "description": "Emergency information i.e., e-mail address and telephone number) of a person or department for Fire Hydrants through which the user can get in touch with.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse ContactPoint)",
      "pattern": "^ContactPoint$"
    },
    "hasEmail": {
      "type": "object",
      "description": "Email address of the ContactPoint.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "hasTelephone": {
      "type": "object",
      "description": "A telephone number through which the ContactPoint can be contacted.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    }
  },
  "required": [
    "@type",
    "hasTelephone"
  ]
}