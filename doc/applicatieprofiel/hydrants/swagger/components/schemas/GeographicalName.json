{
  "title": "GeographicalName",
  "type": "object",
  "description": "Proper noun applied to a real world entity.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GeographicalName)",
      "pattern": "^GeographicalName$"
    },
    "sourceOfName": {
      "type": "object",
      "description": "Original data source from which the geographical name is taken from and integrated in the data set providing/publishing it. For some named spatial objects it might refer again to the publishing data set if no other information is available.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "spelling": {
      "type": "object",
      "description": "A proper way of writing the geographical name.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "nameStatus": {
      "$ref": "#/components/schemas/NameStatusValue"
    },
    "nativeness": {
      "$ref": "#/components/schemas/NativenessValue"
    }
  },
  "required": [
    "@type"
  ]
}