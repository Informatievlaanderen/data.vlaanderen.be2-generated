{
  "title": "Inspection",
  "type": "object",
  "description": "The act of looking at something carefully in order to discover information.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Inspection)",
      "pattern": "^Inspection$"
    },
    "date": {
      "type": "object",
      "description": "The date and time of the inspection.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "description": {
      "type": "array",
      "description": "Lijst van LangString items.",
      "items": {
        "$ref": "#/components/schemas/LangString"
      },
      "minItems": 1
    },
    "performedBy": {
      "$ref": "#/components/schemas/Organization"
    }
  },
  "required": [
    "@type"
  ]
}