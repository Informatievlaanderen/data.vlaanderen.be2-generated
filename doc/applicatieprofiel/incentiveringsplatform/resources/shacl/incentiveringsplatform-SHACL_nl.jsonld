      {
        "@id": "_:df_8_20"
      },
      {
        "@id": "_:df_8_25"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/incentiveringsplatform#Beloningsontvangst"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#BewijsleveringShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Hier wordt in het geval van consumptie van het Stimulansaanbod door een Agent het effectieve bewijs beschreven. Vertrekkend vanuit ons eerder vermelde voorbeeld is dit het feit dat iemand een negatieve alcoholtest aflegt aan een fuif om zo de Beloningsontvangst te verkrijgen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Het bewijs dat effectief geleverd wordt bij de consumptie van het Stimulansaanbod door een Agent."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Bewijslevering"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_5"
      },
      {
        "@id": "_:df_8_8"
      },
