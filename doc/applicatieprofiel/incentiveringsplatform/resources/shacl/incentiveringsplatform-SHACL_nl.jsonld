  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#BeloningShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Als er bijvoorbeeld een Stimulansaanbod is waarvoor je een Sobercoin ontvangt als je voldoet aan de criteria en het bewijs, zal dit hier beschreven zijn. Bouwend op ons eerder vermelde voorbeeld zou men aldus een Sobercoin  ontvangen voor het Stimulansaanbod."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De bekrachtiging die bij een Stimulansaanbod hoort. Dit is wat zal ontvangen worden bij de consumptie van dit Stimulansaanbod. Dit is niet de effectief ontvangen beloning, maar de beschrijving van wat je zal ontvangen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Beloning"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_2"
      },
      {
        "@id": "_:df_8_6"
      },
      {
        "@id": "_:df_8_30"
      },
      {
        "@id": "_:df_8_31"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/incentiveringsplatform#Beloning"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#BeloningsontvangstShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Als er een Stimulansaanbod is waar je aan deelgenomen hebt, of met andere woorden een Stimulansaanbod dat je geconsumeerd hebt, kan je hier de effectieve beloning vinden die je ontvangen hebt zoals bijvoorbeeld 3 Sobercoins."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De effectieve beloning die ontvangen is bij de consumptie van een Stimulansaanbod."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Beloningsontvangst"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
