    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Hier kan je bijvoorbeeld beschrijven dat er een minumumvereiste is om te kunnen meedoen met een Stimulansaanbod. Voorbeelden hiervan zijn: je moet ouder dan 18 jaar zijn en je moet inwoner van gemeente Balen zijn om te kunnen genieten van een Stimulansaanbod."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Voorwaarde om te kunnen deelnemen aan het Stimulansaanbod"
