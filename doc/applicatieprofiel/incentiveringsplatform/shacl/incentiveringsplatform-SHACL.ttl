<https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#DienstverleningShape> a shacl:NodeShape;
  rdfs:label "Dienstverlening"@nl;
  <http://purl.org/vocab/vann/usageNote> "Abstracte klasse die zowel publieke als private dienstverlening bevat. Indien er sprake is van een PubliekeDienstverlening, moet deze geïnstantieerd worden aan de hand van de IPDC-LPDC InstancePublicService."@nl;
  rdfs:comment "Een dienst verleend door een organisatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een beschrijving van het item."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Dienstverlening.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een beschrijving van het item."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path schemas:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De naam van het item."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Dienstverlening.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van het item."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path schemas:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Het type dienstverlening dat wordt aangeboden."@nl;
