<https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#BedragShape> a shacl:NodeShape;
  rdfs:label "Bedrag"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld één Sobercoin die op een fuif kan worden gebruikt."@nl;
  rdfs:comment "Combinatie van een eenheid en een aantal."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Waarde van het bedrag."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bedrag.Waarde>;
    shacl:datatype xsd:double;
    shacl:description "Waarde van het bedrag."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ], [
    a shacl:PropertyShape;
    rdfs:label "eenheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik de ISO4217 3-lettercoide voor valuta's."@nl;
    rdfs:comment "De eenheid waarin het bedrag wordt uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bedrag.Eenheid>;
    shacl:datatype xsd:string;
    shacl:description "De eenheid waarin het bedrag wordt uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "eenheid"@nl;
    shacl:path schemas:unitText
  ];
  shacl:targetClass schemas:QuantitativeValue .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#BeloningShape> a shacl:NodeShape;
  rdfs:label "Beloning"@nl;
  <http://purl.org/vocab/vann/usageNote> "Als er bijvoorbeeld een Stimulansaanbod is waarvoor je een Sobercoin ontvangt als je voldoet aan de criteria en het bewijs, zal dit hier beschreven zijn. Bouwend op ons eerder vermelde voorbeeld zou men aldus een Sobercoin  ontvangen voor het Stimulansaanbod."@nl;
  rdfs:comment "De bekrachtiging die bij een Stimulansaanbod hoort. Dit is wat zal ontvangen worden bij de consumptie van dit Stimulansaanbod. Dit is niet de effectief ontvangen beloning, maar de beschrijving van wat je zal ontvangen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van de beloning."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Beloning.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van de beloning."@nl;
    shacl:maxCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van de beloning."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Beloning.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Beschrijving van de beloning."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "De vorm van beloning."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Beloning.Type>;
    shacl:class skos:Concept;
    shacl:description "De vorm van beloning."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Het gewicht van de beloning."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Beloning.Waarde>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Het gewicht van de beloning."@nl;
    shacl:maxCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/incentiveringsplatform#Beloning> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#BeloningsontvangstShape> a shacl:NodeShape;
  rdfs:label "Beloningsontvangst"@nl;
  <http://purl.org/vocab/vann/usageNote> "Als er een Stimulansaanbod is waar je aan deelgenomen hebt, of met andere woorden een Stimulansaanbod dat je geconsumeerd hebt, kan je hier de effectieve beloning vinden die je ontvangen hebt zoals bijvoorbeeld 3 Sobercoins."@nl;
  rdfs:comment "De effectieve beloning die ontvangen is bij de consumptie van een Stimulansaanbod."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van de beloning."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Beloningsontvangst.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Beschrijving van de beloning."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Het gewicht van de beloning."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Beloningsontvangst.Waarde>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Het gewicht van de beloning."@nl;
    shacl:maxCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/incentiveringsplatform#Beloningsontvangst> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#BewijsShape> a shacl:NodeShape;
  rdfs:label "Bewijs"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het kader van dienstverlening gaat het meestal om administratieve documenten of ingevulde aanvraagformulieren. Zonder het nodige Bewijs kan de dienstverlening niet worden afgeleverd. In het geval van het eerder aangehaalde voorbeeld m.b.t. de Sobercoins kan dit bijvoorbeeld zijn dat je een negatieve alcoholtest moet afleggen."@nl;
  rdfs:comment "De beschrijving van wat men moet voorleggen om aan een Stimulansaanbod te kunnen deelnemen en hiervoor een Beloning te ontvangen (= Beloningsontvangst)."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bewijs.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Beschrijving van het Bewijs."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "documentatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb template van een administratief document of aanvraagformulier of aanwijzingen voor het invullen ervan."@nl;
    rdfs:comment "Documentatie gerelateerd aan het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bewijs.Documentatie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Documentatie gerelateerd aan het Bewijs."@nl;
    shacl:maxCount "1";
    shacl:name "documentatie"@nl;
    shacl:path foaf:page
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Officiële naam van het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bewijs.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Officiële naam van het Bewijs."@nl;
    shacl:maxCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Het gewicht van het bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bewijs.Waarde>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Het gewicht van het bewijs."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het gebruik van een codelijst wordt aanbevolen. Illustratief wordt verwezen naar een eenvoudige codelijst."@nl;
    rdfs:comment "Aard van het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bewijs.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van het Bewijs."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <http://data.europa.eu/m8g/Evidence> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#BewijsleveringShape> a shacl:NodeShape;
  rdfs:label "Bewijslevering"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hier wordt in het geval van consumptie van het Stimulansaanbod door een Agent het effectieve bewijs beschreven. Vertrekkend vanuit ons eerder vermelde voorbeeld is dit het feit dat iemand een negatieve alcoholtest aflegt aan een fuif om zo de Beloningsontvangst te verkrijgen."@nl;
  rdfs:comment "Het bewijs dat effectief geleverd wordt bij de consumptie van het Stimulansaanbod door een Agent."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bewijslevering.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van het Bewijs."@nl;
    shacl:maxCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bewijslevering.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Beschrijving van het Bewijs."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "documentatie"@nl;
    rdfs:comment "Documentatie gerelateerd aan het Bewiijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bewijslevering.Documentatie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Documentatie gerelateerd aan het Bewiijs."@nl;
    shacl:maxCount "1";
    shacl:name "documentatie"@nl;
    shacl:path foaf:page
  ], [
    a shacl:PropertyShape;
    rdfs:label "aantal"@nl;
    rdfs:comment "Het gewicht van het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Bewijslevering.Aantal>;
    shacl:datatype xsd:integer;
    shacl:description "Het gewicht van het Bewijs."@nl;
    shacl:maxCount "1";
    shacl:name "aantal"@nl;
    shacl:path schemas:value
  ];
  shacl:targetClass <http://data.europa.eu/m8g/Evidence> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#BewijstypeShape> a shacl:NodeShape;
  rdfs:label "Bewijstype"@nl;
  rdfs:comment "Het type van bewijsmateriaal dat de informatie ondersteunt of verifieert."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#CriteriumvereisteShape> a shacl:NodeShape;
  rdfs:label "Criteriumvereiste"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hier kan je bijvoorbeeld beschrijven dat er een minumumvereiste is om te kunnen meedoen met een Stimulansaanbod. Voorbeelden hiervan zijn: je moet ouder dan 18 jaar zijn en je moet inwoner van gemeente Balen zijn om te kunnen genieten van een Stimulansaanbod."@nl;
  rdfs:comment "Voorwaarde om te kunnen deelnemen aan het Stimulansaanbod"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van de Criteriumvereiste."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Criteriumvereiste.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Beschrijving van de Criteriumvereiste."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Officiële naam van de CriteriumVereiste."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Criteriumvereiste.Naam>;
    shacl:datatype xsd:string;
    shacl:description "Officiële naam van de CriteriumVereiste."@nl;
    shacl:maxCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de CriteriumVereiste."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#Criteriumvereiste.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de CriteriumVereiste."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <https://uri.semic.eu/m8g/Requirement> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/incentiveringsplatform/erkendestandaard/2024-10-03#CriteriumvereistetypeShape> a shacl:NodeShape;
  rdfs:label "Criteriumvereistetype"@nl;
  rdfs:comment "Soort norm dat vereist is voor het verkrijgen van een Simulansaanbod."@nl;
  shacl:closed false;
