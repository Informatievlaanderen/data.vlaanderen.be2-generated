  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Meerpaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#MeteopaalShape> a shacl:NodeShape;
