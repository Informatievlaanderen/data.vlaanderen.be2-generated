<https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#FietsstallingShape> a shacl:NodeShape;
  rdfs:label "Fietsstalling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-skeletaanvulling detail - WPI16: Fietsstalling. Met het attribuut overdekt als True: GRB-basis - WGA3: Overdekte fietsstalling."@nl;
  rdfs:comment "Een fietsstalling is het geheel aan palen en/of verankeringspunten van een constructie bestemd voor het vastmaken van fietsen, gelegen op het openbare domein."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "afsluitbaar"@nl;
    rdfs:comment "Duidt aan of de fietsstalling al dan niet kan afgesloten worden om toegang voor onbevoegden te verhinderen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#Fietsstalling.Afsluitbaar>;
    shacl:datatype xsd:boolean;
    shacl:description "Duidt aan of de fietsstalling al dan niet kan afgesloten worden om toegang voor onbevoegden te verhinderen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "afsluitbaar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#afsluitbaar>
  ], [
    a shacl:PropertyShape;
    rdfs:label "overdekt"@nl;
    rdfs:comment "Duidt aan of de fietsstalling al dan niet overdekt is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#Fietsstalling.Overdekt>;
    shacl:datatype xsd:boolean;
    shacl:description "Duidt aan of de fietsstalling al dan niet overdekt is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "overdekt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#overdekt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "capaciteit"@nl;
    rdfs:comment "Geeft aan hoeveel fietsen gestald kunnen worden aan of in de fietsenstalling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#Fietsstalling.Capaciteit>;
    shacl:datatype xsd:integer;
    shacl:description "Geeft aan hoeveel fietsen gestald kunnen worden aan of in de fietsenstalling."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "capaciteit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#capaciteit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "fietsdelen"@nl;
    rdfs:comment "Duidt aan of de fietsstalling al dan niet gebruikt wordt voor deelfietsen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#Fietsstalling.Fietsdelen>;
    shacl:datatype xsd:boolean;
    shacl:description "Duidt aan of de fietsstalling al dan niet gebruikt wordt voor deelfietsen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "fietsdelen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#fietsdelen>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Fietsstalling> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#FietstelpaalShape> a shacl:NodeShape;
  rdfs:label "Fietstelpaal"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar http://vlaamswoordenboek.be/definities/term/fietstelpaal."@nl;
  rdfs:comment "Paal die automatisch voorbij passerende fietsers telt."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Fietstelpaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#FlitspaalShape> a shacl:NodeShape;
  rdfs:label "Flitspaal"@nl;
  <http://purl.org/vocab/vann/usageNote> "Onder GRB-skeletaanvulling detail - WPI1: Paal."@nl;
  rdfs:comment "Een meettoestel waarmee snelheidsovertredingen en/of het negeren van een rood verkeerslicht vastgesteld kunnen worden."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Flitspaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#FonteinShape> a shacl:NodeShape;
  rdfs:label "Fontein"@nl;
  <http://purl.org/vocab/vann/usageNote> "Indien de bassin ook een constructie is (en dus geen vijver bijvoorbeeld) maakt deze ook deel uit van de Fontein."@nl;
  rdfs:comment "Een stuk architectuur dat water in een bassin giet of in de lucht spuit (al dan niet opgevangen in een bassin), om drinkwater te leveren en/of voor een decoratief of dramatisch effect."@nl;
  shacl:closed false;
  shacl:targetClass <http://dbpedia.org/resource/Fountain> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#FysiekobjectShape> a shacl:NodeShape;
  rdfs:label "FysiekObject"@nl;
  rdfs:comment "De hoofdklasse waar alle objecten die geïnventariseerd kunnen worden van afgeleid worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "begindatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het gebied of object in gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#Fysiekobject.Begindatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het gebied of object in gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "begindatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#begindatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het beheerobject uit gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#Fysiekobject.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het beheerobject uit gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#einddatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "niveau"@nl;
    <http://purl.org/vocab/vann/usageNote> "Negatieve waarden worden geassocieerd met ondergronds en positieve waarden met bovengronds. Nul wordt beschouwd als een absolute waarde om het maaiveld aan te duiden."@nl;
    rdfs:comment "Het niveau waarop het object zich bevindt, relatief ten opzichte van andere objecten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#Fysiekobject.Niveau>;
    shacl:datatype xsd:integer;
    shacl:description "Het niveau waarop het object zich bevindt, relatief ten opzichte van andere objecten."@nl;
    shacl:maxCount "1";
    shacl:name "niveau"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#niveau>
  ], [
    a shacl:PropertyShape;
    rdfs:label "nauwkeurigheid"@nl;
    rdfs:comment "De precisie waarmee het object opgemeten werd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#Fysiekobject.Nauwkeurigheid>;
    shacl:class skos:Concept;
    shacl:description "De precisie waarmee het object opgemeten werd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "nauwkeurigheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#nauwkeurigheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "De geometrie overeenkomstig met een bepaald object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#Fysiekobject.Geometrie>;
    shacl:class <http://www.opengis.net/ont/geosparql#Geometry>;
    shacl:description "De geometrie overeenkomstig met een bepaald object."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "relatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een verwijzing naar een object uit het wegenregister of grootschalig referentiebestand."@nl;
    rdfs:comment "Verwijst naar een object in een andere databank dat meer informatie kan verschaffen over het beheerobject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#Fysiekobject.Relatie>;
    shacl:class rdfs:Resource;
    shacl:description "Verwijst naar een object in een andere databank dat meer informatie kan verschaffen over het beheerobject."@nl;
    shacl:name "relatie"@nl;
    shacl:path dc:relation
  ];
