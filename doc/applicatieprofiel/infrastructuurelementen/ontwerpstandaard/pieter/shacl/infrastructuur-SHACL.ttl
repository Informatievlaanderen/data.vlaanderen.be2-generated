    shacl:name "aantalAnkerpunten"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#aantalAnkerpunten>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Mast>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Communicatiemast>,
