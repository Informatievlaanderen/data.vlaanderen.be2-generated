<https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#AanplakbordShape> a shacl:NodeShape;
  rdfs:label "Aanplakbord"@nl;
  <http://purl.org/vocab/vann/usageNote> "Voornamelijk voor reclameborden en verkiezingsdrukwerk. Naar GRB-skeletaanvulling detail - WPI12: Paal signalisatie publiciteit en Wikidata (https://www.wikidata.org/wiki/Q4379881)."@nl;
  rdfs:comment "(Paalvormige en duurzame verankering van) signalisatie langsheen de openbare weg met allerlei aankondigingen, al of niet van commerciële aard, op te plakken."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Aanplakbord> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#AfsluitingShape> a shacl:NodeShape;
  rdfs:label "Afsluiting"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-skeletaanvulling detail - AFS: Afsluiting (afgeleid)."@nl;
  rdfs:comment "Op het terrein ondubbelzinnig aanwijsbare en permanent verankerde scheiding."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Afsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#BestendigeAfsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#NormandischeAfsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Dwarsligger>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Draadafsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Treinbiels>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Paneelafsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SpandraadKetting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SelectieveAfsluiting>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Slagboom>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Toegangspoort>,
    <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Muur> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#AfsluitingspandraadenkettingShape> a shacl:NodeShape;
  rdfs:label "AfsluitingSpandraadEnKetting"@nl;
  <http://purl.org/vocab/vann/usageNote> "Verschilt van een draadafsluiting. Naar GRB-skeletaanvulling detail - AFS: Afsluiting - Spandraad en -ketting."@nl;
  rdfs:comment "Op het terrein ondubbelzinnig aanwijsbare en permanent verankerde scheiding, bestaande uit spandraad en/of kettingen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#SpandraadKetting> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/ontwerpstandaard/pieter#BedieningszuilShape> a shacl:NodeShape;
  rdfs:label "Bedieningszuil"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld, bedieningszuil voor verzinkbare wegmonoliet."@nl;
  rdfs:comment "Sensor in functie van elektrische installaties of straatmeubilair."@nl;
