<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#ActivityComplexShape> a shacl:NodeShape;
  rdfs:label "ActivityComplex"@en;
  rdfs:comment "Technical and economic unit managed by the same operator where certain activities regarding production and services take place."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#ActivityComplex>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "name"@en;
    <http://purl.org/vocab/vann/usageNote> """NOTE 1 Several names in different languages may be expressed.
NOTE 2 It is recommended that the language of the name (part of the Geographical/Name data type) be filled whenever possible."""@en;
    rdfs:comment "Name by which the complex is known."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#ActivityComplex.Name>;
    shacl:datatype rdf:langString;
    shacl:description "Name by which the complex is known."@en;
    shacl:maxCount 1;
    shacl:name "name"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "function"@en;
    rdfs:comment "Activities carried out by the complex."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#ActivityComplex.Function>;
    shacl:class <https://vocab.belgif.be/ns/generic#Function>;
    shacl:description "Activities carried out by the complex."@en;
    shacl:minCount 1;
    shacl:name "function"@en;
    shacl:path <https://vocab.belgif.be/ns/utility-services#function>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometry"@en;
    rdfs:comment "Geometry of the complex to describe its location and size."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#ActivityComplex.Geometry>;
    shacl:description "Geometry of the complex to describe its location and size."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "geometry"@en;
    shacl:or ([shacl:class <http://www.w3.org/ns/locn#Geometry>] [shacl:class <http://www.opengis.net/ont/geosparql#Curve>] [shacl:class <http://www.opengis.net/ont/sf#Point>]);
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identifier"@en;
    <http://purl.org/vocab/vann/usageNote> "NOTE  An external object identifier is a unique object identifier published by the responsible body, which may be used by external applications to reference the spatial object. The identifier is an identifier of the spatial object, not an identifier of the real-world phenomenon."@en;
    rdfs:comment "External Identifier of the complex."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#ActivityComplex.Identifier>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "External Identifier of the complex."@en;
    shacl:minCount 1;
    shacl:name "identifier"@en;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "documentation"@en;
    rdfs:comment "Reference to a Document with additional information about the complex."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#ActivityComplex.Documentation>;
    shacl:description "Reference to a Document with additional information about the complex."@en;
    shacl:name "documentation"@en;
    shacl:or ([shacl:class foaf:Document] [shacl:class <https://vocab.belgif.be/ns/utility-services#Plan>]);
    shacl:path <https://vocab.belgif.be/ns/utility-services#documentation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "on"@en;
    rdfs:comment "Utility Network Element belonging to the complex."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#ActivityComplex.On>;
    shacl:description "Utility Network Element belonging to the complex."@en;
    shacl:name "on"@en;
    shacl:or ([shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityNetworkElement>] [shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityNode>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Appurtenance>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Connection>] [shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityLinkSet>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Pipe>] [shacl:class <https://vocab.belgif.be/ns/utility-services#OilGasChemicalsPipe>] [shacl:class <https://vocab.belgif.be/ns/utility-services#SewerPipe>] [shacl:class <https://vocab.belgif.be/ns/utility-services#WaterPipe>] [shacl:class <https://vocab.belgif.be/ns/utility-services#ThermalPipe>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Cable>] [shacl:class <https://vocab.belgif.be/ns/utility-services#ElectricityCable>] [shacl:class <https://vocab.belgif.be/ns/utility-services#TelecommunicationsCable>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Duct>] [shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityLink>] [shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityLinkSequence>] [shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityNodeContainer>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Tower>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Pole>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Manhole>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Cabinet>]);
    shacl:path <https://vocab.belgif.be/ns/utility-services#on>
  ], [
    a shacl:PropertyShape;
    rdfs:label "inNetwork"@en;
    rdfs:comment "Utility Network to which the Activity Complex belongs."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#ActivityComplex.InNetwork>;
    shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityNetwork>;
    shacl:description "Utility Network to which the Activity Complex belongs."@en;
    shacl:minCount 1;
    shacl:name "inNetwork"@en;
    shacl:path <https://vocab.belgif.be/ns/generic#ActivityComplex.inNetwork>
  ];
  shacl:targetClass <https://vocab.belgif.be/ns/generic#ActivityComplex> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#AddressRepresentationShape> a shacl:NodeShape;
  rdfs:label "AddressRepresentation"@en;
  rdfs:comment "More readable representation containing only the basic data of the address,intended for using an address as an attribute of another object."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#AddressRepresentation>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "fullAddress"@en;
    rdfs:comment "The complete address in one string, formatted or not."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#AddressRepresentation.FullAddress>;
    shacl:datatype rdf:langString;
    shacl:description "The complete address in one string, formatted or not."@en;
    shacl:maxCount 1;
    shacl:name "fullAddress"@en;
    shacl:path <http://www.w3.org/ns/locn#fullAddress>
  ], [
    a shacl:PropertyShape;
    rdfs:label "poBox"@en;
    rdfs:comment "PO Box number in a post office."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#AddressRepresentation.PoBox>;
    shacl:datatype xsd:string;
    shacl:description "PO Box number in a post office."@en;
    shacl:maxCount 1;
    shacl:name "poBox"@en;
    shacl:path <http://www.w3.org/ns/locn#poBox>
  ], [
    a shacl:PropertyShape;
    rdfs:label "streetName"@en;
    rdfs:comment "Street name of address."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#AddressRepresentation.StreetName>;
    shacl:datatype rdf:langString;
    shacl:description "Street name of address."@en;
    shacl:maxCount 1;
    shacl:name "streetName"@en;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locationIndication"@en;
    rdfs:comment "Alphanumeric code that uniquely identifies the address locator within the street, administrative unit, etc."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#AddressRepresentation.LocationIndication>;
    shacl:datatype xsd:string;
    shacl:description "Alphanumeric code that uniquely identifies the address locator within the street, administrative unit, etc."@en;
    shacl:name "locationIndication"@en;
    shacl:path <http://www.w3.org/ns/locn#locatorDesignator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "boxNumber"@en;
    rdfs:comment "Officially assigned alphanumeric code added to the house number to distinguish multiple building units, pitches, moorings or plots that have the same house number."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#AddressRepresentation.BoxNumber>;
    shacl:datatype xsd:string;
    shacl:description "Officially assigned alphanumeric code added to the house number to distinguish multiple building units, pitches, moorings or plots that have the same house number."@en;
    shacl:maxCount 1;
    shacl:name "boxNumber"@en;
    shacl:path <https://vocab.belgif.be/ns/address#AddressRepresentation.boxNumber>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locationName"@en;
