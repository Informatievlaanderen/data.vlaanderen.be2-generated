<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#DuctShape> a shacl:NodeShape;
  rdfs:label "Duct"@en;
  <http://purl.org/vocab/vann/usageNote> "A Duct (or Conduit, or Duct-bank, or Wireway) is a linear object which belongs to the structural network. It is the outermost casing. A Duct may contain Pipe(s), Cable(s) or other Duct(s)."@en;
  rdfs:comment "A Utility Link Set used to protect and route cables and pipes through an enclosing structure."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Duct>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "containerType"@en;
    rdfs:comment "Type of the Duct as a container."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Duct.ContainerType>;
    shacl:description "Type of the Duct as a container."@en;
    shacl:maxCount 1;
    shacl:name "containerType"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://vocab.belgif.be/ns/utility-services#Duct.containerType>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ductWidth"@en;
    <http://purl.org/vocab/vann/usageNote> "The measurement of the object - in this case, the duct - from side to side."@en;
    rdfs:comment "Width of the Duct."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Duct.DuctWidth>;
    shacl:class <http://def.isotc211.org/iso19103/2015/MeasureTypes#Length>;
    shacl:description "Width of the Duct."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "ductWidth"@en;
    shacl:path <https://vocab.belgif.be/ns/utility-services#ductWidth>
  ], [
    a shacl:PropertyShape;
    rdfs:label "pipe"@en;
    rdfs:comment "Pipe located in the Duct."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Duct.Pipe>;
    shacl:description "Pipe located in the Duct."@en;
    shacl:name "pipe"@en;
    shacl:or ([shacl:class <https://vocab.belgif.be/ns/utility-services#Pipe>] [shacl:class <https://vocab.belgif.be/ns/utility-services#OilGasChemicalsPipe>] [shacl:class <https://vocab.belgif.be/ns/utility-services#SewerPipe>] [shacl:class <https://vocab.belgif.be/ns/utility-services#WaterPipe>] [shacl:class <https://vocab.belgif.be/ns/utility-services#ThermalPipe>]);
    shacl:path <https://vocab.belgif.be/ns/utility-services#Duct.pipe>
  ], [
    a shacl:PropertyShape;
    rdfs:label "cable"@en;
    rdfs:comment "Cable located in the Duct."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Duct.Cable>;
    shacl:description "Cable located in the Duct."@en;
    shacl:name "cable"@en;
    shacl:or ([shacl:class <https://vocab.belgif.be/ns/utility-services#Cable>] [shacl:class <https://vocab.belgif.be/ns/utility-services#ElectricityCable>] [shacl:class <https://vocab.belgif.be/ns/utility-services#TelecommunicationsCable>]);
    shacl:path <https://vocab.belgif.be/ns/utility-services#Duct.cable>
  ], [
    a shacl:PropertyShape;
    rdfs:label "duct"@en;
    rdfs:comment "Duct located in the Duct."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Duct.Duct>;
    shacl:class <https://vocab.belgif.be/ns/utility-services#Duct>;
    shacl:description "Duct located in the Duct."@en;
    shacl:name "duct"@en;
    shacl:path <https://vocab.belgif.be/ns/utility-services#Duct.duct>
  ];
  shacl:targetClass <https://vocab.belgif.be/ns/utility-services#Duct> .

