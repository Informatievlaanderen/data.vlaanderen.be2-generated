<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#UtilityNetworkElementShape> a shacl:NodeShape;
  rdfs:label "UtilityNetworkElement"@en;
  rdfs:comment "Abstract base type representing an utility network element in an utility network. Every element in an utility network provides some function that is of interest in the utility network."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#UtilityNetworkElement>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "validFrom"@en;
    rdfs:comment "The time when the Utility Network Element started to exist in the real world."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#UtilityNetworkElement.ValidFrom>;
    shacl:datatype xsd:dateTime;
    shacl:description "The time when the Utility Network Element started to exist in the real world."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "validFrom"@en;
    shacl:path <https://vocab.belgif.be/ns/utility-services#validFrom>
  ], [
    a shacl:PropertyShape;
