    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#UtilityLink.InNetwork>;
    shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityNetwork>;
