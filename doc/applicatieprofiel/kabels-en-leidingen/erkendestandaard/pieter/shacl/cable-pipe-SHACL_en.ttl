<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#UtilityLinkShape> a shacl:NodeShape;
  rdfs:label "UtilityLink"@en;
  rdfs:comment "A linear spatial object that describes the geometry and connectivity between two points in a Utility Network."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#UtilityLink>;
  shacl:closed false;
