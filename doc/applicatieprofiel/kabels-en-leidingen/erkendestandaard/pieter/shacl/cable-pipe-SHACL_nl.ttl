    shacl:name "geheel"@nl;
    shacl:or ([shacl:class <https://vocab.belgif.be/ns/utility-services#Annotation>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Dimension>]);
    shacl:path <https://vocab.belgif.be/ns/utility-services#whole>
  ], [
    a shacl:PropertyShape;
    rdfs:label "deel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de maatvoeringslijn in het geval van een Maataanduiding bestaande uit twee pijlen en een maatvoeringshulplijn."@nl;
    rdfs:comment "Annotatie die deel uitmaakt van de Annotatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Annotatie.Deel>;
    shacl:description "Annotatie die deel uitmaakt van de Annotatie."@nl;
    shacl:name "deel"@nl;
    shacl:or ([shacl:class <https://vocab.belgif.be/ns/utility-services#Annotation>] [shacl:class <https://vocab.belgif.be/ns/utility-services#Dimension>]);
    shacl:path <https://vocab.belgif.be/ns/utility-services#part>
  ];
  shacl:targetClass <https://vocab.belgif.be/ns/utility-services#Annotation>,
    <https://vocab.belgif.be/ns/utility-services#Dimension> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#BeschermdGebiedShape> a shacl:NodeShape;
