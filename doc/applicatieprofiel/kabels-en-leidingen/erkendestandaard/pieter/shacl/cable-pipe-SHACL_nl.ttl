    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Nutsvoorzieningnetwerk.Disclaimer>;
    shacl:datatype rdf:langString;
