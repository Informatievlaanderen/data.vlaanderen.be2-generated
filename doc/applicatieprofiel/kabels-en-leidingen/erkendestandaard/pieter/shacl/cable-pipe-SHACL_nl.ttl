<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#DirectePositieShape> a shacl:NodeShape;
  rdfs:label "DirectePositie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typisch gebruikt om de geometrie van een ruimtelijk object te beschrijven of de geometrische primitieven (bijvoorbeeld punt, Lijn, Vlak) waaruit dat object is samengesteld. Een DirectePositie kan echter ook op zichzelf staan om een positie in de ruimte te beschrijven. De positie wordt gegeven in een coördinaatreferentiesysteem. Dat referentiesysteem wordt expliciet bij de DirectePositie opgegeven, tenzij deze deel uitmaakt van een ruimtelijk object (bijvoorbeeld een geometrische primitieve) waar al een referentiesysteem wordt vermeld. Ter info: Een coördinaatreferentiesysteem verschilt van een indirect ruimtelijk referentiesysteem in die zin dat posities direct door middel van coördinaten worden opgegeven ipv indirect door een adres of plaatsnaam."@nl;
  rdfs:comment "Houder van de coördinaten van een positie in een coördinaatreferentiesysteem."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#DirectePositie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "wkt"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik <a href='http://www.opengis.net/ont/geosparql#wktLiteral'>wktliteral</a> als datatype."@nl;
    rdfs:comment "Directe positie uitgedrukt in wkt-formaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#DirectePositie.Wkt>;
    shacl:description "Directe positie uitgedrukt in wkt-formaat."@nl;
    shacl:maxCount 1;
    shacl:name "wkt"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.opengis.net/ont/geosparql#asWKT>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gml"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik <a href='http://www.opengis.net/ont/geosparql#gmlLiteral'>gmlliteral</a> als datatype."@nl;
    rdfs:comment "Directe positie uitgedrukt in gml-formaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#DirectePositie.Gml>;
    shacl:description "Directe positie uitgedrukt in gml-formaat."@nl;
    shacl:maxCount 1;
    shacl:name "gml"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.opengis.net/ont/geosparql#asGML>
  ], [
    a shacl:PropertyShape;
    rdfs:label "opmeting"@nl;
    rdfs:comment "De manier waarop de positie werd bepaald."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#DirectePositie.Opmeting>;
    shacl:class <https://vocab.belgif.be/ns/generic#Survey>;
    shacl:description "De manier waarop de positie werd bepaald."@nl;
    shacl:maxCount 1;
    shacl:name "opmeting"@nl;
    shacl:path <https://vocab.belgif.be/ns/generic#DirectPosition.survey>
  ];
  shacl:targetClass <https://vocab.belgif.be/ns/generic#DirectPosition> .

