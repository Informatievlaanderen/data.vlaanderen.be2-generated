<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#AnnotatieShape> a shacl:NodeShape;
  rdfs:label "Annotatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "In deze context typisch Maataanduiding op een kabel- of leidingenkaart, bijvoorbeeld de afstand van een kabel tov een gevel. Kan bestaan uit onderdelen (bijvoorbeeld maatvoeringslijn, maatvoeringshulplijn, twee pijlen) die op zich ook Annotaties zijn."@nl;
  rdfs:comment "Een korte uitleg of notitie toegevoegd aan een Object."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Annotatie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "tekst"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de maat in het geval van een Maataanduiding."@nl;
    rdfs:comment "Tekst van de Annotatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Annotatie.Tekst>;
    shacl:datatype rdf:langString;
    shacl:description "Tekst van de Annotatie."@nl;
    shacl:name "tekst"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#text>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geassocieerdMet"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een kabel."@nl;
    rdfs:comment "Object waar de Annotatie betrekking op heeft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Annotatie.GeassocieerdMet>;
    shacl:class prov:Entity;
    shacl:description "Object waar de Annotatie betrekking op heeft."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "geassocieerdMet"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#associatedWith>
  ], [
    a shacl:PropertyShape;
    rdfs:label "annotatietype"@nl;
    rdfs:comment "Aard van de Annotatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Annotatie.Annotatietype>;
    shacl:description "Aard van de Annotatie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "annotatietype"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc11:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de ligging en vorm van een Maataanduiding."@nl;
    rdfs:comment "Geometrie van de Annotatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Annotatie.Locatie>;
    shacl:description "Geometrie van de Annotatie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "locatie"@nl;
    shacl:or ([shacl:class <http://www.w3.org/ns/locn#Geometry>] [shacl:class <http://www.opengis.net/ont/geosparql#Curve>] [shacl:class <http://www.opengis.net/ont/sf#Point>]);
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rotatiehoek"@nl;
    <http://purl.org/vocab/vann/usageNote> "Typisch om de Annotatie te aligneren met het Object waarop het betrekking heeft, bijvoorbeeld evenwijdig met de kabel."@nl;
    rdfs:comment "Hoek waarmee de Annotatie bij weergave moet worden geroteerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Annotatie.Rotatiehoek>;
    shacl:description "Hoek waarmee de Annotatie bij weergave moet worden geroteerd."@nl;
    shacl:maxCount 1;
    shacl:name "rotatiehoek"@nl;
    shacl:or ([shacl:class <http://def.isotc211.org/iso19103/2015/MeasureTypes#Measure>] [shacl:class <http://def.isotc211.org/iso19103/2015/MeasureTypes#Length>]);
    shacl:path <https://vocab.belgif.be/ns/utility-services#rotationAngle>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geheel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de Maataanduiding waartoe de maatvoeringslijn behoort."@nl;
    rdfs:comment "Annotatie waarvan de Annotatie deel uitmaakt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/pieter#Annotatie.Geheel>;
