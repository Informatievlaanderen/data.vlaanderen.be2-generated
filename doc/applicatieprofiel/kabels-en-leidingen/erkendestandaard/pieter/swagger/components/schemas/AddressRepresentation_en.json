{
  "title": "AddressRepresentation",
  "type": "object",
  "description": "More readable representation containing only the basic data of the address,intended for using an address as an attribute of another object.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse AddressRepresentation)",
      "pattern": "^AddressRepresentation$"
    },
    "fullAddress": {
      "$ref": "#/components/schemas/AddressRepresentation.fullAddress"
    },
    "poBox": {
      "$ref": "#/components/schemas/AddressRepresentation.poBox"
    },
    "streetName": {
      "$ref": "#/components/schemas/AddressRepresentation.streetName"
    },
    "locationIndication": {
      "type": "array",
      "description": "Alphanumeric code that uniquely identifies the address locator within the street, administrative unit, etc. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/AddressRepresentation.locationIndication"
      },
      "minItems": 1
    },
    "boxNumber": {
      "$ref": "#/components/schemas/AddressRepresentation.boxNumber"
    },
    "locationName": {
      "type": "array",
      "description": "Name or description of the geographic object the address locator designates. Lijst van LangString items.",
      "items": {
        "$ref": "#/components/schemas/AddressRepresentation.locationName"
      },
      "minItems": 1
    },
    "addressArea": {
      "$ref": "#/components/schemas/AddressRepresentation.addressArea"
    },
    "postalName": {
      "$ref": "#/components/schemas/AddressRepresentation.postalName"
    },
    "municipalityName": {
      "$ref": "#/components/schemas/AddressRepresentation.municipalityName"
    },
    "administrativeUnitLevel2": {
      "$ref": "#/components/schemas/AddressRepresentation.administrativeUnitLevel2"
    },
    "country": {
      "$ref": "#/components/schemas/AddressRepresentation.country"
    },
    "postalCode": {
      "$ref": "#/components/schemas/AddressRepresentation.postalCode"
    },
    "administrativeUnitLevel1": {
      "$ref": "#/components/schemas/AddressRepresentation.administrativeUnitLevel1"
    },
    "houseNumber": {
      "$ref": "#/components/schemas/AddressRepresentation.houseNumber"
    },
    "refersTo": {
      "$ref": "#/components/schemas/Address"
    }
  },
  "required": [
    "@type"
  ]
}