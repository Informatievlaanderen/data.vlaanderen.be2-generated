{
  "title": "DirectedLink",
  "type": "object",
  "description": "A link either in its positive or negative direction.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse DirectedLink)",
      "pattern": "^DirectedLink$"
    },
    "link": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Link"
        },
        {
          "$ref": "#/components/schemas/UtilityLink"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Link": "#/components/schemas/Link",
          "UtilityLink": "#/components/schemas/UtilityLink"
        }
      }
    },
    "direction": {
      "$ref": "#/components/schemas/Sign"
    }
  },
  "required": [
    "@type",
    "link",
    "direction"
  ]
}