{
  "title": "Survey",
  "type": "object",
  "description": "Determining the exact size of something by measuring it.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Survey)",
      "pattern": "^Survey$"
    },
    "date": {
      "$ref": "#/components/schemas/Survey.date"
    },
    "method": {
      "$ref": "#/components/schemas/MethodOfMeasurement"
    },
    "accuracy": {
      "$ref": "#/components/schemas/PositionalAccuracy"
    }
  },
  "required": [
    "@type",
    "method"
  ]
}