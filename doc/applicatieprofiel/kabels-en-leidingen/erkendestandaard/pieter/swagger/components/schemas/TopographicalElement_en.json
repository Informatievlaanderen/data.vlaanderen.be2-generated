{
  "title": "TopographicalElement",
  "type": "object",
  "description": "Part of the description of the shape and features of the earth's surface.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse TopographicalElement)",
      "pattern": "^TopographicalElement$"
    },
    "topographicalElementType": {
      "$ref": "#/components/schemas/TopographicalElementType"
    },
    "location": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Geometry"
        },
        {
          "$ref": "#/components/schemas/Curve"
        },
        {
          "$ref": "#/components/schemas/Point"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Geometry": "#/components/schemas/Geometry",
          "Curve": "#/components/schemas/Curve",
          "Point": "#/components/schemas/Point"
        }
      }
    }
  },
  "required": [
    "@type",
    "topographicalElementType",
    "location"
  ]
}