    shacl:maxCount "1";
    shacl:name "opmeting"@nl;
    shacl:path <https://vocab.belgif.be/ns/generic#Geometry.survey>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Geometry> .

