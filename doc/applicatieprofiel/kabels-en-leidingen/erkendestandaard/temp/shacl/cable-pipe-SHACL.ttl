<https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#AansluitingShape> a shacl:NodeShape;
  rdfs:label "Aansluiting"@nl;
  rdfs:comment "Object dat de aansluiting van een kabel of leiding aan een gebouw of een ander fysiek object beschrijft"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres van de aansluiting."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Aansluiting.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres van de aansluiting."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#address>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toebehorentype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Aansluiting is een specialisatie van Toebehoren waarbij het type Toebehoren \"aansluitingspunt\" is."@nl;
    rdfs:comment "Aard van het Toebehoren."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Aansluiting.Toebehorentype>;
    shacl:class skos:Concept;
    shacl:description "Aard van het Toebehoren."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "toebehorentype"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#Connection.appurtenanceType>
  ];
  shacl:targetClass <https://vocab.belgif.be/ns/utility-services#Connection> .

<https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#ActiviteitencomplexShape> a shacl:NodeShape;
  rdfs:label "Activiteitencomplex"@nl;
  <http://purl.org/vocab/vann/usageNote> "In praktijk een site, plot, faciliteit, installatie, gebouw waar de activiteit plaatsvindt. In de context van kabels en leidingen gaat het over bvb een electriciteitscentrale, een pompstation, een zuiveringsinstallatie etc. Omvat de infrastructuur, uitrusting en het materieel die daar voor nodig is. Kan meerdere locaties omvatten voor zover deze deel uitmaken van hetzelfde complex. De activiteit wordt bij voorkeur aangeduid dmv NACE codes."@nl;
  rdfs:comment "Technische en economische eenheid beheerd door eenzelfde operator waar bepaalde activiteiten plaartsvinden mbt productie en dienstverlening."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam waaronder het complex gekend is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Activiteitencomplex.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waaronder het complex gekend is."@nl;
    shacl:maxCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "functie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Eventueel aangevuld met informatie over inputs en outputs van de activiteiten."@nl;
    rdfs:comment "Activiteiten uitgevoerd door het complex."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Activiteitencomplex.Functie>;
    shacl:class <https://vocab.belgif.be/ns/generic#Function>;
    shacl:description "Activiteiten uitgevoerd door het complex."@nl;
    shacl:minCount "1";
    shacl:name "functie"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#function>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "Geometrie van het Activiteitencomplex om de ligging en omvang ervan te beschrijven."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Activiteitencomplex.Geometrie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "Geometrie van het Activiteitencomplex om de ligging en omvang ervan te beschrijven."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Externe Identificator van het complex."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Activiteitencomplex.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Externe Identificator van het complex."@nl;
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "documentatie"@nl;
    rdfs:comment "Verwijzing naar een Document met extra informatie over het Activiteitencomplex."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Activiteitencomplex.Documentatie>;
    shacl:class foaf:Document;
    shacl:description "Verwijzing naar een Document met extra informatie over het Activiteitencomplex."@nl;
    shacl:name "documentatie"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#documentation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "op"@nl;
    rdfs:comment "Nutsvoorzieningnetwerkelement dat behoort tot het complex."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Activiteitencomplex.Op>;
    shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityNetworkElement>;
    shacl:description "Nutsvoorzieningnetwerkelement dat behoort tot het complex."@nl;
    shacl:name "op"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#on>
  ], [
    a shacl:PropertyShape;
    rdfs:label "inNetwerk"@nl;
    rdfs:comment "Nutsvoorzieningnetwerk waartoe het complex behoort."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Activiteitencomplex.Innetwerk>;
    shacl:class <https://vocab.belgif.be/ns/utility-services#UtilityNetwork>;
    shacl:description "Nutsvoorzieningnetwerk waartoe het complex behoort."@nl;
    shacl:minCount "1";
    shacl:name "inNetwerk"@nl;
    shacl:path <https://vocab.belgif.be/ns/generic#ActivityComplex.inNetwork>
  ];
  shacl:targetClass <https://vocab.belgif.be/ns/generic#ActivityComplex> .

<https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#AdresShape> a shacl:NodeShape;
  rdfs:label "Adres"@nl;
  <http://purl.org/vocab/vann/usageNote> "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bv ingangaanduiding, trapaanduiding, verdiepaanduiding) of een gebouwnaam of kamernaam ed zijn mogelijk dmv een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren mbv het object adresvoorstelling."@nl;
  rdfs:comment "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid, een ligplaats, een standplaats of een perceel op basis van een gemeentenaam, een straatnaam, een huisnummer en eventueel een busnummer en een postcode."@nl;
  shacl:closed false;
  shacl:targetClass <https://vocab.belgif.be/ns/address#Adress> .

<https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv als attribuut ve persoon of gebouw. De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres,bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "volledig Adres"@nl;
    <http://purl.org/vocab/vann/usageNote> "Vermijdt fouten tgv het opsplitsen ve adres in zijn onderdelen. Geeft de voorgeschreven volgorde vd verschillende onderdelen weer."@nl;
    rdfs:comment "Het complete adres in één string, al dan niet geformatteerd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Adresvoorstelling.VolledigAdres>;
    shacl:datatype rdf:langString;
    shacl:description "Het complete adres in één string, al dan niet geformatteerd."@nl;
    shacl:maxCount "1";
    shacl:name "volledig Adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#fullAddress>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postbus"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Postbusnummer in een postkantoor."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Adresvoorstelling.Postbus>;
    shacl:datatype xsd:string;
    shacl:description "Postbusnummer in een postkantoor."@nl;
    shacl:maxCount "1";
