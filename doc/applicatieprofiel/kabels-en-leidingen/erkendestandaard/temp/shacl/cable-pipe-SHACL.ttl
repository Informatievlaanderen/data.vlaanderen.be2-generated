<https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#GeometrieShape> a shacl:NodeShape;
  rdfs:label "Geometrie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijft deze kenmerken dmv punten, lijnen, polygonen etc en coördinaten. OPMERKING: gebruik indien gevraagd de subklassen Punt of Curve. Voor andere gevallen gebruik de types uit uit het <a href=\"\">Simple Features Vocabulary</a>, bvb LineString, Polygon, Surface etc. Of gebruik Geometrie, in de wkt- of gml serialisatie wordt het type geometrie ook vermeld."@nl;
  rdfs:comment "Vorm- en positiekenmerken van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "als WKT"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik <a href=\\\"http://www.opengis.net/ont/geosparql#wktLiteral\\\">wktliteral</a> als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in wkt-formaat."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Geometrie.AlsWkt>;
    shacl:datatype rdfs:Literal;
    shacl:description "Geometrie uitgedrukt in wkt-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "als WKT"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#asWKT>
  ], [
    a shacl:PropertyShape;
    rdfs:label "als GML"@nl;
    <http://purl.org/vocab/vann/usageNote> "Use <a href='http://www.opengis.net/ont/geosparql#gmlLiteral'>gmlliteral</a> as datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in gml-formaat."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Geometrie.AlsGml>;
    shacl:datatype rdfs:Literal;
    shacl:description "Geometrie uitgedrukt in gml-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "als GML"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#asGML>
  ], [
    a shacl:PropertyShape;
    rdfs:label "opmeting"@nl;
    rdfs:comment "De manier waarop de geometrie werd bepaald."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/erkendestandaard/temp#Geometrie.Opmeting>;
