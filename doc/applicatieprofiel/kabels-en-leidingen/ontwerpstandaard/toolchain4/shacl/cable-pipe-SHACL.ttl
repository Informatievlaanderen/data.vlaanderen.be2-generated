    shacl:maxCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/ontwerpstandaard/toolchain4#Activiteitencomplex.Functie>;
