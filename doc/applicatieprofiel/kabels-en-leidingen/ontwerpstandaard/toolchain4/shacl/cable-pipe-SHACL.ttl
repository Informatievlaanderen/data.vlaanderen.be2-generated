<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/ontwerpstandaard/toolchain4#Adresvoorstelling.VolledigAdres>;
