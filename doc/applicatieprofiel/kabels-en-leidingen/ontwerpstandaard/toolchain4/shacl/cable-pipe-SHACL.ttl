    shacl:maxCount "1";
    shacl:name "volledig Adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#fullAddress>
  ], [
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/ontwerpstandaard/toolchain4#Adresvoorstelling.Postbus>;
