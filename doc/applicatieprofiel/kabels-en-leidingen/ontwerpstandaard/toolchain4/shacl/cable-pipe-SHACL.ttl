<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/ontwerpstandaard/toolchain4#AansluitingShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/ontwerpstandaard/toolchain4#Aansluiting.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres van de aansluiting."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#address>
  ], [
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/ontwerpstandaard/toolchain4#Aansluiting.Toebehorentype>;
    shacl:class skos:Concept;
    shacl:description "Aard van het Toebehoren."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "toebehorentype"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#Connection.appurtenanceType>
  ];
  shacl:targetClass <https://vocab.belgif.be/ns/utility-services#Connection> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/ontwerpstandaard/toolchain4#ActiviteitencomplexShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kabels-en-leidingen/ontwerpstandaard/toolchain4#Activiteitencomplex.Naam>;
    shacl:datatype rdf:langString;
