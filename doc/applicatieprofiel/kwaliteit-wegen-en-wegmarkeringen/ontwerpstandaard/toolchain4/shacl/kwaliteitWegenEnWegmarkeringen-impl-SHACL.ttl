    rdfs:comment "De gebruikte procedure van de observatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/kwaliteit-wegen-en-wegmarkeringen/ontwerpstandaard/toolchain4#Kwaliteitsobservatie.Gebruikteprocedure>;
