  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "viewDescription";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Node.Viewdescription>;
    shacl:class <http://todo.com/ViewDescription>;
