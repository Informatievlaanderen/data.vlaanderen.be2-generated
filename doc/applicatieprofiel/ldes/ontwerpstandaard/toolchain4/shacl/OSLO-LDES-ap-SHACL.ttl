    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#NodeShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#RelatieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#VersieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#ObservatieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#ShapeShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#EventstreamviewShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#RetentionpolicyShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DurationagopolicyShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#LatestversionsubsetShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#VersieeventstreamShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#VersiematerialisatieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#AfgeleidecollectieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#VeranderlijkobjectShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#ObjectShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#CollectielidShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DatasetShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DataserviceShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DataserviceldesShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#SnapshotShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#LiteralShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DurationShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#IntegerShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DatetimeShape> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#AfgeleidecollectieShape> a shacl:NodeShape;
  rdfs:label "AfgeleideCollectie"@nl;
  rdfs:comment "Een collectie die afgeleid is van een andere collectie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "afgeleidVan"@nl;
    rdfs:comment "Een afleiding is een transformatie van de ene entiteit in een andere, een update van de ene entiteit naar een nieuwe, of de constructie van een nieuwe entiteit gebaseerd op een reeds bestaande entiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Afgeleidecollectie.Afgeleidvan>;
    shacl:class <https://w3id.org/tree#Collection>;
    shacl:description "Een afleiding is een transformatie van de ene entiteit in een andere, een update van de ene entiteit naar een nieuwe, of de constructie van een nieuwe entiteit gebaseerd op een reeds bestaande entiteit."@nl;
    shacl:minCount "1";
    shacl:name "afgeleidVan"@nl;
    shacl:path <http://purl.org/pav/derivedfrom>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/ldes#AfgeleideCollectie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#CollectieShape> a shacl:NodeShape;
  rdfs:label "Collectie"@nl;
  rdfs:comment "Een collectie is een verzameling van objecten. Deze leden voldoen allen aan een opgelegde shape."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "shape"@nl;
    rdfs:comment "Een shape is een technische beschrijving van de structuur waaraan de objecten uit de LDES moeten voldoen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Collectie.Shape>;
    shacl:class shacl:NodeShape;
    shacl:description "Een shape is een technische beschrijving van de structuur waaraan de objecten uit de LDES moeten voldoen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "shape"@nl;
    shacl:path <https://w3id.org/tree#shape>
  ], [
    a shacl:PropertyShape;
    rdfs:label "lid"@nl;
    rdfs:comment "Object dat deel uitmaakt van de collectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Collectie.Lid>;
    shacl:class <https://data.vlaanderen.be/ns/ldes#CollectieLid>;
    shacl:description "Object dat deel uitmaakt van de collectie."@nl;
    shacl:name "lid"@nl;
    shacl:path <https://w3id.org/tree#member>
  ], [
    a shacl:PropertyShape;
    rdfs:label "view"@nl;
    rdfs:comment "Een view is de index/ invariant/ organisatie waarmee doorheen de collectie (LDES) kan worden genavigeerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Collectie.View>;
    shacl:class <https://data.vlaanderen.be/ns/ldes#RootNode>;
    shacl:description "Een view is de index/ invariant/ organisatie waarmee doorheen de collectie (LDES) kan worden genavigeerd."@nl;
    shacl:name "view"@nl;
    shacl:path <https://w3id.org/tree#view>
  ];
  shacl:targetClass <https://w3id.org/tree#Collection> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#CollectielidShape> a shacl:NodeShape;
  rdfs:label "CollectieLid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Kan verder gespecialiseerd worden in functie van het soort collectie, bijvoorbeeld als de collectie een event stream is zijn de collectieleden onveranderlijke objecten."@nl;
  rdfs:comment "Een object dat deel uitmaakt van een collectie."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/ldes#CollectieLid> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DataserviceShape> a shacl:NodeShape;
  rdfs:label "Dataservice"@nl;
  rdfs:comment "Een verzameling van operaties die ofwel toegang bieden tot één of meer datasets ofwel een dataverwerkingsdoel hebben."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "endpointURL"@nl;
    rdfs:comment "De rootlocatie of het primaire endpoint van de dienst (een web-resolvable URi)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Dataservice.Endpointurl>;
    shacl:class rdfs:Resource;
    shacl:description "De rootlocatie of het primaire endpoint van de dienst (een web-resolvable URi)."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "endpointURL"@nl;
    shacl:path dcat:endpointURL
  ], [
    a shacl:PropertyShape;
    rdfs:label "conformAanProtocol"@nl;
    rdfs:comment "Een protocol waaraan de dataservice voldoet."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Dataservice.Conformaanprotocol>;
    shacl:class dc:Standard;
    shacl:description "Een protocol waaraan de dataservice voldoet."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "conformAanProtocol"@nl;
    shacl:path dc:conformsTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "biedtInformatieAanOver"@nl;
    rdfs:comment "De data die via deze dataservice worden aangeboden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Dataservice.Biedtinformatieaanover>;
    shacl:class <https://www.w3.org/ns/dcat#Dataset>;
    shacl:description "De data die via deze dataservice worden aangeboden."@nl;
    shacl:name "biedtInformatieAanOver"@nl;
    shacl:path dcat:servesdataset
  ];
  shacl:targetClass dcat:DataService .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DataserviceldesShape> a shacl:NodeShape;
  rdfs:label "DataServiceLDES"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het protocol is hier per default dat van de Linked Data Event Stream."@nl;
  rdfs:comment "Een verzameling van operaties die ofwel toegang bieden tot één of meer Linked Data Event Streams."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "endpointURL"@nl;
    rdfs:comment "De rootlocatie of het primaire endpoint van de dienst (een web-resolvable URi)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Dataserviceldes.Endpointurl>;
    shacl:class <https://data.vlaanderen.be/ns/ldes#RootNode>;
    shacl:description "De rootlocatie of het primaire endpoint van de dienst (een web-resolvable URi)."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "endpointURL"@nl;
    shacl:path dcat:endpointURL
  ], [
    a shacl:PropertyShape;
    rdfs:label "conformAanProtocol"@nl;
    rdfs:comment "Een protocol waaraan de dataservice voldoet."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Dataserviceldes.Conformaanprotocol>;
    shacl:class dc:Standard;
    shacl:description "Een protocol waaraan de dataservice voldoet."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "conformAanProtocol"@nl;
    shacl:path dc:conformsTo
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/ldes#DataServiceLDES> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DatasetShape> a shacl:NodeShape;
  rdfs:label "Dataset"@nl;
  rdfs:comment "Een verzameling gegevens, gepubliceerd of samengesteld door één agent, en beschikbaar voor toegang of download in één of meerdere voorstellingswijzen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "conform"@nl;
    rdfs:comment "Een standaard, schema, applicatieprofiel, vocabularium waaraan de dataset voldoet."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Dataset.Conform>;
    shacl:class dc:Standard;
    shacl:description "Een standaard, schema, applicatieprofiel, vocabularium waaraan de dataset voldoet."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "conform"@nl;
    shacl:path dc:conformsTo
  ];
  shacl:targetClass <https://www.w3.org/ns/dcat#Dataset> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DurationShape> a shacl:NodeShape;
  rdfs:label "Duration";
  shacl:closed false;
  shacl:targetClass xsd:duration .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#DurationagopolicyShape> a shacl:NodeShape;
  rdfs:label "DurationAgoPolicy"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een DurationAgoPolicy maakt gebruik van een tree:view om aan te duiden of de timestamp mag geherdefinieerd worden door het beleid zelf."@nl;
  rdfs:comment "Een op tijd gebaseerd retentiebeleid dat door middel van een waarde aangeeft van op welk moment in de tijd elementen geen deel meer mogen uitmaken van de Linked Data Event Stream."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "value"@nl;
    rdfs:comment "De waarde waarmee de gelinkte node in de relatie tussen de nodes is vergeleken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Durationagopolicy.Value>;
    shacl:datatype xsd:duration;
    shacl:description "De waarde waarmee de gelinkte node in de relatie tussen de nodes is vergeleken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "value"@nl;
    shacl:path <https://w3id.org/tree#value>
  ], [
    a shacl:PropertyShape;
    rdfs:label "timestampPath"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een SHACL property path naar de timestamp wanneer het versie-object een element werd van de event stream."@nl;
    rdfs:comment "Geeft weer hoe elementen van een LDES zich tot elkaar verhouden door een tijdstip."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Durationagopolicy.Timestamppath>;
    shacl:class rdfs:Resource;
    shacl:description "Geeft weer hoe elementen van een LDES zich tot elkaar verhouden door een tijdstip."@nl;
    shacl:maxCount "1";
    shacl:name "timestampPath"@nl;
    shacl:path <https://w3id.org/ldes#timestampPath>
  ];
  shacl:targetClass <https://w3id.org/ldes#DurationAgoPolicy> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#EventstreamShape> a shacl:NodeShape;
  rdfs:label "EventStream"@nl;
  rdfs:comment "Een collectie van onveranderlijke objecten (zoals versie-objecten & sensor-observaties). Deze objecten volgen een opgelegde shape."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "timestampPath"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een SHACL property path naar de timestamp wanneer het versie-object een element werd van de event stream."@nl;
    rdfs:comment "Geeft weer hoe elementen van een LDES zich tot elkaar verhouden door een specifiek tijdstip."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Eventstream.Timestamppath>;
    shacl:class rdfs:Resource;
    shacl:description "Geeft weer hoe elementen van een LDES zich tot elkaar verhouden door een specifiek tijdstip."@nl;
    shacl:maxCount "1";
    shacl:name "timestampPath"@nl;
    shacl:path <https://w3id.org/ldes#timestampPath>
  ], [
    a shacl:PropertyShape;
    rdfs:label "versionOfPath"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een SHACL property path naar de niet-geversioneerde identifier van een element."@nl;
    rdfs:comment "Geeft de versie van het element weer."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Eventstream.Versionofpath>;
    shacl:class rdfs:Resource;
    shacl:description "Geeft de versie van het element weer."@nl;
    shacl:maxCount "1";
    shacl:name "versionOfPath"@nl;
    shacl:path <https://w3id.org/ldes#versionOfPath>
  ], [
    a shacl:PropertyShape;
    rdfs:label "shape"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een shape wordt opgelegd aan alle elementen van de LDES. Voorbeelden van zo'n shape zijn SHACL en ShEx."@nl;
    rdfs:comment "Een schema waaraan alle elementen in de eventstream moeten voldoen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Eventstream.Shape>;
    shacl:class shacl:NodeShape;
    shacl:description "Een schema waaraan alle elementen in de eventstream moeten voldoen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "shape"@nl;
    shacl:path <https://w3id.org/tree#shape>
  ], [
    a shacl:PropertyShape;
    rdfs:label "view"@nl;
    rdfs:comment "Een view is de index/invariant/organisatie waarmee doorheen de collectie/ Linked Data Event Stream kan worden genavigeerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Eventstream.View>;
    shacl:class <https://data.vlaanderen.be/ns/ldes#RootNode>;
    shacl:description "Een view is de index/invariant/organisatie waarmee doorheen de collectie/ Linked Data Event Stream kan worden genavigeerd."@nl;
    shacl:name "view"@nl;
    shacl:path <https://w3id.org/tree#view>
  ], [
    a shacl:PropertyShape;
    rdfs:label "lid"@nl;
    rdfs:comment "Onveranderlijk object dat deel uitmaakt van de collectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Eventstream.Lid>;
    shacl:class <https://data.vlaanderen.be/ns/ldes#OnveranderlijkObject>;
    shacl:description "Onveranderlijk object dat deel uitmaakt van de collectie."@nl;
    shacl:name "lid"@nl;
    shacl:path <https://w3id.org/tree#member>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eventstreamView"@nl;
    rdfs:comment "De event stream view connecteert de collectie met de rootnode zodanig dat alle leden van de collectie gevonden kunnen worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Eventstream.Eventstreamview>;
    shacl:class <https://data.vlaanderen.be/ns/ldes#EventstreamView>;
    shacl:description "De event stream view connecteert de collectie met de rootnode zodanig dat alle leden van de collectie gevonden kunnen worden."@nl;
    shacl:name "eventstreamView"@nl;
    shacl:path <http://todo.com/eventStreamView>
  ];
  shacl:targetClass <https://w3id.org/ldes#EventStream> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#EventstreamviewShape> a shacl:NodeShape;
  rdfs:label "EventstreamView"@nl;
  rdfs:comment "De event stream view connecteert de collectie met de rootnode zodanig dat alle leden van de collectie gevonden kunnen worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "retentiebeleid"@nl;
    rdfs:comment "Een retentiebeleid is een beleid volgens welke elementen (i.e. data) verwijderd zullen worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Eventstreamview.Retentiebeleid>;
    shacl:class <https://w3id.org/ldes#RetentionPolicy>;
    shacl:description "Een retentiebeleid is een beleid volgens welke elementen (i.e. data) verwijderd zullen worden."@nl;
    shacl:maxCount "1";
    shacl:name "retentiebeleid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/ldes#retentiebeleid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eventstream"@nl;
    rdfs:comment "De event stream view connecteert de collectie met de rootnode zodanig dat alle leden van de collectie gevonden kunnen worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Eventstreamview.Eventstream>;
    shacl:class <https://w3id.org/ldes#EventStream>;
    shacl:description "De event stream view connecteert de collectie met de rootnode zodanig dat alle leden van de collectie gevonden kunnen worden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "eventstream"@nl;
    shacl:path <http://todo.com/eventStream>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rootNode"@nl;
    rdfs:comment "Een rootnode is een beginpagina, die zelf al leden kan bevatten, via wiens gelinkte pagina’s alle leden kunnen gevonden worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Eventstreamview.Rootnode>;
    shacl:class <https://data.vlaanderen.be/ns/ldes#RootNode>;
    shacl:description "Een rootnode is een beginpagina, die zelf al leden kan bevatten, via wiens gelinkte pagina’s alle leden kunnen gevonden worden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "rootNode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/ldes#rootNode>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/ldes#EventstreamView> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#IntegerShape> a shacl:NodeShape;
  rdfs:label "Integer";
  shacl:closed false;
  shacl:targetClass xsd:integer .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#LatestversionsubsetShape> a shacl:NodeShape;
  rdfs:label "LatestVersionSubset"@nl;
  rdfs:comment "De laatste versie van een element/subset dat voldoet aan een bepaald beleid."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "amount"@nl;
    rdfs:comment "Aantal versies van één element die behouden mogen worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Latestversionsubset.Amount>;
    shacl:datatype xsd:integer;
    shacl:description "Aantal versies van één element die behouden mogen worden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "amount"@nl;
    shacl:path <https://w3id.org/ldes#amount>
  ], [
    a shacl:PropertyShape;
    rdfs:label "timestampPath"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een SHACL property path naar de timestamp wanneer het versie-object een element werd van de event stream."@nl;
    rdfs:comment "Geeft weer hoe elementen van een Linked Data Event Stream zich tot elkaar verhouden door een tijdstip."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Latestversionsubset.Timestamppath>;
    shacl:class rdfs:Resource;
    shacl:description "Geeft weer hoe elementen van een Linked Data Event Stream zich tot elkaar verhouden door een tijdstip."@nl;
    shacl:maxCount "1";
    shacl:name "timestampPath"@nl;
    shacl:path <https://w3id.org/ldes#timestampPath>
  ], [
    a shacl:PropertyShape;
    rdfs:label "versionOfPath"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een SHACL property path naar de niet-geversioneerde identifier van een element."@nl;
    rdfs:comment "Geeft de versie van het element weer."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Latestversionsubset.Versionofpath>;
    shacl:class rdfs:Resource;
    shacl:description "Geeft de versie van het element weer."@nl;
    shacl:maxCount "1";
    shacl:name "versionOfPath"@nl;
    shacl:path <https://w3id.org/ldes#versionOfPath>
  ], [
    a shacl:PropertyShape;
    rdfs:label "versionKey"@nl;
    rdfs:comment "Een lijst van SHACL property paths die samen een version key vormen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#Latestversionsubset.Versionkey>;
    shacl:class rdfs:Resource;
    shacl:description "Een lijst van SHACL property paths die samen een version key vormen."@nl;
    shacl:name "versionKey"@nl;
    shacl:path <https://w3id.org/ldes#versionKey>
  ];
  shacl:targetClass <https://w3id.org/ldes#LatestVersionSubset> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#LiteralShape> a shacl:NodeShape;
  rdfs:label "Literal";
  shacl:closed false;
  shacl:targetClass rdfs:Literal .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ldes/ontwerpstandaard/toolchain4#NodeShape> a shacl:NodeShape;
  rdfs:label "Node"@nl;
  rdfs:comment "Een node is een pagina die relaties naar andere nodes kan bevatten."@nl;
