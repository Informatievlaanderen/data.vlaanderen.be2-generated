<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#ToekenningsprocesShape> a shacl:NodeShape;
  rdfs:label "Toekenningsproces"@nl;
  rdfs:comment "Het proces waarbij een organisatie een leerprestatie toekent aan een persoon op basis van een leerspecificatie (bv. een kwalificatie). Het wordt gebruikt om de organisatie te specificeren die de leerspecificatie aan de persoon heeft toegekend, het land of de regio waar de leerspecificatie werd toegekend, en optioneel de datum van toekenning."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "toekenningsdatum"@nl;
    rdfs:comment "De datum waarop de leerspecificatie werd toegekend. Indien niet gespecificeerd is deze ongedefinieerd (\"niet bekend\")."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Toekenningsproces.Toekenningsdatum>;
    shacl:datatype xsd:dateTime;
