<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#VestigingShape> a shacl:NodeShape;
  rdfs:label "Vestiging"@nl;
  <http://purl.org/vocab/vann/usageNote> "Meestal zal de vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten,bv een virtueel kantoor met bijbehorend postnummer en telefonische receptie."@nl;
  rdfs:comment "Een kantoor of ander pand waar een organisatie gevestigd is. Organisaties kunnen over meerdere vestigingen verspreid zijn en vestigingen kunnen op meerdere locaties slaan."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Vestiging.Locatie>;
    shacl:class prov:Location;
    shacl:minCount "1";
    shacl:name "locatie"@nl;
    shacl:path <http://data.europa.eu/m8g/location>
  ];
  shacl:targetClass org:Site .

