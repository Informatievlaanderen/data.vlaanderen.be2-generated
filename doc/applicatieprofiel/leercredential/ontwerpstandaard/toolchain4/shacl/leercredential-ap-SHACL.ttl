    rdfs:comment "Organisatie die deze organisatie omvat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Organisatie.IsSuborganisatieVan>;
    shacl:class org:Organization;
    shacl:description "Organisatie die deze organisatie omvat."@nl;
    shacl:name "is suborganisatie van"@nl;
    shacl:path org:subOrganizationOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "accreditatie"@nl;
    rdfs:comment "TODO"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Organisatie.Accreditatie>;
