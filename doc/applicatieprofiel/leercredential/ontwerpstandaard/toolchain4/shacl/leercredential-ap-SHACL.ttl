<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Organisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv commerciële naam, informele naam…"@nl;
    rdfs:comment "Andere naam waaronder de organisatie bekend is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Organisatie.AlternatieveNaam>;
    shacl:datatype rdf:langString;
    shacl:description "Andere naam waaronder de organisatie bekend is."@nl;
    shacl:name "alternatieve naam"@nl;
    shacl:path skos:altLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "classificatie"@nl;
    rdfs:comment "Rangschikking van de organisatie in een classificatiesysteem."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Organisatie.Classificatie>;
    shacl:class skos:Concept;
    shacl:description "Rangschikking van de organisatie in een classificatiesysteem."@nl;
    shacl:name "classificatie"@nl;
    shacl:path org:classification
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Organisatie.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "homepage"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Adres vd homepage van de website vd organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Organisatie.Homepage>;
    shacl:class <https://data.europa.eu/snb/model#Webresource>;
    shacl:description "Adres vd homepage van de website vd organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "homepage"@nl;
    shacl:path foaf:homepage
  ], [
    a shacl:PropertyShape;
    rdfs:label "extra informatie"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Organisatie.ExtraInformatie>;
    shacl:class <https://data.europa.eu/snb/model#Note>;
