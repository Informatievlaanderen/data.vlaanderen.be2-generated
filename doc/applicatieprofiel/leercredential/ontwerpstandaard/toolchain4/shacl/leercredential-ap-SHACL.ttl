    rdfs:comment "De minimale score."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#ResultaatCategorie.MinimumScore>;
