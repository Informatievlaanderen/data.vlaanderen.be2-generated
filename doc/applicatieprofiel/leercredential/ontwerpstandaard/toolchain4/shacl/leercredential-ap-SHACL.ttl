    shacl:description "Aanvullende informatie over het nationale systeem van dit toekenningsproces."@nl;
    shacl:maxCount "1";
    shacl:name "nationaal systeem"@nl;
    shacl:path <https://data.europa.eu/snb/model#nationalSystemNote>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Een alternatieve identificatie van het toekenningsproces."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Toekenningsproces.Identificator>;
