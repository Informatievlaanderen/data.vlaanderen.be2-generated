    shacl:datatype xsd:dateTime;
    shacl:description "Aanvang van de tijdsduur."@nl;
    shacl:maxCount "1";
    shacl:name "begin"@nl;
    shacl:path <http://www.w3.org/2006/time#hasBeginning>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einde"@nl;
    rdfs:comment "Einde vd tijdsduur."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Periode.Einde>;
    shacl:datatype xsd:dateTime;
