    shacl:maxCount "1";
    shacl:name "toekenningsdatum"@nl;
    shacl:path <https://data.europa.eu/snb/model#awardingDate>
  ], [
    a shacl:PropertyShape;
    rdfs:label "nationaal systeem"@nl;
    rdfs:comment "Aanvullende informatie over het nationale systeem van dit toekenningsproces."@nl;
