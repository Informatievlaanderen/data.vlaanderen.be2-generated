    shacl:name "duur"@nl;
    shacl:path <http://www.w3.org/2006/time#hasDuration>
  ], [
    a shacl:PropertyShape;
    rdfs:label "begin"@nl;
    rdfs:comment "Aanvang van de tijdsduur."@nl;
