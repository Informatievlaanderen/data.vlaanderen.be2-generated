    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#ResultaatCategorie.Label>;
    shacl:description "Het label van de histogramscore of scorebereik. Moet overeenkomen met het beoordelingsschema dat is gebruikt, bijvoorbeeld 'C' of '20-30 '."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "label"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <https://data.europa.eu/snb/model#label>
  ], [
    a shacl:PropertyShape;
