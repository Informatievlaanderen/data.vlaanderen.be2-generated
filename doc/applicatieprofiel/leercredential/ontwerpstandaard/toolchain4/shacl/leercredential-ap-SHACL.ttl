<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#AccreditatieShape> a shacl:NodeShape;
  rdfs:label "Accreditatie"@nl;
  rdfs:comment "De kwaliteitsborging of het verlenen van vergunningen aan een organisatie of een kwalificatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "Een titel van de accreditatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "Een titel van de accreditatie."@nl;
    shacl:maxCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beslissing"@nl;
    rdfs:comment "Het door de kwaliteitsborgingsautoriteit afgegeven kwaliteitsbesluit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Beslissing>;
    shacl:datatype xsd:string;
    shacl:description "Het door de kwaliteitsborgingsautoriteit afgegeven kwaliteitsbesluit."@nl;
    shacl:maxCount "1";
    shacl:name "beslissing"@nl;
    shacl:path <https://data.europa.eu/snb/model#decision>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgave datum"@nl;
    rdfs:comment "De datum waarop de accreditatie formeel werd goedgekeurd/afgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.UitgaveDatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop de accreditatie formeel werd goedgekeurd/afgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "uitgave datum"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "herzieningsdatum"@nl;
    rdfs:comment "De datum waarop de accreditatie opnieuw moet worden bekeken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Herzieningsdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop de accreditatie opnieuw moet worden bekeken."@nl;
    shacl:maxCount "1";
    shacl:name "herzieningsdatum"@nl;
    shacl:path <https://data.europa.eu/snb/model#reviewDate>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vervaldatum"@nl;
    rdfs:comment "De datum waarop de accreditatie vervalt of is verlopen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Vervaldatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop de accreditatie vervalt of is verlopen."@nl;
    shacl:maxCount "1";
    shacl:name "vervaldatum"@nl;
    shacl:path <https://data.europa.eu/snb/model#expiryDate>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De overdraagbare en unieke identificatiecode van het accreditatiedossier."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "De overdraagbare en unieke identificatiecode van het accreditatiedossier."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "accreditatietype"@nl;
    rdfs:comment "De aard van de accreditatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Accreditatietype>;
    shacl:class skos:Concept;
    shacl:description "De aard van de accreditatie."@nl;
    shacl:name "accreditatietype"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "rapport"@nl;
    rdfs:comment "De landingspagina van de accreditatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Rapport>;
    shacl:class <https://data.europa.eu/snb/model#Webresource>;
    shacl:description "De landingspagina van de accreditatie."@nl;
    shacl:maxCount "1";
    shacl:name "rapport"@nl;
    shacl:path <https://data.europa.eu/snb/model#report>
  ], [
    a shacl:PropertyShape;
    rdfs:label "studiegebied"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het moet worden verstrekt met behulp van het door ISCECT-F gecontroleerde vocabularium."@nl;
    rdfs:comment "Het onderwijsveld waarvoor de accreditatie geldig is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Studiegebied>;
    shacl:class skos:Concept;
    shacl:description "Het onderwijsveld waarvoor de accreditatie geldig is."@nl;
    shacl:name "studiegebied"@nl;
    shacl:path <https://data.europa.eu/snb/model#limitField>
  ], [
    a shacl:PropertyShape;
    rdfs:label "onderwijsniveau"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het moet worden verstrekt met behulp van het EQF-gecontroleerde vocabularium."@nl;
    rdfs:comment "Het Europese kwalificatieraamwerk waarvoor de accreditatie geldig is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Onderwijsniveau>;
    shacl:class skos:Concept;
    shacl:description "Het Europese kwalificatieraamwerk waarvoor de accreditatie geldig is."@nl;
    shacl:name "onderwijsniveau"@nl;
    shacl:path <https://data.europa.eu/snb/model#limitEQFLevel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "jurisdictie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het moet worden verstrekt met behulp van de Administrative Territorial Unit Authority Table (ATU)."@nl;
    rdfs:comment "Het rechtsgebied waarvoor de accreditatie geldig is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Jurisdictie>;
    shacl:class dc:Jurisdiction;
    shacl:description "Het rechtsgebied waarvoor de accreditatie geldig is."@nl;
    shacl:name "jurisdictie"@nl;
    shacl:path <https://data.europa.eu/snb/model#limitJurisdiction>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verstrekt door"@nl;
    rdfs:comment "De kwaliteitsborgingsautoriteit (d.w.z. beoordelaar)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.VerstrektDoor>;
    shacl:class org:Organization;
    shacl:description "De kwaliteitsborgingsautoriteit (d.w.z. beoordelaar)."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "verstrekt door"@nl;
    shacl:path <https://data.europa.eu/snb/model#accreditingAgent>
  ], [
    a shacl:PropertyShape;
    rdfs:label "extra informatie"@nl;
    rdfs:comment "Een aanvullende opmerking in vrije tekst over de accreditatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.ExtraInformatie>;
    shacl:class <https://data.europa.eu/snb/model#Note>;
    shacl:description "Een aanvullende opmerking in vrije tekst over de accreditatie."@nl;
    shacl:name "extra informatie"@nl;
    shacl:path <https://data.europa.eu/snb/model#additionalNote>
  ], [
    a shacl:PropertyShape;
    rdfs:label "homepagina"@nl;
    rdfs:comment "De homepage van de accreditatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Homepagina>;
    shacl:class <https://data.europa.eu/snb/model#Webresource>;
    shacl:description "De homepage van de accreditatie."@nl;
    shacl:name "homepagina"@nl;
    shacl:path foaf:homepage
  ], [
    a shacl:PropertyShape;
    rdfs:label "landingspagina"@nl;
    rdfs:comment "De webpagina van de accreditatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Landingspagina>;
    shacl:class <https://data.europa.eu/snb/model#Webresource>;
    shacl:description "De webpagina van de accreditatie."@nl;
    shacl:name "landingspagina"@nl;
    shacl:path <https://data.europa.eu/snb/model#landingPage>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanvullend document"@nl;
    rdfs:comment "Een openbaar webdocument met aanvullende documentatie over de accreditatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.AanvullendDocument>;
    shacl:class <https://data.europa.eu/snb/model#Webresource>;
    shacl:description "Een openbaar webdocument met aanvullende documentatie over de accreditatie."@nl;
    shacl:name "aanvullend document"@nl;
    shacl:path <https://data.europa.eu/snb/model#supplementaryDocument>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een beschrijving van de accreditatie in vrije tekst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Beschrijving>;
    shacl:class <https://data.europa.eu/snb/model#Note>;
    shacl:description "Een beschrijving van de accreditatie in vrije tekst."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "accreditatiestatus"@nl;
    rdfs:comment "De publicatiestatus van een accreditatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Accreditatiestatus>;
    shacl:class skos:Concept;
    shacl:description "De publicatiestatus van een accreditatie."@nl;
    shacl:maxCount "1";
    shacl:name "accreditatiestatus"@nl;
    shacl:path <https://data.europa.eu/snb/model#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "organisatie"@nl;
    rdfs:comment "De organisatie waarvan de activiteiten worden geaccrediteerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Accreditatie.Organisatie>;
    shacl:class org:Organization;
    shacl:description "De organisatie waarvan de activiteiten worden geaccrediteerd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "organisatie"@nl;
    shacl:path <https://data.europa.eu/snb/model#organisation>
  ], [
    a shacl:PropertyShape;
