<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#PeriodeShape> a shacl:NodeShape;
  rdfs:label "Periode"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typisch volgt de duur uit het opgeven ve begin- en eindtijdstip. CONSTRAINT: begin OF duur verplicht."@nl;
  rdfs:comment "Min of meer afgebakende tijdsduur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "duur"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Periode.Duur>;
    shacl:datatype xsd:duration;
