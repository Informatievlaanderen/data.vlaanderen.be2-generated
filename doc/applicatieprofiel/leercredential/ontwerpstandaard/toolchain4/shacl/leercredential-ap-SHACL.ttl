<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#WebdocumentShape> a shacl:NodeShape;
  rdfs:label "Webdocument"@nl;
  rdfs:comment "Een webdocument."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Eén waarde per taal is toegestaan."@nl;
    rdfs:comment "De titel van de webbron."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Webdocument.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De titel van de webbron."@nl;
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "inhoud"@nl;
    rdfs:comment "De openbare toegangs-URL van de webbron."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Webdocument.Inhoud>;
    shacl:datatype xsd:anyURI;
    shacl:description "De openbare toegangs-URL van de webbron."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "inhoud"@nl;
    shacl:path <https://data.europa.eu/snb/model#contentUrl>
  ], [
    a shacl:PropertyShape;
    rdfs:label "taal"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het moet worden verstrekt met behulp van de Language Authority Table."@nl;
    rdfs:comment "De taal van de webresource."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leercredential/ontwerpstandaard/toolchain4#Webdocument.Taal>;
    shacl:class skos:Concept;
    shacl:description "De taal van de webresource."@nl;
    shacl:maxCount "1";
    shacl:name "taal"@nl;
    shacl:path dc:language
  ];
  shacl:targetClass <https://data.europa.eu/snb/model#Webresource> .

