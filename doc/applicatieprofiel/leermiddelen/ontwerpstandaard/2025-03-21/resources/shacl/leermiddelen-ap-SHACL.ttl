<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gedeeldDoor"@nl;
    rdfs:comment "Deze relatie toont aan dat een CreatiefWerk steeds gedeeld wordt door een Agent."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Agent.Gedeelddoor>;
    shacl:class schemas:CreativeWork;
    shacl:description "Deze relatie toont aan dat een CreatiefWerk steeds gedeeld wordt door een Agent."@nl;
    shacl:name "gedeeldDoor"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#gedeeldDoor>
  ];
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#CompetentieShape> a shacl:NodeShape;
  rdfs:label "Competentie"@nl;
  rdfs:comment "Een specifiek geheel van kennis, vaardigheden en attitudes die door een leerder moet worden beheerst."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/leermiddelen#Competentie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#CreatiefwerkShape> a shacl:NodeShape;
  rdfs:label "CreatiefWerk"@nl;
  rdfs:comment "Een intellectueel of artistiek resultaat dat voorkomt uit originele inspanning of verbeelding."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "auteursrechtJaar"@nl;
    rdfs:comment "Het jaar waarin het geclaimde auteursrecht voor het CreatiefWerk voor het eerst werd geclaimd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Creatiefwerk.Auteursrechtjaar>;
    shacl:datatype xsd:dateTime;
    shacl:description "Het jaar waarin het geclaimde auteursrecht voor het CreatiefWerk voor het eerst werd geclaimd."@nl;
    shacl:maxCount "1";
    shacl:name "auteursrechtJaar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#auteursrechtJaar>
  ], [
    a shacl:PropertyShape;
    rdfs:label "versie"@nl;
    rdfs:comment "De versie van het CreatiefWerk."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Creatiefwerk.Versie>;
    shacl:datatype rdf:langString;
    shacl:description "De versie van het CreatiefWerk."@nl;
    shacl:maxCount "1";
    shacl:name "versie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#versie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "publicatieDatum"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit kan bijvoorbeeld de datum zijn waarop een CreatiefWerk werd uitgezonden of een Certification werd uitgegeven."@nl;
    rdfs:comment "Datum van eerste publicatie of uitzending."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Creatiefwerk.Publicatiedatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum van eerste publicatie of uitzending."@nl;
    shacl:maxCount "1";
    shacl:name "publicatieDatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#publicatieDatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft"@nl;
    rdfs:comment "Deze relatie toont aan dat een CreatiefWerk steeds een bepaalde vorm van een Licentie heeft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Creatiefwerk.Heeft>;
    shacl:class <https://data.vlaanderen.be/ns/leermiddelen#Licentie>;
    shacl:description "Deze relatie toont aan dat een CreatiefWerk steeds een bepaalde vorm van een Licentie heeft."@nl;
    shacl:name "heeft"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#heeft>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geproduceerdDoor"@nl;
    rdfs:comment "Deze relatie toont aan dat een CreatiefWerk steeds geproduceerd wordt door een Agent."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Creatiefwerk.Geproduceerddoor>;
    shacl:class dc:Agent;
    shacl:description "Deze relatie toont aan dat een CreatiefWerk steeds geproduceerd wordt door een Agent."@nl;
    shacl:minCount 1;
    shacl:name "geproduceerdDoor"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#geproduceerdDoor>
  ];
  shacl:targetClass schemas:CreativeWork .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#DoelShape> a shacl:NodeShape;
  rdfs:label "Doel"@nl;
  rdfs:comment "Beschrijving van wat een lerende moet weten, kunnen of welke houding deze moet hebben na het voltooien van een leeractiviteit of opleiding."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een duidelijke formulering van het Doel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Doel.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een duidelijke formulering van het Doel."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#beschrijving>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gedefinieerdDoor"@nl;
    rdfs:comment "De entiteit die verantwoordelijk is voor het vaststellen van het Doel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Doel.Gedefinieerddoor>;
    shacl:class dc:Agent;
    shacl:description "De entiteit die verantwoordelijk is voor het vaststellen van het Doel."@nl;
    shacl:minCount "1";
    shacl:name "gedefinieerdDoor"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#gedefinieerdDoor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gerelateerdAan"@nl;
    rdfs:comment "Deze zelfrelatie toont aan dat een Doel gerelateerd is aan één of meerdere andere Doelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Doel.Gerelateerdaan>;
    shacl:class <https://data.vlaanderen.be/ns/leermiddelen#Doel>;
    shacl:description "Deze zelfrelatie toont aan dat een Doel gerelateerd is aan één of meerdere andere Doelen."@nl;
    shacl:name "gerelateerdAan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#gerelateerdAan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isSpecialisatieVan"@nl;
    rdfs:comment "Deze zelfrelatie toont aan dat een Doel potentieel een specialisatie is van een ander Doel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Doel.Isspecialisatievan>;
    shacl:class <https://data.vlaanderen.be/ns/leermiddelen#Doel>;
    shacl:description "Deze zelfrelatie toont aan dat een Doel potentieel een specialisatie is van een ander Doel."@nl;
    shacl:name "isSpecialisatieVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#isSpecialisatieVan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isBrederDan"@nl;
    rdfs:comment "Deze zelfrelatie toont aan dat een Doel potentieel breder is dan een ander Doel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Doel.Isbrederdan>;
    shacl:class <https://data.vlaanderen.be/ns/leermiddelen#Doel>;
    shacl:description "Deze zelfrelatie toont aan dat een Doel potentieel breder is dan een ander Doel."@nl;
    shacl:name "isBrederDan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#isBrederDan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bestaatUit"@nl;
    rdfs:comment "Deze zelfrelatie toont aan dat een Doel kan bestaan uit geen of meerdere andere Doelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Doel.Bestaatuit>;
    shacl:class <https://data.vlaanderen.be/ns/leermiddelen#Doel>;
    shacl:description "Deze zelfrelatie toont aan dat een Doel kan bestaan uit geen of meerdere andere Doelen."@nl;
    shacl:name "bestaatUit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#bestaatUit>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/leermiddelen#Doel> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#DoelgroepShape> a shacl:NodeShape;
  rdfs:label "Doelgroep"@nl;
  rdfs:comment "Deze zelfrelatie toont aan dat een Doel kan bestaan uit geen of meerdere andere Doelen."@nl,
    "Een groep van individuen met gezamenlijke kenmerken, behoeften of interesses, waarop een Leermiddel of Doel is gericht om effectief in te spelen op hun verwachtingen."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept,
    <https://data.vlaanderen.be/ns/leermiddelen#Doelgroep> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#DoeltypeShape> a shacl:NodeShape;
  rdfs:label "Doeltype"@nl;
  rdfs:comment "De categorie waartoe het element behoort binnen een specifiek kader."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/leermiddelen#DoelType> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#FormaattypeShape> a shacl:NodeShape;
  rdfs:label "FormaatType"@nl;
  rdfs:comment "De fysieke of digitale structuur waarin een Leermiddel wordt gepresenteerd."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/leermiddelen#FormaatType> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#InteractietypeShape> a shacl:NodeShape;
  rdfs:label "InteractieType"@nl;
  rdfs:comment "De aard van de wederzijdse actie of communicatie tussen gebruiker en systeem."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/leermiddelen#InteractieType> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#KostShape> a shacl:NodeShape;
  rdfs:label "Kost"@nl;
  rdfs:comment "Het bedrag aan middelen, vaak uitgedrukt in geld, dat nodig is voor het gebruik van het Leermiddel."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/leermiddelen#Kost> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#LangstringShape> a shacl:NodeShape;
  rdfs:label "LangString";
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#LeeractiviteitShape> a shacl:NodeShape;
  rdfs:label "Leeractiviteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze entitieit bevat de datapunten die te maken hebben met de deelname van een student aan een welbepaalde Leeropportuniteit."@nl;
  rdfs:comment "Elk proces dat leidt tot het verwerven van kennis,vaardigheden of verantwoordelijkheid en zelfstandigheid."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "heeft deel"@nl;
    rdfs:comment "Kleinere activiteitseenheden, die bij combinatie deze activiteit vormen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Leeractiviteit.HeeftDeel>;
    shacl:class <http://data.europa.eu/snb/model/elm/LearningActivity>;
    shacl:description "Kleinere activiteitseenheden, die bij combinatie deze activiteit vormen."@nl;
    shacl:name "heeft deel"@nl;
    shacl:path <http://data.europa.eu/snb/model/elm/hasPart>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is deel van"@nl;
    rdfs:comment "Een leeractiviteit waar deze leeractiviteit onderdeel van uitmaakt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Leeractiviteit.IsDeelVan>;
    shacl:class <http://data.europa.eu/snb/model/elm/LearningActivity>;
    shacl:description "Een leeractiviteit waar deze leeractiviteit onderdeel van uitmaakt."@nl;
    shacl:name "is deel van"@nl;
    shacl:path <http://data.europa.eu/snb/model/elm/isPartOf>
  ], [
    a shacl:PropertyShape;
    rdfs:label "specificatie"@nl;
    rdfs:comment "De specificatie van deze leeractiviteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Leeractiviteit.Specificatie>;
    shacl:class <http://data.europa.eu/snb/model/elm/LearningActivitySpecification>;
    shacl:description "De specificatie van deze leeractiviteit."@nl;
    shacl:maxCount "1";
    shacl:name "specificatie"@nl;
    shacl:path <http://data.europa.eu/snb/model/elm/specifiedBy>
  ], [
    a shacl:PropertyShape;
    rdfs:label "workload"@nl;
    rdfs:comment "De feitelijke werklast in aantal uren dat de leerder aan de activiteit heeft besteed. Dit omvat het aantal uren in de klas, in groepsverband, in practica, alsook het aantal uren dat de leerder aan zelfstudie heeft besteed."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Leeractiviteit.Workload>;
    shacl:class <https://www.w3.org/TR/owl-time/#time:Duration>;
    shacl:description "De feitelijke werklast in aantal uren dat de leerder aan de activiteit heeft besteed. Dit omvat het aantal uren in de klas, in groepsverband, in practica, alsook het aantal uren dat de leerder aan zelfstudie heeft besteed."@nl;
    shacl:maxCount "1";
    shacl:name "workload"@nl;
    shacl:path <http://data.europa.eu/snb/model/elm/workload>
  ], [
    a shacl:PropertyShape;
    rdfs:label "maaktGebruikVan"@nl;
    rdfs:comment "Een Leeractiviteit maakt gebruik van een Leermiddel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Leeractiviteit.Maaktgebruikvan>;
    shacl:class <https://data.vlaanderen.be/ns/leermiddelen#Leermiddel>;
    shacl:description "Een Leeractiviteit maakt gebruik van een Leermiddel."@nl;
    shacl:name "maaktGebruikVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leercredential#maaktGebruikVan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "draagtBijAanHetBehalenVan"@nl;
    rdfs:comment "Een Leeractiviteit draagt bij aan het behalen van een Doel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Leeractiviteit.Draagtbijaanhetbehalenvan>;
    shacl:class <https://data.vlaanderen.be/ns/leermiddelen#Doel>;
    shacl:description "Een Leeractiviteit draagt bij aan het behalen van een Doel."@nl;
    shacl:name "draagtBijAanHetBehalenVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leercredential#draagtBijAanHetBehalenVan>
  ];
  shacl:targetClass <http://data.europa.eu/snb/model/elm/LearningActivity> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#LeeractiviteitspecificatieShape> a shacl:NodeShape;
  rdfs:label "Leeractiviteitspecificatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het opleidingsaanbod geformaliseerd volgens een bepaalde specificatie,zoals de ECTS. Zowel een opleidingsonderdeel als een programma kunnen op deze manier gespecifieerd worden."@nl;
  rdfs:comment "De specificatie van een proces dat leidt tot het verwerven van kennis,vaardigheden of verantwoordelijkheid en autonomie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contacturen"@nl;
    rdfs:comment "De contacturen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Leeractiviteitspecificatie.Contacturen>;
    shacl:datatype xsd:string;
    shacl:description "De contacturen."@nl;
    shacl:name "contacturen"@nl;
    shacl:path <http://data.europa.eu/snb/model/elm/contactHour>
  ], [
    a shacl:PropertyShape;
    rdfs:label "generalisatie van"@nl;
