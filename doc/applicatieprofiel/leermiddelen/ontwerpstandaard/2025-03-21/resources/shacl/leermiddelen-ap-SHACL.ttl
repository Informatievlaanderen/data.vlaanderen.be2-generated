<https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#LeermiddelShape> a shacl:NodeShape;
  rdfs:label "Leermiddel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze definitie is een specificatie gebaseerd op de definitie van de kwaliteitsalliantie, i.e.: Het overkoepelende begrip voor zowel papieren als digitale producten, al dan niet in combinatie, ongeacht wie ze ontwikkelt: leraren, niet-commerciële en commerciële aanbieders."@nl;
  rdfs:comment "Elk hulpmiddel dat wordt ingezet om het leerproces te ondersteunen, doelen te bereiken en zo kennis, vaardigheden en attitudes bij te brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een korte tekst die de inhoud of het doel van een Leermiddel verklaart."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-03-21#Leermiddel.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Een korte tekst die de inhoud of het doel van een Leermiddel verklaart."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path <https://data.vlaanderen.be/ns/leermiddelen#beschrijving>
  ], [
    a shacl:PropertyShape;
    rdfs:label "instructie"@nl;
