    shacl:class <https://www.w3.org/TR/owl-time/#time:Duration>;
    shacl:description "De geschatte of typische tijd die het doorgaans kost om met of door de inhoud van dit werk voor het typische of beoogde publiek te werken."@nl;
    shacl:maxCount "1";
