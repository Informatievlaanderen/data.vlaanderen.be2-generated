<https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#TewerkstellingsbreukShape> a shacl:NodeShape;
  rdfs:label "Tewerkstellingsbreuk"@nl;
  rdfs:comment "Het gemiddeld aantal uren per week waarin de werknemer geacht wordt te werken op basis van zijn contract, gedeeld door het gemiddeld aantal uren per week waarin een modelpersoon geacht wordt te werken."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/loongegevens#Tewerkstellingsbreuk> .

