  <http://purl.org/vocab/vann/usageNote> "Een volledige beschrijving van deze klasse is te vinden in het applicatieprofiel OSLO Persoon Basis."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "volledigeNaam"@nl;
    rdfs:comment "De volledige naam vd persoon, doorgaans de combinatie van voornamen en achternaam."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Persoon.Volledigenaam>;
    shacl:datatype xsd:string;
    shacl:description "De volledige naam vd persoon, doorgaans de combinatie van voornamen en achternaam."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "volledigeNaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#volledigeNaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geboortedatum"@nl;
    rdfs:comment "Datum waarop de Geboorte plaatsvond."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Persoon.Geboortedatum>;
    shacl:datatype xsd:date;
    shacl:description "Datum waarop de Geboorte plaatsvond."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geboortedatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#Persoon.geboortedatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "personenFiscaalTenLaste"@nl;
    rdfs:comment "Personen die niet over een inkomen beschikken, of een netto jaarinkomen hebben dat lager is dan wettelijk vastgelegd voor deze regeling, en onder hetzelfde dak wonen als de persoon die voor hen moet voorzien."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Persoon.Personenfiscaaltenlaste>;
    shacl:datatype xsd:integer;
    shacl:description "Personen die niet over een inkomen beschikken, of een netto jaarinkomen hebben dat lager is dan wettelijk vastgelegd voor deze regeling, en onder hetzelfde dak wonen als de persoon die voor hen moet voorzien."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "personenFiscaalTenLaste"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#personenFiscaalTenLaste>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verblijfplaats"@nl;
    rdfs:comment "Plaats waar een persoon verblijft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Persoon.Verblijfplaats>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Verblijfplaats>;
    shacl:description "Plaats waar een persoon verblijft."@nl;
    shacl:name "verblijfplaats"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#Persoon.verblijfplaats>
  ], [
    a shacl:PropertyShape;
    rdfs:label "arbeidsrelatie"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Persoon.Arbeidsrelatie>;
    shacl:class <https://data.vlaanderen.be/ns/loongegevens#Arbeidsrelatie>;
    shacl:name "arbeidsrelatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#arbeidsrelatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "inkomsten"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Persoon.Inkomsten>;
    shacl:class <https://data.vlaanderen.be/ns/loongegevens#Inkomst>;
    shacl:name "inkomsten"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#inkomsten>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isHoofdVan"@nl;
    rdfs:comment "Gezin waarvan de persoon het gezinshoofd is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Persoon.Ishoofdvan>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Gezin>;
    shacl:description "Gezin waarvan de persoon het gezinshoofd is."@nl;
    shacl:maxCount 1;
    shacl:name "isHoofdVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#isHoofdVan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gezinslid"@nl;
    rdfs:comment "Gezin waartoe een persoon behoort."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Persoon.Gezinslid>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Gezin>;
    shacl:description "Gezin waartoe een persoon behoort."@nl;
    shacl:name "gezinslid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#isLidVan>
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#RechtsvormtypeShape> a shacl:NodeShape;
