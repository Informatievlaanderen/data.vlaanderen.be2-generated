<https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Straatnaam vh adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Adresvoorstelling.Straatnaam>;
    shacl:class <https://w3.org/1999/02/22-rdf-syntax-ns#langString>;
    shacl:description "Straatnaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam vh adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Adresvoorstelling.Gemeentenaam>;
    shacl:class <https://w3.org/1999/02/22-rdf-syntax-ns#langString>;
    shacl:description "Gemeentenaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Adresvoorstelling.Land>;
    shacl:class <https://w3.org/1999/02/22-rdf-syntax-ns#langString>;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#ArbeidsloonShape> a shacl:NodeShape;
  rdfs:label "Arbeidsloon"@nl;
  rdfs:comment "Het bedrag dat een persoon ontvangt voor geleverde prestaties in arbeidsverband. Het kan gaan om een financieel bedrag, een bedrag in natura, vergoedingen, etc."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "bedrijfswagen"@nl;
    rdfs:comment "Een voertuig dat door de werkgever aan de werknemer ter beschikking wordt gesteld, als onderdeel van het loonpakket."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Bedrijfswagen>;
    shacl:datatype xsd:boolean;
    shacl:description "Een voertuig dat door de werkgever aan de werknemer ter beschikking wordt gesteld, als onderdeel van het loonpakket."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "bedrijfswagen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#bedrijfswagen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "maaltijdcheques"@nl;
    rdfs:comment "Een maaltijdcheque is een extralegaal voordeel dat een werknemer van zijn/haar werkgever krijgt. Het is een bijdrage van de werkgever voor de kosten van de werknemer voor maaltijden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Maaltijdcheques>;
    shacl:datatype xsd:boolean;
    shacl:description "Een maaltijdcheque is een extralegaal voordeel dat een werknemer van zijn/haar werkgever krijgt. Het is een bijdrage van de werkgever voor de kosten van de werknemer voor maaltijden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "maaltijdcheques"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#maaltijdcheques>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vakantiegeld"@nl;
    rdfs:comment "Dit is een jaarlijkse toelage die een werknemer krijgt om de extra kosten van vakantie te dekken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Vakantiegeld>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Dit is een jaarlijkse toelage die een werknemer krijgt om de extra kosten van vakantie te dekken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "vakantiegeld"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#vakantiegeld>
  ], [
    a shacl:PropertyShape;
    rdfs:label "supplementaireBelastbareBedragen"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gewaarborgd maandloon ziekte, dubbel vakantiegeld, ... Let op dat belastbare maaltijdcheques hier niet in zijn opgenomen. Deze hebben namelijk een apart attribuut in deze klasse."@nl;
    rdfs:comment "Bijkomende sommen die aan het brutoloon toegevoegd worden. Deze zijn vrijgesteld van inhoudingen voor de sociale zekerheid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Supplementairebelastbarebedragen>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Bijkomende sommen die aan het brutoloon toegevoegd worden. Deze zijn vrijgesteld van inhoudingen voor de sociale zekerheid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "supplementaireBelastbareBedragen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#supplementaireBelastbareBedragen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verloningsperiode"@nl;
    rdfs:comment "Een bepaalde tijdsduur met een start- en eindmoment die dient als referentie voor de bepaling van het brutoloon."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Verloningsperiode>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Een bepaalde tijdsduur met een start- en eindmoment die dient als referentie voor de bepaling van het brutoloon."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "verloningsperiode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#verloningsperiode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "brutoloon"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit gaat over de sommen voor gepresteerde arbeid, betaalde afwezigheden, toeslagen, premies, ..."@nl;
    rdfs:comment "De som van alle loonelementen voor sociale en fiscale inhoudingen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Brutoloon>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "De som van alle loonelementen voor sociale en fiscale inhoudingen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "brutoloon"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#brutoloon>
  ], [
    a shacl:PropertyShape;
    rdfs:label "nettoloon"@nl;
    rdfs:comment "Het nettoloon is het brutoloon waar de sociale zekerheidsbijdrage en de bedrijfsvoorheffing van afgetrokken zijn."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Nettoloon>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Het nettoloon is het brutoloon waar de sociale zekerheidsbijdrage en de bedrijfsvoorheffing van afgetrokken zijn."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "nettoloon"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#nettoloon>
  ], [
    a shacl:PropertyShape;
    rdfs:label "inhoudingenVoorDeSocialeZekerheid"@nl;
    rdfs:comment "Dit is een bedrag van het arbeidsloon dat wordt ingehouden om de sociale zekerheid te financieren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Inhoudingenvoordesocialezekerheid>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Dit is een bedrag van het arbeidsloon dat wordt ingehouden om de sociale zekerheid te financieren."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "inhoudingenVoorDeSocialeZekerheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#inhoudingenVoorDeSocialeZekerheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "supplementaireNettoBedragen"@nl;
    <http://purl.org/vocab/vann/usageNote> "Onkostenvergoeding, verplaatsingskosten, ..."@nl;
    rdfs:comment "Bijkomende netto sommen die aan het nettoloon toegevoegd worden. Deze zijn vrijgesteld van belastingen en RSZ."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Supplementairenettobedragen>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Bijkomende netto sommen die aan het nettoloon toegevoegd worden. Deze zijn vrijgesteld van belastingen en RSZ."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "supplementaireNettoBedragen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#supplementaireNettoBedragen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bedrijfsvoorheffing"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het bedrag van de bedrijfsvoorheffing wordt bepaald door loonhoogte, burgerlijke staat, gezinssituatie, … De bedrijfsvoorheffing wordt ingehouden op het totaal belastbare loon."@nl;
    rdfs:comment "Voorschot op de definitieve inkomstenbelasting."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Bedrijfsvoorheffing>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Voorschot op de definitieve inkomstenbelasting."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "bedrijfsvoorheffing"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#bedrijfsvoorheffing>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afTeTrekkenNettoBedragen"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit gaat over de sommen voor loonbeslag, loonoverdracht, persoonlijke bijdrage maaltijdcheques, ..."@nl;
    rdfs:comment "Verplichte inhoudingen door de werkgever."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Aftetrekkennettobedragen>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Verplichte inhoudingen door de werkgever."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "afTeTrekkenNettoBedragen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#afTeTrekkenNettoBedragen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "periodiciteitVerloning"@nl;
    rdfs:comment "Heeft betrekking op het verschil tussen een éénmalige verloning en een periodieke verloning."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Periodiciteitverloning>;
    shacl:class skos:Concept;
    shacl:description "Heeft betrekking op het verschil tussen een éénmalige verloning en een periodieke verloning."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "periodiciteitVerloning"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#periodiciteitVerloning>
  ], [
    a shacl:PropertyShape;
    rdfs:label "collectieveSchuldenregeling"@nl;
    rdfs:comment "Bij collectieve schuldenregeling wordt een afbetalingsplan opgestelt voor het betalen van schulden aan de schuldeisers. Het loon van een persoon wordt gestort en volgens de opgestelde regeling verdeelt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Collectieveschuldenregeling>;
    shacl:class skos:Concept;
    shacl:description "Bij collectieve schuldenregeling wordt een afbetalingsplan opgestelt voor het betalen van schulden aan de schuldeisers. Het loon van een persoon wordt gestort en volgens de opgestelde regeling verdeelt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "collectieveSchuldenregeling"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#collectieveSchuldenregeling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "nettoGestortLoon"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het netto gestort loon kan verschillen van het nettoloon. Dit kan voorkomen bij een herberekening van een voorgaande maand, een onkostennota, ..."@nl;
    rdfs:comment "Het werkelijk gestorte loon op de rekening van de persoon."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Nettogestortloon>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Het werkelijk gestorte loon op de rekening van de persoon."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "nettoGestortLoon"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#nettoGestortLoon>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eindejaarstoelage"@nl;
    rdfs:comment "Een eindejaarstoelage is een financiële bonus die een persoon krijgt van zijn/haar werkgever op het einde van het jaar. Er moeten sociale zekerheidsbijdragen en belastingen op betaald worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Eindejaarstoelage>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Een eindejaarstoelage is een financiële bonus die een persoon krijgt van zijn/haar werkgever op het einde van het jaar. Er moeten sociale zekerheidsbijdragen en belastingen op betaald worden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "eindejaarstoelage"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#eindejaarstoelage>
  ], [
    a shacl:PropertyShape;
    rdfs:label "premie"@nl;
    rdfs:comment "Dit is een deel van het loon dat afhankelijk is van geleverde prestaties."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Premie>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Dit is een deel van het loon dat afhankelijk is van geleverde prestaties."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "premie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/loongegevens#premie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "belastbareMaaltijdcheques"@nl;
    rdfs:comment "Een belastbare maaltijdcheque is een maaltijdchecque met een bedrag boven het wettelijk plafond voor belastingvrije maaltijdcheques. Ze worden apart vermeld op de loonbrief."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/loongegevens/ontwerpstandaard/toolchain4#Arbeidsloon.Belastbaremaaltijdcheques>;
    shacl:class schemas:MonetaryAmount;
