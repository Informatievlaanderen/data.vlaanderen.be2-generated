<https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#KandidatenlijstShape> a shacl:NodeShape;
  rdfs:label "Kandidatenlijst"@nl;
  rdfs:comment "Lijst met kandidaten voor een verkiezing."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lijstnaam"@nl;
    rdfs:comment "De naam van de lijst onder dewelke de kandidaten gezamenlijk opkomen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Kandidatenlijst.Lijstnaam>;
    shacl:datatype xsd:string;
    shacl:description "De naam van de lijst onder dewelke de kandidaten gezamenlijk opkomen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lijstnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "lijstnummer"@nl;
    rdfs:comment "Het volgnummer van de lijst."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Kandidatenlijst.Lijstnummer>;
    shacl:datatype xsd:integer;
    shacl:description "Het volgnummer van de lijst."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lijstnummer"@nl;
    shacl:path <http://data.vlaanderen.be/ns/mandaat#lijstnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "lijsttype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: gemeenteraadsverkiezing, effectieven Vlaams Parlement."@nl;
    rdfs:comment "Het type van de lijst."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Kandidatenlijst.Lijsttype>;
    shacl:class skos:Concept;
    shacl:description "Het type van de lijst."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lijsttype"@nl;
    shacl:path <http://data.vlaanderen.be/ns/mandaat#lijsttype>
  ], [
    a shacl:PropertyShape;
    rdfs:label "behoort tot"@nl;
    rdfs:comment "De verkiezing waar de lijst onderdeel van is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Kandidatenlijst.BehoortTot>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#RechtstreekseVerkiezing>;
    shacl:description "De verkiezing waar de lijst onderdeel van is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "behoort tot"@nl;
    shacl:path <http://data.vlaanderen.be/ns/mandaat#behoortTot>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft kandidaat"@nl;
    rdfs:comment "Een persoon die deel uitmaakt van de lijst."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Kandidatenlijst.HeeftKandidaat>;
    shacl:class <http://www.w3.org/ns/person#Person>;
    shacl:description "Een persoon die deel uitmaakt van de lijst."@nl;
    shacl:minCount 1;
    shacl:name "heeft kandidaat"@nl;
    shacl:path <http://data.vlaanderen.be/ns/mandaat#heeftKandidaat>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/mandaat#Kandidatenlijst> .

<https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#LidmaatschapShape> a shacl:NodeShape;
  rdfs:label "Lidmaatschap"@nl;
  rdfs:comment "Geeft de kenmerken weer vh lidmaatschap van een Mandataris van een Fractie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lid gedurende"@nl;
    rdfs:comment "Periode waarin de Mandataris lid was vd Fractie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Lidmaatschap.LidGedurende>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Periode waarin de Mandataris lid was vd Fractie."@nl;
    shacl:maxCount "1";
    shacl:name "lid gedurende"@nl;
    shacl:path org:memberDuring
  ], [
    a shacl:PropertyShape;
    rdfs:label "lid"@nl;
    rdfs:comment "De mandataris van wie het lidmaatschap beschreven wordt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Lidmaatschap.Lid>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandataris>;
    shacl:description "De mandataris van wie het lidmaatschap beschreven wordt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "lid"@nl;
    shacl:path org:member
  ], [
    a shacl:PropertyShape;
    rdfs:label "is lidmaatschap bij"@nl;
    rdfs:comment "De fractie waarvan de mandataris lid is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Lidmaatschap.IsLidmaatschapBij>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Fractie>;
    shacl:description "De fractie waarvan de mandataris lid is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is lidmaatschap bij"@nl;
    shacl:path org:organization
  ];
  shacl:targetClass org:Membership .

<https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#MandaatShape> a shacl:NodeShape;
  rdfs:label "Mandaat"@nl;
  rdfs:comment "De bevoegdheid om gedurende een bepaalde periode een bestuursorgaan te vormen of er deel van uit te maken. Een mandaat kan één of meerdere zetels voorstellen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aantal houders"@nl;
    rdfs:comment "Maximale aantal mandatarissen dat tegelijk dit mandaat kan opnemen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Mandaat.AantalHouders>;
    shacl:datatype xsd:integer;
    shacl:description "Maximale aantal mandatarissen dat tegelijk dit mandaat kan opnemen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aantal houders"@nl;
    shacl:path <http://data.vlaanderen.be/ns/mandaat#aantalHouders>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bestuursfunctie"@nl;
    rdfs:comment "Een code die de functie van het mandaat aangeeft."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Mandaat.Bestuursfunctie>;
    shacl:class org:Role;
    shacl:description "Een code die de functie van het mandaat aangeeft."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "bestuursfunctie"@nl;
    shacl:path org:role
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/mandaat#Mandaat> .

<https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#MandatarisShape> a shacl:NodeShape;
  rdfs:label "Mandataris"@nl;
  rdfs:comment "Een persoon in zijn rol als houder van een mandaat."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "einde"@nl;
    rdfs:comment "Tijdstip vanaf wanneer de mandataris het mandaat niet langer opneemt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Mandataris.Einde>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip vanaf wanneer de mandataris het mandaat niet langer opneemt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "einde"@nl;
