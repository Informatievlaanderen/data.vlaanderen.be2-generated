<https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke Organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "achternaam"@nl;
    rdfs:comment "De familienaam van de persoon."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Persoon.Achternaam>;
    shacl:datatype xsd:string;
    shacl:description "De familienaam van de persoon."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "achternaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Indien aanwezig is het aan te raden deze naam te gebruiken voor visualisaties in plaats van voornaam en familienaam."@nl;
    rdfs:comment "Een roepnaam van de persoon."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Persoon.AlternatieveNaam>;
    shacl:datatype xsd:string;
    shacl:description "Een roepnaam van de persoon."@nl;
    shacl:maxCount "1";
    shacl:name "alternatieve naam"@nl;
    shacl:path foaf:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruikte voornaam"@nl;
    rdfs:comment "De te gebruiken voornaam van alle officiële voornamen van de persoon."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Persoon.GebruikteVoornaam>;
