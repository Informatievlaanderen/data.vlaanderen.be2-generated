<https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#BestuurseenheidShape> a shacl:NodeShape;
  rdfs:label "Bestuurseenheid"@nl;
  rdfs:comment "Publieke,bestuurlijke organisatie verbonden aan een territoriaal omschreven gebied met bepaalde verantwoordelijkheden waarbinnen het bestuurshandelingen kan stellen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van de bestuurseenheid."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Bestuurseenheid.Naam>;
    shacl:description "Naam van de bestuurseenheid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "classificatie"@nl;
    rdfs:comment "Classificatie van de bestuurseenheid."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Bestuurseenheid.Classificatie>;
    shacl:class skos:Concept;
    shacl:description "Classificatie van de bestuurseenheid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "classificatie"@nl;
    shacl:path org:classification
  ], [
    a shacl:PropertyShape;
    rdfs:label "werkingsgebied"@nl;
    rdfs:comment "Geografische gebied waarbinnen de bestuurseenheid bepaalde verantwoordelijkheden heeft waarbinnen het bestuurshandelingen kan stellen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Bestuurseenheid.Werkingsgebied>;
    shacl:class prov:Location;
    shacl:description "Geografische gebied waarbinnen de bestuurseenheid bepaalde verantwoordelijkheden heeft waarbinnen het bestuurshandelingen kan stellen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "werkingsgebied"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#werkingsgebied>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#Bestuurseenheid> .

<https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Bestuursorgaan(inBestuursperiode)Shape> a shacl:NodeShape;
  rdfs:label "Bestuursorgaan (in bestuursperiode)"@nl;
  rdfs:comment "Een bestuursorgaan,beperkt tot een bepaalde bestuursperiode."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "bevat"@nl;
    rdfs:comment "Een mandaat binnen het orgaan."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Bestuursorgaan(inBestuursperiode).Bevat>;
    shacl:class <http://data.vlaanderen.be/ns/mandaat#Mandaat>;
    shacl:description "Een mandaat binnen het orgaan."@nl;
    shacl:minCount 1;
    shacl:name "bevat"@nl;
    shacl:path org:hasPost
  ], [
    a shacl:PropertyShape;
    rdfs:label "is tijdspecialisatie van"@nl;
    rdfs:comment "Duidt de bronentiteit aan waarvan deze entiteit een tijdsgebonden specialisatie is. De specialisatie stelt de bron voor gedurende een bepaalde periode."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Bestuursorgaan(inBestuursperiode).IsTijdspecialisatieVan>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Bestuursorgaan>;
    shacl:description "Duidt de bronentiteit aan waarvan deze entiteit een tijdsgebonden specialisatie is. De specialisatie stelt de bron voor gedurende een bepaalde periode."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is tijdspecialisatie van"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#isTijdspecialisatieVan>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#Bestuursorgaan> .

<https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#BestuursorgaanShape> a shacl:NodeShape;
  rdfs:label "Bestuursorgaan"@nl;
  rdfs:comment "Een formeel orgaan van een rechtspersoon dat bevoegd is om rechtshandelingen te stellen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van de eenheid."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Bestuursorgaan.Naam>;
    shacl:description "Naam van de eenheid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "classificatie"@nl;
    rdfs:comment "Het type bestuursorgaan."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Bestuursorgaan.Classificatie>;
    shacl:class skos:Concept;
    shacl:description "Het type bestuursorgaan."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "classificatie"@nl;
    shacl:path org:classification
  ], [
    a shacl:PropertyShape;
    rdfs:label "bestuurt"@nl;
    rdfs:comment "De bestuurseenheid die door het orgaan bestuurd wordt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Bestuursorgaan.Bestuurt>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Bestuurseenheid>;
    shacl:description "De bestuurseenheid die door het orgaan bestuurd wordt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "bestuurt"@nl;
    shacl:path <http://data.vlaanderen.be/ns/besluit#bestuurt>
  ];
  shacl:targetClass <http://data.vlaanderen.be/ns/besluit#Bestuursorgaan> .

<https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#CreatieShape> a shacl:NodeShape;
  rdfs:label "Creatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "De entiteit bestond niet voorafgaand aan de creatie en is daarna beschikbaar voor gebruik."@nl;
  rdfs:comment "Het voltooien vd productie ve nieuwe entiteit dmv een activiteit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "tijdstip"@nl;
    rdfs:comment "De start van de periode waarover de versie gedefinieerd is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#Creatie.Tijdstip>;
    shacl:datatype xsd:dateTime;
    shacl:description "De start van de periode waarover de versie gedefinieerd is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "tijdstip"@nl;
    shacl:path prov:atTime
  ];
  shacl:targetClass prov:Generation .

<https://data.vlaanderen.be/doc/applicatieprofiel/mandatendatabank/erkendestandaard/2025-12-11#DateShape> a shacl:NodeShape;
