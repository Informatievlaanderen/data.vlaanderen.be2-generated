<https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#AgentShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#Agent.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de agent."@nl;
    shacl:maxCount "n";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path foaf:name
  ];
  shacl:targetClass dc:Agent .

<https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#CatalogusRecordShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#CatalogusRecord.Identificator>;
    shacl:datatype rdfs:Literal;
    shacl:description "De unieke identificator van het record in de catalogus."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:path dc:identifier
  ], [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#CatalogusRecord.Aanmaakdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum van (formele) opname van de bijbehorende dataset of dataservice in de catalogus."@nl;
    shacl:maxCount "1";
    shacl:name "aanmaakdatum"@nl;
    shacl:path dc:issued
  ], [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#CatalogusRecord.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van het record in de catalogus."@nl;
    shacl:maxCount "n";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#CatalogusRecord.Wijzigingsdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De meest recente datum waarop de record in de catalogus is gewijzigd, bijgewerkt of aangepast."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "wijzigingsdatum"@nl;
    shacl:path dc:modified
  ], [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#CatalogusRecord.BronMetadataRecordLandingspagina>;
    shacl:class rdfs:Resource;
    shacl:description "Een webpagina in een menselijk leesbare vorm van de bron metadata record."@nl;
    shacl:maxCount "1";
    shacl:name "bron metadata record landingspagina"@nl;
    shacl:path <https://data.vlaanderen.be/ns/metadata-dcat#bronMetadataRecordLandingspagina>
  ], [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#CatalogusRecord.AlternatieveIdentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een alternatieve identificator (dan de unieke identificator) voor een record in de catalogus kan hier beschreven worden."@nl;
    shacl:maxCount "n";
    shacl:name "alternatieve identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#CatalogusRecord.Conform>;
    shacl:class dc:Standard;
    shacl:description """De (metadata) standaard volgens welke
regels het hoofdonderwerp waarnaar de
Catalogus Record verwijst, beschreven
wordt."""@nl;
    shacl:maxCount "n";
    shacl:name "conform"@nl;
    shacl:path dc:conformsTo
  ], [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#CatalogusRecord.BronMetadatarecord>;
    shacl:class rdfs:Resource;
    shacl:description "De record in een andere catalogus waarvan deze record en de beschrijvingen van het bijhorende hoofdonderwerp van afgeleid zijn."@nl;
    shacl:maxCount "1";
    shacl:name "bron metadatarecord"@nl;
    shacl:path dc:source
  ], [
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/metadata-dcat/ontwerpstandaard/2025-09-16#CatalogusRecord.Hoofdonderwerp>;
    shacl:class dcat:Resource;
    shacl:description "De resource (dataset of dataservice) beschreven in het record."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hoofdonderwerp"@nl;
    shacl:path foaf:primaryTopic
  ];
  shacl:targetClass dcat:CatalogRecord .

