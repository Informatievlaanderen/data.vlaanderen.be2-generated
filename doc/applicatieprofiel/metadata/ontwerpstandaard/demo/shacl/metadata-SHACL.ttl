@prefix org: <http://www.w3.org/ns/org#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#> rdfs:member <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#UitkomstShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#NeerleggingShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#OrganisatieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#IntShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#StringShape> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#IntShape> a shacl:NodeShape;
  rdfs:label "int";
  shacl:closed false;
  shacl:targetClass xsd:int .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#NeerleggingShape> a shacl:NodeShape;
  rdfs:label "Neerlegging"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het gaat typisch om een wettelijke verplichting,bvb de Neerlegging van een Jaarrekening bij de Nationale Bank van België,bedoeld om inzicht te geven in de financiële positie van de Organisatie waarmee men omgaat."@nl;
  rdfs:comment "Activiteit waarbij een FinancieelRapport officieel wordt ingediend."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    rdfs:comment "De datum waarop het rapport werd neergelegd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#Neerlegging.Datum>;
    shacl:class <http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Instant>;
    shacl:description "De datum waarop het rapport werd neergelegd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum"@nl;
    shacl:path <http://todo.com/Neerlegging.datum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "neergelegdBij"@nl;
    rdfs:comment "De Organisatie waarbij het rapport werd neergelegd"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#Neerlegging.Neergelegdbij>;
    shacl:class org:Organization;
    shacl:description "De Organisatie waarbij het rapport werd neergelegd"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "neergelegdBij"@nl;
    shacl:path <http://todo.com/Neerlegging.neergelegdBij>
  ];
  shacl:targetClass <http://todo.com/Neerlegging> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#Organisatie.Voorkeursnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ];
  shacl:targetClass org:Organization .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#UitkomstShape> a shacl:NodeShape;
  rdfs:label "Uitkomst"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Temp"@nl;
    rdfs:comment "Dit is de definitie van dit label"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#Uitkomst.Temp>;
    shacl:datatype xsd:int;
    shacl:description "Dit is de definitie van dit label"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "Temp"@nl;
    shacl:path <http://todo.com/temp>
  ];
  shacl:targetClass <http://todo.com/Uitkomst> .
