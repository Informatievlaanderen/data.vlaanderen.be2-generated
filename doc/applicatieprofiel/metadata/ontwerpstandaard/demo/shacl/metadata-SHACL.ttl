@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#> rdfs:member <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#UitkomstShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#IntShape> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#IntShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:targetClass xsd:int .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#UitkomstShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/metadata/ontwerpstandaard/demo#Uitkomst.Temp>;
    shacl:datatype xsd:int;
    shacl:description "Dit is de definitie van dit label"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "Temp"@nl;
    shacl:path <http://todo.com/temp>
  ];
  shacl:targetClass <http://todo.com/Uitkomst> .
