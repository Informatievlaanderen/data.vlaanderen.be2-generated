<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#AanvraagShape> a shacl:NodeShape;
  rdfs:label "Aanvraag"@nl;
  rdfs:comment "Aanspraak op de uitoefening van een bevoegdheid; formeel verzoek van een rechtssubject aan een bevoegde instantie om informatie te verstrekken of een beslissing te nemen, in het bijzonder een beslissing om ergens toelating voor te verlenen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanvrager"@nl;
    rdfs:comment "Rechtssubject die de Aanvraag heeft ingediend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Aanvraag.Aanvrager>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Rechtssubject>;
    shacl:description "Rechtssubject die de Aanvraag heeft ingediend."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aanvrager"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#verantwoordelijke>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ingangsdatum"@nl;
    rdfs:comment "Datum vanaf dewelke de Aanvraag rechtskracht krijgt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Aanvraag.Ingangsdatum>;
    shacl:class <http://todo.com/Date>;
    shacl:description "Datum vanaf dewelke de Aanvraag rechtskracht krijgt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "ingangsdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#ingangsdatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De Identificator van de Aanvraag."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Aanvraag.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "De Identificator van de Aanvraag."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vergunningshouder"@nl;
    rdfs:comment "Rechtssubject die de vergunning krijgt via de aanvraag."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Aanvraag.Vergunningshouder>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Rechtssubject>;
    shacl:description "Rechtssubject die de vergunning krijgt via de aanvraag."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "vergunningshouder"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit-intelligente-toegang#Aanvraag.vergunningshouder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Classificering van de Aanvraag aan de hand van een gecontroleerde codelijst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Aanvraag.Type>;
    shacl:description "Classificering van de Aanvraag aan de hand van een gecontroleerde codelijst."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "inhoud"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de toegang om een autoluwe zone binnen te rijden."@nl;
    rdfs:comment "Inhoud van de Aanvraag."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Aanvraag.Inhoud>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit-intelligente-toegang#Toegang>;
    shacl:description "Inhoud van de Aanvraag."@nl;
    shacl:maxCount 1;
    shacl:name "inhoud"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#inhoud>
  ], [
    a shacl:PropertyShape;
    rdfs:label "zaak"@nl;
    rdfs:comment "De zaak waarin de Aanvraag wordt gesteld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Aanvraag.Zaak>;
    shacl:class dbo:Case;
    shacl:description "De zaak waarin de Aanvraag wordt gesteld."@nl;
    shacl:maxCount 1;
    shacl:name "zaak"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#zaak>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Aanvraag> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#ActiviteitShape> a shacl:NodeShape;
  rdfs:label "Activiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Maakt het voorwerp uit van vergunningsaanvragen, meldingen, vergunningsbesluiten, vaststellingen."@nl;
  rdfs:comment "Geheel van handelingen die een of meerdere Rechtssubjecten binnen een welbepaald tijdsbestek en op een welbepaalde locatie ten uitvoer (willen) (laten) brengen en die gezien hun aard te kwalificeren zijn en dus geregeld zijn onder één of meer welbepaalde Juridische Categorieën."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Classificering van de Activiteit aan de hand van een gecontroleerde codelijst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Activiteit.Type>;
    shacl:description "Classificering van de Activiteit aan de hand van een gecontroleerde codelijst."@nl;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "periode"@nl;
    rdfs:comment "Periode van de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Activiteit.Periode>;
    shacl:class <http://www.w3.org/2006/time#ProperInterval>;
    shacl:description "Periode van de Activiteit."@nl;
    shacl:maxCount 1;
    shacl:name "periode"@nl;
    shacl:path dc:extent
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:comment "Aanduiding van de plaats waar een Activiteit plaatsvindt, plaats zal vinden, of plaatsvond."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Activiteit.Locatie>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit#Zone>;
    shacl:description "Aanduiding van de plaats waar een Activiteit plaatsvindt, plaats zal vinden, of plaatsvond."@nl;
    shacl:maxCount 1;
    shacl:name "locatie"@nl;
    shacl:path <http://www.w3.org/ns/locn#location>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Activiteit> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#BewijsShape> a shacl:NodeShape;
  rdfs:label "Bewijs"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het kader van publieke dienstverlening gaat het meestal om administratieve documenten of ingevulde aanvraagformulieren. Zonder het nodige Bewijs kan de dienstverlening niet worden afgeleverd. Soms levert de Output van een Publieke Dienstverlening het Bewijs nodig voor een andere Publieke Dienstverlening."@nl;
  rdfs:comment "Elk stuk waarmee kan worden aangetoond dat men aan een Voorwaarde voldoet."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Bewijs.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Beschrijving van het Bewijs."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Officiële naam van het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Bewijs.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Officiële naam van het Bewijs."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Identificator van het object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Bewijs.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het object."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het gebruik van een codelijst wordt aanbevolen. Illustratief wordt verwezen naar een eenvoudige codelijst."@nl;
    rdfs:comment "Aard van het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Bewijs.Type>;
    shacl:description "Aard van het Bewijs."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "vervult"@nl;
    rdfs:comment "Voorwaarde waaraan voldaan is door middel van het Bewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#Bewijs.Vervult>;
    shacl:description "Voorwaarde waaraan voldaan is door middel van het Bewijs."@nl;
    shacl:name "vervult"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/m8g/Requirement>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit-intelligente-toegang#Voorwaardecollectie>]);
    shacl:path <http://data.europa.eu/m8g/supportsRequirement>
  ];
  shacl:targetClass <http://data.europa.eu/m8g/Evidence> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#BewijstypeShape> a shacl:NodeShape;
  rdfs:label "Bewijstype"@nl;
