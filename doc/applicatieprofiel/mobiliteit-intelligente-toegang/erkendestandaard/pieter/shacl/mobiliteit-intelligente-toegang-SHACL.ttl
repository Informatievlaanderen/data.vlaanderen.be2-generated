<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#PubliekeDienstverleningShape> a shacl:NodeShape;
  rdfs:label "PubliekeDienstverlening"@nl;
  rdfs:comment "Een publieke dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen hiervan."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "heeftCompetenteAutoriteit"@nl;
    rdfs:comment "Verbindt de Publieke Dienstverlening met een Publieke Organisatie, die verantwoordelijk is voor de levering van de dienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#PubliekeDienstverlening.HeeftCompetenteAutoriteit>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "Verbindt de Publieke Dienstverlening met een Publieke Organisatie, die verantwoordelijk is voor de levering van de dienst."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeftCompetenteAutoriteit"@nl;
    shacl:path <http://data.europa.eu/m8g/hasCompetentAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "Geeft aan of de Publieke Dienstverlening bijvoorbeeld actief, inactief, of in ontwikkeling is, op basis van een codelijst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#PubliekeDienstverlening.Status>;
    shacl:description "Geeft aan of de Publieke Dienstverlening bijvoorbeeld actief, inactief, of in ontwikkeling is, op basis van een codelijst."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "status"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <http://www.w3.org/ns/adms#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftOutputtype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit kunnen meerdere types zijn omdat een Publieke Dienstverlening verschillende soorten Output kan produceren. Deze types kunnen vergeleken worden met de Bewijstypes van een Voorwaarde. Op die manier kan bepaald worden welke Publieke Dienstverlening Bewijzen levert die gebruikt kunnen worden door een andere Publieke Dienstverlening."@nl;
    rdfs:comment "De types die de Output van de Publieke Dienstverlening heeft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#PubliekeDienstverlening.HeeftOutputtype>;
    shacl:description "De types die de Output van de Publieke Dienstverlening heeft."@nl;
    shacl:name "heeftOutputtype"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit-intelligente-toegang#heeftOutputtype>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volgt"@nl;
    rdfs:comment "Procedure die de Publieke Dienstverlening volgt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#PubliekeDienstverlening.Volgt>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Procedure>;
    shacl:description "Procedure die de Publieke Dienstverlening volgt."@nl;
    shacl:name "volgt"@nl;
    shacl:path <http://purl.org/vocab/cpsv#follows>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftVoorwaarde"@nl;
    rdfs:comment "Voorwaarden aan voldaan moet worden om gebruik te maken van de Publieke Dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#PubliekeDienstverlening.HeeftVoorwaarde>;
    shacl:description "Voorwaarden aan voldaan moet worden om gebruik te maken van de Publieke Dienstverlening."@nl;
    shacl:name "heeftVoorwaarde"@nl;
    shacl:or ([shacl:class <http://data.europa.eu/m8g/Requirement>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit-intelligente-toegang#Voorwaardecollectie>]);
    shacl:path <http://vocab.belgif.be/ns/publicservice#hasRequirement>
  ], [
    a shacl:PropertyShape;
    rdfs:label "produceert"@nl;
    rdfs:comment "Recht op toegang dat verkregen wordt als resultaat van de uitvoering van de Publieke Dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#PubliekeDienstverlening.Produceert>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit-intelligente-toegang#Toegang>;
    shacl:description "Recht op toegang dat verkregen wordt als resultaat van de uitvoering van de Publieke Dienstverlening."@nl;
    shacl:name "produceert"@nl;
    shacl:path <http://purl.org/vocab/cpsv#produces>
  ], [
    a shacl:PropertyShape;
    rdfs:label "produceert"@nl;
    rdfs:comment "Vergunning dat verkregen wordt als resultaat van de uitvoering van de Publieke Dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-intelligente-toegang/erkendestandaard/pieter#PubliekeDienstverlening.Produceert>;
    shacl:class <http://data.vlaanderen.be/ns/besluit#Vergunning>;
    shacl:description "Vergunning dat verkregen wordt als resultaat van de uitvoering van de Publieke Dienstverlening."@nl;
    shacl:name "produceert"@nl;
    shacl:path <http://purl.org/vocab/cpsv#produces>
  ];
  shacl:targetClass <http://purl.org/vocab/cpsv#PublicService> .

