{
  "title": "Aanvraag",
  "type": "object",
  "description": "Aanspraak op de uitoefening van een bevoegdheid; formeel verzoek van een rechtssubject aan een bevoegde instantie om informatie te verstrekken of een beslissing te nemen, in het bijzonder een beslissing om ergens toelating voor te verlenen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Aanvraag)",
      "pattern": "^Aanvraag$"
    },
    "aanvrager": {
      "$ref": "#/components/schemas/Rechtssubject"
    },
    "ingangsdatum": {
      "$ref": "#/components/schemas/Date"
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    },
    "vergunningshouder": {
      "$ref": "#/components/schemas/Rechtssubject"
    },
    "type": {
      "$ref": "#/components/schemas/Aanvraagtype"
    },
    "inhoud": {
      "$ref": "#/components/schemas/Toegang"
    },
    "zaak": {
      "$ref": "#/components/schemas/Zaak"
    }
  },
  "required": [
    "@type",
    "aanvrager",
    "ingangsdatum",
    "identificator",
    "vergunningshouder",
    "type"
  ]
}