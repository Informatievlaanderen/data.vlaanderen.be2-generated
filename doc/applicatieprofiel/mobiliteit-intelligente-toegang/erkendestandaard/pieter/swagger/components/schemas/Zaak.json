    },
    "procedure": {
      "$ref": "#/components/schemas/Procedure"
    },
    "dossier": {
      "$ref": "#/components/schemas/Dossier"
    },
    "isDeelVan": {
      "type": "array",
      "description": "Lijst van Project items.",
      "items": {
        "$ref": "#/components/schemas/Project"
      },
      "minItems": 1
    },
    "zaakhandeling": {
      "$ref": "#/components/schemas/Vergunning"
    }
  },
  "required": [
    "@type"
  ]
}