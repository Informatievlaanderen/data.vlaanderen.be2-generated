<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#VervoersbewijsShape> a shacl:NodeShape;
  rdfs:label "Vervoersbewijs"@nl;
  <http://purl.org/vocab/vann/usageNote> "Vervoer of dienst zijn nog te consumeren of al geconsumeerd. Typisch een ticket voor of een abonnement op een Mobiliteitsdienst zoals openbaar vervoer, maar kan ook bv een parkeerticket zijn."@nl;
  rdfs:comment "Bewijs van bepaald recht op vervoer of diensten daarmee geassocieerd."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aantal"@nl;
    rdfs:comment "Aantal reizen dat men met het Vervoersbewijs kan afleggen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Vervoersbewijs.Aantal>;
    shacl:datatype xsd:integer;
    shacl:description "Aantal reizen dat men met het Vervoersbewijs kan afleggen."@nl;
    shacl:maxCount "1";
    shacl:name "aantal"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#aantal>
  ], [
    a shacl:PropertyShape;
    rdfs:label "duur"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv 1 uur in het geval van een metroticket of 1 dag voor een dagticket of een krediet van 120 minuten deelstep."@nl;
    rdfs:comment "Totale tijd waarvan men met het Vervoersbewijs van een Mobiliteitsdienst gebruik mag maken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Vervoersbewijs.Duur>;
    shacl:datatype xsd:duration;
    shacl:description "Totale tijd waarvan men met het Vervoersbewijs van een Mobiliteitsdienst gebruik mag maken."@nl;
    shacl:maxCount "1";
    shacl:name "duur"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#duur>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bedrag"@nl;
    rdfs:comment "Geldbedrag dat aan de Mobiliteitsdienst kan worden besteed."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Vervoersbewijs.Bedrag>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Geldbedrag dat aan de Mobiliteitsdienst kan worden besteed."@nl;
    shacl:maxCount "1";
    shacl:name "bedrag"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#bedrag>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Beperkt tot types die op een kwalitatieve manier aangeven in welke mate de Mobiliteitsdienst gebruikt mag worden met het gegeven Vervoersbewijs. Bv dagticket geeft aan dat de Mobiliteitsdienst ongelimiteerd gebruikt mag worden gedurende 1 dag..."@nl;
    rdfs:comment "Aard van het Vervoersbewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Vervoersbewijs.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van het Vervoersbewijs."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "prijs"@nl;
    rdfs:comment "Prijs die voor het Vervoersbewijs is betaald."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Vervoersbewijs.Prijs>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Prijs die voor het Vervoersbewijs is betaald."@nl;
    shacl:maxCount "1";
    shacl:name "prijs"@nl;
    shacl:path schemas:price
  ], [
    a shacl:PropertyShape;
    rdfs:label "periode"@nl;
    rdfs:comment "Periode waarvoor het Vervoersbewijs geldt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Vervoersbewijs.Periode>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Periode waarvoor het Vervoersbewijs geldt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "periode"@nl;
    shacl:path dc:date
  ], [
    a shacl:PropertyShape;
    rdfs:label "reisweg"@nl;
    <http://purl.org/vocab/vann/usageNote> "Typisch de twee opeenvolgende Locaties waartussen men mag reizen met het Vervoersbewijs, bv een treinabonnement tussen Brussel en Gent (waarbij het type Vervoersbewijs dan doorgaans \"retourticket\" is, maw ook een Reis van Gent naar Brussel is mogelijk). Maar kan ook gewoon het Gebied of de Plaats zijn waarvoor het Vervoersbewijs geldt, bv Antwerpen."@nl;
    rdfs:comment "Opeenvolging van Locaties waarvoor het Vervoersbewijs geldig is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Vervoersbewijs.Reisweg>;
    shacl:class prov:Location;
    shacl:description "Opeenvolging van Locaties waarvoor het Vervoersbewijs geldig is."@nl;
    shacl:minCount "1";
    shacl:name "reisweg"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Vervoersbewijs.reisweg>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afstand"@nl;
    rdfs:comment "Gecumuleerde afstand die men met het Vervoersbewijs mag afleggen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Vervoersbewijs.Afstand>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Gecumuleerde afstand die men met het Vervoersbewijs mag afleggen."@nl;
    shacl:maxCount "1";
    shacl:name "afstand"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Vervoersbewijs.afstand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "dienst"@nl;
    rdfs:comment "Mobiliteitsdienst waarvan men met het Vervoersbewijs gebruik mag maken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Vervoersbewijs.Dienst>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Mobiliteitsdienst>;
    shacl:description "Mobiliteitsdienst waarvan men met het Vervoersbewijs gebruik mag maken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "dienst"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Vervoersbewijs.dienst>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Vervoersbewijs> .

