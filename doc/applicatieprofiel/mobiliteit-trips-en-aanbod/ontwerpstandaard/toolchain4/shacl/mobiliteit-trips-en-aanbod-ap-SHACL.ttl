  <http://purl.org/vocab/vann/usageNote> "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet direct gewerkt worden met Geometrie, GeografischeNaam, Adres etc."@nl;
  rdfs:comment "Aanduiding van een geografische positie,dmv coordinaten,een toponiem,een adreslabel,een verwijzing naar een plaats/regio of verwijzing naar een adres."@nl;
  shacl:closed false;
  shacl:targetClass prov:Location .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#MobiliteitsdienstShape> a shacl:NodeShape;
  rdfs:label "Mobiliteitsdienst"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hieronder verstaan we zowel klassieke mobiliteitsdiensten zoals openbaar vervoer (typisch aangeboden als lijndienst, bv metrolijn 5 in Brussel), maar ook deelvervoer zoals free floating deelsteps (bv deelsteps in grote steden)."@nl;
  rdfs:comment "Dienstverlening die verplaatsingen van Personen tussen Locaties mogelijk maakt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van de Mobiliteitsdienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Mobiliteitsdienst.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van de Mobiliteitsdienst."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv openbaar vervoer, parking etc. Combinaties zijn mogelijk, bv collectief vervoer & openbaar vervoer (bv NMBS), individueel vervoer & privé vervoer (taxi's)..."@nl;
    rdfs:comment "Aard van de mobiliteitsdienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Mobiliteitsdienst.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de mobiliteitsdienst."@nl;
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "ruimtelijke dekking"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv Brussels Gewest, Antwerpen..."@nl;
    rdfs:comment "Gebied of Plaats waarbinnen de Mobiliteitsdienst wordt aangeboden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Mobiliteitsdienst.RuimtelijkeDekking>;
    shacl:class dc:Location;
    shacl:description "Gebied of Plaats waarbinnen de Mobiliteitsdienst wordt aangeboden."@nl;
    shacl:name "ruimtelijke dekking"@nl;
    shacl:path dc:spatial
  ], [
