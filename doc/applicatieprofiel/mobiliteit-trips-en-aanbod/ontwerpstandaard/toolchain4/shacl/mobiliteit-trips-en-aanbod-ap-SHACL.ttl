<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#AanbiederShape> a shacl:NodeShape;
  rdfs:label "Aanbieder"@nl;
  <http://purl.org/vocab/vann/usageNote> "Onder een Geregistreerde Organisaties verstaan we een Organisatie met een juridisch statuut (vastgelegd door registratie), bv NV, VZW..."@nl;
  rdfs:comment "Geregistreerde Organisatie die Mobiliteitsdiensten aanbiedt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Aanbieder.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    <http://purl.org/vocab/vann/usageNote> "In de KBO is dit het ondernemingsnummer."@nl;
    rdfs:comment "Identificator die de organisatie verkreeg bij registratie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Aanbieder.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator die de organisatie verkreeg bij registratie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Aanbieder.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path schema:contactPoint
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Aanbieder> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#AandrijftypeShape> a shacl:NodeShape;
  rdfs:label "Aandrijftype";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#BeschikbaarheidShape> a shacl:NodeShape;
  rdfs:label "Beschikbaarheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv uren waarin een dienst wordt aangeboden of openingsuren van een gebouw."@nl;
  rdfs:comment "Mate waarin iets voorhanden is voor gebruik."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "openingsurenString"@nl;
    <http://purl.org/vocab/vann/usageNote> "Syntax volgens schema.org voor openingsuren. Bv als contact kan worden opgenomen tussen 8 en 20u maandag tot zaterdag en tussen 8 en 18u op zondag wordt dit gecodeerd als Ma-za 08:00-20:00, zo 08:00-18:00."@nl;
    rdfs:comment "Uren waarop iets beschikbaar is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Beschikbaarheid.Openingsurenstring>;
    shacl:datatype rdfs:Literal;
    shacl:description "Uren waarop iets beschikbaar is."@nl;
    shacl:maxCount "1";
    shacl:name "openingsurenString"@nl;
    shacl:path schema:openingHours
  ], [
    a shacl:PropertyShape;
    rdfs:label "dienstregeling"@nl;
    rdfs:comment "Schema met tijdstippen waarop iets wordt aangeboden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Beschikbaarheid.Dienstregeling>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Dienstregeling>;
    shacl:description "Schema met tijdstippen waarop iets wordt aangeboden."@nl;
    shacl:maxCount "1";
    shacl:name "dienstregeling"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#dienstregeling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "openingsuren"@nl;
    rdfs:comment "Uren waarop iets beschikbaar is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Beschikbaarheid.Openingsuren>;
    shacl:class schema:OpeningHoursSpecification;
    shacl:description "Uren waarop iets beschikbaar is."@nl;
    shacl:maxCount "1";
    shacl:name "openingsuren"@nl;
    shacl:path schemas:hoursAvailable
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruiker"@nl;
    rdfs:comment "Type gebruiker waarvoor de beschikbaarheid geldt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Beschikbaarheid.Gebruiker>;
    shacl:class skos:Concept;
    shacl:description "Type gebruiker waarvoor de beschikbaarheid geldt."@nl;
    shacl:maxCount "1";
    shacl:name "gebruiker"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#gebruiker>
  ], [
    a shacl:PropertyShape;
    rdfs:label "periode"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv startdatum zonder einddatum voor dienstverlening die nog actief is of een aanduiding van het seizoen waarin de dienstverlening wordt aangeboden. Een ingevulde einddatum geeft aan wanneer de dienstverlening werd beëindigd. Begin- en einddatum volgens ISO8601 syntax."@nl;
    rdfs:comment "Periode waarin iets beschikbaar is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Beschikbaarheid.Periode>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Periode waarin iets beschikbaar is."@nl;
    shacl:maxCount "1";
    shacl:name "periode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#periode>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Beschikbaarheid> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#BoekingShape> a shacl:NodeShape;
  rdfs:label "Boeking"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv het aankopen van een treinticket of het reserveren van een zitplaats op de trein."@nl;
  rdfs:comment "Het vastleggen van een Reis door aankoop van een Vervoersbewijs en/of het reserveren van een Resource."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit tijdstip ligt typisch voor het vertrektijdstip van de Reis."@nl;
    rdfs:comment "Tijdstip waarop de Boeking is gebeurd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Boeking.Datum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de Boeking is gebeurd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum"@nl;
    shacl:path dc:date
  ], [
    a shacl:PropertyShape;
    rdfs:label "prijs"@nl;
    rdfs:comment "Prijs die voor de geboekte Reis of gereserveerde Resource is betaald."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Boeking.Prijs>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Prijs die voor de geboekte Reis of gereserveerde Resource is betaald."@nl;
    shacl:maxCount "1";
    shacl:name "prijs"@nl;
    shacl:path schemas:price
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv of de Boeking nog hangende is of reeds bevestigd."@nl;
    rdfs:comment "Status van de Boeking."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Boeking.Status>;
    shacl:class skos:Concept;
    shacl:description "Status van de Boeking."@nl;
    shacl:maxCount "1";
    shacl:name "status"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Boeking.status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "reis"@nl;
    rdfs:comment "Reis die geboekt wordt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Boeking.Reis>;
    shacl:class schemas:Trip;
    shacl:description "Reis die geboekt wordt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "reis"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#reis>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vervoersbewijs"@nl;
    rdfs:comment "Vervoersbewijs voor de geboekte Reis."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Boeking.Vervoersbewijs>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Vervoersbewijs>;
    shacl:description "Vervoersbewijs voor de geboekte Reis."@nl;
    shacl:name "vervoersbewijs"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Boeking.vervoersbewijs>
  ], [
    a shacl:PropertyShape;
