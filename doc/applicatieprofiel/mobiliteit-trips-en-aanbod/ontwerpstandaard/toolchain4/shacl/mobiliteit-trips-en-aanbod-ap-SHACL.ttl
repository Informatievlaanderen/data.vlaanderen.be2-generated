<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#OverstapShape> a shacl:NodeShape;
  rdfs:label "Overstap"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bedoeld om de overgang tussen twee Routesegmenten te beschrijven indien deze niet zelf door een Routesegment wordt voorgesteld. Men kan overstappen tussen twee dezelfde Routeknopen (bv overstap van de ene trein op de andere in hetzelfde station) of tussen twee verschillende (bv overstap van de parking bij het station naar - de perrons van - het station)."@nl;
  rdfs:comment "Logische verbinding tussen twee Routeknopen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "overstaptijd"@nl;
    rdfs:comment "Tijd waarin de overstap gebeurt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Overstap.Overstaptijd>;
    shacl:datatype xsd:duration;
    shacl:description "Tijd waarin de overstap gebeurt."@nl;
    shacl:maxCount "1";
    shacl:name "overstaptijd"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#overstaptijd>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vervoermiddel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Doorgaans te voet."@nl;
    rdfs:comment "Vervoermiddel waarmee de Overstap gebeurt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Overstap.Vervoermiddel>;
    shacl:class skos:Concept;
    shacl:description "Vervoermiddel waarmee de Overstap gebeurt."@nl;
    shacl:maxCount "1";
    shacl:name "vervoermiddel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Overstap.vervoermiddel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aandrijving"@nl;
    rdfs:comment "Aandrijving van het vervoermiddel waarmee de Overstap gebeurt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Overstap.Aandrijving>;
    shacl:class skos:Concept;
    shacl:description "Aandrijving van het vervoermiddel waarmee de Overstap gebeurt."@nl;
    shacl:maxCount "1";
    shacl:name "aandrijving"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Overstap.aandrijving>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Routeknoop (source)";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Overstap.Routeknoop(source)>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Routeknoop>;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "Routeknoop (source)";
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Overstap.routeknoop.source>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Routeknoop (target)";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/ontwerpstandaard/toolchain4#Overstap.Routeknoop(target)>;
