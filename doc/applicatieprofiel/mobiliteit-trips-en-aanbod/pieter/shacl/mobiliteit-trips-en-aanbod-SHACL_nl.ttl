<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#VervoersbewijsShape> a shacl:NodeShape;
  rdfs:label "Vervoersbewijs"@nl;
  <http://purl.org/vocab/vann/usageNote> "Vervoer of dienst zijn nog te consumeren of al geconsumeerd. Typisch een ticket voor of een abonnement op een Mobiliteitsdienst zoals openbaar vervoer, maar kan ook bijvoorbeeld een parkeerticket zijn."@nl;
  rdfs:comment "Bewijs van bepaald recht op vervoer of diensten daarmee geassocieerd."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Vervoersbewijs>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aantal"@nl;
    rdfs:comment "Aantal reizen dat men met het Vervoersbewijs kan afleggen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Vervoersbewijs.Aantal>;
    shacl:datatype xsd:integer;
    shacl:description "Aantal reizen dat men met het Vervoersbewijs kan afleggen."@nl;
    shacl:maxCount 1;
    shacl:name "aantal"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#aantal>
  ], [
    a shacl:PropertyShape;
    rdfs:label "duur"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld 1 uur in het geval van een metroticket of 1 dag voor een dagticket of een krediet van 120 minuten deelstep."@nl;
    rdfs:comment "Totale tijd waarvan men met het Vervoersbewijs van een Mobiliteitsdienst gebruik mag maken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Vervoersbewijs.Duur>;
    shacl:datatype xsd:duration;
    shacl:description "Totale tijd waarvan men met het Vervoersbewijs van een Mobiliteitsdienst gebruik mag maken."@nl;
    shacl:maxCount 1;
    shacl:name "duur"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#duur>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bedrag"@nl;
    rdfs:comment "Geldbedrag dat aan de Mobiliteitsdienst kan worden besteed."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Vervoersbewijs.Bedrag>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Geldbedrag dat aan de Mobiliteitsdienst kan worden besteed."@nl;
    shacl:maxCount 1;
    shacl:name "bedrag"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#bedrag>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Beperkt tot types die op een kwalitatieve manier aangeven in welke mate de Mobiliteitsdienst gebruikt mag worden met het gegeven Vervoersbewijs. Bijvoorbeeld dagticket geeft aan dat de Mobiliteitsdienst ongelimiteerd gebruikt mag worden gedurende 1 dag..."@nl;
    rdfs:comment "Aard van het Vervoersbewijs."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Vervoersbewijs.Type>;
