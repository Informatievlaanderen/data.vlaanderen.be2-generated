    shacl:name "vervoersbewijs"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Reiziger.vervoersbewijs>
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorkeur"@nl;
    rdfs:comment "Voorkeuren van de Reiziger."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Reiziger.Voorkeur>;
