    rdfs:comment "Formeel Kader waarbinnen de Licentie is verkregen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Licentie.VerkregenBinnen>;
    shacl:class <http://purl.org/vocab/cpsv#FormalFramework>;
