    shacl:class <http://purl.org/vocab/cpsv#FormalFramework>;
    shacl:description "Ander formeel kader dat met het formeel kader verband houdt."@nl;
    shacl:name "isGerelateerdAan"@nl;
    shacl:path dc:relation
  ];
  shacl:targetClass <http://purl.org/vocab/cpsv#FormalFramework> .

