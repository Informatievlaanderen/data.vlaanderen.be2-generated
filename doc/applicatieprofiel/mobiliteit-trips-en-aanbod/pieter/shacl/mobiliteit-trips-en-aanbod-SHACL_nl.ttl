    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van het formeel kader."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#FormeelKader.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van het formeel kader."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van het formeel kader."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#FormeelKader.Beschrijving>;
