    shacl:description "Toestand waarin een Resource zich bevindt."@nl;
    shacl:maxCount 1;
    shacl:name "status"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Resource.status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vervoermiddel"@nl;
    <http://purl.org/vocab/vann/usageNote> "Vooral relevant als de resource een voertuig is."@nl;
