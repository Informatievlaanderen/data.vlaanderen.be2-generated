    shacl:class <http://www.opengis.net/ont/sf#LineString>;
    shacl:description "Geometrie van de midellijn van de Link."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "geometriemiddellijn"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#geometriemiddellijn>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Link> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#LocatieShape> a shacl:NodeShape;
  rdfs:label "Locatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet direct gewerkt worden met Geometrie, GeografischeNaam, Adres etc."@nl;
  rdfs:comment "Aanduiding van een geografische positie,door middel van coordinaten,een toponiem,een adreslabel,een verwijzing naar een plaats/regio of verwijzing naar een adres."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Locatie>;
  shacl:closed false;
  shacl:targetClass prov:Location .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#MobiliteitsdienstShape> a shacl:NodeShape;
  rdfs:label "Mobiliteitsdienst"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hieronder verstaan we zowel klassieke mobiliteitsdiensten zoals openbaar vervoer (typisch aangeboden als lijndienst, bijvoorbeeld metrolijn 5 in Brussel), maar ook deelvervoer zoals free floating deelsteps (bijvoorbeeld deelsteps in grote steden)."@nl;
  rdfs:comment "Dienstverlening die verplaatsingen van Personen tussen Locaties mogelijk maakt."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Mobiliteitsdienst>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van de Mobiliteitsdienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Mobiliteitsdienst.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van de Mobiliteitsdienst."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld openbaar vervoer, parking etc. Combinaties zijn mogelijk, bijvoorbeeld collectief vervoer & openbaar vervoer (bijvoorbeeld NMBS), individueel vervoer & privé vervoer (taxi's)..."@nl;
    rdfs:comment "Aard van de mobiliteitsdienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Mobiliteitsdienst.Type>;
    shacl:description "Aard van de mobiliteitsdienst."@nl;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "ruimtelijkeDekking"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld Brussels Gewest, Antwerpen..."@nl;
    rdfs:comment "Gebied of Plaats waarbinnen de Mobiliteitsdienst wordt aangeboden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Mobiliteitsdienst.RuimtelijkeDekking>;
    shacl:class dc:Location;
    shacl:description "Gebied of Plaats waarbinnen de Mobiliteitsdienst wordt aangeboden."@nl;
    shacl:name "ruimtelijkeDekking"@nl;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbaarheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld dienstregeling of openingsuren."@nl;
    rdfs:comment "Beschikbaarheid van de Mobiliteitsdienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Mobiliteitsdienst.Beschikbaarheid>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Beschikbaarheid>;
    shacl:description "Beschikbaarheid van de Mobiliteitsdienst."@nl;
    shacl:name "beschikbaarheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Mobiliteitsdienst.beschikbaarheid>
  ], [
    a shacl:PropertyShape;
