    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Routeknoop (target)";
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Overstap.routeknoop.target>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gerealiseerdOp"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de halte waar men overstapt tussen twee metrolijnen, het Adresgebied waarbinnen men overstapt tussen twee vervoersmodi."@nl;
    rdfs:comment "Transportobject waarmee de Routeconnectie samenvalt."@nl;
