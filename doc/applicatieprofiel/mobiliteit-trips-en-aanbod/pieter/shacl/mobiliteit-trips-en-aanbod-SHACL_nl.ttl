    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Routeknoop>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Routeknoop (source)";
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Overstap.routeknoop.source>
  ], [
