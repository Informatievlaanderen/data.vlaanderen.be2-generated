    rdfs:comment "Vervoersbewijs van de Reiziger."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Reiziger.Vervoersbewijs>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Vervoersbewijs>;
