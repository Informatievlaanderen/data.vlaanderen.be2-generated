<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#LijnstringShape> a shacl:NodeShape;
  rdfs:label "Lijnstring"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een curve is een 1-dimensioneel geometrisch object gedefinieerd als een sequentie van punten. De interpolatie kan op verschillende manieren gebeuren (bijvoorbeeld lineair bij een lijnstring)."@nl;
  rdfs:comment "Curve met lineaire interpolatie tussen de punten. Elk opeenvolgend paar punten vormt een lijnsegment. De lijnstring heeft ten minste twee punten."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Lijnstring>;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#LineString> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#LinkShape> a shacl:NodeShape;
  rdfs:label "Link"@nl;
  rdfs:comment "Curvilineair netwerkelement dat twee posities verbindt en een homogeen pad in het Netwerk vertegenwoordigt. De verbonden posities worden voorgesteld door Knopen."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit-trips-en-aanbod/pieter#Link>;
  shacl:closed false;
  shacl:property [
