{
  "title": "Aanbieder",
  "type": "object",
  "description": "Geregistreerde Organisatie die Mobiliteitsdiensten aanbiedt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Aanbieder)",
      "pattern": "^Aanbieder$"
    },
    "voorkeursnaam": {
      "$ref": "#/components/schemas/Aanbieder.voorkeursnaam"
    },
    "registratie": {
      "$ref": "#/components/schemas/Identificator"
    },
    "contactinfo": {
      "type": "array",
      "description": "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren. Lijst van Contactinfo items.",
      "items": {
        "$ref": "#/components/schemas/Contactinfo"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "voorkeursnaam",
    "registratie"
  ]
}