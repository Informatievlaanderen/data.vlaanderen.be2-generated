{
  "title": "Overstap",
  "type": "object",
  "description": "Logische verbinding tussen twee Routeknopen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Overstap)",
      "pattern": "^Overstap$"
    },
    "overstaptijd": {
      "$ref": "#/components/schemas/Overstap.overstaptijd"
    },
    "vervoermiddel": {
      "$ref": "#/components/schemas/Vervoermiddel"
    },
    "aandrijving": {
      "$ref": "#/components/schemas/Aandrijftype"
    },
    "routeknoop(Source)": {
      "$ref": "#/components/schemas/Routeknoop"
    },
    "routeknoop(Target)": {
      "$ref": "#/components/schemas/Routeknoop"
    },
    "gerealiseerdOp": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Transportgebied"
        },
        {
          "$ref": "#/components/schemas/Transportknoop"
        },
        {
          "$ref": "#/components/schemas/Transportconnectie"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Transportgebied": "#/components/schemas/Transportgebied",
          "Transportknoop": "#/components/schemas/Transportknoop",
          "Transportconnectie": "#/components/schemas/Transportconnectie"
        }
      }
    }
  },
  "required": [
    "@type",
    "routeknoop(Source)",
    "routeknoop(Target)"
  ]
}