{
  "title": "Provider",
  "type": "object",
  "description": "Registered Organisation providing Mobility Services.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Provider)",
      "pattern": "^Provider$"
    },
    "preferredName": {
      "$ref": "#/components/schemas/Provider.preferredName"
    },
    "registration": {
      "$ref": "#/components/schemas/Identifier"
    },
    "contactInfo": {
      "type": "array",
      "description": "Information such as email, telephone... that allows the Organisation to be contacted. Lijst van ContactInfo items.",
      "items": {
        "$ref": "#/components/schemas/ContactInfo"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "preferredName",
    "registration"
  ]
}