{
  "title": "PubliekeOrganisatie",
  "type": "object",
  "description": "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector, ongeacht het bestuursniveau waarop dat kader van kracht is.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse PubliekeOrganisatie)",
      "pattern": "^PubliekeOrganisatie$"
    },
    "voorkeursnaam": {
      "$ref": "#/components/schemas/PubliekeOrganisatie.voorkeursnaam"
    },
    "werkingsgebied": {
      "type": "array",
      "description": "Administratief gebied dat de Publieke Organisatie dekt. Lijst van Plaats items.",
      "items": {
        "$ref": "#/components/schemas/Plaats"
      },
      "minItems": 1
    },
    "contactinfo": {
      "$ref": "#/components/schemas/Contactinfo"
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    }
  },
  "required": [
    "@type",
    "voorkeursnaam",
    "contactinfo",
    "identificator"
  ]
}