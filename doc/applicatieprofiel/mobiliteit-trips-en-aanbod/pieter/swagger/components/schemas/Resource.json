{
  "title": "Resource",
  "type": "object",
  "description": "Middel dat de Mobiliteitsdienst aan de Reiziger kan aanbieden om zijn verplaatsing te maken.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Resource)",
      "pattern": "^Resource$"
    },
    "identificator": {
      "$ref": "#/components/schemas/Resource.identificator"
    },
    "type": {
      "$ref": "#/components/schemas/Resourcetype"
    },
    "ruimtelijkeDekking": {
      "$ref": "#/components/schemas/Locatie"
    },
    "status": {
      "$ref": "#/components/schemas/Resourcestatus"
    },
    "vervoermiddel": {
      "$ref": "#/components/schemas/Vervoermiddel"
    },
    "aandrijving": {
      "$ref": "#/components/schemas/Aandrijftype"
    },
    "dienst": {
      "type": "array",
      "description": "Mobiliteitsdienst van de Resource. Lijst van Mobiliteitsdienst items.",
      "items": {
        "$ref": "#/components/schemas/Mobiliteitsdienst"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "type",
    "dienst"
  ]
}