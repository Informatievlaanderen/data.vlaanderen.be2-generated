{
  "title": "Resource",
  "type": "object",
  "description": "Means that the Mobility Service can offer to the Traveller to make his journey.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Resource)",
      "pattern": "^Resource$"
    },
    "identifier": {
      "$ref": "#/components/schemas/Resource.identifier"
    },
    "type": {
      "$ref": "#/components/schemas/ResourceType"
    },
    "spatialCoverage": {
      "$ref": "#/components/schemas/Location"
    },
    "status": {
      "$ref": "#/components/schemas/ResourceHealth"
    },
    "meansOfTransport": {
      "$ref": "#/components/schemas/MeansOfTransport"
    },
    "drive": {
      "$ref": "#/components/schemas/TODONOTRANSLATIONPROVIDED"
    },
    "service": {
      "type": "array",
      "description": "Mobility service of the Resource. Lijst van MobilityService items.",
      "items": {
        "$ref": "#/components/schemas/MobilityService"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "type",
    "service"
  ]
}