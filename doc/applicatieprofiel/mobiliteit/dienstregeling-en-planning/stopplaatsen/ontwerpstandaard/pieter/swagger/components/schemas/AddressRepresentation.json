{
  "title": "AddressRepresentation",
  "type": "object",
  "description": "Easier to read of a structured address with only the basic or combined data, intended for the use of an address as an attribute of another object or as a label.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse AddressRepresentation)",
      "pattern": "^AddressRepresentation$"
    },
    "administrativeUnitName": {
      "$ref": "#/components/schemas/AddressRepresentation.administrativeUnitName"
    },
    "busNumber": {
      "$ref": "#/components/schemas/AddressRepresentation.busNumber"
    },
    "municipalityName": {
      "$ref": "#/components/schemas/AddressRepresentation.municipalityName"
    },
    "houseNumber": {
      "$ref": "#/components/schemas/AddressRepresentation.houseNumber"
    },
    "country": {
      "$ref": "#/components/schemas/AddressRepresentation.country"
    },
    "locatorDesignator": {
      "type": "array",
      "description": "A number or string of characters that uniquely identifies the location within the relevant scope. The full identification of the locator could include one or more locator designators. The scope is for example the street for a housenumber or the housenumber for a busnumber. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/AddressRepresentation.locatorDesignator"
      },
      "minItems": 1
    },
    "postOfficeBox": {
      "$ref": "#/components/schemas/AddressRepresentation.postOfficeBox"
    },
    "postcode": {
      "$ref": "#/components/schemas/AddressRepresentation.postcode"
    },
    "postName": {
      "$ref": "#/components/schemas/AddressRepresentation.postName"
    },
    "thoroughfare": {
      "$ref": "#/components/schemas/AddressRepresentation.thoroughfare"
    },
    "fullAddress": {
      "$ref": "#/components/schemas/AddressRepresentation.fullAddress"
    },
    "refersTo": {
      "$ref": "#/components/schemas/Address"
    }
  },
  "required": [
    "@type",
    "administrativeUnitName"
  ]
}