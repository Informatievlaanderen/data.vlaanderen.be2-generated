{
  "title": "Adresvoorstelling",
  "type": "object",
  "description": "More readable presentation with only the basic data of the address, intended for the use of an address as an attribute of another object.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Adresvoorstelling)",
      "pattern": "^Adresvoorstelling$"
    },
    "administratieveEenheidNiveau2": {
      "$ref": "#/components/schemas/Adresvoorstelling.administratieveEenheidNiveau2"
    },
    "adresgebied": {
      "$ref": "#/components/schemas/Adresvoorstelling.adresgebied"
    },
    "busnummer": {
      "$ref": "#/components/schemas/Adresvoorstelling.busnummer"
    },
    "gemeentenaam": {
      "$ref": "#/components/schemas/Adresvoorstelling.gemeentenaam"
    },
    "huisnummer": {
      "$ref": "#/components/schemas/Adresvoorstelling.huisnummer"
    },
    "land": {
      "$ref": "#/components/schemas/Adresvoorstelling.land"
    },
    "locatieaanduiding": {
      "type": "array",
      "description": "Alphanumeric code that uniquely identifies the address locator within the street, administrative unit etc. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Adresvoorstelling.locatieaanduiding"
      },
      "minItems": 1
    },
    "locatienaam": {
      "type": "array",
      "description": "Name or description of the geographical object that the address locator denotes. Lijst van LanguageString items.",
      "items": {
        "$ref": "#/components/schemas/Adresvoorstelling.locatienaam"
      },
      "minItems": 1
    },
    "postbus": {
      "$ref": "#/components/schemas/Adresvoorstelling.postbus"
    },
    "postcode": {
      "$ref": "#/components/schemas/Adresvoorstelling.postcode"
    },
    "postnaam": {
      "$ref": "#/components/schemas/Adresvoorstelling.postnaam"
    },
    "straatnaam": {
      "$ref": "#/components/schemas/Adresvoorstelling.straatnaam"
    },
    "volledigAdres": {
      "$ref": "#/components/schemas/Adresvoorstelling.volledigAdres"
    },
    "administratieveEenheidNiveau1": {
      "$ref": "#/components/schemas/Adresvoorstelling.administratieveEenheidNiveau1"
    }
  },
  "required": [
    "@type"
  ]
}