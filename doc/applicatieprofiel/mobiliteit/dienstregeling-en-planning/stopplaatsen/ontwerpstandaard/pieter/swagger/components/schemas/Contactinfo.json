{
  "title": "Contactinfo",
  "type": "object",
  "description": "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Contactinfo)",
      "pattern": "^Contactinfo$"
    },
    "aanschrijfvorm": {
      "type": "object",
      "description": "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen. Bijvoorbeeld De heer/Mevrouw, Excellentie, Dokter...",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "contactnaam": {
      "type": "object",
      "description": "Naam van bijvoorbeeld de persoon die men kan contacteren.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "email": {
      "type": "object",
      "description": "Email-adres waarnaar men kan mailen.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "openingsuren": {
      "type": "object",
      "description": "Uren waarbinnen contact kan worden opgenomen. Syntax volgens schema.org voor openingsuren. Bijvoorbeeld als contact kan worden opgenomen tussen 8 en 20u maandag tot zaterdag en tussen 8 en 18u op zondag wordt dit gecodeerd als Ma-za 08:00-20:00, zo 08:00-18:00.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "telefoon": {
      "type": "object",
      "description": "Telefoonnummer waarop men kan bellen.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "website": {
      "type": "object",
      "description": "Website waarnaar men kan surfen.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "adres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    }
  },
  "required": [
    "@type"
  ]
}