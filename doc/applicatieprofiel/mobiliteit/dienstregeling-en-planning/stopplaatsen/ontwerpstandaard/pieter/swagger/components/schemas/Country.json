{
  "title": "Country",
  "type": "object",
  "description": "A jurisdictional geographic boundary.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Country)",
      "pattern": "^Country$"
    },
    "uicCode": {
      "$ref": "#/components/schemas/Country.uicCode"
    },
    "alternativeName": {
      "type": "array",
      "description": "Alternative name for the Country. Lijst van LanguageString items.",
      "items": {
        "$ref": "#/components/schemas/Country.alternativeName"
      },
      "minItems": 1
    },
    "name": {
      "$ref": "#/components/schemas/Country.name"
    }
  },
  "required": [
    "@type"
  ]
}