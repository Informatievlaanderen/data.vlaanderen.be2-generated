{
  "title": "GroepVanStopplaatsen",
  "type": "object",
  "description": "Een groepering van stopplaatsen waar vaak naar wordt verwezen voor een specifiek doel (stops in een luchthaven, hoofdstops van een stad, enz.).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GroepVanStopplaatsen)",
      "pattern": "^GroepVanStopplaatsen$"
    },
    "naam": {
      "type": "object",
      "description": "Naam van de groep stopplaatsen.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "korteNaam": {
      "type": "object",
      "description": "Korte naam voor de groep stopplaatsen.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "omschrijving": {
      "type": "object",
      "description": "Beschrijving van de groep stopplaatsen.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "privéCode": {
      "type": "object",
      "description": "Privécode in verband met de groep stopplaatsen.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "transportmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "doelVanGroepering": {
      "$ref": "#/components/schemas/Code"
    },
    "lid": {
      "type": "array",
      "description": "Lijst van Stopplaats items.",
      "items": {
        "$ref": "#/components/schemas/Stopplaats"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}