{
  "title": "GroepVanStopplaatsen",
  "type": "object",
  "description": "Een groepering van stopplaatsen waar vaak naar wordt verwezen voor een specifiek doel (stops in een luchthaven, hoofdstops van een stad, enz.).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GroepVanStopplaatsen)",
      "pattern": "^GroepVanStopplaatsen$"
    },
    "naam": {
      "$ref": "#/components/schemas/GroepVanStopplaatsen.naam"
    },
    "korteNaam": {
      "$ref": "#/components/schemas/GroepVanStopplaatsen.korteNaam"
    },
    "omschrijving": {
      "$ref": "#/components/schemas/GroepVanStopplaatsen.omschrijving"
    },
    "privéCode": {
      "$ref": "#/components/schemas/GroepVanStopplaatsen.privéCode"
    },
    "transportmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "doelVanGroepering": {
      "$ref": "#/components/schemas/Code"
    },
    "submodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "lid": {
      "type": "array",
      "description": "Stopplaats die lid is van de groep stopplaatsen. Lijst van Stopplaats items.",
      "items": {
        "$ref": "#/components/schemas/Stopplaats"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}