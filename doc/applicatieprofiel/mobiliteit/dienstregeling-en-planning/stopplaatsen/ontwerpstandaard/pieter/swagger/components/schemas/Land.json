{
  "title": "Land",
  "type": "object",
  "description": "Een jurisdictionele en geografisch afgebakende Plaats.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Land)",
      "pattern": "^Land$"
    },
    "uicCode": {
      "type": "object",
      "description": "Uic-code van het land.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "alternatieveNaam": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Alternatieve naam voor het land.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "naam": {
      "type": "object",
      "description": "Naam van het land.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    }
  },
  "required": [
    "@type"
  ]
}