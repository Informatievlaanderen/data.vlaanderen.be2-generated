{
  "title": "Locale",
  "type": "object",
  "description": "Parameters en eigenschappen die moeten worden gebruikt bij het verwerken en presenteren van gegevens in een land of regio (tijdzone, taal, etc.).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Locale)",
      "pattern": "^Locale$"
    },
    "tijdzone": {
      "$ref": "#/components/schemas/Locale.tijdzone"
    },
    "tijdzoneOffset": {
      "$ref": "#/components/schemas/Locale.tijdzoneOffset"
    },
    "zomertijdzoneOffset": {
      "$ref": "#/components/schemas/Locale.zomertijdzoneOffset"
    },
    "standaardTaal": {
      "$ref": "#/components/schemas/Locale.standaardTaal"
    },
    "taal": {
      "type": "array",
      "description": "Andere talen ondersteund in de locale. Lijst van Taal items.",
      "items": {
        "$ref": "#/components/schemas/Locale.taal"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}