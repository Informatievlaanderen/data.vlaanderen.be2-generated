{
  "title": "Locale.standaardTaal",
  "type": "object",
  "description": "Standaardtaal van de locale, Bijvoorbeeld en, fr, de, etc.",
  "properties": {
    "@value": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?"
    },
    "@type": {
      "type": "string",
      "pattern": "^Language$"
    }
  },
  "required": [
    "@value",
    "@type"
  ]
}