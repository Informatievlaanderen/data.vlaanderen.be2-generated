{
  "title": "Locale.zomertijdzoneOffset",
  "type": "object",
  "description": "Tijdzone als offset in uren of deeluren van GMT. Kan plus of min zijn.",
  "properties": {
    "@value": {
      "type": "string",
      "pattern": "(+|-)?([0-9]+(.[0-9]*)?|.[0-9]+)"
    },
    "@type": {
      "type": "string",
      "pattern": "^Decimal$"
    }
  },
  "required": [
    "@value",
    "@type"
  ]
}