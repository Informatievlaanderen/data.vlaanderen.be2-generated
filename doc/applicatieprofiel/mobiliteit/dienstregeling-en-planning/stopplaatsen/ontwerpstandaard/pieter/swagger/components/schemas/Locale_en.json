{
  "title": "Locale",
  "type": "object",
  "description": "Parameters and properties to be used when processing and presenting data in a country or region (time zone, language, etc.).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Locale)",
      "pattern": "^Locale$"
    },
    "timeZone": {
      "$ref": "#/components/schemas/Locale.timeZone"
    },
    "timeZoneOffset": {
      "$ref": "#/components/schemas/Locale.timeZoneOffset"
    },
    "summerTimeZoneOffset": {
      "$ref": "#/components/schemas/Locale.summerTimeZoneOffset"
    },
    "defaultLanguage": {
      "$ref": "#/components/schemas/Locale.defaultLanguage"
    },
    "language": {
      "type": "array",
      "description": "Other languages supported in the Locale. Lijst van Language items.",
      "items": {
        "$ref": "#/components/schemas/Locale.language"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}