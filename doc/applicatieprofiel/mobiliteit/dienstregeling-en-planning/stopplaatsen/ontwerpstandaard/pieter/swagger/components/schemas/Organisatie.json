{
  "title": "Organisatie",
  "type": "object",
  "description": "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een organisatie heeft dikwijls een hiërarchische structuur.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Organisatie)",
      "pattern": "^Organisatie$"
    },
    "alternatieveNaam": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Andere naam waaronder de organisatie bekend is. Bijvoorbeeld commerciële naam, informele naam….",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "beschrijving": {
      "type": "object",
      "description": "Beschrijving van de organisatie.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "voorkeursnaam": {
      "type": "object",
      "description": "Naam waarmee de organisatie bij voorkeur wordt aangeduid.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "contactinfo": {
      "type": "array",
      "description": "Lijst van Contactinfo items.",
      "items": {
        "$ref": "#/components/schemas/Contactinfo"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Lijst van OrganizationType items.",
      "items": {
        "$ref": "#/components/schemas/OrganizationType"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "voorkeursnaam"
  ]
}