{
  "title": "Perron",
  "type": "object",
  "description": "Een plaats zoals een platform, bushalte, stand of perron waar passagiers toegang hebben tot openbaar vervoer voertuigen, taxi, auto's of ander vervoermiddel.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Perron)",
      "pattern": "^Perron$"
    },
    "publiekeCode": {
      "type": "object",
      "description": "Gebruik om het perron aan het publiek te identificeren.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "label": {
      "type": "object",
      "description": "Label van het perron.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "plaatcode": {
      "type": "object",
      "description": "Asset-code die wordt gebruikt om het perron te identificeren.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "kruispunt": {
      "type": "object",
      "description": "Naam van de dichtstbijzijnde dwarsweg of kruising en die kan worden gebruikt om het perron te lokaliseren. Mainly relevant for bus modes, where the cross road may provide necessary context to describe the stop to a user.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "verdieping": {
      "$ref": "#/components/schemas/Verdieping"
    },
    "helling": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "perrontype": {
      "$ref": "#/components/schemas/Perrontype"
    },
    "toegankelijkheidsbeoordeling": {
      "$ref": "#/components/schemas/Toegankelijkheidsbeoordeling"
    },
    "toegangsmodus": {
      "type": "array",
      "description": "Lijst van Toegangsmodus items.",
      "items": {
        "$ref": "#/components/schemas/Toegangsmodus"
      },
      "minItems": 1
    },
    "overdekt": {
      "$ref": "#/components/schemas/Overdekkingstype"
    },
    "omheind": {
      "$ref": "#/components/schemas/Omheiningstype"
    },
    "verlichting": {
      "$ref": "#/components/schemas/Verlichtingstype"
    },
    "superperron": {
      "$ref": "#/components/schemas/Perron"
    }
  },
  "required": [
    "@type"
  ]
}