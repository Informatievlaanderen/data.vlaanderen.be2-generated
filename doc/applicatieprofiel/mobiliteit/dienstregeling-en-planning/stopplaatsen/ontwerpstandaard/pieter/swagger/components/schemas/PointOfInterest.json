{
  "title": "PointOfInterest",
  "type": "object",
  "description": "Een soort plaats waarnaar of waardoor passagiers misschien willen navigeren als onderdeel van hun rit en die in detail wordt gemodelleerd door reisplanners.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse PointOfInterest)",
      "pattern": "^PointOfInterest$"
    },
    "naam": {
      "$ref": "#/components/schemas/PointOfInterest.naam"
    },
    "korteNaam": {
      "$ref": "#/components/schemas/PointOfInterest.korteNaam"
    },
    "omschrijving": {
      "$ref": "#/components/schemas/PointOfInterest.omschrijving"
    },
    "privéCode": {
      "$ref": "#/components/schemas/PointOfInterest.privéCode"
    },
    "classificatie": {
      "type": "array",
      "description": "Classificatie van de Point of Interest. Lijst van Code items.",
      "items": {
        "$ref": "#/components/schemas/Code"
      },
      "minItems": 1
    },
    "nabijeTopografischePlaats": {
      "type": "array",
      "description": "Topografische plaatsen in de buurt van de Point of Interest. Lijst van TopografischePlaats items.",
      "items": {
        "$ref": "#/components/schemas/TopografischePlaats"
      },
      "minItems": 1
    },
    "locale": {
      "$ref": "#/components/schemas/Locale"
    },
    "organisatie": {
      "$ref": "#/components/schemas/Operator"
    },
    "parentSite": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Site"
        },
        {
          "$ref": "#/components/schemas/Stopplaats"
        },
        {
          "$ref": "#/components/schemas/PointOfInterest"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Site": "#/components/schemas/Site",
          "Stopplaats": "#/components/schemas/Stopplaats",
          "PointOfInterest": "#/components/schemas/PointOfInterest"
        }
      }
    },
    "verdieping": {
      "type": "array",
      "description": "Verdieping van de Point of Interest. Lijst van Verdieping items.",
      "items": {
        "$ref": "#/components/schemas/Verdieping"
      },
      "minItems": 1
    },
    "ingang": {
      "type": "array",
      "description": "Ingang van de Point of Interest. Lijst van Toegang items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Toegang"
          },
          {
            "$ref": "#/components/schemas/Stopplaatstoegang"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Toegang": "#/components/schemas/Toegang",
            "Stopplaatstoegang": "#/components/schemas/Stopplaatstoegang"
          }
        }
      },
      "minItems": 1
    },
    "centroïDe": {
      "$ref": "#/components/schemas/PuntDatatype"
    },
    "polygoon": {
      "$ref": "#/components/schemas/Polygoon"
    },
    "bediendDoor": {
      "type": "array",
      "description": "Point of Interest dat door de Stopplaats wordt bediend. Lijst van Stopplaats items.",
      "items": {
        "$ref": "#/components/schemas/Stopplaats"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "centroïDe"
  ]
}