{
  "title": "Presentation",
  "type": "object",
  "description": "Defines a uniform set of values to control appearances of an element (on a map, a schematic map, a paper or screen description, etc.).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Presentation)",
      "pattern": "^Presentation$"
    },
    "infoLink": {
      "type": "array",
      "description": "URL of an image associated with the entity. For example an icon. Lijst van URI items.",
      "items": {
        "$ref": "#/components/schemas/Presentation.infoLink"
      },
      "minItems": 1
    },
    "colour": {
      "$ref": "#/components/schemas/ColourType"
    },
    "backgroundColour": {
      "$ref": "#/components/schemas/ColourType"
    },
    "textColour": {
      "$ref": "#/components/schemas/ColourType"
    },
    "textFont": {
      "$ref": "#/components/schemas/TextFontType"
    }
  },
  "required": [
    "@type"
  ]
}