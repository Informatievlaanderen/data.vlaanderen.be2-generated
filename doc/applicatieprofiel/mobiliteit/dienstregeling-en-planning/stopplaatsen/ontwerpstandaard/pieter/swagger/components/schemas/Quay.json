{
  "title": "Quay",
  "type": "object",
  "description": "A place such as a platform, bus stop, stance or quay side where passengers have access to public transport vehicles, taxi, cars or other means of transportation.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Quay)",
      "pattern": "^Quay$"
    },
    "publicCode": {
      "$ref": "#/components/schemas/Quay.publicCode"
    },
    "label": {
      "$ref": "#/components/schemas/Quay.label"
    },
    "plateCode": {
      "$ref": "#/components/schemas/Quay.plateCode"
    },
    "crossRoad": {
      "$ref": "#/components/schemas/Quay.crossRoad"
    },
    "level": {
      "$ref": "#/components/schemas/Level"
    },
    "compassBearing": {
      "$ref": "#/components/schemas/QuantitativeValue"
    },
    "quayType": {
      "$ref": "#/components/schemas/QuayType"
    },
    "accessibilityAssessment": {
      "$ref": "#/components/schemas/AccessibilityAssessment"
    },
    "accessMode": {
      "type": "array",
      "description": "Access mode of the Quay. Lijst van AccessMode items.",
      "items": {
        "$ref": "#/components/schemas/AccessMode"
      },
      "minItems": 1
    },
    "covered": {
      "$ref": "#/components/schemas/CoveredType"
    },
    "gated": {
      "$ref": "#/components/schemas/GatedType"
    },
    "lighting": {
      "$ref": "#/components/schemas/LightingType"
    },
    "parentQuay": {
      "$ref": "#/components/schemas/Quay"
    }
  },
  "required": [
    "@type"
  ]
}