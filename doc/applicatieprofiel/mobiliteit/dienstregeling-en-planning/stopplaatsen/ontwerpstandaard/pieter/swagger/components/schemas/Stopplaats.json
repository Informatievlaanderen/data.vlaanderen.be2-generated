{
  "title": "Stopplaats",
  "type": "object",
  "description": "Een Stopplaats stelt een station, halte, haven, luchthaven of eender welk ander fysiek toegangspunt tot het transportnetwerk voor.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Stopplaats)",
      "pattern": "^Stopplaats$"
    },
    "publiekeCode": {
      "type": "object",
      "description": "Code gebruikt om een ??stopplaats aan het publiek te identificeren als een alternatief voor een naam.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "grensovergang": {
      "type": "object",
      "description": "Geeft aan of de stopplaats een grensovergang is.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "alternatieveNaam": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Alternatieve naam voor de stopplaats. Gebruikt voor stops met meerdere aliassen.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "kruispunt": {
      "type": "object",
      "description": "Naam van de dichtstbijzijnde dwarsweg of kruising die kan worden gebruikt om de stopplaats te vinden. Hoofdzakelijk relevant voor busmodi, waar de dwarsweg de nodige context kan verstrekken om de Stop bij een gebruiker te beschrijven.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "oriëNtatiepunt": {
      "type": "object",
      "description": "Naam van een nabijgelegen oriëntatiepunt. Voornamelijk relevant voor busmodi.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "url": {
      "type": "object",
      "description": "URL met informatie over de stopplaats.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "afbeelding": {
      "type": "object",
      "description": "Afbeelding van de stopplaats.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "naam": {
      "type": "object",
      "description": "Naam van de Stopplaats.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "korteNaam": {
      "type": "object",
      "description": "Korte naam van deStopplaats.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "omschrijving": {
      "type": "object",
      "description": "Beschrijving van de Stopplaats.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "privéCode": {
      "type": "object",
      "description": "Privécode van de Stopplaats.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "transportmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "stopplaatstype": {
      "$ref": "#/components/schemas/Stopplaatstype"
    },
    "toegankelijkheidsbeoordeling": {
      "$ref": "#/components/schemas/Toegankelijkheidsbeoordeling"
    },
    "toegangsmodi": {
      "type": "array",
      "description": "Lijst van Toegangsmodus items.",
      "items": {
        "$ref": "#/components/schemas/Toegangsmodus"
      },
      "minItems": 1
    },
    "wegadres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    },
    "centroïDe": {
      "$ref": "#/components/schemas/PuntDatatype"
    },
    "locale": {
      "$ref": "#/components/schemas/Locale"
    },
    "plaatstype": {
      "$ref": "#/components/schemas/Plaatstype"
    },
    "polygoon": {
      "$ref": "#/components/schemas/Polygoon"
    },
    "submodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "andereTransportmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "tariefzone": {
      "type": "array",
      "description": "Lijst van Tariefzone items.",
      "items": {
        "$ref": "#/components/schemas/Tariefzone"
      },
      "minItems": 1
    },
    "gewicht": {
      "$ref": "#/components/schemas/Code"
    },
    "stopplaatsgewicht": {
      "$ref": "#/components/schemas/Stopplaatsgewicht"
    },
    "organisatie": {
      "$ref": "#/components/schemas/Operator"
    },
    "verdieping": {
      "type": "array",
      "description": "Lijst van Verdieping items.",
      "items": {
        "$ref": "#/components/schemas/Verdieping"
      },
      "minItems": 1
    },
    "overdekt": {
      "$ref": "#/components/schemas/Overdekkingstype"
    },
    "omheind": {
      "$ref": "#/components/schemas/Omheiningstype"
    },
    "verlichting": {
      "$ref": "#/components/schemas/Verlichtingstype"
    },
    "postadres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    },
    "gelegenIn": {
      "$ref": "#/components/schemas/Land"
    },
    "geplandeStopplaats": {
      "type": "array",
      "description": "Lijst van GeplandStoppunt items.",
      "items": {
        "$ref": "#/components/schemas/GeplandStoppunt"
      },
      "minItems": 1
    },
    "omvattend": {
      "type": "array",
      "description": "Lijst van Perron items.",
      "items": {
        "$ref": "#/components/schemas/Perron"
      },
      "minItems": 1
    },
    "binnengekomenVia": {
      "type": "array",
      "description": "Lijst van Stopplaatstoegang items.",
      "items": {
        "$ref": "#/components/schemas/Stopplaatstoegang"
      },
      "minItems": 1
    },
    "bedient": {
      "type": "array",
      "description": "Lijst van PointOfInterest items.",
      "items": {
        "$ref": "#/components/schemas/PointOfInterest"
      },
      "minItems": 1
    },
    "voor": {
      "type": "array",
      "description": "Lijst van TopografischePlaats items.",
      "items": {
        "$ref": "#/components/schemas/TopografischePlaats"
      },
      "minItems": 1
    },
    "in": {
      "type": "array",
      "description": "Lijst van TopografischePlaats items.",
      "items": {
        "$ref": "#/components/schemas/TopografischePlaats"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "stopplaatstype",
    "gelegenIn"
  ]
}