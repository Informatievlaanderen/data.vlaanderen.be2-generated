{
  "title": "Stopplaats",
  "type": "object",
  "description": "Een Stopplaats stelt een station, halte, haven, luchthaven of eender welk ander fysiek toegangspunt tot het transportnetwerk voor.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Stopplaats)",
      "pattern": "^Stopplaats$"
    },
    "publiekeCode": {
      "$ref": "#/components/schemas/Stopplaats.publiekeCode"
    },
    "grensovergang": {
      "$ref": "#/components/schemas/Stopplaats.grensovergang"
    },
    "alternatieveNaam": {
      "type": "array",
      "description": "Alternatieve naam voor de stopplaats. Gebruikt voor stops met meerdere aliassen. Lijst van Taalstring items.",
      "items": {
        "$ref": "#/components/schemas/Stopplaats.alternatieveNaam"
      },
      "minItems": 1
    },
    "kruispunt": {
      "$ref": "#/components/schemas/Stopplaats.kruispunt"
    },
    "oriëNtatiepunt": {
      "$ref": "#/components/schemas/Stopplaats.oriëNtatiepunt"
    },
    "url": {
      "$ref": "#/components/schemas/Stopplaats.url"
    },
    "afbeelding": {
      "$ref": "#/components/schemas/Stopplaats.afbeelding"
    },
    "naam": {
      "$ref": "#/components/schemas/Stopplaats.naam"
    },
    "korteNaam": {
      "$ref": "#/components/schemas/Stopplaats.korteNaam"
    },
    "omschrijving": {
      "$ref": "#/components/schemas/Stopplaats.omschrijving"
    },
    "privéCode": {
      "$ref": "#/components/schemas/Stopplaats.privéCode"
    },
    "transportmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "stopplaatstype": {
      "$ref": "#/components/schemas/Stopplaatstype"
    },
    "toegankelijkheidsbeoordeling": {
      "$ref": "#/components/schemas/Toegankelijkheidsbeoordeling"
    },
    "toegangsmodi": {
      "type": "array",
      "description": "Toegangsmodi waarmee de stopplaats toegankelijk is. Lijst van Toegangsmodus items.",
      "items": {
        "$ref": "#/components/schemas/Toegangsmodus"
      },
      "minItems": 1
    },
    "wegadres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    },
    "centroïDe": {
      "$ref": "#/components/schemas/PuntDatatype"
    },
    "locale": {
      "$ref": "#/components/schemas/Locale"
    },
    "plaatstype": {
      "$ref": "#/components/schemas/Plaatstype"
    },
    "polygoon": {
      "$ref": "#/components/schemas/Polygoon"
    },
    "submodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "andereTransportmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "tariefzone": {
      "type": "array",
      "description": "Tariefzone geassocieerd met de stopplaats. Lijst van Tariefzone items.",
      "items": {
        "$ref": "#/components/schemas/Tariefzone"
      },
      "minItems": 1
    },
    "gewicht": {
      "$ref": "#/components/schemas/Code"
    },
    "stopplaatsgewicht": {
      "$ref": "#/components/schemas/Stopplaatsgewicht"
    },
    "organisatie": {
      "$ref": "#/components/schemas/Operator"
    },
    "verdieping": {
      "type": "array",
      "description": "Verdieping van de stopplaats. Lijst van Verdieping items.",
      "items": {
        "$ref": "#/components/schemas/Verdieping"
      },
      "minItems": 1
    },
    "overdekt": {
      "$ref": "#/components/schemas/Overdekkingstype"
    },
    "omheind": {
      "$ref": "#/components/schemas/Omheiningstype"
    },
    "verlichting": {
      "$ref": "#/components/schemas/Verlichtingstype"
    },
    "postadres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    },
    "parentSite": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Site"
        },
        {
          "$ref": "#/components/schemas/Stopplaats"
        },
        {
          "$ref": "#/components/schemas/PointOfInterest"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Site": "#/components/schemas/Site",
          "Stopplaats": "#/components/schemas/Stopplaats",
          "PointOfInterest": "#/components/schemas/PointOfInterest"
        }
      }
    },
    "gelegenIn": {
      "$ref": "#/components/schemas/Land"
    },
    "geplandeStopplaats": {
      "type": "array",
      "description": "Gepland Stoppunt geassocieerd met de Stopplaats. Lijst van GeplandStoppunt items.",
      "items": {
        "$ref": "#/components/schemas/GeplandStoppunt"
      },
      "minItems": 1
    },
    "omvattend": {
      "type": "array",
      "description": "De perrons in de stopplaats, dat zijn, platforms, steigers, baaien, taxistandplaatsen en andere punten van fysieke toegang tot voertuigen. Lijst van Perron items.",
      "items": {
        "$ref": "#/components/schemas/Perron"
      },
      "minItems": 1
    },
    "binnengekomenVia": {
      "type": "array",
      "description": "Ingang van de stopplaats. Lijst van Stopplaatstoegang items.",
      "items": {
        "$ref": "#/components/schemas/Stopplaatstoegang"
      },
      "minItems": 1
    },
    "bedient": {
      "type": "array",
      "description": "Point of Interest die wordt bediend door de stopplaats. Lijst van PointOfInterest items.",
      "items": {
        "$ref": "#/components/schemas/PointOfInterest"
      },
      "minItems": 1
    },
    "voor": {
      "type": "array",
      "description": "Topografische plaats waarvoor de stopplaats de hoofdterminus is. Lijst van TopografischePlaats items.",
      "items": {
        "$ref": "#/components/schemas/TopografischePlaats"
      },
      "minItems": 1
    },
    "in": {
      "type": "array",
      "description": "Topografische Plaats waarin de Stopplaats zich situeert. Lijst van TopografischePlaats items.",
      "items": {
        "$ref": "#/components/schemas/TopografischePlaats"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "stopplaatstype",
    "gelegenIn"
  ]
}