{
  "title": "Stopplaatstoegang",
  "type": "object",
  "description": "Fysieke toegang of uitgang naar/van een stopplaats voor een passagier.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Stopplaatstoegang)",
      "pattern": "^Stopplaatstoegang$"
    },
    "publiekeCode": {
      "type": "object",
      "description": "Publieke code voor de ingang van de site.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "isToegang": {
      "type": "object",
      "description": "Geeft aan of de ingang kan worden gebruikt voor toegang tot de stopplaats.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isUitgang": {
      "type": "object",
      "description": "Geeft aan of de ingang kan worden gebruikt voor exit van de stopplaats.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "label": {
      "type": "object",
      "description": "Label van de Ingang.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "isExtern": {
      "type": "object",
      "description": "Geeft aan of de ingang van de site extern opent.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "verlaagdeStoeprand": {
      "type": "object",
      "description": "Geeft aan of er een verlaagde stoeprand buiten de ingang van de site is.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "alternatieveNaam": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Alternatieve naam voor de ingang van de site.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "oriëNtatiepunt": {
      "type": "object",
      "description": "Naam van een nabijgelegen oriëntatiepunt.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "kruispunt": {
      "type": "object",
      "description": "Naam van de dichtstbijzijnde dwarsweg of kruising die kan worden gebruikt om de Ingang te lokaliseren. Hoofdzakelijk relevant voor busmodi, waar de dwarsweg de nodige context kan verstrekken om de Stop bij een gebruiker te beschrijven.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "naam": {
      "type": "object",
      "description": "Naam van de Ingang.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "toegangstype": {
      "$ref": "#/components/schemas/Toegangstype"
    },
    "toegankelijkheidsbeoordeling": {
      "$ref": "#/components/schemas/Toegankelijkheidsbeoordeling"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "toegangsmodus": {
      "type": "array",
      "description": "Lijst van Toegangsmodus items.",
      "items": {
        "$ref": "#/components/schemas/Toegangsmodus"
      },
      "minItems": 1
    },
    "overdekt": {
      "$ref": "#/components/schemas/Overdekkingstype"
    },
    "omheind": {
      "$ref": "#/components/schemas/Omheiningstype"
    },
    "verlichting": {
      "$ref": "#/components/schemas/Verlichtingstype"
    },
    "verdieping": {
      "$ref": "#/components/schemas/Verdieping"
    }
  },
  "required": [
    "@type"
  ]
}