{
  "title": "Tariefzone",
  "type": "object",
  "description": "Een zone die wordt gebruikt om een ??zonale tariefstructuur te definiëren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Tariefzone)",
      "pattern": "^Tariefzone$"
    },
    "presentatie": {
      "$ref": "#/components/schemas/Presentatie"
    },
    "lid": {
      "type": "array",
      "description": "Lijst met punten binnen de puntengroep. Lijst van PuntKlasse items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PuntKlasse"
          },
          {
            "$ref": "#/components/schemas/GeplandStoppunt"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "PuntKlasse": "#/components/schemas/PuntKlasse",
            "GeplandStoppunt": "#/components/schemas/GeplandStoppunt"
          }
        }
      },
      "minItems": 1
    },
    "middelpunt": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/PuntKlasse"
        },
        {
          "$ref": "#/components/schemas/GeplandStoppunt"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "PuntKlasse": "#/components/schemas/PuntKlasse",
          "GeplandStoppunt": "#/components/schemas/GeplandStoppunt"
        }
      }
    },
    "veelhoek": {
      "$ref": "#/components/schemas/Polygoon"
    }
  },
  "required": [
    "@type"
  ]
}