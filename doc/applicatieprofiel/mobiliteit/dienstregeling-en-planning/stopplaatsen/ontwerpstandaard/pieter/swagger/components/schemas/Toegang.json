{
  "title": "Toegang",
  "type": "object",
  "description": "Fysieke toegang of uitgang naar/van een site.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Toegang)",
      "pattern": "^Toegang$"
    },
    "publiekeCode": {
      "$ref": "#/components/schemas/Toegang.publiekeCode"
    },
    "isToegang": {
      "$ref": "#/components/schemas/Toegang.isToegang"
    },
    "isUitgang": {
      "$ref": "#/components/schemas/Toegang.isUitgang"
    },
    "label": {
      "$ref": "#/components/schemas/Toegang.label"
    },
    "isExtern": {
      "$ref": "#/components/schemas/Toegang.isExtern"
    },
    "verlaagdeStoeprand": {
      "$ref": "#/components/schemas/Toegang.verlaagdeStoeprand"
    },
    "alternatieveNaam": {
      "type": "array",
      "description": "Alternatieve naam voor de ingang van de site. Lijst van Taalstring items.",
      "items": {
        "$ref": "#/components/schemas/Toegang.alternatieveNaam"
      },
      "minItems": 1
    },
    "oriëNtatiepunt": {
      "$ref": "#/components/schemas/Toegang.oriëNtatiepunt"
    },
    "kruispunt": {
      "$ref": "#/components/schemas/Toegang.kruispunt"
    },
    "naam": {
      "$ref": "#/components/schemas/Toegang.naam"
    },
    "toegangstype": {
      "$ref": "#/components/schemas/Toegangstype"
    },
    "toegankelijkheidsbeoordeling": {
      "$ref": "#/components/schemas/Toegankelijkheidsbeoordeling"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "toegangsmodus": {
      "type": "array",
      "description": "Toegangsmodi van de ingang van de site. Lijst van Toegangsmodus items.",
      "items": {
        "$ref": "#/components/schemas/Toegangsmodus"
      },
      "minItems": 1
    },
    "overdekt": {
      "$ref": "#/components/schemas/Overdekkingstype"
    },
    "omheind": {
      "$ref": "#/components/schemas/Omheiningstype"
    },
    "verlichting": {
      "$ref": "#/components/schemas/Verlichtingstype"
    },
    "verdieping": {
      "$ref": "#/components/schemas/Verdieping"
    }
  },
  "required": [
    "@type"
  ]
}