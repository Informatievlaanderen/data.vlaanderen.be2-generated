{
  "title": "Verdieping",
  "type": "object",
  "description": "Een geïdentificeerde verdieping (gelijkvloers, eerste, kelder, mezzanine, enz.) Binnen een uitwisselingsgebouw of site waarop sitecomponenten verblijven.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Verdieping)",
      "pattern": "^Verdieping$"
    },
    "naam": {
      "type": "object",
      "description": "Naam van de verdieping.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "korteNaam": {
      "type": "object",
      "description": "Korte naam voor de verdieping.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "omschrijving": {
      "type": "object",
      "description": "Beschrijving van de verdieping.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "openbaarGebruik": {
      "type": "object",
      "description": "Geeft aan of de verdieping publiekelijk toegankelijk is.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "publiekeCode": {
      "type": "object",
      "description": "Publieke code van de verdieping.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "rolstoeltoegankelijk": {
      "type": "object",
      "description": "Geeft aan of alle gebieden van de verdieping rolstoeltoegankelijk zijn.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "toegankelijkheid": {
      "$ref": "#/components/schemas/Toegankelijkheidsbeoordeling"
    }
  },
  "required": [
    "@type"
  ]
}