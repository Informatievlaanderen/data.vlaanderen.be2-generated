    shacl:name "eenheid"@nl;
    shacl:path schemas:unitText
  ], [
    a shacl:PropertyShape;
    rdfs:label "standaardEenheid"@nl;
    rdfs:comment "De gestandaardiseerde eenheid waarin de waarde is uitgedrukt."@nl;
