    shacl:description "Transportsubmodus van de rit."@nl;
    shacl:maxCount 1;
    shacl:name "transportsubmodus"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#Journey.transportSubmode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "transportmodus"@nl;
    rdfs:comment "Transportmodus van de rit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#VoertuigRit.Transportmodus>;
