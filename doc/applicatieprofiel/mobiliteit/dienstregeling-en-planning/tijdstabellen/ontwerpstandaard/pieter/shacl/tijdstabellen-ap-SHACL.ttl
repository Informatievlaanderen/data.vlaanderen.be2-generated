<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#GeregistreerdeOrganisatieShape> a shacl:NodeShape;
  rdfs:label "GeregistreerdeOrganisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "In België moeten onder andere volgende organisaties zich registreren: vennootschap (nv,bijvoorbeelda etc),eenmanszaak,overheidsorgaan,stichting… Bij registratie krijgt de organisatie een ondernemingsnummer en worden zijn gegevens ingevoerd in de KBO."@nl;
  rdfs:comment "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een formele organisatie waarbij dit statuut ook op een andere manier verkregen kan zijn."@nl;
  shacl:closed false;
  shacl:property _:df_2_24, [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    <http://purl.org/vocab/vann/usageNote> "In de KBO is dit het ondernemingsnummer."@nl;
    rdfs:comment "Identificator dat de organisatie verkreeg bij registratie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#GeregistreerdeOrganisatie.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator dat de organisatie verkreeg bij registratie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "registratie"@nl;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ];
  shacl:targetClass <http://www.w3.org/ns/regorg#RegisteredOrganization> .

