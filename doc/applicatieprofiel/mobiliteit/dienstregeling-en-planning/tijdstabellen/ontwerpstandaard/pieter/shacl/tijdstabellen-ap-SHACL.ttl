    shacl:description "Aantal dagen na de starttijd van de reis, indien niet dezelfde kalenderdag. Standaard is 0 voor dezelfde dag."@nl;
    shacl:maxCount 1;
    shacl:name "aankomstdagOffset"@nl;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#arrivalDayOffset>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vertrekdagOffset"@nl;
    rdfs:comment "Aantal dagen na de starttijd van de reis, indien niet dezelfde kalenderdag. Standaard is 0 voor dezelfde dag."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#Doorkomsttijd.VertrekdagOffset>;
    shacl:datatype xsd:integer;
    shacl:description "Aantal dagen na de starttijd van de reis, indien niet dezelfde kalenderdag. Standaard is 0 voor dezelfde dag."@nl;
    shacl:maxCount 1;
    shacl:name "vertrekdagOffset"@nl;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#TimeTabledPassingTime.departureDayOffset>
  ], [
