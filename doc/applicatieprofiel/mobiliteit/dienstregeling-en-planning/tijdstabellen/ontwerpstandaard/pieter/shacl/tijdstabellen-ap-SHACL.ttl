    shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#TrainNumber>;
    shacl:description "Verwijzing naar het Treinnummer van het Ritdeel."@nl;
    shacl:maxCount 1;
    shacl:name "treinNummer"@nl;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#trainNumber>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ritdeel"@nl;
    rdfs:comment "Verwijzingen naar een Ritdeel van de Rit waar het Ritdeel aan aansluit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#Ritdeelpaar.Ritdeel>;
    shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#JourneyPart>;
