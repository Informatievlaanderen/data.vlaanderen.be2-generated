    shacl:maxCount 1;
    shacl:name "aankomsttijd"@nl;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#arrivalTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vertrektijd"@nl;
