    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#Ritdeelpaar.VanStopPoint>;
    shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#ScheduledStopPoint>;
    shacl:description "Verwijzing naar het GeplandStoppunt waar de Ritdeelpaar vertrekt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "vanStopPoint"@nl;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#fromStopPont>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naarStopPunt"@nl;
    rdfs:comment "Verwijzing naar het GeplandStoppunt waar de Ritdeelpaar eindigt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#Ritdeelpaar.NaarStopPunt>;
    shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#ScheduledStopPoint>;
    shacl:description "Verwijzing naar het GeplandStoppunt waar de Ritdeelpaar eindigt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naarStopPunt"@nl;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#toStopPoint>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hoofdDeel"@nl;
    rdfs:comment "Verwijzing naar de RitdeelPaar van de hoofdrit van een Ritdeelpaar."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#Ritdeelpaar.HoofdDeel>;
    shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#JourneyPartCouple>;
