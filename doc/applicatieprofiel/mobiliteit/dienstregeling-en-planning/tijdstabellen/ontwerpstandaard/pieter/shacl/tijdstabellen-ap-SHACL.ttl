<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#AccommodatieShape> a shacl:NodeShape;
  rdfs:label "Accommodatie"@nl;
  rdfs:comment "Kenmerken van de accommodatie die beschikbaar is op een dienst."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "tariefKlasse"@nl;
    rdfs:comment "Tariefklasse van de accommodatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#Accommodatie.TariefKlasse>;
    shacl:description "Tariefklasse van de accommodatie."@nl;
    shacl:maxCount 1;
    shacl:name "tariefKlasse"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#fareClass>
  ], [
    a shacl:PropertyShape;
    rdfs:label "accommodatieFaciliteit"@nl;
    rdfs:comment "Type van accommodatie."@nl;
