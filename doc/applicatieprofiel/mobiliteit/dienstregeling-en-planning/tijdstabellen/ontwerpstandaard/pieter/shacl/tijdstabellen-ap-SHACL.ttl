<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#UicOperationelePeriodeShape> a shacl:NodeShape;
  rdfs:label "UicOperationelePeriode"@nl;
  rdfs:comment "Een alternatieve geoptimaliseerde weergave van een operationele periode die een reeks bits gebruikt om aan te geven aan welke dagen met de periode een specifiek daytype van toepassing is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geldigeDagbits"@nl;
    <http://purl.org/vocab/vann/usageNote> "Normaal gesproken is er een beetje voor elke dag tussen start- en einddatum. Als bit ontbreekt, neem dan aan beschikbaar."@nl;
    rdfs:comment "String of bits (gebouwd van \"0\" en \"1\"), één voor elke dag in de periode: al dan niet geldig of niet geldig op de dag."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#UicOperationelePeriode.GeldigeDagbits>;
    shacl:datatype xsd:string;
    shacl:description "String of bits (gebouwd van \"0\" en \"1\"), één voor elke dag in de periode: al dan niet geldig of niet geldig op de dag."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "geldigeDagbits"@nl;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#validDayBits>
  ], [
    a shacl:PropertyShape;
    rdfs:label "dagenVanDeWeek"@nl;
    rdfs:comment "Dagen van de week waaraan de (tot de eerste zeven) bits corresponderen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#UicOperationelePeriode.DagenVanDeWeek>;
    shacl:datatype xsd:string;
    shacl:description "Dagen van de week waaraan de (tot de eerste zeven) bits corresponderen."@nl;
    shacl:maxCount 1;
    shacl:name "dagenVanDeWeek"@nl;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#daysOfWeek>
  ];
  shacl:targetClass <https://purl.eu/ns/mobility/timetables-and-planning#UicOperatingPeriod> .

