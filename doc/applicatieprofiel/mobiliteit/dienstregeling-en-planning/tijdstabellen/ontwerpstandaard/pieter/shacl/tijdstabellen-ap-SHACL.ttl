    shacl:datatype xsd:time;
    shacl:description "Vertrektijd op punt in patroon."@nl;
    shacl:maxCount 1;
    shacl:name "vertrektijd"@nl;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#TimeTabledPassingTime.departureTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aankomstdagOffset"@nl;
    rdfs:comment "Aantal dagen na de starttijd van de reis, indien niet dezelfde kalenderdag. Standaard is 0 voor dezelfde dag."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#Doorkomsttijd.AankomstdagOffset>;
