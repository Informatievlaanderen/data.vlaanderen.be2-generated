<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#KwantitatieveWaardeShape> a shacl:NodeShape;
  rdfs:label "KwantitatieveWaarde"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de hoogte van een object,het gewicht,de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog,laag en dergelijke vallen hier dus niet onder."@nl;
  rdfs:comment "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "eenheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "To be used if no standard unit is known."@nl;
    rdfs:comment "De eenheid waarin de waarde is uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/dienstregeling-en-planning/tijdstabellen/ontwerpstandaard/pieter#KwantitatieveWaarde.Eenheid>;
