{
  "title": "Accommodatie",
  "type": "object",
  "description": "Kenmerken van de accommodatie die beschikbaar is op een dienst.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Accommodatie)",
      "pattern": "^Accommodatie$"
    },
    "tariefKlasse": {
      "$ref": "#/components/schemas/Tariefklasse"
    },
    "accommodatieFaciliteit": {
      "$ref": "#/components/schemas/AccommodatieFaciliteitType"
    },
    "overlastFaciliteit": {
      "$ref": "#/components/schemas/OverlastFaciliteittype"
    },
    "passagierCommFaciliteit": {
      "type": "array",
      "description": "Communicatiefaciliteiten binnen de Accommodatie. Lijst van PassagierCommunicatieFaciliteittype items.",
      "items": {
        "$ref": "#/components/schemas/PassagierCommunicatieFaciliteittype"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}