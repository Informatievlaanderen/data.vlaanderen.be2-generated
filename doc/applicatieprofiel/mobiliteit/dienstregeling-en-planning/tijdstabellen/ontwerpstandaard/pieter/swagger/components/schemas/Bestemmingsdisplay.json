{
  "title": "Bestemmingsdisplay",
  "type": "object",
  "description": "Een geadverteerde bestemming van een specifieke lijn of ritpatroon, meestal weergegeven op een kopteken of op andere locaties aan boord.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Bestemmingsdisplay)",
      "pattern": "^Bestemmingsdisplay$"
    },
    "tekstZijkant": {
      "type": "object",
      "description": "Tekst die wordt weergegeven aan de zijkant van het voertuig dat is gekoppeld aan het bestemmingsdisplay.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "tekstVoorzijde": {
      "type": "object",
      "description": "Voorkant van voertuigtekst gekoppeld aan het bestemmingsdisplay.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "publiekeCode": {
      "type": "object",
      "description": "Publieke code (die aan het publiek moeten worden gepresenteerd) geassocieerd met het bestemmingsdisplay.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "via": {
      "type": "array",
      "description": "Lijst van Via items.",
      "items": {
        "$ref": "#/components/schemas/Via"
      },
      "minItems": 1
    },
    "variant": {
      "type": "array",
      "description": "Lijst van BestemmingsdisplayVariant items.",
      "items": {
        "$ref": "#/components/schemas/BestemmingsdisplayVariant"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}