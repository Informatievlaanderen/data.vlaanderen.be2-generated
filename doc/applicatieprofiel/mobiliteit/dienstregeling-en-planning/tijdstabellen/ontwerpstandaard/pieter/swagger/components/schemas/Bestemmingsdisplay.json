{
  "title": "Bestemmingsdisplay",
  "type": "object",
  "description": "Een geadverteerde bestemming van een specifieke lijn of ritpatroon, meestal weergegeven op een kopteken of op andere locaties aan boord.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Bestemmingsdisplay)",
      "pattern": "^Bestemmingsdisplay$"
    },
    "tekstZijkant": {
      "$ref": "#/components/schemas/Bestemmingsdisplay.tekstZijkant"
    },
    "tekstVoorzijde": {
      "$ref": "#/components/schemas/Bestemmingsdisplay.tekstVoorzijde"
    },
    "publiekeCode": {
      "$ref": "#/components/schemas/Bestemmingsdisplay.publiekeCode"
    },
    "via": {
      "type": "array",
      "description": "Tekst om weer te geven voor het Via display. Lijst van Via items.",
      "items": {
        "$ref": "#/components/schemas/Via"
      },
      "minItems": 1
    },
    "variant": {
      "type": "array",
      "description": "Variant van het bestemmingsdisplay. Lijst van BestemmingsdisplayVariant items.",
      "items": {
        "$ref": "#/components/schemas/BestemmingsdisplayVariant"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}