{
  "title": "BestemmingsdisplayVariant",
  "type": "object",
  "description": "Variant van een bepaald bestemmingsdisplay, zoals nodig is voor verschillende mediakanalen (elektronische, afgedrukte, audio, mobiele app, enz.).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse BestemmingsdisplayVariant)",
      "pattern": "^BestemmingsdisplayVariant$"
    },
    "tekstZijkant": {
      "type": "object",
      "description": "Tekst om weer te geven aan de zijkant van het voertuig dat is gekoppeld aan de variant Destination Display.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "tekstVoorzijde": {
      "type": "object",
      "description": "Voorkant van voertuigtekst geassocieerd met de variant van de bestemmingsdisplay.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "bestemmingsdisplayVarianttype": {
      "$ref": "#/components/schemas/BestemmingsdisplayvariantType"
    },
    "via": {
      "type": "array",
      "description": "Lijst van Via items.",
      "items": {
        "$ref": "#/components/schemas/Via"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "bestemmingsdisplayVarianttype"
  ]
}