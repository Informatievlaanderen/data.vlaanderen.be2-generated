{
  "title": "Dienstkalender",
  "type": "object",
  "description": "Verzameling van dagtype-toewijzingen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Dienstkalender)",
      "pattern": "^Dienstkalender$"
    },
    "vanDatum": {
      "$ref": "#/components/schemas/Dienstkalender.vanDatum"
    },
    "totDatum": {
      "$ref": "#/components/schemas/Dienstkalender.totDatum"
    },
    "naam": {
      "$ref": "#/components/schemas/Dienstkalender.naam"
    },
    "gespecificeerdDoor": {
      "type": "array",
      "description": "Dagtypetoewijzing dat het Dagtype specificieert. Lijst van Dagtype items.",
      "items": {
        "$ref": "#/components/schemas/Dagtype"
      },
      "minItems": 1
    },
    "binnen": {
      "type": "array",
      "description": "Operationele periode waarbinnen de operationele kalender zich bevindt. Lijst van OperationelePeriode items.",
      "items": {
        "$ref": "#/components/schemas/UicOperationelePeriode"
      },
      "minItems": 1
    },
    "operationeleDag": {
      "type": "array",
      "description": "Bedrijfsdag in de operationele kalender. Lijst van OperationeleDag items.",
      "items": {
        "$ref": "#/components/schemas/OperationeleDag"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}