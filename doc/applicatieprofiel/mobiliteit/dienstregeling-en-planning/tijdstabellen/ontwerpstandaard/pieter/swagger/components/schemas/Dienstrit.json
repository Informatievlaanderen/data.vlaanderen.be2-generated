{
  "title": "Dienstrit",
  "type": "object",
  "description": "Een Dienstrit is een Rit waarop het passagiers toegelaten is om aan Stopplaatsen op of af te stappen van voertuigen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Dienstrit)",
      "pattern": "^Dienstrit$"
    },
    "vertrektijd": {
      "$ref": "#/components/schemas/Dienstrit.vertrektijd"
    },
    "vertrekdagOffset": {
      "$ref": "#/components/schemas/Dienstrit.vertrekdagOffset"
    },
    "ritduur": {
      "$ref": "#/components/schemas/Dienstrit.ritduur"
    },
    "operator": {
      "$ref": "#/components/schemas/Operator"
    },
    "dagtype": {
      "type": "array",
      "description": "Dagtype voor de Diensrit. Lijst van Dagtype items.",
      "items": {
        "$ref": "#/components/schemas/Dagtype"
      },
      "minItems": 1
    },
    "voertuigtype": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Voertuigtype"
        },
        {
          "$ref": "#/components/schemas/Trein"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Voertuigtype": "#/components/schemas/Voertuigtype",
          "Trein": "#/components/schemas/Trein"
        }
      }
    },
    "treinnummer": {
      "type": "array",
      "description": "Treinnummers - afgeleid door middel van ritdelen van een rit - alleen voor een multi-part-ritten. Lijst van Treinnummer items.",
      "items": {
        "$ref": "#/components/schemas/Treinnummer"
      },
      "minItems": 1
    },
    "faciliteit": {
      "type": "array",
      "description": "Faciliteit op de dienstrit. Lijst van DienstFaciliteitenset items.",
      "items": {
        "$ref": "#/components/schemas/DienstFaciliteitenset"
      },
      "minItems": 1
    },
    "treingrootte": {
      "$ref": "#/components/schemas/Treingrootte"
    },
    "gemaaktMet": {
      "$ref": "#/components/schemas/Dienstritpatroon"
    },
    "uitgevoerdOp": {
      "type": "array",
      "description": "Dagtype waarop de rit wordt gewerkt. Lijst van Dagtype items.",
      "items": {
        "$ref": "#/components/schemas/Dagtype"
      },
      "minItems": 1
    },
    "transportsubmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "transportmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "opmerking": {
      "type": "array",
      "description": "Kennisgeving relevant voor de hele rit. Lijst van Opmerking items.",
      "items": {
        "$ref": "#/components/schemas/Opmerking"
      },
      "minItems": 1
    },
    "passeerdeOp": {
      "type": "array",
      "description": "Doorkomsstijd waarop de rit passeert. Lijst van Doorkomsttijd items.",
      "items": {
        "$ref": "#/components/schemas/Doorkomsttijd"
      },
      "minItems": 1
    },
    "deel": {
      "type": "array",
      "description": "Deel van de rit. Lijst van Ritdeel items.",
      "items": {
        "$ref": "#/components/schemas/Ritdeel"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "gemaaktMet",
    "uitgevoerdOp"
  ]
}