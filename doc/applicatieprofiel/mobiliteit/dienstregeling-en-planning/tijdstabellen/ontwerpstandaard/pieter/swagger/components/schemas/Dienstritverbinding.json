    },
    "vertrektijd": {
      "$ref": "#/components/schemas/Dienstritverbinding.vertrektijd"
    },
    "omAfTeStappen": {
      "$ref": "#/components/schemas/Dienstritverbinding.omAfTeStappen"
    },
    "omOpTeStappen": {
      "$ref": "#/components/schemas/Dienstritverbinding.omOpTeStappen"
    },
    "aankomstStopplaats": {
      "$ref": "#/components/schemas/GeplandStoppunt"
    },
    "vertrekStopplaats": {
      "$ref": "#/components/schemas/GeplandStoppunt"
    },
    "lijn": {
      "$ref": "#/components/schemas/Lijn"
    }
  },
  "required": [
    "@type",
    "aankomsttijd",
    "vertrektijd",
    "omAfTeStappen",
    "omOpTeStappen",
    "aankomstStopplaats",
