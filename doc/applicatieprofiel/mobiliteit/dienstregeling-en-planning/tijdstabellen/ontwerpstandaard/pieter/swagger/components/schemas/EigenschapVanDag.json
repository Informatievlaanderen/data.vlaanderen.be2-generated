{
  "title": "EigenschapVanDag",
  "type": "object",
  "description": "Een eigenschap die een dag kan bezitten, zoals schoolvakantie, weekdag, zomer, winter etc.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse EigenschapVanDag)",
      "pattern": "^EigenschapVanDag$"
    },
    "naam": {
      "$ref": "#/components/schemas/EigenschapVanDag.naam"
    },
    "omschrijving": {
      "$ref": "#/components/schemas/EigenschapVanDag.omschrijving"
    },
    "maandVanHetJaar": {
      "$ref": "#/components/schemas/Month"
    },
    "dagVanDeMaand": {
      "$ref": "#/components/schemas/Day"
    },
    "dagVanHetJaar": {
      "$ref": "#/components/schemas/MonthDay"
    },
    "land": {
      "type": "array",
      "description": "Land van vakantietype. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/EigenschapVanDag.land"
      },
      "minItems": 1
    },
    "dagVanDeWeek": {
      "type": "array",
      "description": "De dag van de week, bijvoorbeeld. zondag. Lijst van DagVanDeWeek items.",
      "items": {
        "$ref": "#/components/schemas/DagVanDeWeek"
      },
      "minItems": 1,
      "maxItems": 7
    },
    "vakantietype": {
      "type": "array",
      "description": "Het type vakantie, bijvoorbeeld. Kerstmis. Lijst van Vakantietype items.",
      "items": {
        "$ref": "#/components/schemas/Vakantietype"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "seizoen": {
      "type": "array",
      "description": "Het seizoen, bijvoorbeeld. winter. Lijst van Seizoen items.",
      "items": {
        "$ref": "#/components/schemas/Seizoen"
      },
      "minItems": 1,
      "maxItems": 4
    },
    "weekVanDeMaand": {
      "type": "array",
      "description": "Weeknummer van de maand (1-5). Lijst van WeekVanDeMaand items.",
      "items": {
        "$ref": "#/components/schemas/WeekVanDeMaand"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "drukte": {
      "$ref": "#/components/schemas/Drukte"
    },
    "beschrijft": {
      "type": "array",
      "description": "Dagtype die de Eigenschap van de Dag beschrijft. Lijst van Dagtype items.",
      "items": {
        "$ref": "#/components/schemas/Dagtype"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "omschrijving"
  ]
}