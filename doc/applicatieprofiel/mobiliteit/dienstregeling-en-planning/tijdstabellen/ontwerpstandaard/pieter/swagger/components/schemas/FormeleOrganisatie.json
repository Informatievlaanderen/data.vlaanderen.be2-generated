{
  "title": "FormeleOrganisatie",
  "type": "object",
  "description": "Een erkende organisatie, erkend in brede zin of meer specifiek in juridische zin met bijbehorende rechten en plichten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse FormeleOrganisatie)",
      "pattern": "^FormeleOrganisatie$"
    },
    "voorkeursnaam": {
      "type": "object",
      "description": "Naam waarmee de organisatie bij voorkeur wordt aangeduid.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "alternatieveNaam": {
      "type": "array",
      "description": "Lijst van Taalstring items.",
      "items": {
        "type": "object",
        "description": "Andere naam waaronder de organisatie bekend is. Bijvoorbeeld commerciële naam, informele naam….",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "beschrijving": {
      "type": "object",
      "description": "Beschrijving van de organisatie.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "contactinfo": {
      "type": "array",
      "description": "Lijst van Contactinfo items.",
      "items": {
        "$ref": "#/components/schemas/Contactinfo"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "voorkeursnaam"
  ]
}