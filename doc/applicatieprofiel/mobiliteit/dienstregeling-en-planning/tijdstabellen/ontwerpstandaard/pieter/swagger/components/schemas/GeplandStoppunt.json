{
  "title": "GeplandStoppunt",
  "type": "object",
  "description": "Een Punt waar passagiers kunnen op- of afstappen van voertuigen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GeplandStoppunt)",
      "pattern": "^GeplandStoppunt$"
    },
    "naam": {
      "type": "object",
      "description": "Naam van het punt.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "korteNaam": {
      "type": "object",
      "description": "Korte naam van het geplande stoppunt.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "omschrijving": {
      "type": "object",
      "description": "Beschrijving van het geplande stoppunt.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "publiekeCode": {
      "type": "object",
      "description": "Publieke code van het geplande stoppunt.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "privéCode": {
      "type": "object",
      "description": "Alternatieve identificatie van het geplande stoppunt.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "locatie": {
      "$ref": "#/components/schemas/PuntDatatype"
    },
    "stoptype": {
      "$ref": "#/components/schemas/Stopplaatstype"
    },
    "tariefzone": {
      "type": "array",
      "description": "Lijst van Tariefzone items.",
      "items": {
        "$ref": "#/components/schemas/Tariefzone"
      },
      "minItems": 1
    },
    "presentatie": {
      "$ref": "#/components/schemas/Presentatie"
    },
    "tijdspuntstype": {
      "$ref": "#/components/schemas/Tijdspuntstatus"
    },
    "startVan": {
      "type": "array",
      "description": "Lijst van Dienstverbinding items.",
      "items": {
        "$ref": "#/components/schemas/Dienstverbinding"
      },
      "minItems": 1
    },
    "eindeVan": {
      "type": "array",
      "description": "Lijst van Dienstverbinding items.",
      "items": {
        "$ref": "#/components/schemas/Dienstverbinding"
      },
      "minItems": 1
    },
    "gezienAls": {
      "type": "array",
      "description": "Lijst van PuntInRitpatroon items.",
      "items": {
        "$ref": "#/components/schemas/PuntInRitpatroon"
      },
      "minItems": 1
    },
    "puntnummer": {
      "type": "object",
      "description": "Arbitraire alternatieve identifier voor het punt.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    }
  },
  "required": [
    "@type",
    "naam",
    "locatie"
  ]
}