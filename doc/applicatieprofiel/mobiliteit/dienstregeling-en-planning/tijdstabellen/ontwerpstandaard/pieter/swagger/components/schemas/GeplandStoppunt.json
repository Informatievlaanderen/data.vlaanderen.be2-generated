{
  "title": "GeplandStoppunt",
  "type": "object",
  "description": "Een Punt waar passagiers kunnen op- of afstappen van voertuigen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GeplandStoppunt)",
      "pattern": "^GeplandStoppunt$"
    },
    "naam": {
      "$ref": "#/components/schemas/GeplandStoppunt.naam"
    },
    "korteNaam": {
      "$ref": "#/components/schemas/GeplandStoppunt.korteNaam"
    },
    "omschrijving": {
      "$ref": "#/components/schemas/GeplandStoppunt.omschrijving"
    },
    "publiekeCode": {
      "$ref": "#/components/schemas/GeplandStoppunt.publiekeCode"
    },
    "privéCode": {
      "$ref": "#/components/schemas/GeplandStoppunt.privéCode"
    },
    "locatie": {
      "$ref": "#/components/schemas/PuntDatatype"
    },
    "stoptype": {
      "$ref": "#/components/schemas/Stopplaatstype"
    },
    "tariefzone": {
      "type": "array",
      "description": "Tariefzones waartoe het geplande stoppunt behoort. Lijst van Tariefzone items.",
      "items": {
        "$ref": "#/components/schemas/Tariefzone"
      },
      "minItems": 1
    },
    "presentatie": {
      "$ref": "#/components/schemas/Presentatie"
    },
    "tijdspuntstype": {
      "$ref": "#/components/schemas/Tijdspuntstatus"
    },
    "startVan": {
      "type": "array",
      "description": "Dienstverbinding waarvan het stoppunt van het schema het begin is. Lijst van Dienstverbinding items.",
      "items": {
        "$ref": "#/components/schemas/Dienstverbinding"
      },
      "minItems": 1
    },
    "eindeVan": {
      "type": "array",
      "description": "Dienstverbinding waarvan het stoppunt van het schema het einde is. Lijst van Dienstverbinding items.",
      "items": {
        "$ref": "#/components/schemas/Dienstverbinding"
      },
      "minItems": 1
    },
    "gezienAls": {
      "type": "array",
      "description": "Zoals gebruikt als een punt in een ritpatroon. Lijst van PuntInRitpatroon items.",
      "items": {
        "$ref": "#/components/schemas/PuntInRitpatroon"
      },
      "minItems": 1
    },
    "puntnummer": {
      "$ref": "#/components/schemas/GeplandStoppunt.puntnummer"
    }
  },
  "required": [
    "@type",
    "naam",
    "locatie"
  ]
}