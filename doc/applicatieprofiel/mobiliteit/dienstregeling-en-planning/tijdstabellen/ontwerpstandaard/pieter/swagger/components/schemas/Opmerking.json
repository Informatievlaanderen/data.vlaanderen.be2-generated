{
  "title": "Opmerking",
  "type": "object",
  "description": "De toewijzing van een kennisgeving aan een entiteit.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Opmerking)",
      "pattern": "^Opmerking$"
    },
    "kennisgeving": {
      "$ref": "#/components/schemas/Kennisgeving"
    },
    "startPuntInPatroon": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/PuntInLijnsequentie"
        },
        {
          "$ref": "#/components/schemas/PuntInRitpatroon"
        },
        {
          "$ref": "#/components/schemas/PuntOpRoute"
        },
        {
          "$ref": "#/components/schemas/StopplaatsInRitpatroon"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "PuntInLijnsequentie": "#/components/schemas/PuntInLijnsequentie",
          "PuntInRitpatroon": "#/components/schemas/PuntInRitpatroon",
          "PuntOpRoute": "#/components/schemas/PuntOpRoute",
          "StopplaatsInRitpatroon": "#/components/schemas/StopplaatsInRitpatroon"
        }
      }
    },
    "eindPuntInSequentie": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/PuntInLijnsequentie"
        },
        {
          "$ref": "#/components/schemas/PuntInRitpatroon"
        },
        {
          "$ref": "#/components/schemas/PuntOpRoute"
        },
        {
          "$ref": "#/components/schemas/StopplaatsInRitpatroon"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "PuntInLijnsequentie": "#/components/schemas/PuntInLijnsequentie",
          "PuntInRitpatroon": "#/components/schemas/PuntInRitpatroon",
          "PuntOpRoute": "#/components/schemas/PuntOpRoute",
          "StopplaatsInRitpatroon": "#/components/schemas/StopplaatsInRitpatroon"
        }
      }
    }
  },
  "required": [
    "@type"
  ]
}