{
  "title": "Presentatie",
  "type": "object",
  "description": "Bepaalt een uniforme reeks waarden om de verschijningen van een element te controleren (op een kaart, een schematische kaart, een papier- of schermbeschrijving, enz.).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Presentatie)",
      "pattern": "^Presentatie$"
    },
    "infoLink": {
      "type": "array",
      "description": "URL van een afbeelding die aan de entiteit is gekoppeld. Lijst van URI items.",
      "items": {
        "$ref": "#/components/schemas/Presentatie.infoLink"
      },
      "minItems": 1
    },
    "kleur": {
      "$ref": "#/components/schemas/Kleurtype"
    },
    "achtergrondKleur": {
      "$ref": "#/components/schemas/Kleurtype"
    },
    "tekstKleur": {
      "$ref": "#/components/schemas/Kleurtype"
    },
    "tekstLettertype": {
      "$ref": "#/components/schemas/Tekstlettertype"
    }
  },
  "required": [
    "@type"
  ]
}