{
  "title": "PuntInRitpatroon",
  "type": "object",
  "description": "Elk Punt in Ritpatroon specifieert het bezoek van een Dienst aan een specifiek Punt met een bepaalde volgorde binnen het patroon.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse PuntInRitpatroon)",
      "pattern": "^PuntInRitpatroon$"
    },
    "volgorde": {
      "$ref": "#/components/schemas/PuntInRitpatroon.volgorde"
    },
    "veranderingVanBestemmingsdisplay": {
      "$ref": "#/components/schemas/PuntInRitpatroon.veranderingVanBestemmingsdisplay"
    },
    "omschrijving": {
      "$ref": "#/components/schemas/PuntInRitpatroon.omschrijving"
    },
    "bestemmingsdisplay": {
      "$ref": "#/components/schemas/Bestemmingsdisplay"
    },
    "bij": {
      "type": "array",
      "description": "Doorkomsttijd op het punt in de ritpatroon. Lijst van Doorkomsttijd items.",
      "items": {
        "$ref": "#/components/schemas/Doorkomsttijd"
      },
      "minItems": 1
    },
    "eenViewVan": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/GeplandStoppunt"
        },
        {
          "$ref": "#/components/schemas/Routepunt"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "GeplandStoppunt": "#/components/schemas/GeplandStoppunt",
          "Routepunt": "#/components/schemas/Routepunt"
        }
      }
    }
  },
  "required": [
    "@type",
    "volgorde",
    "veranderingVanBestemmingsdisplay",
    "eenViewVan"
  ]
}