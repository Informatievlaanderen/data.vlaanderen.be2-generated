{
  "title": "Ritdeel",
  "type": "object",
  "description": "Een deel van een voertuigrit gecreëerd volgens een specifiek functioneel doel, bijvoorbeeld in situaties wanneer het koppelen of scheiden van het voertuig optreedt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Ritdeel)",
      "pattern": "^Ritdeel$"
    },
    "beschrijving": {
      "$ref": "#/components/schemas/Ritdeel.beschrijving"
    },
    "startTijd": {
      "$ref": "#/components/schemas/Ritdeel.startTijd"
    },
    "startTijdDagOffset": {
      "$ref": "#/components/schemas/Ritdeel.startTijdDagOffset"
    },
    "eindTijd": {
      "$ref": "#/components/schemas/Ritdeel.eindTijd"
    },
    "eindTijdDagOffset": {
      "$ref": "#/components/schemas/Ritdeel.eindTijdDagOffset"
    },
    "treinNummer": {
      "$ref": "#/components/schemas/Treinnummer"
    },
    "vanStopPoint": {
      "$ref": "#/components/schemas/GeplandStoppunt"
    },
    "naarStopPunt": {
      "$ref": "#/components/schemas/GeplandStoppunt"
    },
    "faciliteit": {
      "type": "array",
      "description": "Faciliteit beschikbaar tijdens het Ritdeel. Lijst van DienstFaciliteitenset items.",
      "items": {
        "$ref": "#/components/schemas/DienstFaciliteitenset"
      },
      "minItems": 1
    },
    "ritdeelPositie": {
      "type": "array",
      "description": "Positie in de Trein van het Ritdeel. Lijst van RitdeelPositie items.",
      "items": {
        "$ref": "#/components/schemas/RitdeelPositie"
      },
      "minItems": 1
    },
    "hoofDeel": {
      "$ref": "#/components/schemas/Ritdeelpaar"
    },
    "ritdeelpaar": {
      "$ref": "#/components/schemas/Ritdeelpaar"
    }
  },
  "required": [
    "@type",
    "startTijd",
    "eindTijd"
  ]
}