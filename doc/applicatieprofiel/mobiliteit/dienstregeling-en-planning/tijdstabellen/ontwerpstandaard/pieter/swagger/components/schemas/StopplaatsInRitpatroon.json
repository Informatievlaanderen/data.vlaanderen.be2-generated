    },
    "omInTeStappen": {
      "$ref": "#/components/schemas/StopplaatsInRitpatroon.omInTeStappen"
    },
    "omUitTeStappen": {
      "$ref": "#/components/schemas/StopplaatsInRitpatroon.omUitTeStappen"
    },
    "veranderingVanBestemmingsdisplay": {
      "$ref": "#/components/schemas/StopplaatsInRitpatroon.veranderingVanBestemmingsdisplay"
    },
    "stopaanvraag": {
      "$ref": "#/components/schemas/StopplaatsInRitpatroon.stopaanvraag"
    },
    "volgendeDienstverbinding": {
      "$ref": "#/components/schemas/Dienstverbinding"
    },
    "bestemmingsdisplay": {
      "$ref": "#/components/schemas/Bestemmingsdisplay"
    },
    "aanvraagmethode": {
      "$ref": "#/components/schemas/Aanvraagmethode"
