{
  "title": "UicOperationelePeriode",
  "type": "object",
  "description": "Een alternatieve geoptimaliseerde weergave van een operationele periode die een reeks bits gebruikt om aan te geven aan welke dagen met de periode een specifiek daytype van toepassing is.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse UicOperationelePeriode)",
      "pattern": "^UicOperationelePeriode$"
    },
    "geldigeDagbits": {
      "type": "object",
      "description": "String of bits (gebouwd van \"0\" en \"1\"), één voor elke dag in de periode: al dan niet geldig of niet geldig op de dag. Normaal gesproken is er een beetje voor elke dag tussen start- en einddatum. Als bit ontbreekt, neem dan aan beschikbaar.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "dagenVanDeWeek": {
      "type": "object",
      "description": "Dagen van de week waaraan de (tot de eerste zeven) bits corresponderen.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "naam": {
      "type": "object",
      "description": "Naam van de operationele periode.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "vanDatum": {
      "type": "object",
      "description": "Start operationele dag (inclusief).",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "totDatum": {
      "type": "object",
      "description": "Einde operationele dag (inclusief).",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    }
  },
  "required": [
    "@type",
    "geldigeDagbits",
    "vanDatum",
    "totDatum"
  ]
}