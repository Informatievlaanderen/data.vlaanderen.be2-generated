{
  "title": "Via",
  "type": "object",
  "description": "Een optioneel onderdeel van een bestemmingsdisplay dat verschillende mogelijke paden onderscheidt tussen een oorsprong en een bestemming.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Via)",
      "pattern": "^Via$"
    },
    "naam": {
      "type": "object",
      "description": "Naam van de VIA.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    }
  },
  "required": [
    "@type",
    "naam"
  ]
}