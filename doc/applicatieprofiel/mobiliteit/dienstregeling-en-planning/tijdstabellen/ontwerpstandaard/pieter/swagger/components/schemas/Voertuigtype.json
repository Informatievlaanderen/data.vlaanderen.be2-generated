{
  "title": "Voertuigtype",
  "type": "object",
  "description": "Voertuigen kunnen worden geclassificeerd met behulp van een voertuigtype volgens hoe zij voldoen aan de vereisten van voertuigplanning m.b.t. de capaciteit en het aan boord hebben van faciliteiten (bijvoorbeeld standaardbus, dubbeldek, enz.).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Voertuigtype)",
      "pattern": "^Voertuigtype$"
    },
    "naam": {
      "type": "object",
      "description": "Naam van het type voertuig.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "omschrijving": {
      "type": "object",
      "description": "Beschrijving van het type voertuig.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "zelfvoortstuwend": {
      "type": "object",
      "description": "Geeft aan of het type voertuig zelf wordt voortgestuwd.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "euroKlasse": {
      "type": "object",
      "description": "Euro-klasse van het voertuigtype.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "lageVloer": {
      "type": "object",
      "description": "Geeft aan of het type voertuig een lage vloer is.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "heeftLiftOfRamp": {
      "type": "object",
      "description": "Geeft aan of het type voertuig een lift of oprit heeft voor rolstoeltoegang.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "typeBrandstof": {
      "$ref": "#/components/schemas/TypeBrandstof"
    },
    "capaciteit": {
      "type": "array",
      "description": "Lijst van Passagierscapaciteit items.",
      "items": {
        "$ref": "#/components/schemas/Passagierscapaciteit"
      },
      "minItems": 1
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "gewicht": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    }
  },
  "required": [
    "@type"
  ]
}