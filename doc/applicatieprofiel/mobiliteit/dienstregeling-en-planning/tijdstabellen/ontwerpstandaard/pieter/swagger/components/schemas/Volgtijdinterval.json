{
  "title": "Volgtijdinterval",
  "type": "object",
  "description": "Een tijdsinterval of een duur die een voortgangsperiode definieert en het karakteriseren van de hiatus ritgroepen (bijvoorbeeld elke 10 minuten, elke 4-6 min).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Volgtijdinterval)",
      "pattern": "^Volgtijdinterval$"
    },
    "geplandVolgtijdinterval": {
      "type": "object",
      "description": "Geplande volgtijdinterval.",
      "properties": {
        "$ref": "#/components/schemas/Duration"
      },
      "required": [
        "$ref"
      ]
    },
    "minimaalVolgtijdinterval": {
      "type": "object",
      "description": "Minimaal volgtijdinterval.",
      "properties": {
        "$ref": "#/components/schemas/Duration"
      },
      "required": [
        "$ref"
      ]
    },
    "maximaalVolgtijdinterval": {
      "type": "object",
      "description": "Maximaal volgtijdinterval.",
      "properties": {
        "$ref": "#/components/schemas/Duration"
      },
      "required": [
        "$ref"
      ]
    }
  },
  "required": [
    "@type"
  ]
}