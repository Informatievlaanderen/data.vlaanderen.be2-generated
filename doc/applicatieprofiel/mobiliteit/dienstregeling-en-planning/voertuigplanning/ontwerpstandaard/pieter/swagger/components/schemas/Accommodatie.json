{
  "title": "Accommodatie",
  "type": "object",
  "description": "Kenmerken van de accommodatie die beschikbaar is op een dienst.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Accommodatie)",
      "pattern": "^Accommodatie$"
    },
    "tariefklasse": {
      "$ref": "#/components/schemas/Tariefklasse"
    },
    "accommodatiefaciliteit": {
      "$ref": "#/components/schemas/Accommodatiefaciliteitstype"
    },
    "overlastfaciliteit": {
      "$ref": "#/components/schemas/Overlastfaciliteitstype"
    },
    "passagierCommfaciliteit": {
      "type": "array",
      "description": "Communicatiefaciliteiten binnen de Accommodatie. Lijst van PassagierCommfaciliteitstype items.",
      "items": {
        "$ref": "#/components/schemas/PassagierCommfaciliteitstype"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}