{
  "title": "Adresvoorstelling",
  "type": "object",
  "description": "Beter leesbare weergave van een gestructureerd adres met alleen de basis- of gecombineerde gegevens, bedoeld voor het gebruik van een adres als attribuut van een ander object of als label.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Adresvoorstelling)",
      "pattern": "^Adresvoorstelling$"
    },
    "administratieveEenheidNaam": {
      "$ref": "#/components/schemas/Adresvoorstelling.administratieveEenheidNaam"
    },
    "busnummer": {
      "$ref": "#/components/schemas/Adresvoorstelling.busnummer"
    },
    "gemeentenaam": {
      "$ref": "#/components/schemas/Adresvoorstelling.gemeentenaam"
    },
    "huisnummer": {
      "$ref": "#/components/schemas/Adresvoorstelling.huisnummer"
    },
    "land": {
      "$ref": "#/components/schemas/Adresvoorstelling.land"
    },
    "locatieaanduiding": {
      "type": "array",
      "description": "Een nummer of een reeks tekens die de locatie op unieke wijze identificeert binnen de relevante scope. De volledige identificatie van de locator kan een of meer locator-aanduidingen bevatten. De scope is bijvoorbeeld de straat voor een huisnummer of het huisnummer voor een busnummer. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Adresvoorstelling.locatieaanduiding"
      },
      "minItems": 1
    },
    "postbus": {
      "$ref": "#/components/schemas/Adresvoorstelling.postbus"
    },
    "postcode": {
      "$ref": "#/components/schemas/Adresvoorstelling.postcode"
    },
    "postnaam": {
      "$ref": "#/components/schemas/Adresvoorstelling.postnaam"
    },
    "straatnaam": {
      "$ref": "#/components/schemas/Adresvoorstelling.straatnaam"
    },
    "volledigAdres": {
      "$ref": "#/components/schemas/Adresvoorstelling.volledigAdres"
    },
    "verwijstNaar": {
      "$ref": "#/components/schemas/Adres"
    }
  },
  "required": [
    "@type",
    "administratieveEenheidNaam"
  ]
}