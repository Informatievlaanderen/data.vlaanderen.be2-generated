{
  "title": "Garage",
  "type": "object",
  "description": "Faciliteit gebruikt voor het parkeren en onderhoud van voertuigen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Garage)",
      "pattern": "^Garage$"
    },
    "afbeelding": {
      "$ref": "#/components/schemas/Garage.afbeelding"
    },
    "url": {
      "$ref": "#/components/schemas/Garage.url"
    },
    "naam": {
      "$ref": "#/components/schemas/Garage.naam"
    },
    "korteNaam": {
      "$ref": "#/components/schemas/Garage.korteNaam"
    },
    "omschrijving": {
      "$ref": "#/components/schemas/Garage.omschrijving"
    },
    "privéCode": {
      "$ref": "#/components/schemas/Garage.privéCode"
    },
    "contactgegevens": {
      "$ref": "#/components/schemas/Contactinfo"
    },
    "gebruiktDoor": {
      "type": "array",
      "description": "Operator die de garage gebruikt. Lijst van Operator items.",
      "items": {
        "$ref": "#/components/schemas/Operator"
      },
      "minItems": 1
    },
    "uitgebaatDoor": {
      "$ref": "#/components/schemas/Operator"
    },
    "postadres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    },
    "wegadres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    },
    "plaatstype": {
      "$ref": "#/components/schemas/Plaatstype"
    },
    "centroïDe": {
      "$ref": "#/components/schemas/PuntDatatype"
    },
    "polygoon": {
      "$ref": "#/components/schemas/Polygoon"
    },
    "doelVanGroepering": {
      "$ref": "#/components/schemas/Code"
    },
    "garagepunt": {
      "type": "array",
      "description": "Garagepunt gekoppeld aan de Garage. Lijst van Garagepunt items.",
      "items": {
        "$ref": "#/components/schemas/Garagepunt"
      },
      "minItems": 1
    },
    "bemanningsbasis": {
      "type": "array",
      "description": "Bemanningsbasis bij de garage. Lijst van Bemanningsbasis items.",
      "items": {
        "$ref": "#/components/schemas/Bemanningsbasis"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "centroïDe"
  ]
}