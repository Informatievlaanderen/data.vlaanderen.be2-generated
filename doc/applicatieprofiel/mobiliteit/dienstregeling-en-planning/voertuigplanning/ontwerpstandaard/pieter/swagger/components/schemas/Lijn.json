{
  "title": "Lijn",
  "type": "object",
  "description": "Een groepering van Routes welke algemeen bekend zijn bij het brede publiek onder een gelijkaardige naam of nummer.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Lijn)",
      "pattern": "^Lijn$"
    },
    "naam": {
      "$ref": "#/components/schemas/Lijn.naam"
    },
    "publiekeCode": {
      "$ref": "#/components/schemas/Lijn.publiekeCode"
    },
    "korteNaam": {
      "$ref": "#/components/schemas/Lijn.korteNaam"
    },
    "omschrijving": {
      "$ref": "#/components/schemas/Lijn.omschrijving"
    },
    "url": {
      "$ref": "#/components/schemas/Lijn.url"
    },
    "privéCode": {
      "$ref": "#/components/schemas/Lijn.privéCode"
    },
    "gemonitord": {
      "$ref": "#/components/schemas/Lijn.gemonitord"
    },
    "documentlink": {
      "type": "array",
      "description": "Tijdschema documenten in verband met de lijn, Bijvoorbeeld PDF-bestanden. Lijst van URI items.",
      "items": {
        "$ref": "#/components/schemas/Lijn.documentlink"
      },
      "minItems": 1
    },
    "transportmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "toegankelijkheidsbeoordeling": {
      "$ref": "#/components/schemas/Toegankelijkheidsbeoordeling"
    },
    "transportsubmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "extraOperator": {
      "type": "array",
      "description": "Verwijzingen naar extra autoriteiten of exploitanten voor de lijn. Lijst van AutoriteitOfOperator items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Operator"
          },
          {
            "$ref": "#/components/schemas/Autoriteit"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Operator": "#/components/schemas/Operator",
            "Autoriteit": "#/components/schemas/Autoriteit"
          }
        }
      },
      "minItems": 1
    },
    "andereTransportmodus": {
      "type": "array",
      "description": "Extra transportmodi voor de lijn. Lijst van Transportmodus items.",
      "items": {
        "$ref": "#/components/schemas/Transportmodus"
      },
      "minItems": 1
    },
    "typeLijn": {
      "$ref": "#/components/schemas/TypeLijn"
    },
    "presentatie": {
      "$ref": "#/components/schemas/Presentatie"
    },
    "toegestaneRichting": {
      "type": "array",
      "description": "Toegestane richtingen voor de lijn. Lijst van Richting items.",
      "items": {
        "$ref": "#/components/schemas/Richting"
      },
      "minItems": 1
    },
    "opmerking": {
      "type": "array",
      "description": "Kennisgevingen toegewezen aan de lijn. Lijst van Opmerking items.",
      "items": {
        "$ref": "#/components/schemas/Opmerking"
      },
      "minItems": 1
    },
    "transportorganisatie": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Operator"
        },
        {
          "$ref": "#/components/schemas/Autoriteit"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Operator": "#/components/schemas/Operator",
          "Autoriteit": "#/components/schemas/Autoriteit"
        }
      }
    },
    "bestaandeUit": {
      "type": "array",
      "description": "De routes die de lijn vormen. Lijst van Route items.",
      "items": {
        "$ref": "#/components/schemas/Route"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "naam",
    "bestaandeUit"
  ]
}