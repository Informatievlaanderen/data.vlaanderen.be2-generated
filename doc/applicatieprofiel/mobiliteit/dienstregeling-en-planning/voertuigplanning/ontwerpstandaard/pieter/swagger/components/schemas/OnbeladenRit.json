{
  "title": "OnbeladenRit",
  "type": "object",
  "description": "Een rit waarbij geen dienst wordt geleverd.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse OnbeladenRit)",
      "pattern": "^OnbeladenRit$"
    },
    "richtingType": {
      "$ref": "#/components/schemas/RichtingType"
    },
    "onbeladenRittype": {
      "$ref": "#/components/schemas/OnbeladenRittype"
    },
    "vertrektijd": {
      "$ref": "#/components/schemas/OnbeladenRit.vertrektijd"
    },
    "ritduur": {
      "$ref": "#/components/schemas/OnbeladenRit.ritduur"
    },
    "vertrekdagOffset": {
      "$ref": "#/components/schemas/OnbeladenRit.vertrekdagOffset"
    },
    "opmerking": {
      "type": "array",
      "description": "Kennisgeving relevant voor de hele rit. Lijst van Opmerking items.",
      "items": {
        "$ref": "#/components/schemas/Opmerking"
      },
      "minItems": 1
    },
    "uitgevoerdOp": {
      "type": "array",
      "description": "Dagtype waarop de rit wordt gewerkt. Lijst van Dagtype items.",
      "items": {
        "$ref": "#/components/schemas/Dagtype"
      },
      "minItems": 1
    },
    "transportmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "transportsubmodus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "voertuigtype": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Voertuigtype"
        },
        {
          "$ref": "#/components/schemas/Trein"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Voertuigtype": "#/components/schemas/Voertuigtype",
          "Trein": "#/components/schemas/Trein"
        }
      }
    },
    "passeerdeOp": {
      "type": "array",
      "description": "Tijd waarop de voertuigreis passeert. Lijst van GeplandeDoorkomsttijd items.",
      "items": {
        "$ref": "#/components/schemas/GeplandeDoorkomsttijd"
      },
      "minItems": 1
    },
    "ritdeel": {
      "type": "array",
      "description": "Reis een deel van een reis. Alleen voor een multi-part-reis. Lijst van Ritdeel items.",
      "items": {
        "$ref": "#/components/schemas/Ritdeel"
      },
      "minItems": 1
    },
    "gemaaktMet": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/DienstRitpatroon"
        },
        {
          "$ref": "#/components/schemas/OnbeladenRitpatroon"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "DienstRitpatroon": "#/components/schemas/DienstRitpatroon",
          "OnbeladenRitpatroon": "#/components/schemas/OnbeladenRitpatroon"
        }
      }
    },
    "in": {
      "$ref": "#/components/schemas/Blok"
    },
    "deel": {
      "type": "array",
      "description": "TE DOEN. Lijst van Ritdeel items.",
      "items": {
        "$ref": "#/components/schemas/Ritdeel"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "uitgevoerdOp",
    "gemaaktMet"
  ]
}