{
  "title": "Operator",
  "type": "object",
  "description": "Een bedrijf dat openbaarvervoersdiensten aanbiedt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Operator)",
      "pattern": "^Operator$"
    },
    "land": {
      "$ref": "#/components/schemas/Operator.land"
    },
    "adres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    },
    "primaireModus": {
      "$ref": "#/components/schemas/Transportmodus"
    },
    "voorkeursnaam": {
      "$ref": "#/components/schemas/Operator.voorkeursnaam"
    },
    "alternatieveNaam": {
      "type": "array",
      "description": "Andere naam waaronder de organisatie bekend is. Bijvoorbeeld commerciële naam, informele naam…. Lijst van Taalstring items.",
      "items": {
        "$ref": "#/components/schemas/Operator.alternatieveNaam"
      },
      "minItems": 1
    },
    "beschrijving": {
      "$ref": "#/components/schemas/Operator.beschrijving"
    },
    "contactinfo": {
      "type": "array",
      "description": "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren. Lijst van Contactinfo items.",
      "items": {
        "$ref": "#/components/schemas/Contactinfo"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Soort organisatie. Specialisatie van classificatie (naast activiteit & status). Lijst van Organisatietype items.",
      "items": {
        "$ref": "#/components/schemas/Organisatietype"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "voorkeursnaam"
  ]
}