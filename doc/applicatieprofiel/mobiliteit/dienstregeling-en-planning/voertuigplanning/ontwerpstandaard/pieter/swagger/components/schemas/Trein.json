    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Trein)",
      "pattern": "^Trein$"
    },
    "aantalWagons": {
      "$ref": "#/components/schemas/Trein.aantalWagons"
    },
    "treingroottetype": {
      "$ref": "#/components/schemas/Treingrootte"
    },
    "component": {
      "type": "array",
      "description": "Verwijzing naar het Treincomponent. Lijst van Treincomponent items.",
      "items": {
        "$ref": "#/components/schemas/Treincomponent"
      },
      "minItems": 1
    },
    "naam": {
      "$ref": "#/components/schemas/Trein.naam"
    },
    "omschrijving": {
      "$ref": "#/components/schemas/Trein.omschrijving"
    },
    "zelfvoortstuwend": {
      "$ref": "#/components/schemas/Trein.zelfvoortstuwend"
    },
    "euroKlasse": {
      "$ref": "#/components/schemas/Trein.euroKlasse"
    },
    "lageVloer": {
      "$ref": "#/components/schemas/Trein.lageVloer"
    },
    "heeftLiftOfRamp": {
      "$ref": "#/components/schemas/Trein.heeftLiftOfRamp"
    },
    "typeBrandstof": {
      "$ref": "#/components/schemas/TypeBrandstof"
    },
    "capaciteit": {
      "type": "array",
      "description": "Passagiers dragende capaciteit van het voertuigtype per tariefklasse. Lijst van Passagierscapaciteit items.",
      "items": {
        "$ref": "#/components/schemas/Passagierscapaciteit"
      },
      "minItems": 1
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "gewicht": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    }
  },
  "required": [
    "@type"
  ]
