{
  "title": "Treinelement",
  "type": "object",
  "description": "Elementair onderdeel van een trein.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Treinelement)",
      "pattern": "^Treinelement$"
    },
    "naam": {
      "$ref": "#/components/schemas/Treinelement.naam"
    },
    "beschrijving": {
      "$ref": "#/components/schemas/Treinelement.beschrijving"
    },
    "treinelementtype": {
      "$ref": "#/components/schemas/Treinelementtype"
    },
    "tariefklasse": {
      "type": "array",
      "description": "Tariefklasse van het Treinelement. Lijst van Tariefklasse items.",
      "items": {
        "$ref": "#/components/schemas/Tariefklasse"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "treinelementtype"
  ]
}