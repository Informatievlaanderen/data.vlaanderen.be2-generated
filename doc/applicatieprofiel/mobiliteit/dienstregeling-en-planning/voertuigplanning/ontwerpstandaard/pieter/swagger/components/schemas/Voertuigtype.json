{
  "title": "Voertuigtype",
  "type": "object",
  "description": "Voertuigen kunnen worden geclassificeerd met behulp van een voertuigtype volgens hoe zij voldoen aan de vereisten van voertuigplanning m.b.t. de capaciteit en het aan boord hebben van faciliteiten (bijvoorbeeld standaardbus, dubbeldek, enz.).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Voertuigtype)",
      "pattern": "^Voertuigtype$"
    },
    "naam": {
      "$ref": "#/components/schemas/Voertuigtype.naam"
    },
    "omschrijving": {
      "$ref": "#/components/schemas/Voertuigtype.omschrijving"
    },
    "zelfvoortstuwend": {
      "$ref": "#/components/schemas/Voertuigtype.zelfvoortstuwend"
    },
    "euroKlasse": {
      "$ref": "#/components/schemas/Voertuigtype.euroKlasse"
    },
    "lageVloer": {
      "$ref": "#/components/schemas/Voertuigtype.lageVloer"
    },
    "heeftLiftOfRamp": {
      "$ref": "#/components/schemas/Voertuigtype.heeftLiftOfRamp"
    },
    "typeBrandstof": {
      "$ref": "#/components/schemas/TypeBrandstof"
    },
    "capaciteit": {
      "type": "array",
      "description": "Passagiers dragende capaciteit van het voertuigtype per tariefklasse. Lijst van Passagierscapaciteit items.",
      "items": {
        "$ref": "#/components/schemas/Passagierscapaciteit"
      },
      "minItems": 1
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    },
    "gewicht": {
      "$ref": "#/components/schemas/KwantitatieveWaarde"
    }
  },
  "required": [
    "@type"
  ]
}