    shacl:datatype rdf:langString;
    shacl:description "Name of the town or area."@en;
    shacl:maxCount 1;
    shacl:name "locationName"@en;
    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometry"@en;
    rdfs:comment "Geometry of the place or area."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportRegion.Geometry>;
    shacl:description "Geometry of the place or area."@en;
    shacl:maxCount 1;
