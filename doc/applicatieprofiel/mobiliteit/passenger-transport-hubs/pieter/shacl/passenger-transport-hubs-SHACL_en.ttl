    shacl:description "Transport object with which the Route connection coincides."@en;
    shacl:maxCount 1;
    shacl:name "realisedAt"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#realisedAt>
  ], [
