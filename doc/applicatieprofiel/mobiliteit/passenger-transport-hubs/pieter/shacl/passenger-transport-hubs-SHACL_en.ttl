<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AccessibilityShape> a shacl:NodeShape;
  rdfs:label "Accessibility"@en;
  <http://purl.org/vocab/vann/usageNote> "For example physical accessibility of a service or building for people with disabilities."@en;
  rdfs:comment "Degree to which something can be accessed."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Accessibility>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "component"@en;
    rdfs:comment "Part of the service or infrastructure to which Accessibility relates."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Accessibility.Component>;
    shacl:description "Part of the service or infrastructure to which Accessibility relates."@en;
    shacl:maxCount 1;
    shacl:name "component"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#component>
  ], [
    a shacl:PropertyShape;
    rdfs:label "level"@en;
    rdfs:comment "Level of accessibility."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Accessibility.Level>;
    shacl:description "Level of accessibility."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "level"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#level>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    rdfs:comment "Nature of the accessibility."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Accessibility.Type>;
    shacl:description "Nature of the accessibility."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Accessibility> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AdditionalServiceShape> a shacl:NodeShape;
  rdfs:label "AdditionalService"@en;
  <http://purl.org/vocab/vann/usageNote> "For example Newspaper shop, Postal service or Restaurant in a Station. Services that are supplemented or supported by this are for example Mobility Services."@en;
  rdfs:comment "Service that complements or supports other Services."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AdditionalService>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "title"@en;
    rdfs:comment "Name of the additional service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AdditionalService.Title>;
    shacl:datatype rdf:langString;
    shacl:description "Name of the additional service."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "title"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    <http://purl.org/vocab/vann/usageNote> "For example ticketing, waiting facilities, sanitary facilities, AED..."@en;
    rdfs:comment "Nature of the additional service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AdditionalService.Type>;
    shacl:description "Nature of the additional service."@en;
    shacl:minCount 1;
    shacl:name "type"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "availability"@en;
    <http://purl.org/vocab/vann/usageNote> "For example timetable or opening hours."@en;
    rdfs:comment "Availability of the additional service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AdditionalService.Availability>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Provider>;
    shacl:description "Availability of the additional service."@en;
    shacl:name "availability"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#AdditionalService.availability>
  ], [
    a shacl:PropertyShape;
    rdfs:label "accessibility"@en;
    <http://purl.org/vocab/vann/usageNote> "For example whether the Mobility Service is accessible to persons with disabilities."@en;
    rdfs:comment "Accessibility of the additional service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AdditionalService.Accessibility>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Accessibility>;
    shacl:description "Accessibility of the additional service."@en;
    shacl:name "accessibility"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#AdditionalService.accessibility>
  ], [
    a shacl:PropertyShape;
    rdfs:label "provider"@en;
    rdfs:comment "The provider of the additional service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AdditionalService.Provider>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Provider>;
    shacl:description "The provider of the additional service."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "provider"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#AdditionalService.provider>
  ], [
    a shacl:PropertyShape;
    rdfs:label "transportHub"@en;
    rdfs:comment "The Passenger Transport Hub at which the additional service is offered."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AdditionalService.TransportHub>;
    shacl:description "The Passenger Transport Hub at which the additional service is offered."@en;
    shacl:name "transportHub"@en;
    shacl:or ([shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportHub>] [shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#RegisteredTransportHub>] [shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#Hoppinpoint>]);
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#transportHub>
  ], [
    a shacl:PropertyShape;
    rdfs:label "availableAtInfrastructureElement"@en;
    rdfs:comment "Infrastructure element on which the additional service is offered."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AdditionalService.AvailableAtInfrastructureElement>;
    shacl:description "Infrastructure element on which the additional service is offered."@en;
    shacl:name "availableAtInfrastructureElement"@en;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infrastructuurelement>] [shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#InformationCarrier>] [shacl:class <https://data.vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/#Infozuil>] [shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#HoppinColumn>] [shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#DataExchangeInfrastructure>] [shacl:class <http://schema.mobivoc.org/#ParkingFacility>] [shacl:class <http://schema.mobivoc.org/#BicycleParkingStation>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Fietsstalling>] [shacl:class <http://schema.mobivoc.org/#ParkingGarage>] [shacl:class <http://schema.mobivoc.org/#ParkingLot>] [shacl:class <http://schema.mobivoc.org/#UndergroundParkingGarage>] [shacl:class <http://schema.mobivoc.org/#AutomatedParkingGarage>] [shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#Charger>] [shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#Quay>] [shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#StopPlace>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Haltepaal>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Bushok>]);
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#availableAtInfrastructureElement>
  ], [
    a shacl:PropertyShape;
    rdfs:label "availableOnTransportObject"@en;
    rdfs:comment "Transport object on which the additional service is offered."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AdditionalService.AvailableOnTransportObject>;
    shacl:description "Transport object on which the additional service is offered."@en;
    shacl:name "availableOnTransportObject"@en;
