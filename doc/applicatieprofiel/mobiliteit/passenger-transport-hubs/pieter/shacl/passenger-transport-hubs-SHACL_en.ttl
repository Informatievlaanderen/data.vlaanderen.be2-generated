    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#RouteNode>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "RouteNode (source)";
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Transfer.routeNode.source>
  ], [
