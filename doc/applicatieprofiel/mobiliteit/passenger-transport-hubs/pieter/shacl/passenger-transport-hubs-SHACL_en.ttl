    shacl:or ([shacl:class <http://www.w3.org/ns/locn#Geometry>] [shacl:class <http://www.opengis.net/ont/sf#Point>] [shacl:class <http://www.opengis.net/ont/sf#Polygon>]);
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportRegion> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TravelerShape> a shacl:NodeShape;
  rdfs:label "Traveler"@en;
  rdfs:comment "Person who undertakes or wants to undertake a Trip."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Traveler>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "pseudonym"@en;
    <http://purl.org/vocab/vann/usageNote> "The aim is that the real identity of the Traveller can no longer be traced but that trip data can still be studied on an individual level."@en;
    rdfs:comment "Name of the Traveler which differs from his actual name."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Traveler.Pseudonym>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Pseudonym>;
    shacl:description "Name of the Traveler which differs from his actual name."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "pseudonym"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#pseudonym>
  ], [
    a shacl:PropertyShape;
    rdfs:label "undertakes"@en;
    rdfs:comment "Trip that a Traveller undertakes or wants to undertake."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Traveler.Undertakes>;
    shacl:class schemas:Trip;
    shacl:description "Trip that a Traveller undertakes or wants to undertake."@en;
    shacl:name "undertakes"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#undertakes>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isFellowTravelerOf"@en;
    <http://purl.org/vocab/vann/usageNote> "For example the children of a family travelling together. Important for example when determining the price of a Ticket when young children travel free of charge."@en;
    rdfs:comment "Traveller who accompanies the Traveller on the Journey."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Traveler.IsFellowTravelerOf>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Traveler>;
    shacl:description "Traveller who accompanies the Traveller on the Journey."@en;
    shacl:name "isFellowTravelerOf"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#isFellowTravelerOf>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Traveler> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TripShape> a shacl:NodeShape;
  rdfs:label "Trip"@en;
  <http://purl.org/vocab/vann/usageNote> "The trip may take place via other Locations. The Location where the trip starts can be the same as where the trip ends (for example round trip)."@en;
  rdfs:comment "Voluntary movement of a Person from one Location to another Location."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Trip>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "departureTime"@en;
    <http://purl.org/vocab/vann/usageNote> "Usually only a departure or arrival time is given."@en;
    rdfs:comment "Time at which the Trip ends or at which the Passenger would like it to end."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Trip.DepartureTime>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time at which the Trip ends or at which the Passenger would like it to end."@en;
    shacl:maxCount 1;
    shacl:name "departureTime"@en;
    shacl:path schemas:departureTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "arrivalTime"@en;
    <http://purl.org/vocab/vann/usageNote> "Usually only a departure or arrival time is specified."@en;
    rdfs:comment "Sequence of Locations to be visited during the Trip."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Trip.ArrivalTime>;
    shacl:datatype xsd:dateTime;
    shacl:description "Sequence of Locations to be visited during the Trip."@en;
    shacl:maxCount 1;
    shacl:name "arrivalTime"@en;
    shacl:path schemas:arrivalTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "itinerary"@en;
    <http://purl.org/vocab/vann/usageNote> "Including the Location where the Journey starts and ends."@en;
    rdfs:comment "Sequence of Locations to be visited during the Trip."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Trip.Itinerary>;
    shacl:class prov:Location;
    shacl:description "Sequence of Locations to be visited during the Trip."@en;
    shacl:minCount 2;
    shacl:name "itinerary"@en;
    shacl:path schemas:itinerary
  ], [
    a shacl:PropertyShape;
    rdfs:label "partOfTrip"@en;
    rdfs:comment "Part of a complete Trip that can also be considered a Trip in itself."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Trip.PartOfTrip>;
    shacl:class schemas:Trip;
    shacl:description "Part of a complete Trip that can also be considered a Trip in itself."@en;
    shacl:name "partOfTrip"@en;
    shacl:path schemas:partOfTrip
  ], [
    a shacl:PropertyShape;
    rdfs:label "possibleRoute"@en;
    rdfs:comment "Routes that can be followed to perform the Trip."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Trip.PossibleRoute>;
    shacl:description "Routes that can be followed to perform the Trip."@en;
    shacl:name "possibleRoute"@en;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Route>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#RouteSegment>]);
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#possibleRoute>
  ], [
    a shacl:PropertyShape;
    rdfs:label "chosenRoute"@en;
    <http://purl.org/vocab/vann/usageNote> "Possibly more than 1 selected Route if the traveller changes Route on the way."@en;
    rdfs:comment "Route which the Passenger chooses from the possible Routes."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Trip.ChosenRoute>;
    shacl:description "Route which the Passenger chooses from the possible Routes."@en;
    shacl:name "chosenRoute"@en;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Route>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#RouteSegment>]);
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#chosenRoute>
  ], [
    a shacl:PropertyShape;
    rdfs:label "executedRoute"@en;
    <http://purl.org/vocab/vann/usageNote> "Actual time of arrival and departure, duration of journey, etc."@en;
    rdfs:comment "Route finally implemented to realise the Trip."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Trip.ExecutedRoute>;
    shacl:description "Route finally implemented to realise the Trip."@en;
    shacl:maxCount 1;
    shacl:name "executedRoute"@en;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Route>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#RouteSegment>]);
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#executedRoute>
  ];
  shacl:targetClass schemas:Trip .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#UndergroundParkingShape> a shacl:NodeShape;
  rdfs:label "UndergroundParking"@en;
  rdfs:comment "Parking garage that is located below the ground surface."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#UndergroundParking>;
  shacl:closed false;
  shacl:targetClass <http://schema.mobivoc.org/#UndergroundParkingGarage> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#VirtualNodeShape> a shacl:NodeShape;
  rdfs:label "VirtualNode"@en;
  <http://purl.org/vocab/vann/usageNote> "The place where a Trip is started usually does not coincide with an existing Transport node, for example it is the home of the Traveller located between two intersections. To still enter the network to start his Trip, the Traveller creates a Virtual Node on the link between these intersections. Virtual Nodes are important for a correct estimation of the travel time for example for route planning because the distance between the Virtual Node and the next real Transport Node must be added. Also important for example in free-floating partial transport where the position of the partial step does not necessarily coincide with that of an existing Transport Node."@en;
  rdfs:comment "Transport node that is dynamically created."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#VirtualNode>;
  shacl:closed false;
  shacl:targetClass <https://purl.eu/ns/mobility/passenger-transport-hubs#VirtualNode> .

_:df_0_106 a shacl:PropertyShape;
  rdfs:label "classification"@en;
  rdfs:comment "The classification of the Hoppinpoint."@en;
