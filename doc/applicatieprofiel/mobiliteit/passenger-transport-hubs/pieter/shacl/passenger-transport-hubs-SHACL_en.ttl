    shacl:name "service"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#ResourceReport.service>
  ];
  shacl:targetClass <https://purl.eu/ns/mobility/passenger-transport-hubs#ResourceReport> .

