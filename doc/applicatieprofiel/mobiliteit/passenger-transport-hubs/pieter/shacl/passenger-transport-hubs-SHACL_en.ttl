<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportNetworkShape> a shacl:NodeShape;
  rdfs:label "TransportNetwork"@en;
  <http://purl.org/vocab/vann/usageNote> "The transport mode is at least road, rail, air and water. Further subdivision into Transport Networks according to means of transport, drive type, service type is possible."@en;
  rdfs:comment "Collection of Network elements representing the same mode of transport."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportNetwork>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geographicalName"@en;
    rdfs:comment "Name of the Transport network."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportNetwork.GeographicalName>;
    shacl:datatype rdf:langString;
    shacl:description "Name of the Transport network."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "geographicalName"@en;
    shacl:path <https://data.vlaanderen.be/ns/transportnetwerk#geografischeNaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    rdfs:comment "Nature of the transport network according to the mode of transport."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportNetwork.Type>;
    shacl:description "Nature of the transport network according to the mode of transport."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "consistsOf"@en;
    rdfs:comment "Transport objects that make up the Transport network."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportNetwork.ConsistsOf>;
    shacl:description "Transport objects that make up the Transport network."@en;
    shacl:name "consistsOf"@en;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Transportobject>] [shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Transportknoop>] [shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#VirtualNode>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#TransportConnection>]);
    shacl:path <https://data.vlaanderen.be/ns/netwerk#bestaatUit>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/transportnetwerk#Transportnetwerk> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportNodeShape> a shacl:NodeShape;
