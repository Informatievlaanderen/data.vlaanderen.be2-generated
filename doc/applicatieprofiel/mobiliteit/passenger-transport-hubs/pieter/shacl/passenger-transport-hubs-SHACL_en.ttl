    rdfs:comment "End of the time period."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Period.EndTime>;
    shacl:datatype xsd:dateTime;
    shacl:description "End of the time period."@en;
    shacl:maxCount 1;
    shacl:name "endTime"@en;
    shacl:path <http://data.europa.eu/m8g/endTime>
  ];
  shacl:targetClass <http://data.europa.eu/m8g/PeriodOfTime> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#PointShape> a shacl:NodeShape;
  rdfs:label "Point"@en;
  rdfs:comment "A 0-dimensional geometric object that represents a particular location in a coordinate space. Has an x-coordinate and a y-coordinate. Can also have a z-coordinate (height) and an m-coordinate (distance along a curve)."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Point>;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#Point> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#PolygonShape> a shacl:NodeShape;
  rdfs:label "Polygon"@en;
  <http://purl.org/vocab/vann/usageNote> "The boundaries are so-called linear rings, that is, they are closed (not even intersecting) line strings. The outer boundary is distinguished from the inner boundary by the clockwise and counterclockwise directions in which the ring runs, respectively."@en;
  rdfs:comment "Surface consisting of 1 outer boundary and 0 or more inner boundaries. Each internal boundary forms a hole in the polygon."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Polygon>;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#Polygon> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#PriceSpecificationShape> a shacl:NodeShape;
  rdfs:label "PriceSpecification"@en;
  <http://purl.org/vocab/vann/usageNote> "Allows to find out how much a specific Journey will cost, taking into account for example the distance travelled or how long the Mobility Service is used. Including any discounts for target groups for example discount for children under 12 years."@en;
  rdfs:comment "Price of the Trips that can be made with the Mobility Service."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#PriceSpecification>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "title"@en;
    rdfs:comment "Name of the Price specfication."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#PriceSpecification.Title>;
    shacl:datatype rdf:langString;
    shacl:description "Name of the Price specfication."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "title"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "description"@en;
    rdfs:comment "Description of the Price specification."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#PriceSpecification.Description>;
    shacl:datatype rdf:langString;
    shacl:description "Description of the Price specification."@en;
    shacl:maxCount 1;
    shacl:name "description"@en;
    shacl:path dc:description
  ];
  shacl:targetClass schemas:PriceSpecification .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ProviderShape> a shacl:NodeShape;
  rdfs:label "Provider"@en;
  <http://purl.org/vocab/vann/usageNote> "By a registered organisation, we mean an organisation with a legal status (established through registration), for example LC,  NPO..."@en;
  rdfs:comment "Registered Organisation providing Mobility Services."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Provider>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "preferredLabel"@en;
    rdfs:comment "Name preferred by the Organisation."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Provider.PreferredLabel>;
    shacl:datatype rdf:langString;
    shacl:description "Name preferred by the Organisation."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "preferredLabel"@en;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "registration"@en;
    <http://purl.org/vocab/vann/usageNote> "In the CBE, this is the enterprise number."@en;
    rdfs:comment "Identifier obtained by the organisation upon registration."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Provider.Registration>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identifier obtained by the organisation upon registration."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "registration"@en;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactInformation"@en;
    rdfs:comment "Information such as email, telephone... which allows the Organisation to be contacted."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Provider.ContactInformation>;
    shacl:class schemas:ContactPoint;
    shacl:description "Information such as email, telephone... which allows the Organisation to be contacted."@en;
    shacl:name "contactInformation"@en;
    shacl:path schemas:contactPoint
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Provider> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#PublicOrganisationShape> a shacl:NodeShape;
  rdfs:label "PublicOrganisation"@en;
  <http://purl.org/vocab/vann/usageNote> "The public and semi-public organisations that may be considered as belonging to the public sector are referred to in European Directive 2003/98/EC as \"public sector bodies\" and defined as: \"the State, regional or local authorities, bodies governed by public law, associations formed by one or several of such authorities or one or several of such bodies governed by public law\". And a body governed by public law is defined as \"any body (a) established for the specific purpose of meeting needs in the general interest, not having an industrial or commercial character, and (b) having legal personality, and (c) financed, for the most part, by the State, or regional or local authorities, or other bodies governed by public law; or subject to management supervision by those bodies; or having an administrative, managerial or supervisory board, more than half of whose members are appointed by the State, regional or local authorities or by other bodies governed by public law\"."@en;
  rdfs:comment "An organisation that, according to a legal framework, belongs to the public sector, regardless of the level of government at which that framework applies."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#PublicOrganisation>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "spatialCoverage"@en;
    rdfs:comment "Administrative area covering the Public Organisation."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#PublicOrganisation.SpatialCoverage>;
    shacl:description "Administrative area covering the Public Organisation."@en;
    shacl:name "spatialCoverage"@en;
    shacl:or ([shacl:class dc:Location] [shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportRegion>]);
    shacl:path dc:spatial
  ];
  shacl:targetClass <http://data.europa.eu/m8g/PublicOrganisation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#QuayShape> a shacl:NodeShape;
  rdfs:label "Quay"@en;
  rdfs:comment "A place such as a platform, bus stop, stand or train platform where passengers can access public transport vehicles, taxis, cars or other means of transport."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Quay>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "publicCode"@en;
    rdfs:comment "Use to identify the platform to the public."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Quay.PublicCode>;
    shacl:datatype xsd:string;
    shacl:description "Use to identify the platform to the public."@en;
    shacl:maxCount 1;
    shacl:name "publicCode"@en;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#Quay.publicCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "stopPlace"@en;
    rdfs:comment "The stopping point as a larger entity to which the platform belongs."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Quay.StopPlace>;
    shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#StopPlace>;
    shacl:description "The stopping point as a larger entity to which the platform belongs."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "stopPlace"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#Quay.stopPlace>
  ], [
    a shacl:PropertyShape;
    rdfs:label "quay"@en;
    rdfs:comment "The platform belonging to the stop."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Quay.Quay>;
    shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#Quay>;
    shacl:description "The platform belonging to the stop."@en;
    shacl:maxCount 1;
    shacl:name "quay"@en;
    shacl:path <https://purl.eu/ns/mobility/timetables-and-planning#quay>
  ];
  shacl:targetClass <https://purl.eu/ns/mobility/timetables-and-planning#Quay> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#RegisteredTransportHubShape> a shacl:NodeShape;
  rdfs:label "RegisteredTransportHub"@en;
  <http://purl.org/vocab/vann/usageNote> "This recognition implies that a Registered Transport Hub is formally designated as a Transport Hub. Typically, this is done by the government to give the hub an official character (recognisable for the user, meets imposed quality requirements...)."@en;
  rdfs:comment "Passenger Transport Hub recognised as such."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#RegisteredTransportHub>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "registration"@en;
