    rdfs:label "RouteNode (target)";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Transfer.RouteNode(Target)>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#RouteNode>;
