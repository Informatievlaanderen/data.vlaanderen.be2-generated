    shacl:name "openingHours"@en;
    shacl:nodeKind shacl:Literal;
    shacl:path schemas:hoursAvailable
  ], [
    a shacl:PropertyShape;
    rdfs:label "timetable"@en;
    rdfs:comment "Schedule of times when something is offered."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Availability.Timetable>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Timetable>;
    shacl:description "Schedule of times when something is offered."@en;
    shacl:maxCount 1;
    shacl:name "timetable"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#timetable>
  ], [
    a shacl:PropertyShape;
    rdfs:label "user"@en;
    rdfs:comment "Type of user to which the availability applies."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Availability.User>;
    shacl:description "Type of user to which the availability applies."@en;
    shacl:maxCount 1;
    shacl:name "user"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#person>
  ], [
    a shacl:PropertyShape;
    rdfs:label "period"@en;
    <http://purl.org/vocab/vann/usageNote> "For example start date without end date for services that are still active or an indication of the season in which the services are offered. A completed end date indicates when the service was terminated. Start and end date according to ISO8601 syntax."@en;
    rdfs:comment "Period in which something is available."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Availability.Period>;
    shacl:class schemas:hoursAvailable;
    shacl:description "Period in which something is available."@en;
    shacl:maxCount 1;
    shacl:name "period"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Beschikbaarheid.periode>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Availability> .

