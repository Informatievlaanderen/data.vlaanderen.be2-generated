<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#FormalFrameworkShape> a shacl:NodeShape;
  rdfs:label "FormalFramework"@en;
  <http://purl.org/vocab/vann/usageNote> "The documents in question are laws, policies, regulations, contracts, etc."@en;
  rdfs:comment "Set of formal documents describing rules, rights, obligations towards citizens, authorities, companies, etc."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#FormalFramework>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "title"@en;
    rdfs:comment "Name of the formal framework."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#FormalFramework.Title>;
    shacl:datatype rdf:langString;
    shacl:description "Name of the formal framework."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "title"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "description"@en;
    rdfs:comment "Description of the formal framework."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#FormalFramework.Description>;
    shacl:datatype rdf:langString;
    shacl:description "Description of the formal framework."@en;
    shacl:maxCount 1;
    shacl:name "description"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "territorialApplication"@en;
