<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportRegionShape> a shacl:NodeShape;
  rdfs:label "TransportRegion"@en;
  rdfs:comment "Clusters of municipalities in which mobility is coordinated."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportRegion>;
  shacl:closed false;
  shacl:property [
