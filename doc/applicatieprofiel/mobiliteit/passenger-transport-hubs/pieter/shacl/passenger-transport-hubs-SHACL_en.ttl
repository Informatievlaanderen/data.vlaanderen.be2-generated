<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#AvailabilityShape> a shacl:NodeShape;
  rdfs:label "Availability"@en;
  <http://purl.org/vocab/vann/usageNote> "For example hours when a service is offered or opening hours of a building."@en;
  rdfs:comment "Degree to which something is available for use."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Availability>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "openingHours"@en;
    <http://purl.org/vocab/vann/usageNote> "Syntax according to schema.org for opening hours. For example if contact can be made between 8 and 20h Monday to Saturday and between 8 and 18h on Sunday this is coded as Mon-Sat 08:00-20:00, Sun 08:00-18:00."@en;
    rdfs:comment "Hours on which something is available."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Availability.OpeningHours>;
    shacl:description "Hours on which something is available."@en;
