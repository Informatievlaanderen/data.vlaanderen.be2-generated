<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#RouteNodeShape> a shacl:NodeShape;
  rdfs:label "RouteNode"@en;
  rdfs:comment "Significant position in the Route that always coincides with the beginning or the end of a Route segment."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#RouteNode>;
  shacl:closed false;
