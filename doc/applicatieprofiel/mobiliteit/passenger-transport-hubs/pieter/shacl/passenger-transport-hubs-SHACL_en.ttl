    shacl:description "The brand of the Passenger Transport Hub."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "brand"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportHub.brand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "roadAuthority"@en;
    rdfs:comment "The road authority of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportHub.RoadAuthority>;
    shacl:class dc:Agent;
    shacl:description "The road authority of the Passenger Transport Hub."@en;
    shacl:name "roadAuthority"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportHub.roadAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "transportObject"@en;
    rdfs:comment "The transport object of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportHub.TransportObject>;
    shacl:description "The transport object of the Passenger Transport Hub."@en;
    shacl:name "transportObject"@en;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Transportobject>] [shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Transportknoop>] [shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#VirtualNode>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#TransportConnection>]);
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#transportObject>
  ], [
    a shacl:PropertyShape;
    rdfs:label "service"@en;
    rdfs:comment "The mobility services connected to the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportHub.Service>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#MobilityService>;
    shacl:description "The mobility services connected to the Passenger Transport Hub."@en;
