    rdfs:comment "Transport object with which the Route connection coincides."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Transfer.RealisedAt>;
