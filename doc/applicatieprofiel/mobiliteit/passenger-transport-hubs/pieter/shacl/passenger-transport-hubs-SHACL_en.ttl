    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#RegisteredTransportHub.Registration>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "The registration of the registered Passenger Transport Hub."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "registration"@en;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "specification"@en;
    rdfs:comment "The specification of the registered Passenger Transport Hub."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#RegisteredTransportHub.Specification>;
    shacl:class foaf:Document;
    shacl:description "The specification of the registered Passenger Transport Hub."@en;
    shacl:maxCount 1;
    shacl:name "specification"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#RegisteredTransportHub.specification>
  ];
  shacl:targetClass <https://purl.eu/ns/mobility/passenger-transport-hubs#RegisteredTransportHub>,
    <https://purl.eu/ns/mobility/passenger-transport-hubs#Hoppinpoint> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ResourceReportShape> a shacl:NodeShape;
  rdfs:label "ResourceReport"@en;
  <http://purl.org/vocab/vann/usageNote> "For example The number of available bikes in a particular train station."@en;
  rdfs:comment "Report of how many Resources with similar characteristics of availability, type, service, location etc are present at a certain point in time."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ResourceReport>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "number"@en;
    rdfs:comment "The number of resources."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ResourceReport.Number>;
    shacl:datatype xsd:integer;
    shacl:description "The number of resources."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "number"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#number>
  ], [
    a shacl:PropertyShape;
    rdfs:label "reportTime"@en;
    rdfs:comment "Point in time for which the report is valid."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ResourceReport.ReportTime>;
    shacl:datatype xsd:dateTime;
    shacl:description "Point in time for which the report is valid."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "reportTime"@en;
    shacl:path dc11:date
  ], [
    a shacl:PropertyShape;
    rdfs:label "propulsion"@en;
    rdfs:comment "Engine of the means of transport."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ResourceReport.Propulsion>;
    shacl:description "Engine of the means of transport."@en;
    shacl:name "propulsion"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#propulsion>
  ], [
    a shacl:PropertyShape;
    rdfs:label "location"@en;
    <http://purl.org/vocab/vann/usageNote> "This could be the real-time location of the vehicle, for example in free-floating part transport."@en;
    rdfs:comment "Location of the Resource."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ResourceReport.Location>;
    shacl:class prov:Location;
    shacl:description "Location of the Resource."@en;
    shacl:name "location"@en;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "meansOfTransport"@en;
    <http://purl.org/vocab/vann/usageNote> "Especially relevant if the resource is a vehicle."@en;
    rdfs:comment "The type of means of transport of the Resource."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ResourceReport.MeansOfTransport>;
    shacl:description "The type of means of transport of the Resource."@en;
    shacl:name "meansOfTransport"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#ResourceReport.meansOfTransport>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@en;
    <http://purl.org/vocab/vann/usageNote> "For example reserved, inactive, available. Determines whether a resource can be used."@en;
    rdfs:comment "State of a Resource."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ResourceReport.Status>;
    shacl:description "State of a Resource."@en;
    shacl:name "status"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#ResourceReport.status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    rdfs:comment "Nature of the Resource."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ResourceReport.Type>;
    shacl:description "Nature of the Resource."@en;
    shacl:name "type"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "service"@en;
    rdfs:comment "The MobilityService used within the ResourceReport."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#ResourceReport.Service>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#MobilityService>;
