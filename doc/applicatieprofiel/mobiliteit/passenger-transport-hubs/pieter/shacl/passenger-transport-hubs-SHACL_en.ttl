<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportHubShape> a shacl:NodeShape;
  rdfs:label "TransportHub"@en;
  <http://purl.org/vocab/vann/usageNote> "Examples for passenger transport are train stations, underground stations, bus stations, airports, ferry terminals, car parks... For freight transport it concerns typically airports, seaports, transhipment terminals. Transport hubs are typically intermodal, for example travellers combine the (shared) bicycle with the train for their trip, but intramodal transfers (for example from one bus line to another) are also important. Concretely, a Transport hub includes infrastructure (stations, car parks, charging infrastructure... ), (mobility) services (public transport lines, shared bicycles, shops... ) and nodes in transport networks (public transport stops, car sharing points... )."@en;
  rdfs:comment "Place where passengers and/or freight are exchanged between vehicles and/or modes of transport."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportHub>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "title"@en;
    rdfs:comment "The name of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportHub.Title>;
    shacl:datatype rdf:langString;
    shacl:description "The name of the Passenger Transport Hub."@en;
    shacl:name "title"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "accessibility"@en;
    rdfs:comment "The accessibility of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransportHub.Accessibility>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Accessibility>;
    shacl:description "The accessibility of the Passenger Transport Hub."@en;
    shacl:name "accessibility"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportHub.accessibility>
  ], [
    a shacl:PropertyShape;
    rdfs:label "location"@en;
    rdfs:comment "The location of the Passenger Transport Hub."@en;
