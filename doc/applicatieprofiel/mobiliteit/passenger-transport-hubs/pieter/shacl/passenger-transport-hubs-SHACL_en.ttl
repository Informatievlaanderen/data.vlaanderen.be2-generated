<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#TransferShape> a shacl:NodeShape;
  rdfs:label "Transfer"@en;
  <http://purl.org/vocab/vann/usageNote> "Means to describe the transition between two Route segments if not represented by a Route segment itself. One can interchange between two same Route nodes (for example changing from one train to another at the same station) or between two different ones (for example interchanging from the station car parking to the station platforms)."@en;
  rdfs:comment "Logical connection between two Route nodes."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Transfer>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "transferTime"@en;
    rdfs:comment "Time in which the changeover takes place."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Transfer.TransferTime>;
    shacl:datatype xsd:duration;
    shacl:description "Time in which the changeover takes place."@en;
    shacl:maxCount 1;
    shacl:name "transferTime"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#transferTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "meansOfTransport"@en;
    <http://purl.org/vocab/vann/usageNote> "Usually on foot."@en;
    rdfs:comment "Means of transport by which the Transfer is made."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Transfer.MeansOfTransport>;
    shacl:description "Means of transport by which the Transfer is made."@en;
    shacl:maxCount 1;
    shacl:name "meansOfTransport"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Overstap.vervoermiddel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "propulsion"@en;
    rdfs:comment "Propulsion of the means of transport by which the Transfer is made."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/passenger-transport-hubs/pieter#Transfer.Propulsion>;
    shacl:description "Propulsion of the means of transport by which the Transfer is made."@en;
    shacl:maxCount 1;
