{
  "title": "Executor",
  "type": "object",
  "description": "Agent performing mobility service.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Executor)",
      "pattern": "^Executor$"
    },
    "preferredLabel": {
      "$ref": "#/components/schemas/Executor.preferredLabel"
    },
    "registration": {
      "$ref": "#/components/schemas/Identifier"
    },
    "contactInformation": {
      "type": "array",
      "description": "Information such as e-mail, telephone... which allows the executor to be contacted. Lijst van ContactInformation items.",
      "items": {
        "$ref": "#/components/schemas/ContactInformation"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "preferredLabel",
    "registration"
  ]
}