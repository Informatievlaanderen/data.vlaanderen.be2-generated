{
  "title": "HoppinColumn",
  "type": "object",
  "description": "Information column of a Hoppinpoint.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse HoppinColumn)",
      "pattern": "^HoppinColumn$"
    },
    "columnName": {
      "$ref": "#/components/schemas/HoppinColumn.columnName"
    },
    "columnNumber": {
      "$ref": "#/components/schemas/HoppinColumn.columnNumber"
    },
    "displayedTransportationModeOnMap": {
      "type": "array",
      "description": "The different modes of transport available are shown on the corresponding map. Lijst van TransportModeOnMap items.",
      "items": {
        "$ref": "#/components/schemas/TransportModeOnMap"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "The type of infrastructure element. Lijst van InfrastructureElementType items.",
      "items": {
        "$ref": "#/components/schemas/InfrastructureElementType"
      },
      "minItems": 1
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Geometry"
        },
        {
          "$ref": "#/components/schemas/Point"
        },
        {
          "$ref": "#/components/schemas/Polygon"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Geometry": "#/components/schemas/Geometry",
          "Point": "#/components/schemas/Point",
          "Polygon": "#/components/schemas/Polygon"
        }
      }
    },
    "validityPeriod": {
      "$ref": "#/components/schemas/Period"
    },
    "accessibility": {
      "type": "array",
      "description": "The overall accessibility characteristics of the infrastructure element. Lijst van Accessibility items.",
      "items": {
        "$ref": "#/components/schemas/Accessibility"
      },
      "minItems": 1
    },
    "identifier": {
      "$ref": "#/components/schemas/Identifier"
    },
    "service": {
      "type": "array",
      "description": "The service offered by the infrastructure element. Lijst van AdditionalService items.",
      "items": {
        "$ref": "#/components/schemas/AdditionalService"
      },
      "minItems": 1
    },
    "transportHub": {
      "type": "array",
      "description": "The transport hub to which this infrastructure element belongs. Lijst van TransportHub items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TransportHub"
          },
          {
            "$ref": "#/components/schemas/RegisteredTransportHub"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "TransportHub": "#/components/schemas/TransportHub",
            "RegisteredTransportHub": "#/components/schemas/RegisteredTransportHub"
          }
        }
      },
      "minItems": 1
    },
    "transportObject": {
      "type": "array",
      "description": "The transport object belonging to the infrastructure element. Lijst van TransportObject items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TransportNode"
          },
          {
            "$ref": "#/components/schemas/TransportConnection"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "TransportNode": "#/components/schemas/TransportNode",
            "TransportConnection": "#/components/schemas/TransportConnection"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "columnName",
    "columnNumber",
    "geometry",
    "validityPeriod",
    "identifier"
  ]
}