{
  "title": "License",
  "type": "object",
  "description": "Formal authorisation to offer a Mobility Service.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse License)",
      "pattern": "^License$"
    },
    "period": {
      "$ref": "#/components/schemas/Period"
    },
    "territorialApplication": {
      "type": "array",
      "description": "Area or Place in which the Licence is valid. Lijst van Location items.",
      "items": {
        "$ref": "#/components/schemas/Location"
      },
      "minItems": 1
    },
    "transportAuthority": {
      "$ref": "#/components/schemas/PublicOrganisation"
    }
  },
  "required": [
    "@type",
    "period",
    "territorialApplication",
    "transportAuthority"
  ]
}