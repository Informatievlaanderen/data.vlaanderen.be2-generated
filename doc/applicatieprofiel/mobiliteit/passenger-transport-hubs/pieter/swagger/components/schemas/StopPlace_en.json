{
  "title": "StopPlace",
  "type": "object",
  "description": "A stopping point represents a station, stop, port, airport or any other physical access point to the transport network.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse StopPlace)",
      "pattern": "^StopPlace$"
    },
    "publicCode": {
      "$ref": "#/components/schemas/StopPlace.publicCode"
    },
    "stopPlaceType": {
      "$ref": "#/components/schemas/StoppingPlaceType"
    },
    "accessModes": {
      "type": "array",
      "description": "Access modes by which the stopping point can be accessed. Lijst van AccessMode items.",
      "items": {
        "$ref": "#/components/schemas/AccessMode"
      },
      "minItems": 1
    },
    "accessibility": {
      "type": "array",
      "description": "The overall accessibility characteristics of the infrastructure element. Lijst van Accessibility items.",
      "items": {
        "$ref": "#/components/schemas/Accessibility"
      },
      "minItems": 1
    },
    "placeType": {
      "$ref": "#/components/schemas/PlaceType"
    },
    "roadAdress": {
      "$ref": "#/components/schemas/AddressRepresentation"
    },
    "centroid": {
      "$ref": "#/components/schemas/Point"
    },
    "polygon": {
      "$ref": "#/components/schemas/Polygon"
    },
    "parentSite": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Site"
        },
        {
          "$ref": "#/components/schemas/StopPlace"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Site": "#/components/schemas/Site",
          "StopPlace": "#/components/schemas/StopPlace"
        }
      }
    },
    "transportMode": {
      "$ref": "#/components/schemas/TransportMode"
    },
    "containing": {
      "type": "array",
      "description": "The platform as part of the stopping point. Lijst van Quay items.",
      "items": {
        "$ref": "#/components/schemas/Quay"
      },
      "minItems": 1
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Geometry"
        },
        {
          "$ref": "#/components/schemas/Point"
        },
        {
          "$ref": "#/components/schemas/Polygon"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Geometry": "#/components/schemas/Geometry",
          "Point": "#/components/schemas/Point",
          "Polygon": "#/components/schemas/Polygon"
        }
      }
    },
    "validityPeriod": {
      "$ref": "#/components/schemas/Period"
    },
    "identifier": {
      "$ref": "#/components/schemas/Identifier"
    },
    "type": {
      "type": "array",
      "description": "The type of infrastructure element. Lijst van InfrastructureElementType items.",
      "items": {
        "$ref": "#/components/schemas/InfrastructureElementType"
      },
      "minItems": 1
    },
    "service": {
      "type": "array",
      "description": "The service offered by the infrastructure element. Lijst van AdditionalService items.",
      "items": {
        "$ref": "#/components/schemas/AdditionalService"
      },
      "minItems": 1
    },
    "transportHub": {
      "type": "array",
      "description": "The transport hub to which this infrastructure element belongs. Lijst van TransportHub items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TransportHub"
          },
          {
            "$ref": "#/components/schemas/RegisteredTransportHub"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "TransportHub": "#/components/schemas/TransportHub",
            "RegisteredTransportHub": "#/components/schemas/RegisteredTransportHub"
          }
        }
      },
      "minItems": 1
    },
    "transportObject": {
      "type": "array",
      "description": "The transport object belonging to the infrastructure element. Lijst van TransportObject items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TransportNode"
          },
          {
            "$ref": "#/components/schemas/TransportConnection"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "TransportNode": "#/components/schemas/TransportNode",
            "TransportConnection": "#/components/schemas/TransportConnection"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "stopPlaceType",
    "geometry",
    "validityPeriod",
    "identifier"
  ]
}