{
  "title": "Transfer",
  "type": "object",
  "description": "Logical connection between two Route nodes.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Transfer)",
      "pattern": "^Transfer$"
    },
    "transferTime": {
      "$ref": "#/components/schemas/Transfer.transferTime"
    },
    "meansOfTransport": {
      "$ref": "#/components/schemas/MeansOfTransport"
    },
    "propulsion": {
      "$ref": "#/components/schemas/PropulsionType"
    },
    "realisedAt": {
      "$ref": "#/components/schemas/TransportConnection"
    },
    "routeNode(Source)": {
      "$ref": "#/components/schemas/RouteNode"
    },
    "routeNode(Target)": {
      "$ref": "#/components/schemas/RouteNode"
    }
  },
  "required": [
    "@type",
    "routeNode(Source)",
    "routeNode(Target)"
  ]
}