    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "zuilnaam"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Hoppinzuil.zuilnaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "zuilnummer"@nl;
    rdfs:comment "Uniek identificatienummer dat elke zuil krijgt en dat wordt opgenomen in de vervoersknooppuntendatabank."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#Hoppinzuil.Zuilnummer>;
    shacl:datatype xsd:string;
    shacl:description "Uniek identificatienummer dat elke zuil krijgt en dat wordt opgenomen in de vervoersknooppuntendatabank."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "zuilnummer"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Hoppinzuil.zuilnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "weergegevenVervoersmodusOpKaart"@nl;
    rdfs:comment "De verschillende beschikbare vervoersmodi die op de bijhorende kaart worden weergegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#Hoppinzuil.Weergegevenvervoersmodusopkaart>;
