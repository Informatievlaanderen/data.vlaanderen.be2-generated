<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#InformatiedragerShape> a shacl:NodeShape;
  rdfs:label "Informatiedrager"@nl;
