<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#HoppinpuntShape> a shacl:NodeShape;
  rdfs:label "Hoppinpunt"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hoppin is de benaming waaronder de Vlaamse overheid Vervoersknooppunten voor reizigersvervoer aanduidt die voldoen aan vastgelegde (kwaliteits)eisen. Zaken van belang zijn herkenbaarheid (toepassing Hoppin huisstijl), toegankelijkheid (voor alle gebruikers ongeacht hun beperking, leeftijd etc), minimale uitrusting (bvb fietsstallingen, informatiedragers... ), afstemming op mobiliteitsplannen etc."@nl;
  rdfs:comment "Vervoersknooppunt van het mobiliteitsmerk Hoppin."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "classificatie"@nl;
    rdfs:comment "De classificatie van het Hoppinpunt"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#Hoppinpunt.Classificatie>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Hoppinpunttype>;
    shacl:description "De classificatie van het Hoppinpunt"@nl;
    shacl:maxCount "1";
    shacl:name "classificatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Hoppinpunt.classificatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "De status van het Hoppinpunt"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#Hoppinpunt.Status>;
    shacl:class skos:Concept;
    shacl:description "De status van het Hoppinpunt"@nl;
    shacl:maxCount "1";
    shacl:name "status"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Hoppinpunt.status>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Hoppinpunt> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#HoppinpuntstatusShape> a shacl:NodeShape;
