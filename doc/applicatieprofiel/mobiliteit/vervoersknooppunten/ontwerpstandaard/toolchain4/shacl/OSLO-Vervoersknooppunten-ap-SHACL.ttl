<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#AanbiederShape> a shacl:NodeShape;
  rdfs:label "Aanbieder"@nl;
  <http://purl.org/vocab/vann/usageNote> "Onder een geregistreerde Organisaties verstaan we een Organisatie met een juridisch statuut (vastgelegd door registratie), bv NV, VZW..."@nl;
  rdfs:comment "Geregistreerde Organisatie die Mobiliteitsdiensten aanbiedt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#Aanbieder.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    <http://purl.org/vocab/vann/usageNote> "In de KBO is dit het ondernemingsnummer."@nl;
    rdfs:comment "Identificator die de organisatie verkreeg bij registratie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#Aanbieder.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator die de organisatie verkreeg bij registratie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#Aanbieder.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path schema:contactPoint
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Aanbieder> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#AandrijftypeShape> a shacl:NodeShape;
  rdfs:label "Aandrijftype"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#AanvullendedienstShape> a shacl:NodeShape;
  rdfs:label "AanvullendeDienst"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv Krantenwinkel, Postdienst of Restaurant in een Station. De Diensten die daarmee worden aangevuld of ondersteund zijn bv Mobiliteitsdiensten."@nl;
  rdfs:comment "Dienst die een aanvulling biedt op andere Diensten of deze ondersteunt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van de aanvullende dienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#Aanvullendedienst.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van de aanvullende dienst."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv ticketing, wachtaccomodatie, sanitair, AED…"@nl;
    rdfs:comment "Aard van de aanvullende dienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#Aanvullendedienst.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de aanvullende dienst."@nl;
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbaarheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv dienstregeling of openingsuren."@nl;
    rdfs:comment "Beschikbaarheid van de aanvullende dienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/ontwerpstandaard/toolchain4#Aanvullendedienst.Beschikbaarheid>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Aanbieder>;
    shacl:description "Beschikbaarheid van de aanvullende dienst."@nl;
    shacl:name "beschikbaarheid"@nl;
