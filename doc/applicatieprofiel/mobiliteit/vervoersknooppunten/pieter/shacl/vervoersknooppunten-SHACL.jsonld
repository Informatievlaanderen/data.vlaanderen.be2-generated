  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#VirtueleKnoopShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "De plek waar een Reis gestart wordt valt doorgaans niet samen met een bestaande Transportknoop, het is bijvoorbeeld de woning van de Reiziger gelegen tussen twee kruispunten. Om alsnog het netwerk op te gaan om zijn Reis te starten creëert de Reiziger ahw een VirtueleKnoop op de link tussen deze kruispunten. VirtueleKnopen zijn van belang om een correcte inschatting van de reistijd te maken bijvoorbeeld bij routeplanning omdat concreet nog de afstand moet bijgeteld worden tussen de VirtueleKnoop en de eerstvolgende echte Transportknoop. Ook belangrijk bijvoorbeeld bij free floating deelvervoer waar de positie van bijvoorbeeld de deelstep niet noodzakelijk samenvalt met deze van een bestaande Transportknoop."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Transportknoop die dynamisch gecreëerd wordt."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "VirtueleKnoop"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#VirtueleKnoop"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#VirtueleKnoop"
      }
    ]
  },
