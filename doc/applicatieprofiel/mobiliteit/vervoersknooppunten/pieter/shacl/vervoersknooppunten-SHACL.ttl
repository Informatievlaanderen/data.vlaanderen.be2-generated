    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Transportconnectie>;
    shacl:description "Transportobject waarmee de Routeconnectie samenvalt."@nl;
    shacl:maxCount 1;
    shacl:name "gerealiseerdOp"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#gerealiseerdOp>
  ], [
