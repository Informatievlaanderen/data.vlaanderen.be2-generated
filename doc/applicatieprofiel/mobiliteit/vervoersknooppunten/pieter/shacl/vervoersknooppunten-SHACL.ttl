    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "Geometrie van de plaats of het gebied."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#PlaatsOsloGeneriek.Geometrie>;
    shacl:description "Geometrie van de plaats of het gebied."@nl;
    shacl:maxCount 1;
    shacl:name "geometrie"@nl;
    shacl:or ([shacl:class <http://www.w3.org/ns/locn#Geometry>] [shacl:class <http://www.opengis.net/ont/sf#Point>] [shacl:class <http://www.opengis.net/ont/sf#Polygon>]);
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass dc:Location .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#PolygoonShape> a shacl:NodeShape;
  rdfs:label "Polygoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "De grenzen zijn zgn lineaire ringen,het is te zeggen het zijn gesloten (niet zelfsnijdende) lijnstringen. De buitengrens wordt onderscheiden van de binnengrens door resp de kloksgewijze en tegenkloksgewijze richting waarin de ring loopt."@nl;
  rdfs:comment "Oppervlak bestaande uit 1 buitengrens en 0 of meer binnengrenzen. Elke binnengrens vormt een gat in de polygoon."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Polygoon>;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#Polygon> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#PrijsplanShape> a shacl:NodeShape;
  rdfs:label "Prijsplan"@nl;
  <http://purl.org/vocab/vann/usageNote> "Laat toe te achterhalen hoeveel een specifieke Reis gaat kosten, rekening houdend met bijvoorbeeld de reisweg of de afgelegde afstand of hoe lang men van de Mobiliteitsdienst gebruik maakt. Inclusief eventuele kortingen voor doelgroepen bijvoorbeeld korting voor kinderen onder 12 jaar."@nl;
  rdfs:comment "Prijs van de Reizen die met de Mobiliteitsdienst kunnen worden uitgevoerd."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Prijsplan>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van het Prijsplan."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Prijsplan.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van het Prijsplan."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Beschrijving van het Prijsplan."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Prijsplan.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Beschrijving van het Prijsplan."@nl;
    shacl:maxCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ];
  shacl:targetClass schemas:PriceSpecification .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#PubliekeOrganisatieShape> a shacl:NodeShape;
  rdfs:label "PubliekeOrganisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "De overheids- en semioverheidsorganisaties die tot men zo tot de publieke sector kan rekenen worden in Europese richtlijn 2003/98/EG \"openbaar lichaam\" genoemd en gedefinieerd als: \"de staat, zijn territoriale lichamen, publiekrechtelijke instellingen, en verenigingen gevormd door een of meer van deze lichamen of een of meer van deze publiekrechtelijke instellingen\". En onder een publiekrechtelijke instelling verstaat men \" iedere instelling die a) is opgericht met het specifieke doel te voorzien in behoeften van algemeen belang die niet van industriële of commerciële aard zijn, en b) rechtspersoonlijkheid heeft, en c) waarvan hetzij de activiteiten in hoofdzaak door de staat of zijn territoriale lichamen of andere publiekrechtelijke instellingen worden gefinancierd, hetzij het beheer is onderworpen aan toezicht door deze laatste, hetzij de leden van het bestuursorgaan, het leidinggevend orgaan of het toezichthoudend orgaan voor meer dan de helft door de staat, zijn territoriale lichamen of andere publiekrechtelijke instellingen zijn aangewezen.\"."@nl;
  rdfs:comment "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector,ongeacht het bestuursniveau waarop dat kader van kracht is."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#PubliekeOrganisatie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "werkingsgebied"@nl;
    rdfs:comment "Administratief gebied dat de Publieke Organisatie dekt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#PubliekeOrganisatie.Werkingsgebied>;
    shacl:class dc:Location;
    shacl:description "Administratief gebied dat de Publieke Organisatie dekt."@nl;
    shacl:name "werkingsgebied"@nl;
    shacl:path dc:spatial
  ];
  shacl:targetClass <http://data.europa.eu/m8g/PublicOrganisation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#PuntShape> a shacl:NodeShape;
  rdfs:label "Punt"@nl;
  rdfs:comment "Een 0-dimensioneel geometrisch object dat een bepaalde locatie in een coördinaatruimte voorstelt. Heeft een x-coördinaat en een y-coördinaat. Kan ook een z-coördinaat (hoogte) en een m-coördinaat (afstand langs een curve) hebben."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Punt>;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#Point> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ReisShape> a shacl:NodeShape;
  rdfs:label "Reis"@nl;
  <http://purl.org/vocab/vann/usageNote> "De reis verloopt eventueel via andere Locaties. De Locatie waar de Reis begint kan gelijk zijn aan deze waar de Reis eindigt (bijvoorbeeld heen- en terugreis)."@nl;
  rdfs:comment "Vrijwillige verplaatsing van een Persoon van de ene Locatie naar een andere Locatie."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reis>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "vertrektijd"@nl;
    <http://purl.org/vocab/vann/usageNote> "Doorgaans wordt enkel een vertrek- of een aankomsttijdstip opgegeven."@nl;
    rdfs:comment "Tijdstip waarop de Reis aanvangt of waarop de Reiziger zou willen dat ze aanvangt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reis.Vertrektijd>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de Reis aanvangt of waarop de Reiziger zou willen dat ze aanvangt."@nl;
    shacl:maxCount 1;
    shacl:name "vertrektijd"@nl;
    shacl:path schemas:departureTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "aankomsttijd"@nl;
    <http://purl.org/vocab/vann/usageNote> "Doorgaans wordt enkel een vertrek- of een aankomsttijdstip opgegeven."@nl;
    rdfs:comment "Tijdstip waarop de Reis afgelopen is of waarop de Reiziger zou willen dat ze is afgelopen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reis.Aankomsttijd>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de Reis afgelopen is of waarop de Reiziger zou willen dat ze is afgelopen."@nl;
    shacl:maxCount 1;
    shacl:name "aankomsttijd"@nl;
    shacl:path schemas:arrivalTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "reisweg"@nl;
    <http://purl.org/vocab/vann/usageNote> "Inclusief de Locatie waar de Reis aanvangt en eindigt."@nl;
    rdfs:comment "Opeenvolging van Locaties die men tijdens de Reis wil aandoen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reis.Reisweg>;
    shacl:class prov:Location;
    shacl:description "Opeenvolging van Locaties die men tijdens de Reis wil aandoen."@nl;
    shacl:minCount 2;
    shacl:name "reisweg"@nl;
    shacl:path schemas:itinerary
  ], [
    a shacl:PropertyShape;
    rdfs:label "deelVanReis"@nl;
    rdfs:comment "Deel van een volledige Reis dat op zichzelf ook beschouwd kan worden als een Reis."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reis.DeelVanReis>;
    shacl:class schemas:Trip;
    shacl:description "Deel van een volledige Reis dat op zichzelf ook beschouwd kan worden als een Reis."@nl;
    shacl:name "deelVanReis"@nl;
    shacl:path schemas:partOfTrip
  ], [
    a shacl:PropertyShape;
    rdfs:label "mogelijkeRoute"@nl;
    rdfs:comment "Routes die gevolgd kunnen worden om de Reis uit te voeren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reis.MogelijkeRoute>;
    shacl:description "Routes die gevolgd kunnen worden om de Reis uit te voeren."@nl;
    shacl:name "mogelijkeRoute"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Route>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Routesegment>]);
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#mogelijkeRoute>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gekozenRoute"@nl;
    <http://purl.org/vocab/vann/usageNote> "Eventueel meer dan 1 gekozen Route als de reiziger onderweg van Route verandert."@nl;
    rdfs:comment "Route die de Reiziger kiest uit de mogelijke Routes."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reis.GekozenRoute>;
    shacl:description "Route die de Reiziger kiest uit de mogelijke Routes."@nl;
    shacl:name "gekozenRoute"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Route>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Routesegment>]);
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#gekozenRoute>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdeRoute"@nl;
    <http://purl.org/vocab/vann/usageNote> "Werkelijke aankomst- en vertrektijdstip, reisduur etc."@nl;
    rdfs:comment "Route die uiteindelijk uitgevoerd is om de Reis te realiseren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reis.UitgevoerdeRoute>;
    shacl:description "Route die uiteindelijk uitgevoerd is om de Reis te realiseren."@nl;
    shacl:maxCount 1;
    shacl:name "uitgevoerdeRoute"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Route>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Routesegment>]);
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#uitgevoerdeRoute>
  ];
  shacl:targetClass schemas:Trip .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ReizigerShape> a shacl:NodeShape;
  rdfs:label "Reiziger"@nl;
  rdfs:comment "Persoon die een Reis onderneemt of wil ondernemen."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reiziger>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "pseudoniem"@nl;
    <http://purl.org/vocab/vann/usageNote> "Doel is dat de werkelijke identiteit van de Reiziger niet meer achterhaald kan worden maar dat tripdata toch op individueel niveau bestudeerd kan worden."@nl;
    rdfs:comment "Naam van de Reiziger die afwijkt van zijn werkelijke naam."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reiziger.Pseudoniem>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Pseudoniem>;
    shacl:description "Naam van de Reiziger die afwijkt van zijn werkelijke naam."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "pseudoniem"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#pseudoniem>
  ], [
    a shacl:PropertyShape;
    rdfs:label "onderneemt"@nl;
    rdfs:comment "Reis die een Reiziger onderneemt of wil ondernemen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reiziger.Onderneemt>;
    shacl:class schemas:Trip;
    shacl:description "Reis die een Reiziger onderneemt of wil ondernemen."@nl;
    shacl:name "onderneemt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#onderneemt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isMedereizigerVan"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de kinderen van een gezin dat samenreist. Van belang bij bijvoorbeeld bij het bepalen van de prijs van een Vervoersbewijs wanneer jonge kinderen gratis meereizen."@nl;
    rdfs:comment "Reiziger die de Reiziger vergezelt tijdens de Reis."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Reiziger.IsMedereizigerVan>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Reiziger>;
    shacl:description "Reiziger die de Reiziger vergezelt tijdens de Reis."@nl;
    shacl:name "isMedereizigerVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#isMedereizigerVan>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Reiziger> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceRapportShape> a shacl:NodeShape;
  rdfs:label "ResourceRapport"@nl;
  <http://purl.org/vocab/vann/usageNote> "Voorbeeld: Het aantal beschikbare deelfietsen aan een treinstation op een welbepaalde locatie."@nl;
  rdfs:comment "Het rapport van het aantal Resources met gelijkaardige karakteristieken van beschikbaarheid, type, service, locatie etc die beschikbaar zijn op een welbepaald tijdstip."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceRapport>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "rapportTijd"@nl;
    rdfs:comment "Tijdstip van beschikbaarheid van het rapport."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceRapport.RapportTijd>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip van beschikbaarheid van het rapport."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "rapportTijd"@nl;
    shacl:path dc11:date
  ], [
    a shacl:PropertyShape;
    rdfs:label "nummer"@nl;
    rdfs:comment "Het aantal Resources."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceRapport.Nummer>;
    shacl:datatype xsd:integer;
    shacl:description "Het aantal Resources."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "nummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#ResourceReport.nummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Het type van de Resource."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceRapport.Type>;
    shacl:description "Het type van de Resource."@nl;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voorbeeld: gereserveerd, inactief, beschikbaar. Dit veld bepaald of een Resource al dan niet kan gebruikt worden."@nl;
    rdfs:comment "De status van de Resource."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceRapport.Status>;
    shacl:description "De status van de Resource."@nl;
    shacl:name "status"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#ResourceReport.status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "service"@nl;
    rdfs:comment "De Mobiliteitsdienst die gebruikt wordt binnen het ResourceRapport."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceRapport.Service>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Mobiliteitsdienst>;
    shacl:description "De Mobiliteitsdienst die gebruikt wordt binnen het ResourceRapport."@nl;
    shacl:name "service"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#ResourceReport.reportTijd>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aandrijving"@nl;
    rdfs:comment "Aandrijving van het vervoermiddel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceRapport.Aandrijving>;
    shacl:description "Aandrijving van het vervoermiddel."@nl;
    shacl:name "aandrijving"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#ResourceReport.aandrijving>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:comment "Locatie van de Resource."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceRapport.Locatie>;
    shacl:class prov:Location;
    shacl:description "Locatie van de Resource."@nl;
    shacl:name "locatie"@nl;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "vervoermiddel"@nl;
    <http://purl.org/vocab/vann/usageNote> "."@nl;
    rdfs:comment "Het vervoermiddel van de Resource."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceRapport.Vervoermiddel>;
    shacl:description "Het vervoermiddel van de Resource."@nl;
    shacl:name "vervoermiddel"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#ResourceReport.vervoermiddel>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#ResourceRapport> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#ResourceShape> a shacl:NodeShape;
  rdfs:label "Resource"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld zitplaats op een trein, deelfiets aan een station, parkeerplaats in een parking."@nl;
  rdfs:comment "Middel dat de Mobiliteitsdienst aan de Reiziger kan aanbieden om zijn verplaatsing te maken."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Resource>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de Resource."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Resource.Type>;
    shacl:description "Aard van de Resource."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit kan bijvoorbeeld de realtime Locatie zijn van het voertuig bijvoorbeeld bij free floating deelvervoer."@nl;
    rdfs:comment "Locatie van de Resource."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Resource.Locatie>;
    shacl:class prov:Location;
    shacl:description "Locatie van de Resource."@nl;
    shacl:maxCount 1;
    shacl:name "locatie"@nl;
