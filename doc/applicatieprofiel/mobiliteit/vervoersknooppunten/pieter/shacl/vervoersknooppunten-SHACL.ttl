  shacl:closed false;
  shacl:targetClass prov:Location .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#MobiliteitsdienstShape> a shacl:NodeShape;
