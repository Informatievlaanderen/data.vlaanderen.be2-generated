    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#aandrijving>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gerealiseerdOp"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de halte waar men overstapt tussen twee metrolijnen, het Adresgebied waarbinnen men overstapt tussen twee vervoersmodi."@nl;
