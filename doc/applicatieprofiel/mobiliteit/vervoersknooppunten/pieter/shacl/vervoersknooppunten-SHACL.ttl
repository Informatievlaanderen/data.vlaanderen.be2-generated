<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#HoppinpuntShape> a shacl:NodeShape;
  rdfs:label "Hoppinpunt"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hoppin is de benaming waaronder de Vlaamse overheid Vervoersknooppunten voor reizigersvervoer aanduidt die voldoen aan vastgelegde (kwaliteits)eisen. Zaken van belang zijn herkenbaarheid (toepassing Hoppin huisstijl), toegankelijkheid (voor alle gebruikers ongeacht hun beperking, leeftijd etc), minimale uitrusting (bijvoorbeeld fietsstallingen, informatiedragers... ), afstemming op mobiliteitsplannen etc."@nl;
  rdfs:comment "Vervoersknooppunt van het mobiliteitsmerk Hoppin."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Hoppinpunt>;
  shacl:closed false;
  shacl:property _:df_2_106,
    _:df_2_127;
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Hoppinpunt> .

