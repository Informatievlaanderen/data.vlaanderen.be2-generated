<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#AanbiederShape> a shacl:NodeShape;
  rdfs:label "Aanbieder"@nl;
  <http://purl.org/vocab/vann/usageNote> "Onder een geregistreerde Organisaties verstaan we een Organisatie met een juridisch statuut (vastgelegd door registratie), bijvoorbeeld NV, VZW..."@nl;
  rdfs:comment "Geregistreerde Organisatie die Mobiliteitsdiensten aanbiedt."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Aanbieder>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Aanbieder.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    <http://purl.org/vocab/vann/usageNote> "In de KBO is dit het ondernemingsnummer."@nl;
    rdfs:comment "Identificator die de organisatie verkreeg bij registratie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Aanbieder.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator die de organisatie verkreeg bij registratie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "registratie"@nl;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Aanbieder.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Aanbieder> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#AanvullendeDienstShape> a shacl:NodeShape;
  rdfs:label "AanvullendeDienst"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld Krantenwinkel, Postdienst of Restaurant in een Station. De Diensten die daarmee worden aangevuld of ondersteund zijn bijvoorbeeld Mobiliteitsdiensten."@nl;
  rdfs:comment "Dienst die een aanvulling biedt op andere Diensten of deze ondersteunt."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#AanvullendeDienst>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van de aanvullende dienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#AanvullendeDienst.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van de aanvullende dienst."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld ticketing, wachtaccomodatie, sanitair, AED…."@nl;
    rdfs:comment "Aard van de aanvullende dienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#AanvullendeDienst.Type>;
    shacl:description "Aard van de aanvullende dienst."@nl;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbaarheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld dienstregeling of openingsuren."@nl;
    rdfs:comment "Beschikbaarheid van de aanvullende dienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#AanvullendeDienst.Beschikbaarheid>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Aanbieder>;
    shacl:description "Beschikbaarheid van de aanvullende dienst."@nl;
    shacl:name "beschikbaarheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#AanvullendeDienst.beschikbaarheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegankelijkheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld of de Mobiliteitsdienst toegankelijk is voor personen met een beperking."@nl;
    rdfs:comment "Toegankelijkheid van de aanvullende dienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#AanvullendeDienst.Toegankelijkheid>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Toegankelijkheid>;
    shacl:description "Toegankelijkheid van de aanvullende dienst."@nl;
    shacl:name "toegankelijkheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#AanvullendeDienst.toegankelijkheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanbieder"@nl;
    rdfs:comment "De aanbieder van de aanvullende dienst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#AanvullendeDienst.Aanbieder>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Aanbieder>;
    shacl:description "De aanbieder van de aanvullende dienst."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aanbieder"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#aanbieder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vervoersknoop"@nl;
    rdfs:comment "Het vervoersknooppunt waarop de aanvullende dienst wordt aangeboden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#AanvullendeDienst.Vervoersknoop>;
    shacl:description "Het vervoersknooppunt waarop de aanvullende dienst wordt aangeboden."@nl;
    shacl:name "vervoersknoop"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Vervoersknooppunt>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#GeregistreerdVervoersknooppunt>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Hoppinpunt>]);
