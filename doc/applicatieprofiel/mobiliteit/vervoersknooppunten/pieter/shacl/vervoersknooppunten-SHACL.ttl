  rdfs:comment "Mate waarin iets voorhanden is voor gebruik."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Beschikbaarheid>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "openingsuren"@nl;
    <http://purl.org/vocab/vann/usageNote> "Syntax volgens schema.org voor openingsuren. Bijvoorbeeld als contact kan worden opgenomen tussen 8 en 20u maandag tot zaterdag en tussen 8 en 18u op zondag wordt dit gecodeerd als Ma-za 08:00-20:00, zo 08:00-18:00."@nl;
    rdfs:comment "Uren waarop iets beschikbaar is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Beschikbaarheid.Openingsuren>;
    shacl:description "Uren waarop iets beschikbaar is."@nl;
