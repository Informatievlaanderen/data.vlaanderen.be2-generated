    shacl:name "infrastructuurelement"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infrastructuurelement>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Informatiedrager>] [shacl:class <https://data.vlaanderen.be/doc/applicatieprofiel/infrastructuurelementen/#Infozuil>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Hoppinzuil>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Datauitwisselingsinfrastructuur>] [shacl:class <http://schema.mobivoc.org/#ParkingFacility>] [shacl:class <http://schema.mobivoc.org/#BicycleParkingStation>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Fietsstalling>] [shacl:class <http://schema.mobivoc.org/#ParkingGarage>] [shacl:class <http://schema.mobivoc.org/#ParkingLot>] [shacl:class <http://schema.mobivoc.org/#UndergroundParkingGarage>] [shacl:class <http://schema.mobivoc.org/#AutomatedParkingGarage>] [shacl:class <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#Lader>] [shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#Quay>] [shacl:class <https://purl.eu/ns/mobility/timetables-and-planning#StopPlace>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Haltepaal>] [shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Bushok>]);
