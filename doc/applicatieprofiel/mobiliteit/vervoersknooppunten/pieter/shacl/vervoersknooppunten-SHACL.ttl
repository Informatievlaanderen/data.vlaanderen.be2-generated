<https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#VervoersknooppuntShape> a shacl:NodeShape;
  rdfs:label "Vervoersknooppunt"@nl;
  <http://purl.org/vocab/vann/usageNote> "Voorbeelden voor reizigersvervoer zijn treinstations, metrostations, busstations, luchthavens, ferry terminals, parkeerterreinen… Voor vrachtvervoer gaat het typisch over luchthavens, zeehavens, overslagterminals. Vervoersknooppunten zijn typisch intermodaal bijvoorbeeld reizigers combineren de (deel)fiets met de trein voor hun verplaatsing, maar ook intramodale overstappen (bijvoorbeeld van de ene buslijn op de andere) zijn belangrijk. Concreet omvat een Vervoersknooppunt infrastructuur (stations, parkeerterreinen, laadinfrastructuur... ), (mobiliteits)diensten (openbaar vervoerslijnen, deelfietsen, winkels... ) en knooppunten in vervoersnetwerken (haltes openbaar vervoer, standplaatsen deelauto's... )."@nl;
  rdfs:comment "Plaats waar passagiers en/of vracht wordt uitgewisseld tussen voertuigen en/of vervoersmodi."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Vervoersknooppunt>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De naam van het Vervoersknooppunt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Vervoersknooppunt.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van het Vervoersknooppunt."@nl;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegankelijkheid"@nl;
    rdfs:comment "De toegankelijkheid van het Vervoersknooppunt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/mobiliteit/vervoersknooppunten/pieter#Vervoersknooppunt.Toegankelijkheid>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Toegankelijkheid>;
    shacl:description "De toegankelijkheid van het Vervoersknooppunt."@nl;
    shacl:name "toegankelijkheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#toegankelijkheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:comment "De locatie van het Vervoersknooppunt."@nl;
