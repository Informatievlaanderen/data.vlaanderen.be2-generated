{
  "title": "AutomaticParkingGarage",
  "type": "object",
  "description": "Parking garage with an automatic parking system that automatically parks vehicles in an available space.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse AutomaticParkingGarage)",
      "pattern": "^AutomaticParkingGarage$"
    },
    "openingHours": {
      "$ref": "#/components/schemas/AutomaticParkingGarage.openingHours"
    },
    "characteristic": {
      "$ref": "#/components/schemas/ParkingFacilityFeatureType"
    },
    "entrance": {
      "type": "array",
      "description": "The entrance to the parking facility. Lijst van Entrance items.",
      "items": {
        "$ref": "#/components/schemas/Entrance"
      },
      "minItems": 1
    },
    "output": {
      "type": "array",
      "description": "The exit of the parking facility. Lijst van Exit items.",
      "items": {
        "$ref": "#/components/schemas/Exit"
      },
      "minItems": 1
    },
    "capacity": {
      "type": "array",
      "description": "The capacity of the parking facility. Lijst van Capacity items.",
      "items": {
        "$ref": "#/components/schemas/Capacity"
      },
      "minItems": 1
    },
    "parking": {
      "type": "array",
      "description": "The parking facility parking lot. Lijst van Parking items.",
      "items": {
        "$ref": "#/components/schemas/Parking"
      },
      "minItems": 1
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Geometry"
        },
        {
          "$ref": "#/components/schemas/Point"
        },
        {
          "$ref": "#/components/schemas/Polygon"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Geometry": "#/components/schemas/Geometry",
          "Point": "#/components/schemas/Point",
          "Polygon": "#/components/schemas/Polygon"
        }
      }
    },
    "validityPeriod": {
      "$ref": "#/components/schemas/PeriodOfProject"
    },
    "accessibility": {
      "type": "array",
      "description": "The overall accessibility characteristics of the infrastructure element. Lijst van Accessibility items.",
      "items": {
        "$ref": "#/components/schemas/Accessibility"
      },
      "minItems": 1
    },
    "identifier": {
      "$ref": "#/components/schemas/Identifier"
    },
    "type": {
      "type": "array",
      "description": "The type of infrastructure element. Lijst van InfrastructureElementType items.",
      "items": {
        "$ref": "#/components/schemas/InfrastructureElementType"
      },
      "minItems": 1
    },
    "service": {
      "type": "array",
      "description": "The service provided by means of the infrastructure element. Lijst van AdditionalService items.",
      "items": {
        "$ref": "#/components/schemas/AdditionalService"
      },
      "minItems": 1
    },
    "transportHub": {
      "type": "array",
      "description": "The transport nodes to which this infrastructure element belongs. Lijst van TransportHub items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TransportHub"
          },
          {
            "$ref": "#/components/schemas/RegisteredTransportHub"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "TransportHub": "#/components/schemas/TransportHub",
            "RegisteredTransportHub": "#/components/schemas/RegisteredTransportHub"
          }
        }
      },
      "minItems": 1
    },
    "transportObject": {
      "type": "array",
      "description": "The transport object belonging to the infrastructure element. Lijst van TransportObject items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TransportKnot"
          },
          {
            "$ref": "#/components/schemas/TransportConnection"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "TransportKnot": "#/components/schemas/TransportKnot",
            "TransportConnection": "#/components/schemas/TransportConnection"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "characteristic",
    "geometry",
    "validityPeriod",
    "identifier"
  ]
}