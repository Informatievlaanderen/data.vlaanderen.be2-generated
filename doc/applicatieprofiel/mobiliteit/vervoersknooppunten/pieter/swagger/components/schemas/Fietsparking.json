{
  "title": "Fietsparking",
  "type": "object",
  "description": "Gebouw of structuur dat benut wordt om fietsen te parkeren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Fietsparking)",
      "pattern": "^Fietsparking$"
    },
    "openingsuren": {
      "$ref": "#/components/schemas/Fietsparking.openingsuren"
    },
    "kenmerk": {
      "$ref": "#/components/schemas/ParkeerfaciliteitKenmerktype"
    },
    "ingang": {
      "type": "array",
      "description": "De ingang van de parkeerfaciliteit. Lijst van Entrance items.",
      "items": {
        "$ref": "#/components/schemas/Entrance"
      },
      "minItems": 1
    },
    "uitgang": {
      "type": "array",
      "description": "De uitgang van de parkeerfaciliteit. Lijst van Exit items.",
      "items": {
        "$ref": "#/components/schemas/Exit"
      },
      "minItems": 1
    },
    "capaciteit": {
      "type": "array",
      "description": "De capaciteit van de parkeerfaciliteit. Lijst van Capaciteit items.",
      "items": {
        "$ref": "#/components/schemas/Capaciteit"
      },
      "minItems": 1
    },
    "parkeerplaats": {
      "type": "array",
      "description": "De parkeerplaats van de parkeerfaciliteit. Lijst van Parkeerplaats items.",
      "items": {
        "$ref": "#/components/schemas/Parkeerplaats"
      },
      "minItems": 1
    },
    "geometrie": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Geometrie"
        },
        {
          "$ref": "#/components/schemas/Punt"
        },
        {
          "$ref": "#/components/schemas/Polygoon"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Geometrie": "#/components/schemas/Geometrie",
          "Punt": "#/components/schemas/Punt",
          "Polygoon": "#/components/schemas/Polygoon"
        }
      }
    },
    "geldigheidsperiode": {
      "$ref": "#/components/schemas/Periode"
    },
    "toegankelijkheid": {
      "type": "array",
      "description": "De algehele toegankelijkheidskenmerken van de het infrastructuurelement. Lijst van Toegankelijkheid items.",
      "items": {
        "$ref": "#/components/schemas/Toegankelijkheid"
      },
      "minItems": 1
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    },
    "type": {
      "type": "array",
      "description": "Het type van infrastructuurelement. Lijst van Infrastructuurelementtype items.",
      "items": {
        "$ref": "#/components/schemas/Infrastructuurelementtype"
      },
      "minItems": 1
    },
    "dienst": {
      "type": "array",
      "description": "De dienst dat wordt aangeboden door middel van het infrastructuurelement. Lijst van AanvullendeDienst items.",
      "items": {
        "$ref": "#/components/schemas/AanvullendeDienst"
      },
      "minItems": 1
    },
    "vervoersknoop": {
      "type": "array",
      "description": "De vervoersknopen waartoe dit infrastructuurelement behoort. Lijst van Vervoersknooppunt items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Vervoersknooppunt"
          },
          {
            "$ref": "#/components/schemas/GeregistreerdVervoersknooppunt"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Vervoersknooppunt": "#/components/schemas/Vervoersknooppunt",
            "GeregistreerdVervoersknooppunt": "#/components/schemas/GeregistreerdVervoersknooppunt"
          }
        }
      },
      "minItems": 1
    },
    "transportobject": {
      "type": "array",
      "description": "Het transportobject horende bij het infrastructuurelement. Lijst van Transportobject items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Transportknoop"
          },
          {
            "$ref": "#/components/schemas/Transportconnectie"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Transportknoop": "#/components/schemas/Transportknoop",
            "Transportconnectie": "#/components/schemas/Transportconnectie"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "kenmerk",
    "geometrie",
    "geldigheidsperiode",
    "identificator"
  ]
}