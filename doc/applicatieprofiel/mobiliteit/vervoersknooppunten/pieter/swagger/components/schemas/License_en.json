{
  "title": "License",
  "type": "object",
  "description": "Formal permission to offer a Mobility Service.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse License)",
      "pattern": "^License$"
    },
    "periodOfProject": {
      "$ref": "#/components/schemas/PeriodOfProject"
    },
    "applicationArea": {
      "type": "array",
      "description": "Territory or Place in which the License applies. Lijst van LocationOsloGeneric items.",
      "items": {
        "$ref": "#/components/schemas/LocationOsloGeneric"
      },
      "minItems": 1
    },
    "transportAuthority": {
      "$ref": "#/components/schemas/PublicOrganization"
    }
  },
  "required": [
    "@type",
    "periodOfProject",
    "applicationArea",
    "transportAuthority"
  ]
}