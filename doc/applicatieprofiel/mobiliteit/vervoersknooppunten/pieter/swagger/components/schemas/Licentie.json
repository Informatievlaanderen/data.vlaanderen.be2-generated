{
  "title": "Licentie",
  "type": "object",
  "description": "Formele toestemming om een Mobiliteitsdienst aan te bieden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Licentie)",
      "pattern": "^Licentie$"
    },
    "periode": {
      "$ref": "#/components/schemas/Periode"
    },
    "toepassingsgebied": {
      "type": "array",
      "description": "Gebied of Plaats waarbinnen de Licentie geldt. Lijst van PlaatsOsloGeneriek items.",
      "items": {
        "$ref": "#/components/schemas/PlaatsOsloGeneriek"
      },
      "minItems": 1
    },
    "vervoersautoriteit": {
      "$ref": "#/components/schemas/PubliekeOrganisatie"
    }
  },
  "required": [
    "@type",
    "periode",
    "toepassingsgebied",
    "vervoersautoriteit"
  ]
}