{
  "title": "Performer",
  "type": "object",
  "description": "Agent performing Mobility Service.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Performer)",
      "pattern": "^Performer$"
    },
    "preferredName": {
      "$ref": "#/components/schemas/Performer.preferredName"
    },
    "registration": {
      "$ref": "#/components/schemas/Identifier"
    },
    "contactInfo": {
      "type": "array",
      "description": "Information such as email, telephone... which allows the contractor to be contacted. Lijst van PointOfContact items.",
      "items": {
        "$ref": "#/components/schemas/PointOfContact"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "preferredName",
    "registration"
  ]
}