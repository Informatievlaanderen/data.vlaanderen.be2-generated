{
  "title": "Resource",
  "type": "object",
  "description": "Means that the Mobility Service can offer to the Traveller to make his journey.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Resource)",
      "pattern": "^Resource$"
    },
    "type": {
      "$ref": "#/components/schemas/ResourceType"
    },
    "location": {
      "$ref": "#/components/schemas/Location"
    },
    "identifier": {
      "$ref": "#/components/schemas/Identifier"
    },
    "status": {
      "$ref": "#/components/schemas/ResourceHealth"
    },
    "meansOfTransport": {
      "type": "array",
      "description": "The type of transport of the Resource. Especially relevant if the resource is a vehicle. Lijst van MeansOfTransport items.",
      "items": {
        "$ref": "#/components/schemas/MeansOfTransport"
      },
      "minItems": 1
    },
    "drive": {
      "type": "array",
      "description": "Drive of the means of transport. Lijst van DriveType items.",
      "items": {
        "$ref": "#/components/schemas/DriveType"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "type"
  ]
}