{
  "title": "Uitvoerder",
  "type": "object",
  "description": "Agent die Mobiliteitsdienst uitvoert.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Uitvoerder)",
      "pattern": "^Uitvoerder$"
    },
    "voorkeursnaam": {
      "$ref": "#/components/schemas/Uitvoerder.voorkeursnaam"
    },
    "registratie": {
      "$ref": "#/components/schemas/Identificator"
    },
    "contactinfo": {
      "type": "array",
      "description": "Informatie zoals email, telefoon... die toelaat de uitvoerder te contacteren. Lijst van Contactpunt items.",
      "items": {
        "$ref": "#/components/schemas/Contactpunt"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "voorkeursnaam",
    "registratie"
  ]
}