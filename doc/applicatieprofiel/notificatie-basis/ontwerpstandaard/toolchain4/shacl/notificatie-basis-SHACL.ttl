@prefix dc: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix schemas: <https://schema.org/> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#> rdfs:member <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#PubliekeDienstverleningShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#PubliekeOrganisatieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#AgentShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#NotificatieberichtShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#AdministratieveEenheidShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#InformeerActieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#MerkShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#ContactinfoShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#StringShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#GetypeerdeStringShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#UriShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#TijdsintervalShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#GeometrieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#DatetimeShape>,
