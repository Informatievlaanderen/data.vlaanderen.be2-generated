    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Sleutel/waardePaarShape> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#AdministratieveEenheidShape> a shacl:NodeShape;
  rdfs:label "Administratieve Eenheid"@nl;
  rdfs:comment "Een geografisch gebied,dat typisch onder de jurisdictie van een bepaalde publieke administratie valt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van de Administratieve Eenheid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#AdministratieveEenheid.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van de Administratieve Eenheid."@nl;
    shacl:maxCount "1";
    shacl:name "naam"@nl;
    shacl:path schemas:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "De geometrische voorstelling van het object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#AdministratieveEenheid.Geometrie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "De geometrische voorstelling van het object."@nl;
    shacl:maxCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geografisch gebied"@nl;
    rdfs:comment "Het geografisch gebied geassocieerd met de doelgroep."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#AdministratieveEenheid.GeografischGebied>;
    shacl:class schemas:Audience;
    shacl:description "Het geografisch gebied geassocieerd met de doelgroep."@nl;
    shacl:name "geografisch gebied"@nl;
    shacl:path schemas:geographicArea
  ];
  shacl:targetClass schemas:AdministrativeArea .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanschrijfvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb De heer/Mevrouw, Excellentie, Dokter..."@nl;
    rdfs:comment "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Contactinfo.Aanschrijfvorm>;
    shacl:datatype rdf:langString;
    shacl:description "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    shacl:maxCount "1";
    shacl:name "aanschrijfvorm"@nl;
    shacl:path vcard:honorific-prefix
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam van bvb de persoon die men kan contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Contactinfo.Contactnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van bvb de persoon die men kan contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactnaam"@nl;
    shacl:path foaf:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Contactinfo.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schema:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "fax"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Faxnummer waarnaar men kan faxen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Contactinfo.Fax>;
    shacl:datatype xsd:string;
    shacl:description "Faxnummer waarnaar men kan faxen."@nl;
    shacl:maxCount "1";
    shacl:name "fax"@nl;
    shacl:path schema:faxNumber
  ], [
    a shacl:PropertyShape;
    rdfs:label "openingsuren"@nl;
    <http://purl.org/vocab/vann/usageNote> "Syntax volgens schema.org voor openingsuren. Bv als contact kan worden opgenomen tussen 8 en 20u maandag tot zaterdag en tussen 8 en 18u op zondag wordt dit gecodeerd als Ma-za 08:00-20:00, zo 08:00-18:00."@nl;
    rdfs:comment "Uren waarbinnen contact kan worden opgenomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Contactinfo.Openingsuren>;
    shacl:datatype rdfs:Literal;
    shacl:description "Uren waarbinnen contact kan worden opgenomen."@nl;
    shacl:maxCount "1";
    shacl:name "openingsuren"@nl;
    shacl:path schema:openingHours
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Contactinfo.Telefoon>;
    shacl:datatype xsd:string;
    shacl:description "Telefoonnummer waarop men kan bellen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schema:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "website"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Website waarnaar men kan surfen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Contactinfo.Website>;
    shacl:datatype xsd:anyURI;
    shacl:description "Website waarnaar men kan surfen."@nl;
    shacl:maxCount "1";
    shacl:name "website"@nl;
    shacl:path foaf:page
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Contactinfo.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven of bezoeken."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbaarheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv aanduiding van het seizoen waarin contact kan worden opgenomen. Begin- en einddatum volgens ISO8601 syntax."@nl;
    rdfs:comment "Periode waarin contact kan worden opgenomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Contactinfo.Beschikbaarheid>;
    shacl:class schema:OpeningHoursSpecification;
    shacl:description "Periode waarin contact kan worden opgenomen."@nl;
    shacl:maxCount "1";
    shacl:name "beschikbaarheid"@nl;
    shacl:path schema:hoursAvailable
  ];
  shacl:targetClass schema:ContactPoint .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#DoelgroepShape> a shacl:NodeShape;
  rdfs:label "Doelgroep"@nl;
  rdfs:comment "De beoogde doelgroep van een informeer actie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "doelgroep type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Er wordt verwacht dat het type doelgroep gedefinieerd is in een codelijst. Het bepalen en ontlsuiten van deze codelijst kan applicatie-specifiek worden ingevuld. Voorbeelden zijn leerkrachten, vastgoedeigenaars, personen die een auto bezitten,..."@nl;
    rdfs:comment "Een typering van de doelgroep."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Doelgroep.DoelgroepType>;
    shacl:datatype xsd:string;
    shacl:description "Een typering van de doelgroep."@nl;
    shacl:maxCount "1";
    shacl:name "doelgroep type"@nl;
    shacl:path schemas:audienceType
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Kan bijvoorbeeld een specifieke persoon of organisatie identificeren, of een groep van personen of organisaties."@nl;
    rdfs:comment "Een identificator voor de doelgroep."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Doelgroep.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een identificator voor de doelgroep."@nl;
    shacl:maxCount "1";
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geografisch gebied"@nl;
    rdfs:comment "Het geografisch gebied geassocieerd met de doelgroep."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Doelgroep.GeografischGebied>;
    shacl:class schemas:AdministrativeArea;
    shacl:description "Het geografisch gebied geassocieerd met de doelgroep."@nl;
    shacl:name "geografisch gebied"@nl;
    shacl:path schemas:geographicArea
  ];
  shacl:targetClass schemas:Audience .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#GeografischeNaamShape> a shacl:NodeShape;
  rdfs:label "Geografische Naam"@nl;
  rdfs:comment "Benaming toegekend aan of gebruikt voor een geografisch object."@nl;
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#GeometrieShape> a shacl:NodeShape;
  rdfs:label "Geometrie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijft deze kenmerken dmv punten, lijnen, polygonen en coördinaten."@nl;
  rdfs:comment "Vorm- en positiekenmerken van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gml"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#gmlLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in gml-formaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Geometrie.Gml>;
    shacl:datatype rdfs:Literal;
    shacl:description "Geometrie uitgedrukt in gml-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "gml"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#asGML>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wkt"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#wktLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in wkt-formaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#Geometrie.Wkt>;
    shacl:datatype rdfs:Literal;
    shacl:description "Geometrie uitgedrukt in wkt-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "wkt"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#asWKT>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Geometry> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#GetypeerdeStringShape> a shacl:NodeShape;
  rdfs:label "Getypeerde String"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb '20170901' als string en 'datum' als type. Laat automatische interpretatie vd string toe."@nl;
  rdfs:comment "Combinatie van een string en het type van wat de string voorstelt."@nl;
  shacl:closed false;
  shacl:targetClass rdfs:Literal .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#InformeerActieShape> a shacl:NodeShape;
  rdfs:label "Informeer Actie"@nl;
  rdfs:comment "Kennisgeving van informatie aan zij die het aanbelangt. Deze informatie kan via meerdere kanalen naar een individu of naar een doelgroep genotificeerd worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "doelgroep"@nl;
    rdfs:comment "De bestemmeling(en) die de informatie dien(t)(en) te ontvangen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#InformeerActie.Doelgroep>;
    shacl:class schemas:Audience;
    shacl:description "De bestemmeling(en) die de informatie dien(t)(en) te ontvangen."@nl;
    shacl:minCount "1";
    shacl:name "doelgroep"@nl;
    shacl:path schema:recipient
  ], [
    a shacl:PropertyShape;
    rdfs:label "inhoud"@nl;
    <http://purl.org/vocab/vann/usageNote> "De inhoudt van een Notificatiebericht wordt gevormd door een aantal key-value pairs."@nl;
    rdfs:comment "De inhoud van een Notificatiebericht."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#InformeerActie.Inhoud>;
    shacl:class schemas:PropertyValue;
    shacl:description "De inhoud van een Notificatiebericht."@nl;
    shacl:name "inhoud"@nl;
    shacl:path <https://data.vlaanderen.be/ns/notificatie#inhoud>
  ], [
    a shacl:PropertyShape;
    rdfs:label "notificatiekanaal"@nl;
    <http://purl.org/vocab/vann/usageNote> "Er wordt verwacht dat het notificatiekanaal gedefinieerd is in een codelijst. Het bepalen en ontlsuiten van deze codelijst kan applicatie-specifiek worden ingevuld. Mogelijke waarden zijn sms en e-mail."@nl;
    rdfs:comment "Het notificatiekanaal duidt het technisch medium aan waarlangs het Notificatiebericht wordt verzonden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#InformeerActie.Notificatiekanaal>;
    shacl:class skos:Concept;
    shacl:description "Het notificatiekanaal duidt het technisch medium aan waarlangs het Notificatiebericht wordt verzonden."@nl;
    shacl:minCount "1";
    shacl:name "notificatiekanaal"@nl;
    shacl:path <https://data.vlaanderen.be/ns/notificatie#notificatiekanaal>
  ], [
    a shacl:PropertyShape;
    rdfs:label "onderwerp"@nl;
    <http://purl.org/vocab/vann/usageNote> "Er wordt verwacht dat de notificatiecategorie gedefinieerd is in een codelijst. Het bepalen en ontlsuiten van deze codelijst kan applicatie-specifiek worden ingevuld."@nl;
    rdfs:comment "Het onderwerp van de informeer actie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#InformeerActie.Onderwerp>;
    shacl:class skos:Concept;
    shacl:description "Het onderwerp van de informeer actie."@nl;
    shacl:minCount "1";
    shacl:name "onderwerp"@nl;
    shacl:path schemas:about
  ], [
    a shacl:PropertyShape;
    rdfs:label "periode verzending"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld, wanneer het stedelijk zwembad een week gesloten is, kan de periode voor verzending van de Informeer Actie beginnen een maand voor de sluiting en eindigen op de laatste dag van de sluitingsperiode."@nl;
    rdfs:comment "Het tijdsinterval waarbinnen de Informeer Actie relevant is en bijgevolg kan resulteren in de verzending van notificatieberichten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#InformeerActie.PeriodeVerzending>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Het tijdsinterval waarbinnen de Informeer Actie relevant is en bijgevolg kan resulteren in de verzending van notificatieberichten."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "periode verzending"@nl;
    shacl:path <https://data.vlaanderen.be/ns/notificatie#periodeVerzending>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is gerelateerd met"@nl;
    rdfs:comment "Een relatie tussen twee Informeer Acties."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#InformeerActie.IsGerelateerdMet>;
    shacl:class schemas:InformAction;
    shacl:description "Een relatie tussen twee Informeer Acties."@nl;
    shacl:name "is gerelateerd met"@nl;
    shacl:path dc:relation
  ], [
    a shacl:PropertyShape;
    rdfs:label "resulteert in"@nl;
    rdfs:comment "De relatie tussen een Informeer Actie en het (de) Notificatiebericht(en) die hier uit voortkomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/notificatie-basis/ontwerpstandaard/toolchain4#InformeerActie.ResulteertIn>;
    shacl:class <https://data.vlaanderen.be/ns/notificatie#Notificatiebericht>;
    shacl:description "De relatie tussen een Informeer Actie en het (de) Notificatiebericht(en) die hier uit voortkomen."@nl;
    shacl:name "resulteert in"@nl;
    shacl:path <https://data.vlaanderen.be/ns/notificatie#InformeerActie.resulteertIn>
  ], [
    a shacl:PropertyShape;
    rdfs:label "agent"@nl;
    rdfs:comment "Duidt de agent aan die aanleiding gaf tot de InformeerActie."@nl;
