  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#InhoudShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Kan een verzoek zijn, een melding, een vaststelling, een normatieve bepaling, een procedurele beslissing, enzovoort. Eén rechtshandeling kan meerdere inhoudelijke punten inhouden. Gebruikers worden aangezet om het soort inhoud te classificeren volgens gemeenschappelijke codelijsten."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Dat wat een rechtshandeling inhoudt."
      }
    ],
