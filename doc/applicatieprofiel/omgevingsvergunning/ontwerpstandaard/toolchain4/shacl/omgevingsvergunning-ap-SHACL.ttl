<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#AanvraagShape> a shacl:NodeShape;
  rdfs:label "Aanvraag"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de context van omgevingsvergunningen betreft dit alle aanvragen van of met betrekking tot omgevingsvergunningen."@nl;
  rdfs:comment "Aanspraak op de uitoefening van een bevoegdheid; formeel verzoek van een rechtssubject aan een bevoegde instantie om informatie te verstrekken of een beslissing te nemen, in het bijzonder een beslissing om ergens toelating voor te verlenen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanvrager"@nl;
    rdfs:comment "Rechtssubject of rechtssubjecten die de aanvraag indient(-en) of namens wie deze wordt ingediend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Aanvraag.Aanvrager>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Rechtssubject>;
    shacl:description "Rechtssubject of rechtssubjecten die de aanvraag indient(-en) of namens wie deze wordt ingediend."@nl;
    shacl:name "aanvrager"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#verantwoordelijke>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Aanvraag> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#ActiviteitShape> a shacl:NodeShape;
  rdfs:label "Activiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Maakt het voorwerp uit van vergunningsaanvragen, meldingen, vergunningsbesluiten, vaststellingen."@nl;
  rdfs:comment "Geheel van handelingen die een of meerdere Rechtssubjecten binnen een welbepaald tijdsbestek en op een welbepaalde locatie ten uitvoer (willen) (laten) brengen en die gezien hun aard te kwalificeren zijn en dus geregeld zijn onder één of meer welbepaalde Juridische Categorieën."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "De beschrijving van de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Activiteit.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "De beschrijving van de Activiteit."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:comment "Aanduiding van de plaats waar een Activiteit plaatsvindt, plaats zal vinden, of plaatsvond."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Activiteit.Locatie>;
    shacl:class dc:Location;
    shacl:description "Aanduiding van de plaats waar een Activiteit plaatsvindt, plaats zal vinden, of plaatsvond."@nl;
    shacl:name "locatie"@nl;
    shacl:path <http://www.w3.org/ns/locn#location>
  ], [
    a shacl:PropertyShape;
    rdfs:label "juridische kwalificatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "De gebruikte codelijst kan een andere zijn dan die gebruikt wordt voor Rechtshandelingen."@nl;
    rdfs:comment "De Juridische Kwalificatie van de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Activiteit.JuridischeKwalificatie>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#JuridischeCategorie>;
    shacl:description "De Juridische Kwalificatie van de Activiteit."@nl;
    shacl:name "juridische kwalificatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#juridischeKwalificatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "tijdsbestek"@nl;
    rdfs:comment "Aanduiding van het tijdsbestek van de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Activiteit.Tijdsbestek>;
    shacl:class <http://www.w3.org/2006/time#TemporalDuration>;
    shacl:description "Aanduiding van het tijdsbestek van de Activiteit."@nl;
    shacl:name "tijdsbestek"@nl;
    shacl:path dc:extent
  ], [
    a shacl:PropertyShape;
    rdfs:label "verantwoordelijke"@nl;
    rdfs:comment "Rechtssubject verantwoordelijk voor de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Activiteit.Verantwoordelijke>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Rechtssubject>;
    shacl:description "Rechtssubject verantwoordelijk voor de Activiteit."@nl;
    shacl:name "verantwoordelijke"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#verantwoordelijke>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is deel van"@nl;
    <http://purl.org/vocab/vann/usageNote> "Laat toe om een complexe Activiteit als een geneste datastructuur uit te werken."@nl;
    rdfs:comment "Verwijzing naar omvattende Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Activiteit.IsDeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Activiteit>;
    shacl:description "Verwijzing naar omvattende Activiteit."@nl;
    shacl:maxCount 1;
    shacl:name "is deel van"@nl;
    shacl:path dc:isPartOf
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Activiteit> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#BekendmakingShape> a shacl:NodeShape;
  rdfs:label "Bekendmaking"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het kader van omgevingsvergunningsaanvragen is een aanplakking een vorm van Publicatie. Zo ook de bekendmaking op de website van een gemeente. Gebruik Notificatie voor een gerichte bekendmaking aan een betrokkene."@nl;
  rdfs:comment "Bekendmaking aan het brede publiek."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Bekendmaking> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#BeroepsmogelijkheidShape> a shacl:NodeShape;
  rdfs:label "Beroepsmogelijkheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Mogelijkheid om in beroep te gaan tegen een gemeentelijke vergunningsbeslissing in eerste aanleg. Of jurisdictioneel beroep tegen een beslissing in laatste administratieve aanleg."@nl;
  rdfs:comment "Procedurestap die de mogelijkheid biedt om een bestuurlijke rechtshandeling of gerechtelijke beslissing aan te vechten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanwendingstermijn"@nl;
    rdfs:comment "Termijn binnen dewelke de Beroepsmogelijkheid aangewend mag worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Beroepsmogelijkheid.Aanwendingstermijn>;
    shacl:class <http://www.w3.org/2006/time#TemporalDuration>;
    shacl:description "Termijn binnen dewelke de Beroepsmogelijkheid aangewend mag worden."@nl;
    shacl:maxCount "1";
    shacl:name "aanwendingstermijn"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#termijn>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bevoegde overheid"@nl;
    rdfs:comment "De Publieke Organisatie bevoegd om zich over de Beroepsmogelijkheid uit te spreken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Beroepsmogelijkheid.BevoegdeOverheid>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "De Publieke Organisatie bevoegd om zich over de Beroepsmogelijkheid uit te spreken."@nl;
    shacl:name "bevoegde overheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#bevoegdeOverheid>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Beroepsmogelijkheid> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#BestuurlijkeRechtshandelingShape> a shacl:NodeShape;
  rdfs:label "Bestuurlijke Rechtshandeling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Voorbeelden van eenzijdige bestuurlijke rechtshandelingen zijn: besluiten van algemene strekking, uitvaardiging van voorschriften, beschikkingen zoals erkenningen en vergunningen en aktenamen. Breid deze klasse uit met de nodige specilisaties of typeringen."@nl;
  rdfs:comment "Handeling, uitgaande van een bestuur, die de rechtstoestand wijzigt, dan wel belet dat deze wordt gewijzigd."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "verantwoordelijke"@nl;
    rdfs:comment "De Publieke Organisatie verantwoordelijk voor de Bestuurlijke Rechtshandeling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#BestuurlijkeRechtshandeling.Verantwoordelijke>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "De Publieke Organisatie verantwoordelijk voor de Bestuurlijke Rechtshandeling."@nl;
    shacl:maxCount "1";
    shacl:name "verantwoordelijke"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#verantwoordelijke>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#BestuurlijkeRechtshandeling> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#DateShape> a shacl:NodeShape;
  rdfs:label "Date";
  shacl:closed false;
  shacl:targetClass xsd:date .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#DatumShape> a shacl:NodeShape;
  rdfs:label "Datum"@nl;
  shacl:closed false;
  shacl:targetClass xsd:date .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#DocumentShape> a shacl:NodeShape;
  rdfs:label "Document"@nl;
  <http://purl.org/vocab/vann/usageNote> "Omvat elektronische en niet-elektronische vormen. De gegevensdrager kan gefragmenteerd zijn, zoals een papieren document bestaande uit meerdere vellen, of een digitaal document bestaande uit meerdere bestanden. Eveneens kan één gegevensdrager meerdere documenten bevatten, zoals een digital bestand dat een scan is van meerdere documenten."@nl;
  rdfs:comment "Logisch geheel van informatie vastgelegd op een gegevensdrager in welke vorm ook."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "waarmerk"@nl;
    rdfs:comment "Waarheidskenmerk van het Document."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Document.Waarmerk>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Waarmerk>;
    shacl:description "Waarheidskenmerk van het Document."@nl;
    shacl:name "waarmerk"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#waarmerk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Gestructureerde identificator van het Document."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Document.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Gestructureerde identificator van het Document."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vindplaats"@nl;
    rdfs:comment "De fysieke of digitale locatie waar het Document zich bevindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Document.Vindplaats>;
    shacl:class prov:Location;
    shacl:description "De fysieke of digitale locatie waar het Document zich bevindt."@nl;
    shacl:maxCount "1";
    shacl:name "vindplaats"@nl;
    shacl:path prov:atLocation
  ];
  shacl:targetClass foaf:Document .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#DossierShape> a shacl:NodeShape;
  rdfs:label "Dossier"@nl;
  rdfs:comment "Samenhangend geheel van stukken die betrekking hebben op een bepaalde zaak."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De naam van het dossier."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Dossier.Naam>;
    shacl:datatype xsd:string;
    shacl:description "De naam van het dossier."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Een identificator voor het dossier."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Dossier.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een identificator voor het dossier."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "informatieclassificatie"@nl;
    rdfs:comment "Duidt aan welke veiligheidsmaatregelen (waaronder toegangsmaatregelen) genomen moeten worden voor het Dossier."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Dossier.Informatieclassificatie>;
    shacl:class skos:Concept;
    shacl:description "Duidt aan welke veiligheidsmaatregelen (waaronder toegangsmaatregelen) genomen moeten worden voor het Dossier."@nl;
    shacl:maxCount "1";
    shacl:name "informatieclassificatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#informatieclassificatie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/dossier#Dossier> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#InhoudShape> a shacl:NodeShape;
  rdfs:label "Inhoud"@nl;
  <http://purl.org/vocab/vann/usageNote> "Kan een verzoek zijn, een melding, een vaststelling, een normatieve bepaling, een procedurele beslissing, enzovoort. Eén rechtshandeling kan meerdere inhoudelijke punten inhouden. Gebruikers worden aangezet om het soort inhoud te classificeren volgens gemeenschappelijke codelijsten."@nl;
  rdfs:comment "Dat wat een rechtshandeling inhoudt."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Inhoud> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#InstellingBeroepShape> a shacl:NodeShape;
  rdfs:label "Instelling Beroep"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld, de instelling van een administratief beroep tegen een welbepaalde gemeentelijke vergunningsbeslissing in eerste aanleg. Instelling van een jurisdictioneel beroep tegen een welbepaalde beslissing in laatste administratieve aanleg."@nl;
  rdfs:comment "Instellen van een beroep met betrekking tot een concrete aanvechtbare Rechtshandeling."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "verzoekende partij"@nl;
    rdfs:comment "Partij die de Beroepsmogelijkheid aanwendt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#InstellingBeroep.VerzoekendePartij>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Rechtssubject>;
    shacl:description "Partij die de Beroepsmogelijkheid aanwendt."@nl;
    shacl:name "verzoekende partij"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#verantwoordelijke>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ingestelde beroepsmogelijkheid"@nl;
    rdfs:comment "Verwijzing naar de ingestelde beroepsmogelijkheid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#InstellingBeroep.IngesteldeBeroepsmogelijkheid>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Beroepsmogelijkheid>;
    shacl:description "Verwijzing naar de ingestelde beroepsmogelijkheid."@nl;
    shacl:maxCount 1;
    shacl:name "ingestelde beroepsmogelijkheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#ingesteldeBeroepsmogelijkheid>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#InstellingBeroep> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#JuridischWerkShape> a shacl:NodeShape;
  rdfs:label "Juridisch Werk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Omvat o.a. wetgeving en regelgeving, publiek- en privaatrechtelijke rechtshandelingen van rechtscolleges, bestuurlijke instanties en andere rechtssubjecten. Rechtsleer valt hier ook onder, alsook juridische typologieën (Juridische Categorie). Technocratische instrumenten, zoals standaarden, specificaties en implementaties daarvan die een juridische functie vervullen zijn door deze entiteit gedekt. Een Juridisch Werk vindt doorgaans zijn neerslag in één of meer Documenten. De rechtswaarde van een Juridisch Werk hangt o.a. af van het bestaan van een authentieke versie (Document) die is bekendgemaakt volgens de voorziene voorschriften. Breder dan http://data.europa.eu/eli/ontology#LegalResource die beperkt is tot wetgevende werken."@nl;
  rdfs:comment "Werken opgemaakt voor juridische doeleinden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Recherlijke uitspraken kunnen bijvoorbeeld van de ECLI identificatieschema gebruik maken. Wetgevende werken zijn in scope van ELI. Andere voorbeeld, de gestructureerde identificator van een omgevingsbesluit in het beheersysteem van een gemeente."@nl;
    rdfs:comment "Gestructureerde identificator van het Juridisch Werk."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#JuridischWerk.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Gestructureerde identificator van het Juridisch Werk."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#JuridischWerk> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#JuridischeCategorieShape> a shacl:NodeShape;
  rdfs:label "Juridische Categorie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een juridische kwalificatie gebeurt aan de hand van juridische verwijzingen, nl. verwijzingen naar Juridische Werken. Het is mogelijk om een juridische kwalificatie op verschillende dimensies (bv. een activiteit kwalificeren op vlak van indelingsrubrieken en op vlak van Sevezo-regelgeving) te doen."@nl;
  rdfs:comment "Onder Juridische Categorie verstaan we rubrieken, klasseringen of juridisch-verankerde typeringen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "juridisch werk"@nl;
    rdfs:comment "De rechtsbron van de Juridische Categorie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#JuridischeCategorie.JuridischWerk>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#JuridischWerk>;
    shacl:description "De rechtsbron van de Juridische Categorie."@nl;
    shacl:maxCount 1;
    shacl:name "juridisch werk"@nl;
    shacl:path skos:note
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#JuridischeCategorie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#JuridischeGebeurtenisShape> a shacl:NodeShape;
  rdfs:label "Juridische Gebeurtenis"@nl;
  <http://purl.org/vocab/vann/usageNote> "Is een abstract klasse: gebruik specialisaties. Deze gebeurtenissen vormen de basis waarop de Vergunde Toestand wordt bepaald."@nl;
  rdfs:comment "Rechtsfeiten alsook rechtshandelingen en zaakhandelingen binnen de context van omgevingsvergunning."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#JuridischeGebeurtenis> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#LocatieShape> a shacl:NodeShape;
  rdfs:label "Locatie"@nl;
  rdfs:comment "Generieke aanknopingspunt voor ruimtelijke data."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De identificator van de Locatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Locatie.Identificator>;
