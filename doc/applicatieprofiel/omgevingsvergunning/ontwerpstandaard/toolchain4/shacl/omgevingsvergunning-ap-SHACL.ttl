<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#ZaakShape> a shacl:NodeShape;
  rdfs:label "Zaak"@nl;
  <http://purl.org/vocab/vann/usageNote> "De bevoegde overheid geniet daarbij een zekere graad van vrijheid maar is tevens gebonden aan procedurele voorschriften. De overheid heeft bijvoorbeeld de mogelijkheid om aanvragen, verzoeken of klachten samen te voegen en gezamenlijk te behandelen. Op de werkvloer wordt vaak de term dossier afwisselend in deze betekenis gebruikt of in de betekenis van OSLO Dossier zijnde een neerslag van een Zaak in een geheel van stukken. In casemanagement systemen die CMMN implementeren komt deze entiteit overeen met een Case."@nl;
  rdfs:comment "Een Zaak is de uitwerking van een bepaalde overheidsbevoegdheid op een specifieke kwestie of situatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "verantwoordelijke"@nl;
    rdfs:comment "De Publieke Organisatie verantwoordelijk voor de opvolging van de Zaak."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Zaak.Verantwoordelijke>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "De Publieke Organisatie verantwoordelijk voor de opvolging van de Zaak."@nl;
    shacl:maxCount "1";
    shacl:name "verantwoordelijke"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#verantwoordelijke>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld, de OMV-referentie van een Zaak in het Omgevingsloket."@nl;
    rdfs:comment "Gestructureerde identificator van de Zaak."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Zaak.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Gestructureerde identificator van de Zaak."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "dossier"@nl;
    rdfs:comment "Het dossier waarin deze zaak wordt behandeld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Zaak.Dossier>;
    shacl:class <https://data.vlaanderen.be/ns/dossier#Dossier>;
    shacl:description "Het dossier waarin deze zaak wordt behandeld."@nl;
    shacl:maxCount 1;
    shacl:name "dossier"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#dossier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "zaakhandeling"@nl;
    rdfs:comment "De Zaakhandelingen die worden gesteld in het kader van de Zaak."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Zaak.Zaakhandeling>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Zaakhandeling>;
    shacl:description "De Zaakhandelingen die worden gesteld in het kader van de Zaak."@nl;
    shacl:name "zaakhandeling"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#zaakhandeling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "procedure"@nl;
    rdfs:comment "De Procedure volgens dewelke de Zaak wordt afgehandeld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Zaak.Procedure>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Procedure>;
    shacl:description "De Procedure volgens dewelke de Zaak wordt afgehandeld."@nl;
    shacl:maxCount 1;
    shacl:name "procedure"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#procedure>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verwanteZaak"@nl;
    <http://purl.org/vocab/vann/usageNote> "Verwantschappen kunnen verschillende doelstellingen hebben. De doelstelling mag een aangegeven worden in een gekwalificeerde relatie."@nl;
    rdfs:comment "Verwijzingen naar verwante Zaken."@nl;
