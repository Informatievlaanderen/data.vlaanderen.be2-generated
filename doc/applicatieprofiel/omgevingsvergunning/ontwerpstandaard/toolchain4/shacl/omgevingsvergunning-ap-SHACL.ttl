    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Associeert de Locatie met het bijbehorende adres."@nl;
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatieType"@nl;
