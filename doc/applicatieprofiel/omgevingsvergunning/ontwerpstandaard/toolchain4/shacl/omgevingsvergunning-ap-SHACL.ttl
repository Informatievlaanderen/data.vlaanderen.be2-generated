    shacl:class <http://www.opengis.net/ont/geosparql#Geometry>;
    shacl:description "Een ruimtelijke voorstelling voor een welbepaalde Locatie"@nl;
    shacl:name "geometrie"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#hasGeometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Associeert de Locatie met het bijbehorende adres."@nl;
