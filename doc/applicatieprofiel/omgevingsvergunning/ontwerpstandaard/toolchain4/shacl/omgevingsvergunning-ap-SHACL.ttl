    shacl:name "verantwoordelijke"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#verantwoordelijke>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebeurtenis"@nl;
    rdfs:comment "Gebeurtenissen waarvan de Vergunde Toestand is afgeleid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#VaststellingVergundeToestand.Gebeurtenis>;
