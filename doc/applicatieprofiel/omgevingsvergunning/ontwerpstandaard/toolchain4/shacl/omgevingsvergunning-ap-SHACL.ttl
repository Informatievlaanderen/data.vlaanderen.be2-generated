    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Locatie.Locatietype>;
    shacl:class skos:Concept;
    shacl:description "De type van de Locatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "locatieType"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass dc:Location .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#NormatieveBepalingShape> a shacl:NodeShape;
  rdfs:label "Normatieve Bepaling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Kan van algemene en individuele strekking zijn. Het kan gaan om een recht of verbintenis."@nl;
  rdfs:comment "Een bepaling die een rechtsnorm in het leven roept, wijzigt, beëindigt of bevestigt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "tijdsbestek"@nl;
    <http://purl.org/vocab/vann/usageNote> "De toelating om een bepaalde Activiteit uit te voeren kan beperkt zijn in de tijd."@nl;
    rdfs:comment "Aanduiding van het tijdsbestek van de Normatieve Bepaling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#NormatieveBepaling.Tijdsbestek>;
    shacl:class <http://www.w3.org/2006/time#TemporalDuration>;
    shacl:description "Aanduiding van het tijdsbestek van de Normatieve Bepaling."@nl;
    shacl:name "tijdsbestek"@nl;
    shacl:path dc:extent
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorwerp"@nl;
    rdfs:comment "Het voorwerp van de Normatieve Bepaling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#NormatieveBepaling.Voorwerp>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Activiteit>;
    shacl:description "Het voorwerp van de Normatieve Bepaling."@nl;
    shacl:name "voorwerp"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#voorwerp>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#NormatieveBepaling> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als Agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:targetClass org:Organization .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#ProcedureShape> a shacl:NodeShape;
  rdfs:label "Procedure"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het bevat Procedurestappen zoals bijvoorbeeld een Beroepsmogelijkheid. De Procedurestappen bepalen wat de mogelijke vervolghandelingen zijn in de Zaak en welke termijnen er gelden. In casemanagement systemen die CMMN implementeren komt deze entiteit overeen met een CasePlanModel."@nl;
  rdfs:comment "Een Procedure is de blauwdruk voor de afhandeling van een Zaak."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "rechtsgrond"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld, de procedure voor de vereenvoudigde vergunningsprocedure is vastgesteld in de artikelen 37 en volgende van het Omgevingsdecreet, zoals van kracht op een bepaalde datum."@nl;
    rdfs:comment "Verwijzingen naar de Juridische Werken die de grondslag vormen van de Procedure."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Procedure.Rechtsgrond>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#JuridischWerk>;
    shacl:description "Verwijzingen naar de Juridische Werken die de grondslag vormen van de Procedure."@nl;
    shacl:name "rechtsgrond"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#rechtsgrond>
  ], [
    a shacl:PropertyShape;
    rdfs:label "termijn"@nl;
    rdfs:comment "Termijn binnen dewelke de Procedure toegepast mag worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Procedure.Termijn>;
    shacl:class <http://www.w3.org/2006/time#TemporalDuration>;
    shacl:description "Termijn binnen dewelke de Procedure toegepast mag worden."@nl;
    shacl:maxCount "1";
    shacl:name "termijn"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#termijn>
  ], [
    a shacl:PropertyShape;
    rdfs:label "procedurestap"@nl;
    rdfs:comment "De Procedurestappen die deel uitmaken van een Procedure."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Procedure.Procedurestap>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Procedurestap>;
    shacl:description "De Procedurestappen die deel uitmaken van een Procedure."@nl;
    shacl:name "procedurestap"@nl;
    shacl:path dc:hasPart
  ], [
    a shacl:PropertyShape;
    rdfs:label "bevoegde overheid"@nl;
    rdfs:comment "De Publieke Organisaties die bevoegdheid kunnen hebben over de Procedure."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Procedure.BevoegdeOverheid>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "De Publieke Organisaties die bevoegdheid kunnen hebben over de Procedure."@nl;
    shacl:name "bevoegde overheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#bevoegdeOverheid>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Procedure> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#ProcedurestapShape> a shacl:NodeShape;
  rdfs:label "Procedurestap"@nl;
  <http://purl.org/vocab/vann/usageNote> "Wordt gebruikt om aan te geven welke soort handeling de Procedure voorschrijft. De Zaakhandeling geeft uitvoering aan de Procedurestap met betrekking tot een concrete Zaak."@nl;
  rdfs:comment "Een Procedurestap is een voorgeschreven handeling binnen een Procedure."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Procedurestap> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#PubliekeOrganisatieShape> a shacl:NodeShape;
  rdfs:label "Publieke Organisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "De overheids- en semioverheidsorganisaties die tot men zo tot de publieke sector kan rekenen worden in Europese richtlijn 2003/98/EG \"openbaar lichaam\" genoemd en gedefinieerd als: \"de staat, zijn territoriale lichamen, publiekrechtelijke instellingen, en verenigingen gevormd door een of meer van deze lichamen of een of meer van deze publiekrechtelijke instellingen\". En onder een publiekrechtelijke instelling verstaat men \" iedere instelling die a) is opgericht met het specifieke doel te voorzien in behoeften van algemeen belang die niet van industriële of commerciële aard zijn, en b) rechtspersoonlijkheid heeft, en c) waarvan hetzij de activiteiten in hoofdzaak door de staat of zijn territoriale lichamen of andere publiekrechtelijke instellingen worden gefinancierd, hetzij het beheer is onderworpen aan toezicht door deze laatste, hetzij de leden van het bestuursorgaan, het leidinggevend orgaan of het toezichthoudend orgaan voor meer dan de helft door de staat, zijn territoriale lichamen of andere publiekrechtelijke instellingen zijn aangewezen.\"."@nl;
  rdfs:comment "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector, ongeacht het bestuursniveau waarop dat kader van kracht is."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/m8g/PublicOrganisation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#RechtShape> a shacl:NodeShape;
  rdfs:label "Recht"@nl;
  rdfs:comment "De toestemming om een bepaalde activiteit uit te voeren op een bepaalde locatie, waarvoor, op het moment van aanvraag of melding, een specifieke vergunning of melding vereist is volgens de geldende regelgeving op het gebied van ruimtelijke ordening en milieu."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Recht> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#RechterlijkeUitspraakShape> a shacl:NodeShape;
  rdfs:label "Rechterlijke Uitspraak"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de context van omgevingsvergunningen omvat dit de uitspraken van de Raad voor Vergunningsbetwistingen en de Raad van State."@nl;
  rdfs:comment "Een formele beslissing of oordeel van een rechtscollege, uitgesproken door een rechter of een panel van rechters."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "rechtscollege"@nl;
    rdfs:comment "De Rechtscollege verantwoordelijk voor de Rechterlijke Uitspraak."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#RechterlijkeUitspraak.Rechtscollege>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Rechtscollege>;
    shacl:description "De Rechtscollege verantwoordelijk voor de Rechterlijke Uitspraak."@nl;
    shacl:maxCount "1";
    shacl:name "rechtscollege"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#verantwoordelijke>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#RechterlijkeUitspraak> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#RechtscollegeShape> a shacl:NodeShape;
  rdfs:label "Rechtscollege"@nl;
  rdfs:comment "Rechtsprekende instantie."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Rechtscollege> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#RechtsgrondShape> a shacl:NodeShape;
  rdfs:label "Rechtsgrond"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een rechtsgrond kan zowel een geheel (bvb: wet, besluit) voorstellen als een onderdeel eruit (bvb: artikel)."@nl;
  rdfs:comment "Een legaal concept dat los staat van een bepaalde vorm (het achterliggende idee)."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/eli/ontology#LegalResource> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#RechtshandelingShape> a shacl:NodeShape;
  rdfs:label "Rechtshandeling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Omvat Bestuurlijke Handeling en Rechterlijke Uitspraken. Omvat ook aanvragen, meldingen, formele vastleggingen en andere administratieve en gerechtelijke rechtshandelingen gepleegd door zowel overheidsinstanties als ook burgers en bedrijven. Omvat ook stilzwijgende handelingen, zoals stilzwijgende aktename of weigering."@nl;
  rdfs:comment "Handeling met beoogde rechtsgevolgen. Bewuste actie die gericht is op het tot stand brengen, wijzigen, overdragen, beëindigen of bevestigen van juridische verplichtingen of rechten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "ingangsdatum"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld, de datum van een arrest."@nl;
    rdfs:comment "Datum vanaf dewelke de Rechtshandeling rechtskracht krijgt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Rechtshandeling.Ingangsdatum>;
    shacl:datatype xsd:date;
    shacl:description "Datum vanaf dewelke de Rechtshandeling rechtskracht krijgt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "ingangsdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#ingangsdatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "document"@nl;
    rdfs:comment "Neerslag van de Rechtshandeling in een Document."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Rechtshandeling.Document>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#Document>;
    shacl:description "Neerslag van de Rechtshandeling in een Document."@nl;
    shacl:name "document"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#document>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De Identificator van de Rechtshandeling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#Rechtshandeling.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "De Identificator van de Rechtshandeling."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bekendmaking"@nl;
