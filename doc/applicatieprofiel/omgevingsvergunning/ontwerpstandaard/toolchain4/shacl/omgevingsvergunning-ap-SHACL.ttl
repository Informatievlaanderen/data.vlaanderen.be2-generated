<https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#VergundeToestandShape> a shacl:NodeShape;
  rdfs:label "Vergunde Toestand"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een vergunde toestand bevat (verwijzingen naar) Normatieve Bepalingen. In de context van de omgevingsvergunning is het voorwerp van de vergunde toestand vaak een Locatie zoals een gebouw, een perceel of een gebied. Een Vergunde Toestand is onlosmakelijk verbonden met de Vaststelling ervan."@nl;
  rdfs:comment "Het geheel van rechten en plichten, voor wat betreft het toepassingsgebied van de omgevingsvergunningen, die op een bepaald moment in de tijd van toepassing zijn op het voorwerp van de vergunde toestand."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "toestand datum"@nl;
    rdfs:comment "Aanduiding van de datum van de Vergunde Toestand."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#VergundeToestand.ToestandDatum>;
    shacl:datatype xsd:date;
    shacl:description "Aanduiding van de datum van de Vergunde Toestand."@nl;
    shacl:maxCount "1";
    shacl:name "toestand datum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#toestandDatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorwerp"@nl;
    rdfs:comment "De ruimtelijke bepaling waarvoor de vergunde toestand wordt vastgesteld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#VergundeToestand.Voorwerp>;
    shacl:class dc:Location;
    shacl:description "De ruimtelijke bepaling waarvoor de vergunde toestand wordt vastgesteld."@nl;
    shacl:name "voorwerp"@nl;
    shacl:path <http://www.w3.org/ns/locn#location>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vaststelling vergunde toestand"@nl;
    rdfs:comment "De handeling waarmee de Vergunde Toestand is vastgelegd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#VergundeToestand.VaststellingVergundeToestand>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#VaststellingVergundeToestand>;
    shacl:description "De handeling waarmee de Vergunde Toestand is vastgelegd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "vaststelling vergunde toestand"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#vaststellingVergundeToestand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "normatieve bepaling"@nl;
    rdfs:comment "De Normatieve Bepalingen die geldig zijn in de context van een bepaalde Vergunde Toestand."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/ontwerpstandaard/toolchain4#VergundeToestand.NormatieveBepaling>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#NormatieveBepaling>;
    shacl:description "De Normatieve Bepalingen die geldig zijn in de context van een bepaalde Vergunde Toestand."@nl;
    shacl:name "normatieve bepaling"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#normatieveBepaling>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#VergundeToestand> .

