    shacl:class rdfs:Resource;
    shacl:name "metadata";
    shacl:path <http://www.w3.org/ns/sosa/oms/metadata>
  ], [
    a shacl:PropertyShape;
    rdfs:label "implementeert"@nl;
    rdfs:comment "Observatieprocedure die door de Sensor wordt toegepast."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Sensor.Implementeert>;
    shacl:class <http://www.w3.org/ns/sosa/oms/ObservingProcedure>;
