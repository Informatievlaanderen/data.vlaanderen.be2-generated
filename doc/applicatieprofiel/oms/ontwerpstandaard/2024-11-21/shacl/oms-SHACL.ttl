<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#WerkingsbereikShape> a shacl:NodeShape;
  rdfs:label "Werkingsbereik"@nl;
  <http://purl.org/vocab/vann/usageNote> "Slaat op zaken als onderhoud of de vereiste netspanning en de eventuele bijkomende condities, bv om de 3 weken is onderhoud nodig (door een gespecialiseerde firma) of de spanning op het net voor de voeding vh Systeem moet tussen 110 en 230 Volt liggen (bij normaal verbruik)."@nl;
  rdfs:comment "Vereisten opdat een Systeem normaal functioneert."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "conditie"@nl;
    rdfs:comment "Voorwaarde waaronder het normaal functioneren geldt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Werkingsbereik.Conditie>;
    shacl:class <http://www.w3.org/ns/ssn/systems/Condition>;
    shacl:description "Voorwaarde waaronder het normaal functioneren geldt."@nl;
    shacl:minCount "1";
    shacl:name "conditie"@nl;
    shacl:path <http://www.w3.org/ns/ssn/systems/inCondition>
  ], [
    a shacl:PropertyShape;
    rdfs:label "kenmerk"@nl;
    rdfs:comment "Aspect van het Werkingsbereik dat wordt beschouwd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Werkingsbereik.Kenmerk>;
    shacl:class <http://www.w3.org/ns/ssn/systems/OperatingProperty>;
    shacl:description "Aspect van het Werkingsbereik dat wordt beschouwd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "kenmerk"@nl;
    shacl:path <http://www.w3.org/ns/ssn/systems/hasOperatingProperty>
  ];
  shacl:targetClass <http://www.w3.org/ns/ssn/systems/OperatingRange> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#WerkingskenmerkShape> a shacl:NodeShape;
