    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:maxCount "1";
    shacl:name "locatie";
    shacl:path <http://www.opengis.net/ont/geosparql#hasGeometry>
  ], [
    a shacl:PropertyShape;
