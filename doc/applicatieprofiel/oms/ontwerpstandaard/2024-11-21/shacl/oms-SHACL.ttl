    rdfs:label "voorbereidMonster";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Monstervoorbereiding.Voorbereidmonster>;
