    shacl:name "uitgevoerdeObservatie"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeObservation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "observeert"@nl;
    rdfs:comment "Kenmerk dat door de Sensor wordt geobserveerd."@nl;
