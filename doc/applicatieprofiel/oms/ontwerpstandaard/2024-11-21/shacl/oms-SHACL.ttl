<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#OverlevingscapaciteitShape> a shacl:NodeShape;
  rdfs:label "Overlevingscapaciteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Slaat op de levensduur vh Systeem als geheel of van cruciale delen ervan zoals de batterij en de Condities waaronder die kenmerken gelden. Bv de batterij van het systeem gaat 3 weken mee alvorens ze opnieuw moet worden opgeladen op voorwaarde dat de temperatuur tussen -5 en +35 graden ligt."@nl;
  rdfs:comment "Levensduur ve Systeem."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "conditie"@nl;
    rdfs:comment "Voorwaarde waaronder de opgegeven levensduur geldt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Overlevingscapaciteit.Conditie>;
    shacl:class <http://www.w3.org/ns/ssn/systems/Condition>;
    shacl:description "Voorwaarde waaronder de opgegeven levensduur geldt."@nl;
    shacl:minCount "1";
    shacl:name "conditie"@nl;
    shacl:path <http://www.w3.org/ns/ssn/systems/inCondition>
  ], [
    a shacl:PropertyShape;
    rdfs:label "kenmerk"@nl;
    rdfs:comment "Aspect van de Overlevingscapaciteit dat wordt beschouwd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Overlevingscapaciteit.Kenmerk>;
    shacl:class <http://www.w3.org/ns/ssn/systems/SurvivalProperty>;
    shacl:description "Aspect van de Overlevingscapaciteit dat wordt beschouwd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "kenmerk"@nl;
    shacl:path <http://www.w3.org/ns/ssn/systems/hasSurvivalProperty>
  ];
  shacl:targetClass <http://www.w3.org/ns/ssn/systems/SurvivalRange> .

