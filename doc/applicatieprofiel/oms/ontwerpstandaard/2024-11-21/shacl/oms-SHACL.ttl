<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#AnyShape> a shacl:NodeShape;
  rdfs:label "Any"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te substitueren door een geschikte klasse of datatype."@nl;
  rdfs:comment "Instanties van  om het even welk type."@nl;
  shacl:closed false;
  shacl:targetClass rdfs:Resource .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#BemonsteraarShape> a shacl:NodeShape;
  rdfs:label "Bemonsteraar"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv een kogelmolen (om Monsters te breken), een diamantboor, een hamer, een injectienaald, een beeldsensor, een grondboor etc. De Sensor en de Bemonsteraar zijn soms hetzelfde Toestel, zoals in het vb van de beeldsensor. Een Bemonsteraar moet niet per se een fysiek Toestel zijn."@nl;
  rdfs:comment "Toestel dat wordt gebruikt door een Bemonsteringsprocedure of deze implementeert om één of meer Bemonsteringsobjecten te bekomen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "link";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonsteraar.Link>;
    shacl:datatype xsd:anyURI;
    shacl:name "link";
    shacl:path <http://fixme.com/>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de Bemonsteraar."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonsteraar.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de Bemonsteraar."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdeBemonstering"@nl;
    rdfs:comment "Bemonstering die met de Bemonsteraar is uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonsteraar.Uitgevoerdebemonstering>;
    shacl:class <http://www.w3.org/ns/sosa/Sampling>;
    shacl:description "Bemonstering die met de Bemonsteraar is uitgevoerd."@nl;
    shacl:name "uitgevoerdeBemonstering"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeSampling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "implementeert"@nl;
    rdfs:comment "Bemonsteringsprocedure die door de Bemonsteraar in praktijk wordt gebracht."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonsteraar.Implementeert>;
    shacl:class <http://www.w3.org/ns/sosa/oms/SamplingProcedure>;
    shacl:description "Bemonsteringsprocedure die door de Bemonsteraar in praktijk wordt gebracht."@nl;
    shacl:minCount "1";
    shacl:name "implementeert"@nl;
    shacl:path <http://www.w3.org/ns/sosa/implements>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Sampler> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#BemonsteraartypeShape> a shacl:NodeShape;
  rdfs:label "Bemonsteraartype"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#BemonsteringShape> a shacl:NodeShape;
  rdfs:label "Bemonstering"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv het breken van een rotsmonster, het graven van een profielput, het verdelen van een site in kwadranten, bloed trekken bij een patient, een meetpunt opzetten voor bv milieumonitoring, een luchtfoto nemen, een bodemmonster zeven, een deelpopulatie selecteren, een boorkern bemonsteren etc."@nl;
  rdfs:comment "Handeling waarbij een bepaalde Bemonsteringsprocedure wordt uitgevoerd om één of meer Bemonsteringsobjecten te bekomen of waarbij deze worden bewerkt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "link";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Link>;
    shacl:datatype xsd:anyURI;
    shacl:name "link";
    shacl:path <http://fixme.com/>
  ], [
    a shacl:PropertyShape;
    rdfs:label "conditie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv de weersomstandigheden..."@nl;
    rdfs:comment "Omstandigheden waarin de Bemonstering plaatsvond."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Conditie>;
    shacl:class <http://fixme.com/>;
    shacl:description "Omstandigheden waarin de Bemonstering plaatsvond."@nl;
    shacl:name "conditie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/sensoren-en-bemonstering#Bemonstering.conditie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wettelijkKader"@nl;
    rdfs:comment "WettelijkKader waarbinnen de Bemonstering plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Wettelijkkader>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#WettelijkKader>;
    shacl:description "WettelijkKader waarbinnen de Bemonstering plaatsvindt."@nl;
    shacl:maxCount "1";
    shacl:name "wettelijkKader"@nl;
    shacl:path <https://data.vlaanderen.be/ns/sensoren-en-bemonstering#Bemonstering.wettelijkKader>
  ], [
    a shacl:PropertyShape;
    rdfs:label "opdracht"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv de Opdracht voor een veldonderzoek of voor het uitvoeren van specifieke Metingen of analyses van een Monster."@nl;
    rdfs:comment "Opdracht in het kader waarvan de Bemonstering plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Opdracht>;
    shacl:class <https://data.vlaanderen.be/ns/bodem-en-ondergrond#Opdracht>;
    shacl:description "Opdracht in het kader waarvan de Bemonstering plaatsvindt."@nl;
    shacl:name "opdracht"@nl;
    shacl:path <https://data.vlaanderen.be/ns/sensoren-en-bemonstering#Bemonstering.opdracht>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bemonsteringstijdstip"@nl;
    rdfs:comment "Moment waarop de Bemonstering werd afgerond."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Bemonsteringstijdstip>;
    shacl:class <http://www.w3.org/2006/time#TemporalEntity>;
    shacl:description "Moment waarop de Bemonstering werd afgerond."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "bemonsteringstijdstip"@nl;
    shacl:path <http://www.w3.org/ns/sosa/resultTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdDoor"@nl;
    rdfs:comment "Agent die de Bemonstering heeft uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Uitgevoerddoor>;
    shacl:class dc:Agent;
    shacl:description "Agent die de Bemonstering heeft uitgevoerd."@nl;
    shacl:name "uitgevoerdDoor"@nl;
    shacl:path <https://data.vlaanderen.be/ns/sensoren-en-bemonstering#Bemonstering.uitgevoerdDoor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de Bemonstering."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de Bemonstering."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "doel"@nl;
    rdfs:comment "Reden waarom de Bemonstering wordt uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Doel>;
    shacl:class skos:Concept;
    shacl:description "Reden waarom de Bemonstering wordt uitgevoerd."@nl;
    shacl:name "doel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/sensoren-en-bemonstering#Bemonstering.doel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "parameter";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Parameter>;
    shacl:class <http://fixme.com/>;
    shacl:name "parameter";
    shacl:path <http://fixme.com/>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bemonsteringsplaats";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Bemonsteringsplaats>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:maxCount "1";
    shacl:name "bemonsteringsplaats";
    shacl:path <http://fixme.com/>
  ], [
    a shacl:PropertyShape;
    rdfs:label "metadata";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Metadata>;
    shacl:class rdfs:Resource;
    shacl:name "metadata";
    shacl:path <http://www.w3.org/ns/sosa/oms/metadata>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdMet"@nl;
    rdfs:comment "Bemonsteraar waarmee de Bemonstering is uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Uitgevoerdmet>;
    shacl:class <http://www.w3.org/ns/sosa/Sampler>;
    shacl:description "Bemonsteraar waarmee de Bemonstering is uitgevoerd."@nl;
    shacl:name "uitgevoerdMet"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeBySampler>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruikteProcedure"@nl;
    rdfs:comment "Bemonsteringsprocedure die werd gevolgd bij de Bemonstering."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Gebruikteprocedure>;
    shacl:class <http://www.w3.org/ns/sosa/oms/SamplingProcedure>;
    shacl:description "Bemonsteringsprocedure die werd gevolgd bij de Bemonstering."@nl;
    shacl:name "gebruikteProcedure"@nl;
    shacl:path <http://www.w3.org/ns/sosa/usedProcedure>
  ], [
    a shacl:PropertyShape;
    rdfs:label "resultaat"@nl;
    rdfs:comment "Bemonsteringsobject dat bij de Bemonstering werd verkregen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Resultaat>;
    shacl:class <http://www.w3.org/ns/sosa/Sample>;
    shacl:description "Bemonsteringsobject dat bij de Bemonstering werd verkregen."@nl;
    shacl:minCount "1";
    shacl:name "resultaat"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasResult>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bemonsterdObject"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv de Persoon waarvan een bloedstaal wordt genomen."@nl;
    rdfs:comment "Object dat wordt bemonsterd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Bemonstering.Bemonsterdobject>;
    shacl:class <http://www.w3.org/ns/sosa/FeatureOfInterest>;
    shacl:description "Object dat wordt bemonsterd."@nl;
