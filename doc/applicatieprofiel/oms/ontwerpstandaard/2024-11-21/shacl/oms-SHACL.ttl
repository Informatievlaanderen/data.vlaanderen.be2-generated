    rdfs:label "vertikalePositioneleNauwkeurigheid";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Ruimtelijkbemonsteringsobject.Vertikalepositionelenauwkeurigheid>;
