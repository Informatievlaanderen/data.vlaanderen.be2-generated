<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#ObservatieprocedureShape> a shacl:NodeShape;
  rdfs:label "Observatieprocedure"@nl;
  <http://purl.org/vocab/vann/usageNote> "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bv de correcte plaatsing van een windmeter (op een welbepaalde hoogte boven het grondoppervlak, bv 10m voor meteorologische waarnemingen). De procedures zijn doorgaans bedoeld om bij meer dan één Bermonstering te worden toegepast."@nl;
  rdfs:comment "Een workflow, protocol, plan, algoritme of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "specificatie"@nl;
    rdfs:comment "Verwijzing naar een document dat de Observatieprocedure beschrijft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Observatieprocedure.Specificatie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Verwijzing naar een document dat de Observatieprocedure beschrijft."@nl;
    shacl:name "specificatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/sensoren-en-bemonstering#Observatieprocedure.specificatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "link";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Observatieprocedure.Link>;
    shacl:datatype xsd:anyURI;
    shacl:name "link";
    shacl:path <http://fixme.com/>
  ], [
    a shacl:PropertyShape;
    rdfs:label "input"@nl;
    rdfs:comment "Verwijzing naar de Input die de procedure vereist."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Observatieprocedure.Input>;
    shacl:class <http://www.w3.org/ns/ssn/Input>;
    shacl:description "Verwijzing naar de Input die de procedure vereist."@nl;
    shacl:name "input"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasInput>
  ], [
    a shacl:PropertyShape;
    rdfs:label "output"@nl;
    rdfs:comment "Verwijzing naar de Output die de Procedure genereert."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Observatieprocedure.Output>;
    shacl:class <http://www.w3.org/ns/ssn/Output>;
    shacl:description "Verwijzing naar de Output die de Procedure genereert."@nl;
    shacl:name "output"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasOutput>
  ], [
    a shacl:PropertyShape;
    rdfs:label "parameter"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv een parameter die een aspect van de Observatieprocedure beschrijft (bv de vereiste hoogte voor het observeren van windsnelheid) of een noodzakelijke omgevingsparameter (bv temperatuurbereik waarbinnen een labo-analyse moet plaatsvinden)."@nl;
    rdfs:comment "Willekeurig gegeven gassocieerd met de Observatieprocedure."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Observatieprocedure.Parameter>;
    shacl:class <http://fixme.com/>;
    shacl:description "Willekeurig gegeven gassocieerd met de Observatieprocedure."@nl;
    shacl:name "parameter"@nl;
    shacl:path <https://data.vlaanderen.be/ns/sensoren-en-bemonstering#Observatieprocedure.parameter>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de Observatieprocedure."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Observatieprocedure.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de Observatieprocedure."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "metadata";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Observatieprocedure.Metadata>;
    shacl:class rdfs:Resource;
    shacl:name "metadata";
    shacl:path <http://www.w3.org/ns/sosa/oms/metadata>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geïmplementeerdMet"@nl;
    rdfs:comment "Sensor waarmee de Observatieprocedure is of moet worden uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Observatieprocedure.Geïmplementeerdmet>;
    shacl:class <https://www.w3.org/ns/sosa/Sensor>;
    shacl:description "Sensor waarmee de Observatieprocedure is of moet worden uitgevoerd."@nl;
    shacl:name "geïmplementeerdMet"@nl;
    shacl:path <http://www.w3.org/ns/sosa/implementedBy>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruiktVoorHetObserverenVan";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Observatieprocedure.Gebruiktvoorhetobserverenvan>;
    shacl:class <http://www.w3.org/ns/sosa/Observation>;
    shacl:name "gebruiktVoorHetObserverenVan";
    shacl:path <http://fixme.com/>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/oms/ObservingProcedure> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#ObservatieproceduretypeShape> a shacl:NodeShape;
  rdfs:label "Observatieproceduretype"@nl;
