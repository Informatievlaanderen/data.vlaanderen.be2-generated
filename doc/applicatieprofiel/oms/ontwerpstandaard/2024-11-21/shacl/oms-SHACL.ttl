    shacl:description "Platform waarop het Systeem gehost wordt."@nl;
    shacl:name "gehostDoor"@nl;
    shacl:path <http://www.w3.org/ns/sosa/isHostedBy>
  ];
  shacl:targetClass <http://www.w3.org/ns/ssn/System> .

