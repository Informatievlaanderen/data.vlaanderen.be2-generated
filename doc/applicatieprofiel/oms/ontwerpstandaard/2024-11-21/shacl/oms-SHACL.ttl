    shacl:datatype rdf:langString;
    shacl:description "Naam vh model vh Toestel."@nl;
    shacl:maxCount "1";
    shacl:name "model"@nl;
    shacl:path <https://saref.etsi.org/core/hasModel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "functie"@nl;
    rdfs:comment "Functie die het Toestel kan uitvoeren met het oog op het uitvoeren van een taak."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Toestel.Functie>;
    shacl:class <https://saref.etsi.org/core/Function>;
    shacl:description "Functie die het Toestel kan uitvoeren met het oog op het uitvoeren van een taak."@nl;
    shacl:minCount "1";
    shacl:name "functie"@nl;
    shacl:path <https://saref.etsi.org/core/hasFunction>
  ], [
    a shacl:PropertyShape;
    rdfs:label "taak"@nl;
    rdfs:comment "Taak die met het Toestel kan worden uitgevoerd waarvoor het Toestel ontworpen is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Toestel.Taak>;
    shacl:class <https://saref.etsi.org/core/Task>;
    shacl:description "Taak die met het Toestel kan worden uitgevoerd waarvoor het Toestel ontworpen is."@nl;
    shacl:minCount "1";
    shacl:name "taak"@nl;
    shacl:path <https://saref.etsi.org/core/accomplishes>
  ];
  shacl:targetClass <https://saref.etsi.org/core/Device> .

