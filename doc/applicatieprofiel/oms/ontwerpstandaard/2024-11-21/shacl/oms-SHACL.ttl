    shacl:class <http://www.w3.org/ns/sosa/Deployment>;
    shacl:name "heeftDeployment";
    shacl:path <http://www.w3.org/ns/sosa/hasDeployment>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gehostDoor"@nl;
    rdfs:comment "Platform waarop het Systeem gehost wordt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Systeem.Gehostdoor>;
