<https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#SysteemShape> a shacl:NodeShape;
  rdfs:label "Systeem"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze componenten kunnen Systemen op zich zijn. In deze context zijn het Systemen die een Observatieprocedure realiseren (typisch een Sensor) of waarmee een Bemonsteringsprocedure wordt uitgevoerd (bv een Boorinstallatie)."@nl;
  rdfs:comment "Samenhangend geheel van componenten die samen één of meer functies vervullen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "capaciteit"@nl;
    rdfs:comment "Capaciteit vh Systeem."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Systeem.Capaciteit>;
    shacl:class <http://www.w3.org/ns/ssn/systems/SystemCapacity>;
    shacl:description "Capaciteit vh Systeem."@nl;
    shacl:name "capaciteit"@nl;
    shacl:path <http://www.w3.org/ns/ssn/systems/hasSystemCapability>
  ], [
    a shacl:PropertyShape;
    rdfs:label "werkingsbereik"@nl;
    rdfs:comment "Werking vh Systeem."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Systeem.Werkingsbereik>;
    shacl:class <http://www.w3.org/ns/ssn/systems/OperatingRange>;
    shacl:description "Werking vh Systeem."@nl;
    shacl:name "werkingsbereik"@nl;
    shacl:path <http://www.w3.org/ns/ssn/systems/hasOperatingRange>
  ], [
    a shacl:PropertyShape;
    rdfs:label "overlevingsbereik"@nl;
    rdfs:comment "Levensduur vh Systeem."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Systeem.Overlevingsbereik>;
    shacl:class <http://www.w3.org/ns/ssn/systems/SurvivalRange>;
    shacl:description "Levensduur vh Systeem."@nl;
    shacl:name "overlevingsbereik"@nl;
    shacl:path <http://www.w3.org/ns/ssn/systems/hasSurvivalRange>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard vh Systeem."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Systeem.Type>;
