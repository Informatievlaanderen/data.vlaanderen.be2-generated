    shacl:class <http://www.w3.org/ns/sosa/Property>;
    shacl:description "Kenmerk dat door de Sensor wordt geobserveerd."@nl;
    shacl:minCount "1";
    shacl:name "observeert"@nl;
    shacl:path <http://www.w3.org/ns/sosa/observes>
  ];
  shacl:targetClass <https://www.w3.org/ns/sosa/Sensor> .

