    shacl:class <http://www.w3.org/ns/ssn/systems/SystemProperty>;
    shacl:description "Aspect van het Systeemvermogen dat wordt beschouwd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "kenmerk"@nl;
    shacl:path <http://www.w3.org/ns/ssn/systems/hasSystemProperty>
  ], [
    a shacl:PropertyShape;
    rdfs:label "conditie"@nl;
    rdfs:comment "Voorwaarde waaronder de opgegeven capaciteit geldt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/oms/ontwerpstandaard/2024-11-21#Systeemvermogen.Conditie>;
