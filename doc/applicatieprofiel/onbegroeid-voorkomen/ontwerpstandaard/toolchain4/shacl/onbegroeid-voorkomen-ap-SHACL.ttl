    shacl:class skos:Concept;
    shacl:description "Een talud is het kunstmatig gedeelte van een vlak van de wegbaan, dijken, spoorbanen, vestingswerken, ... dat een helling (min. 20%, max 80% voor kunstmatig verharde taluds) vertoont en bedoeld voor het opvangen van een hoogteverschil."@nl;
    shacl:maxCount "1";
    shacl:name "talud"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#talud>
  ];
