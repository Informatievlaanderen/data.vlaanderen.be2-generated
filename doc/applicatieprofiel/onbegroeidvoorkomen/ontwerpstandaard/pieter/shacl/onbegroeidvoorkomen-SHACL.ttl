<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#GebakkenstraatstenenShape> a shacl:NodeShape;
  rdfs:label "GebakkenStraatstenen"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar AWV SB250, Hoofdstuk 3."@nl;
  rdfs:comment "Gebakken straatstenen zijn straatstenen, in hoofdzaak vervaardigd uit klei al dan niet gemengd met leem, zand, brandstoffen of andere toeslagstoffen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#GebakkenStraatstenen> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#GeslotenkunststofverhardingShape> a shacl:NodeShape;
  rdfs:label "GeslotenKunststofverharding"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv. atletiekpistes."@nl;
  rdfs:comment "Kunststofverharding die over de totale oppervlakte in één continue laag werd aangebracht."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#GeslotenKunststofverharding> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#GrasbetontegeldeprecatedShape> a shacl:NodeShape;
  rdfs:label "GrasbetontegelDeprecated"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar AWV SB250, Hoofdstuk 3."@nl;
  rdfs:comment "Grasbetontegels zijn overeenkomstig PTV 121."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#Grasbetontegel> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#GraskunststofplaatdeprecatedShape> a shacl:NodeShape;
  rdfs:label "GrasKunststofplaatDeprecated"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar AWV SB250, Hoofdstuk 3."@nl;
  rdfs:comment "Gras/grind-kunststofplaten zijn kunststofplaten met raatvormige structuur die aangewend worden voorhet wapenen van grasmatten. Ze voldoen aan de voorschriften van PTV 828."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#GrasKunststofplaat> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#GravelShape> a shacl:NodeShape;
  rdfs:label "Gravel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bron definitie: naar Technisch Vademecum Paden en verhardingen."@nl;
  rdfs:comment "Puinmengsel specifiek bestaande uit zuiver gebroken baksteen- en dakpannenpuin."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#Gravel> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#GrondShape> a shacl:NodeShape;
  rdfs:label "Grond"@nl;
  rdfs:comment "Lithologisch hoofd- en nevenbestanddeel (als code) van de laag zoals gebruikt bij Databank Ondergrond Vlaanderen (gecodeerde lithologie en geotechnische codering)."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#Grond> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#KasseiShape> a shacl:NodeShape;
  rdfs:label "Kassei"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar AWV SB250, Hoofdstuk 3."@nl;
  rdfs:comment "Bestrating van kasseien, in rij gelegd. Kasseien zijn bestratingselementen van porfier, kwartsiet, graniet, of van harde zandsteen die geen schilferige structuur heeft. Ze hebben een dicht aaneengesloten en homogene korrel, zonder steenkorst, kwade aders of kwakaders en vertonen geen diamantkop."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#Kassei> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#KunstgrasShape> a shacl:NodeShape;
  rdfs:label "Kunstgras"@nl;
  rdfs:comment "Bedekking bestaande uit synthetisch materiaal, met de bedoeling om natuurlijk gras te imiteren."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#Kunstgras> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#MozaiekkeiShape> a shacl:NodeShape;
  rdfs:label "Mozaiekkei"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar AWV SB250, Hoofdstuk 3."@nl;
  rdfs:comment "Bestrating van kasseien, in mozaïekverband gelegd. Kasseien zijn bestratingselementen van porfier, kwartsiet, graniet, of van harde zandsteen die geen schilferige structuur heeft. Ze hebben een dicht aaneengesloten en homogene korrel, zonder steenkorst, kwade aders of kwakaders en vertonen geen diamantkop."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#Mozaiekkei> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#MulchShape> a shacl:NodeShape;
  rdfs:label "Mulch"@nl;
  <http://purl.org/vocab/vann/usageNote> "Cf. GRB-skeletoptie groen- en begraafplaatsenbeheer: WSV1102: mülsh."@nl;
  rdfs:comment "Bedekking bestaande uit een laag organisch materiaal. (Herfstbladeren, grasmaaisel, houtsnippers, compost...)."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#Mulch> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#NatuursteentegelShape> a shacl:NodeShape;
  rdfs:label "Natuursteentegel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar AWV SB250, Hoofdstuk 3."@nl;
