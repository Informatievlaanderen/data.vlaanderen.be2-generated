<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#BitumineuzeverhardingShape> a shacl:NodeShape;
  rdfs:label "BitumineuzeVerharding"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar AWV SB250, Hoofdstuk 3."@nl;
  rdfs:comment "Flexibele verharding die meestal uit bitumineus gebonden materialen (asfalt of gietasfalt) bestaat en laagsgewijs wordt aangelegd."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#BitumineuzeVerharding> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#CementbetonverhardingShape> a shacl:NodeShape;
  rdfs:label "Cementbetonverharding"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bron definitie: GRB-skeletaanvulling detail: WSV103: cementbeton."@nl;
  rdfs:comment "Stijve verharding met of zonder wapening verkregen door cementbeton te spreiden en mechanisch te verdichten."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#Cementbetonverharding> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#ColloidaalbetonShape> a shacl:NodeShape;
  rdfs:label "ColloidaalBeton"@nl;
  rdfs:comment "Betonspecie voor toepassing onder water, waarvan de samenhang is verbeterd door toevoeging van een waterretentiemiddel."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#ColloidaalBeton> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#DolomietverhardingShape> a shacl:NodeShape;
  rdfs:label "Dolomietverharding"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar AWV SB250, Hoofdstuk 3. Bron definitie: GRB-skeletaanvulling detail: WSV108: steenslag."@nl;
  rdfs:comment "Bedekking van een onverharde zone die opgebouwd is uit een niet-gecompacteerde groep van individuele componenten die voldoen aan de volgende specificaties: dolomiet (gele kleur, gemiddelde korrelgrootte), onregelmatige vorm, onregelmatig verband."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "verstevigingsmateriaal"@nl;
    rdfs:comment "Materiaal waarmee iets verstevigd is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/onbegroeidvoorkomen/ontwerpstandaard/pieter#Dolomietverharding.Verstevigingsmateriaal>;
    shacl:class skos:Concept;
    shacl:description "Materiaal waarmee iets verstevigd is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "verstevigingsmateriaal"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#verstevigingsmateriaal>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/onbegroeidvoorkomen#Dolomietverharding> .

