    rdfs:label "geometrie"@nl;
    rdfs:comment "De geometrie overeenkomstig met een bepaald gebied."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Gebied.Geometrie>;
    shacl:class <http://www.opengis.net/ont/sf#Polygon>;
    shacl:description "De geometrie overeenkomstig met een bepaald gebied."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beheerder"@nl;
    <http://purl.org/vocab/vann/usageNote> "Tot op team- of dienstniveau."@nl;
    rdfs:comment "Instantie die instaat voor het beheer van het gebied."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Gebied.Beheerder>;
    shacl:class org:Organization;
    shacl:description "Instantie die instaat voor het beheer van het gebied."@nl;
    shacl:maxCount 1;
    shacl:name "beheerder"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#beheerder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eigenaar"@nl;
    rdfs:comment "De entiteit (bv. de gemeente) die eigenaar is van het gebied."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Gebied.Eigenaar>;
    shacl:class org:Organization;
    shacl:description "De entiteit (bv. de gemeente) die eigenaar is van het gebied."@nl;
    shacl:maxCount 1;
    shacl:name "eigenaar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#eigenaar>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/gebied#Gebied> .

