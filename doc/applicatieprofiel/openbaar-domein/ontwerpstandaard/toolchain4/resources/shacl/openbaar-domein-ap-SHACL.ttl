<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#AantalObstakelsShape> a shacl:NodeShape;
  rdfs:label "Aantal Obstakels"@nl;
  <http://purl.org/vocab/vann/usageNote> "De invulling hiervan kan o.a. klassen zijn (bv. 0-10, 11-20, ...) of een kwalitatieve gradatie (bv. weinig, matig, veel)."@nl;
  rdfs:comment "Het aantal obstakels."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#BegroeidVoorkomenShape> a shacl:NodeShape;
  rdfs:label "Begroeid voorkomen"@nl;
  rdfs:comment "De ruimtelijke massa van planten-individuen, in samenhang met de plaats waar zij groeien."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "soortnaam Nederlands"@nl;
    rdfs:comment "Soortnaam in het Nederlands."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#BegroeidVoorkomen.SoortnaamNederlands>;
    shacl:datatype rdf:langString;
    shacl:description "Soortnaam in het Nederlands."@nl;
    shacl:name "soortnaam Nederlands"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#soortnaamNederlands>
  ], [
    a shacl:PropertyShape;
    rdfs:label "soortcode"@nl;
    <http://purl.org/vocab/vann/usageNote> "De soortcode wordt opgenomen onder de vorm van de 'GBIF Key'."@nl;
    rdfs:comment "Een unieke identificator voor de soort van het vegetatie-element."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#BegroeidVoorkomen.Soortcode>;
    shacl:class skos:Concept;
    shacl:description "Een unieke identificator voor de soort van het vegetatie-element."@nl;
    shacl:name "soortcode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#soortcode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "drassigheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "De drassigheid geeft hierbij aan in welke mate de normale werking van types machines zou kunnen verstoord worden."@nl;
    rdfs:comment "Mate waarin de bodem verzadigd is met water."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#BegroeidVoorkomen.Drassigheid>;
    shacl:class skos:Concept;
    shacl:description "Mate waarin de bodem verzadigd is met water."@nl;
    shacl:maxCount "1";
    shacl:name "drassigheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#drassigheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wetenschappelijke soortnaam"@nl;
    rdfs:comment "De wetenschappelijke soortnaam."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#BegroeidVoorkomen.WetenschappelijkeSoortnaam>;
    shacl:class skos:Concept;
    shacl:description "De wetenschappelijke soortnaam."@nl;
    shacl:name "wetenschappelijke soortnaam"@nl;
    shacl:path dwc:scientificName
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#BegroeidVoorkomen> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#CollectieShape> a shacl:NodeShape;
  rdfs:label "Collectie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld, alle objecten op het openbaar domein die bij een verkeersplateau horen maar niet noodzakelijk een rechtstreekse ruimtelijke relatie hebben."@nl;
  rdfs:comment "Een verzameling van individuele objecten waartussen een functionele relatie bestaat."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "Een titel voor de collectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Collectie.Titel>;
    shacl:datatype xsd:string;
    shacl:description "Een titel voor de collectie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "bevat"@nl;
    rdfs:comment "Relatie naar de objecten die deel uitmaken van de collectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Collectie.Bevat>;
    shacl:class <https://data.vlaanderen.be/ns/openbaardomein#FysiekObject>;
    shacl:description "Relatie naar de objecten die deel uitmaken van de collectie."@nl;
    shacl:name "bevat"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#bevat>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein#Collectie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanschrijfvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb De heer/Mevrouw, Excellentie, Dokter..."@nl;
    rdfs:comment "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Contactinfo.Aanschrijfvorm>;
    shacl:datatype rdf:langString;
    shacl:description "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    shacl:maxCount "1";
    shacl:name "aanschrijfvorm"@nl;
    shacl:path vcard:honorific-prefix
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam van bvb de persoon die men kan contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Contactinfo.Contactnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van bvb de persoon die men kan contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactnaam"@nl;
    shacl:path foaf:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Contactinfo.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schema:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "fax"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Faxnummer waarnaar men kan faxen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Contactinfo.Fax>;
    shacl:datatype xsd:string;
    shacl:description "Faxnummer waarnaar men kan faxen."@nl;
    shacl:maxCount "1";
    shacl:name "fax"@nl;
    shacl:path schema:faxNumber
  ], [
    a shacl:PropertyShape;
    rdfs:label "openingsuren"@nl;
    <http://purl.org/vocab/vann/usageNote> "Syntax volgens schema.org voor openingsuren. Bv als contact kan worden opgenomen tussen 8 en 20u maandag tot zaterdag en tussen 8 en 18u op zondag wordt dit gecodeerd als Ma-za 08:00-20:00, zo 08:00-18:00."@nl;
    rdfs:comment "Uren waarbinnen contact kan worden opgenomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Contactinfo.Openingsuren>;
    shacl:description "Uren waarbinnen contact kan worden opgenomen."@nl;
    shacl:maxCount "1";
    shacl:name "openingsuren"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path schema:openingHours
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Contactinfo.Telefoon>;
    shacl:datatype xsd:string;
    shacl:description "Telefoonnummer waarop men kan bellen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schema:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "website"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Website waarnaar men kan surfen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Contactinfo.Website>;
    shacl:datatype xsd:anyURI;
    shacl:description "Website waarnaar men kan surfen."@nl;
    shacl:maxCount "1";
    shacl:name "website"@nl;
    shacl:path foaf:page
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Contactinfo.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven of bezoeken."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbaarheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv aanduiding van het seizoen waarin contact kan worden opgenomen. Begin- en einddatum volgens ISO8601 syntax."@nl;
    rdfs:comment "Periode waarin contact kan worden opgenomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Contactinfo.Beschikbaarheid>;
    shacl:class schemas:OpeningHoursSpecification;
    shacl:description "Periode waarin contact kan worden opgenomen."@nl;
    shacl:maxCount "1";
    shacl:name "beschikbaarheid"@nl;
    shacl:path schema:hoursAvailable
  ];
  shacl:targetClass schema:ContactPoint .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#DeelShape> a shacl:NodeShape;
  rdfs:label "Deel"@nl;
  rdfs:comment "Homogeen gedeelte van het aardoppervlak, met een gelijkaardige hoofdfunctie en fysiek voorkomen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "oppervlakte"@nl;
    rdfs:comment "De afmeting van het object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Deel.Oppervlakte>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "De afmeting van het object."@nl;
    shacl:maxCount "1";
    shacl:name "oppervlakte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#oppervlakte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorkomen"@nl;
    rdfs:comment "Verwijst naar het fysiek voorkomen van het beheerdeel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#Deel.Voorkomen>;
    shacl:class <https://data.vlaanderen.be/ns/openbaardomein#FysiekVoorkomen>;
    shacl:description "Verwijst naar het fysiek voorkomen van het beheerdeel."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "voorkomen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#voorkomen>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein#Deel> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#DrassigheidwaardeShape> a shacl:NodeShape;
  rdfs:label "DrassigheidWaarde"@nl;
  rdfs:comment "De mate van drassigheid."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#ElementShape> a shacl:NodeShape;
  rdfs:label "Element"@nl;
  rdfs:comment "Afzonderlijk te onderscheiden element dat ofwel direct of indirect bevestigd is aan het aardoppervlak."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein#Element> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#FysiekObjectShape> a shacl:NodeShape;
  rdfs:label "Fysiek object"@nl;
  rdfs:comment "De hoofdklasse waar alle objecten die geïnventariseerd kunnen worden van afgeleid worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "begindatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het gebied of object in gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#FysiekObject.Begindatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het gebied of object in gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "begindatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#begindatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het beheerobject uit gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#FysiekObject.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het beheerobject uit gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#einddatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "niveau"@nl;
    <http://purl.org/vocab/vann/usageNote> "Negatieve waarden worden geassocieerd met ondergronds en positieve waarden met bovengronds. Nul wordt beschouwd als een absolute waarde om het maaiveld aan te duiden."@nl;
    rdfs:comment "Het niveau waarop het object zich bevindt, relatief ten opzichte van andere objecten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#FysiekObject.Niveau>;
    shacl:datatype xsd:integer;
    shacl:description "Het niveau waarop het object zich bevindt, relatief ten opzichte van andere objecten."@nl;
    shacl:maxCount "1";
    shacl:name "niveau"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#niveau>
  ], [
    a shacl:PropertyShape;
    rdfs:label "nauwkeurigheid"@nl;
    rdfs:comment "De precisie waarmee het object opgemeten werd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbaar-domein/ontwerpstandaard/toolchain4#FysiekObject.Nauwkeurigheid>;
    shacl:class skos:Concept;
    shacl:description "De precisie waarmee het object opgemeten werd."@nl;
