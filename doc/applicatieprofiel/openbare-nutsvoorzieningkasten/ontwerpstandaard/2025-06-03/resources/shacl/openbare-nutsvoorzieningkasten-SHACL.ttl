  ], [
    a shacl:PropertyShape;
    rdfs:label "host"@nl;
    rdfs:comment "Relatie tussen een Deployment en het platform waarop het Systeem is gedeployet."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Deployment.Host>;
