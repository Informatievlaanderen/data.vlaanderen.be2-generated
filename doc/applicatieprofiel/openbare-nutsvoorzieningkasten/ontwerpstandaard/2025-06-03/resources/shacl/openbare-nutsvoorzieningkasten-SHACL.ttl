    rdfs:label "indentificator"@nl;
    rdfs:comment "Referentie naar informatie die de Organisatie uniek indentificieerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Organisatie.Indentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Referentie naar informatie die de Organisatie uniek indentificieerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "indentificator"@nl;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Organisatie.Contactinfo>;
