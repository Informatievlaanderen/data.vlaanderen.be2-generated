    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Geaggregeerdverbruikobservatie.Resultaat>;
    shacl:class <https://qudt.org/schema/qudt/QuantityValue>;
