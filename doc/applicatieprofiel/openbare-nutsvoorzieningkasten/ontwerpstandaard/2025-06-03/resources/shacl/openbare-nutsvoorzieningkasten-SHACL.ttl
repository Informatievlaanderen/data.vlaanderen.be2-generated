    shacl:class <http://www.w3.org/ns/ssn/System>;
    shacl:description "Systeem dat door het Platform wordt gehost."@nl;
    shacl:name "hostVan"@nl;
    shacl:path <https://www.w3.org/ns/sosa/hosts>
  ], [
    a shacl:PropertyShape;
    rdfs:label "deployment"@nl;
