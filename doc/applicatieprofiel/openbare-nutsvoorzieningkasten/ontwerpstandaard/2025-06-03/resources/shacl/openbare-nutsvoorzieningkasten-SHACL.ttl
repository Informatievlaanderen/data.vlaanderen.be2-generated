<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "volledige naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik dit attribuut wanneer het niet mogelijk is om een opsplitsing te maken tussen voor- en achternaam."@nl;
    rdfs:comment "De volledige naam vd persoon, doorgaans de combinatie van voornamen en achternaam."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Persoon.VolledigeNaam>;
    shacl:datatype xsd:string;
    shacl:description "De volledige naam vd persoon, doorgaans de combinatie van voornamen en achternaam."@nl;
    shacl:maxCount "1";
    shacl:name "volledige naam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#volledigeNaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "indentificator"@nl;
    rdfs:comment "Referentie naar informatie die de Persoon uniek indentificieerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Persoon.Indentificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Referentie naar informatie die de Persoon uniek indentificieerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
