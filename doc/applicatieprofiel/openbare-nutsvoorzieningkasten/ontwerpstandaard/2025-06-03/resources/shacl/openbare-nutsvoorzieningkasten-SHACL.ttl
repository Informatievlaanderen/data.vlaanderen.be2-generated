<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#AansluitingShape> a shacl:NodeShape;
  rdfs:label "Aansluiting"@nl;
  rdfs:comment "Object dat de aansluiting van een kabel of leiding aan een gebouw of een ander fysiek object beschrijft"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "toebehorentype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Aansluiting is een specialisatie van Toebehoren waarbij het type Toebehoren \"aansluitingspunt\" is."@nl;
    rdfs:comment "Aard van het Toebehoren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Aansluiting.Toebehorentype>;
    shacl:class skos:Concept;
    shacl:description "Aard van het Toebehoren."@nl;
    shacl:maxCount "1";
    shacl:name "toebehorentype"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#Connection.appurtenanceType>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres van de aansluiting."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Aansluiting.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres van de aansluiting."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "adres"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#address>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "De geometrie van de Aansluiting."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Aansluiting.Geometrie>;
    shacl:class <http://www.opengis.net/ont/sf#Point>;
    shacl:description "De geometrie van de Aansluiting."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#hasGeometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Referentie naar informatie om een object uniek te indentificeren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Aansluiting.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Referentie naar informatie om een object uniek te indentificeren."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:path dc:identifier
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruiker"@nl;
    rdfs:comment "De gebruiker die de Aansluiting gebruikt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Aansluiting.Gebruiker>;
    shacl:class dc:Agent;
    shacl:description "De gebruiker die de Aansluiting gebruikt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gebruiker"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#gebruiker>
  ], [
    a shacl:PropertyShape;
    rdfs:label "leverancier"@nl;
    rdfs:comment "De leverancier die de nutsvoorziening aanlevert."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Aansluiting.Leverancier>;
    shacl:class dc:Agent;
    shacl:description "De leverancier die de nutsvoorziening aanlevert."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "leverancier"@nl;
    shacl:path <https://vocab.belgif.be/ns/utility-services#leverancier>
  ];
  shacl:targetClass <https://vocab.belgif.be/ns/utility-services#Connection> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#ActiviteitShape> a shacl:NodeShape;
  rdfs:label "Activiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een activiteit verwijst naar het evenement dat plaatsvindt, het type evenement kan gespecifieerd worden via de codelijst Activititeitstype en erft alle attributen over van <a href=\"https://schema.org/Event\">schema:Event</a> om meer informatie over het evenement te geven zoals organisator, beschrijving, etc."@nl;
  rdfs:comment "Handeling van bepaalde duur op of met entiteiten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "tijd"@nl;
    rdfs:comment "Tijd waarop de Activiteit plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Activiteit.Tijd>;
    shacl:class <http://www.w3.org/2006/time#TemporalEntity>;
    shacl:description "Tijd waarop de Activiteit plaatsvindt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "tijd"@nl;
    shacl:path prov:atTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:comment "Locatie waar de Activiteit plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Activiteit.Locatie>;
    shacl:class prov:Location;
    shacl:description "Locatie waar de Activiteit plaatsvindt."@nl;
    shacl:minCount "1";
    shacl:name "locatie"@nl;
    shacl:path prov:atLocation
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Type activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Activiteit.Type>;
    shacl:class skos:Concept;
    shacl:description "Type activiteit."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "agent"@nl;
    rdfs:comment "De Agent die de Activiteit uitvoert."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Activiteit.Agent>;
    shacl:class dc:Agent;
    shacl:description "De Agent die de Activiteit uitvoert."@nl;
    shacl:minCount "1";
    shacl:name "agent"@nl;
    shacl:path prov:qualifiedAssociation
  ];
  shacl:targetClass prov:Activity .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv als attribuut ve persoon of gebouw. De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres,bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling.locatieaanduiding tbv Belgische adressen. http://vocab.belgif.be/ns/address is momenteel offline. Dit issue is geweten en er wordt aan gewerkt. Je kan de definitie opzoeken op de vorige versie op <a href=\"https://data.vlaanderen.be/ns/adres#busnummer\">https://data.vlaanderen.be/ns/adres#busnummer</a>."@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://vocab.belgif.be/ns/address#AddressRepresentation.boxNumber>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatienaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam of omschrijving van het het geografisch object dat de adreslocator aanduidt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Adresvoorstelling.Locatienaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam of omschrijving van het het geografisch object dat de adreslocator aanduidt."@nl;
    shacl:name "locatienaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adresgebied"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb de naam van het gehucht waarin het adres ligt."@nl;
    rdfs:comment "Naam ve geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Adresvoorstelling.Adresgebied>;
    shacl:datatype rdf:langString;
    shacl:description "Naam ve geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is"@nl;
    shacl:maxCount "1";
    shacl:name "adresgebied"@nl;
    shacl:path <http://www.w3.org/ns/locn#addressArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Adresvoorstelling.Postnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#postName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "http://vocab.belgif.be/ns/address is momenteel offline. Dit issue is geweten en er wordt aan gewerkt. Je kan de definitie opzoeken op de vorige versie op <a href=\"https://data.vlaanderen.be/ns/adres#gemeentenaam\">https://data.vlaanderen.be/ns/adres#gemeentenaam</a>."@nl;
    rdfs:comment "Gemeentenaam van het adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://vocab.belgif.be/ns/address#municipalityName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 2"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "De regio van het adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/openbare-nutsvoorzieningkasten/ontwerpstandaard/2025-06-03#Adresvoorstelling.AdministratieveEenheidNiveau2>;
    shacl:datatype rdf:langString;
    shacl:description "De regio van het adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 2"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL2>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 1"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Hoogste Administratieve eenheid van het adres, doorgaans een land."@nl;
