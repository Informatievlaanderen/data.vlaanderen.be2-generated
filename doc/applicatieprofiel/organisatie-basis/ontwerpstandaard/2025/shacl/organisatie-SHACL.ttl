<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#LidmaatschapShape> a shacl:NodeShape;
  rdfs:label "Lidmaatschap"@nl;
  rdfs:comment "Geeft de kenmerken weer van het Lidmaatschap van een Agent van een Organisatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lidVanTot"@nl;
    rdfs:comment "Periode waarin de agent lid was van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Lidmaatschap.Lidvantot>;
    shacl:class <http://www.w3.org/2006/time#ProperInterval>;
    shacl:description "Periode waarin de agent lid was van de Organisatie."@nl;
    shacl:maxCount "1";
