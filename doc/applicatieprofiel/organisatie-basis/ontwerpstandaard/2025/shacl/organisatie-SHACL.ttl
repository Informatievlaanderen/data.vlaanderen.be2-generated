    shacl:class org:Role;
    shacl:description "Rol die de Agent vervult als lid van de Organisatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "rol"@nl;
    shacl:path org:role
  ], [
    a shacl:PropertyShape;
    rdfs:label "lid"@nl;
    rdfs:comment "Lidmaatschap van een Agent (van een Organisatie)."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Lidmaatschap.Lid>;
    shacl:class org:Organization;
    shacl:description "Lidmaatschap van een Agent (van een Organisatie)."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lid"@nl;
    shacl:path org:member
  ], [
    a shacl:PropertyShape;
    rdfs:label "isLidBij"@nl;
    rdfs:comment "Organisatie waarop het Lidmaatschap (van een Agent) betrekking heeft."@nl;
