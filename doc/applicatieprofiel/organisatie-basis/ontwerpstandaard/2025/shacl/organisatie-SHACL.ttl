<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te vervangen door een niet-abstracte klasse zoals W3C Organisatie."@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een Organisatie heeft dikwijls een hiërarchische structuur."@nl,
    "Een Organisatie is een institutie zoals een bedrijf, publieke organisatie, etc."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "doel"@nl;
    rdfs:comment "Bestaansreden van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Doel>;
    shacl:datatype rdf:langString;
    shacl:description "Bestaansreden van de Organisatie."@nl;
    shacl:name "doel"@nl;
    shacl:path org:purpose
  ], [
    a shacl:PropertyShape;
    rdfs:label "homepage"@nl;
    rdfs:comment "Adres van de homepage van de website van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Homepage>;
    shacl:datatype xsd:anyURI;
    shacl:description "Adres van de homepage van de website van de Organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "homepage"@nl;
    shacl:path foaf:homepage
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieveNaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: commerciële naam, informele naam, …"@nl;
    rdfs:comment "Andere naam waaronder de Organisatie bekend is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Alternatievenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Andere naam waaronder de Organisatie bekend is."@nl;
    shacl:name "alternatieveNaam"@nl;
    shacl:path skos:altLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Textuele beschrijving van de organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Textuele beschrijving van de organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "logo"@nl;
    rdfs:comment "Verwijzing naar het logo van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Logo>;
    shacl:class schemas:MediaObject;
    shacl:description "Verwijzing naar het logo van de Organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "logo"@nl;
    shacl:path schemas:logo
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van classificatie (naast type & activiteit)."@nl;
    rdfs:comment "Toestand van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Status>;
    shacl:class skos:Concept;
    shacl:description "Toestand van de Organisatie."@nl;
    shacl:name "status"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgStatus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van classificatie (naast activiteit & status)."@nl;
    rdfs:comment "Soort Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Type>;
    shacl:class skos:Concept;
    shacl:description "Soort Organisatie."@nl;
    shacl:name "type"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgType>
  ], [
    a shacl:PropertyShape;
    rdfs:label "activiteit"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van het attribuut classificatie (naast type & status)."@nl;
    rdfs:comment "Type activiteit die door de organisatie wordt uitgeoefend."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Activiteit>;
    shacl:class skos:Concept;
    shacl:description "Type activiteit die door de organisatie wordt uitgeoefend."@nl;
    shacl:maxCount "1";
    shacl:name "activiteit"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgActivity>
  ], [
    a shacl:PropertyShape;
    rdfs:label "classificatie"@nl;
    rdfs:comment "Rangschikking van de Organisatie in een classificatiesysteem."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Classificatie>;
    shacl:class skos:Concept;
    shacl:description "Rangschikking van de Organisatie in een classificatiesysteem."@nl;
    shacl:name "classificatie"@nl;
    shacl:path org:classification
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftGeregistreerdeVestiging"@nl;
    <http://purl.org/vocab/vann/usageNote> "In België verplicht voor een GeregistreerdeOrganisatie en geregistreerd in de KBO."@nl;
    rdfs:comment "Verwijst naar de wettelijk geregistreerde Vestiging van de Organisatie. Is voor een FormeleOrganisatie doorgaans verplicht."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Heeftgeregistreerdevestiging>;
    shacl:class org:Site;
    shacl:description "Verwijst naar de wettelijk geregistreerde Vestiging van de Organisatie. Is voor een FormeleOrganisatie doorgaans verplicht."@nl;
    shacl:name "heeftGeregistreerdeVestiging"@nl;
    shacl:path org:hasRegisteredSite
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftPrimaireVestiging"@nl;
    rdfs:comment "Verwijst naar de belangrijkste Vestiging van de Organisatie, niet noodzakelijk het formele hoofdkwartier maar wel de Vestiging waarop de Organisatie standaard kan worden gecontacteerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Heeftprimairevestiging>;
    shacl:class org:Site;
    shacl:description "Verwijst naar de belangrijkste Vestiging van de Organisatie, niet noodzakelijk het formele hoofdkwartier maar wel de Vestiging waarop de Organisatie standaard kan worden gecontacteerd."@nl;
    shacl:name "heeftPrimaireVestiging"@nl;
    shacl:path org:hasPrimarySite
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftSuborganisatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Wordt gebruikt om een hiërarchie van organisaties te documenteren."@nl;
    rdfs:comment "Organisatie die dochter of onderdeel is van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Heeftsuborganisatie>;
    shacl:class org:Organization;
    shacl:description "Organisatie die dochter of onderdeel is van de Organisatie."@nl;
    shacl:name "heeftSuborganisatie"@nl;
    shacl:path org:subOrganizationOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftPositie"@nl;
    rdfs:comment "Verwijst naar een Positie in de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Heeftpositie>;
    shacl:class org:Post;
    shacl:description "Verwijst naar een Positie in de Organisatie."@nl;
    shacl:name "heeftPositie"@nl;
    shacl:path org:hasPost
  ], [
    a shacl:PropertyShape;
    rdfs:label "http://www.w3.org/ns/org#linkedTo"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld om subsidiëring of bevooradingsketens te documenteren. Dient in dat geval verder gespecialiseerd te worden."@nl;
    rdfs:comment "Niet nader bepaalde relatie met een andere Organisatie."@nl;
    shacl:class org:Organization;
    shacl:description "Niet nader bepaalde relatie met een andere Organisatie."@nl;
    shacl:name "http://www.w3.org/ns/org#linkedTo"@nl;
    shacl:path org:linkedTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftVestiging"@nl;
    <http://purl.org/vocab/vann/usageNote> "Indirect bijvoorbeeld een virtueel kantoor waarvan de locatie niet rechtstreeks achterhaald kan worden (bijvoorbeeld een postbus). In België mogen in de KBO GeregistreerdeOrganisaties enkel fysieke locaties als Vestiging registreren."@nl;
    rdfs:comment "Verwijst naar een plek waar de Organisatie op een of andere manier, desnoods indirect, aanwezig is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Heeftvestiging>;
    shacl:class org:Site;
    shacl:description "Verwijst naar een plek waar de Organisatie op een of andere manier, desnoods indirect, aanwezig is."@nl;
    shacl:name "heeftVestiging"@nl;
    shacl:path org:hasSite
  ], [
    a shacl:PropertyShape;
    rdfs:label "isSuborganisatieVan"@nl;
    <http://purl.org/vocab/vann/usageNote> "Wordt gebruikt om een hiërarchie van Organisaties te documenteren."@nl;
    rdfs:comment "Organisatie die deze Organisatie omvat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Issuborganisatievan>;
    shacl:class org:Organization;
    shacl:description "Organisatie die deze Organisatie omvat."@nl;
    shacl:name "isSuborganisatieVan"@nl;
    shacl:path org:subOrganizationOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "isHetResultaatVan"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voor een publieke Organisatie is een verwijzing naar een Veranderingsmoment van het type Oprichting verplicht. Merk op dat deze relatie zinloos is als het Veranderingsmoment een Stopzetting is."@nl;
    rdfs:comment "Verwijst naar het Veranderingsmoment dat tot de huidige Organisatie heeft geleid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Ishetresultaatvan>;
    shacl:class org:ChangeEvent;
    shacl:description "Verwijst naar het Veranderingsmoment dat tot de huidige Organisatie heeft geleid."@nl;
    shacl:name "isHetResultaatVan"@nl;
    shacl:path org:resultedFrom
  ], [
    a shacl:PropertyShape;
    rdfs:label "isVeranderdDoor"@nl;
    <http://purl.org/vocab/vann/usageNote> "Als het Veranderingsmoment bijvoorbeeld een Stopzetting is hield de Organisatie daarna op met bestaan. Merk op dat deze relatie zinloos is als het Veranderingsmoment een Oprichting is (de Organisatie bestond nog niet en kan dus niet veranderd zijn ten gevolge van de Oprichting)."@nl;
    rdfs:comment "Verwijst naar het Veranderingsmoment dat deze Organisatie heeft veranderd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Isveranderddoor>;
    shacl:class org:ChangeEvent;
    shacl:description "Verwijst naar het Veranderingsmoment dat deze Organisatie heeft veranderd."@nl;
    shacl:name "isVeranderdDoor"@nl;
    shacl:path org:changedBy
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftEenheid"@nl;
    rdfs:comment "Verwijst naar een Organisatie-eenheid die deel uitmaakt van de Organisatie, bijvoorbeeld een afdeling."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Heefteenheid>;
    shacl:class org:OrganizationalUnit;
    shacl:description "Verwijst naar een Organisatie-eenheid die deel uitmaakt van de Organisatie, bijvoorbeeld een afdeling."@nl;
    shacl:name "heeftEenheid"@nl;
    shacl:path org:hasUnit
  ], [
    a shacl:PropertyShape;
    rdfs:label "lid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dekt elk type aansluiting of betrokkenheid van een Agent bij een Organisatie, niet enkel formeel lidmaatschap. Kan eventueel verder gespecialiseerd worden. Het lidmaatschap wordt meer in detail beschreven met de entiteit Lidmaatschap (door middel van associatieklasse modellering)."@nl;
    rdfs:comment "Agent die lid is (van een Organisatie)."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatie.Lid>;
    shacl:class foaf:Agent;
    shacl:description "Agent die lid is (van een Organisatie)."@nl;
    shacl:name "lid"@nl;
    shacl:path org:hasMember
  ];
  shacl:targetClass org:Organization,
    prov:Organization .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#OrganisatieeenheidShape> a shacl:NodeShape;
  rdfs:label "OrganisatieEenheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "OrganisatieEenheden kunnen groot en complex zijn en bestaan uit andere OrganisatieEenheden."@nl;
  rdfs:comment "Een organisatie zoals een afdeling of dienst die deel uitmaakt van de grotere organisatie en zijn bestaansreden daaraan ontleent. Heeft geen juridische status op zich."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "isEenheidVan"@nl;
    rdfs:comment "Organisatie waarvan de Organisatie-eenheid deel uitmaakt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Organisatieeenheid.Iseenheidvan>;
    shacl:class org:Organization;
    shacl:description "Organisatie waarvan de Organisatie-eenheid deel uitmaakt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "isEenheidVan"@nl;
    shacl:path org:unitOf
  ];
  shacl:targetClass org:OrganizationalUnit .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#PeriodeShape> a shacl:NodeShape;
  rdfs:label "Periode"@nl;
  rdfs:comment "Temporele Entiteit waarvan de omvang en duurtijd verschilt van nul, dit wil zeggen, waarvoor de begin- en eindtijd verschillend zijn."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "tot"@nl;
    rdfs:comment "Einde van een TemporeleEntiteit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Periode.Tot>;
    shacl:class <http://www.w3.org/2006/time#Instant>;
    shacl:description "Einde van een TemporeleEntiteit."@nl;
    shacl:maxCount "1";
    shacl:name "tot"@nl;
    shacl:path <http://www.w3.org/2006/time#hasEnd>
  ], [
    a shacl:PropertyShape;
    rdfs:label "van"@nl;
    rdfs:comment "Start van een TemporeleEntiteit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Periode.Van>;
    shacl:class <http://www.w3.org/2006/time#Instant>;
    shacl:description "Start van een TemporeleEntiteit."@nl;
    shacl:maxCount "1";
    shacl:name "van"@nl;
    shacl:path <http://www.w3.org/2006/time#hasBeginning>
  ];
  shacl:targetClass <http://www.w3.org/2006/time#ProperInterval> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#PlaatsShape> a shacl:NodeShape;
  rdfs:label "Plaats"@nl;
  rdfs:comment "Een ruimtelijk gebied of benoemde plaats."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "plaatsnaam"@nl;
    rdfs:comment "Naam van de plaats of van het gebied."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Plaats.Plaatsnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van de plaats of van het gebied."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "plaatsnaam"@nl;
    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "Geometrie van de plaats of het gebied."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Plaats.Geometrie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "Geometrie van de plaats of het gebied."@nl;
    shacl:maxCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass dc:Location .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#PositieShape> a shacl:NodeShape;
  rdfs:label "Positie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Laat ook toe om ambsthalve posities weer te geven. Zo is een minister automatisch lid vd regering,ongeacht door welke persoon deze functie wordt uitgeoefend."@nl;
  rdfs:comment "Functie binnen een organisatie, kan bestaan los vd persoon of personen die ze invult."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "rol"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Geeft de aard weer vd functie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Positie.Rol>;
    shacl:class org:Role;
    shacl:description "Geeft de aard weer vd functie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "rol"@nl;
    shacl:path org:role
  ], [
    a shacl:PropertyShape;
    rdfs:label "rapporteertAan"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gecombineerd met Agent-rapporteertAan-Agent kan het organogram vd organisatie gedocumenteerd worden."@nl;
    rdfs:comment "Verwijst naar de positie waaraan een positie verantwoording aflegt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Positie.Rapporteertaan>;
    shacl:class org:Post;
    shacl:description "Verwijst naar de positie waaraan een positie verantwoording aflegt."@nl;
    shacl:name "rapporteertAan"@nl;
    shacl:path org:reportsTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "inPositieIn"@nl;
    rdfs:comment "Organisatie waar de Positie bestaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Positie.Inpositiein>;
    shacl:class org:Organization;
    shacl:description "Organisatie waar de Positie bestaat."@nl;
    shacl:name "inPositieIn"@nl;
    shacl:path org:postIn
  ];
  shacl:targetClass org:Post .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#PubliekeorganisatieShape> a shacl:NodeShape;
  rdfs:label "PubliekeOrganisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "De overheids- en semioverheidsorganisaties die tot men zo tot de publieke sector kan rekenen worden in Europese richtlijn 2003/98/EG \"openbaar lichaam\" genoemd en gedefinieerd als: \"de staat, zijn territoriale lichamen, publiekrechtelijke instellingen, en verenigingen gevormd door een of meer van deze lichamen of een of meer van deze publiekrechtelijke instellingen\". En onder een publiekrechtelijke instelling verstaat men \" iedere instelling die a) is opgericht met het specifieke doel te voorzien in behoeften van algemeen belang die niet van industriële of commerciële aard zijn, en b) rechtspersoonlijkheid heeft, en c) waarvan hetzij de activiteiten in hoofdzaak door de staat of zijn territoriale lichamen of andere publiekrechtelijke instellingen worden gefinancierd, hetzij het beheer is onderworpen aan toezicht door deze laatste, hetzij de leden van het bestuursorgaan, het leidinggevend orgaan of het toezichthoudend orgaan voor meer dan de helft door de staat, zijn territoriale lichamen of andere publiekrechtelijke instellingen zijn aangewezen.\"."@nl;
  rdfs:comment "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector, ongeacht het bestuursniveau waarop dat kader van kracht is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "werkingsgebied"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Administratief gebied dat de Publieke Organisatie dekt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Publiekeorganisatie.Werkingsgebied>;
    shacl:class dc:Location;
    shacl:description "Administratief gebied dat de Publieke Organisatie dekt."@nl;
    shacl:name "werkingsgebied"@nl;
    shacl:path dc:spatial
  ];
  shacl:targetClass <http://data.europa.eu/m8g/PublicOrganisation> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#SamenwerkingsverbandShape> a shacl:NodeShape;
  rdfs:label "Samenwerkingsverband"@nl;
  <http://purl.org/vocab/vann/usageNote> "Is normaal gezien geen formele organisatie en ook geen organisatie-eenheid. Heeft doorgaans een kortere levensduur dan de organisaties in het verband. Alternatieve benamingen: project, consortium."@nl;
  rdfs:comment "Samenwerking tussen twee of meer Organisaties bijvoorbeeld voor een project."@nl;
  shacl:closed false;
  shacl:targetClass org:OrganizationalCollaboration .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#SplitsingShape> a shacl:NodeShape;
  rdfs:label "Splitsing"@nl;
  rdfs:comment "Gebeurtenis waarbij uit één Organisatie twee Organisaties worden gevormd."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/organisatie#Splitsing> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#StopzettingShape> a shacl:NodeShape;
  rdfs:label "Stopzetting"@nl;
  rdfs:comment "Gebeurtenis waarbij een Organisatie is stopgezet."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "redenStopzetting"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld pensionering, faillissement, …"@nl;
    rdfs:comment "Reden waarom de Organisatie is stopgezet."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Stopzetting.Redenstopzetting>;
    shacl:class skos:Concept;
    shacl:description "Reden waarom de Organisatie is stopgezet."@nl;
    shacl:maxCount "1";
    shacl:name "redenStopzetting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#redenStopzetting>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/organisatie#Stopzetting> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#TemporeleentiteitShape> a shacl:NodeShape;
  rdfs:label "TemporeleEntiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "TemporeleEntiteiten zijn temporele geometrische primitieven zoals Moment of Periode. Dit datatype is abstract, gebruik één van de subklassen."@nl;
  rdfs:comment "Abstracte klasse voor temporele objecten."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/2006/time#TemporalEntity> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#TijdsduurShape> a shacl:NodeShape;
  rdfs:label "Tijdsduur"@nl;
  rdfs:comment "Een maat voor de tijd die nodig is om een specifieke taak of activiteit te voltooien, doorgaans uitgedrukt in eenheden zoals seconden, minuten of uren."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/2006/time#Duration> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#TimeShape> a shacl:NodeShape;
  rdfs:label "Time";
  shacl:closed false;
  shacl:targetClass xsd:time .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#UriShape> a shacl:NodeShape;
  rdfs:label "URI";
  shacl:closed false;
  shacl:targetClass xsd:anyURI .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#VeranderingsgebeurtenisShape> a shacl:NodeShape;
  rdfs:label "Veranderingsgebeurtenis"@nl;
  <http://purl.org/vocab/vann/usageNote> "Is bedoeld voor situaties waarbij de de resulterende Organisatie zodanig verschilt van de oorspronkelijke dat ze beschouwd kan worden als een nieuwe Organisatie."@nl;
  rdfs:comment "Gebeurtenis waardoor een Organisatie een belangrijke wijziging ondergaat zoals een fusie of een herstructurering."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    <http://purl.org/vocab/vann/usageNote> "Zie Time and date & Recurring and partial dates van <a href=\"https://www.w3.org/TR/rdf11-concepts/#h2_section-Datatypes\"> XSD Datatypes</a>"@nl;
    rdfs:comment "Datum waarop de Veranderingsgebeurtenis plaatsvond."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Veranderingsgebeurtenis.Datum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de Veranderingsgebeurtenis plaatsvond."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum"@nl;
    shacl:path dc:date
  ], [
    a shacl:PropertyShape;
    rdfs:label "resulterendeOrganisatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Merk op dat deze relatie zinloos is als het Veranderingsmoment een Stopzetting is (een Stopzetting kan niet tot een nieuwe Organisatie leiden)."@nl;
    rdfs:comment "Organisatie die uit de Veranderingsgebeurtenis voortkwam."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Veranderingsgebeurtenis.Resulterendeorganisatie>;
    shacl:class org:Organization;
    shacl:description "Organisatie die uit de Veranderingsgebeurtenis voortkwam."@nl;
    shacl:name "resulterendeOrganisatie"@nl;
    shacl:path org:resultingOrganization
  ], [
    a shacl:PropertyShape;
    rdfs:label "oorspronkelijkeOrganisatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Merk op dat deze relatie zinloos is als het Veranderingsmoment een Oprichting is (een Oprichting is geen verandering aan bestaande Organisatie)."@nl;
    rdfs:comment "Organisatie die de Veranderingsgebeurtenis onderging."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Veranderingsgebeurtenis.Oorspronkelijkeorganisatie>;
    shacl:class org:Organization;
    shacl:description "Organisatie die de Veranderingsgebeurtenis onderging."@nl;
    shacl:name "oorspronkelijkeOrganisatie"@nl;
    shacl:path org:originalOrganization
  ];
  shacl:targetClass org:ChangeEvent .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#VervangingShape> a shacl:NodeShape;
  rdfs:label "Vervanging"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: doorstart van een bedrijf na technisch faillissement."@nl;
  rdfs:comment "Gebeurtenis waarbij een organisatie wordt vervangen door een andere."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/organisatie#Vervanging> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#VestigingShape> a shacl:NodeShape;
  rdfs:label "Vestiging"@nl;
  <http://purl.org/vocab/vann/usageNote> "Meestal zal de Vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten, bijvoorbeeld een virtueel kantoor met bijbehorend postnummer en telefonische receptie."@nl;
  rdfs:comment "Een kantoor of ander pand waar een Organisatie gevestigd is. Organisaties kunnen over meerdere Vestigingen verspreid zijn en Vestigingen kunnen op meerdere locaties slaan."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "vestigingsadres"@nl;
    <http://purl.org/vocab/vann/usageNote> "Kan email, telefoon en ook adres zijn (in welk geval ook niet-fysieke adressen mogelijk zijn)."@nl;
    rdfs:comment "Adres van de Vestiging."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/2025#Vestiging.Vestigingsadres>;
    shacl:class schemas:ContactPoint;
    shacl:description "Adres van de Vestiging."@nl;
    shacl:maxCount "1";
    shacl:name "vestigingsadres"@nl;
    shacl:path org:siteAddress
  ];
  shacl:targetClass org:Site .
