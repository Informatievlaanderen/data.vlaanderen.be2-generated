    rdfs:comment "Organisatie die dochter of onderdeel is van de organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Organisatie.HeeftSuborganisatie>;
