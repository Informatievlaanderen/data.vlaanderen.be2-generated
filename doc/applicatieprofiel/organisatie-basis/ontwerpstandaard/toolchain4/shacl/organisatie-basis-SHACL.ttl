<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#AdresseerbaarObjectShape> a shacl:NodeShape;
  rdfs:label "Adresseerbaar Object"@nl;
  <http://purl.org/vocab/vann/usageNote> "Is abstract, ttz het type adresseerbaar object moet altijd worden opgegeven (vb gebouweenheid, perceel)."@nl;
  rdfs:comment "Geografisch object dat met een adres kan worden geïdentificeerd."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#AdresseerbaarObject> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "heeft geregistreerde organisatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb een eenmanszaak die door een natuurlijk persoon wordt uitgebaat of een niet-geregistreerde organisatie die meerdere geregistreerde organisaties omvat."@nl;
    rdfs:comment "Verwijst naar de geregistreerde organisatie waarmee de agent geassocieerd is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Agent.HeeftGeregistreerdeOrganisatie>;
    shacl:class <http://www.w3.org/ns/regorg#RegisteredOrganization>;
    shacl:description "Verwijst naar de geregistreerde organisatie waarmee de agent geassocieerd is."@nl;
    shacl:name "heeft geregistreerde organisatie"@nl;
    shacl:path <http://www.w3.org/ns/regorg#hasRegisteredOrganization>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rapporteert aan"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gecombineerd met Positie rapporteertAan-Positie kan het organogram vd Organisatie gedocumenteerd worden."@nl;
    rdfs:comment "Verwijst naar de Agent waaraan de Agent verantwoording aflegt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Agent.RapporteertAan>;
    shacl:class dc:Agent;
    shacl:description "Verwijst naar de Agent waaraan de Agent verantwoording aflegt."@nl;
    shacl:name "rapporteert aan"@nl;
    shacl:path org:reportsTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "houdt"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Geeft aan welke positie een agent heeft (typisch bij de organisatie waar de positie is gedefinieerd)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Agent.Houdt>;
    shacl:class org:Post;
    shacl:description "Geeft aan welke positie een agent heeft (typisch bij de organisatie waar de positie is gedefinieerd)."@nl;
    shacl:name "houdt"@nl;
    shacl:path org:holds
  ], [
    a shacl:PropertyShape;
    rdfs:label "is hoofd van"@nl;
    rdfs:comment "Verwijst naar de organisatie waaraan een agent aan het hoofd staat of leiding geeft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Agent.IsHoofdVan>;
    shacl:class org:Organization;
    shacl:description "Verwijst naar de organisatie waaraan een agent aan het hoofd staat of leiding geeft."@nl;
    shacl:name "is hoofd van"@nl;
    shacl:path org:headOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "is lid van"@nl;
    <http://purl.org/vocab/vann/usageNote> """Dekt elk type aansluiting of betrokkenheid van een agent bij een organisatie, niet enkel formeel lidmaatschap. Kan eventueel verder gespecialiseerd worden.

Het lidmaatschap wordt meer in detail beschreven met de entiteit lidmaatschap ( d.m.v. associatieklasse modellering)."""@nl;
    rdfs:comment "Niet nader bepaald lidmaatschap van een agent van een organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Agent.IsLidVan>;
    shacl:class org:Organization;
    shacl:description "Niet nader bepaald lidmaatschap van een agent van een organisatie."@nl;
    shacl:name "is lid van"@nl;
    shacl:path org:memberOf
  ];
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:targetClass schema:ContactPoint .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#FormeelKaderShape> a shacl:NodeShape;
  rdfs:label "Formeel Kader"@nl;
  <http://purl.org/vocab/vann/usageNote> "De documenten waarvan sprake zijn wetten, beleidsdocumenten, regulaties, contracten ed."@nl;
  rdfs:comment "Geheel van formele documenten dat regels, rechten, plichten ten aanzien van burgers, overheden, bedrijven etc beschrijft."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam vh formeel kader."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#FormeelKader.Naam>;
    shacl:class rdf:langString;
    shacl:description "Naam vh formeel kader."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ];
  shacl:targetClass <http://purl.org/vocab/cpsv#FormalFramework> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#FormeleOrganisatieShape> a shacl:NodeShape;
  rdfs:label "Formele Organisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb een bedrijf,een vzw,een overheidsorgaan,een kerkgemeenschap."@nl;
  rdfs:comment "Een erkende organisatie, erkend in brede zin of  meer specifiek in juridische zin met bijbehorende rechten en plichten."@nl;
  shacl:closed false;
  shacl:targetClass org:FormalOrganization .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#FusieShape> a shacl:NodeShape;
  rdfs:label "Fusie"@nl;
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Gebeurtenis waarbij twee organisaties samen een nieuwe organisatie vormen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/organisatie#Fusie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatieShape> a shacl:NodeShape;
  rdfs:label "Geregistreerde Organisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "In België moeten oa volgende organisaties zich registreren: vennootschap (nv,bvba etc),eenmanszaak,overheidsorgaan,stichting… Bij registratie krijgt de organisatie een ondernemingsnummer en worden zijn gegevens ingevoerd in de KBO."@nl;
  rdfs:comment "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een formele organisatie waarbij dit statuut ook op een andere manier verkregen kan zijn."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "rechtspersoonlijkheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een rechtspersoon is een juridische constructie die een organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc). Vb privaatrechterlijke rechtspersonen: vennootschappen, vzw's etc.; vb publiekrechterlijke rechtspersonen: steden, gemeenten etc. Een feitelijke vereniging is in principe geen rechtspersoon maar wordt als ze geregistreerd is id KBO toch als dusdanig geklasseerd."@nl;
    rdfs:comment "Geeft aan of de rechtspersoonlijkheid van de geregistreerde organisatie deze is van een natuurlijk persoon of van een rechtspersoon."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Rechtspersoonlijkheid>;
    shacl:class skos:Concept;
    shacl:description "Geeft aan of de rechtspersoonlijkheid van de geregistreerde organisatie deze is van een natuurlijk persoon of van een rechtspersoon."@nl;
    shacl:maxCount "1";
    shacl:name "rechtspersoonlijkheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#rechtspersoonlijkheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtstoestand"@nl;
    <http://purl.org/vocab/vann/usageNote> "Stemt in de KBO overeen met rechtstoestand, bvb normale toestand, gerechtelijk akkoord, opening faillissement etc."@nl;
    rdfs:comment "Status van de geregistreerde organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Rechtstoestand>;
    shacl:class skos:Concept;
    shacl:description "Status van de geregistreerde organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "rechtstoestand"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#rechtstoestand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtsvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Stemt in de KBO overeen met rechtsvorm, bvb NV, VZW, Stad/Gemeente, OCMW etc."@nl;
    rdfs:comment "Juridisch statuut van de geregistreerde organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Rechtsvorm>;
    shacl:class skos:Concept;
    shacl:description "Juridisch statuut van de geregistreerde organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "rechtsvorm"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#rechtsvorm>
  ], [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    <http://purl.org/vocab/vann/usageNote> "In de KBO is dit het ondernemingsnummer."@nl;
    rdfs:comment "Identificator dat de organisatie verkreeg bij registratie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator dat de organisatie verkreeg bij registratie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wettelijke naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Evt in verschillende talen."@nl;
    rdfs:comment "Wettelijk geregistreerde naam vd organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.WettelijkeNaam>;
    shacl:class rdf:langString;
    shacl:description "Wettelijk geregistreerde naam vd organisatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "wettelijke naam"@nl;
    shacl:path <http://www.w3.org/ns/regorg#legalName>
  ];
  shacl:targetClass <http://www.w3.org/ns/regorg#RegisteredOrganization> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#HoedanigheidShape> a shacl:NodeShape;
  rdfs:label "Hoedanigheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Laat een functie toe om te handelen,bv ihkv een dienstverlening (bv diversiteitsplan wordt opgemaakt door diversiteitsambtenaar)."@nl;
  rdfs:comment "Agent met een positie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Informatie zoals email, telefoon… die toelaat de hoedanigheid te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Hoedanigheid.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Informatie zoals email, telefoon… die toelaat de hoedanigheid te contacteren."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#contactinfo>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/organisatie#Hoedanigheid> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#LidmaatschapShape> a shacl:NodeShape;
  rdfs:label "Lidmaatschap"@nl;
  rdfs:comment "Geeft de kenmerken weer vh lidmaatschap van een agent van een organisatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lid van tot"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Periode waarin de agent lid was vd organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Lidmaatschap.LidVanTot>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Periode waarin de agent lid was vd organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "lid van tot"@nl;
    shacl:path org:memberDuring
  ], [
    a shacl:PropertyShape;
    rdfs:label "rol"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Rol die de agent vervult als lid van de organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Lidmaatschap.Rol>;
    shacl:class org:Role;
    shacl:description "Rol die de agent vervult als lid van de organisatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "rol"@nl;
    shacl:path org:role
  ], [
    a shacl:PropertyShape;
    rdfs:label "lid"@nl;
    rdfs:comment "Lidmaatschap van een agent (van een organisatie)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Lidmaatschap.Lid>;
    shacl:class dc:Agent;
    shacl:description "Lidmaatschap van een agent (van een organisatie)."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lid"@nl;
    shacl:path org:member
  ], [
    a shacl:PropertyShape;
    rdfs:label "is lidmaatschap bij"@nl;
    rdfs:comment "Organisatie waarop het lidmaatschap (van een agent) betrekking heeft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Lidmaatschap.IsLidmaatschapBij>;
    shacl:class org:Organization;
    shacl:description "Organisatie waarop het lidmaatschap (van een agent) betrekking heeft."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is lidmaatschap bij"@nl;
    shacl:path org:organization
  ];
  shacl:targetClass org:Membership .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#OprichtingShape> a shacl:NodeShape;
  rdfs:label "Oprichting"@nl;
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Gebeurtenis waarbij een organisatie is opgericht."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/m8g/FoundationEvent> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Organisatie-eenheidShape> a shacl:NodeShape;
  rdfs:label "Organisatie-eenheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Organisatie-eenheden kunnen groot en complex zijn en bestaan uit andere organisatie-eenheden."@nl;
  rdfs:comment "Een organisatie zoals een afdeling of dienst die deel uitmaakt van de grotere organisatie en zijn bestaansreden daaraan ontleent. Heeft geen juridische status op zich."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is eenheid van"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Organisatie waarvan de organisatie-eenheid deel uitmaakt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Organisatie-eenheid.IsEenheidVan>;
