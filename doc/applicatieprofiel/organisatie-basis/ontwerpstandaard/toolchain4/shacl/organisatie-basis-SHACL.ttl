    rdfs:comment "Niet nader bepaalde relatie met een andere organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Organisatie.IsGeassocieerdMet>;
    shacl:class org:Organization;
    shacl:description "Niet nader bepaalde relatie met een andere organisatie."@nl;
    shacl:name "is geassocieerd met"@nl;
    shacl:path org:linkedTo
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft vestiging"@nl;
    <http://purl.org/vocab/vann/usageNote> "Indirect bvb een virtueel kantoor waarvan de locatie niet rechtstreeks achterhaald kan worden (bv postbus). In België mogen in de KBO geregistreerde organisaties enkel fysieke locaties als vestiging registreren."@nl;
    rdfs:comment "Verwijst naar een plek waar de organisatie op een of andere manier, desnoods indirect, aanwezig is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Organisatie.HeeftVestiging>;
    shacl:class org:Site;
    shacl:description "Verwijst naar een plek waar de organisatie op een of andere manier, desnoods indirect, aanwezig is."@nl;
    shacl:name "heeft vestiging"@nl;
    shacl:path org:hasSite
  ], [
    a shacl:PropertyShape;
    rdfs:label "is suborganisatie van"@nl;
    <http://purl.org/vocab/vann/usageNote> "Wordt gebruikt om een hiërarchie van organisaties te documenteren."@nl;
    rdfs:comment "Organisatie die deze organisatie omvat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Organisatie.IsSuborganisatieVan>;
    shacl:class org:Organization;
    shacl:description "Organisatie die deze organisatie omvat."@nl;
    shacl:name "is suborganisatie van"@nl;
    shacl:path org:subOrganizationOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "is het resultaat van"@nl;
    rdfs:comment "Verwijst naar het veranderingsmoment dat tot de huidige organisatie heeft geleid."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Organisatie.IsHetResultaatVan>;
