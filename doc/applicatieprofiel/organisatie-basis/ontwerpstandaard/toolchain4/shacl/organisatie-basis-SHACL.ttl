    shacl:name "is het resultaat van"@nl;
    shacl:path org:resultedFrom
  ], [
    a shacl:PropertyShape;
    rdfs:label "is veranderd door"@nl;
    rdfs:comment "Verwijst naar het veranderingsmoment dat deze organisatie heeft veranderd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Organisatie.IsVeranderdDoor>;
    shacl:class org:ChangeEvent;
    shacl:description "Verwijst naar het veranderingsmoment dat deze organisatie heeft veranderd."@nl;
    shacl:name "is veranderd door"@nl;
    shacl:path org:changedBy
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft eenheid"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Verwijst naar een organisatie-eenheid die deel uitmaakt van de organisatie, bv een afdeling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Organisatie.HeeftEenheid>;
    shacl:class org:OrganizationalUnit;
    shacl:description "Verwijst naar een organisatie-eenheid die deel uitmaakt van de organisatie, bv een afdeling."@nl;
    shacl:name "heeft eenheid"@nl;
    shacl:path org:hasUnit
  ], [
    a shacl:PropertyShape;
    rdfs:label "lid"@nl;
    <http://purl.org/vocab/vann/usageNote> """Dekt elk type aansluiting of betrokkenheid van een agent bij een organisatie, niet enkel formeel lidmaatschap. Kan eventueel verder gespecialiseerd worden.

Het lidmaatschap wordt meer in detail beschreven met de entiteit lidmaatschap ( d.m.v. associatieklasse modellering)."""@nl;
    rdfs:comment "Agent die lid is (van een organisatie)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/organisatie-basis/ontwerpstandaard/toolchain4#Organisatie.Lid>;
    shacl:class dc:Agent;
