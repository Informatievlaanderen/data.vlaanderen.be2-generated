  shacl:closed false;
  shacl:targetClass xsd:double .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#GebouwShape> a shacl:NodeShape;
  rdfs:label "Gebouw"@nl;
  rdfs:comment "Een gesloten en/of overdekt, bovengronds of ondergronds bouwwerk, dat dient of bestemd is, ofwel om mensen, dieren en voorwerpen onder te brengen, ofwel om economische goederen te vervaardigen of diensten te verstrekken. Een gebouw verwijst naar gelijk welke structuur die op blijvende wijze op een terrein opgetrokken of gebouwd wordt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "ligtOp"@nl;
    rdfs:comment "De kadastrale planpercelen waarmee het gebouw officieel geassocieerd is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Gebouw.Ligtop>;
    shacl:class <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel>;
    shacl:description "De kadastrale planpercelen waarmee het gebouw officieel geassocieerd is."@nl;
    shacl:name "ligtOp"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#ligtOp>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/gebouw#Gebouw> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#GeometrieShape> a shacl:NodeShape;
  rdfs:label "Geometrie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijft deze kenmerken door middel van punten, lijnen, polygonen en coördinaten."@nl;
  rdfs:comment "Vorm- en positiekenmerken van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gml"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#gmlLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in gml-formaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Geometrie.Gml>;
    shacl:description "Geometrie uitgedrukt in gml-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "gml"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.opengis.net/ont/geosparql#asGML>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wkt"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#wktLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in wkt-formaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Geometrie.Wkt>;
    shacl:description "Geometrie uitgedrukt in wkt-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "wkt"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.opengis.net/ont/geosparql#asWKT>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Geometry> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#GeometriemethodewaardeShape> a shacl:NodeShape;
  rdfs:label "GeometrieMethodeWaarde"@nl;
  <http://purl.org/vocab/vann/usageNote> "De methode geeft aan op welke manier de geometrie tot stand is gekomen."@nl;
  rdfs:comment "De methode geeft aan op welke manier de geometrie tot stand is gekomen."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#GestructureerdeidentificatorShape> a shacl:NodeShape;
  rdfs:label "GestructureerdeIdentificator"@nl;
  rdfs:comment "Identificator van een object opgesplitst in zijn onderdelen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lokaleIdentificator"@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren binnen de naamruimte."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Gestructureerdeidentificator.Lokaleidentificator>;
    shacl:datatype xsd:string;
    shacl:description "String gebruikt om het object uniek te identificeren binnen de naamruimte."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lokaleIdentificator"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#lokaleIdentificator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naamruimte"@nl;
    <http://purl.org/vocab/vann/usageNote> "Laat toe om objecten met dezelfde identificator maar van verschillend type en/of afkomstig uit verschillende domeinen uiteen te houden. In praktijk bijvoorbeeld een uri samengesteld uit betekenisvolle elementen zoals een domeinnaam, type en concept (bijvoorbeeld https://data.vlaanderen.be/id/adres/)."@nl;
    rdfs:comment "String die toegvoegd wordt aan de lokaleidentificator om deze globaal uniek te maken."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Gestructureerdeidentificator.Naamruimte>;
    shacl:datatype xsd:string;
    shacl:description "String die toegvoegd wordt aan de lokaleidentificator om deze globaal uniek te maken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naamruimte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#naamruimte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "versieIdentificator"@nl;
    rdfs:comment "Identificator van de specifieke versie van een object."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Gestructureerdeidentificator.Versieidentificator>;
    shacl:datatype xsd:string;
    shacl:description "Identificator van de specifieke versie van een object."@nl;
    shacl:maxCount "1";
    shacl:name "versieIdentificator"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#versieIdentificator>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek#GestructureerdeIdentificator> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#GetalShape> a shacl:NodeShape;
  rdfs:label "Getal"@nl;
  <http://purl.org/vocab/vann/usageNote> "In praktijk de primitieve datatypes waarmee een hoeveelheid kan worden aangeduid, zie xsd datatypes float, double, decimal, integer etc."@nl;
  rdfs:comment "Aanduiding van een hoeveelheid."@nl;
  shacl:closed false;
  shacl:targetClass schemas:Number .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "toegekendOp"@nl;
    rdfs:comment "Tijdstip waarop de identificator werd uitgegeven."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Identificator.Toegekendop>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekendOp"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type van de string slaat op het identificatiesysteem (inclusief de versie ervan), de string zelf op de eigenlijke identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Identificator.Identificator>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount "1";
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "gestructureerdeIdentificator"@nl;
    rdfs:comment "Identificator van het object opgesplitst in zijn onderdelen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Identificator.Gestructureerdeidentificator>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#GestructureerdeIdentificator>;
    shacl:description "Identificator van het object opgesplitst in zijn onderdelen."@nl;
    shacl:maxCount "1";
    shacl:name "gestructureerdeIdentificator"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#gestructureerdeIdentificator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendDoor"@nl;
    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Identificator.Toegekenddoor>;
    shacl:class dc:Agent;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekendDoor"@nl;
    shacl:path dc:creator
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendDoorString"@nl;
    rdfs:comment "Naam van de agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Identificator.Toegekenddoorstring>;
    shacl:class dc:Agent;
    shacl:description "Naam van de agent die de identificator heeft toegekend."@nl;
    shacl:maxCount "1";
    shacl:name "toegekendDoorString"@nl;
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#IntegerShape> a shacl:NodeShape;
  rdfs:label "Integer";
  shacl:closed false;
  shacl:targetClass xsd:integer .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KadastraalpatrimoniumperceelShape> a shacl:NodeShape;
  rdfs:label "KadastraalPatrimoniumperceel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze definitie is gealigneerd met de definitie van de Algemene Administratie van de PatrimoniumDocumentatie (AAPD). Kadastraal Patrimoniumperceel komt overeen met de entiteit BasicPropertyUnit uit INSPIRE Cadastral Parcel. De identificator die gedefinieerd kan worden voor een Kadastraal patrimoniumperceel komt overeen met de PatKey. Ter informatie: de PatKey is samengesteld uit de CaPaKey en het partitienummer. Bijvoorbeeld: in Patkey 11111A2222/33B444_P0000 is 11111A2222/33B444 de CaPaKey en P0000 het partitienummer."@nl;
  rdfs:comment "Een onroerend goed of onroerend recht dat in hoofde van één of meerdere titularissen van een zakelijk recht onderworpen is aan een bepaald eigendomsstatuut."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datumBijwerking"@nl;
    rdfs:comment "Datum van de laatste bijwerking."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Kadastraalpatrimoniumperceel.Datumbijwerking>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum van de laatste bijwerking."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datumBijwerking"@nl;
    shacl:path <https://data.vlaanderen.be/ns/perceel#datumbijwerking>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze identificator komt overeen met de Patkey van het AAPD."@nl;
    rdfs:comment "De identificator van het Kadastraal Patrimoniumperceel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Kadastraalpatrimoniumperceel.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "De identificator van het Kadastraal Patrimoniumperceel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "agentMetZakelijkRecht"@nl;
    rdfs:comment "Agent die een zakelijk recht heeft op een kadastraal patrimoniumperceel."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Kadastraalpatrimoniumperceel.Agentmetzakelijkrecht>;
    shacl:class dc:Agent;
    shacl:description "Agent die een zakelijk recht heeft op een kadastraal patrimoniumperceel."@nl;
    shacl:minCount 1;
    shacl:name "agentMetZakelijkRecht"@nl;
    shacl:path <https://data.vlaanderen.be/ns/perceel#agentMetZakelijkRecht>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isGerelateerdAan"@nl;
    rdfs:comment "Duidt het kadastraal planperceel aan waaraan het patrimoniumperceel gekoppeld kan worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Kadastraalpatrimoniumperceel.Isgerelateerdaan>;
    shacl:class <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel>;
    shacl:description "Duidt het kadastraal planperceel aan waaraan het patrimoniumperceel gekoppeld kan worden."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "isGerelateerdAan"@nl;
    shacl:path dc:relation
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/perceel#KadastraalPatrimoniumperceel> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KadastraalplanperceelShape> a shacl:NodeShape;
  rdfs:label "KadastraalPlanperceel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Kadastraal Planperceel komt overeen met de entiteit CadastralParcel uit INSPIRE Cadastral Parcel. De identificator die gedefinieerd kan worden voor een Kadastraal planperceel komt overeen met de CaPaKey (bijvoorbeeld 11111A2222/33B444)."@nl;
  rdfs:comment "Een gedeelte van het Belgische grondgebied, geografische afgebakend en geïdentificeerd door de AAPD op het kadastraal percelenplan, dat overeenstemt met het grondoppervlak van één of meerdere kadastrale patrimoniale percelen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datumBijwerking"@nl;
    rdfs:comment "Datum van de laatste bijwerking."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Kadastraalplanperceel.Datumbijwerking>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum van de laatste bijwerking."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datumBijwerking"@nl;
    shacl:path <https://data.vlaanderen.be/ns/perceel#datumbijwerking>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KwantitatievewaardeShape> a shacl:NodeShape;
  rdfs:label "KwantitatieveWaarde"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de hoogte van een object , het gewicht, de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog, laag en dergelijke vallen hier dus niet onder."@nl;
  rdfs:comment "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "eenheid"@nl;
