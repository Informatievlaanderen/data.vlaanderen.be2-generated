<https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#GestructureerdeIdentificatorShape> a shacl:NodeShape;
  rdfs:label "Gestructureerde Identificator"@nl;
  rdfs:comment "Identificator van een object opgesplitst in zijn onderdelen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lokale identificator"@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren binnen de naamruimte."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#GestructureerdeIdentificator.LokaleIdentificator>;
    shacl:datatype xsd:string;
    shacl:description "String gebruikt om het object uniek te identificeren binnen de naamruimte."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lokale identificator"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#lokaleIdentificator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naamruimte"@nl;
    <http://purl.org/vocab/vann/usageNote> "Laat toe om objecten met dezelfde identificator maar van verschillend type en/of afkomstig uit verschillende domeinen uiteen te houden. In praktijk bv een uri samengesteld uit betekenisvolle elementen zoals een domeinnaam, type en concept (bv https://data.vlaanderen.be/id/adres/)."@nl;
    rdfs:comment "String die toegvoegd wordt aan de lokaleidentificator om deze globaal uniek te maken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#GestructureerdeIdentificator.Naamruimte>;
    shacl:datatype xsd:string;
    shacl:description "String die toegvoegd wordt aan de lokaleidentificator om deze globaal uniek te maken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naamruimte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#naamruimte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "versie-identificator"@nl;
    rdfs:comment "Identificator van de specifieke versie van een object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#GestructureerdeIdentificator.Versie-identificator>;
    shacl:datatype xsd:string;
    shacl:description "Identificator van de specifieke versie van een object."@nl;
    shacl:maxCount "1";
    shacl:name "versie-identificator"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#versieIdentificator>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek#GestructureerdeIdentificator> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#GetalShape> a shacl:NodeShape;
  rdfs:label "Getal"@nl;
  <http://purl.org/vocab/vann/usageNote> "In praktijk de primitieve datatypes waarmee een hoeveelheid kan worden aangeduid, zie xsd datatypes float, double, decimal, integer etc."@nl;
  rdfs:comment "Aanduiding van een hoeveelheid."@nl;
  shacl:closed false;
  shacl:targetClass schemas:Number .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "toegekend op"@nl;
    rdfs:comment "Tijdstip waarop de identificator werd uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Identificator.ToegekendOp>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend op"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type vd string slaat op het identificatiesysteem (incl de versie ervan), de string zelf op de eigenlijke identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Identificator.Identificator>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount "1";
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "gestructureerde identificator"@nl;
    rdfs:comment "Identificator vh object opgesplitst in zijn onderdelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Identificator.GestructureerdeIdentificator>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#GestructureerdeIdentificator>;
    shacl:description "Identificator vh object opgesplitst in zijn onderdelen."@nl;
    shacl:maxCount "1";
    shacl:name "gestructureerde identificator"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#gestructureerdeIdentificator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door"@nl;
    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Identificator.ToegekendDoor>;
    shacl:class dc:Agent;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend door"@nl;
    shacl:path dc:creator
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door (String)"@nl;
    rdfs:comment "Naam vd agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#Identificator.ToegekendDoor(string)>;
    shacl:class dc:Agent;
    shacl:description "Naam vd agent die de identificator heeft toegekend."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend door (String)"@nl;
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#IntegerShape> a shacl:NodeShape;
  rdfs:label "Integer";
  shacl:closed false;
  shacl:targetClass xsd:integer .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KadastraalPatrimoniumperceelShape> a shacl:NodeShape;
  rdfs:label "Kadastraal Patrimoniumperceel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze definitie is gealigneerd met de definitie van de Algemene Administratie van de PatrimoniumDocumentatie (AAPD). Kadastraal Patrimoniumperceel komt overeen met de entiteit BasicPropertyUnit uit INSPIRE Cadastral Parcel. De identificator die gedefinieerd kan worden voor een Kadastraal patrimoniumperceel komt overeen met de PatKey. Ter informatie: de PatKey is samengesteld uit de CaPaKey en het partitienummer. Bijvoorbeeld: in Patkey 11111A2222/33B444_P0000 is 11111A2222/33B444 de CaPaKey en P0000 het partitienummer."@nl;
  rdfs:comment "Een onroerend goed of onroerend recht dat in hoofde van één of meerdere titularissen van een zakelijk recht onderworpen is aan een bepaald eigendomsstatuut."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum bijwerking"@nl;
    rdfs:comment "Datum van de laatste bijwerking."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KadastraalPatrimoniumperceel.DatumBijwerking>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum van de laatste bijwerking."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum bijwerking"@nl;
    shacl:path <https://data.vlaanderen.be/ns/perceel#datumbijwerking>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze identificator komt overeen met de Patkey van het AAPD."@nl;
    rdfs:comment "De identificator van het Kadastraal Patrimoniumperceel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KadastraalPatrimoniumperceel.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "De identificator van het Kadastraal Patrimoniumperceel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "agent met zakelijk recht"@nl;
    rdfs:comment "Agent die een zakelijk recht heeft op een kadastraal patrimoniumperceel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KadastraalPatrimoniumperceel.AgentMetZakelijkRecht>;
    shacl:class dc:Agent;
    shacl:description "Agent die een zakelijk recht heeft op een kadastraal patrimoniumperceel."@nl;
    shacl:minCount "1";
    shacl:name "agent met zakelijk recht"@nl;
    shacl:path <https://data.vlaanderen.be/ns/perceel#agentMetZakelijkRecht>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is gerelateerd aan"@nl;
    rdfs:comment "Duidt het kadastraal planperceel aan waaraan het patrimoniumperceel gekoppeld kan worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KadastraalPatrimoniumperceel.IsGerelateerdAan>;
    shacl:class <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel>;
    shacl:description "Duidt het kadastraal planperceel aan waaraan het patrimoniumperceel gekoppeld kan worden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is gerelateerd aan"@nl;
    shacl:path dc:relation
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/perceel#KadastraalPatrimoniumperceel> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KadastraalPlanperceelShape> a shacl:NodeShape;
  rdfs:label "Kadastraal Planperceel"@nl;
  <http://purl.org/vocab/vann/usageNote> "Kadastraal Planperceel komt overeen met de entiteit CadastralParcel uit INSPIRE Cadastral Parcel. De identificator die gedefinieerd kan worden voor een Kadastraal planperceel komt overeen met de CaPaKey (bijvoorbeeld 11111A2222/33B444)."@nl;
  rdfs:comment "Een gedeelte van het Belgische grondgebied, geografische afgebakend en geïdentificeerd door de AAPD op het kadastraal percelenplan, dat overeenstemt met het grondoppervlak van één of meerdere kadastrale patrimoniale percelen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum bijwerking"@nl;
    rdfs:comment "Datum van de laatste bijwerking."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KadastraalPlanperceel.DatumBijwerking>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum van de laatste bijwerking."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum bijwerking"@nl;
    shacl:path <https://data.vlaanderen.be/ns/perceel#datumbijwerking>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ligt op"@nl;
    rdfs:comment "De kadastrale planpercelen waarmee het gebouw officieel geassocieerd is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/perceel/ontwerpstandaard/toolchain4#KadastraalPlanperceel.LigtOp>;
    shacl:class <https://data.vlaanderen.be/ns/gebouw#Gebouw>;
    shacl:description "De kadastrale planpercelen waarmee het gebouw officieel geassocieerd is."@nl;
    shacl:name "ligt op"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#ligtOp>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is gerelateerd aan"@nl;
    rdfs:comment "Duidt het kadastraal planperceel aan waaraan het patrimoniumperceel gekoppeld kan worden."@nl;
