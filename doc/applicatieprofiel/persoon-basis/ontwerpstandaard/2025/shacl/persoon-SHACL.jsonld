  {
    "@id": "https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#DomicilieShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Plaats waar de Persoon het grootste deel van de tijd verblijft binnen de jurisdictie waarvan hij Inwoner is. Dit wordt doorgaans officieel vastgesteld en geregistreerd ih bevolkingsregister. Kan in praktijk verschillend zijn van de feitelijke verblijfplaats."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Hoofdverblijfplaats van een Persoon."
      }
    ],
