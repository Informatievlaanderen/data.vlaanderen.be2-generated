      {
        "@id": "_:df_8_71"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://xmlns.com/foaf/0.1/Agent"
      },
      {
        "@id": "http://purl.org/dc/terms/Agent"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Agent"
      }
    ]
  },
  {
