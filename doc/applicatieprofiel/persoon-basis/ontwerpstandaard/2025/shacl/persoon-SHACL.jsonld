      {
        "@id": "_:df_8_3"
      },
      {
        "@id": "_:df_8_52"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/persoon#Afstamming"
      }
    ]
  },
  {
    "@id": "https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#AgentShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Te vervangen door een niet-abstracte klasse."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een agent zoals een Persoon, groep, software of fysiek artifact."
      },
      {
        "@language": "nl",
        "@value": "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."
      },
      {
        "@language": "nl",
        "@value": "Een Agent is verantwoordelijk voor een bepaalde Activiteit, bestaan van een Object, of een Activiteit van een andere Agent."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Agent"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
