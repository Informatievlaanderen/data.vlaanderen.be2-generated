<https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld als attribuut van een persoon of gebouw, ... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Land>;
    shacl:datatype rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 1"@nl;
    rdfs:comment "Hoogste Administratieve eenheid van het adres, doorgaans een land."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.AdministratieveEenheidNiveau1>;
    shacl:datatype rdf:langString;
    shacl:description "Hoogste Administratieve eenheid van het adres, doorgaans een land."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 1"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL1>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding tbv Belgische adressen."@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Straatnaam van het adres."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Straatnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Straatnaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volledigAdres"@nl;
    <http://purl.org/vocab/vann/usageNote> "Vermijdt fouten ten gevolge van het opsplitsen van een adres in zijn onderdelen. Geeft de voorgeschreven volgorde van de verschillende onderdelen weer."@nl;
    rdfs:comment "Het complete adres in één string, al dan niet geformatteerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Volledigadres>;
    shacl:datatype rdf:langString;
    shacl:description "Het complete adres in één string, al dan niet geformatteerd."@nl;
    shacl:maxCount "1";
    shacl:name "volledigAdres"@nl;
    shacl:path <http://www.w3.org/ns/locn#fullAddress>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 2"@nl;
    rdfs:comment "De regio van het adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.AdministratieveEenheidNiveau2>;
    shacl:datatype rdf:langString;
    shacl:description "De regio van het adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 2"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL2>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatienaam"@nl;
    rdfs:comment "Naam of omschrijving van het het geografisch object dat de adreslocator aanduidt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Locatienaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam of omschrijving van het het geografisch object dat de adreslocator aanduidt."@nl;
    shacl:name "locatienaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postbus"@nl;
    rdfs:comment "Postbusnummer in een postkantoor."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Postbus>;
    shacl:datatype xsd:string;
    shacl:description "Postbusnummer in een postkantoor."@nl;
    shacl:maxCount "1";
    shacl:name "postbus"@nl;
    shacl:path <http://www.w3.org/ns/locn#poBox>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adresgebied"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb de naam van het gehucht waarin het adres ligt."@nl;
    rdfs:comment "Naam van een geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Adresgebied>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van een geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is."@nl;
    shacl:maxCount "1";
    shacl:name "adresgebied"@nl;
    shacl:path <http://www.w3.org/ns/locn#addressArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam van het adres."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatieaanduiding"@nl;
    rdfs:comment "Alfanumerieke code die de adreslocator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Locatieaanduiding>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code die de adreslocator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    shacl:name "locatieaanduiding"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorDesignator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding ten behoeve van Belgische adressen."@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postnaam"@nl;
    rdfs:comment "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Adresvoorstelling.Postnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#postName>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#AfstammingShape> a shacl:NodeShape;
  rdfs:label "Afstamming"@nl;
  <http://purl.org/vocab/vann/usageNote> "De afstamming kan ook niet-biologisch zijn, bijvoorbeeld adoptie. Afstamming kan ook in opgaande lijn worden bekeken. Het begrip is enger dan verwantschap dat onder andere ook Huwelijk inhoudt."@nl;
  rdfs:comment "Afstamming is de dalende lijn van bloedverwantschap tussen verschillende generaties."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datumVanAfstamming"@nl;
    rdfs:comment "De datum waarop de afstamming wordt vastgesteld."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Afstamming.Datumvanafstamming>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop de afstamming wordt vastgesteld."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datumVanAfstamming"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#datumVanAfstamming>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afstammingstype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: geadopteerd, kind uit huwelijk, erkend door de vader, etc."@nl;
    rdfs:comment "Aard van de afstamming."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Afstamming.Afstammingstype>;
    shacl:class skos:Concept;
    shacl:description "Aard van de afstamming."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "afstammingstype"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#afstammingsType>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Afstamming> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te vervangen door een niet-abstracte klasse."@nl;
  rdfs:comment "Een agent zoals een Persoon, groep, software of fysiek artifact."@nl,
    "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl,
    "Een Agent is verantwoordelijk voor een bepaalde Activiteit, bestaan van een Object, of een Activiteit van een andere Agent."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "isLidVan"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dekt elk type aansluiting of betrokkenheid van een Agent bij een Organisatie, niet enkel formeel lidmaatschap. Kan eventueel verder gespecialiseerd worden. Het lidmaatschap wordt meer in detail beschreven met de entiteit Lidmaatschap (door middel van associatieklasse modellering)."@nl;
    rdfs:comment "Niet nader bepaald lidmaatschap van een Agent van een Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Agent.Islidvan>;
    shacl:class org:Organization;
    shacl:description "Niet nader bepaald lidmaatschap van een Agent van een Organisatie."@nl;
    shacl:name "isLidVan"@nl;
    shacl:path org:memberOf
  ];
  shacl:targetClass foaf:Agent,
    dc:Agent,
    prov:Agent .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#BurgerlijkestaatShape> a shacl:NodeShape;
  rdfs:label "BurgerlijkeStaat"@nl;
  <http://purl.org/vocab/vann/usageNote> "Slaat op huwelijk, partnerregistratie, afstamming, voogdij, etc. Is met andere woorde de toestand van bepaalde verhoudingen tussen personen."@nl;
  rdfs:comment "Burgerrechtelijke toestand van een Persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de Burgerlijke Staat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Burgerlijkestaat.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de Burgerlijke Staat."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#BurgerlijkeStaat> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#ContactpuntShape> a shacl:NodeShape;
  rdfs:label "Contactpunt"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen, etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanschrijfvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: De heer/Mevrouw, Excellentie, Dokter, ..."@nl;
    rdfs:comment "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Contactpunt.Aanschrijfvorm>;
    shacl:datatype rdf:langString;
    shacl:description "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    shacl:maxCount "1";
    shacl:name "aanschrijfvorm"@nl;
    shacl:path vcard:honorific-prefix
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van bijvoorbeeld de persoon die men kan contacteren."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Contactpunt.Naam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van bijvoorbeeld de persoon die men kan contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "naam"@nl;
    shacl:path foaf:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Contactpunt.Telefoon>;
    shacl:datatype xsd:string;
    shacl:description "Telefoonnummer waarop men kan bellen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schemas:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Contactpunt.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schemas:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "openingsuren"@nl;
    <http://purl.org/vocab/vann/usageNote> "Syntax volgens Schema.org voor openingsuren. Bijvoorbeeld: als contact kan worden opgenomen tussen 8 en 20u maandag tot zaterdag en tussen 8 en 18u op zondag wordt dit gecodeerd als \"ma-za 08:00-20:00, zo 08:00-18:00\"."@nl;
    rdfs:comment "Uren waarbinnen contact kan worden opgenomen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Contactpunt.Openingsuren>;
    shacl:datatype rdf:langString;
    shacl:description "Uren waarbinnen contact kan worden opgenomen."@nl;
    shacl:maxCount "1";
    shacl:name "openingsuren"@nl;
    shacl:path schemas:openingHours
  ], [
    a shacl:PropertyShape;
    rdfs:label "faxnummer"@nl;
    rdfs:comment "Faxnummer waarnaar men kan faxen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Contactpunt.Faxnummer>;
    shacl:datatype xsd:string;
    shacl:description "Faxnummer waarnaar men kan faxen."@nl;
    shacl:maxCount "1";
    shacl:name "faxnummer"@nl;
    shacl:path schemas:faxNumber
  ], [
    a shacl:PropertyShape;
    rdfs:label "website"@nl;
    rdfs:comment "Website waarnaar men kan surfen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Contactpunt.Website>;
    shacl:datatype xsd:anyURI;
    shacl:description "Website waarnaar men kan surfen."@nl;
    shacl:maxCount "1";
    shacl:name "website"@nl;
    shacl:path foaf:homepage
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbaarheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: aanduiding van het seizoen waarin contact kan worden opgenomen. Begin- en einddatum volgens ISO8601 syntax."@nl;
    rdfs:comment "Periode waarin contact kan worden opgenomen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Contactpunt.Beschikbaarheid>;
    shacl:class schemas:OpeningHoursSpecification;
    shacl:description "Periode waarin contact kan worden opgenomen."@nl;
    shacl:maxCount "1";
    shacl:name "beschikbaarheid"@nl;
    shacl:path schemas:hoursAvailable
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/2025#Contactpunt.Adres>;
