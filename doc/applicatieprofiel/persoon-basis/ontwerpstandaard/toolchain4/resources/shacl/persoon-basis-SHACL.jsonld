      {
        "@id": "_:df_8_2"
      },
      {
        "@id": "_:df_8_14"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/persoon#Afstamming"
      }
    ]
  },
