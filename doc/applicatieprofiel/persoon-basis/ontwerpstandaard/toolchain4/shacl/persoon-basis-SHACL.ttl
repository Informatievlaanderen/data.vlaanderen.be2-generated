<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#InwonerschapShape> a shacl:NodeShape;
  rdfs:label "Inwonerschap"@nl;
  rdfs:comment "Het feit dat een persoon verblijf houdt in een plaats of land."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "heeft verblijfplaats"@nl;
    rdfs:comment "Plaats waar een persoon verblijft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Inwonerschap.HeeftVerblijfplaats>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Verblijfplaats>;
    shacl:description "Plaats waar een persoon verblijft."@nl;
    shacl:name "heeft verblijfplaats"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#heeftVerblijfplaats>
  ], [
    a shacl:PropertyShape;
    rdfs:label "persoon"@nl;
    rdfs:comment "de persoon waarvan het inwonerschap binnen de opgegeven jurisdictie valt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Inwonerschap.Persoon>;
    shacl:class <http://www.w3.org/ns/person#Person>;
    shacl:description "de persoon waarvan het inwonerschap binnen de opgegeven jurisdictie valt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "persoon"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#Inwonerschap.Persoon>
  ], [
