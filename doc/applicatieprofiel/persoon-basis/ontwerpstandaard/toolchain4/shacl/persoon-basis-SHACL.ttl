    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass dc:Location .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#SamenwonenShape> a shacl:NodeShape;
  rdfs:label "Samenwonen"@nl;
  <http://purl.org/vocab/vann/usageNote> "Kan, net als bv een huwelijk, de basis vormen van een gezin."@nl;
  rdfs:comment "Regeling waarbij twee personen die niet getrouwd zijn samenleven."@nl;
  shacl:closed false;
