    rdfs:label "binnen jurisdictie"@nl;
    rdfs:comment "Jurisdictie waarbinnen het inwonerschap (ve persoon) is gedefineerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Inwonerschap.BinnenJurisdictie>;
    shacl:class dc:Jurisdiction;
    shacl:description "Jurisdictie waarbinnen het inwonerschap (ve persoon) is gedefineerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "binnen jurisdictie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#Inwonerschap.Jurisdictie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Inwonerschap> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#JurisdictieShape> a shacl:NodeShape;
  rdfs:label "Jurisdictie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Doorgaans een land of deelstaat."@nl;
  rdfs:comment "Het gebied waarover de rechtsmacht van een overheid zich uitstrekt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "plaats"@nl;
    <http://purl.org/vocab/vann/usageNote> "Typisch een land."@nl;
    rdfs:comment "Ruimtelijk gebied of benoemde plaats waarmee de Jurisdictie samenvalt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Jurisdictie.Plaats>;
    shacl:class dc:Location;
    shacl:description "Ruimtelijk gebied of benoemde plaats waarmee de Jurisdictie samenvalt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "plaats"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#plaats>
  ];
  shacl:targetClass dc:Jurisdiction .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#NationaliteitShape> a shacl:NodeShape;
  rdfs:label "Nationaliteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Merk op dat dit begrip ruimer is dan staatsburgerschap (dat zich beperkt tot de relatie met een staat). Wie de nationaliteit ve bepaald land heeft is er doorgaans ook automatisch staatsburger van. Nationaliteit wordt doorgaans autamatisch verkregen door geboorte: men krijgt hetzij de nationaliteit van zijn ouders of men krijgt deze vh land waar men Inwoner van is. Men kan een bepaalde nationaliteit ook verkrijgen door naturalisatie. In principe verliest men dan zijn oorspronkelijke nationaliteit, maar dat is niet altijd zo (meervoudige nationaliteit)."@nl;
  rdfs:comment "De relatie tussen een persoon en een staat, cultuur of loyaliteit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "nationaliteit"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "De nationaliteit vd persoon."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Nationaliteit.Nationaliteit>;
    shacl:class skos:Concept;
    shacl:description "De nationaliteit vd persoon."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "nationaliteit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#nationaliteit>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Nationaliteit> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#NationaliteitscodeShape> a shacl:NodeShape;
  rdfs:label "Nationaliteitscode";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als Agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:targetClass org:Organization .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#OverlijdenShape> a shacl:NodeShape;
  rdfs:label "Overlijden"@nl;
  rdfs:comment "Het doodgaan vd Persoon."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Overlijden> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#PermanentInwonerShape> a shacl:NodeShape;
  rdfs:label "Permanent Inwoner"@nl;
  <http://purl.org/vocab/vann/usageNote> "Is een verblijfsrecht dat in principe officieel moet worden toegekend als de persoon geen staatsburger is."@nl;
  rdfs:comment "Persoon die permanent in een bepaalde plaats of land woont."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#PermanentInwoner> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "achternaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.Achternaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "achternaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv pseudoniem, titel etc."@nl;
    rdfs:comment "Alternatief voor de volledige naam vd persoon."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.AlternatieveNaam>;
    shacl:datatype xsd:string;
    shacl:description "Alternatief voor de volledige naam vd persoon."@nl;
    shacl:name "alternatieve naam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#alternatieveNaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geboortenaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "De namen van een persoon kunnen id loop vd tijd wijzigen, bv kan de achternaam wijzigen door huwelijk. De oorspronkelijke naam wordt echter dikwijls ook nog gebruikt."@nl;
    rdfs:comment "Volledige naam vd persoon bij geboorte."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.Geboortenaam>;
    shacl:datatype xsd:string;
    shacl:description "Volledige naam vd persoon bij geboorte."@nl;
    shacl:maxCount "1";
    shacl:name "geboortenaam"@nl;
    shacl:path <http://www.w3.org/ns/person#birthName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruikte voornaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Belangrijkste vd voornamen ve persoon."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.GebruikteVoornaam>;
    shacl:datatype xsd:string;
    shacl:description "Belangrijkste vd voornamen ve persoon."@nl;
    shacl:maxCount "1";
    shacl:name "gebruikte voornaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#gebruikteVoornaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "patroniem"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv in Ijsland: Magnusdottir (dochter van Magnus)."@nl;
    rdfs:comment "Achternaam gebaseerd op de voornaam vd vader ve persoon."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.Patroniem>;
    shacl:datatype xsd:string;
    shacl:description "Achternaam gebaseerd op de voornaam vd vader ve persoon."@nl;
    shacl:maxCount "1";
    shacl:name "patroniem"@nl;
    shacl:path <http://www.w3.org/ns/person#patronymicName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volledige naam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "De volledige naam vd persoon, doorgaans de combinatie van voornamen en achternaam."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.VolledigeNaam>;
    shacl:datatype xsd:string;
    shacl:description "De volledige naam vd persoon, doorgaans de combinatie van voornamen en achternaam."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "volledige naam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#volledigeNaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "voornaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.Voornaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    shacl:minCount "1";
    shacl:name "voornaam"@nl;
    shacl:path foaf:givenName
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Persoon te contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Persoon te contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path schema:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "geslacht"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Het feit of de persoon een man of een vrouw is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.Geslacht>;
    shacl:class skos:Concept;
    shacl:description "Het feit of de persoon een man of een vrouw is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geslacht"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#geslacht>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft nationaliteit"@nl;
    rdfs:comment "Nationaliteit vd persoon."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.HeeftNationaliteit>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Nationaliteit>;
    shacl:description "Nationaliteit vd persoon."@nl;
    shacl:name "heeft nationaliteit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#heeftNationaliteit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is hoofd van"@nl;
    rdfs:comment "Persoon die standaard het gezin vertegenwoordigt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.IsHoofdVan>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Gezin>;
    shacl:description "Persoon die standaard het gezin vertegenwoordigt."@nl;
    shacl:maxCount "1";
    shacl:name "is hoofd van"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#isHoofdVan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft relatie met"@nl;
    rdfs:comment "Persoon waarmee de persoon gerelateerd is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Persoon.HeeftRelatieMet>;
    shacl:class <http://www.w3.org/ns/person#Person>;
    shacl:description "Persoon waarmee de persoon gerelateerd is."@nl;
    shacl:name "heeft relatie met"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#heeftRelatieMet>
  ], [
