<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv als attribuut ve persoon of gebouw... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#AfstammingShape> a shacl:NodeShape;
  rdfs:label "Afstamming"@nl;
  <http://purl.org/vocab/vann/usageNote> "De afstamming kan ook niet-biologisch zijn, bv adoptie. Afstamming kan ook in opgaande lijn worden bekeken. Het begrip is enger dan verwantschap dat oa ook huwelijk inhoudt."@nl;
  rdfs:comment "Afstamming is de dalende lijn van bloedverwantschap tussen verschillende generaties."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum van afstamming"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "De datum waarop de afstamming wordt vastgesteld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Afstamming.DatumVanAfstamming>;
    shacl:datatype rdfs:Literal;
    shacl:description "De datum waarop de afstamming wordt vastgesteld."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum van afstamming"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#datumVanAfstamming>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afstammingstype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv geadopteerd, kind uit huwelijk, erkend door de vader etc."@nl;
    rdfs:comment "Aard vd afstamming."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Afstamming.Afstammingstype>;
    shacl:class skos:Concept;
    shacl:description "Aard vd afstamming."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "afstammingstype"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#afstammingsType>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Afstamming> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#AfstammingstypeShape> a shacl:NodeShape;
  rdfs:label "Afstammingstype";
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Aard vd afstamming tussen twee personen."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#BurgerlijkeStaatShape> a shacl:NodeShape;
  rdfs:label "Burgerlijke Staat"@nl;
  <http://purl.org/vocab/vann/usageNote> "Slaat op huwelijk, partnerregistratie, afstamming, voogdij etc. Is maw de toestand van bepaalde verhoudingen tussen personen."@nl;
  rdfs:comment "Burgerrechtelijke toestand van een persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Aard vd burgerlijke staat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#BurgerlijkeStaat.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard vd burgerlijke staat."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#type>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#BurgerlijkeStaat> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#BurgerlijkestaattypeShape> a shacl:NodeShape;
  rdfs:label "BurgerlijkeStaatType";
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Aard vd burgerlijke staat ve persoon."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:targetClass schemas:ContactPoint .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#DomicilieShape> a shacl:NodeShape;
  rdfs:label "Domicilie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Plaats waar de persoon het grootste deel vd tijd verblijft binnen de jurisdictie waarvan hij Inwoner is. Dit wordt doorgaans officieel vastgesteld en geregistreerd ih bevolkingsregister. Kan in praktijk verschillend vd feitelijke verblijfplaats."@nl;
  rdfs:comment "Hoofdverblijfplaats ve persoon."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Domicilie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#GeboorteShape> a shacl:NodeShape;
  rdfs:label "Geboorte"@nl;
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Het ter wereld komen vd persoon."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Geboorte> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#GeenInwonerShape> a shacl:NodeShape;
  rdfs:label "Geen Inwoner"@nl;
  <http://purl.org/vocab/vann/usageNote> "Plaats of land wordt hier vertegenwoordigd door de entiteit jurisdictie."@nl;
  rdfs:comment "Persoon die niet in een bepaalde plaats of land woont."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#GeenInwoner> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#GeregistreerdPersoonShape> a shacl:NodeShape;
  rdfs:label "Geregistreerd Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb naam en voornaam) en de Verblijfplaats vd persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."@nl;
  rdfs:comment "Persoon waarvan de gegevens zijn ingeschreven in een register."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Identificatiecode vd persoon ih register."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#GeregistreerdPersoon.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificatiecode vd persoon ih register."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#registratie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#GeslachtShape> a shacl:NodeShape;
  rdfs:label "Geslacht";
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Het feit of men een man of een vrouw is."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#GezinShape> a shacl:NodeShape;
  rdfs:label "Gezin"@nl;
  <http://purl.org/vocab/vann/usageNote> "Ruimer begrip dan familie waar het gezin louter bestaat uit nabije bloedverwanten, bv een eenpersoonsgezin of living apart together. Gezinsleden hebben doorgaans dezelfde verblijfplaats."@nl;
  rdfs:comment "Samenwerkingsvorm die een herkenbare sociale eenheid vormt (bv tgv huwelijk), met al dan niet verwante personen die duurzame banden hebben en elkaar onderling steun en verzorging verlenen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gezinsadres"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dikwijls een criterium om te bepalen of personen deel uitmaken van eenzelfde gezin."@nl;
    rdfs:comment "Verblijfplaats vh gezin."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Gezin.Gezinsadres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Verblijfplaats vh gezin."@nl;
    shacl:maxCount "1";
    shacl:name "gezinsadres"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#gezinsadres>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gezinshoofd"@nl;
    rdfs:comment "TODO"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Gezin.Gezinshoofd>;
    shacl:class <http://www.w3.org/ns/person#Person>;
    shacl:description "TODO"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gezinshoofd"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#gezinshoofd>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gezinslid"@nl;
    rdfs:comment "TODO"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Gezin.Gezinslid>;
    shacl:class <http://www.w3.org/ns/person#Person>;
    shacl:description "TODO"@nl;
    shacl:minCount "1";
    shacl:name "gezinslid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#gezinslid>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Gezin> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#GezinsrelatieShape> a shacl:NodeShape;
  rdfs:label "Gezinsrelatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv echtgenoot, zoon, schoonmoeder."@nl;
  rdfs:comment "Relatie tussen leden van eenzelfde gezin."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gezinsrelatietype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Wordt typisch bepaald tov het gezinshoofd. Bv als de vader gezinshoofd is en een gezinslid is zoon, dan zou als de grootvader gezinshoofd was datzelfde gezinslid kleinzoon zijn."@nl;
    rdfs:comment "Aard vd relatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#Gezinsrelatie.Gezinsrelatietype>;
    shacl:class skos:Concept;
    shacl:description "Aard vd relatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gezinsrelatietype"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#gezinsrelatietype>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Gezinsrelatie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#GezinsrelatietypeShape> a shacl:NodeShape;
  rdfs:label "Gezinsrelatietype";
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Aard vd gezinsrelatie tussen twee personen."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#HuwelijkShape> a shacl:NodeShape;
  rdfs:label "Huwelijk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Kan, net als bv samenwonen, de basis vormen van een gezin."@nl;
  rdfs:comment "Een door burgerlijk of religieus recht geregelde samenlevingsvorm van twee personen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Huwelijk> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#InwonerShape> a shacl:NodeShape;
  rdfs:label "Inwoner"@nl;
  <http://purl.org/vocab/vann/usageNote> "Plaats of land wordt hier vertegenwoordigd door de entiteit jurisdictie."@nl;
  rdfs:comment "Persoon die in een bepaalde plaats of land woont."@nl;
  shacl:closed false;
