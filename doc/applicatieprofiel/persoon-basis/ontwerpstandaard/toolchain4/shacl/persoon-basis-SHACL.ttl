<https://data.dev-vlaanderen.be/doc/applicatieprofiel/persoon-basis/ontwerpstandaard/toolchain4#PlaatsShape> a shacl:NodeShape;
  rdfs:label "Plaats"@nl;
  rdfs:comment "Een ruimtelijk gebied of benoemde plaats."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "plaatsnaam"@nl;
