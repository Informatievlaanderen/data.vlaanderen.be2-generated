  {
    "@id": "_:df_8_50",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Een rechtspersoon is een juridische constructie die een organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc). Vb privaatrechterlijke rechtspersonen: vennootschappen, vzw's etc.; vb publiekrechterlijke rechtspersonen: steden, gemeenten etc. Een feitelijke vereniging is in principe geen rechtspersoon maar wordt als ze geregistreerd is id KBO toch als dusdanig geklasseerd."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Geeft aan of de rechtspersoonlijkheid van de geregistreerde organisatie deze is van een natuurlijk persoon of van een rechtspersoon."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "rechtspersoonlijkheid"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Rechtspersoonlijkheid"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "Geeft aan of de rechtspersoonlijkheid van de geregistreerde organisatie deze is van een natuurlijk persoon of van een rechtspersoon."
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@value": "1"
      }
    ],
