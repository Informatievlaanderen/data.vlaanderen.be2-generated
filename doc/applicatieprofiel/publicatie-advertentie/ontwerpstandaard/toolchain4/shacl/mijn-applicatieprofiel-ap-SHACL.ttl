<https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatieShape> a shacl:NodeShape;
  rdfs:label "Geregistreerde Organisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "In België moeten oa volgende organisaties zich registreren: vennootschap (nv,bvba etc),eenmanszaak,overheidsorgaan,stichting… Bij registratie krijgt de organisatie een ondernemingsnummer en worden zijn gegevens ingevoerd in de KBO."@nl;
  rdfs:comment "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een formele organisatie waarbij dit statuut ook op een andere manier verkregen kan zijn."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "wettelijke naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Evt in verschillende talen."@nl;
    rdfs:comment "Wettelijk geregistreerde naam vd organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.WettelijkeNaam>;
    shacl:datatype rdf:langString;
    shacl:description "Wettelijk geregistreerde naam vd organisatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "wettelijke naam"@nl;
    shacl:path <http://www.w3.org/ns/regorg#legalName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtspersoonlijkheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een rechtspersoon is een juridische constructie die een organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc). Vb privaatrechterlijke rechtspersonen: vennootschappen, vzw's etc.; vb publiekrechterlijke rechtspersonen: steden, gemeenten etc. Een feitelijke vereniging is in principe geen rechtspersoon maar wordt als ze geregistreerd is id KBO toch als dusdanig geklasseerd."@nl;
    rdfs:comment "Geeft aan of de rechtspersoonlijkheid van de geregistreerde organisatie deze is van een natuurlijk persoon of van een rechtspersoon."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Rechtspersoonlijkheid>;
    shacl:class skos:Concept;
    shacl:description "Geeft aan of de rechtspersoonlijkheid van de geregistreerde organisatie deze is van een natuurlijk persoon of van een rechtspersoon."@nl;
    shacl:maxCount "1";
    shacl:name "rechtspersoonlijkheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#rechtspersoonlijkheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtstoestand"@nl;
    <http://purl.org/vocab/vann/usageNote> "Stemt in de KBO overeen met rechtstoestand, bvb normale toestand, gerechtelijk akkoord, opening faillissement etc."@nl;
    rdfs:comment "Status van de geregistreerde organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Rechtstoestand>;
    shacl:class skos:Concept;
    shacl:description "Status van de geregistreerde organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "rechtstoestand"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#rechtstoestand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtsvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Stemt in de KBO overeen met rechtsvorm, bvb NV, VZW, Stad/Gemeente, OCMW etc."@nl;
    rdfs:comment "Juridisch statuut van de geregistreerde organisatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Rechtsvorm>;
    shacl:class skos:Concept;
    shacl:description "Juridisch statuut van de geregistreerde organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "rechtsvorm"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#rechtsvorm>
  ], [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    <http://purl.org/vocab/vann/usageNote> "In de KBO is dit het ondernemingsnummer."@nl;
    rdfs:comment "Identificator dat de organisatie verkreeg bij registratie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator dat de organisatie verkreeg bij registratie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ];
  shacl:targetClass <http://www.w3.org/ns/regorg#RegisteredOrganization> .

