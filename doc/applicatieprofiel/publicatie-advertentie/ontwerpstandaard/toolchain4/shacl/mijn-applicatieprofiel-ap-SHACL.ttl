<https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv als attribuut ve persoon of gebouw... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres,bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#AdvertentieEventShape> a shacl:NodeShape;
  rdfs:label "Advertentie Event"@nl;
  rdfs:comment "Het event om een advertentie stand te brengen en te verspreiden."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/campagne/publicatie#AdvertentieEvent> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#AdvertentieShape> a shacl:NodeShape;
  rdfs:label "Advertentie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv het kopen van een product of deelnemen aan een actie."@nl;
  rdfs:comment "Een promotiemiddel die bedoeld is de lezer ervan te verleiden tot een bepaalde actie."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/campagne/publicatie#Advertentie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#BestandsindelingstypeShape> a shacl:NodeShape;
  rdfs:label "bestandsindelingstype"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv. JPEG, PNG, …"@nl;
  rdfs:comment "De extensie waarin de afbeelding is opgeslagen."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#CampagneComponentShape> a shacl:NodeShape;
  rdfs:label "Campagne Component"@nl;
  rdfs:comment "Een onderdeel van een campagne."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "campagne"@nl;
    rdfs:comment "De campagne waaronder het campagne component valt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#CampagneComponent.Campagne>;
    shacl:class <https://data.vlaanderen.be/ns/campagne/publicatie#Campagne>;
    shacl:description "De campagne waaronder het campagne component valt."@nl;
    shacl:name "campagne"@nl;
    shacl:path <https://data.vlaanderen.be/ns/campagne/publicatie#campagne>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/campagne/publicatie#CampagneComponent> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#CampagneShape> a shacl:NodeShape;
  rdfs:label "Campagne"@nl;
  rdfs:comment "Een afgebakende set activiteiten met welomschreven doelstellingen, tijdpaden en resultatenmetingen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "budget"@nl;
    rdfs:comment "Het budget dat vrijgemaakt is voor een campagne."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Campagne.Budget>;
    shacl:class <http://data.europa.eu/m8g/Cost>;
    shacl:description "Het budget dat vrijgemaakt is voor een campagne."@nl;
    shacl:name "budget"@nl;
    shacl:path <https://data.vlaanderen.be/ns/campagne/publicatie#budget>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv. seizoenscampagne, traditionele campagne, merkzichtbaarheid, …"@nl;
    rdfs:comment "Verwijst naar de soort campagne die gevoerd wordt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Campagne.Type>;
    shacl:class skos:Concept;
    shacl:description "Verwijst naar de soort campagne die gevoerd wordt."@nl;
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "marketing"@nl;
    rdfs:comment "De doelgroep van de campagne."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Campagne.Marketing>;
    shacl:class <https://data.vlaanderen.be/ns/campagne/publicatie#Marketing>;
    shacl:description "De doelgroep van de campagne."@nl;
    shacl:name "marketing"@nl;
    shacl:path <https://data.vlaanderen.be/ns/campagne/publicatie#marketing>
  ], [
    a shacl:PropertyShape;
    rdfs:label "periode"@nl;
    rdfs:comment "De periode waarin de campagne plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Campagne.Periode>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "De periode waarin de campagne plaatsvindt."@nl;
    shacl:minCount "1";
    shacl:name "periode"@nl;
    shacl:path <http://data.europa.eu/m8g/PeriodOfTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gevoerd door"@nl;
    rdfs:comment "De uitvoerder van de campagne."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Campagne.GevoerdDoor>;
    shacl:class dc:Agent;
    shacl:description "De uitvoerder van de campagne."@nl;
    shacl:name "gevoerd door"@nl;
    shacl:path <https://data.vlaanderen.be/ns/campagne/publicatie#gevoerdDoor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bestaat uit"@nl;
    rdfs:comment "De verschillende onderdelen van een campagne."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Campagne.BestaatUit>;
    shacl:class <https://data.vlaanderen.be/ns/campagne/publicatie#CampagneComponent>;
    shacl:description "De verschillende onderdelen van een campagne."@nl;
    shacl:minCount "1";
    shacl:name "bestaat uit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/campagne/publicatie#bestaatUit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "product"@nl;
    rdfs:comment "Het product of producten die verbonden zijn aan de campagne."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Campagne.Product>;
    shacl:class <https://data.vlaanderen.be/ns/campagne/publicatie#Product>;
    shacl:description "Het product of producten die verbonden zijn aan de campagne."@nl;
    shacl:minCount "1";
    shacl:name "product"@nl;
    shacl:path <https://data.vlaanderen.be/ns/campagne/publicatie#product>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/campagne/publicatie#Campagne> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#CampagneTypeShape> a shacl:NodeShape;
  rdfs:label "Campagne type"@nl;
  rdfs:comment "De soort campagne."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen,mailen etc."@nl;
  rdfs:comment "Informatie zoals email,telefoon,adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanschrijfvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb De heer/Mevrouw, Excellentie, Dokter..."@nl;
    rdfs:comment "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Contactinfo.Aanschrijfvorm>;
    shacl:datatype rdf:langString;
    shacl:description "Titel waarmee iemand wordt aangeschreven of aangesproken of waarmee naar iemand wordt verwezen."@nl;
    shacl:maxCount "1";
    shacl:name "aanschrijfvorm"@nl;
    shacl:path vcard:honorific-prefix
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam van bvb de persoon die men kan contacteren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Contactinfo.Contactnaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van bvb de persoon die men kan contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactnaam"@nl;
    shacl:path foaf:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Contactinfo.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schema:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "fax"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Faxnummer waarnaar men kan faxen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Contactinfo.Fax>;
    shacl:datatype xsd:string;
    shacl:description "Faxnummer waarnaar men kan faxen."@nl;
    shacl:maxCount "1";
    shacl:name "fax"@nl;
    shacl:path schema:faxNumber
  ], [
    a shacl:PropertyShape;
    rdfs:label "openingsuren"@nl;
    <http://purl.org/vocab/vann/usageNote> "Syntax volgens schema.org voor openingsuren. Bv als contact kan worden opgenomen tussen 8 en 20u maandag tot zaterdag en tussen 8 en 18u op zondag wordt dit gecodeerd als Ma-za 08:00-20:00, zo 08:00-18:00."@nl;
    rdfs:comment "Uren waarbinnen contact kan worden opgenomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Contactinfo.Openingsuren>;
    shacl:datatype rdfs:Literal;
    shacl:description "Uren waarbinnen contact kan worden opgenomen."@nl;
    shacl:maxCount "1";
    shacl:name "openingsuren"@nl;
    shacl:path schema:openingHours
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/publicatie-advertentie/ontwerpstandaard/toolchain4#Contactinfo.Telefoon>;
    shacl:datatype xsd:string;
    shacl:description "Telefoonnummer waarop men kan bellen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schema:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "website"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Website waarnaar men kan surfen."@nl;
