    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Te gebruiken ipv Concept als een voorgedefinieerde eenheid van QUDT beschikbaar is, bvb <a href=\"http://qudt.org/vocab/currency/EUR\">Euro</a>. Zie <a href=\"https://www.qudt.org/doc/DOC_VOCAB-UNITS-CURRENCY.html\">QUDT-currency-units</a> voor meer info."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
