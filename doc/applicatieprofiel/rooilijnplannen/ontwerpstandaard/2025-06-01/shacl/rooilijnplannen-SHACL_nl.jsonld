  {
    "@id": "https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#OpenbarewegShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Impliceert in principe een onbelemmerd, vrij gebruik voor alle verkeersdeelnemers op alle denkbare momenten. Staat los van openbaar of privaat eigendom, een weg kan op een privaat eigendom liggen maar toch openbaar zijn, bvb trage wegen (nu gemeentewegen, zie <a href=\"https://codex.vlaanderen.be/PrintDocument.ashx?id=1032035&datum=&geannoteerd=true&print=false\">Decreet gemeentewegen</a>). OPGELET: Subklasse van Rooilijnkenmerk waardoor deze klasse dus niet de OpenbareWeg voorstelt als een apart object maar als een kenmerk (van een Rooilijn)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Weg die vrij voor iedereen toegankelijk is."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "OpenbareWeg"
      }
    ],
