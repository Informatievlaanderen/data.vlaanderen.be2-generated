  {
    "@id": "https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#AangelandeeigendommenShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Eigendommen kunnen juridisch zowel privaat als publiek zijn. Onder eigendommen worden in praktijk KadastralePatrimoniumPercelen verstaan. Het doorkruisen van AangelandeEigendommen door een OpenbareWeg doet zich voor wanneer de ondergrond privaat eigendom is en de openbare weg op het privaat perceel wordt aangelegd. OPGELET: Subklasse van Rooilijnkenmerk en dus stelt deze klasse niet de AangelandeEigendommen als object maar als kenmerk (van een Rooilijn) voor."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Eigendommen die grenzen aan of doorkruist worden door de OpenbareWeg."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "AangelandeEigendommen"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_35"
      },
      {
        "@id": "_:df_8_45"
      },
      {
        "@id": "_:df_8_67"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/rooilijn#AangelandeEigendommen"
      }
    ]
  },
  {
    "@id": "https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#AgentShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
