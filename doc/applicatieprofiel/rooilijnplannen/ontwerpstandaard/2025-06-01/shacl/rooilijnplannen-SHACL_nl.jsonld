  {
    "@id": "_:df_8_52",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Bvb is het kenmerk geldig voor de ene richting of voor de andere of in beide richtingen. Om de ene richting te onderscheiden van de andere staat \"gelijklopend\" voor de richting die gelijkloopt met de digitalisatierichting van de Lijn en \"tegengesteld\" voor de richting die tegengesteld is aan de digitalisatierichting. In het geval de referentie niet slaat op de richting van de Lijn, maar op een fenomeen langs de Lijn, komt \"gelijklopend\" overeen met de rechterkant en \"tegengesteld\" met de linkerkant."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Richting van de Lijn waarop de referentie van toepassing is."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
