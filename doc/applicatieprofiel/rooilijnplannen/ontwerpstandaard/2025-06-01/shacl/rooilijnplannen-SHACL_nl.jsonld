      }
    ]
  },
  {
    "@id": "https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#RuimtelijkuitvoeringsplanShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Onder bestemming wordt verstaan voor welke functies de ruimte mag worden gebruikt bvb wonen, kantoren, verkeer, groen etc. Dat wordt dmv een grafisch plan weergegeven. Daarnaast bevat een RuimtelijkUitvoeringsplan de stedenbouwkundige voorschriften over inrichting en/of het beheer die van toepassing zijn, bvb hoe hoog er gebouwd mag worden, hoever van de straat etc. In deze context gaat het over RuimtelijkeUitvoeringsplannen waarin Rooilijnen worden vastgelegd."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Plan waarin de overheid stedenbouwkundige voorschriften over de bestemming, inrichting en/of beheer van de ruimte vastlegt."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "RuimtelijkUitvoeringsplan"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_9"
      },
