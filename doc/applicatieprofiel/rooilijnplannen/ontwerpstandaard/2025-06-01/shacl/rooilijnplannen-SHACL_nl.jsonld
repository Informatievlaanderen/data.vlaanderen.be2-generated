  },
  {
    "@id": "https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#BesluitShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "De beslissingen waarvan sprake zijn rechtshandelingen met beoogd rechtsgevolg. Hetzij individueel (bvb toekennen van een subsidie) of voor een groep (bvb een verkeersregel). In deze context gaat het om Besluiten waarin Rooilijnen worden vastgelegd. Voor meer info over de klasse Besluit, zie het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/\">applicatieprofiel OSLO-Besluit</a>."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De authentieke schriftelijke neerslag van een beslissing van een bestuursorgaan. Deze beslissing houdt een rechtshandeling in waarbij sprake is van een beoogd rechtsgevolg."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Besluit"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_13"
      },
      {
        "@id": "_:df_8_14"
      },
      {
        "@id": "_:df_8_60"
      },
      {
        "@id": "_:df_8_73"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://data.vlaanderen.be/ns/besluit#Besluit"
      }
    ]
  },
  {
