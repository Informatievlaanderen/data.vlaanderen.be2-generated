    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Het gaat over activiteiten die oa hinderlijk zijn voor mens en milieu of met ruimtelijke implicaties en daarom door de overheid vergund moeten worden, bvb het oprichten van een bouwwerk, het uitvoeren van een bedrijfsactiviteit, het verkavelen van een grond etc. In deze context gaat het over Omgevingsvergunningen waarbij Rooilijnen worden vastgelegd. Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/\">OSLO-Omgevingsvergunningen</a>."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Officiële toestemming om een bepaalde activiteit te verrichten in de fysieke leefomgeving."
      }
    ],
