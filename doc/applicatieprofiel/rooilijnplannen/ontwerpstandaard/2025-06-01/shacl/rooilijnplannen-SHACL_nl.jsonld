    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Wordt bvb gebruikt om naar een Bouwlijn te verwijzen die de AangelandeEigendommen van een Rooilijn doorkruist."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
