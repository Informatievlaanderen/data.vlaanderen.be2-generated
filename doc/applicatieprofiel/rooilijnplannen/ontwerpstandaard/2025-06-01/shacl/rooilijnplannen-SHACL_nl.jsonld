  {
    "@id": "https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#BouwlijnShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "In de context van Rooilijnplannen is het de lijn die in de AangelandeEigendommen van een Rooilijn ligt en gerekend vanaf deze Rooilijn de strook afbakent waarbinnen niet mag gebouwd worden (ook Achteruitbouwstrook genoemd). Een Bouwlijn heeft in principe een Geometrie maar kan ook de vorm van een voorschrift aannemen, bijvoorbeeld geen bebouwing toegelaten op minder dan 8m van de Rooilijn."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Lijn die de grens aangeeft tussen de zone waar niet en waar wel mag gebouwd worden."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Bouwlijn"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_24"
      },
      {
        "@id": "_:df_8_25"
      },
      {
        "@id": "_:df_8_40"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/rooilijn#Bouwlijn"
      }
    ]
  },
