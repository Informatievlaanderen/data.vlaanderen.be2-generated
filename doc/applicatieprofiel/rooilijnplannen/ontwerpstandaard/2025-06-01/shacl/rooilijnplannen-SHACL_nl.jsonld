  {
    "@id": "https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#RuimtelijkeEenheidShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Definitie conform ISO 19152 - Land Administration Domain Model. Meer info over deze klasse in het AP <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/perceel/\">OSLO-Perceel</a>."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Eén gebied (of meerdere gebieden) van land en/of water, of één enkel volume (of meerdere volumes) ruimte,afgebakend voor een bepaald doel."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Ruimtelijke Eenheid"
      }
    ],
