      }
    ]
  },
  {
    "@id": "https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#VergunningShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
