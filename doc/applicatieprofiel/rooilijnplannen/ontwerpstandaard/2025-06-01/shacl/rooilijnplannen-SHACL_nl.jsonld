      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "In deze context gaat het om kenmerken die zich links of rechts van een Rooilijn bevinden en meer specifiek OpenbareWeg en AangelandeEigendommen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Lijnkenmerk geassocieerd met een Rooilijn."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Rooilijnkenmerk"
      }
    ],
