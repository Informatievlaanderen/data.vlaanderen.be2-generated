    shacl:class foaf:Document;
    shacl:description "Verwijzing naar het originele plan op papier."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "document"@nl;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Identificator van het Plan."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Plan.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het Plan."@nl;
    shacl:name "identificator"@nl;
