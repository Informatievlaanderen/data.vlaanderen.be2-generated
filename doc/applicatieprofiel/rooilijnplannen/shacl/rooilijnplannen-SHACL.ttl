    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Zakelijkrecht.Kadastraalpatrimoniumperceel>;
    shacl:class <https://data.vlaanderen.be/ns/perceel#KadastraalPatrimoniumperceel>;
