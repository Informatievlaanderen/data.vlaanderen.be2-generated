  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#LijnShape> a shacl:NodeShape;
  rdfs:label "Lijn"@nl;
  <http://purl.org/vocab/vann/usageNote> "Equivalent met de geometrische primitieve Curve. In deze context gebruikt als abstracte superklasse om lijnen zoals Rooilijnen,Bouwlijnen edm te groeperen"@nl;
  rdfs:comment "Een 1-dimensionele geometrische primitieve."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#Curve> .

<https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#LijnkenmerkShape> a shacl:NodeShape;
  rdfs:label "Lijnkenmerk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb om het deel ve Lijn aan te geven dat wordt opgeheven of dat ondergronds ipv bovengronds ligt etc."@nl;
  rdfs:comment "Kenmerk dat aan een Lijn is verbonden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard vh kenmerk dat met de Lijn is geassocieerd.."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Lijnkenmerk.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard vh kenmerk dat met de Lijn is geassocieerd.."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "lineaireReferentie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Overbodig voor Rooilijnkenmerken en Bouwlijnkenmerken aangezien in principe het Rooilijnkenmerk (OpenbareWeg en AangelandeEigendommen) zich voordoet over de gehele lengte en enkel voor een specifieke kant (links of rechts) die al bij de Rooilijn resp Bouwlijn opgegeven is."@nl;
    rdfs:comment "Verwijzing naar de Lijn en aanduiding van het deel en de kant van de Lijn waar het kenmerk zich voordoet."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Lijnkenmerk.Lineairereferentie>;
    shacl:class <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie>;
    shacl:description "Verwijzing naar de Lijn en aanduiding van het deel en de kant van de Lijn waar het kenmerk zich voordoet."@nl;
    shacl:maxCount "1";
    shacl:name "lineaireReferentie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/rooilijn#lineaireReferentie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/rooilijn#Lijnkenmerk> .

<https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#LijnstringShape> a shacl:NodeShape;
  rdfs:label "Lijnstring"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een curve is een 1-dimensioneel geometrisch object gedefinieerd als een sequentie van punten. De interpolatie kan op verschillende manieren gebeuren (bv lineair bij een lijnstring)."@nl;
  rdfs:comment "Curve met lineaire interpolatie tussen de punten. Elk opeenvolgend paar punten vormt een lijnsegment. De lijnstring heeft ten minste twee punten."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#LineString> .

<https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#LineairereferentieShape> a shacl:NodeShape;
  rdfs:label "LineaireReferentie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Meer specifiek het deel twee opeenvolgende posities op de Lijn. Bvb op een Lijn van 500 meter het deel tussen de 100 en 400 meter."@nl;
  rdfs:comment "Linkreferentie die verwijst naar een deel van het lineair netwerkelement."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lijnreferentie"@nl;
    rdfs:comment "Referentie naar de Lijn."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Lineairereferentie.Lijnreferentie>;
    shacl:class <http://www.opengis.net/ont/sf#Curve>;
    shacl:description "Referentie naar de Lijn."@nl;
    shacl:maxCount "1";
    shacl:name "lijnreferentie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#Netwerkreferentie.element>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toepassingsrichting"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb is het kenmerk geldig voor de ene richting of voor de andere of in beide richtingen. Om de ene richting te onderscheiden van de andere staat \"gelijklopend\" voor de richting die gelijkloopt met de digitalisatierichting van de Lijn en \"tegengesteld\" voor de richting die tegengesteld is aan de digitalisatierichting. In het geval de referentie niet slaat op de richting van de Lijn, maar op een fenomeen langs de Lijn, komt \"gelijklopend\" overeen met de rechterkant en \"tegengesteld\" met de linkerkant."@nl;
    rdfs:comment "Richting van de Lijn waarop de referentie van toepassing is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Lineairereferentie.Toepassingsrichting>;
    shacl:class skos:Concept;
    shacl:description "Richting van de Lijn waarop de referentie van toepassing is."@nl;
    shacl:maxCount "1";
    shacl:name "toepassingsrichting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#toepassingsrichting>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vanPositie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uitgedrukt in afstand tov het begin van het netwerkelement. Bvb 100meter gerekend vanaf het begin van het netwerkelement. Moet kleiner zijn dan de totPositie en kleiner dan de totale lengte van de Lijn."@nl;
    rdfs:comment "Start van het deel van de Lijn."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Lineairereferentie.Vanpositie>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Start van het deel van de Lijn."@nl;
    shacl:maxCount "1";
    shacl:name "vanPositie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie.vanPositie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "totPositie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uitgedrukt in afstand tov het begin van het netwerkelement. Bvb 400meter gerekend vanaf het begin van het netwerkelement. Moet groter zijn dan de vanPositie en kleiner dan de totale lengte van de Lijn."@nl;
    rdfs:comment "Einde van het deel van de Lijn."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Lineairereferentie.Totpositie>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Einde van het deel van de Lijn."@nl;
    shacl:maxCount "1";
    shacl:name "totPositie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie.totPositie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie> .

<https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#MomentShape> a shacl:NodeShape;
  rdfs:label "Moment"@nl;
  rdfs:comment "TemporeleEntiteit met omvang en duur nul."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "inXSDDatumTijd"@nl;
    rdfs:comment "Positie ve Moment, uitgedrukt dmv xsd:dateTime."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Moment.Inxsddatumtijd>;
    shacl:datatype xsd:dateTime;
    shacl:description "Positie ve Moment, uitgedrukt dmv xsd:dateTime."@nl;
    shacl:maxCount "1";
    shacl:name "inXSDDatumTijd"@nl;
    shacl:path <http://www.w3.org/2006/time#inXSDDateTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "inEDTF"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik <a href=\"http://id.loc.gov/datatypes/edtf/EDTF\">http://id.loc.gov/datatypes/edtf/EDTF</a> als datatype van de Literal en een String in EDTF-formaat als waarde. EDTF is en uitgebreide set van notaties voor het vastleggen van datums, tijden en tijdsintervallen, inclusief onzekere of benaderde datums, herhalende datums en open tijdsintervallen. Voorbeelden: 1980/1984 (periode 1980-1984), 1984? (jaar onzeker), 1984~ (jaar bij benadering), 19XX (20ste eeuw), /1980 (periode met onbekend begin), 1984 (ergens in 1984). Zie <a href=\"https://www.loc.gov/standards/datetime/\">EDTF</a> voor meer info."@nl;
    rdfs:comment "Positie van een Moment, uitgedrukt in EDTF."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Moment.Inedtf>;
    shacl:description "Positie van een Moment, uitgedrukt in EDTF."@nl;
    shacl:maxCount "1";
    shacl:name "inEDTF"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <https://periodo.github.io/edtf-ontology/edtfo.ttl#hasEDTFDateTimeDescription>
  ];
  shacl:targetClass <http://www.w3.org/2006/time#Instant> .

