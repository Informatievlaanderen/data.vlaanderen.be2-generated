<https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#RuimtelijkuitvoeringsplanShape> a shacl:NodeShape;
  rdfs:label "RuimtelijkUitvoeringsplan"@nl;
  <http://purl.org/vocab/vann/usageNote> "Onder bestemming wordt verstaan voor welke functies de ruimte mag worden gebruikt bvb wonen, kantoren, verkeer, groen etc. Dat wordt dmv een grafisch plan weergegeven. Daarnaast bevat een RuimtelijkUitvoeringsplan de stedenbouwkundige voorschriften over inrichting en/of het beheer die van toepassing zijn, bvb hoe hoog er gebouwd mag worden, hoever van de straat etc. In deze context gaat het over RuimtelijkeUitvoeringsplannen waarin Rooilijnen worden vastgelegd."@nl;
  rdfs:comment "Plan waarin de overheid stedenbouwkundige voorschriften over de bestemming, inrichting en/of beheer van de ruimte vastlegt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "Titel van de Omgevingsvergunning."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Ruimtelijkuitvoeringsplan.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "Titel van de Omgevingsvergunning."@nl;
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Identificator van het RuimtelijkUitvoeringsplan."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Ruimtelijkuitvoeringsplan.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het RuimtelijkUitvoeringsplan."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "Verwijzing naar de Status van het RuimtelijkUitvoeringspan."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Ruimtelijkuitvoeringsplan.Status>;
    shacl:class <https://data.vlaanderen.be/ns/rooilijn#Status>;
    shacl:description "Verwijzing naar de Status van het RuimtelijkUitvoeringspan."@nl;
    shacl:name "status"@nl;
    shacl:path <http://purl.org/vocab/lifecycle/schema#state>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/rooilijn#RuimtelijkUitvoeringsplan> .

