  ], [
    a shacl:PropertyShape;
    rdfs:label "planstatus"@nl;
    rdfs:comment "Verwijzing naar de Status van het Plan."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#Plan.Planstatus>;
    shacl:class <https://data.vlaanderen.be/ns/rooilijn#Status>;
