  rdfs:comment "Lineair ruimtelijk object dat de geometrie en connectiviteit beschrijft tussen twee punten in een Wegennetwerk."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#Wegsegment> .

<https://data.vlaanderen.be/doc/applicatieprofiel/rooilijnplannen/ontwerpstandaard/2025-06-01#ZakelijkrechtShape> a shacl:NodeShape;
  rdfs:label "ZakelijkRecht"@nl;
