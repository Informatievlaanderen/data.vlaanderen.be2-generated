  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ruimtelijke-indicatoren/ontwerpstandaard/toolchain4#TellingShape> a shacl:NodeShape;
  rdfs:label "Telling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Doorgaans bij een Observatie waar het belang van een fenomeen te bepalen door te tellen hoe vaak het voorkomt. Bv het observeren vd opkomst bij een verkiezing,het tellen van bio-indicatoren in een watermonster. Datatype vh resultaat is een Integer."@nl;
  rdfs:comment "Observatie waarbij het resultaat een aantal is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "resultaat"@nl;
    rdfs:comment "Resultaat van de Telling."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ruimtelijke-indicatoren/ontwerpstandaard/toolchain4#Telling.Resultaat>;
    shacl:datatype xsd:integer;
    shacl:description "Resultaat van de Telling."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "resultaat"@nl;
    shacl:path <http://def.isotc211.org/iso19156/2011/CountObservation#OM_CountObservation.result>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/CountObservation#OM_CountObservation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ruimtelijke-indicatoren/ontwerpstandaard/toolchain4#TemporeleentiteitShape> a shacl:NodeShape;
  rdfs:label "TemporeleEntiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Die temporele objecten zijn temporele geometrische primitieven zoals Moment of Periode. Of het zijn composieten van temporele primitieven, bv om de geschiedenis van een fenomeen weer te geven (bv de opeenvolgende Periodes dat het fenomeen zich voordeed). Te gebruiken wanneer bvb beide temporele geometrische primitieven mogelijk zijn. OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bv time:TemporalEntity uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."@nl;
  rdfs:comment "Abstracte klasse voor temporele objecten."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Object> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ruimtelijke-indicatoren/ontwerpstandaard/toolchain4#ToetsingtypeShape> a shacl:NodeShape;
  rdfs:label "ToetsingType"@nl;
  rdfs:comment "Aard van de toetsing van twee resultaten ten opzichte van elkaar."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/ruimtelijke-indicatoren/#ToetsingType> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ruimtelijke-indicatoren/ontwerpstandaard/toolchain4#UriShape> a shacl:NodeShape;
  rdfs:label "URI";
  shacl:closed false;
  shacl:targetClass xsd:anyURI .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/ruimtelijke-indicatoren/ontwerpstandaard/toolchain4#WaarheidsobservatieShape> a shacl:NodeShape;
  rdfs:label "WaarheidsObservatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Normaal gezien bij Observaties waar gekeken wordt of een bepaald fenomeen zich al dan niet voordoet. Bv het voorkomen van een bedreigde diersoort,de aanwezigheid van een defect. Datatype vh resultaat is een Boolean."@nl;
  rdfs:comment "Observatie waarbij het resultaat booleaans is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "resultaat"@nl;
    rdfs:comment "Resultaat van de Waarheidsobservatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ruimtelijke-indicatoren/ontwerpstandaard/toolchain4#Waarheidsobservatie.Resultaat>;
    shacl:datatype xsd:boolean;
    shacl:description "Resultaat van de Waarheidsobservatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "resultaat"@nl;
    shacl:path <http://def.isotc211.org/iso19156/2011/TruthObservation#OM_TruthObservation.result>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/TruthObservation#OM_TruthObservation> .
