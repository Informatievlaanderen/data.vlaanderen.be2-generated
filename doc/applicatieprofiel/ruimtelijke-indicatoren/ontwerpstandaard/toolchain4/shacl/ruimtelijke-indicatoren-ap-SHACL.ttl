    shacl:name "type"@nl;
    shacl:path <https://data.vlaanderen.be/ns/ruimtelijke-indicatoren/#RuimtelijkObject.type>
  ], [
    a shacl:PropertyShape;
    rdfs:label "waardeverschaffer"@nl;
    rdfs:comment "Observaties die op het Object gebeuren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/ruimtelijke-indicatoren/ontwerpstandaard/toolchain4#Ruimtelijkobject.Waardeverschaffer>;
