    shacl:path <https://data.vlaanderen.be/ns/ruimtelijke-indicatoren/#toetsingType>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/ruimtelijke-indicatoren/#RuimtelijkeIndicator> .

