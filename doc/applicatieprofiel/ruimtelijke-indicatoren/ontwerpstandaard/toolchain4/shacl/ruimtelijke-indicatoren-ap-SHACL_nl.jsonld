    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Bv Observaties die op hetzelfde tijdstip plaatsvonden of hetzelfde Object observeren of door dezelfde sensor zijn gemaakt."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Collectie van Observaties met dezelfde kenmerken."
      }
    ],
