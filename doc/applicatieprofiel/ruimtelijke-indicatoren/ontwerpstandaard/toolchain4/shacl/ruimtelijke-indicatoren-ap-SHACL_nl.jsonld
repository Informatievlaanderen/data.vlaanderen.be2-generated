      {
        "@id": "_:df_8_41"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://def.isotc211.org/iso19156/2011/CategoryObservation#OM_CategoryObservation"
      }
    ]
  },
