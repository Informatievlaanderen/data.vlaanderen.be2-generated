<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/erkendestandaard/2025-05-15#AanmaningShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/erkendestandaard/2025-05-15#Aanmaning.Aanmaningsdatum>;
    shacl:datatype xsd:date;
    shacl:description "Datum waarop de aanmaning werd verstuurd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aanmaningsdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#aanmaningsdatum>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/erkendestandaard/2025-05-15#Aanmaning.GenereertWanbetalingsvergoeding>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Wanbetalingsvergoeding>;
    shacl:description "Verwijzing naar een wanbetalingsvergoeding die door de aanmaning wordt gegenereerd. Een wanbetalingsvergoeding wordt gegenereerd door een aanmaning maar heeft zijn grondslag in een algemene voorwaarde of een reglement"@nl;
    shacl:name "genereert wanbetalingsvergoeding"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#genereertWanbetalingsvergoeding>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/schuldbeheer#Aanmaning> .

