    shacl:minCount "1";
    shacl:name "saldobedrag"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#saldobedrag>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/schuldbeheer#Saldo> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#SchrappingShape> a shacl:NodeShape;
  rdfs:label "Schrapping"@nl;
  rdfs:comment "Het formeel beëindigen of annuleren van een overeengekomen betalingsregeling, bijvoorbeeld omdat de schuldenaar zijn betaalverplichtingen niet naleeft."@nl;
