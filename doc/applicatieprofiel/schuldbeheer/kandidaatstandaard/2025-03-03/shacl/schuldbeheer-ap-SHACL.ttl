    shacl:class <https://data.vlaanderen.be/ns/persoon#Gezin>;
    shacl:description "Persoon die tot een gezin behoort."@nl;
    shacl:name "is lid van"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#isLidVan>
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#PersoonsrelatieShape> a shacl:NodeShape;
