    shacl:description "Persoon die tot een gezin behoort."@nl;
    shacl:minCount 1;
    shacl:name "gezinslid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#gezinslid>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Gezin> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
