    rdfs:label "juridisch statuut"@nl;
    rdfs:comment "Verwijzing naar een juridisch statuut van een persoon."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#GeregistreerdPersoon.JuridischStatuut>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#JuridischStatuut>;
    shacl:description "Verwijzing naar een juridisch statuut van een persoon."@nl;
    shacl:name "juridisch statuut"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#juridischStatuut>
  ], [
    a shacl:PropertyShape;
    rdfs:label "inkomst"@nl;
    rdfs:comment "Verwijzing naar een inkomst van een persoon."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#GeregistreerdPersoon.Inkomst>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Inkomst>;
    shacl:description "Verwijzing naar een inkomst van een persoon."@nl;
    shacl:name "inkomst"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#inkomst>
  ], [
    a shacl:PropertyShape;
    rdfs:label "krediet"@nl;
    rdfs:comment "Verwijzing naar een krediet dat door een persoon werd aangegaan als schuldenaar."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#GeregistreerdPersoon.Krediet>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Krediet>;
