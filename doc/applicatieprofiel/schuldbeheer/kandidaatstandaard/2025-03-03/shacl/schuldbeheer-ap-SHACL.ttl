<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#SchuldvorderingShape> a shacl:NodeShape;
  rdfs:label "Schuldvordering"@nl;
  <http://purl.org/vocab/vann/usageNote> "Voor de doeleinden van dit applicatieprofiel is de opgelegde prestatie altijd de betaling van een geldsom."@nl;
  rdfs:comment "Aanspraak van een partij (de schuldeiser) op een bepaalde prestatie vanwege een andere partij (de schuldenaar)."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "verjaringsdatum"@nl;
    rdfs:comment "De datum waarna de schuldeiser zijn recht om juridische stappen te ondernemen verliest en de vordering niet langer inbaar is. Wordt berekend op basis van de verjaringstermijn, vanaf de startdatum van de vordering of de datum van de stuitende activiteit, bijvoorbeeld een betaling."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Schuldvordering.Verjaringsdatum>;
    shacl:datatype xsd:date;
    shacl:description "De datum waarna de schuldeiser zijn recht om juridische stappen te ondernemen verliest en de vordering niet langer inbaar is. Wordt berekend op basis van de verjaringstermijn, vanaf de startdatum van de vordering of de datum van de stuitende activiteit, bijvoorbeeld een betaling."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "verjaringsdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#verjaringsdatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wanbetaling"@nl;
    rdfs:comment "Laat toe om aan te duiden of de hoofdsom voor de uiterste betaaldatum werd betaald."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Schuldvordering.Wanbetaling>;
    shacl:datatype xsd:boolean;
    shacl:description "Laat toe om aan te duiden of de hoofdsom voor de uiterste betaaldatum werd betaald."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "wanbetaling"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#Schuldvordering.wanbetaling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uiterste betaaldatum"@nl;
    rdfs:comment "De laatst mogelijke datum waarop een betaling moet worden gedaan om te voorkomen dat er eventuele boetes, interesten of andere sancties worden opgelegd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Schuldvordering.UitersteBetaaldatum>;
    shacl:datatype xsd:date;
    shacl:description "De laatst mogelijke datum waarop een betaling moet worden gedaan om te voorkomen dat er eventuele boetes, interesten of andere sancties worden opgelegd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "uiterste betaaldatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#Schuldvordering.uitersteBetaaldatum>
