    shacl:name "gezinshoofd"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#gezinshoofd>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gezinslid"@nl;
    rdfs:comment "Persoon die tot een gezin behoort."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Gezin.Gezinslid>;
