<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#GeregistreerdPersoonShape> a shacl:NodeShape;
  rdfs:label "Geregistreerd Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb naam en voornaam) en de Verblijfplaats vd persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."@nl;
  rdfs:comment "Persoon waarvan de gegevens zijn ingeschreven in een register."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    rdfs:comment "Identificatiecode vd persoon ih register."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#GeregistreerdPersoon.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificatiecode vd persoon ih register."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "solvabiliteitsprofiel"@nl;
    rdfs:comment "Verwijzing naar een solvabiliteitsrofiel van een persoon."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#GeregistreerdPersoon.Solvabiliteitsprofiel>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Solvabiliteitsprofiel>;
    shacl:description "Verwijzing naar een solvabiliteitsrofiel van een persoon."@nl;
    shacl:name "solvabiliteitsprofiel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#solvabiliteitsprofiel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "sociaal statuut"@nl;
    rdfs:comment "Verwijzing naar een sociaal statuut van een persoon."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#GeregistreerdPersoon.SociaalStatuut>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#SociaalStatuut>;
    shacl:description "Verwijzing naar een sociaal statuut van een persoon."@nl;
    shacl:name "sociaal statuut"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#sociaalStatuut>
  ], [
