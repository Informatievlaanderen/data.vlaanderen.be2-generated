<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#AanmaningShape> a shacl:NodeShape;
  rdfs:label "Aanmaning"@nl;
  rdfs:comment "Schriftelijk berichtgeving van een schuldeiser naar een schuldenaar om deze schuldenaar te herinneren aan een schuldvordering die niet is voldaan terwijl de uiterste betaaldatum van deze schuldvordering reeds verstreken is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanmaningsdatum"@nl;
    rdfs:comment "Datum waarop de aanmaning werd verstuurd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Aanmaning.Aanmaningsdatum>;
    shacl:datatype xsd:date;
    shacl:description "Datum waarop de aanmaning werd verstuurd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aanmaningsdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#aanmaningsdatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "genereert wanbetalingsvergoeding"@nl;
    rdfs:comment "Verwijzing naar een wanbetalingsvergoeding die door de aanmaning wordt gegenereerd. Een wanbetalingsvergoeding wordt gegenereerd door een aanmaning maar heeft zijn grondslag in een algemene voorwaarde of een reglement"@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Aanmaning.GenereertWanbetalingsvergoeding>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Wanbetalingsvergoeding>;
    shacl:description "Verwijzing naar een wanbetalingsvergoeding die door de aanmaning wordt gegenereerd. Een wanbetalingsvergoeding wordt gegenereerd door een aanmaning maar heeft zijn grondslag in een algemene voorwaarde of een reglement"@nl;
    shacl:name "genereert wanbetalingsvergoeding"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#genereertWanbetalingsvergoeding>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/schuldbeheer#Aanmaning> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#AanvaardingShape> a shacl:NodeShape;
  rdfs:label "Aanvaarding"@nl;
  rdfs:comment "Het formeel akkoord gaan met een afbetalingsplan"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanvaard afbetalingsplan"@nl;
    rdfs:comment "Verwijzing naar het afbetalingsplan dat wordt aanvaard."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Aanvaarding.AanvaardAfbetalingsplan>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Afbetalingsplan>;
    shacl:description "Verwijzing naar het afbetalingsplan dat wordt aanvaard."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aanvaard afbetalingsplan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#aanvaardAfbetalingsplan>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/schuldbeheer#Aanvaarding> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#ActiviteitShape> a shacl:NodeShape;
  rdfs:label "Activiteit"@nl;
  rdfs:comment "Handeling van bepaalde duur op of met entiteiten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "De einddatum van de activiteit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Activiteit.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De einddatum van de activiteit."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#Activiteit.einddatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "startdatum"@nl;
    rdfs:comment "De startdatum van de activiteit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Activiteit.Startdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De startdatum van de activiteit."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "startdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#Activiteit.startdatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft deelnemer"@nl;
    rdfs:comment "Persoon of organisatie die binnen een bepaalde rol een verantwoordelijkheid opneemt voor deze activiteit."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Activiteit.HeeftDeelnemer>;
    shacl:class prov:Association;
    shacl:description "Persoon of organisatie die binnen een bepaalde rol een verantwoordelijkheid opneemt voor deze activiteit."@nl;
    shacl:name "heeft deelnemer"@nl;
    shacl:path prov:qualifiedAssociation
  ], [
    a shacl:PropertyShape;
    rdfs:label "genereert"@nl;
    rdfs:comment "Een activiteit kan een stuk genereren."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Activiteit.Genereert>;
    shacl:class <https://data.vlaanderen.be/ns/dossier#Stuk>;
    shacl:description "Een activiteit kan een stuk genereren."@nl;
    shacl:name "genereert"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#genereert>
  ], [
    a shacl:PropertyShape;
    rdfs:label "werd gestart door"@nl;
    rdfs:comment "Van een start is sprake wanneer een activiteit geacht wordt te zijn gestart. Een start kan verwijzen naar een entiteit, ook wel een trigger genoemd, die de activiteit heeft geïntitieerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Activiteit.WerdGestartDoor>;
    shacl:class prov:Agent;
    shacl:description "Van een start is sprake wanneer een activiteit geacht wordt te zijn gestart. Een start kan verwijzen naar een entiteit, ook wel een trigger genoemd, die de activiteit heeft geïntitieerd."@nl;
    shacl:maxCount 1;
    shacl:name "werd gestart door"@nl;
    shacl:path prov:wasStartedBy
  ];
  shacl:targetClass prov:Activity .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#AfbetalingShape> a shacl:NodeShape;
  rdfs:label "Afbetaling"@nl;
  rdfs:comment "Betaling in het kader van een afbetalingsplan"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gevolgd afbetalingsplanonderdeel"@nl;
    rdfs:comment "Verwijzing naar het afbetalingsplanonderdeel dat werd gevolgd bij het uitvoeren van de afbetaling."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Afbetaling.GevolgdAfbetalingsplanonderdeel>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Afbetalingsplanonderdeel>;
    shacl:description "Verwijzing naar het afbetalingsplanonderdeel dat werd gevolgd bij het uitvoeren van de afbetaling."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "gevolgd afbetalingsplanonderdeel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#gevolgdAfbetalingsplanonderdeel>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/schuldbeheer#Afbetaling> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#AfbetalingsplanShape> a shacl:NodeShape;
  rdfs:label "Afbetalingsplan"@nl;
  rdfs:comment "Een gestructureerd schema dat wordt gebruikt om een schuld af te lossen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "startbedrag"@nl;
    rdfs:comment "Het totale verschuldigde bedrag dat wordt herschikt bij de aanvang van het afbetalingsplan."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Afbetalingsplan.Startbedrag>;
    shacl:class schemas:MonetaryAmount;
    shacl:description "Het totale verschuldigde bedrag dat wordt herschikt bij de aanvang van het afbetalingsplan."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "startbedrag"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#startBedrag>
  ], [
    a shacl:PropertyShape;
    rdfs:label "herschikte schuldvordering"@nl;
    rdfs:comment "Verwijzijng naar een schuldvordering waarvan de betaalmodaliteiten door het afbetalingsplan herschikt worden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Afbetalingsplan.HerschikteSchuldvordering>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Schuldvordering>;
    shacl:description "Verwijzijng naar een schuldvordering waarvan de betaalmodaliteiten door het afbetalingsplan herschikt worden."@nl;
    shacl:minCount 1;
    shacl:name "herschikte schuldvordering"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#herschikteSchuldvordering>
  ], [
    a shacl:PropertyShape;
    rdfs:label "schrapping"@nl;
    rdfs:comment "Verwijzing naar een schrapping van de schuldvordering."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Afbetalingsplan.Schrapping>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Schrapping>;
    shacl:description "Verwijzing naar een schrapping van de schuldvordering."@nl;
    shacl:maxCount 1;
    shacl:name "schrapping"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#schrapping>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afbetalingsplansaldo"@nl;
    rdfs:comment "Verwijzing naar een saldo van een afbetalingsplan, namelijk het nog af te betalen bedrag op een bepaalde datum."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Afbetalingsplan.Afbetalingsplansaldo>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Afbetalingsplansaldo>;
    shacl:description "Verwijzing naar een saldo van een afbetalingsplan, namelijk het nog af te betalen bedrag op een bepaalde datum."@nl;
    shacl:name "afbetalingsplansaldo"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#afbetalingsplansaldo>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afbetalingsplanonderdeel"@nl;
    rdfs:comment "Verwijzing naar een onderdeel van het afbetalingsplan."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Afbetalingsplan.Afbetalingsplanonderdeel>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Afbetalingsplanonderdeel>;
    shacl:description "Verwijzing naar een onderdeel van het afbetalingsplan."@nl;
    shacl:minCount 1;
    shacl:name "afbetalingsplanonderdeel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#afbetalingsplanonderdeel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorstel"@nl;
    rdfs:comment "Verwijzing naar de activiteit die het afbetalingsplan voorstelt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Afbetalingsplan.Voorstel>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Voorstel>;
    shacl:description "Verwijzing naar de activiteit die het afbetalingsplan voorstelt."@nl;
    shacl:minCount 1;
    shacl:name "voorstel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#voorstel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanvaarding"@nl;
    rdfs:comment "Verwijzing naar de aanvaarding van het afbetalingsplan."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Afbetalingsplan.Aanvaarding>;
    shacl:class <https://data.vlaanderen.be/ns/schuldbeheer#Aanvaarding>;
    shacl:description "Verwijzing naar de aanvaarding van het afbetalingsplan."@nl;
    shacl:name "aanvaarding"@nl;
    shacl:path <https://data.vlaanderen.be/ns/schuldbeheer#aanvaarding>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/schuldbeheer#Afbetalingsplan> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#AfbetalingsplanonderdeelShape> a shacl:NodeShape;
  rdfs:label "Afbetalingsplanonderdeel"@nl;
  rdfs:comment "Een afbetalingsplan bestaat uit verschillende onderdelen. Elk onderdeel specifieert een bedrag en tijdstip waarop dit bedrag ten laatste betaald moet zijn."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "uiterste betaaldatum"@nl;
    rdfs:comment "De laatst mogelijke datum waarop het af te betalen bedrag moet betaald zijn om aan de betaaldverplichting van het aanvaarde afbetalingsplan te voldoen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/schuldbeheer/kandidaatstandaard/2025-03-03#Afbetalingsplanonderdeel.UitersteBetaaldatum>;
    shacl:datatype xsd:date;
    shacl:description "De laatst mogelijke datum waarop het af te betalen bedrag moet betaald zijn om aan de betaaldverplichting van het aanvaarde afbetalingsplan te voldoen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "uiterste betaaldatum"@nl;
