<https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(generiek)Shape> a shacl:NodeShape;
  rdfs:label "Activiteit (Generiek)"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv het consumeren,verwerken,transformeren,wijzigen,verplaatsen,gebruiken of genereren van entiteiten."@nl;
  rdfs:comment "Handeling van bepaalde duur op of met entiteiten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Specialisatie van het type activiteit zoals bepaald in W3C Activity Streams."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(generiek).Type>;
    shacl:class skos:Concept;
    shacl:description "Specialisatie van het type activiteit zoals bepaald in W3C Activity Streams."@nl;
    shacl:name "type"@nl;
    shacl:path rdf:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "genereert"@nl;
    rdfs:comment "Annotatie die gegenereerd werd uit de activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(generiek).Genereert>;
    shacl:class oa:Annotation;
    shacl:description "Annotatie die gegenereerd werd uit de activiteit."@nl;
    shacl:name "genereert"@nl;
    shacl:path prov:generates
  ], [
    a shacl:PropertyShape;
    rdfs:label "was geassocieerd met"@nl;
    rdfs:comment "Agent die betrokken was bij de activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(generiek).WasGeassocieerdMet>;
    shacl:class prov:Agent;
    shacl:description "Agent die betrokken was bij de activiteit."@nl;
    shacl:name "was geassocieerd met"@nl;
    shacl:path prov:wasAssociatedWith
  ];
  shacl:targetClass prov:Activity .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(omgevingsvergunning)Shape> a shacl:NodeShape;
  rdfs:label "Activiteit (Omgevingsvergunning)"@nl;
  <http://purl.org/vocab/vann/usageNote> "Maakt het voorwerp uit van vergunningsaanvragen, meldingen, vergunningsbesluiten, vaststellingen."@nl;
  rdfs:comment "Geheel van handelingen die een of meerdere Rechtssubjecten binnen een welbepaald tijdsbestek en op een welbepaalde locatie ten uitvoer (willen) (laten) brengen en die gezien hun aard te kwalificeren zijn en dus geregeld zijn onder één of meer welbepaalde Juridische Categorieën."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "De beschrijving van de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(omgevingsvergunning).Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "De beschrijving van de Activiteit."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#beschrijving>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatie"@nl;
    rdfs:comment "Aanduiding van de plaats waar een Activiteit plaatsvindt, zal vinden, of zou hebben gevonden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(omgevingsvergunning).Locatie>;
    shacl:class <https://data.vlaanderen.be/ns/slimmeraadpleegomgeving#RuimtelijkeEenheid>;
    shacl:description "Aanduiding van de plaats waar een Activiteit plaatsvindt, zal vinden, of zou hebben gevonden."@nl;
    shacl:name "locatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#locatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "juridische kwalificatie"@nl;
    rdfs:comment "De Juridische Kwalificatie van de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(omgevingsvergunning).JuridischeKwalificatie>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#JuridischeKwalificatie>;
    shacl:description "De Juridische Kwalificatie van de Activiteit."@nl;
    shacl:name "juridische kwalificatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#juridischeKwalificatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "tijdsbestek"@nl;
    rdfs:comment "Aanduiding van het tijdsbestek van de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(omgevingsvergunning).Tijdsbestek>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Aanduiding van het tijdsbestek van de Activiteit."@nl;
    shacl:name "tijdsbestek"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#tijdsbestek>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verantwoordelijke"@nl;
    rdfs:comment "Rechtssubject verantwoordelijk voor de Activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(omgevingsvergunning).Verantwoordelijke>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Rechtssubject>;
    shacl:description "Rechtssubject verantwoordelijk voor de Activiteit."@nl;
    shacl:name "verantwoordelijke"@nl;
    shacl:path <https://data.vlaanderen.be/ns/omgevingsvergunning#verantwoordelijke>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is deel van"@nl;
    <http://purl.org/vocab/vann/usageNote> "Laat toe om een complexe Activiteit als een geneste datastructuur uit te werken."@nl;
    rdfs:comment "Verwijzing naar omvattende Activiteiten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Activiteit(omgevingsvergunning).IsDeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Activiteit>;
    shacl:description "Verwijzing naar omvattende Activiteiten."@nl;
    shacl:name "is deel van"@nl;
    shacl:path dc:isPartOf
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/omgevingsvergunning#Activiteit> .

