    a shacl:PropertyShape;
    rdfs:label "bestaat uit"@nl;
    rdfs:comment "Geeft een fijnmazigere activiteit aan die binnen dit Legaal Proces plaatsvindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#LegaalProces.BestaatUit>;
