    shacl:maxCount 1;
    shacl:name "bekrachtigt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/slimmeraadpleegomgeving#bekrachtigt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "realiseert"@nl;
    rdfs:comment "Normatieve bepaling die door de legale verschijningsvorm wordt gerealiseerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Legaleverschijningsvorm.Realiseert>;
