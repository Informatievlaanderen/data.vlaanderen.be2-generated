    rdfs:comment "Tekst dat de annotatie gebruikt als inhoud voor een resource."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Annotatie.HeeftTekstueleInhoud>;
