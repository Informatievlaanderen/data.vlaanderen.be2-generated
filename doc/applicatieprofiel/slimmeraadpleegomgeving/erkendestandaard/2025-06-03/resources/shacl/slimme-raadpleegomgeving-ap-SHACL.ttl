    shacl:name "bestaat uit"@nl;
    shacl:path <http://data.europa.eu/eli/eli-draft-legislation-ontology#consists_of>
  ];
  shacl:targetClass <http://data.europa.eu/eli/eli-draft-legislation-ontology#LegislativeProcess> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#LegaleActiviteitShape> a shacl:NodeShape;
  rdfs:label "Legale activiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> """Dit kan het maken van een document inhouden, of worden getriggerd door een document dat door een eerdere activiteit is gemaakt.

Dit kan gebruikt worden om activiteiten op een willekeurig nauwkeurigheidsniveau te beschrijven: macro-activiteiten, zoals het lezen van tekst in een kamer, of kleinschalige activiteiten, zoals stemmen om de voorzitter van een commissie te kiezen."""@nl;
  rdfs:comment "Een activiteit die plaatsvindt in een juridische context, hetzij in wetgevende organen zoals parlementen of uitvoerende organen zoals regeringen of de Europese Commissie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Korte beschrijving van de legale activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#LegaleActiviteit.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Korte beschrijving van de legale activiteit."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "De naam van de legale activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#LegaleActiviteit.Titel>;
    shacl:datatype xsd:string;
    shacl:description "De naam van de legale activiteit."@nl;
    shacl:maxCount "1";
    shacl:name "titel"@nl;
    shacl:path <http://data.europa.eu/eli/eli-draft-legislation-ontology#activity_label>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het is aan de gebruiker van de standaard om een passende codelijst op te stellen."@nl;
    rdfs:comment "De soort of categorie van de activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#LegaleActiviteit.Type>;
    shacl:class skos:Concept;
    shacl:description "De soort of categorie van de activiteit."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path <http://data.europa.eu/eli/eli-draft-legislation-ontology#had_activity_type>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft organisatie als participant"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een organisatie kan een fractie, partij of groep van raadsleden zijn."@nl;
    rdfs:comment "Een organisatie die deelneemt aan een activiteit, maar er niet noodzakelijk verantwoordelijk voor is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#LegaleActiviteit.HeeftOrganisatieAlsParticipant>;
    shacl:class org:Organization;
    shacl:description "Een organisatie die deelneemt aan een activiteit, maar er niet noodzakelijk verantwoordelijk voor is."@nl;
    shacl:name "heeft organisatie als participant"@nl;
    shacl:path <http://data.europa.eu/eli/eli-draft-legislation-ontology#had_participant_organization>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft persoon als participant"@nl;
    rdfs:comment "Een persoon die deelneemt aan een activiteit. Een preciezere eigenschap bestaat om de verantwoordelijke persoon van een activiteit aan te duiden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#LegaleActiviteit.HeeftPersoonAlsParticipant>;
    shacl:class <http://www.w3.org/ns/person#Person>;
    shacl:description "Een persoon die deelneemt aan een activiteit. Een preciezere eigenschap bestaat om de verantwoordelijke persoon van een activiteit aan te duiden."@nl;
    shacl:name "heeft persoon als participant"@nl;
    shacl:path <http://data.europa.eu/eli/eli-draft-legislation-ontology#had_participant_person>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft verantwoordelijke organisatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een organisatie kan een fractie, partij of groep van raadsleden zijn."@nl;
    rdfs:comment "De organisatie verantwoordelijk voor de activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#LegaleActiviteit.HeeftVerantwoordelijkeOrganisatie>;
    shacl:class org:Organization;
