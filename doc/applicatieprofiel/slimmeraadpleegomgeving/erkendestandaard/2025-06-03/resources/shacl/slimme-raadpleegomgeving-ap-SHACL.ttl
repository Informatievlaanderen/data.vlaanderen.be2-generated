<https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#InstantiePubliekeDienstverleningShape> a shacl:NodeShape;
  rdfs:label "Instantie publieke dienstverlening"@nl;
  rdfs:comment "Deze klasse vertegenwoordigt de openbare dienst zelf, zoals beschreven in een catalogus van openbare diensten. Een overheidsdienst is een verplichte of discretionaire reeks activiteiten die worden uitgevoerd of kunnen worden uitgevoerd door of namens een overheidsorganisatie, die door de overheid worden gefinancierd en die voortvloeien uit overheidsbeleid. Diensten kunnen ten goede komen aan een individu, een bedrijf of een andere overheidsinstantie, of groepen van deze. Een dienst bestaat ongeacht of er gebruik van wordt gemaakt, en de term \"voordeel\" kan van toepassing zijn in de zin van het mogelijk maken van het nakomen van een verplichting. Zoals gedefinieerd in de herziene versie van het Europese Interoperabiliteitskader, omvat een Europese overheidsdienst elke dienst die wordt geleverd door overheidsinstellingen in Europa, of door andere organisaties namens hen, aan bedrijven, burgers of andere overheidsinstellingen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "heeft bron"@nl;
    rdfs:comment "Verwijzing naar het conceptuele product in de Interbestuurlijke Diensten- en Productencataloog (IPDC)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#InstantiePubliekeDienstverlening.HeeftBron>;
    shacl:class <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#ConceptualPublicService>;
    shacl:description "Verwijzing naar het conceptuele product in de Interbestuurlijke Diensten- en Productencataloog (IPDC)."@nl;
    shacl:maxCount 1;
    shacl:name "heeft bron"@nl;
    shacl:path dc:source
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft legale rechtsgrond"@nl;
    rdfs:comment "Rechtsgrond waarop de dienstverlening betrekking heeft, werkt of zijn grondslag heeft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#InstantiePubliekeDienstverlening.HeeftLegaleRechtsgrond>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Rechtsgrond waarop de dienstverlening betrekking heeft, werkt of zijn grondslag heeft."@nl;
    shacl:name "heeft legale rechtsgrond"@nl;
    shacl:path <http://data.europa.eu/m8g/hasLegalResource>
  ];
  shacl:targetClass <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#InstancePublicService> .

