    shacl:description "Een Adviesvraag die ¨logischerwijs¨ voorafging aan deze AdviesAntwoord"@nl;
    shacl:name "was gemotiveerd door"@nl;
    shacl:path <http://data.europa.eu/eli/eli-draft-legislation-ontology#was_motivated_by>
  ], [
    a shacl:PropertyShape;
    rdfs:label "motiveerde"@nl;
    rdfs:comment "Een Beslissingsactiviteit die logisch volgde op dit AdviesAntwoord."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Adviesantwoord.Motiveerde>;
    shacl:class <https://data.vlaanderen.be/ns/besluitvorming#Beslissingsactiviteit>;
    shacl:description "Een Beslissingsactiviteit die logisch volgde op dit AdviesAntwoord."@nl;
    shacl:name "motiveerde"@nl;
    shacl:path <http://data.europa.eu/eli/eli-draft-legislation-ontology#motivated>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/slimmeraadpleegomgeving#AdviesAntwoord> .

