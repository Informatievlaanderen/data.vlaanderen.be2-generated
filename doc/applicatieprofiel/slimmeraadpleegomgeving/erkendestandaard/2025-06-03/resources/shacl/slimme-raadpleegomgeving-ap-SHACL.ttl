    shacl:name "heeft participatie"@nl;
    shacl:path <http://data.europa.eu/eli/eli-draft-legislation-ontology#had_participation>
  ];
  shacl:targetClass <http://data.europa.eu/eli/eli-draft-legislation-ontology#LegislativeActivity> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#LegaleverschijningsvormShape> a shacl:NodeShape;
  rdfs:label "LegaleVerschijningsvorm"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv een Besluit dat is genomen op basis van een Wet."@nl;
  rdfs:comment "Een legale verschijningsvorm is een intellectuele realisatie van een Rechtsgrond onder de vorm van een opeenvolging van tekens (meestal alphanumerieke tekens)."@nl;
