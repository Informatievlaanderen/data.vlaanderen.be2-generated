    rdfs:comment "Een stukje inhoud dat onmiddellijk voorafgaat aan de inhoud die wordt geselecteerd door de Selector."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Tekstquoteselector.Prefix>;
