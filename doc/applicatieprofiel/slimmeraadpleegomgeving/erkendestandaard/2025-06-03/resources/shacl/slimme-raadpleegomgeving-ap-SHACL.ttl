<https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#TekstpositieselectorShape> a shacl:NodeShape;
  rdfs:label "Tekstpositieselector"@nl;
  rdfs:comment "Afbakening van een resource met behulp van een tekstbereik op basis van de begin- en eindpositie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "start"@nl;
    rdfs:comment "De startpositie in een op 0 gebaseerde index waarop een inhoudsbereik wordt geselecteerd uit de gegevens in de bron."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Tekstpositieselector.Start>;
    shacl:datatype xsd:integer;
    shacl:description "De startpositie in een op 0 gebaseerde index waarop een inhoudsbereik wordt geselecteerd uit de gegevens in de bron."@nl;
    shacl:maxCount "1";
    shacl:name "start"@nl;
    shacl:path oa:start
  ], [
    a shacl:PropertyShape;
    rdfs:label "einde"@nl;
    rdfs:comment "De eigenschap einde wordt gebruikt om de op 0 gebaseerde index van de eindpositie van een inhoudsbereik over te brengen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#Tekstpositieselector.Einde>;
    shacl:datatype xsd:integer;
    shacl:description "De eigenschap einde wordt gebruikt om de op 0 gebaseerde index van de eindpositie van een inhoudsbereik over te brengen."@nl;
    shacl:maxCount "1";
    shacl:name "einde"@nl;
    shacl:path oa:end
  ];
  shacl:targetClass oa:TextPositionSelector .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/erkendestandaard/2025-06-03#TekstquoteselectorShape> a shacl:NodeShape;
