  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/ontwerpstandaard/toolchain4#Activiteit(generiek).Type>;
