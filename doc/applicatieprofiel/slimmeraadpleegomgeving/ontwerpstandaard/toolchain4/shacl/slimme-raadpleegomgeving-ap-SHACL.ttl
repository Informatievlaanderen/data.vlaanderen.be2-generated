    shacl:path rdf:type
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/slimmeraadpleegomgeving/ontwerpstandaard/toolchain4#Activiteit(generiek).Genereert>;
