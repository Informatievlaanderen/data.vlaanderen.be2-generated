        }
      },
      "@id": "https://data.vlaanderen.be/ns/statistiek#Kwantiel"
    },
    "Moment": {
      "@context": {
        "orde": {
          "@id": "https://data.vlaanderen.be/ns/statistiek#orde",
          "@type": "http://www.w3.org/2001/XMLSchema#integer"
        }
      },
      "@id": "https://data.vlaanderen.be/ns/statistiek#Moment"
    },
    "Object": {
      "@id": "http://def.isotc211.org/iso19156/2011/GeneralFeatureInstance#GFI_Feature"
    },
    "Observatie": {
      "@id": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation"
    },
    "OperatorType": {
      "@id": "http://www.w3.org/2004/02/skos/core#Concept"
    },
    "Probabiliteit": {
      "@context": {
        "drempelwaarde": {
