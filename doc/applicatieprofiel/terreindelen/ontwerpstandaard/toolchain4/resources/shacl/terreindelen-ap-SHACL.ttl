<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#AkkerShape> a shacl:NodeShape;
  rdfs:label "Akker"@nl;
  rdfs:comment "Terreindeel dat bewerkt wordt voor productie van landbouwgewassen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Akker> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#BijzondereOverrijdbareBeddingShape> a shacl:NodeShape;
  rdfs:label "Bijzondere overrijdbare bedding"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar definitie in wegcode: https://wegcode.be/wetteksten/secties/kb/wegcode/100-art2"@nl;
  rdfs:comment "Het deel van de openbare weg dat aan het verkeer van voertuigen van geregelde diensten voor gemeenschappelijk vervoer is voorbehouden door middel van de wegmarkeringen bedoeld in de artikelen 72.6. en 77.8. en waarvan het begin is aangeduid door het verkeersbord F18."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#BijzondereOverrijdbareBedding> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#BooleanShape> a shacl:NodeShape;
  rdfs:label "Boolean";
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#BoomplantplaatsShape> a shacl:NodeShape;
  rdfs:label "Boomplantplaats"@nl;
  rdfs:comment "De gereserveerde wortelzone, een ruimte (ondergronds) waar de wortels van bomen vrij kunnen groeien."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "doorwortelbaar volume"@nl;
    rdfs:comment "Het bodemvolume met voldoende mineralen, water en zuurstof die bereikbaar zijn voor een boom om erin te wortelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#Boomplantplaats.DoorwortelbaarVolume>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Het bodemvolume met voldoende mineralen, water en zuurstof die bereikbaar zijn voor een boom om erin te wortelen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "doorwortelbaar volume"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#doorwortelbaarVolume>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Boomplantplaats> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#BoordsteenShape> a shacl:NodeShape;
  rdfs:label "Boordsteen"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-basis - WLI1: Verhoogde boordsteen/kantsteen. Naar GRB-basis – WCZ: grens circulatiezone zwakke weggebruiker."@nl;
  rdfs:comment "Een lijnvormig inrichtingselement met een minimale breedte van 7cm dat gebruikt wordt voor de duurzame afboording van zones of voor geleiding van verkeersstromen. De rand van een zichtbaar fundament of sokkel (ter plekke vervaardigd) wordt niet als boordsteen beschouwd."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Boordsteen> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#BushaltehavenShape> a shacl:NodeShape;
  rdfs:label "Bushaltehaven"@nl;
  rdfs:comment "Uitwijkplaats bestemd voor het stilstaan van bussen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Bushaltehaven> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#DeelShape> a shacl:NodeShape;
  rdfs:label "Deel"@nl;
  rdfs:comment "Homogeen gedeelte van het aardoppervlak, met een gelijkaardige hoofdfunctie en fysiek voorkomen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "oppervlakte"@nl;
    rdfs:comment "De afmeting van het object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#Deel.Oppervlakte>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "De afmeting van het object."@nl;
    shacl:maxCount "1";
    shacl:name "oppervlakte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#oppervlakte>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein#Deel> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#DierenloopweideShape> a shacl:NodeShape;
  rdfs:label "Dierenloopweide"@nl;
  rdfs:comment "Terreindeel dat bedoeld is om gedomesticeerde dieren in de buitenruimte vrij te laten lopen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Dierenloopweide> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#EigenBeddingShape> a shacl:NodeShape;
  rdfs:label "Eigen bedding"@nl;
  <http://purl.org/vocab/vann/usageNote> "Geen Bijzonder Overrijdbare Bedding (Behoort tot de wegbaan)"@nl;
  rdfs:comment "Terreindeel bestemd voor het gebruik van spoorvoertuigen (trein, tram) dat niet behoord tot de wegbaan."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#EigenBedding> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#FietspadShape> a shacl:NodeShape;
  rdfs:label "Fietspad"@nl;
  rdfs:comment "Een zone binnen de binnen- of buitenberm en geschikt voor fiets- en/of bromfietsverkeer klasse A en aldus aangegeven via verticale en/of horizontale signalisatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "vrijliggend"@nl;
    rdfs:comment "Geeft aan of de verharding fysiek gescheiden is van de rijbaan door een veiligheidsstrook die niet door rijdend verkeer mag en kan worden gebruikt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#Fietspad.Vrijliggend>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of de verharding fysiek gescheiden is van de rijbaan door een veiligheidsstrook die niet door rijdend verkeer mag en kan worden gebruikt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "vrijliggend"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#vrijliggend>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Fietspad> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#FysiekObjectShape> a shacl:NodeShape;
  rdfs:label "Fysiek object"@nl;
  rdfs:comment "De hoofdklasse waar alle objecten die geïnventariseerd kunnen worden van afgeleid worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "begindatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het gebied of object in gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#FysiekObject.Begindatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het gebied of object in gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "begindatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#begindatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het beheerobject uit gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#FysiekObject.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het beheerobject uit gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#einddatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "niveau"@nl;
    <http://purl.org/vocab/vann/usageNote> "Negatieve waarden worden geassocieerd met ondergronds en positieve waarden met bovengronds. Nul wordt beschouwd als een absolute waarde om het maaiveld aan te duiden."@nl;
    rdfs:comment "Het niveau waarop het object zich bevindt, relatief ten opzichte van andere objecten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#FysiekObject.Niveau>;
    shacl:datatype xsd:integer;
    shacl:description "Het niveau waarop het object zich bevindt, relatief ten opzichte van andere objecten."@nl;
    shacl:maxCount "1";
    shacl:name "niveau"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#niveau>
  ], [
    a shacl:PropertyShape;
    rdfs:label "nauwkeurigheid"@nl;
    rdfs:comment "De precisie waarmee het object opgemeten werd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#FysiekObject.Nauwkeurigheid>;
    shacl:class skos:Concept;
    shacl:description "De precisie waarmee het object opgemeten werd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "nauwkeurigheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#nauwkeurigheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "De geometrie overeenkomstig met een bepaald object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#FysiekObject.Geometrie>;
    shacl:class <http://www.opengis.net/ont/geosparql#Geometry>;
    shacl:description "De geometrie overeenkomstig met een bepaald object."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "relatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een verwijzing naar een object uit het wegenregister of grootschalig referentiebestand."@nl;
    rdfs:comment "Verwijst naar een object in een andere databank dat meer informatie kan verschaffen over het beheerobject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#FysiekObject.Relatie>;
    shacl:class rdfs:Resource;
    shacl:description "Verwijst naar een object in een andere databank dat meer informatie kan verschaffen over het beheerobject."@nl;
    shacl:name "relatie"@nl;
    shacl:path dc:relation
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein#FysiekObject> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#GroendakShape> a shacl:NodeShape;
  rdfs:label "Groendak"@nl;
  <http://purl.org/vocab/vann/usageNote> "cf. GRB Lexicon: kan deel uitmaken van particulier gebied"@nl;
  rdfs:comment "Dak dat doelbewust begroeid is met planten."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Groendak> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#GroenvlakShape> a shacl:NodeShape;
  rdfs:label "Groenvlak"@nl;
  rdfs:comment "Terreindeel met aangelegde en beheerde begroeiing, met een hoofdzakelijk visueel-structurerende functie."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Groenvlak> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#HondentoiletShape> a shacl:NodeShape;
  rdfs:label "Hondentoilet"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-skeletoptie groen- en begraafplaatsenbeheer - PRA: Park- of recreatieattribuut; PRC: Functiecode park- of recreatieattribuut."@nl;
  rdfs:comment "Een plaats waar huisdieren (honden) hun behoefte kunnen en mogen doen en waarbij het opruimen van de hondenpoep wordt uitgevoerd door de gemeente of een andere instantie."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Hondentoilet> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#HondenuitlaatplaatsShape> a shacl:NodeShape;
  rdfs:label "Hondenuitlaatplaats"@nl;
  rdfs:comment "Afgebakend terreindeel waar geen opruimplicht voor hondenpoep geldt en waar honden aan de leiband dienen te lopen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Hondenuitlaatplaats> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#HoogstamboomgaardShape> a shacl:NodeShape;
  rdfs:label "Hoogstamboomgaard"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar Ecopedia (https://www.ecopedia.be/bwk/hoogstamboomgaard-kj)"@nl;
  rdfs:comment "Hoogstamboomgaarden zijn aanplanten van hoogstammige fruitbomen in grasland. Dikwijls liggen ze in de onmiddellijke omgeving van de bebouwing. Een hoogstamboomgaard onderscheidt zich van een laagstam- of productieboomgaard (kl) door de hoogstammige fruitbomen, een aaneengesloten graslandvegetatie onder de bomen en een veelal hogere ouderdom."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Hoogstamboomgaard> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#HorecaterreinShape> a shacl:NodeShape;
  rdfs:label "Horecaterrein"@nl;
  rdfs:comment "Terreindeel dat bedoeld is om horeca-activiteiten te laten doorgaan"@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Horecaterrein> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#IntegerShape> a shacl:NodeShape;
  rdfs:label "Integer";
  shacl:closed false;
  shacl:targetClass xsd:integer .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/terreindelen/ontwerpstandaard/toolchain4#KantsteenShape> a shacl:NodeShape;
  rdfs:label "Kantsteen"@nl;
  <http://purl.org/vocab/vann/usageNote> "Naar GRB-basis - WLI1: Verhoogde boordsteen/kantsteen."@nl;
