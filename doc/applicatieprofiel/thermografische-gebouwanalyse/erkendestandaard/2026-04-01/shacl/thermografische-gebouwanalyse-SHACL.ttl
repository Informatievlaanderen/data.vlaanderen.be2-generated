    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Soort kenmerk."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/thermografische-gebouwanalyse/erkendestandaard/2026-04-01#Kenmerk.Type>;
