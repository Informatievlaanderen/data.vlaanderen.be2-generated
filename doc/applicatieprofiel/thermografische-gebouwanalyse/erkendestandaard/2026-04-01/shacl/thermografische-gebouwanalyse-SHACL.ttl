  ];
  shacl:targetClass <https://www.w3.org/ns/sosa/Platform> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/thermografische-gebouwanalyse/erkendestandaard/2026-04-01#SensorShape> a shacl:NodeShape;
  rdfs:label "Sensor"@nl;
  <http://purl.org/vocab/vann/usageNote> "Sensoren genereren een resultaat op basis van een Stimulus, ttz een verandering in de omgeving, of op basis van resultaten van andere Observaties. Ze worden typisch gehost door een Platform. Voorbeelden zijn snelheidsmeters, gyroscopen, barometers, magnetometers gemonteerd op een smart phone. Ook bv het menselijk oog kan beschouwd worden als een Sensor."@nl;
  rdfs:comment "Toestel of Agent (incl Personen of software) waarmee Observaties gemaakt worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "implementeert"@nl;
    rdfs:comment "Observatieprocedure die door de Sensor wordt toegepast."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/thermografische-gebouwanalyse/erkendestandaard/2026-04-01#Sensor.Implementeert>;
    shacl:class <http://www.w3.org/ns/sosa/ObservingProcedure>;
    shacl:description "Observatieprocedure die door de Sensor wordt toegepast."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "implementeert"@nl;
    shacl:path <http://www.w3.org/ns/sosa/implements>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdeObservatie"@nl;
    rdfs:comment "Observatie die met de Sensor is uitrgevoerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/thermografische-gebouwanalyse/erkendestandaard/2026-04-01#Sensor.Uitgevoerdeobservatie>;
    shacl:class <http://www.w3.org/ns/sosa/Observation>;
    shacl:description "Observatie die met de Sensor is uitrgevoerd."@nl;
    shacl:name "uitgevoerdeObservatie"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeObservation>
  ];
  shacl:targetClass <https://www.fair-gnss.oma.be/gnss-dcat-ap/vocabulary/geo#GNSSReceiver>,
    <https://www.w3.org/ns/sosa/Sensor>,
    dbo:Camera,
    <https://w3id.org/okn/o/sd#ConfigurationSetup>,
    <http://data.europa.eu/it6/MachineLearningModel> .

