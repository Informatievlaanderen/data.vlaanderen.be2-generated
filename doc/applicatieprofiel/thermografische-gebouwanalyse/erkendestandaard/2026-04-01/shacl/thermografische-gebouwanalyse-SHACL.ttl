    shacl:maxCount "1";
    shacl:name "locatie"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#hasGeometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hostVan"@nl;
    rdfs:comment "Systeem dat door het Platform wordt gehost."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/thermografische-gebouwanalyse/erkendestandaard/2026-04-01#Platform.Hostvan>;
    shacl:description "Systeem dat door het Platform wordt gehost."@nl;
    shacl:name "hostVan"@nl;
    shacl:or ([shacl:class <http://www.w3.org/ns/ssn/System>] [shacl:class <https://www.w3.org/ns/sosa/Sensor>] [shacl:class <https://www.fair-gnss.oma.be/gnss-dcat-ap/vocabulary/geo#GNSSReceiver>] [shacl:class dbo:Camera] [shacl:class <https://w3id.org/okn/o/sd#ConfigurationSetup>] [shacl:class <http://data.europa.eu/it6/MachineLearningModel>] [shacl:class <https://saref.etsi.org/core/Device>]);
    shacl:path <https://www.w3.org/ns/sosa/hosts>
  ], [
