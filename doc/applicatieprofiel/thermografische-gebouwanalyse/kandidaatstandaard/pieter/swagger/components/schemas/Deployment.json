{
  "title": "Deployment",
  "type": "object",
  "description": "Beschrijft de inzet of uitrol van een of meer systemen voor een bepaald doel.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Deployment)",
      "pattern": "^Deployment$"
    },
    "deploymentTijdstip": {
      "type": "array",
      "description": "Het moment waarop een bepaalde Deployment plaatsvindt. Lijst van TemporeleEntiteit items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TemporeleEntiteit"
          },
          {
            "$ref": "#/components/schemas/Moment"
          },
          {
            "$ref": "#/components/schemas/Periode"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "TemporeleEntiteit": "#/components/schemas/TemporeleEntiteit",
            "Moment": "#/components/schemas/Moment",
            "Periode": "#/components/schemas/Periode"
          }
        }
      },
      "minItems": 1
    },
    "deployedSysteem": {
      "type": "array",
      "description": "Systeem dat is gedeployed. Lijst van Systeem items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Sensor"
          },
          {
            "$ref": "#/components/schemas/Toestel"
          },
          {
            "$ref": "#/components/schemas/MachineLearningModel"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Sensor": "#/components/schemas/Sensor",
            "Toestel": "#/components/schemas/Toestel",
            "MachineLearningModel": "#/components/schemas/MachineLearningModel"
          }
        }
      },
      "minItems": 1
    },
    "host": {
      "type": "array",
      "description": "Platform waarop het Systeem is gedeployed. Lijst van Platform items.",
      "items": {
        "$ref": "#/components/schemas/Platform"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}