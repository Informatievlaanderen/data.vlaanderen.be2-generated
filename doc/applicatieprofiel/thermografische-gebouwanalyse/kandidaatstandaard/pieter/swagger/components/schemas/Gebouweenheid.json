{
  "title": "Gebouweenheid",
  "type": "object",
  "description": "De kleinste eenheid binnen een gebouw die geschikt is voor woon-, bedrijfsmatige, of recreatieve doeleinden en die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde circulatieruimte. Een gebouweenheid is in functioneel opzicht zelfstandig. Daarnaast kan een gebouweenheid ook een gemeenschappelijk deel zijn.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Gebouweenheid)",
      "pattern": "^Gebouweenheid$"
    },
    "kenmerk": {
      "type": "array",
      "description": "Lijst van Kenmerk items.",
      "items": {
        "$ref": "#/components/schemas/Kenmerk"
      },
      "minItems": 1
    },
    "adres": {
      "type": "array",
      "description": "Lijst van Adresvoorstelling items.",
      "items": {
        "$ref": "#/components/schemas/Adresvoorstelling"
      },
      "minItems": 1
    },
    "functie": {
      "$ref": "#/components/schemas/TypeFunctie"
    },
    "status": {
      "$ref": "#/components/schemas/TypeGebouweenheidstatus"
    },
    "type": {
      "type": "array",
      "description": "Lijst van Domeinobjecttype items.",
      "items": {
        "$ref": "#/components/schemas/Domeinobjecttype"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "status"
  ]
}