{
  "title": "KwantitatieveWaarde",
  "type": "object",
  "description": "Een kwantitatieve waarde beschrijft de grootte en is het product van een numerieke waarde en een meeteenheid.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse KwantitatieveWaarde)",
      "pattern": "^KwantitatieveWaarde$"
    },
    "waarde": {
      "type": "object",
      "description": "Bepaalde hoeveelheid.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "eenheid": {
      "$ref": "#/components/schemas/Eenheid"
    }
  },
  "required": [
    "@type",
    "waarde",
    "eenheid"
  ]
}