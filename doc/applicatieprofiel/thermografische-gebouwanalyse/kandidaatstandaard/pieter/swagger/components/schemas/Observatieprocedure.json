{
  "title": "Observatieprocedure",
  "type": "object",
  "description": "Stappen die zijn uitgevoerd om de waarde van het geobserveerdKenmerk te bekomen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Observatieprocedure)",
      "pattern": "^Observatieprocedure$"
    },
    "specificatie": {
      "type": "array",
      "description": "Verwijzing naar een document dat de Observatieprocedure beschrijft. Lijst van URI items.",
      "items": {
        "$ref": "#/components/schemas/Observatieprocedure.specificatie"
      },
      "minItems": 1
    },
    "input": {
      "type": "array",
      "description": "Verwijzing naar de Input die de procedure vereist. Lijst van Input items.",
      "items": {
        "$ref": "#/components/schemas/Input"
      },
      "minItems": 1
    },
    "output": {
      "type": "array",
      "description": "Verwijzing naar de Output die de Procedure genereert. Lijst van Output items.",
      "items": {
        "$ref": "#/components/schemas/Output"
      },
      "minItems": 1
    },
    "parameter": {
      "type": "array",
      "description": "Fenomeen dat uitvoering van de Observatieprocedure beInvloedt. Verschillend van het geobserveerdKenmerk. Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Aard van de Observatieprocedure. Lijst van Observatieproceduretype items.",
      "items": {
        "$ref": "#/components/schemas/Observatieproceduretype"
      },
      "minItems": 1
    },
    "geïMplementeerdMet": {
      "type": "array",
      "description": "Sensor waarmee de Observatieprocedure is of moet worden uitgevoerd. Lijst van Sensor items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Sensor"
          },
          {
            "$ref": "#/components/schemas/GnssOntvanger"
          },
          {
            "$ref": "#/components/schemas/Camera"
          },
          {
            "$ref": "#/components/schemas/Opstelling"
          },
          {
            "$ref": "#/components/schemas/MachineLearningModel"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Sensor": "#/components/schemas/Sensor",
            "GnssOntvanger": "#/components/schemas/GnssOntvanger",
            "Camera": "#/components/schemas/Camera",
            "Opstelling": "#/components/schemas/Opstelling",
            "MachineLearningModel": "#/components/schemas/MachineLearningModel"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}