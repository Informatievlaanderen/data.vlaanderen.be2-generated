{
  "title": "ObservationProcedure",
  "type": "object",
  "description": "Steps that have been taken to obtain the value of the observed Attribute.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse ObservationProcedure)",
      "pattern": "^ObservationProcedure$"
    },
    "specification": {
      "type": "array",
      "description": "Reference to a document describing the Observation Procedure. Lijst van URI items.",
      "items": {
        "$ref": "#/components/schemas/ObservationProcedure.specification"
      },
      "minItems": 1
    },
    "input": {
      "type": "array",
      "description": "Reference to the Input that the procedure requires. Lijst van Input items.",
      "items": {
        "$ref": "#/components/schemas/Input"
      },
      "minItems": 1
    },
    "output": {
      "type": "array",
      "description": "Reference to the Output generated by the Procedure. Lijst van Output items.",
      "items": {
        "$ref": "#/components/schemas/Output"
      },
      "minItems": 1
    },
    "parameter": {
      "type": "array",
      "description": "Phenomenon that affects the execution of the Observation Procedure. Different from the observed Feature. Lijst van NominatedValue items.",
      "items": {
        "$ref": "#/components/schemas/NominatedValue"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Nature of the Observation Procedure. Lijst van ObservationProcedureType items.",
      "items": {
        "$ref": "#/components/schemas/ObservationProcedureType"
      },
      "minItems": 1
    },
    "implementedWith": {
      "type": "array",
      "description": "Sensor with which the Observation Procedure has been or is to be performed. Lijst van Sensor items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Sensor"
          },
          {
            "$ref": "#/components/schemas/MachineLearningModel"
          },
          {
            "$ref": "#/components/schemas/GnssReceiver"
          },
          {
            "$ref": "#/components/schemas/Camera"
          },
          {
            "$ref": "#/components/schemas/Setup"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Sensor": "#/components/schemas/Sensor",
            "MachineLearningModel": "#/components/schemas/MachineLearningModel",
            "GnssReceiver": "#/components/schemas/GnssReceiver",
            "Camera": "#/components/schemas/Camera",
            "Setup": "#/components/schemas/Setup"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}