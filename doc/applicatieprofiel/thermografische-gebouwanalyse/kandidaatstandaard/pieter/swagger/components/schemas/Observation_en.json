{
  "title": "Observation",
  "type": "object",
  "description": "Activity that determines the value of a particular attribute of an Object.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Observation)",
      "pattern": "^Observation$"
    },
    "parameter": {
      "type": "array",
      "description": "Phenomenon that affects Observation activity. Different from the observed Feature. Lijst van NominatedValue items.",
      "items": {
        "$ref": "#/components/schemas/NominatedValue"
      },
      "minItems": 1
    },
    "phenomenonTime": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/TemporalEntity"
        },
        {
          "$ref": "#/components/schemas/Moment"
        },
        {
          "$ref": "#/components/schemas/PeriodOfProject"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "TemporalEntity": "#/components/schemas/TemporalEntity",
          "Moment": "#/components/schemas/Moment",
          "PeriodOfProject": "#/components/schemas/PeriodOfProject"
        }
      }
    },
    "result": {
      "$ref": "#/components/schemas/Any"
    },
    "type": {
      "type": "array",
      "description": "The kind of Observation. Lijst van ObservationType items.",
      "items": {
        "$ref": "#/components/schemas/ObservationType"
      },
      "minItems": 1
    },
    "identifier": {
      "type": "array",
      "description": "Observation Identifier. Lijst van Identifier items.",
      "items": {
        "$ref": "#/components/schemas/Identifier"
      },
      "minItems": 1
    },
    "observedCharacteristic": {
      "$ref": "#/components/schemas/ObservableCharacteristic"
    },
    "performedWithSensor": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Sensor"
        },
        {
          "$ref": "#/components/schemas/MachineLearningModel"
        },
        {
          "$ref": "#/components/schemas/GnssReceiver"
        },
        {
          "$ref": "#/components/schemas/Camera"
        },
        {
          "$ref": "#/components/schemas/Setup"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Sensor": "#/components/schemas/Sensor",
          "MachineLearningModel": "#/components/schemas/MachineLearningModel",
          "GnssReceiver": "#/components/schemas/GnssReceiver",
          "Camera": "#/components/schemas/Camera",
          "Setup": "#/components/schemas/Setup"
        }
      }
    },
    "procedureUsed": {
      "type": "array",
      "description": "The procedure followed in the Observation. Lijst van ObservationProcedure items.",
      "items": {
        "$ref": "#/components/schemas/ObservationProcedure"
      },
      "minItems": 1
    },
    "observedObject": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Building"
        },
        {
          "$ref": "#/components/schemas/Video"
        },
        {
          "$ref": "#/components/schemas/BimElement"
        },
        {
          "$ref": "#/components/schemas/BuildingUnit"
        },
        {
          "$ref": "#/components/schemas/Photo"
        },
        {
          "$ref": "#/components/schemas/BIMBuilding"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Building": "#/components/schemas/Building",
          "Video": "#/components/schemas/Video",
          "BimElement": "#/components/schemas/BimElement",
          "BuildingUnit": "#/components/schemas/BuildingUnit",
          "Photo": "#/components/schemas/Photo",
          "BIMBuilding": "#/components/schemas/BIMBuilding"
        }
      }
    },
    "isMemberOf": {
      "type": "array",
      "description": "The collection of which the Oberservatie is a part. Lijst van ObservationCollection items.",
      "items": {
        "$ref": "#/components/schemas/ObservationCollection"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "phenomenonTime",
    "result",
    "observedCharacteristic",
    "performedWithSensor",
    "observedObject"
  ]
}