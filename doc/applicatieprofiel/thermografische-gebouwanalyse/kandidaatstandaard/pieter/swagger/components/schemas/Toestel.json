{
  "title": "Toestel",
  "type": "object",
  "description": "Tastbaar Object ontworpen om een specifieke Taak mee uit te voeren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Toestel)",
      "pattern": "^Toestel$"
    },
    "fabrikant": {
      "$ref": "#/components/schemas/Toestel.fabrikant"
    },
    "model": {
      "$ref": "#/components/schemas/Toestel.model"
    },
    "functie": {
      "type": "array",
      "description": "Functie die het Toestel kan uitvoeren met het oog op het uitvoeren van een taak. Lijst van Functie items.",
      "items": {
        "$ref": "#/components/schemas/Functie"
      },
      "minItems": 1
    },
    "taak": {
      "type": "array",
      "description": "Taak die met het Toestel kan worden uitgevoerd waarvoor het Toestel ontworpen is. Lijst van Taak items.",
      "items": {
        "$ref": "#/components/schemas/Taak"
      },
      "minItems": 1
    },
    "type": {
      "$ref": "#/components/schemas/Platformtype"
    },
    "capaciteit": {
      "type": "array",
      "description": "Capaciteit van het Systeem. Lijst van Systeemvermogen items.",
      "items": {
        "$ref": "#/components/schemas/Systeemvermogen"
      },
      "minItems": 1
    },
    "werkingsbereik": {
      "type": "array",
      "description": "Werking van het Systeem. Lijst van Werkingsbereik items.",
      "items": {
        "$ref": "#/components/schemas/Werkingsbereik"
      },
      "minItems": 1
    },
    "overlevingsbereik": {
      "type": "array",
      "description": "Levensduur van het Systeem. Lijst van Overlevingscapaciteit items.",
      "items": {
        "$ref": "#/components/schemas/Overlevingscapaciteit"
      },
      "minItems": 1
    },
    "gehostDoor": {
      "type": "array",
      "description": "Platform waarop het Systeem gehost wordt. Lijst van Platform items.",
      "items": {
        "$ref": "#/components/schemas/Platform"
      },
      "minItems": 1
    },
    "heeftDeployment": {
      "type": "array",
      "description": "Een Systeem heeft een bepaalde Deployment. Lijst van Deployment items.",
      "items": {
        "$ref": "#/components/schemas/Deployment"
      },
      "minItems": 1
    },
    "locatie": {
      "$ref": "#/components/schemas/Geometrie"
    },
    "hostVan": {
      "type": "array",
      "description": "Systeem dat door het Platform wordt gehost. Lijst van Systeem items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Sensor"
          },
          {
            "$ref": "#/components/schemas/Toestel"
          },
          {
            "$ref": "#/components/schemas/MachineLearningModel"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Sensor": "#/components/schemas/Sensor",
            "Toestel": "#/components/schemas/Toestel",
            "MachineLearningModel": "#/components/schemas/MachineLearningModel"
          }
        }
      },
      "minItems": 1
    },
    "deployment": {
      "type": "array",
      "description": "Een platform heeft een bepaalde Deployment. Lijst van Deployment items.",
      "items": {
        "$ref": "#/components/schemas/Deployment"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "functie",
    "taak",
    "type"
  ]
}