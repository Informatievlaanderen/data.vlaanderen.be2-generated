{
  "title": "MachineLearningModel",
  "type": "object",
  "description": "Een set van parameters opgeslagen in een bestand, dat getraind is om patronen te herkennen en een klasse of waarde te voorspellen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse MachineLearningModel)",
      "pattern": "^MachineLearningModel$"
    },
    "naam": {
      "type": "object",
      "description": "Naam van het model.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "versie": {
      "type": "object",
      "description": "De huidige versie van het model. Je vindt de definitie terug op <a href=\"https://semiceu.github.io/MLDCAT-AP/releases/2.0.0/#MachineLearningModel\">https://semiceu.github.io/MLDCAT-AP/releases/2.0.0/#MachineLearningModel</a>.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "creatiedatum": {
      "type": "object",
      "description": "Creatiedatum van het model.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "type": {
      "type": "array",
      "description": "Lijst van Systeemtype items.",
      "items": {
        "$ref": "#/components/schemas/Systeemtype"
      },
      "minItems": 1
    },
    "getraindOp": {
      "type": "array",
      "description": "Lijst van Dataset items.",
      "items": {
        "$ref": "#/components/schemas/Dataset"
      },
      "minItems": 1
    },
    "implementeert": {
      "$ref": "#/components/schemas/Observatieprocedure"
    },
    "uitgevoerdeObservatie": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "$ref": "#/components/schemas/Observatie"
      },
      "minItems": 1
    },
    "capaciteit": {
      "type": "array",
      "description": "Lijst van Systeemvermogen items.",
      "items": {
        "$ref": "#/components/schemas/Systeemvermogen"
      },
      "minItems": 1
    },
    "werkingsbereik": {
      "type": "array",
      "description": "Lijst van Werkingsbereik items.",
      "items": {
        "$ref": "#/components/schemas/Werkingsbereik"
      },
      "minItems": 1
    },
    "overlevingsbereik": {
      "type": "array",
      "description": "Lijst van Overlevingscapaciteit items.",
      "items": {
        "$ref": "#/components/schemas/Overlevingscapaciteit"
      },
      "minItems": 1
    },
    "gehostDoor": {
      "type": "array",
      "description": "Lijst van Platform items.",
      "items": {
        "$ref": "#/components/schemas/Platform"
      },
      "minItems": 1
    },
    "heeftDeployment": {
      "type": "array",
      "description": "Lijst van Deployment items.",
      "items": {
        "$ref": "#/components/schemas/Deployment"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "implementeert"
  ]
}