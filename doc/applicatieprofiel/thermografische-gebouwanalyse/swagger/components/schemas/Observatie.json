{
  "title": "Observatie",
  "type": "object",
  "description": "Activiteit waarbij de waarde van een bepaald kenmerk van een Object wordt vastgesteld.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Observatie)",
      "pattern": "^Observatie$"
    },
    "parameter": {
      "type": "array",
      "description": "Fenomeen dat activiteit van de Observatie beInvloedt. Verschillend van het geobserveerdKenmerk. Lijst van BenoemdeWaarde items.",
      "items": {
        "$ref": "#/components/schemas/BenoemdeWaarde"
      },
      "minItems": 1
    },
    "fenomeentijd": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/TemporeleEntiteit"
        },
        {
          "$ref": "#/components/schemas/Moment"
        },
        {
          "$ref": "#/components/schemas/Periode"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "TemporeleEntiteit": "#/components/schemas/TemporeleEntiteit",
          "Moment": "#/components/schemas/Moment",
          "Periode": "#/components/schemas/Periode"
        }
      }
    },
    "resultaat": {
      "$ref": "#/components/schemas/Any"
    },
    "type": {
      "type": "array",
      "description": "Het soort Observatie. Lijst van Observatietype items.",
      "items": {
        "$ref": "#/components/schemas/Observatietype"
      },
      "minItems": 1
    },
    "identificator": {
      "type": "array",
      "description": "Identificator van de Observatie. Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "geobserveerdKenmerk": {
      "$ref": "#/components/schemas/ObserveerbaarKenmerk"
    },
    "uitgevoerdMetSensor": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Sensor"
        },
        {
          "$ref": "#/components/schemas/GNSSOntvanger"
        },
        {
          "$ref": "#/components/schemas/Camera"
        },
        {
          "$ref": "#/components/schemas/Opstelling"
        },
        {
          "$ref": "#/components/schemas/MachineLearningModel"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Sensor": "#/components/schemas/Sensor",
          "GNSSOntvanger": "#/components/schemas/GNSSOntvanger",
          "Camera": "#/components/schemas/Camera",
          "Opstelling": "#/components/schemas/Opstelling",
          "MachineLearningModel": "#/components/schemas/MachineLearningModel"
        }
      }
    },
    "gebruikteProcedure": {
      "type": "array",
      "description": "De procedure die bij de Observatie wordt gevolgd. Lijst van Observatieprocedure items.",
      "items": {
        "$ref": "#/components/schemas/Observatieprocedure"
      },
      "minItems": 1
    },
    "geobserveerdObject": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Gebouw"
        },
        {
          "$ref": "#/components/schemas/Gebouweenheid"
        },
        {
          "$ref": "#/components/schemas/Foto"
        },
        {
          "$ref": "#/components/schemas/BIM_Gebouw"
        },
        {
          "$ref": "#/components/schemas/BIM_Element"
        },
        {
          "$ref": "#/components/schemas/Video"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Gebouw": "#/components/schemas/Gebouw",
          "Gebouweenheid": "#/components/schemas/Gebouweenheid",
          "Foto": "#/components/schemas/Foto",
          "BIM_Gebouw": "#/components/schemas/BIM_Gebouw",
          "BIM_Element": "#/components/schemas/BIM_Element",
          "Video": "#/components/schemas/Video"
        }
      }
    },
    "isLidVan": {
      "type": "array",
      "description": "De verzameling waarvan de Oberservatie deel uitmaakt. Lijst van Observatieverzameling items.",
      "items": {
        "$ref": "#/components/schemas/Observatieverzameling"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "fenomeentijd",
    "resultaat",
    "geobserveerdKenmerk",
    "uitgevoerdMetSensor",
    "geobserveerdObject"
  ]
}