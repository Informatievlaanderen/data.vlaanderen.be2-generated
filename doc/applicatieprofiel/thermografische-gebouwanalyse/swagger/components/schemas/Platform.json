{
  "title": "Platform",
  "type": "object",
  "description": "Entiteit die fungeert als basis voor andere Entiteiten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Platform)",
      "pattern": "^Platform$"
    },
    "type": {
      "$ref": "#/components/schemas/Platformtype"
    },
    "locatie": {
      "$ref": "#/components/schemas/Geometrie"
    },
    "hostVan": {
      "type": "array",
      "description": "Systeem dat door het Platform wordt gehost. Lijst van Systeem items.",
      "items": {
        "$ref": "#/components/schemas/Toestel"
      },
      "minItems": 1
    },
    "deployment": {
      "type": "array",
      "description": "Een platform heeft een bepaalde Deployment. Lijst van Deployment items.",
      "items": {
        "$ref": "#/components/schemas/Deployment"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "type"
  ]
}