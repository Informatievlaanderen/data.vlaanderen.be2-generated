    shacl:class schemas:QuantitativeValue;
    shacl:description "Oppervlakte van het vastgoed."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "oppervlakte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#oppervlakte>
  ], [
