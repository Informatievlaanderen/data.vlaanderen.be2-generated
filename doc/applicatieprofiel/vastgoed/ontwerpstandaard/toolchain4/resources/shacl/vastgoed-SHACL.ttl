    shacl:maxCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#geometrie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebouw"@nl;
    rdfs:comment "Een gesloten en/of overdekt, bovengronds of ondergronds bouwwerk, dat dient of bestemd is, ofwel om mensen, dieren en voorwerpen onder te brengen, ofwel om economische goederen te vervaardigen of diensten te verstrekken. Een gebouw verwijst naar gelijk welke structuur die op blijvende wijze op een terrein opgetrokken of gebouwd wordt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Vastgoed.Gebouw>;
    shacl:class <https://data.vlaanderen.be/ns/gebouw#Gebouw>;
    shacl:description "Een gesloten en/of overdekt, bovengronds of ondergronds bouwwerk, dat dient of bestemd is, ofwel om mensen, dieren en voorwerpen onder te brengen, ofwel om economische goederen te vervaardigen of diensten te verstrekken. Een gebouw verwijst naar gelijk welke structuur die op blijvende wijze op een terrein opgetrokken of gebouwd wordt."@nl;
    shacl:name "gebouw"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#gebouw>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebouweenheid"@nl;
    rdfs:comment "De kleinste eenheid binnen een gebouw die geschikt is voor woon-, bedrijfsmatige, of recreatieve doeleinden en die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde circulatieruimte. Een gebouweenheid is in functioneel opzicht zelfstandig. Daarnaast kan een gebouweenheid ook een gemeenschappelijk deel zijn."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Vastgoed.Gebouweenheid>;
    shacl:class <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid>;
    shacl:description "De kleinste eenheid binnen een gebouw die geschikt is voor woon-, bedrijfsmatige, of recreatieve doeleinden en die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde circulatieruimte. Een gebouweenheid is in functioneel opzicht zelfstandig. Daarnaast kan een gebouweenheid ook een gemeenschappelijk deel zijn."@nl;
    shacl:name "gebouweenheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#gebouweenheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aard perceel"@nl;
