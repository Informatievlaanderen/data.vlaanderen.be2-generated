    shacl:description "De aard van het perceel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aard perceel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#aardPerceel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aard vastgoed"@nl;
    <http://purl.org/vocab/vann/usageNote> "e.g. Appartement,"@nl;
    rdfs:comment "De aard van het vastgoed"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Vastgoed.AardVastgoed>;
