<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#AanvraagShape> a shacl:NodeShape;
  rdfs:label "Aanvraag"@nl;
  rdfs:comment "Start van de procedure voor een publieke dienstverlening."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    rdfs:comment "Datum waarop de aanvraag ingediend is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Aanvraag.Datum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de aanvraag ingediend is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#datum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    <http://purl.org/vocab/vann/usageNote> "e.g. Voltooid, in behandeling ..."@nl;
    rdfs:comment "Toestand waarin de aanvraag zich bevindt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Aanvraag.Status>;
    shacl:class <https://data.vlaanderen.be/ns/vastgoed#Aanvraagstatus>;
    shacl:description "Toestand waarin de aanvraag zich bevindt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "status"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "doel"@nl;
    <http://purl.org/vocab/vann/usageNote> "e.g. Verkoop, verhuur ..."@nl;
    rdfs:comment "Doel van de aanvraag."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Aanvraag.Doel>;
    shacl:class <https://data.vlaanderen.be/ns/vastgoed#DoelAanvraag>;
    shacl:description "Doel van de aanvraag."@nl;
    shacl:minCount "1";
    shacl:name "doel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#doel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "prijs"@nl;
    <http://purl.org/vocab/vann/usageNote> "Kostprijs wordt bepaald door type aanvraag en door de publieke organisatie die de dienstverlening aanbiedt."@nl;
    rdfs:comment "Kostprijs verbonden aan het gebruik van de publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Aanvraag.Prijs>;
    shacl:class <https://data.vlaanderen.be/ns/vastgoed#Bedrag>;
    shacl:description "Kostprijs verbonden aan het gebruik van de publieke dienstverlening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "prijs"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#prijs>
  ], [
    a shacl:PropertyShape;
    rdfs:label "inlichtingen over"@nl;
    rdfs:comment "Het object waar inlichtingen over worden aangevraagd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Aanvraag.InlichtingenOver>;
    shacl:class <https://data.vlaanderen.be/ns/vastgoed#Vastgoed>;
    shacl:description "Het object waar inlichtingen over worden aangevraagd."@nl;
    shacl:minCount 1;
    shacl:name "inlichtingen over"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#inlichtingenOver>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanvrager"@nl;
    rdfs:comment "Iemand die het proces van de aanvraag voor een publieke dienstverlening kan teweeg brengen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Aanvraag.Aanvrager>;
    shacl:class <https://data.vlaanderen.be/ns/vastgoed#Aanvrager>;
    shacl:description "Iemand die het proces van de aanvraag voor een publieke dienstverlening kan teweeg brengen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aanvrager"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#aanvrager>
  ], [
    a shacl:PropertyShape;
    rdfs:label "resultaat"@nl;
    rdfs:comment "Resultaat van de aanvraag."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Aanvraag.Resultaat>;
    shacl:class <https://data.vlaanderen.be/ns/vastgoed#Vastgoeddossier>;
    shacl:description "Resultaat van de aanvraag."@nl;
    shacl:minCount 1;
    shacl:name "resultaat"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#resultaat>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/vastgoed#Aanvraag> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#AanvraagstatusShape> a shacl:NodeShape;
