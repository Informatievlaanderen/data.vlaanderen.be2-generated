<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#VastgoedShape> a shacl:NodeShape;
  rdfs:label "Vastgoed"@nl;
  rdfs:comment "Vastgoed is de grond en de gebouwen (opstal) op deze grond."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "perceel"@nl;
    rdfs:comment "Een onroerend goed of onroerend recht dat in hoofde van één of meerdere titularissen van een zakelijk recht onderworpen is aan een bepaald eigendomsstatuut."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Vastgoed.Perceel>;
    shacl:class <https://data.vlaanderen.be/ns/perceel#KadastraalPatrimoniumperceel>;
    shacl:description "Een onroerend goed of onroerend recht dat in hoofde van één of meerdere titularissen van een zakelijk recht onderworpen is aan een bepaald eigendomsstatuut."@nl;
    shacl:name "perceel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#perceel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "functioneelEigenaar"@nl;
    <http://purl.org/vocab/vann/usageNote> "e.g. De Vlaamse MilieuMaatschappij is functioneel eigenaar van een eigendom (vastgoed) van de Vlaamse Overheid."@nl;
    rdfs:comment "De rechthebbende aan ie een zakelijk recht toebehoort om gebruik te maken van het eigendom (vastgoed) van een andere rechthebbende."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vastgoed/ontwerpstandaard/toolchain4#Vastgoed.Functioneeleigenaar>;
    shacl:class dc:Agent;
    shacl:description "De rechthebbende aan ie een zakelijk recht toebehoort om gebruik te maken van het eigendom (vastgoed) van een andere rechthebbende."@nl;
    shacl:name "functioneelEigenaar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#functioneelEigenaar>
  ], [
