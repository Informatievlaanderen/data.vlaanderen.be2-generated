    shacl:description "Een onroerend goed of onroerend recht dat in hoofde van één of meerdere titularissen van een zakelijk recht onderworpen is aan een bepaald eigendomsstatuut."@nl;
    shacl:name "perceel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#perceel>
  ], [
