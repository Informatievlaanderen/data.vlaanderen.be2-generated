    shacl:description "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid, een ligplaats, een standplaats of een perceel op basis van een gemeentenaam, een straatnaam, een huisnummer en eventueel een busnummer en een postcode."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <https://data.vlaanderen.be/ns/vastgoed#adres>
