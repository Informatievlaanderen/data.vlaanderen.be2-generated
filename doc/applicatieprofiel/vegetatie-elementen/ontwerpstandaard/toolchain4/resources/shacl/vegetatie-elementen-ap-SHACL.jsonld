  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#LeiboomShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een leiboom is een boom waarvan alle gesteltakken in één verticaal vlak worden geleid. Soms worden de geleide bomen tegen een muur geleid of wordt er in een leidconstructie voorzien."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Leiboom"
      }
    ],
