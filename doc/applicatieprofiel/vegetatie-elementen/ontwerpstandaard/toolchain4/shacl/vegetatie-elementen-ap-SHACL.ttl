    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#oppervlakte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volume"@nl;
    rdfs:comment "De inhoud of grootte van het object in de ruimte in kubieke meter."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Plantbakvorm.Volume>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "De inhoud of grootte van het object in de ruimte in kubieke meter."@nl;
    shacl:maxCount "1";
    shacl:name "volume"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#volume>
  ], [
