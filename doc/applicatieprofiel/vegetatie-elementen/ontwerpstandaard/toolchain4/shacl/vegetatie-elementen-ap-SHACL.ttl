    shacl:maxCount "1";
    shacl:name "eenheid"@nl;
    shacl:path schemas:unitText
  ], [
    a shacl:PropertyShape;
    rdfs:label "standaard eenheid"@nl;
    rdfs:comment "De gestandaardiseerde eenheid waarin de waarde is uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#KwantitatieveWaarde.StandaardEenheid>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#StandaardEenheid>;
    shacl:description "De gestandaardiseerde eenheid waarin de waarde is uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:name "standaard eenheid"@nl;
    shacl:path schemas:unitCode
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#KwantitatieveWaarde.Waarde>;
    shacl:class schemas:Number;
    shacl:description "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ];
  shacl:targetClass schemas:QuantitativeValue .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#LeiboomShape> a shacl:NodeShape;
  rdfs:label "Leiboom"@nl;
  rdfs:comment "Een leiboom is een boom waarvan alle gesteltakken in één verticaal vlak worden geleid. Soms worden de geleide bomen tegen een muur geleid of wordt er in een leidconstructie voorzien."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#Leiboom> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#MuurvegetatieShape> a shacl:NodeShape;
  rdfs:label "Muurvegetatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Definitie naar Ecopedia."@nl;
  rdfs:comment "Muurvegetaties zijn gebonden aan door de mens gecreëerde stenige, doorgaans steile tot verticale standplaatsen. Voorbeelden zijn kerkhofmuren, stadswallen, ruïnes, kademuren, oude forten en bunkers."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#Muurvegetatie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#NauwkeurigheidsklassenShape> a shacl:NodeShape;
  rdfs:label "Nauwkeurigheidsklassen"@nl;
  rdfs:comment "De nauwkeurigheid waarmee objecten opgemeten worden hangt af van de meetmethode (terrestrisch of via luchtfotogrammetrie) en van de precisie waarmee objecten op het terrein kunnen aangeduid worden. Het GRB definieert 6 nauwkeurigheidsklassen van A tot en met F. Daarnaast werden op basis van het IMKL datamodel ook nog de waarden 'tot 50cm' en 'tot 100cm' opgenomen."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Niet-zelfhechtendeKlimvormShape> a shacl:NodeShape;
  rdfs:label "Niet-zelfhechtende klimvorm"@nl;
  <http://purl.org/vocab/vann/usageNote> "Definitie vrij naar Ecopedia: https://www.ecopedia.be/encyclopedie/groene-gevel"@nl;
  rdfs:comment "Planten die niet zelf hechten hebben en een draagstructuur nodig hebben. Het zijn slingerende soorten zoals kamperfoelie of hop. De draagstructuur kan tegen de gevel worden geplaatst of op een bepaalde afstand."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#NietZelfhechtendeKlimvorm> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#OpgaandeBoomShape> a shacl:NodeShape;
  rdfs:label "Opgaande boom"@nl;
  rdfs:comment "Een opgaande boom is een boom waarvan de vorm van de kruin overeenkomt met zijn natuurlijke, soortgebonden habitus. Opgaande bomen kunnen een hoge, lage, brede, smalle of een afwijkende groeivorm hebben, zoals zuil- en treurvormen. De boom kan zich op volstrekt natuurlijke wijze uitgezaaid hebben en zijn groeivorm kan bepaald zijn door de natuurlijke groeiomstandigheden (bv. natuurlijke snoei). Ontstond de boom in kunstmatige omstandigheden, dan is de groeivorm bepaald door de jeugdsnoei in de kwekerij en is het eindbeeld van de boom bepaald door de begeleidingssnoei die wordt uitgevoerd vanaf het planten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "vrij uitgroeiend"@nl;
    rdfs:comment "Geeft aan of de vegetatie of begroeiing al dan niet snoei vereist."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#OpgaandeBoom.VrijUitgroeiend>;
    shacl:datatype xsd:boolean;
    shacl:description "Geeft aan of de vegetatie of begroeiing al dan niet snoei vereist."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "vrij uitgroeiend"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#vrijUitgroeiend>
  ], [
    a shacl:PropertyShape;
    rdfs:label "takvrije stamlengte"@nl;
    <http://purl.org/vocab/vann/usageNote> "Definitie vrij naar Ecopedia: https://www.ecopedia.be/encyclopedie/begeleidingssnoei-bij-bomen"@nl;
    rdfs:comment "De lengte in meters, gemeten vanop het aardoppervlak, van het gedeelte van de stam dat takvrij dient gehouden te worden. Alle takken die lager zitten dan de uiteindelijke takvrije stamlengte behoren tot de tijdelijke kroon en zullen gesnoeid worden in verschillende fasen gespreid over verschillende jaren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#OpgaandeBoom.TakvrijeStamlengte>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "De lengte in meters, gemeten vanop het aardoppervlak, van het gedeelte van de stam dat takvrij dient gehouden te worden. Alle takken die lager zitten dan de uiteindelijke takvrije stamlengte behoren tot de tijdelijke kroon en zullen gesnoeid worden in verschillende fasen gespreid over verschillende jaren."@nl;
    shacl:maxCount "1";
    shacl:name "takvrije stamlengte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#takvrijeStamlengte>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#OpgaandeBoom> .

