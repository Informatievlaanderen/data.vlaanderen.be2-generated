  rdfs:label "Boolean";
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#BoomConditiewaardeShape> a shacl:NodeShape;
  rdfs:label "Boom Conditiewaarde"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#BoomvormShape> a shacl:NodeShape;
  rdfs:label "Boomvorm"@nl;
  rdfs:comment "Individueel te onderscheiden vegetatie-element. Een boom is een overblijvende plant met een verhoute stam en een kroon (kruin)."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "boomrooster"@nl;
    <http://purl.org/vocab/vann/usageNote> "Geeft aan of een boomrooster al dan niet aanwezig is."@nl;
    rdfs:comment "Een horizontale structuur die zorgt voor een adequate bescherming van bomen tegen betreding van de boomspiegel door voetgangers of verkeer. Bijkomend zorgen boomroosters voor veiligheid van vooral voetgangers en fietsers doordat het maaiveld rondom de bomen gelijk blijft met de rest van de verharding waarin ze gelegen zijn."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Boomvorm.Boomrooster>;
    shacl:datatype xsd:boolean;
    shacl:description "Een horizontale structuur die zorgt voor een adequate bescherming van bomen tegen betreding van de boomspiegel door voetgangers of verkeer. Bijkomend zorgen boomroosters voor veiligheid van vooral voetgangers en fietsers doordat het maaiveld rondom de bomen gelijk blijft met de rest van de verharding waarin ze gelegen zijn."@nl;
    shacl:maxCount "1";
    shacl:name "boomrooster"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#boomrooster>
  ], [
    a shacl:PropertyShape;
    rdfs:label "boomplaat"@nl;
    <http://purl.org/vocab/vann/usageNote> "Geeft aan of een boomplaat al dan niet aanwezig is. Naar AWV SB250."@nl;
    rdfs:comment "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden. Boomplaten die aangewend worden voor bomen beschikken over extra openingen in de plaat voor het aanbrengen van een boompalen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Boomvorm.Boomplaat>;
    shacl:datatype xsd:boolean;
    shacl:description "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden. Boomplaten die aangewend worden voor bomen beschikken over extra openingen in de plaat voor het aanbrengen van een boompalen."@nl;
    shacl:maxCount "1";
    shacl:name "boomplaat"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#boomplaat>
  ], [
    a shacl:PropertyShape;
    rdfs:label "markant element"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voor de invulling van dit attribuut verwijzen we naar de taxonomie voor houtige beplanting van de erfgoedtypes thesaurus van Onroerend Erfgoed."@nl;
    rdfs:comment "Een kenmerk van een boom waardoor deze zich onderscheidt van andere bomen van dezelfde soort. Bijvoorbeeld door een bepaalde erfgoedwaarde."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Boomvorm.MarkantElement>;
    shacl:class skos:Concept;
    shacl:description "Een kenmerk van een boom waardoor deze zich onderscheidt van andere bomen van dezelfde soort. Bijvoorbeeld door een bepaalde erfgoedwaarde."@nl;
    shacl:name "markant element"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#markantElement>
  ], [
    a shacl:PropertyShape;
    rdfs:label "groeifase"@nl;
    <http://purl.org/vocab/vann/usageNote> "De mogelijke types zijn gedefinieerd vanuit Inverde."@nl;
    rdfs:comment "De levensfase van een Boomvorm."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Boomvorm.Groeifase>;
    shacl:class skos:Concept;
    shacl:description "De levensfase van een Boomvorm."@nl;
    shacl:maxCount "1";
    shacl:name "groeifase"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#groeifase>
  ], [
    a shacl:PropertyShape;
    rdfs:label "conditiebeoordeling"@nl;
    rdfs:comment "De conditie beoordeeld volgens de kronenstructuur van Dr. A. Roloff, gelet op de scheutlengte ontwikkeling en vorming van dood hout."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Boomvorm.Conditiebeoordeling>;
    shacl:class skos:Concept;
    shacl:description "De conditie beoordeeld volgens de kronenstructuur van Dr. A. Roloff, gelet op de scheutlengte ontwikkeling en vorming van dood hout."@nl;
    shacl:maxCount "1";
    shacl:name "conditiebeoordeling"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#conditiebeoordeling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "conditiewaarde"@nl;
    <http://purl.org/vocab/vann/usageNote> "De conditiewaarde is te gebruiken in de context van de waardebepaling van bomen zoals vooropgesteld door de vereniging voor openbaar groen: http://www.vvog.info/default.asp?page=47"@nl;
    rdfs:comment "De conditiewaarde van een boom is een coëfficiënt die iets vertelt over de gezondheidstoestand (vitaliteit, conditie) en de levensverwachting van een boom. Een dode boom heeft een conditiewaarde nul. Een kerngezonde boom met zeer hoge levensverwachting heeft een conditiewaarde 1."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Boomvorm.Conditiewaarde>;
    shacl:class skos:Concept;
    shacl:description "De conditiewaarde van een boom is een coëfficiënt die iets vertelt over de gezondheidstoestand (vitaliteit, conditie) en de levensverwachting van een boom. Een dode boom heeft een conditiewaarde nul. Een kerngezonde boom met zeer hoge levensverwachting heeft een conditiewaarde 1."@nl;
    shacl:maxCount "1";
    shacl:name "conditiewaarde"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#conditiewaarde>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vrije doorrijhoogte"@nl;
    rdfs:comment "Vrij te houden hoogte, voor het doorrijden van verkeer toe te laten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Boomvorm.VrijeDoorrijhoogte>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Vrij te houden hoogte, voor het doorrijden van verkeer toe te laten."@nl;
    shacl:maxCount "1";
    shacl:name "vrije doorrijhoogte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#vrijeDoorrijhoogte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "kroondiameter"@nl;
    rdfs:comment "Diameter van de kroonprojectie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Boomvorm.Kroondiameter>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Diameter van de kroonprojectie."@nl;
    shacl:maxCount "1";
    shacl:name "kroondiameter"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#kroondiameter>
  ], [
    a shacl:PropertyShape;
    rdfs:label "stamomtrek"@nl;
    rdfs:comment "Stamomtrek, gemeten vanaf 1 meter boven de grond."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#Boomvorm.Stamomtrek>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Stamomtrek, gemeten vanaf 1 meter boven de grond."@nl;
    shacl:maxCount "1";
    shacl:name "stamomtrek"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#stamomtrek>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#Boomvorm> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#BoomvormconditieklassenShape> a shacl:NodeShape;
