<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#BegroeidVoorkomenShape> a shacl:NodeShape;
  rdfs:label "Begroeid voorkomen"@nl;
  rdfs:comment "De ruimtelijke massa van planten-individuen, in samenhang met de plaats waar zij groeien."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "soortnaam Nederlands"@nl;
    rdfs:comment "Soortnaam in het Nederlands."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#BegroeidVoorkomen.SoortnaamNederlands>;
    shacl:datatype rdf:langString;
    shacl:description "Soortnaam in het Nederlands."@nl;
    shacl:name "soortnaam Nederlands"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#soortnaamNederlands>
  ], [
    a shacl:PropertyShape;
    rdfs:label "soortcode"@nl;
    <http://purl.org/vocab/vann/usageNote> "De soortcode wordt opgenomen onder de vorm van de 'GBIF Key'."@nl;
    rdfs:comment "Een unieke identificator voor de soort van het vegetatie-element."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#BegroeidVoorkomen.Soortcode>;
    shacl:class skos:Concept;
    shacl:description "Een unieke identificator voor de soort van het vegetatie-element."@nl;
    shacl:name "soortcode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#soortcode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "drassigheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "De drassigheid geeft hierbij aan in welke mate de normale werking van types machines zou kunnen verstoord worden."@nl;
    rdfs:comment "Mate waarin de bodem verzadigd is met water."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#BegroeidVoorkomen.Drassigheid>;
    shacl:class skos:Concept;
    shacl:description "Mate waarin de bodem verzadigd is met water."@nl;
    shacl:maxCount "1";
    shacl:name "drassigheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#drassigheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wetenschappelijke soortnaam"@nl;
    rdfs:comment "De wetenschappelijke soortnaam."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#BegroeidVoorkomen.WetenschappelijkeSoortnaam>;
    shacl:class skos:Concept;
    shacl:description "De wetenschappelijke soortnaam."@nl;
    shacl:name "wetenschappelijke soortnaam"@nl;
    shacl:path dwc:scientificName
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorkomen"@nl;
    rdfs:comment "Verwijst naar het voorkomen van de plantbakvorm."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#BegroeidVoorkomen.Voorkomen>;
    shacl:class <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#Plantbakvorm>;
    shacl:description "Verwijst naar het voorkomen van de plantbakvorm."@nl;
    shacl:name "voorkomen"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#BegroeidVoorkomen.voorkomen>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/begroeidvoorkomen#BegroeidVoorkomen> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#BloemenmandShape> a shacl:NodeShape;
  rdfs:label "Bloemenmand"@nl;
  rdfs:comment "Plantbak die doelbewust verhoogd opgehangen wordt."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#Bloemenmand> .

