<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#GekandelaardeBoomShape> a shacl:NodeShape;
  rdfs:label "Gekandelaarde boom"@nl;
  rdfs:comment "Een gekandelaarde boom is een boom waarvan alle gesteltakken op een bepaalde lengte worden afgezet en die hierop opnieuw uitlopen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#GekandelaardeBoom> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#GeschorenBoomShape> a shacl:NodeShape;
  rdfs:label "Geschoren boom"@nl;
  <http://purl.org/vocab/vann/usageNote> "Definitie naar begrippenlijst landschap van Vlaams agentschap Onroerend Erfgoed."@nl;
  rdfs:comment "Bomen waarvan de kruinen zijn geschoren. De vorm werd bepaald bij de eerste vormsnoei van de gesteltakken en werd uitgevoerd op jonge bomen. Het beheer wordt uitgevoerd in periodieke scheerbeurten, één of meerdere keren per jaar."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/vegetatie#GeschorenBoom> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#GroeifasenShape> a shacl:NodeShape;
  rdfs:label "Groeifasen"@nl;
  rdfs:comment "De levensfase van een boom. De mogelijke types zijn gedefinieerd door Inverde."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vegetatie-elementen/ontwerpstandaard/toolchain4#IntegerShape> a shacl:NodeShape;
