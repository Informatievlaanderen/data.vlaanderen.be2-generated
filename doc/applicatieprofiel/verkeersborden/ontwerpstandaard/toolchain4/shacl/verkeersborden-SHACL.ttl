<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#AfsluitingShape> a shacl:NodeShape;
  rdfs:label "Afsluiting"@nl;
  rdfs:comment "Op het terrein ondubbelzinnig aanwijsbare en permanent verankerde scheiding."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Afsluiting> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#ArtikelWegcodeShape> a shacl:NodeShape;
  rdfs:label "Artikel wegcode"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: artikel 12.1 Verkeersborden F1, F1a of F1b..."@nl;
  rdfs:comment "Artikel met meer uitleg over een specifiek type verkeersbord."@nl;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/eli/ontology#LegalResourceSubdivision> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#BestendigeAfsluitingShape> a shacl:NodeShape;
  rdfs:label "Bestendige afsluiting"@nl;
  rdfs:comment "Op het terrein ondubbelzinnig aanwijsbare en permanent verankerde scheiding die statisch is in vorm en geen doorgang toelaat."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#BestendigeAfsluiting> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#BevestigingShape> a shacl:NodeShape;
  rdfs:label "Bevestiging"@nl;
  rdfs:comment "Het montage-element dat een verkeersbord bevestigt aan een infrastructuurelement."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "conform standaard"@nl;
    rdfs:comment "Tot welke standaard deze bevestiging conform is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#Bevestiging.ConformStandaard>;
    shacl:class skos:Concept;
    shacl:description "Tot welke standaard deze bevestiging conform is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "conform standaard"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#conformStandaard>
  ], [
    a shacl:PropertyShape;
    rdfs:label "montagetype"@nl;
    rdfs:comment "Waarmee de bevestiging gemonteerd is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#Bevestiging.Montagetype>;
    shacl:class skos:Concept;
    shacl:description "Waarmee de bevestiging gemonteerd is."@nl;
    shacl:maxCount "1";
    shacl:name "montagetype"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "Bevestiging.RetroreflecterendVerkeersbord";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#Bevestiging.Bevestiging.retroreflecterendverkeersbord>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit#RetroreflecterendVerkeersbord>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Bevestiging.RetroreflecterendVerkeersbord";
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#Bevestiging.RetroreflecterendVerkeersbord>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Bevestiging.DraagconstructieRetroreflecterendeVerkeersborden";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#Bevestiging.Bevestiging.draagconstructieretroreflecterendeverkeersborden>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit#DraagconstructieRetroreflecterendeVerkeersborden>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Bevestiging.DraagconstructieRetroreflecterendeVerkeersborden";
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#Bevestiging.DraagconstructieRetroreflecterendeVerkeersborden>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit#Bevestiging> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#BooleanShape> a shacl:NodeShape;
  rdfs:label "Boolean";
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#BorstweringShape> a shacl:NodeShape;
  rdfs:label "Borstwering"@nl;
  rdfs:comment "Hekwerk of constructie (balustrade, 'omega'-profielen,...) die geplaatst werd met het oog op de veiligheid van de zwakke weggebruiker, overwegend parallel aan de hartlijn van de wegbaan georiënteerd"@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Borstwering> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#ConceptShape> a shacl:NodeShape;
  rdfs:label "Concept"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#DraadafsluitingShape> a shacl:NodeShape;
  rdfs:label "Draadafsluiting"@nl;
  rdfs:comment "Op het terrein ondubbelzinnig aanwijsbare en permanent verankerde scheiding, bestaande uit draad."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Draadafsluiting> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#DraagconstructieRetroreflecterendeVerkeersbordenShape> a shacl:NodeShape;
  rdfs:label "Draagconstructie retroreflecterende verkeersborden"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze draagconstructie verschilt van de draagconstructies voor inwendig verlichte en dynamische verkeersborden."@nl;
  rdfs:comment "Constructie die geschikt is om retroreflecterende verkeersborden aan op te hangen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beheerder"@nl;
    <http://purl.org/vocab/vann/usageNote> "Instantie tot op team- of dienstniveau"@nl;
    rdfs:comment "Instantie tot op team- of dienstniveau die instaat voor het beheer van het object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#DraagconstructieRetroreflecterendeVerkeersborden.Beheerder>;
    shacl:class org:Organization;
    shacl:description "Instantie tot op team- of dienstniveau die instaat voor het beheer van het object."@nl;
    shacl:maxCount "1";
    shacl:name "beheerder"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#beheerder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "kleur"@nl;
    rdfs:comment "Kleur van de draagconstructie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#DraagconstructieRetroreflecterendeVerkeersborden.Kleur>;
    shacl:class skos:Concept;
    shacl:description "Kleur van de draagconstructie."@nl;
    shacl:maxCount "1";
    shacl:name "kleur"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#kleur>
  ], [
    a shacl:PropertyShape;
    rdfs:label "leverancier"@nl;
    <http://purl.org/vocab/vann/usageNote> "Enkel te gebruiken wanneer het object een infrastructuurelement is."@nl;
    rdfs:comment "Agent die de draagconstructie aanlevert."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#DraagconstructieRetroreflecterendeVerkeersborden.Leverancier>;
    shacl:class dc:Agent;
    shacl:description "Agent die de draagconstructie aanlevert."@nl;
    shacl:maxCount "1";
    shacl:name "leverancier"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#leverancier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "materiaal"@nl;
    rdfs:comment "Materiaal waaruit de draagconstructie voor retroreflecterende verkeersborden is uit opgebouwd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#DraagconstructieRetroreflecterendeVerkeersborden.Materiaal>;
    shacl:class skos:Concept;
    shacl:description "Materiaal waaruit de draagconstructie voor retroreflecterende verkeersborden is uit opgebouwd."@nl;
    shacl:name "materiaal"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#materiaal>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is opgehangen aan"@nl;
    rdfs:comment "Waaraan het verkeersbord is opgehangen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#DraagconstructieRetroreflecterendeVerkeersborden.IsOpgehangenAan>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit#RetroreflecterendVerkeersbord>;
    shacl:description "Waaraan het verkeersbord is opgehangen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is opgehangen aan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#DraagconstructieRetroreflecterendeVerkeersborden.isOpgehangenAan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "RetroreflecterendVerkeersbord.Bevestiging";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#DraagconstructieRetroreflecterendeVerkeersborden.Retroreflecterendverkeersbord.bevestiging>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit#Bevestiging>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "RetroreflecterendVerkeersbord.Bevestiging";
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit#RetroreflecterendVerkeersbord.Bevestiging>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit#DraagconstructieRetroreflecterendeVerkeersborden> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#DraagconstructieVerkeersbordenShape> a shacl:NodeShape;
  rdfs:label "Draagconstructie verkeersborden"@nl;
  rdfs:comment "Stabiele voorziening waaraan een verkeersbord opgehangen kan worden."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit#DraagconstructieVerkeersborden> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#ElektriciteitspaalShape> a shacl:NodeShape;
  rdfs:label "Elektriciteitspaal"@nl;
  rdfs:comment "Paal van de elektriciteitsleiding."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Elektriciteitspaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#FietsstallingShape> a shacl:NodeShape;
  rdfs:label "Fietsstalling"@nl;
  rdfs:comment "Een fietsstalling is het geheel aan palen en/of verankeringspunten van een constructie bestemd voor het vastmaken van fietsen, gelegen op het openbare domein."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Fietsstalling> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#FietstelpaalShape> a shacl:NodeShape;
  rdfs:label "Fietstelpaal"@nl;
  rdfs:comment "Paal die automatisch voorbij passerende fietsers telt."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Fietstelpaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#FlitspaalShape> a shacl:NodeShape;
  rdfs:label "Flitspaal"@nl;
  rdfs:comment "Een meettoestel waarmee snelheidsovertredingen en/of het negeren van een rood verkeerslicht vastgesteld kunnen worden."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Flitspaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#GalgsteunShape> a shacl:NodeShape;
  rdfs:label "Galgsteun"@nl;
  rdfs:comment "Elke overspanning van een gedeelte van de wegbaan, watergang of spoorbaan waarbij slechts aan één kant gesteund wordt waarbij signalisatieborden werden aangebracht."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit#OSLO-OpenbaarDomein::Galgsteun> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#GeluidschermShape> a shacl:NodeShape;
  rdfs:label "Geluidscherm"@nl;
  rdfs:comment "Geluidswerende wand langs autosnelwegen, spoorwegen... met als doel de omwonende tegen geluidshinder te beschermen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Geluidscherm> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#KnipperlichtShape> a shacl:NodeShape;
  rdfs:label "Knipperlicht"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een verkeersbord wordt opgehangen aan de paal van het knipperlicht en niet aan het licht zelf."@nl;
  rdfs:comment "Oranje, wit of rood knipperlicht op een paal, dat dienst doet als verkeersignaal op wegen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Knipperlicht> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#MobiliteitsmaatregelShape> a shacl:NodeShape;
  rdfs:label "Mobiliteitsmaatregel"@nl;
  rdfs:comment "Maatregel om de beweging en verplaatsing van de weggebruiker op het openbaar domein of privé domein met openbaar karakter te organiseren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "wordt aangeduid door"@nl;
    <http://purl.org/vocab/vann/usageNote> "Mobiliteitsmaatregel wordt beschreven in een artikel van een aanvullend of tijdelijk wegreglement."@nl;
