    a shacl:PropertyShape;
    rdfs:label "verkeersbordcode"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: F1"@nl;
    rdfs:comment "Code die aan dit soort bord gegeven wordt binnen de wegcode."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersborden/ontwerpstandaard/toolchain4#Verkeersbordconcept.Verkeersbordcode>;
    shacl:datatype xsd:string;
    shacl:description "Code die aan dit soort bord gegeven wordt binnen de wegcode."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "verkeersbordcode"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "betekenis"@nl;
