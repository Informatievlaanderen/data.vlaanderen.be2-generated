  shacl:targetClass <http://def.isotc211.org/iso19115/2006/MetadataEntitySetInformation#MD_Metadata> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#MomentShape> a shacl:NodeShape;
  rdfs:label "Moment"@nl;
  <http://purl.org/vocab/vann/usageNote> "Vergelijkbaar met een Punt in de ruimte, maar ipv een positie in een ruimtelijk referentiesysteem gaat het hier over een punt op de tijdsas. OPMERKING: Meer info in de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a>."@nl;
  rdfs:comment "Een 0-dimensionele geometrische primitieve in de tijd."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Instant> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#NetwerkelementShape> a shacl:NodeShape;
  rdfs:label "Netwerkelement"@nl;
