    shacl:description "Taal waarin de data zijn gesteld."@nl;
    shacl:name "taal"@nl;
    shacl:path dc11:language
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de data."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Metadata.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de data."@nl;
    shacl:name "type"@nl;
    shacl:path dc11:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgever"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv een persoon, organisatie of service. Te substitueren door een instantie ve subklasse van Agent, bvb een Persoon of Organisatie zoals resp beschreven door <a href=\"https://data.vlaanderen.be/standaarden/erkende-standaard/vocabularium-persoon.html\">OSLO-Persoon</a> en <a href=\"https://data.vlaanderen.be/standaarden/kandidaat-standaard/applicatieprofiel-organisatie-basis.html\">OSLO-Organisatie</a>."@nl;
    rdfs:comment "Referentie naar de entiteit verantwoordelijk voor het publiek maken van de data."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Metadata.Uitgever>;
    shacl:class dc:Agent;
    shacl:description "Referentie naar de entiteit verantwoordelijk voor het publiek maken van de data."@nl;
    shacl:name "uitgever"@nl;
