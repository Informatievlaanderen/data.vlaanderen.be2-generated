  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Netwerkreferentie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#ObjectShape> a shacl:NodeShape;
  rdfs:label "Object"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de context van Verkeersmetingen is dit het Object waarvan een kenmerk wordt geobserveerd. Dat kan een real-world Domeinobject zijn of een benadering daarvan door een Bemonsteringsobject. OPGELET: deze klasse is abstract, gebruik de subklassen."@nl;
  rdfs:comment "Klasse die instanties van om het even welk type vertegenwoordigt."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/GeneralFeatureInstance#GFI_Feature> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#ObservatieShape> a shacl:NodeShape;
  rdfs:label "Observatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het gaat om schattingen van de waarde, maw op de waarde zit een zekere foutmarge. Voorbeelden zijn temperatuur, klasse, kleur. Dit is verschillend van waarden die zijn toegekend en dus geen schattingen zijn zoals naam of prijs. OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensoren en Bemonstering</a>."@nl;
  rdfs:comment "Het vaststellen van de waarde van een bepaald kenmerk van een Object op een bepaald tijdstip of tussen twee tijdstippen."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#ObservatieprocedureShape> a shacl:NodeShape;
  rdfs:label "Observatieprocedure"@nl;
  <http://purl.org/vocab/vann/usageNote> "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bv de correcte plaatsing van een windmeter (op een welbepaalde hoogte boven het grondoppervlak, bv 10m voor meteorologische waarnemingen). De procedures zijn doorgaans bedoeld om bij meer dan één Bemonstering te worden toegepast."@nl;
  rdfs:comment "Een workflow, protocol, plan, algoritme of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "specificatie"@nl;
    rdfs:comment "Verwijzing naar een document dat de Observatieprocedure beschrijft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Observatieprocedure.Specificatie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Verwijzing naar een document dat de Observatieprocedure beschrijft."@nl;
    shacl:name "specificatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/sensoren-en-bemonstering#Observatieprocedure.specificatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "input"@nl;
    rdfs:comment "Verwijzing naar de Input die de procedure vereist."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Observatieprocedure.Input>;
    shacl:class <http://www.w3.org/ns/ssn/Input>;
    shacl:description "Verwijzing naar de Input die de procedure vereist."@nl;
    shacl:name "input"@nl;
    shacl:path <http://www.w3.org/ns/ssn/hasInput>
  ], [
    a shacl:PropertyShape;
    rdfs:label "output"@nl;
    rdfs:comment "Verwijzing naar de Output die de Procedure genereert."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Observatieprocedure.Output>;
    shacl:class <http://www.w3.org/ns/ssn/Output>;
    shacl:description "Verwijzing naar de Output die de Procedure genereert."@nl;
    shacl:name "output"@nl;
    shacl:path <http://www.w3.org/ns/ssn/hasOutput>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de Observatieprocedure."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Observatieprocedure.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de Observatieprocedure."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "geïmplementeerdMet"@nl;
    rdfs:comment "Sensor waarmee de Observatieprocedure is of moet worden uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Observatieprocedure.Geïmplementeerdmet>;
    shacl:class <http://www.w3.org/ns/sosa/Sensor>;
    shacl:description "Sensor waarmee de Observatieprocedure is of moet worden uitgevoerd."@nl;
    shacl:name "geïmplementeerdMet"@nl;
    shacl:path <http://www.w3.org/ns/ssn/implementedBy>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Procedure> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#ObservatieproceduretypeShape> a shacl:NodeShape;
  rdfs:label "Observatieproceduretype"@nl;
  rdfs:comment "Type Obeservatieprocedure."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#ObservatieverzamelingShape> a shacl:NodeShape;
  rdfs:label "Observatieverzameling"@nl;
  <http://purl.org/vocab/vann/usageNote> """Bv Observaties die op hetzelfde tijdstip plaatsvonden of hetzelfde Object observeren of door dezelfde Sensor zijn gemaakt.
OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensoren en Bemonstering</a>."""@nl;
  rdfs:comment "Collectie van Observaties met dezelfde kenmerken."@nl;
  shacl:closed false;
  shacl:targetClass <https://www.w3.org/TR/vocab-ssn-ext/#sosa:ObservationCollection> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#OutputShape> a shacl:NodeShape;
  rdfs:label "Output"@nl;
  rdfs:comment "Informatie die door een Procedure wordt gegenereerd."@nl;
  shacl:closed false;
