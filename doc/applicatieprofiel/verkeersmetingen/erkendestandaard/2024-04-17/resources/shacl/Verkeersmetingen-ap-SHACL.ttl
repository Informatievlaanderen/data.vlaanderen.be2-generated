  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Netwerkelement> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#NetwerkreferentieShape> a shacl:NodeShape;
  rdfs:label "Netwerkreferentie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb het Wegsegment waarlangs er straatverlichting is, de Wegknoop met verkeerslichten etc."@nl;
  rdfs:comment "Verwijzing naar het Netwerkelement waarvoor de Netwerkeigenschap geldt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "element"@nl;
