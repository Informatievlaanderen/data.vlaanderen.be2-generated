    shacl:description "Geeft aan of de GerichteLink de oorspronkelijke richting van de Link volgt of niet (positief indien gelijklopend, negatief indien tegengesteld)."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "richting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#richting>
  ], [
    a shacl:PropertyShape;
    rdfs:label "link"@nl;
    rdfs:comment "Verwijzing naar de oorspronkelijke Link."@nl;
