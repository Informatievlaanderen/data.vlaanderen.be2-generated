    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <http://www.w3.org/ns/ssn/Output> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#PlatformShape> a shacl:NodeShape;
  rdfs:label "Platform"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze andere entiteiten zijn typisch Sensoren, Bemonsteraars, Actuators of andere Platformen. In de context van Verkeersmetingen definiëren we de subklasse Toestel als mogelijke basis voor één of meer Sensoren. OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensoren en Bemonstering</a>."@nl;
  rdfs:comment "Entiteit die fungeert als basis voor andere Entiteiten."@nl;
  shacl:closed false;
  shacl:targetClass <https://www.w3.org/ns/sosa/Platform> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#ProcedureShape> a shacl:NodeShape;
  rdfs:label "Procedure"@nl;
  <http://purl.org/vocab/vann/usageNote> "Slaat op de manier waarop Observaties of Bemonstering worden uitgevoerd of Actuators worden bediend. Neemt in praktijk de vorm aan van een workflow, protocol, plan, algoritme,berekeningswijze etc. OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensoren en Bemonstering</a>."@nl;
  rdfs:comment "Vastgelegde of officiële manier om iets te doen."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/sosa/Procedure> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#PuntShape> a shacl:NodeShape;
  rdfs:label "Punt"@nl;
  rdfs:comment "Een 0-dimensioneel geometrisch object dat een bepaalde locatie in een coördinaatruimte voorstelt. Heeft een x-coördinaat en een y-coördinaat. Kan ook een z-coördinaat (hoogte) en een m-coördinaat (afstand langs een curve) hebben."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#Point> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#PuntreferentieShape> a shacl:NodeShape;
  rdfs:label "Puntreferentie"@nl;
  rdfs:comment "Netwerkreferentie beperkt tot een punt langs de Link of Linksequentie waarnaar ze verwijst."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "opPositie"@nl;
    rdfs:comment "Afstand vanaf het begin van de Link of Linksequentie tot het punt waar de Netwerkeigenschap geldt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Puntreferentie.Oppositie>;
    shacl:class <http://def.isotc211.org/iso19103/2015/MeasureTypes#Length>;
    shacl:description "Afstand vanaf het begin van de Link of Linksequentie tot het punt waar de Netwerkeigenschap geldt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "opPositie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#Puntreferentie.opPositie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Puntreferentie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#RijrichtingShape> a shacl:NodeShape;
  rdfs:label "Rijrichting"@nl;
  rdfs:comment "Richting waarin het verkeer zich over de weg beweegt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "netwerkreferentie"@nl;
    <http://purl.org/vocab/vann/usageNote> "In de context van dit applicatieprofiel is het Netwerkelement een Wegsegment of een Weglinksequentie. De Netwerkreferentie laat ook toe om Rijrichtingen te specifiëren voor slechts een stuk van de weg of voor één bepaalde wegkant."@nl;
    rdfs:comment "Verwijzing naar het Netwerkelement waarop de Rijrichting betrekking heeft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Rijrichting.Netwerkreferentie>;
    shacl:class <https://data.vlaanderen.be/ns/netwerk#Netwerkreferentie>;
    shacl:description "Verwijzing naar het Netwerkelement waarop de Rijrichting betrekking heeft."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "netwerkreferentie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#netwerkreferentie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rijrichting"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze wordt beschreven tov de richting van de geometrie van de weg: gelijklopend met of tegengesteld aan die richting. De richting van de geometrie wordt bepaald door de volgorde waarin de coördinaten op elkaar volgen."@nl;
    rdfs:comment "De rijrichting."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Rijrichting.Rijrichting>;
    shacl:class skos:Concept;
    shacl:description "De rijrichting."@nl;
    shacl:maxCount "1";
    shacl:name "rijrichting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#rijrichting>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#Rijrichting> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#RijstrookShape> a shacl:NodeShape;
  rdfs:label "Rijstrook"@nl;
  <http://purl.org/vocab/vann/usageNote> "Onder rijbaan verstaan we dat deel van de wegbaan ingericht om met een Voertuig over te rijden. Door de rijbaan op te splitsen krijgt men een meer gecontroleerde verkeersstroom, in de eerste plaats omdat de rijrichtingen of bvb doorgaand en afslaand verkeer gescheiden worden en ook door de breedte te beperken zodat er maar één Voertuig tegelijk doorkan. Rijstroken worden typisch afgebakend dmv wegmarkeringen, bvb een witte doorlopende of onderbroken streep. OPMERKING: Voetpaden of Fietspaden zijn geen Rijstroken aangezien ze niet bedoeld zijn om met een auto over te rijden en dus geen deel zijn van de rijbaan."@nl;
  rdfs:comment "In de langsrichting begrensd deel van de rijbaan, bedoeld om de verkeersstroom te geleiden in een bepaalde richting en met doorgaans de breedte van één Voertuig."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "netwerkreferentie"@nl;
    <http://purl.org/vocab/vann/usageNote> "In de context van dit applicatieprofiel is het Netwerkelement een Wegsegment of een Weglinksequentie. De Netwerkreferentie laat ook toe om Rijstroken te specifiëren voor slechts een stuk van de weg of voor één bepaalde wegkant."@nl;
    rdfs:comment "Verwijzing naar het Netwerkelement waarop de Rijstrook betrekking heeft."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Rijstrook.Netwerkreferentie>;
    shacl:class <https://data.vlaanderen.be/ns/netwerk#Netwerkreferentie>;
    shacl:description "Verwijzing naar het Netwerkelement waarop de Rijstrook betrekking heeft."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "netwerkreferentie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#netwerkreferentie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rijstrook"@nl;
    <http://purl.org/vocab/vann/usageNote> "De identificator moet getypeerd worden bvb volgens het systeem dat werd gehanteerd om de Rijstroken te nummeren. Bvb het schema van DATEX II waar over de volledige breedte van de weg van links naar rechts wordt genummerd."@nl;
    rdfs:comment "Identificator van de Rijstrook."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Rijstrook.Rijstrook>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van de Rijstrook."@nl;
    shacl:maxCount "1";
    shacl:name "rijstrook"@nl;
    shacl:path <https://data.vlaanderen.be/ns/verkeersmetingen#rijstrook>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rijstrooktype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb of het een afslagstrook is, een fietssuggestiestrook, een middenrijbaan etc."@nl;
    rdfs:comment "Aard vd Rijstrook."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Rijstrook.Rijstrooktype>;
    shacl:class skos:Concept;
    shacl:description "Aard vd Rijstrook."@nl;
    shacl:name "rijstrooktype"@nl;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/verkeersmetingen#Rijstrook> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#RijstrooktypeShape> a shacl:NodeShape;
  rdfs:label "Rijstrooktype"@nl;
  rdfs:comment "Type Rijstrook."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#SensorShape> a shacl:NodeShape;
  rdfs:label "Sensor"@nl;
  <http://purl.org/vocab/vann/usageNote> "Sensoren genereren een resultaat op basis van een Stimulus, ttz een verandering in de omgeving, of op basis van resultaten van andere Observaties. Ze worden typisch gehost door een Platform. Voorbeelden zijn snelheidsmeters, gyroscopen, barometers, magnetometers gemonteerd op een smart phone. Ook bv het menselijk oog kan beschouwd worden als een sensor."@nl;
  rdfs:comment "Toestel of Agent (incl Personen of software) waarmee Observaties gemaakt worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "ligging"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb de coördinaten of het adres of een verwijzing naar een meetpunt of ander Bemonsteringsobject. Meerdere verschillende types van locaties kunnen worden opgegeven (bvb adres èn coördinaten). Als de Sensor een meetinstallatie is evt de verschillende meetpunten die worden omvat of een omschrijvende polygoon. OPGELET: De locatie van de Sensor is niet noodzakelijk de positie waar de Observatie gebeurt, die wordt in de eerste plaats gegeven door de ligging vh Bemonsteringsobject of het Domeinobject. Dit attribuut laat vooral toe om posities van Sensoren te beschrijven los vd metingen die er gebeuren."@nl;
    rdfs:comment "Locatie van de Sensor."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Sensor.Ligging>;
    shacl:class prov:Location;
    shacl:description "Locatie van de Sensor."@nl;
    shacl:name "ligging"@nl;
    shacl:path <https://data.vlaanderen.be/ns/verkeersmetingen#ligging>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gehostDoor"@nl;
    <http://purl.org/vocab/vann/usageNote> "d!"@nl;
    rdfs:comment "Toestel waarop de Sensor gehost wordt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Sensor.Gehostdoor>;
    shacl:class <https://saref.etsi.org/core/Device>;
    shacl:description "Toestel waarop de Sensor gehost wordt."@nl;
    shacl:name "gehostDoor"@nl;
    shacl:path <http://www.w3.org/ns/sosa/isHostedBy>
  ], [
    a shacl:PropertyShape;
    rdfs:label "implementeert"@nl;
    rdfs:comment "Observatieprocedure die door de Sensor wordt toegepast."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Sensor.Implementeert>;
    shacl:class <http://www.w3.org/ns/sosa/Procedure>;
    shacl:description "Observatieprocedure die door de Sensor wordt toegepast."@nl;
    shacl:maxCount 1;
    shacl:name "implementeert"@nl;
    shacl:path <http://www.w3.org/ns/ssn/implements>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdeObservatie"@nl;
    rdfs:comment "Verkeersmeting die met de Sensor is uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Sensor.Uitgevoerdeobservatie>;
    shacl:class <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeting>;
    shacl:description "Verkeersmeting die met de Sensor is uitgevoerd."@nl;
    shacl:name "uitgevoerdeObservatie"@nl;
    shacl:path <http://todo.com/uitgevoerdeObservatie>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Sensor> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#SysteemShape> a shacl:NodeShape;
  rdfs:label "Systeem"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze componenten kunnen Systemen op zich zijn. Het zijn Systemen die een Observatieprocedure realiseren (typisch een Sensor) of waarmee een Bemonsteringsprocedure wordt uitgevoerd (bv een boorinstallatie) of het zijn Platformen zoals een Toestel waarop de sensor is gemonteerd. OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensoren en Bemonstering</a>."@nl;
  rdfs:comment "Samenhangend geheel van componenten die samen één of meer functies vervullen."@nl;
  shacl:closed false;
  shacl:targetClass <https://www.w3.org/TR/vocab-ssn/#ssn-system> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TaalcodeShape> a shacl:NodeShape;
  rdfs:label "Taalcode"@nl;
  rdfs:comment "Taal waarin de data zijn gesteld."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TekenShape> a shacl:NodeShape;
  rdfs:label "Teken"@nl;
  rdfs:comment "Aanduiding of een waarde negatief of positief is"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TemporeleentiteitShape> a shacl:NodeShape;
  rdfs:label "TemporeleEntiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Die temporele objecten zijn temporele geometrische primitieven zoals Moment of Periode. Of het zijn composieten van temporele primitieven, bv om de geschiedenis van een fenomeen weer te geven (bv de opeenvolgende Periodes dat het fenomeen zich voordeed). Te gebruiken wanneer de uiteindelijke temporele primitieve nog niet gekend is. OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bv time:TemporalEntity uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."@nl;
  rdfs:comment "Abstracte klasse voor temporele objecten."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Object> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#ToestelShape> a shacl:NodeShape;
  rdfs:label "Toestel"@nl;
  rdfs:comment "Tastbaar Object ontworpen om een specifieke Taak mee uit te voeren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "fabrikant"@nl;
    rdfs:comment "Naam van de fabrikant."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Toestel.Fabrikant>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van de fabrikant."@nl;
    shacl:maxCount "1";
    shacl:name "fabrikant"@nl;
    shacl:path <https://saref.etsi.org/core/hasManufacturer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "model"@nl;
    rdfs:comment "Naam vh model vh Toestel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Toestel.Model>;
    shacl:datatype rdf:langString;
    shacl:description "Naam vh model vh Toestel."@nl;
    shacl:maxCount "1";
    shacl:name "model"@nl;
    shacl:path <https://saref.etsi.org/core/hasModel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "functie"@nl;
    rdfs:comment "Functie die het Toestel kan uitvoeren met het oog op het uitvoeren van een taak."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Toestel.Functie>;
    shacl:class <https://saref.etsi.org/core/Function>;
    shacl:description "Functie die het Toestel kan uitvoeren met het oog op het uitvoeren van een taak."@nl;
    shacl:minCount "1";
    shacl:name "functie"@nl;
    shacl:path <https://saref.etsi.org/core/hasFunction>
  ], [
    a shacl:PropertyShape;
    rdfs:label "taak"@nl;
    rdfs:comment "Taak die met het Toestel kan worden uitgevoerd waarvoor het Toestel ontworpen is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Toestel.Taak>;
    shacl:class <https://saref.etsi.org/core/Task>;
    shacl:description "Taak die met het Toestel kan worden uitgevoerd waarvoor het Toestel ontworpen is."@nl;
    shacl:minCount "1";
    shacl:name "taak"@nl;
    shacl:path <https://saref.etsi.org/core/accomplishes>
  ], [
    a shacl:PropertyShape;
    rdfs:label "host van"@nl;
    rdfs:comment "Sensor door het Toestel gehost."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Toestel.HostVan>;
    shacl:class <http://www.w3.org/ns/sosa/Sensor>;
    shacl:description "Sensor door het Toestel gehost."@nl;
    shacl:name "host van"@nl;
    shacl:path <https://www.w3.org/ns/sosa/hosts>
  ];
  shacl:targetClass <https://saref.etsi.org/core/Device> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TransporteigenschapShape> a shacl:NodeShape;
  rdfs:label "Transporteigenschap"@nl;
  <http://purl.org/vocab/vann/usageNote> "Heeft betrekking op objecten zoals Transportllinks, Transportknopen etc of - via LineaireReferentie - op delen ervan."@nl;
  rdfs:comment "Eigenschap van een Transportobject."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/transportnetwerk#Transporteigenschap> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TransportknoopShape> a shacl:NodeShape;
  rdfs:label "Transportknoop"@nl;
  <http://purl.org/vocab/vann/usageNote> "OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/ns/transportnetwerk/\">VOC Transportnetwerk</a>."@nl;
  rdfs:comment "Significante positie in het Transportetwerk die steeds samenvalt met het begin of het einde van een Transportlink."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/transportnetwerk#Transportknoop> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TransportlinkShape> a shacl:NodeShape;
  rdfs:label "Transportlink"@nl;
  <http://purl.org/vocab/vann/usageNote> "OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/ns/transportnetwerk/\">VOC Transportnetwerk</a>."@nl;
  rdfs:comment "Lineair ruimtelijk object dat de geometrie en connectiviteit beschrijft tussen twee punten in een Transportnetwerk."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/transportnetwerk#Transportlink> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TransportlinksequentieShape> a shacl:NodeShape;
  rdfs:label "Transportlinksequentie"@nl;
  <http://purl.org/vocab/vann/usageNote> "OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/ns/transportnetwerk/\">VOC Transportnetwerk</a>."@nl;
  rdfs:comment "Lineair ruimtelijk object, bestaande uit een geordende verzameling van Transportlinks, die een onvertakt doorlopend pad in een Transportnetwerk vertegenwoordigt."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/transportnetwerk#Transportlinksequentie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#UriShape> a shacl:NodeShape;
  rdfs:label "URI";
  shacl:closed false;
  shacl:targetClass xsd:anyURI .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#VerkeersbemonsteringsobjectShape> a shacl:NodeShape;
  rdfs:label "Verkeersbemonsteringsobject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Van belang als men dit object niet rechtstreeks kan observeren. Bvb om de snelheid ve Voertuig te bepalen kan men moeilijk dat Voertuig gaan volgen, in plaats daarvan zet men een meetpunt op langs de weg om te zien hoe snel passerende Voertuigen rijden. Gelijkaardig voor bvb verkeersintensiteit: men telt in een meetpunt langs de weg doorkomsten van Voertuigen en gaat ervan uit dat dit cijfer representatief is voor  het Wegsegment (deel van de weg tussen twee opeenvolgende kruispunten). OPGELET: Deze klasse is abstract, ze mag niet geinstantieerd worden. Gebruik in de plaats de subklassen Verkeersmeetpunt of Verkeersmeettraject"@nl;
  rdfs:comment "Object dat representatief is voor het object waarvan men het Verkeerskenmerk meet."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "bemonsterdObject"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb het Voertuig of het Wegsegment waarvan men een Verkeerskenmerk bepaalt."@nl;
    rdfs:comment "Verwijzing naar het Verkeersdomeinobject waarop de meting betrekking heeft en waarvoor het Verkeersbemonsteringsobject representatief is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Verkeersbemonsteringsobject.Bemonsterdobject>;
    shacl:class <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersdomeinobject>;
    shacl:description "Verwijzing naar het Verkeersdomeinobject waarop de meting betrekking heeft en waarvoor het Verkeersbemonsteringsobject representatief is."@nl;
    shacl:minCount 1;
    shacl:name "bemonsterdObject"@nl;
    shacl:path <https://data.vlaanderen.be/ns/verkeersmetingen#bemonsterdObject>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersbemonsteringsobject> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#VerkeersdeelnemerShape> a shacl:NodeShape;
  rdfs:label "Verkeersdeelnemer"@nl;
  rdfs:comment "Deelnemer aan het verkeer, als bestuurder of passagier van een Voertuig of zonder Voertuig, bvb als voetganger."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "verkeersdeelnemertype"@nl;
    rdfs:comment "Aard van de Verkeersdeelnemer."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Verkeersdeelnemer.Verkeersdeelnemertype>;
    shacl:class skos:Concept;
    shacl:description "Aard van de Verkeersdeelnemer."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "verkeersdeelnemertype"@nl;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersdeelnemer> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#VerkeersdeelnemertypeShape> a shacl:NodeShape;
  rdfs:label "Verkeersdeelnemertype"@nl;
  rdfs:comment "Type Verkeersdeelnemer."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#VerkeersdomeinobjectShape> a shacl:NodeShape;
  rdfs:label "Verkeersdomeinobject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hieronder verstaan we een real-world object uit het verkeer, ttz een Voertuig of Verkeersdeelnemer of een Wegsegment of gelijkaardig waarover verkeer plaatsvindt. Vallen hier niet onder: Verkeersbemonsteringsobjecten zoals Verkeersmeetpunten of Verkeersmeettrajecten, dat zijn de objecten die het Verkeersdomein bemonsteren. OPGELET: Deze klasse is abstract, ze mag maw niet geinstantieerd worden. Gebruik in de plaats subklassen zoal Wegsegment, Rijstrook, Voertuig etc."@nl;
  rdfs:comment "Object uit het verkeersdomein waarvan men een Verkeerskenmerk meet."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersdomeinobject> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#VerkeerskenmerkShape> a shacl:NodeShape;
  rdfs:label "Verkeerskenmerk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb de gemiddelde snelheid van auto's langs een Meetpunt of de verkeersIntensiteit van fietsen op een Wegsegment bvb uitgedrukt in aantal voertuigen of de snelheid van een individueel Voertuig etc."@nl;
  rdfs:comment "Kenmerk van het Verkeersdomeinobject of het Verkeersbemonsteringsobject dat gemeten wordt en dat betrekking heeft op het verkeer over of langs dat object of op zijn deelname aan het verkeer."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Type vh Verkeerskenmerk."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Verkeerskenmerk.Type>;
    shacl:class skos:Concept;
    shacl:description "Type vh Verkeerskenmerk."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc11:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "voertuigType"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb \"Fiets\" als men enkel het aantal fietsen wil tellen in een Meetpunt. Enkel noodzakelijk voor Verkeersdomeinobjecten die zelf geen Voertuig zijn maar bvb een Wegsegment of Rijstrook etc."@nl;
    rdfs:comment "Soort Voertuig waarvan men het Verkeerskenmerk meet."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Verkeerskenmerk.Voertuigtype>;
    shacl:class skos:Concept;
    shacl:description "Soort Voertuig waarvan men het Verkeerskenmerk meet."@nl;
    shacl:name "voertuigType"@nl;
    shacl:path <https://data.vlaanderen.be/ns/verkeersmetingen#voertuigType>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verkeersdeelnemertype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb \"Voetganger\" als men enkel het aantal Voertgangers wil tellen in een Meetpunt. Enkel noodzakelijk voor Verkeersdomeinobjecten die zelf geen Verkeersdeelnemer zijn maar bvb een Wegsegment of Rijstrook etc."@nl;
    rdfs:comment "Soort Verkeersdeelnemer waarvan men het Verkeerskenmerk meet."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#Verkeerskenmerk.Verkeersdeelnemertype>;
    shacl:class skos:Concept;
    shacl:description "Soort Verkeersdeelnemer waarvan men het Verkeerskenmerk meet."@nl;
    shacl:name "verkeersdeelnemertype"@nl;
    shacl:path <https://data.vlaanderen.be/ns/verkeersmetingen#verkeersdeelnemerType>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerskenmerk> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#VerkeerskenmerktypeShape> a shacl:NodeShape;
  rdfs:label "Verkeerskenmerktype"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv aantal, snelheid,…"@nl;
