        "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeettraject"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TrafficobjectShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "ATTENTION: This class is abstract, it must be specialized as a TrafficDomainObject or as a TrafficSamplingObject. As a Traffic DomainObject if the measurement directly relates to the object you want to observe (e.g. a RoadSegment or a Vehicle, etc.) or as a TrafficSamplingObject if the measurement is done indirectly (e.g. via a TrafficMeasuringPoint located along a RoadSegment)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Object on which or along which traffic occurs or that is part of traffic."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "TrafficObject"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_81"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersobject"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TrafficparticipantShape",
