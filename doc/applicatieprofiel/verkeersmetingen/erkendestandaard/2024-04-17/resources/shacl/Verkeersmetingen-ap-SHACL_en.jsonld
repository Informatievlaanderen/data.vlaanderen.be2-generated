      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "This is the point along the road where, for example, the passage of Vehicles is counted and/or their speed is measured or for which any other TrafficFeature is determined that relates to the sampled TrafficDomainObject."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Point at which features of passing traffic are measured."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "TrafficMeasurementPoint"
