      },
      {
        "@id": "_:df_8_86"
      },
      {
        "@id": "_:df_8_90"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeting"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TrafficmeasurementtrajectoryShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "This is a distance along the road where, for example, the average speed of Vehicles is measured (the so called fixed average speed check), or any other TrafficFeature that relates to the sampled TrafficDomainObject."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Trajectory along the road for which the characteristics of passing traffic are measured."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "TrafficMeasurementTrajectory"
      }
    ],
