        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_37"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/weg#Wegknoop"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#RoadobjectShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "Typical examples are RoadSegments, RoadNodes, RoadLinkSequences etc… REMARK: this class is abstract, only use the subclasses."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Object that represents a part of a RoadNetwork."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "RoadObject"
      }
    ],
