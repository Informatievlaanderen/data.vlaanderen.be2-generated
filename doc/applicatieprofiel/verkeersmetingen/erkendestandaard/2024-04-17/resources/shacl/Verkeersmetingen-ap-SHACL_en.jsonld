  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#RoadlinksequenceShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "Typically a route in a network, e.g. a numbered road or a public transport line in a certain direction."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Linear spatial object consisting of an ordered collection of RoadSegments, representing an unbranched continuous path in a TransportationNetwork."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "RoadLinkSequence"
      }
    ],
