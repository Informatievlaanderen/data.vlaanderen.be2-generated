  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#DomainobjectShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "This is the actual observedObject. If direct observation is not possible, we observe a representative sample, the so-called SamplingObject. In that case, the DomainObject is the sampledObject. REMARK: This class is purely informative and needs to be substituted in practice by a class from the domain. E.g. in the domain TraficMeasurements, the DomainObject could be an instance of a RoadSegment or a Vehicle."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Real world object that is not a SamplingObject."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "DomainObject"
      }
