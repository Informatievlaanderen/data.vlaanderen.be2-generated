  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#PointShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A 0-dimensional geometric object that represents a single location in coordinate space. A Point has an x-coordinate value and a y-coordinate value. Has an x-coordinate and a y-coordinate. Can also have a z-coordinate (height) and an m-coordinate (distance along a curve)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Point"
      }
    ],
