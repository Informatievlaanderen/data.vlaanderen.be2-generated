      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Linear spatial object that describes the geometry and connectivity between two points in a RoadNetwork."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "RoadSegment"
      }
