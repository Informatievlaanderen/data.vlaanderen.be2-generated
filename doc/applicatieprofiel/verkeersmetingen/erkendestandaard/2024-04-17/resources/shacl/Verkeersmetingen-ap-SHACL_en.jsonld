  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#TrafficsamplingobjectShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "To be used if one cannot observe this object directly. For example, to determine the speed of a Vehicle, it is impossible to track each vehicle. Instead, one sets up a measuring point along the road to see how fast passing Vehicles are driving. Similar to, for example, traffic intensity: the passages of Vehicles are counted at a measuring point along the road and it is assumed that this figure is representative of at least the part of the road between two consecutive intersections (being the corresponding RoadSegment). ATTENTION: This class is abstract, it may not be instantiated. Use the subclasses TrafficMeasurementPoint or TrafficMeasurementSection instead."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Object that is representative of the object for which the TrafficFeature is measured."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "TrafficSamplingObject"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_83"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersbemonsteringsobject"
      }
    ]
  },
