    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "Typically an intersection of roads or the beginning or end of a road."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Significant position in the TransportNetwork that always coincides with the start or end of a RoadSegment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "RoadNode"
      }
