      {
        "@language": "en",
        "@value": "Observations can be regarded as data and therefore data about Observations are indeed metadata. We limit ourselves here to descriptive metadata, i.e. information such as title, summary, author and keywords. Such metadata is primarily intended for identification and data catalogs."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
