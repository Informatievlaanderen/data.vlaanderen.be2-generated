    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "E.g. measurements that took place at the same time or observed the same object or feature or were made by the same Sensor. For example, the measurements of speed, vehicle type, etc. at the same TrafficMeasurementPoint or the measurements of traffic intensity per hour on the same RoadSegment, etc."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Collection of TrafficMeasurements with the same properties"
      }
    ],
