      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#LinestringShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "A Curve is a 1-dimensional geometric object, defined as a sequence of points. The interpolation can take different forms (e.g. linear in the case of a Line String)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A Curve with linear interpolation between Points. Each consecutive pair of Points defines a Line segment. A LineString has at least two points."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "LineString"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://schemas.opengis.net/sf/1.0/simple_features_geometries.rdf#LineString"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#LinkdirectionvalueShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Type of direction relative to the direction of a Link or Link Sequence."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "LinkDirectionValue"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#LinkShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "By a homogeneous path we mean a route that does not branch, for example a road between two intersections (where the intersections represent Nodes in the Network)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Curvilinear network element that connects two positions and represents a homogeneous path in the Network. The connected positions are represented by Nodes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Link"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://data.vlaanderen.be/ns/netwerk#Link"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/verkeersmetingen/erkendestandaard/2024-04-17#LocationShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "Use location if the applicable Class or datatype is nit yet known. Otherwise t be substituted by an instance of Place, AdministrativeUnit, GeographicalName, Address or other geographical objects like a Building, a Road or a CadastralParcel. Or to be represented by Geometry like Point, LineString, Polygon. REMARK: More info about these classes/datatypes in the application profile <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/\">OSLO-Generics</a>."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Indication of a geographical position, by using coordinates, a toponym, an address label, a reference to a place/region, a reference to an address or to a geographical object."
      }
