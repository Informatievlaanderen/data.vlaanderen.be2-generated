      {
        "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerskenmerk"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "en",
        "@value": "Characteristic of the TrafficObject being observed."
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": "1"
      }
    ],
