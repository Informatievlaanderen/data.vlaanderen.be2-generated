{
  "title": "Sensor",
  "type": "object",
  "description": "Toestel of Agent (inclusief Personen of software) waarmee Observaties gemaakt worden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Sensor)",
      "pattern": "^Sensor$"
    },
    "ligging": {
      "type": "array",
      "description": "Lijst van Locatie items.",
      "items": {
        "$ref": "#/components/schemas/Locatie"
      },
      "minItems": 1
    },
    "gehostDoor": {
      "type": "array",
      "description": "Lijst van Toestel items.",
      "items": {
        "$ref": "#/components/schemas/Toestel"
      },
      "minItems": 1
    },
    "implementeert": {
      "$ref": "#/components/schemas/Observatieprocedure"
    },
    "uitgevoerdeObservatie": {
      "type": "array",
      "description": "Lijst van Verkeersmeting items.",
      "items": {
        "$ref": "#/components/schemas/Verkeersmeting"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}