{
  "title": "Verkeersdeelnemer",
  "type": "object",
  "description": "Deelnemer aan het verkeer, als bestuurder of passagier van een Voertuig of zonder Voertuig, bijvoorbeeld als voetganger.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Verkeersdeelnemer)",
      "pattern": "^Verkeersdeelnemer$"
    },
    "verkeersdeelnemertype": {
      "$ref": "#/components/schemas/Verkeersdeelnemertype"
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Verkeersmeting items.",
      "items": {
        "$ref": "#/components/schemas/Verkeersmeting"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "verkeersdeelnemertype"
  ]
}