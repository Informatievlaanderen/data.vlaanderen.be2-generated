{
  "title": "Voertuig",
  "type": "object",
  "description": "Voorwerp gemaakt om personen of goederen te vervoeren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Voertuig)",
      "pattern": "^Voertuig$"
    },
    "voertuigtype": {
      "$ref": "#/components/schemas/Voertuigtype"
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Verkeersmeting items.",
      "items": {
        "$ref": "#/components/schemas/Verkeersmeting"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "voertuigtype"
  ]
}