{
  "title": "Wegknoop",
  "type": "object",
  "description": "Significante positie in het Tansportnetwerk die steeds samenvalt met het begin of het einde van een Wegsegment.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Wegknoop)",
      "pattern": "^Wegknoop$"
    },
    "geometrie": {
      "$ref": "#/components/schemas/Punt"
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Verkeersmeting items.",
      "items": {
        "$ref": "#/components/schemas/Verkeersmeting"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "geometrie"
  ]
}