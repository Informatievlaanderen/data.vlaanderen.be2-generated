{
  "title": "Weglinksequentie",
  "type": "object",
  "description": "Lineair ruimtelijk object, bestaande uit een geordende verzameling van Wegsegmenten, dat een onvertakt doorlopend pad in een Transportnetwerk vertegenwoordigt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Weglinksequentie)",
      "pattern": "^Weglinksequentie$"
    },
    "link": {
      "type": "array",
      "description": "Lijst van GerichteLink items.",
      "items": {
        "$ref": "#/components/schemas/GerichteLink"
      },
      "minItems": 1
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Verkeersmeting items.",
      "items": {
        "$ref": "#/components/schemas/Verkeersmeting"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "link"
  ]
}