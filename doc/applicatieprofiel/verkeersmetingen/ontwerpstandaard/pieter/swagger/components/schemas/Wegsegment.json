{
  "title": "Wegsegment",
  "type": "object",
  "description": "Lineair ruimtelijk object dat de geometrie en connectiviteit beschrijft tussen twee punten in een Wegennetwerk.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Wegsegment)",
      "pattern": "^Wegsegment$"
    },
    "geometriemiddenlijn": {
      "$ref": "#/components/schemas/Lijnstring"
    },
    "eindknoop": {
      "type": "array",
      "description": "Lijst van Wegknoop items.",
      "items": {
        "$ref": "#/components/schemas/Wegknoop"
      },
      "minItems": 1
    },
    "beginknoop": {
      "type": "array",
      "description": "Lijst van Wegknoop items.",
      "items": {
        "$ref": "#/components/schemas/Wegknoop"
      },
      "minItems": 1
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Verkeersmeting items.",
      "items": {
        "$ref": "#/components/schemas/Verkeersmeting"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "geometriemiddenlijn"
  ]
}