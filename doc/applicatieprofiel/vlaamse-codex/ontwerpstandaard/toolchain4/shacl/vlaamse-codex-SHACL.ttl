    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#DatetimeShape> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#AardVanDeWetgevingShape> a shacl:NodeShape;
  rdfs:label "aard van de wetgeving"@nl;
  rdfs:comment "Het type van de rechtsbron."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> ""@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#DateShape> a shacl:NodeShape;
  rdfs:label "Date";
  shacl:closed false;
  shacl:targetClass xsd:date .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type vd string slaat op het identificatiesysteem (incl de versie ervan), de string zelf op de eigenlijke identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Identificator.Identificator>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend op"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Tijdstip waarop de identificator werd uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Identificator.ToegekendOp>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend op"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Identificator.ToegekendDoor>;
    shacl:class dc:Agent;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend door"@nl;
    shacl:path dc:creator
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door (String)"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam vd agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Identificator.ToegekendDoor(string)>;
    shacl:class dc:Agent;
    shacl:description "Naam vd agent die de identificator heeft toegekend."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend door (String)"@nl;
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#RechtsbronShape> a shacl:NodeShape;
  rdfs:label "Rechtsbron"@nl;
  rdfs:comment "Een legaal concept dat los staat van een bepaalde vorm (het achterliggende idee)."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "inwerkingtreding"@nl;
    rdfs:comment "De datum waarop de regelgeving van kracht wordt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.Inwerkingtreding>;
    shacl:datatype xsd:date;
    shacl:description "De datum waarop de regelgeving van kracht wordt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "inwerkingtreding"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#first_date_entry_in_force>
  ], [
    a shacl:PropertyShape;
    rdfs:label "datum document"@nl;
    rdfs:comment "Adoptiedatum of handtekendatum (in de vorm jjjj-mm-dd)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.DatumDocument>;
    shacl:datatype xsd:date;
    shacl:description "Adoptiedatum of handtekendatum (in de vorm jjjj-mm-dd)."@nl;
    shacl:maxCount "1";
    shacl:name "datum document"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#date_document>
  ], [
    a shacl:PropertyShape;
    rdfs:label "buitenwerkingtreding"@nl;
    rdfs:comment "De laatste dag waarop de regelgeving nog van kracht is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.Buitenwerkingtreding>;
    shacl:datatype xsd:date;
    shacl:description "De laatste dag waarop de regelgeving nog van kracht is."@nl;
    shacl:maxCount "1";
    shacl:name "buitenwerkingtreding"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#date_no_longer_in_force>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type document"@nl;
    rdfs:comment "Het type van het regelgevend document."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.TypeDocument>;
    shacl:class skos:Concept;
    shacl:description "Het type van het regelgevend document."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type document"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#type_document>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ingevoegd bij"@nl;
    rdfs:comment "Geeft een bron aan die deze bron aanvult met juridische impact."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.IngevoegdBij>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Geeft een bron aan die deze bron aanvult met juridische impact."@nl;
    shacl:name "ingevoegd bij"@nl;
    shacl:path <https://data.vlaanderen.be/ns/wetgeving#ingevoegdBij>
  ], [
    a shacl:PropertyShape;
    rdfs:label "zie ook"@nl;
    rdfs:comment "Duidt op een of ander manier gerelateerd ander document, niet noodzakelijk een legale bron."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.ZieOok>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Duidt op een of ander manier gerelateerd ander document, niet noodzakelijk een legale bron."@nl;
    shacl:name "zie ook"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#related_to>
  ], [
    a shacl:PropertyShape;
    rdfs:label "trekt in"@nl;
    rdfs:comment "Geeft aan dat deze juridische bron of juridische uitdrukking volledig kan worden geannuleerd door een andere."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.TrektIn>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Geeft aan dat deze juridische bron of juridische uitdrukking volledig kan worden geannuleerd door een andere."@nl;
    shacl:name "trekt in"@nl;
    shacl:path <https://data.vlaanderen.be/ns/wetgeving#trektIn>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft deel"@nl;
    rdfs:comment "Geeft aan dat deze bron uit deelbronnen bestaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.HeeftDeel>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>;
    shacl:description "Geeft aan dat deze bron uit deelbronnen bestaat."@nl;
    shacl:name "heeft deel"@nl;
    shacl:path dc:hasPart
  ], [
    a shacl:PropertyShape;
    rdfs:label "ingetrokken bij"@nl;
    rdfs:comment "Geeft aan dat deze bron volledig wordt geannuleerd door een andere bron."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.IngetrokkenBij>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Geeft aan dat deze bron volledig wordt geannuleerd door een andere bron."@nl;
    shacl:name "ingetrokken bij"@nl;
    shacl:path <https://data.vlaanderen.be/ns/wetgeving#ingetrokkenBij>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heft op"@nl;
    rdfs:comment "Geeft aan dat deze bron een andere buiten werking stelt"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.HeftOp>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Geeft aan dat deze bron een andere buiten werking stelt"@nl;
    shacl:name "heft op"@nl;
    shacl:path <https://data.vlaanderen.be/ns/wetgeving#heftOp>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vervangen bij"@nl;
    rdfs:comment "Geeft een bron aan die volledig vernieuwd is door een andere."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.VervangenBij>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Geeft een bron aan die volledig vernieuwd is door een andere."@nl;
    shacl:name "vervangen bij"@nl;
    shacl:path <https://data.vlaanderen.be/ns/wetgeving#vervangenBij>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bekrachtigd bij"@nl;
    rdfs:comment "Inverse van bekrachtigt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.BekrachtigdBij>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Inverse van bekrachtigt."@nl;
    shacl:name "bekrachtigd bij"@nl;
    shacl:path <https://data.vlaanderen.be/ns/wetgeving#bekrachtigdBij>
  ], [
    a shacl:PropertyShape;
    rdfs:label "zet om"@nl;
    rdfs:comment "Geeft aan dat deze wetgeving (of een deel van de wetgeving) voldoet aan de doelstellingen van een andere wetgeving, door het nemen van passende uitvoeringsmaatregelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.ZetOm>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Geeft aan dat deze wetgeving (of een deel van de wetgeving) voldoet aan de doelstellingen van een andere wetgeving, door het nemen van passende uitvoeringsmaatregelen."@nl;
    shacl:name "zet om"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#transposes>
  ], [
    a shacl:PropertyShape;
    rdfs:label "citeert"@nl;
    rdfs:comment "Een citatie in de wettelijke tekst. Dit omvat zowel woordelijke citaten als citaten in verwijzingen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.Citeert>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Een citatie in de wettelijke tekst. Dit omvat zowel woordelijke citaten als citaten in verwijzingen."@nl;
    shacl:name "citeert"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#cites>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verantwoordelijke"@nl;
    rdfs:comment "Een aparte intellectuele creatie (d.w.z. de intellectuele inhoud)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.Verantwoordelijke>;
    shacl:class dc:Agent;
    shacl:description "Een aparte intellectuele creatie (d.w.z. de intellectuele inhoud)."@nl;
    shacl:name "verantwoordelijke"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#responsibility_of>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wijzigt"@nl;
    rdfs:comment "Duidt aan dat deze rechtsbron een verandering met legale gevolgen doorvoert op een andere rechtsbron. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.Wijzigt>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Duidt aan dat deze rechtsbron een verandering met legale gevolgen doorvoert op een andere rechtsbron. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    shacl:name "wijzigt"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#amends>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bekrachtigt"@nl;
    rdfs:comment "Betekent dat dit document instemt met een ander type document waardoor dat laatste volledige rechtskracht krijgt. De bekrachtiging is in dit geval een opschortende voorwaarde."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.Bekrachtigt>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Betekent dat dit document instemt met een ander type document waardoor dat laatste volledige rechtskracht krijgt. De bekrachtiging is in dit geval een opschortende voorwaarde."@nl;
    shacl:name "bekrachtigt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/wetgeving#bekrachtigt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vervangt"@nl;
    rdfs:comment "Geeft aan dat deze bron een andere volledig vernieuwt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.Vervangt>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Geeft aan dat deze bron een andere volledig vernieuwt."@nl;
    shacl:name "vervangt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/wetgeving#vervangt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "voegt in"@nl;
    rdfs:comment "Deze bron vult een andere aan met legale impact."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.VoegtIn>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Deze bron vult een andere aan met legale impact."@nl;
    shacl:name "voegt in"@nl;
    shacl:path <https://data.vlaanderen.be/ns/wetgeving#voegtIn>
  ], [
    a shacl:PropertyShape;
    rdfs:label "opgeheven bij"@nl;
    rdfs:comment "Geeft aan dat deze juridische bron of juridische uitdrukking volledig wordt ingetrokken door een andere juridische hulpbron."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.OpgehevenBij>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Geeft aan dat deze juridische bron of juridische uitdrukking volledig wordt ingetrokken door een andere juridische hulpbron."@nl;
    shacl:name "opgeheven bij"@nl;
    shacl:path <https://data.vlaanderen.be/ns/wetgeving#opgehevenBij>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gewijzigd bij"@nl;
    rdfs:comment "Duidt aan dat deze rechtsbron een verandering met legale gevolgen heeft ondergaan door een andere rechtsbron. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.GewijzigdBij>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Duidt aan dat deze rechtsbron een verandering met legale gevolgen heeft ondergaan door een andere rechtsbron. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."@nl;
    shacl:name "gewijzigd bij"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#amended_by>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is gerealiseerd door"@nl;
    rdfs:comment "De verschijningsvorm die deze rechtsbron materialiseert in een concrete tekst."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbron.IsGerealiseerdDoor>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalExpression>;
    shacl:description "De verschijningsvorm die deze rechtsbron materialiseert in een concrete tekst."@nl;
    shacl:name "is gerealiseerd door"@nl;
    shacl:path <http://data.europa.eu/eli/ontology#is_realized_by>
  ];
  shacl:targetClass <http://data.europa.eu/eli/ontology#LegalResource> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#RechtsbrononderdeelShape> a shacl:NodeShape;
  rdfs:label "Rechtsbrononderdeel"@nl;
  rdfs:comment "Een onderdeel van een rechtshandeling, op een willekeurig niveau van nauwkeurigheid, zoals een hoofdstuk, een artikel, een alinea, een alinea of een lijstitem."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Het type van het rechtsbrononderdeel."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbrononderdeel.Type>;
    shacl:class skos:Concept;
    shacl:description "Het type van het rechtsbrononderdeel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "is deel van"@nl;
    rdfs:comment "Relatie die documenten en onderdelen (hoofdstukken, artikels...) aan elkaar linkt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/vlaamse-codex/ontwerpstandaard/toolchain4#Rechtsbrononderdeel.IsDeelVan>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "Relatie die documenten en onderdelen (hoofdstukken, artikels...) aan elkaar linkt."@nl;
    shacl:name "is deel van"@nl;
