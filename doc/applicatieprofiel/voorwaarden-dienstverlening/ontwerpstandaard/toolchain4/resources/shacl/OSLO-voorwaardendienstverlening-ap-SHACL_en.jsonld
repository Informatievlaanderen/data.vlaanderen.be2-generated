  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/voorwaarden-dienstverlening/ontwerpstandaard/toolchain4#ConstraintShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "Constraints are requirements in themselves, since they impose prerequisites which influence the definition, use and/or fulfilment of the requirement.\r\nThey represent hard conditions such as minimum or maximum expressions which can be used to evaluate pieces of information, the required age, income, involvement in activities, etc. \r\n\r\nAn example from the eProcurement domain is a threshold as the minimum turnover required by the buying organisation to select the candidates. \r\n\r\nNote that CCCEV does not provide any specific guidance on when which kind of Requirement should be used. Users of this vocabulary should make decisions on this topic in their specific context."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A limitation applied to Requirement(s) or to the Information Concept(s) the Requirement is about."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Constraint"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_74"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
