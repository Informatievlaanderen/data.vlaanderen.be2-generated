  {
    "@id": "_:df_8_74",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "Information Concepts are tools to make Requirements more machine processable: they allow to provide more detail about a Requirement. This way, Constraints can be made very precise, namely the limit that must be achieved, is a limit on the value for the associated Information Concept. For example, the Information Concept would be the age of a person and the Constraint would be the required age in the context of a specific evaluation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Information Concept about which a Constraint expresses a limitation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "constrains"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/voorwaarden-dienstverlening/ontwerpstandaard/toolchain4#Constraint.Constrains"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "http://data.europa.eu/m8g/cccev#InformationConcept"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "en",
        "@value": "The Information Concept about which a Constraint expresses a limitation."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
