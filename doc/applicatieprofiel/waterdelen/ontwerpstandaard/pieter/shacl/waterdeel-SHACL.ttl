<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#BeekShape> a shacl:NodeShape;
  rdfs:label "Beek"@nl;
  rdfs:comment "Een Natuurlijke Waterloop die een buiten de wegbaan gelegen natuurlijke stroom ondiep water is die vanuit een oorsprong, vaak een bron, stroomafwaarts vloeit. Een beek is onbevaarbaar."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Beek> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#DeelShape> a shacl:NodeShape;
  rdfs:label "Deel"@nl;
  rdfs:comment "Homogeen gedeelte van het aardoppervlak, met een gelijkaardige hoofdfunctie en fysiek voorkomen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "oppervlakte"@nl;
    rdfs:comment "De afmeting van het object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#Deel.Oppervlakte>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "De afmeting van het object."@nl;
    shacl:maxCount "1";
    shacl:name "oppervlakte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#oppervlakte>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein#Deel>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Waterdeel>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Watervlak>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Vijver>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Meer>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Poel>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Slotgracht>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Ven>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Waterloop>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Sloot>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Gracht>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#NatuurlijkeGracht>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#KunstmatigeGracht>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#NatuurlijkeWaterloop>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Rivier>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Beek>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#KunstmatigeWaterloop>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Kanaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#FysiekobjectShape> a shacl:NodeShape;
  rdfs:label "FysiekObject"@nl;
  rdfs:comment "De hoofdklasse waar alle objecten die geïnventariseerd kunnen worden van afgeleid worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "begindatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het gebied of object in gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#Fysiekobject.Begindatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het gebied of object in gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "begindatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#begindatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "Datum waarop de huidige versie van het beheerobject uit gebruik wordt genomen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#Fysiekobject.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarop de huidige versie van het beheerobject uit gebruik wordt genomen."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#einddatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "niveau"@nl;
    <http://purl.org/vocab/vann/usageNote> "Negatieve waarden worden geassocieerd met ondergronds en positieve waarden met bovengronds. Nul wordt beschouwd als een absolute waarde om het maaiveld aan te duiden."@nl;
    rdfs:comment "Het niveau waarop het object zich bevindt, relatief ten opzichte van andere objecten."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#Fysiekobject.Niveau>;
    shacl:datatype xsd:integer;
    shacl:description "Het niveau waarop het object zich bevindt, relatief ten opzichte van andere objecten."@nl;
    shacl:maxCount "1";
    shacl:name "niveau"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#niveau>
  ], [
    a shacl:PropertyShape;
    rdfs:label "nauwkeurigheid"@nl;
    rdfs:comment "De precisie waarmee het object opgemeten werd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#Fysiekobject.Nauwkeurigheid>;
    shacl:class skos:Concept;
    shacl:description "De precisie waarmee het object opgemeten werd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "nauwkeurigheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/openbaardomein#nauwkeurigheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "De geometrie overeenkomstig met een bepaald object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#Fysiekobject.Geometrie>;
    shacl:class <http://www.opengis.net/ont/geosparql#Geometry>;
    shacl:description "De geometrie overeenkomstig met een bepaald object."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "relatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een verwijzing naar een object uit het wegenregister of grootschalig referentiebestand."@nl;
    rdfs:comment "Verwijst naar een object in een andere databank dat meer informatie kan verschaffen over het beheerobject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#Fysiekobject.Relatie>;
    shacl:class rdfs:Resource;
    shacl:description "Verwijst naar een object in een andere databank dat meer informatie kan verschaffen over het beheerobject."@nl;
    shacl:name "relatie"@nl;
    shacl:path dc:relation
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein#FysiekObject>,
    <https://data.vlaanderen.be/ns/openbaardomein#Deel>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Waterdeel>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Watervlak>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Vijver>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Meer>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Poel>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Slotgracht>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Ven>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Waterloop>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Sloot>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Gracht>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#NatuurlijkeGracht>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#KunstmatigeGracht>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#NatuurlijkeWaterloop>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Rivier>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Beek>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#KunstmatigeWaterloop>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Kanaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#GrachtShape> a shacl:NodeShape;
  rdfs:label "Gracht"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bron definitie: naar GRB-basis: WGR: Gracht."@nl;
  rdfs:comment "Een afvoerweg tot afscheiding, tot afwatering of tot ontwatering van hemelwater, drainagewater, bemalingswater en in voorkomend geval ook effluentwater uit een waterzuiveringsinstallatie, of water afkomstig uit een overstort, die niet bij de waterwegen en ook niet bij de onbevaarbare waterlopen is ingedeeld. Een gracht is niet altijd permanent watervoerend."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Gracht>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#NatuurlijkeGracht>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#KunstmatigeGracht> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#IntegerShape> a shacl:NodeShape;
  rdfs:label "Integer";
  shacl:closed false;
  shacl:targetClass xsd:integer .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#KanaalShape> a shacl:NodeShape;
  rdfs:label "Kanaal"@nl;
  rdfs:comment "Een Kunstmatige Waterloop die bevaarbaar is."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Kanaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#KunstmatigegrachtShape> a shacl:NodeShape;
  rdfs:label "KunstmatigeGracht"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een baangracht of een gracht voor effluentwater uit een waterzuiveringsinstallatie."@nl;
  rdfs:comment "Een Gracht die is aangelegd door de mens."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#KunstmatigeGracht> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#KunstmatigewaterloopShape> a shacl:NodeShape;
  rdfs:label "KunstmatigeWaterloop"@nl;
  rdfs:comment "Een Waterloop die, geheel of in grote mate, tot stand is gebracht door het ingrijpen van de mens."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#KunstmatigeWaterloop>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Kanaal> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#KwantitatievewaardeShape> a shacl:NodeShape;
  rdfs:label "KwantitatieveWaarde"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld de hoogte van een object,het gewicht,de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog,laag en dergelijke vallen hier dus niet onder."@nl;
  rdfs:comment "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "eenheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Te gebruiken als geen standaard eenheid gekend is."@nl;
    rdfs:comment "De eenheid waarin de waarde is uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#Kwantitatievewaarde.Eenheid>;
    shacl:datatype xsd:string;
    shacl:description "De eenheid waarin de waarde is uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:name "eenheid"@nl;
    shacl:path schemas:unitText
  ], [
    a shacl:PropertyShape;
    rdfs:label "standaardEenheid"@nl;
    rdfs:comment "De gestandaardiseerde eenheid waarin de waarde is uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#Kwantitatievewaarde.Standaardeenheid>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#StandaardEenheid>;
    shacl:description "De gestandaardiseerde eenheid waarin de waarde is uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:name "standaardEenheid"@nl;
    shacl:path schemas:unitCode
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#Kwantitatievewaarde.Waarde>;
    shacl:class schemas:Number;
    shacl:description "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ];
  shacl:targetClass schemas:QuantitativeValue .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#MeerShape> a shacl:NodeShape;
  rdfs:label "Meer"@nl;
  rdfs:comment "Een meer is een door land omringde watervlakte. De meeste meren hebben een of meer voedende en afwaterende rivieren."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Meer> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#NatuurlijkegrachtShape> a shacl:NodeShape;
  rdfs:label "NatuurlijkeGracht"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld tussen twee landbouwpercelen."@nl;
  rdfs:comment "Een Gracht die op natuurlijke wijze is ontstaan door de afwatering van hemelwater."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#NatuurlijkeGracht> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#NatuurlijkewaterloopShape> a shacl:NodeShape;
  rdfs:label "NatuurlijkeWaterloop"@nl;
  rdfs:comment "Een Waterloop die op natuurlijke wijze is ontstaan."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#NatuurlijkeWaterloop>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Rivier>,
    <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Beek> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#PoelShape> a shacl:NodeShape;
  rdfs:label "Poel"@nl;
  rdfs:comment "Een poel is een meestal door de mens uitgegraven waterpartij in een grasland, bedoeld als drinkplaats voor het vee. Het zijn meestal kleine, ondiepe waterpartijen in grasland."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Poel> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#RivierShape> a shacl:NodeShape;
  rdfs:label "Rivier"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bron object: GRB-entiteit: Watergang (Wtz), NOTE Bron object: VHA: waterloop."@nl;
  rdfs:comment "Een Natuurlijke Waterloop, bedoeld voor de af- of aanvoer of het tijdelijk ophouden van oppervlaktewater en die (meestal) bevaarbaar is."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Rivier> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#SlootdeprecatedShape> a shacl:NodeShape;
  rdfs:label "SlootDeprecated"@nl;
  rdfs:comment "Een sloot is een waterloop op plaatsen waar regenwater samenstroomt, zodat het gezamenlijk kan worden afgevoerd om wateroverlast te voorkomen. Een sloot is een onderdeel van de waterhishoudkundige infrastructuur. Het via sloten afgevoerde water wordt elders weggepompt."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Sloot> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#SlotgrachtShape> a shacl:NodeShape;
  rdfs:label "Slotgracht"@nl;
  rdfs:comment "Een slotgracht is een diepe, brede gracht, droog of gevuld met water, dat een kasteel of gebouw omringt."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Slotgracht> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#VenShape> a shacl:NodeShape;
  rdfs:label "Ven"@nl;
  rdfs:comment "Een ven is een klein, meestal ondiep meer dat voorkomt op Pleistocene zandgronden. Vennen hebben wisselende waterstanden en zijn zelden groter dan enkele hectaren. Onder vennen worden uitsluitend natuurlijke wateren verstaan."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Ven> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterdelen/ontwerpstandaard/pieter#VijverShape> a shacl:NodeShape;
  rdfs:label "Vijver"@nl;
  rdfs:comment "Een vijver is een door de mens aangelegd waterlichaam met beperkte oppervlakte en wordt geassocieerd met visvangst of een sierfunctie."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/waterdeel#Vijver> .

