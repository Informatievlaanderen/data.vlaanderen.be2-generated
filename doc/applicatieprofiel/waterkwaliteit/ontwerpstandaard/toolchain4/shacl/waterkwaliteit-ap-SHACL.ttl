    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Bemonsteringsobjectverzameling.Verzameling>;
    shacl:class <http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeature>;
    shacl:description "TODO"@nl;
    shacl:minCount "1";
    shacl:name "Verzameling"@nl;
    shacl:path <http://todo/>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeatureCollection> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#BenoemdewaardeShape> a shacl:NodeShape;
  rdfs:label "BenoemdeWaarde"@nl;
  <http://purl.org/vocab/vann/usageNote> "In essentie een waarde en de naam vh type van de waarde. In deze context gaat het over zaken zoals operator, omgevingstemperatuur etc."@nl;
  rdfs:comment "Generieke, zwak getypeerde waarde."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van het type van de waarde."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Benoemdewaarde.Naam>;
    shacl:class <http://def.isotc211.org/iso19103/2005/Names#GenericName>;
    shacl:description "Naam van het type van de waarde."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path <http://def.isotc211.org/iso19156/2011/Observation#NamedValue.name>
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het datatype Any moet gesubstitueerd worden door iets concreter zoals Agent of <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/observaties-en-metingen/#Maat\">Maat</a>."@nl;
    rdfs:comment "Kwalitatieve of kwantitatieve invulling van de waarde."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Benoemdewaarde.Waarde>;
    shacl:class rdfs:Resource;
    shacl:description "Kwalitatieve of kwantitatieve invulling van de waarde."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path <http://def.isotc211.org/iso19156/2011/Observation#NamedValue.value>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/Observation#NamedValue> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#BioindicatorobservatieShape> a shacl:NodeShape;
  rdfs:label "BioIndicatorObservatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze soorten, ook BioIndicatoren genoemd, zijn levende organismen zoals planten, plankton, dieren, microben etc. Meer specifiek worden biochemische, fysiologische, gedragsmatige of populatieveranderingen gemonitord."@nl;
  rdfs:comment "Observatie die de biologische kwaliteit van water beoordeelt op basis van de algehele toestand van indicatiesoorten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geobserveerdKenmerk"@nl;
    rdfs:comment "Type van het geobserveerdKenmerk."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Bioindicatorobservatie.Geobserveerdkenmerk>;
    shacl:class skos:Concept;
    shacl:description "Type van het geobserveerdKenmerk."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geobserveerdKenmerk"@nl;
    shacl:path <https://purl.eu/ns/air-and-water/water#BioIndicatorObservation.observedProperty>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bioIndicator"@nl;
    rdfs:comment "Resultaat van de BioIndicatorObservatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Bioindicatorobservatie.Bioindicator>;
    shacl:class rdfs:Resource;
    shacl:description "Resultaat van de BioIndicatorObservatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "bioIndicator"@nl;
    shacl:path <https://purl.eu/ns/air-and-water/water#BioIndicatorObservation.bioIndicator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "soort"@nl;
    rdfs:comment "De bioindicator soort die bij de observatie geobserveerd wordt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Bioindicatorobservatie.Soort>;
    shacl:class <https://data.vlaanderen.be/ns/waterkwaliteit#Soort>;
    shacl:description "De bioindicator soort die bij de observatie geobserveerd wordt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "soort"@nl;
    shacl:path <https://data.vlaanderen.be/ns/waterkwaliteit#soort>
  ];
  shacl:targetClass <https://purl.eu/ns/air-and-water/water#BioIndicatorObservation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#BioindicatortypeShape> a shacl:NodeShape;
  rdfs:label "BioIndicatorType"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#BiotischeindexobservatieShape> a shacl:NodeShape;
  rdfs:label "BiotischeIndexObservatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de praktijk komt dit neer op het tellen van exemplaren van bepaalde soorten macro-ongewervelde dieren zoals wormen, slakken, vliegen, mosselen etc. die in het water aanwezig zijn, gewogen met de mate waarin ze watervervuiling tolereren en gecombineerd tot één waterkwaliteitscore."@nl;
  rdfs:comment "Observatie die de biologische kwaliteit van water op een bepaalde schaal beoordeelt, op basis van welke organismen in het water aanwezig zijn en in welke hoeveelheden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geobserveerdKenmerk"@nl;
    rdfs:comment "Type van het geobserveerdKenmerk."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Biotischeindexobservatie.Geobserveerdkenmerk>;
    shacl:class skos:Concept;
    shacl:description "Type van het geobserveerdKenmerk."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geobserveerdKenmerk"@nl;
    shacl:path <https://purl.eu/ns/air-and-water/water#BioticIndexObservation.observedProperty>
  ], [
    a shacl:PropertyShape;
    rdfs:label "biotischeIndex"@nl;
    rdfs:comment "Resultaat van de BiotischeIndexObservatie."@nl;
