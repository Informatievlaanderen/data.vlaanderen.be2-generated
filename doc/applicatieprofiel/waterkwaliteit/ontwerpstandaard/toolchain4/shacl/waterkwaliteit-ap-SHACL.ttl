    rdfs:label "uitgevoerdMetSensor"@nl;
    rdfs:comment "Sensor waarmee de Observatie is uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Observatie.Uitgevoerdmetsensor>;
    shacl:class <http://www.w3.org/ns/sosa/Sensor>;
    shacl:description "Sensor waarmee de Observatie is uitgevoerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "uitgevoerdMetSensor"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeBySensor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruikteProcedure"@nl;
    rdfs:comment "Een relatie die de connectie legt tussen een herbruikbare procedure voor het maken van een observatie, een beschrijving of een bemonstering, typisch door een sensor, beschrijver of bemonsteraar."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Observatie.Gebruikteprocedure>;
    shacl:class <http://www.w3.org/ns/sosa/Procedure>;
    shacl:description "Een relatie die de connectie legt tussen een herbruikbare procedure voor het maken van een observatie, een beschrijving of een bemonstering, typisch door een sensor, beschrijver of bemonsteraar."@nl;
    shacl:name "gebruikteProcedure"@nl;
    shacl:path <http://www.w3.org/ns/sosa/usedProcedure>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#ObservatiecontextShape> a shacl:NodeShape;
  rdfs:label "Observatiecontext"@nl;
  rdfs:comment "Verdere beschrijving van de samenhang tussen twee Observaties."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "rol"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv. Observatie A \"isInputVoor\" Observatie B, Observatie A \"verklaart\" het resultaat van Observatie B."@nl;
    rdfs:comment "Aard van de samenhang."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Observatiecontext.Rol>;
    shacl:class <http://def.isotc211.org/iso19103/2005/Names#GenericName>;
    shacl:description "Aard van de samenhang."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "rol"@nl;
    shacl:path <http://def.isotc211.org/iso19156/2011/Observation#ObservationContext.role>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Observatie (source)";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Observatiecontext.Observatie(source)>;
    shacl:class <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation>;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "Observatie (source)";
    shacl:path <https://data.vlaanderen.be/ns/observaties-en-metingen#Observatiecontext.observatie.source>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Observatie (target)";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Observatiecontext.Observatie(target)>;
    shacl:class <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation>;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "Observatie (target)";
    shacl:path <https://data.vlaanderen.be/ns/observaties-en-metingen#Observatiecontext.observatie.target>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/Observation#ObservationContext> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#ObservatieprocedureShape> a shacl:NodeShape;
  rdfs:label "Observatieprocedure"@nl;
  <http://purl.org/vocab/vann/usageNote> "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bv de correcte plaatsing van een windmeter (op een welbepaalde hoogte boven het grondoppervlak, bv 10m voor meteorologische waarnemingen). De procedures zijn doorgaans bedoeld om bij meer dan één Bermonstering te worden toegepast.OPMERKING: Een meer uitgebreide beschrijving is te vinden in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP OSLO-SensorenEnBemonstering</a>."@nl;
  rdfs:comment "Een workflow, protocol, plan, algoritme of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geïmplementeerdMet"@nl;
    rdfs:comment "De relatie tussen een procedure (een algorithme, procedure of methode) en de entiteit die de procedure implementeert in een uitvoerde manier."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Observatieprocedure.Geïmplementeerdmet>;
    shacl:class <http://www.w3.org/ns/sosa/Sensor>;
    shacl:description "De relatie tussen een procedure (een algorithme, procedure of methode) en de entiteit die de procedure implementeert in een uitvoerde manier."@nl;
    shacl:name "geïmplementeerdMet"@nl;
    shacl:path <http://www.w3.org/ns/ssn/implementedBy>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Procedure> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#ObservatietypeShape> a shacl:NodeShape;
  rdfs:label "Observatietype"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#ObservatieverzamelingShape> a shacl:NodeShape;
  rdfs:label "Observatieverzameling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv Observaties die op hetzelfde tijdstip plaatsvonden of hetzelfde Object observeren of door dezelfde sensor zijn gemaakt. OPMERKING: Een meer uitgebreide beschrijving is te vinden in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP OSLO-SensorenEnBemonstering</a>."@nl;
  rdfs:comment "Collectie van Observaties met dezelfde kenmerken."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/sosa/ObservationCollection> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#OpmetingShape> a shacl:NodeShape;
  rdfs:label "Opmeting"@nl;
  rdfs:comment "Het bepalen van de precieze omvang van iets door het te meten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "methode"@nl;
    rdfs:comment "Aard van de gebruikte methode."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Opmeting.Methode>;
    shacl:class skos:Concept;
    shacl:description "Aard van de gebruikte methode."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "methode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#Opmeting.methode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdDoor"@nl;
    rdfs:comment "Agent die de Opmeting heeft uitgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Opmeting.Uitgevoerddoor>;
    shacl:class dc:Agent;
    shacl:description "Agent die de Opmeting heeft uitgevoerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "uitgevoerdDoor"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#Opmeting.uitgevoerdDoor>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek#Opmeting> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#OpmetingtypeShape> a shacl:NodeShape;
  rdfs:label "Opmetingtype"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#PeriodeShape> a shacl:NodeShape;
  rdfs:label "Periode"@nl;
  <http://purl.org/vocab/vann/usageNote> "Vergelijkbaar met een Curve in de ruimte, maar ipv een interval tussen twee punten in de ruimte gaat het hier over een interval tussen twee punten op de tijdsas. De bijbehorende tijdsduur is de temporele afstand tussen die twee punten (vergelijkbaar met de afstand tussen twee punten in de ruimte). OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bv time:Interval uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."@nl;
  rdfs:comment "Een 1-dimensionele geometrische primitieve in de tijd."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Period> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#PositionelenauwkeurigheidShape> a shacl:NodeShape;
  rdfs:label "PositioneleNauwkeurigheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Mate waarin de coördinaten van de gegeven absolute, relatieve of pixel-positie overeenstemmen met de werkelijke coördinaten. Bv percentage positionele fouten groter dan 1 meter. OPMERKING: Een meer uitgebreide beschrijving is te vinden in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/datakwaliteit/\">AP OSLO-Datakwaliteit</a>."@nl;
  rdfs:comment "Nauwkeurigheid van de positie van de data in een ruimtelijk referentiesysteem."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19115/2006/DataQualityInformation#DQ_PositionalAccuracy> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#ProcedureShape> a shacl:NodeShape;
  rdfs:label "Procedure"@nl;
  <http://purl.org/vocab/vann/usageNote> "In deze context het uitvoeren van Observaties, Bemonstering of de Bediening van Actuators. Neemt in praktijk de vorm aan van een workflow, protocol, plan, algoritme, berekeningswijze etc."@nl;
  rdfs:comment "Vastgelegde of officiële manier om iets te doen."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/sosa/Procedure> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#ProcesShape> a shacl:NodeShape;
  rdfs:label "Proces"@nl;
  <http://purl.org/vocab/vann/usageNote> "In deze contextde manier waarop het resultaat van een Observatie is verkregen. Dat kan dmv een instrument of een sensor zijn; maar het kan ook een menselijke observator zijn of een simulatie of een verwerking of algoritme toegepast op meer primitieve resultaten. Het Proces vormt samen met het Bemonsteringsobject dat is gebruikt het zgn observatieprotocol. OPGELET: deze klasse is abstract, ze moet gespecialiseerd worden in functie van het applicatiedomein"@nl;
  rdfs:comment "Opeenvolgende acties of stappen noodzakelijk om een resultaat te bekomen."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.OM_Process> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#RuimtelijkbemonsteringsobjectShape> a shacl:NodeShape;
  rdfs:label "RuimtelijkBemonsteringsobject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Wordt gebruikt als het geobserveerd Object een zekere omvang heeft waardoor het niet in zijn geheel geobserveerd kan worden. Afhankelijk van de toegankelijkheid van het Object en de aard van de variatie van het geobserveerd Kenmerk binnen het Object, wordt gekozen voor een RuimtelijkBemonsteringsobject in 1, 2 of 3 dimensies. OPMERKING: Een meer uitgebreide beschrijving is te vinden in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP OSLO-SensorenEnBemonstering</a> en in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/observaties-en-metingen/\">AP OSLO-Observaties en Metingen</a>."@nl;
  rdfs:comment "Ruimtelijk begrensd deel van het Object dat men observeert en dat representatief wordt geacht voor dat Object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "Geometrie van het RuimtelijkBemonsteringsobject."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Ruimtelijkbemonsteringsobject.Geometrie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "Geometrie van het RuimtelijkBemonsteringsobject."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://def.isotc211.org/iso19156/2011/SpatialSamplingFeature#SF_SpatialSamplingFeature.shape>
  ], [
    a shacl:PropertyShape;
    rdfs:label "positioneleNauwkeurigheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Kardinaliteit is maximaal 2 opdat zowel horizontale als verticale positionele nauwkeurigheid zou kunnen worden opgegeven. Bv. voor de horizontale nauwkeurigheid ve Bemonsteringspunt: straal vd cirkel rond het gemeten punt waarin met 90% zekerheid de werkelijke positie ligt."@nl;
    rdfs:comment "Nauwkeurigheid waarmee de geometrie is bepaald."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Ruimtelijkbemonsteringsobject.Positionelenauwkeurigheid>;
    shacl:class <http://def.isotc211.org/iso19115/2006/DataQualityInformation#DQ_PositionalAccuracy>;
    shacl:description "Nauwkeurigheid waarmee de geometrie is bepaald."@nl;
    shacl:maxCount "2";
    shacl:name "positioneleNauwkeurigheid"@nl;
    shacl:path <http://def.isotc211.org/iso19156/2011/SpatialSamplingFeature#SF_SpatialSamplingFeature.positionalAccuracy>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gehostPlatform"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv. een Procedure vh type \"MonitoringWaterkwaliteit\" die doorlopend in een meetstation wordt uitgevoerd of een Toestel vh type \"Windmeter\" dat daar is geïnstalleerd."@nl;
    rdfs:comment "Procedure die of instrument dat in of op het RuimtelijkBemonsteringsobject is geïnstalleerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Ruimtelijkbemonsteringsobject.Gehostplatform>;
    shacl:class <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.OM_Process>;
    shacl:description "Procedure die of instrument dat in of op het RuimtelijkBemonsteringsobject is geïnstalleerd."@nl;
    shacl:name "gehostPlatform"@nl;
    shacl:path <http://def.isotc211.org/iso19156/2011/SpatialSamplingFeature#SF_SpatialSamplingFeature.hostedProcedure>
  ];
  shacl:targetClass <http://def.isotc211.org/iso19156/2011/SpatialSamplingFeature#SF_SpatialSamplingFeature> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#SensorShape> a shacl:NodeShape;
  rdfs:label "Sensor"@nl;
  <http://purl.org/vocab/vann/usageNote> "Sensoren genereren een resultaat op basis van een Stimulus, ttz een verandering in de omgeving, of op basis van resultaten van andere Observaties. Ze worden typisch gehost door een Platform. Voorbeelden zijn snelheidsmeters, gyroscopen, barometers, magnetometers gemonteerd op een smart phone. Ook bv het menselijk oog kan beschouwd worden als een sensor. OPMERKING: Een meer uitgebreide beschrijving van deze klasse is te vinden in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP OSLO-SensorenEnBemonstering</a>."@nl;
  rdfs:comment "Toestel of Agent (incl Personen of software) waarmee Observaties gemaakt worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "implementeert"@nl;
    rdfs:comment "De relatie tussen een entiteit die de procedure op een uitvoerbare manier implementeert en de procedure (een algorithme, procedure of methode)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Sensor.Implementeert>;
    shacl:class <http://www.w3.org/ns/sosa/Procedure>;
    shacl:description "De relatie tussen een entiteit die de procedure op een uitvoerbare manier implementeert en de procedure (een algorithme, procedure of methode)."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "implementeert"@nl;
    shacl:path <http://www.w3.org/ns/ssn/implements>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdeObservatie"@nl;
    rdfs:comment "Observatie die met de Sensor is uitrgevoerd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Sensor.Uitgevoerdeobservatie>;
    shacl:class <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation>;
    shacl:description "Observatie die met de Sensor is uitrgevoerd."@nl;
    shacl:name "uitgevoerdeObservatie"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeObservation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "observeert"@nl;
    rdfs:comment "TODO"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#Sensor.Observeert>;
    shacl:class <http://def.isotc211.org/iso19109/2005/GeneralFeatureModel#GF_PropertyType>;
    shacl:description "TODO"@nl;
    shacl:minCount "1";
    shacl:name "observeert"@nl;
    shacl:path <http://todo.com/observeert>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Sensor> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#SoortShape> a shacl:NodeShape;
  rdfs:label "Soort"@nl;
  <http://purl.org/vocab/vann/usageNote> "In deze context het type plant, dier, microbe gebruikt als bioindicator."@nl;
  rdfs:comment "Groep organismen getypeerd door het feit dat ze gezamenlijk vruchtbare nakomelingen kunnen krijgen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/waterkwaliteit#Soort> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#StatistischeobservatieShape> a shacl:NodeShape;
  rdfs:label "StatistischeObservatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "OPMERKING: Een meer uitgebreide beschrijving is te vinden in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/statistiek/\">AP OSLO-Statistiek</a>."@nl;
  rdfs:comment "Een observatie volgens een statistische methodologie."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/waterkwaliteit#StatistischeObservatie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#SysteemShape> a shacl:NodeShape;
  rdfs:label "Systeem"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze componenten kunnen Systemen op zich zijn. In deze context zijn het Systemen die een Observatieprocedure realiseren (typisch een Sensor) of waarmee een Bemonsteringsprocedure wordt uitgevoerd (bv een Boorinstallatie). OPMERKING: Een meer uitgebreide beschrijving is te vinden in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP OSLO-SensorenEnBemonstering</a>."@nl;
  rdfs:comment "Samenhangend geheel van componenten die samen één of meer functies vervullen."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/ssn/System> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#TemporeleentiteitShape> a shacl:NodeShape;
  rdfs:label "TemporeleEntiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Die temporele objecten zijn temporele geometrische primitieven zoals Moment of Periode. Of het zijn composieten van temporele primitieven, bv om de geschiedenis van een fenomeen weer te geven (bv de opeenvolgende Periodes dat het fenomeen zich voordeed). Te gebruiken wanneer bvb beide temporele geometrische primitieven mogelijk zijn. OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bv time:TemporalEntity uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."@nl;
  rdfs:comment "Abstracte klasse voor temporele objecten."@nl;
  shacl:closed false;
  shacl:targetClass <http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Object> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#WaterkwaliteitobservatieverzamelingShape> a shacl:NodeShape;
