    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "Actually the Measurement of the amount of the substance in the Water,usually over some averaging period. Result is how much of the substance is found eg in milligrams-per-liter."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Observation to assess  the chemical Quality of Water by estimating the concentration of a harmful or unsuitable substance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
