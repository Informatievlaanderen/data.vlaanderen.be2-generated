      {
        "@id": "_:df_8_18"
      },
      {
        "@id": "_:df_8_19"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://purl.eu/ns/air-and-water/water#BioticIndexObservation"
      }
    ]
  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/ontwerpstandaard/toolchain4#ChemicalagentconcentrationobservationShape",
