@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#> rdfs:member <https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#WatervoorkomenShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#FysiekvoorkomenShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#DiepwaterShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#DiepwatermetoevervegetatieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#OndiepwaterShape> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#DiepwaterShape> a shacl:NodeShape;
  rdfs:label "DiepWater"@nl;
  rdfs:comment "Oppervlakte volledig bedekt met water en een waterdiepte en/of bodemsubstraat die geen plantengroei toestaat."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#DiepWater> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#DiepwatermetoevervegetatieShape> a shacl:NodeShape;
  rdfs:label "DiepWaterMetOevervegetatie"@nl;
  rdfs:comment "Oppervlakte volledig bedekt met water met beperkte plantengroei aan de oevers."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#DiepWaterMetOevervegetatie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#FysiekvoorkomenShape> a shacl:NodeShape;
  rdfs:label "FysiekVoorkomen"@nl;
  rdfs:comment "Beschrijving van het fysieke voorkomen van het object."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#WaterVoorkomen>,
    <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#DiepWater>,
    <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#DiepWaterMetOevervegetatie>,
    <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#OndiepWater>,
    <https://data.vlaanderen.be/ns/openbaardomein#FysiekVoorkomen> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#OndiepwaterShape> a shacl:NodeShape;
  rdfs:label "OndiepWater"@nl;
  rdfs:comment "Oppervlakte volledig bedekt, maar met bepekte waterdiepte en/of bodemsubstraat die plantengroei toestaat."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#OndiepWater> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/pieter#WatervoorkomenShape> a shacl:NodeShape;
  rdfs:label "WaterVoorkomen"@nl;
  rdfs:comment "Fysiek voorkomen van het oppervlak bestaande uit water."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#WaterVoorkomen>,
    <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#DiepWater>,
    <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#DiepWaterMetOevervegetatie>,
    <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#OndiepWater> .
