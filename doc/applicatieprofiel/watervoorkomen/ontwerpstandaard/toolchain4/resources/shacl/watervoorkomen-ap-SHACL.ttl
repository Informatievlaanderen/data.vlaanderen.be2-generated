@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#> rdfs:member <https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#WaterVoorkomenShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#FysiekVoorkomenShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#DiepWaterShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#DiepWaterMetOevervegetatieShape>,
    <https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#OndiepWaterShape> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#DiepWaterMetOevervegetatieShape> a shacl:NodeShape;
  rdfs:label "Diep water met oevervegetatie"@nl;
  rdfs:comment "Oppervlakte volledig bedekt met water met beperkte plantengroei aan de oevers"@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#DiepWaterMetOevervegetatie> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#DiepWaterShape> a shacl:NodeShape;
  rdfs:label "Diep water"@nl;
  rdfs:comment "Oppervlakte volledig bedekt met water en een waterdiepte en/of bodemsubstraat die geen plantengroei toestaat."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#DiepWater> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#FysiekVoorkomenShape> a shacl:NodeShape;
  rdfs:label "Fysiek voorkomen"@nl;
  rdfs:comment "Beschrijving van het fysieke voorkomen van het object."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein#FysiekVoorkomen> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#OndiepWaterShape> a shacl:NodeShape;
  rdfs:label "Ondiep water"@nl;
  rdfs:comment "Oppervlakte volledig bedekt, maar met bepekte waterdiepte en/of bodemsubstraat die plantengroei toestaat."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#OndiepWater> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/watervoorkomen/ontwerpstandaard/toolchain4#WaterVoorkomenShape> a shacl:NodeShape;
  rdfs:label "Water voorkomen"@nl;
  rdfs:comment "Fysiek voorkomen van het oppervlak bestaande uit water."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/openbaardomein/watervoorkomen#WaterVoorkomen> .
