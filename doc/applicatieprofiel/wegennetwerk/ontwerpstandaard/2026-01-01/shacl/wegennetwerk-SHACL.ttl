    shacl:path <https://data.vlaanderen.be/ns/transportnetwerk#Beheerder.autoriteit>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/transportnetwerk#Beheerder> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#ConnectieShape> a shacl:NodeShape;
  rdfs:label "Connectie"@nl;
  rdfs:comment "Logische verbinding tussen twee of meer Netwerkelementen in verschillende Netwerken."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "verbindt"@nl;
    rdfs:comment "Netwerkelementen die door de Connectie verbonden zijn."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Connectie.Verbindt>;
    shacl:class <https://data.vlaanderen.be/ns/netwerk#Netwerkelement>;
    shacl:description "Netwerkelementen die door de Connectie verbonden zijn."@nl;
    shacl:minCount "2";
    shacl:name "verbindt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#verbindt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de Connectie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Connectie.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de Connectie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Connectie> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#EigenaarShape> a shacl:NodeShape;
