    shacl:name "eigenschap"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#eigenschap>
  ], [
    a shacl:PropertyShape;
    rdfs:label "element"@nl;
    rdfs:comment "Netwerkelement waarnaar de Netwerkreferentie verwijst."@nl;
