<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#StraatnaamShape> a shacl:NodeShape;
  rdfs:label "Straatnaam"@nl;
  rdfs:comment "Adrescomponent met de naam die officieel werd toegekend aan een straat (baan, doorgang, plein) of aan een gehucht en waaraan adressen kunnen zijn gekoppeld."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "homoniem toevoeging"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Toevoeging om dubbele straatnamen (straatnamen met dezelfde naam maar andere ligging in de gemeente en eigen adressen) van elkaar te onderscheiden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Straatnaam.HomoniemToevoeging>;
    shacl:datatype xsd:string;
    shacl:description "Toevoeging om dubbele straatnamen (straatnamen met dezelfde naam maar andere ligging in de gemeente en eigen adressen) van elkaar te onderscheiden."@nl;
    shacl:maxCount "1";
    shacl:name "homoniem toevoeging"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#homoniemToevoeging>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam vd straat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Straatnaam.Straatnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam vd straat."@nl;
    shacl:minCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Actuele toestand van de straatnaam."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Straatnaam.Status>;
    shacl:class skos:Concept;
    shacl:description "Actuele toestand van de straatnaam."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "status"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Straatnaam.status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is toegekend door"@nl;
    <http://purl.org/vocab/vann/usageNote> "In België is dit de gemeente."@nl;
    rdfs:comment "Agent die de straatnaam heeft toegekend."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Straatnaam.IsToegekendDoor>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#Gemeente>;
    shacl:description "Agent die de straatnaam heeft toegekend."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is toegekend door"@nl;
    shacl:path prov:wasAttributedTo
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#Straatnaam> .

