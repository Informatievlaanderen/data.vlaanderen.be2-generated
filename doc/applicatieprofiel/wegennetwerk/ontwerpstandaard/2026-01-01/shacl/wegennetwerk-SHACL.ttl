<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#AantalrijstrokenShape> a shacl:NodeShape;
  rdfs:label "AantalRijstroken"@nl;
  rdfs:comment "Het aantal rijstroken van een wegverbinding."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aantal"@nl;
    rdfs:comment "Het aantal rijstroken."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Aantalrijstroken.Aantal>;
    shacl:datatype xsd:integer;
    shacl:description "Het aantal rijstroken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aantal"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#aantal>
  ], [
    a shacl:PropertyShape;
    rdfs:label "richting"@nl;
    rdfs:comment "Richting waarvoor het aantal geldt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Aantalrijstroken.Richting>;
    shacl:class skos:Concept;
    shacl:description "Richting waarvoor het aantal geldt."@nl;
    shacl:maxCount "1";
    shacl:name "richting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#AantalRijstroken.richting>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aantalRijstrokentype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Geeft bvb aan of het opgegeven aantal het maximaal of minimaal aantal rijstroken is op de wegverbinding."@nl;
    rdfs:comment "Aard van het aantal."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Aantalrijstroken.Aantalrijstrokentype>;
    shacl:class skos:Concept;
    shacl:description "Aard van het aantal."@nl;
    shacl:maxCount "1";
    shacl:name "aantalRijstrokentype"@nl;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#AantalRijstroken> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#AfstandspaalShape> a shacl:NodeShape;
  rdfs:label "Afstandspaal"@nl;
  rdfs:comment "Paaltje of gelijkaardig dat, meestal op regelmatige afstanden, de afstand tov het begin van een route of ander referentiepunt aangeeft."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "afstand"@nl;
    rdfs:comment "Afstand van de Afstandspaal tov het begin van de route of ander referentiepunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Afstandspaal.Afstand>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Afstand van de Afstandspaal tov het begin van de route of ander referentiepunt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "afstand"@nl;
    shacl:path <https://data.vlaanderen.be/ns/transportnetwerk#afstand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "route"@nl;
    rdfs:comment "Route in een transportnetwerk waarlangs de afstandspaal is geplaatst."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Afstandspaal.Route>;
    shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Transportlinkset>;
    shacl:description "Route in een transportnetwerk waarlangs de afstandspaal is geplaatst."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "route"@nl;
    shacl:path <https://data.vlaanderen.be/ns/transportnetwerk#route>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/transportnetwerk#Afstandspaal> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#BeheerderShape> a shacl:NodeShape;
  rdfs:label "Beheerder"@nl;
  rdfs:comment "Agent verantwoordelijk voor het beheer van het Transportobject."@nl;
  shacl:closed false;
