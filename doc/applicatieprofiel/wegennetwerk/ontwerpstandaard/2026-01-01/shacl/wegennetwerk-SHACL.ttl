    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Morfologischewegklasse.Klasse>;
    shacl:class skos:Concept;
    shacl:description "De toegekende morfologische wegklasse."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "klasse"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#klasse>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#MorfologischeWegklasse> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#NetwerkreferentieShape> a shacl:NodeShape;
  rdfs:label "Netwerkreferentie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Laat toe om een Netwerkeigenschap aan een Netwerkelement te koppelen,bvb om aan te geven op welk wegsegment een snelheidsbeperking van toepassing is of langs welke wegsegmenten een fietspad ligt."@nl;
  rdfs:comment "Verwijzing naar een Netwerkelement."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "eigenschap"@nl;
