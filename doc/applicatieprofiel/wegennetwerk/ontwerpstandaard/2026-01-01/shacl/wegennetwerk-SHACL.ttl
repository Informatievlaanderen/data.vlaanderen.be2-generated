<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#EuropesewegShape> a shacl:NodeShape;
  rdfs:label "EuropeseWeg"@nl;
  rdfs:comment "Een verzameling Wegsegmenten of  Weglinksequenties die een route vertegenwoordigt die deel uitmaakt van het internationale E-wegennetwerk, gekenmerkt door het Europese wegummer."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "europeesWegnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> """De code begint altijd met een
letter 'E', gevolgd door een één-, twee- of driecijferig
nummer."""@nl;
    rdfs:comment "Code die de route in het internationale E-wegennetwerk identificeert."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Europeseweg.Europeeswegnummer>;
    shacl:datatype xsd:string;
    shacl:description "Code die de route in het internationale E-wegennetwerk identificeert."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "europeesWegnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#europeesWegnummer>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#EuropeseWeg> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#GerichtelinkShape> a shacl:NodeShape;
  rdfs:label "GerichteLink"@nl;
  rdfs:comment "Link in hetzij zijn positieve, hetzij zijn negatieve richting."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "richting"@nl;
    rdfs:comment "Geeft aan of de richting van de link overeenstemt met zijn positieve of zijn negatieve richting."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Gerichtelink.Richting>;
    shacl:class skos:Concept;
    shacl:description "Geeft aan of de richting van de link overeenstemt met zijn positieve of zijn negatieve richting."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "richting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#richting>
  ], [
    a shacl:PropertyShape;
    rdfs:label "link"@nl;
    rdfs:comment "Verwijzing naar de Link."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Gerichtelink.Link>;
    shacl:class <https://data.vlaanderen.be/ns/netwerk#Link>;
    shacl:description "Verwijzing naar de Link."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "link"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#GerichteLink.link>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#GerichteLink> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#IntegerShape> a shacl:NodeShape;
  rdfs:label "Integer";
  shacl:closed false;
  shacl:targetClass xsd:integer .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#LineairereferentieShape> a shacl:NodeShape;
  rdfs:label "LineaireReferentie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Meer specifiek het deel twee opeenvolgende posities op de Lijn. Bvb op een Lijn van 500 meter het deel tussen de 100 en 400 meter."@nl;
  rdfs:comment "Linkreferentie die verwijst naar een deel van het lineair netwerkelement."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "vanPositie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uitgedrukt in afstand tov het begin van het netwerkelement. Bvb 100meter gerekend vanaf het begin van het netwerkelement. Moet kleiner zijn dan de totPositie en kleiner dan de totale lengte van de Lijn."@nl;
    rdfs:comment "Start van het deel van de Lijn."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Lineairereferentie.Vanpositie>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Start van het deel van de Lijn."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "vanPositie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#vanPositie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "totPositie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uitgedrukt in afstand tov het begin van het netwerkelement. Bvb 400 meter gerekend vanaf het begin van het netwerkelement. Moet groter zijn dan de vanPositie en kleiner dan de totale lengte van de Lijn."@nl;
    rdfs:comment "Einde van het deel van de Lijn."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Lineairereferentie.Totpositie>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Einde van het deel van de Lijn."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "totPositie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#totPositie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#LinkreferentieShape> a shacl:NodeShape;
  rdfs:label "Linkreferentie"@nl;
  rdfs:comment "Netwerkreferentie die verwijst naar een lineair netwerkelement."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "toepassingsrichting"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb is een snelheidsbeperking geldig voor de ene richting of voor de andere of in beide richtingen. Om de ene richting te onderscheiden van de andere staat \"gelijklopend\" voor de richting die gelijkloopt met de digitalisatierichting van het lineair netwerkelement en \"tegengesteld\" voor de richting die tegengesteld is aan de digitalisatierichting. In het geval de referentie niet slaat op de richting van de link, maar op een fenomeen langs de link (bvb een fietspad of straatverlichting), komt \"gelijklopend\" overeen met de rechterkant en \"tegengesteld\" met de linkerkant."@nl;
    rdfs:comment "Richting van de link waarop de referentie van toepassing is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#Linkreferentie.Toepassingsrichting>;
    shacl:class skos:Concept;
    shacl:description "Richting van de link waarop de referentie van toepassing is."@nl;
    shacl:maxCount "1";
    shacl:name "toepassingsrichting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#toepassingsRichting>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Linkreferentie> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegennetwerk/ontwerpstandaard/2026-01-01#MorfologischewegklasseShape> a shacl:NodeShape;
  rdfs:label "MorfologischeWegklasse"@nl;
  rdfs:comment "Een classificatie gebaseerd op de fysieke eigenschappen van de weg."@nl;
  shacl:closed false;
