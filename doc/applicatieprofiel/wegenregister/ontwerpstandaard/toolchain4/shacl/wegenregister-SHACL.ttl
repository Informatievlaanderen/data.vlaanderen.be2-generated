<https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GestructureerdeIdentificatorShape> a shacl:NodeShape;
  rdfs:label "Gestructureerde Identificator"@nl;
  rdfs:comment "Identificator van een object opgesplitst in zijn onderdelen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lokale identificator"@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren binnen de naamruimte."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GestructureerdeIdentificator.LokaleIdentificator>;
    shacl:datatype xsd:string;
    shacl:description "String gebruikt om het object uniek te identificeren binnen de naamruimte."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "lokale identificator"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#lokaleIdentificator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naamruimte"@nl;
    <http://purl.org/vocab/vann/usageNote> "Laat toe om objecten met dezelfde identificator maar van verschillend type en/of afkomstig uit verschillende domeinen uiteen te houden. In praktijk bv een uri samengesteld uit betekenisvolle elementen zoals een domeinnaam, type en concept (bv https://data.vlaanderen.be/id/adres/)."@nl;
    rdfs:comment "String die toegvoegd wordt aan de lokaleidentificator om deze globaal uniek te maken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GestructureerdeIdentificator.Naamruimte>;
    shacl:datatype xsd:string;
    shacl:description "String die toegvoegd wordt aan de lokaleidentificator om deze globaal uniek te maken."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naamruimte"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#naamruimte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "versie-identificator"@nl;
    rdfs:comment "Identificator van de specifieke versie van een object."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GestructureerdeIdentificator.Versie-identificator>;
    shacl:datatype xsd:string;
