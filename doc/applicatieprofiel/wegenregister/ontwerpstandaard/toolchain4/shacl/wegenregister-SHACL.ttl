<https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#EuropeseWegShape> a shacl:NodeShape;
  rdfs:label "Europese Weg"@nl;
  rdfs:comment "Een verzameling weglinksequenties en of individuele weglinks die een route vertegenwoordigt die deel uitmaakt van het internationale E-wegennetwerk, gekenmerkt door zijn Europese routenummer."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "europees wegnummer"@nl;
    rdfs:comment "Code die de route in het internationaal E-wegennetwerk identificeert. De code begint steeds met de letter E en wordt vervolledigd door een getal met 1,2 of 3 cijfers."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#EuropeseWeg.EuropeesWegnummer>;
    shacl:datatype xsd:string;
    shacl:description "Code die de route in het internationaal E-wegennetwerk identificeert. De code begint steeds met de letter E en wordt vervolledigd door een getal met 1,2 of 3 cijfers."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "europees wegnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#europeesWegnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "behoort tot"@nl;
    rdfs:comment "Route die deel uitmaakt van het internationale E-wegennetwerk tot dewelke het Wegsegment behoort. De route wordt gekenmerkt door een Europees wegnummer."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#EuropeseWeg.BehoortTot>;
    shacl:class <https://data.vlaanderen.be/ns/weg#Wegsegment>;
    shacl:description "Route die deel uitmaakt van het internationale E-wegennetwerk tot dewelke het Wegsegment behoort. De route wordt gekenmerkt door een Europees wegnummer."@nl;
    shacl:minCount "1";
    shacl:name "behoort tot"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#EuropeseWeg.behoortTot>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#EuropeseWeg> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GemeentenaamShape> a shacl:NodeShape;
  rdfs:label "Gemeentenaam"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "linkergemeentenaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "De aanduiding links/rechts wordt bepaald adhv de begin- en eindknoop. Men kijkt steeds van begin- naar eindknoop. Dit komt niet altijd overeen met de digitalisatiezin van het wegsegment."@nl;
    rdfs:comment "TODO"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#Gemeentenaam.Linkergemeentenaam>;
    shacl:class <https://data.vlaanderen.be/ns/weg#Wegsegment>;
    shacl:description "TODO"@nl;
    shacl:name "linkergemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#Gemeentenaam.linkergemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtergemeentenaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "De aanduiding links/rechts wordt bepaald adhv de begin- en eindknoop. Men kijkt steeds van begin- naar eindknoop. Dit komt niet altijd overeen met de digitalisatiezin van het wegsegment."@nl;
    rdfs:comment "TODO"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#Gemeentenaam.Rechtergemeentenaam>;
    shacl:class <https://data.vlaanderen.be/ns/weg#Wegsegment>;
    shacl:description "TODO"@nl;
    shacl:name "rechtergemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#Gemeentenaam.rechtergemeentenaam>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#Gemeentenaam> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GenummerdeWegShape> a shacl:NodeShape;
  rdfs:label "Genummerde Weg"@nl;
  rdfs:comment "Een genummerde weg is een weg die in een bepaald land van bovenlokaal belang is of door een hogere overheidsinstantie wordt beheerd, en steeds genummerd wordt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "genummerdeWegnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik hiervoor ident8"@nl;
    rdfs:comment "Technische code van een genummerde weg toegekend door het Agentschap Wegen en Verkeer"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GenummerdeWeg.Genummerdewegnummer>;
    shacl:datatype xsd:string;
    shacl:description "Technische code van een genummerde weg toegekend door het Agentschap Wegen en Verkeer"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "genummerdeWegnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#genummerdeWegnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "behoortTotSet";
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GenummerdeWeg.Behoorttotset>;
    shacl:class <https://data.vlaanderen.be/ns/weg#Wegsegment>;
    shacl:minCount "1";
    shacl:name "behoortTotSet";
    shacl:path <https://data.vlaanderen.be/ns/weg#GenummerdeWeg.behoortTotSet>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#GenummerdeWeg> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GenummerdewegrichtingwaardeShape> a shacl:NodeShape;
  rdfs:label "GenummerdeWegRichtingWaarde";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GeometrieShape> a shacl:NodeShape;
  rdfs:label "Geometrie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijft deze kenmerken dmv punten, lijnen, polygonen en coördinaten"@nl;
  rdfs:comment "Vorm- en positiekenmerken van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "als WKT"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#wktLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in wkt-formaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#Geometrie.AlsWkt>;
    shacl:datatype rdfs:Literal;
    shacl:description "Geometrie uitgedrukt in wkt-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "als WKT"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#asWKT>
  ], [
    a shacl:PropertyShape;
    rdfs:label "als GML"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#gmlLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in gml-formaat."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#Geometrie.AlsGml>;
    shacl:datatype rdfs:Literal;
    shacl:description "Geometrie uitgedrukt in gml-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "als GML"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#asGML>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Geometry> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#GeometriemethodewaardeShape> a shacl:NodeShape;
  rdfs:label "GeometrieMethodeWaarde";
