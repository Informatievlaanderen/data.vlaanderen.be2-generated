<https://data.test-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AantalRijstrokenShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AantalRijstroken.Aantal>;
    shacl:datatype xsd:integer;
    shacl:description "Het aantal door (doorlopende of onderbroken) witte strepen begrensde delen van de rijbaan, plaats biedend aan autoverkeer"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aantal"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#aantal>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AantalRijstroken.Richting>;
    shacl:class skos:Concept;
    shacl:description "De richting waarin het aantal rijstroken geldt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "richting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#richting>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AantalRijstroken.VanPositie>;
    shacl:class <https://data.vlaanderen.be/ns/weg#Lengte>;
    shacl:description "De startpositie, uitgedrukt als de afstand langs de veelhoekslijn vanaf de start van het wegsegment."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "van positie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#vanPositie>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AantalRijstroken.TotPositie>;
    shacl:class <https://data.vlaanderen.be/ns/weg#Lengte>;
    shacl:description "De eindpositie, uitgedrukt als de afstand langs de veelhoekslijn vanaf de start van het wegsegment."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "tot positie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#totPositie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#AantalRijstroken> .

