<https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AantalRijstrokenShape> a shacl:NodeShape;
  rdfs:label "Aantal Rijstroken"@nl;
  rdfs:comment "het aantal rijstroken van een wegsegment"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aantal"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voor Wegsegmenten waarvoor het aantalRijstroken niet relevant is, wordt de waar -9 ingevuld. Voor wegsegmenten waarvoor de waarde niet gekend is, wordt -8 ingevuld."@nl;
    rdfs:comment "Het aantal door (doorlopende of onderbroken) witte strepen begrensde delen van de rijbaan, plaats biedend aan autoverkeer"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AantalRijstroken.Aantal>;
    shacl:datatype xsd:integer;
    shacl:description "Het aantal door (doorlopende of onderbroken) witte strepen begrensde delen van de rijbaan, plaats biedend aan autoverkeer"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "aantal"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#aantal>
  ], [
    a shacl:PropertyShape;
    rdfs:label "richting"@nl;
    <http://purl.org/vocab/vann/usageNote> "De richting wordt bepaald adhv de begin- en eindknoop. Men kijkt steeds van begin- naar eindknoop. Dit komt niet altijd overeen met de digitalisatiezin van het wegsegment."@nl;
    rdfs:comment "De richting waarin het aantal rijstroken geldt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AantalRijstroken.Richting>;
    shacl:class skos:Concept;
    shacl:description "De richting waarin het aantal rijstroken geldt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "richting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#richting>
  ], [
    a shacl:PropertyShape;
    rdfs:label "van positie"@nl;
    rdfs:comment "De startpositie, uitgedrukt als de afstand langs de veelhoekslijn vanaf de start van het wegsegment."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AantalRijstroken.VanPositie>;
    shacl:class <https://data.vlaanderen.be/ns/weg#Lengte>;
    shacl:description "De startpositie, uitgedrukt als de afstand langs de veelhoekslijn vanaf de start van het wegsegment."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "van positie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#vanPositie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "tot positie"@nl;
    rdfs:comment "De eindpositie, uitgedrukt als de afstand langs de veelhoekslijn vanaf de start van het wegsegment."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AantalRijstroken.TotPositie>;
    shacl:class <https://data.vlaanderen.be/ns/weg#Lengte>;
    shacl:description "De eindpositie, uitgedrukt als de afstand langs de veelhoekslijn vanaf de start van het wegsegment."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "tot positie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#totPositie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#AantalRijstroken> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#AfstandShape> a shacl:NodeShape;
  rdfs:label "Afstand"@nl;
  <http://purl.org/vocab/vann/usageNote> "Wees voorzichtig bij het gebruik van afstand waarbij lengte wordt bedoeld. De afstand van begin tot einde van een curve is niet de lengte van de curve, maar vertegenwoordigt de lengte van de kortste curve tussen deze twee punten."@nl;
  rdfs:comment "Gebruikt als een type voor het retourneren van afstanden en mogelijk lengtes."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#Afstand> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/wegenregister/ontwerpstandaard/toolchain4#BeperkingstypewaardeShape> a shacl:NodeShape;
