  rdfs:comment "Activiteit waarbij een bepaalde dienst, ruimte, of object vooraf wordt gereserveerd voor toekomstig gebruik."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gereserveerd door"@nl;
    rdfs:comment "De Agent door wie de Infrastructuur is voorbehouden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatie.GereserveerdDoor>;
    shacl:class dc:Agent;
    shacl:description "De Agent door wie de Infrastructuur is voorbehouden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gereserveerd door"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Reservatie.gereserveerdDoor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gereserveerd voor"@nl;
    rdfs:comment "De Activiteit waarvoor de Infrastructuur is voorbehouden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatie.GereserveerdVoor>;
    shacl:class crm:E7_Activity;
    shacl:description "De Activiteit waarvoor de Infrastructuur is voorbehouden."@nl;
    shacl:name "gereserveerd voor"@nl;
    shacl:path <https://data.vlaanderen.be/ns/zaalreservatie#Reservatie.gereserveerdVoor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "periode"@nl;
    rdfs:comment "De hoeveelheid tijd waarvoor de Reservatie geldt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatie.Periode>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "De hoeveelheid tijd waarvoor de Reservatie geldt."@nl;
    shacl:name "periode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/zaalreservatie#Reservatie.periode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "Huidige toestand, positie, of situatie van een persoon, plaats, object, systeem, of proces op een bepaald moment."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatie.Status>;
    shacl:class <https://data.vlaanderen.be/ns/zaalreservatie#Infrastructuurreservatiestatus>;
    shacl:description "Huidige toestand, positie, of situatie van een persoon, plaats, object, systeem, of proces op een bepaald moment."@nl;
    shacl:minCount "1";
    shacl:name "status"@nl;
    shacl:path <http://www.w3.org/ns/adms#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "buffer"@nl;
    <http://purl.org/vocab/vann/usageNote> "In verband met zaalreservatie wordt een \"buffer\" gebruikt om te voorkomen dat twee evenementen of vergaderingen direct na elkaar gepland worden in dezelfde ruimte. Het is een vaste tijdspanne die na een zaalreservering niet gereserveerd kan worden. Bijvoorbeeld, als een zaal gereserveerd is tussen 10u en 17u en ze kan slechts eenmaal gereserveerd worden per dag, dan is de buffer 8u-10u en 17h-18h (openingsuren van de zaal)."@nl;
    rdfs:comment "Periode die tijd of ruimte creëert voor een proces of handeling."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatie.Buffer>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "Periode die tijd of ruimte creëert voor een proces of handeling."@nl;
    shacl:name "buffer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/zaalreservatie#buffer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "plaatsbeschrijving"@nl;
    rdfs:comment "Gedetailleerd en systematisch vastleggen van de kenmerken, toestand, en specifieke details van een locatie of ruimte."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatie.Plaatsbeschrijving>;
    shacl:class <https://data.vlaanderen.be/ns/zaalreservatie#Plaatsbeschrijving>;
    shacl:description "Gedetailleerd en systematisch vastleggen van de kenmerken, toestand, en specifieke details van een locatie of ruimte."@nl;
    shacl:name "plaatsbeschrijving"@nl;
    shacl:path <https://data.vlaanderen.be/ns/zaalreservatie#plaatsbeschrijving>
  ], [
    a shacl:PropertyShape;
    rdfs:label "infrastructuur"@nl;
    rdfs:comment "Onroerende of roerende voorziening."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatie.Infrastructuur>;
    shacl:class <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Infrastructuur>;
    shacl:description "Onroerende of roerende voorziening."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "infrastructuur"@nl;
    shacl:path <https://data.vlaanderen.be/ns/zaalreservatie#infrastructuur>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/zaalreservatie#Infrastructuurreservatie> .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#InfrastructuurreservatiedienstShape> a shacl:NodeShape;
  rdfs:label "Infrastructuurreservatiedienst"@nl;
  rdfs:comment "Dienst die het mogelijk maakt om infrastructuur te reserveren voor een bepaalde periode."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "Officiële naam van de publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.Titel>;
