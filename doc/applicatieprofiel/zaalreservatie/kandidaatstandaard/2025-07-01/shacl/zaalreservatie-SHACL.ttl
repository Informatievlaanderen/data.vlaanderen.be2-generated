    shacl:maxCount "1";
    shacl:name "heeft contactpunt"@nl;
    shacl:path <http://data.europa.eu/m8g/hasContactPoint>
  ], [
    a shacl:PropertyShape;
    rdfs:label "infrastructuur"@nl;
    rdfs:comment "Onroerende of roerende voorziening."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.Infrastructuur>;
    shacl:class <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Infrastructuur>;
    shacl:description "Onroerende of roerende voorziening."@nl;
    shacl:name "infrastructuur"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#infrastructuur>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft verantwoordelijke"@nl;
    rdfs:comment "De verantwoordelijke Organisatie die de reservatiedienst uitbaat."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.HeeftVerantwoordelijke>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "De verantwoordelijke Organisatie die de reservatiedienst uitbaat."@nl;
    shacl:name "heeft verantwoordelijke"@nl;
    shacl:path <http://data.europa.eu/m8g/hasCompetentAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "produceert"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: een erkenning, financieel voordeel, code, fysiek object, etc."@nl;
    rdfs:comment "Het werkelijke resultaat van de uitvoering van de publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.Produceert>;
