<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#KwantitatievewaardeShape> a shacl:NodeShape;
  rdfs:label "KwantitatieveWaarde"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv de hoogte van een object,het gewicht,de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog,laag ed vallen hier dus niet onder."@nl;
  rdfs:comment "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Kwantitatievewaarde.Waarde>;
    shacl:description "Getal waarmee de kwantiteit van het kenmerk kan worden uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path schemas:value
  ], [
    a shacl:PropertyShape;
    rdfs:label "eenheid"@nl;
    rdfs:comment "De eenheid waarin de waarde is uitgedrukt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Kwantitatievewaarde.Eenheid>;
    shacl:class skos:Concept;
    shacl:description "De eenheid waarin de waarde is uitgedrukt."@nl;
    shacl:maxCount "1";
    shacl:name "eenheid"@nl;
    shacl:path schemas:unitCode
  ];
  shacl:targetClass schemas:QuantitativeValue .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#LangstringShape> a shacl:NodeShape;
  rdfs:label "LangString";
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#LocatieShape> a shacl:NodeShape;
  rdfs:label "Locatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet direct gewerkt worden met Geometrie,GeografischeNaam,Adres etc."@nl;
  rdfs:comment "Een locatie kan een identificeerbare geografische locatie zijn (ISO 19112), maar deze locatie kan ook een niet-geografische locatie zijn, zoals een directory, rij of kolom. Als zodanig zijn er talloze manieren waarop locatie kan worden uitgedrukt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Schriftelijke weergave van kenmerken van iets of iemand."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Locatie.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Schriftelijke weergave van kenmerken van iets of iemand."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Aanduiding waar de site zich bevindt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Locatie.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Aanduiding waar de site zich bevindt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "adres"@nl;
    shacl:path org:siteAddress
  ];
  shacl:targetClass prov:Location .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#MomentShape> a shacl:NodeShape;
  rdfs:label "Moment"@nl;
  rdfs:comment "TemporeleEntiteit met omvang en duur nul."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "in XSD datumTijd"@nl;
    rdfs:comment "Positie ve Moment, uitgedrukt dmv xsd:dateTime."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Moment.InXsdDatumtijd>;
    shacl:datatype xsd:dateTime;
    shacl:description "Positie ve Moment, uitgedrukt dmv xsd:dateTime."@nl;
    shacl:maxCount "1";
    shacl:name "in XSD datumTijd"@nl;
    shacl:path <http://www.w3.org/2006/time#inXSDDateTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "in EDTF"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik <a href=\"http://id.loc.gov/datatypes/edtf/EDTF\">http://id.loc.gov/datatypes/edtf/EDTF</a> als datatype van de Literal en een String in EDTF-formaat als waarde. EDTF is en uitgebreide set van notaties voor het vastleggen van datums, tijden en tijdsintervallen, inclusief onzekere of benaderde datums, herhalende datums en open tijdsintervallen. Voorbeelden: 1980/1984 (periode 1980-1984), 1984? (jaar onzeker), 1984~ (jaar bij benadering), 19XX (20ste eeuw), /1980 (periode met onbekend begin), 1984 (ergens in 1984). Zie <a href=\"https://www.loc.gov/standards/datetime/\">EDTF</a> voor meer info."@nl;
    rdfs:comment "Positie van een Moment, uitgedrukt in EDTF."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Moment.InEdtf>;
    shacl:description "Positie van een Moment, uitgedrukt in EDTF."@nl;
    shacl:maxCount "1";
    shacl:name "in EDTF"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <https://periodo.github.io/edtf-ontology/edtfo.ttl#hasEDTFDateTimeDescription>
  ];
  shacl:targetClass <http://www.w3.org/2006/time#Instant> .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#OpeningsurenspecificatieShape> a shacl:NodeShape;
  rdfs:label "Openingsurenspecificatie"@nl;
  rdfs:comment "Informatie over de openingsuren ve plaats of dienst."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "dag van week"@nl;
    <http://purl.org/vocab/vann/usageNote> "Zie https://schema.org/DayOfWeek voor lijst van mogelijke waarden."@nl;
    rdfs:comment "Dag van de week waarvoor de openingsuren geldig zijn."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Openingsurenspecificatie.DagVanWeek>;
    shacl:datatype xsd:anyURI;
    shacl:description "Dag van de week waarvoor de openingsuren geldig zijn."@nl;
    shacl:maxCount "1";
    shacl:name "dag van week"@nl;
    shacl:path schemas:dayOfWeek
  ], [
    a shacl:PropertyShape;
    rdfs:label "geldig tot"@nl;
    rdfs:comment "Datum tot wanneer de opgegeven openingsuren gelden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Openingsurenspecificatie.GeldigTot>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum tot wanneer de opgegeven openingsuren gelden."@nl;
    shacl:maxCount "1";
    shacl:name "geldig tot"@nl;
    shacl:path schemas:validThrough
  ], [
    a shacl:PropertyShape;
    rdfs:label "geldig van"@nl;
    rdfs:comment "Datum vanaf wanneer de opgegeven openingsuren gelden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Openingsurenspecificatie.GeldigVan>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum vanaf wanneer de opgegeven openingsuren gelden."@nl;
    shacl:maxCount "1";
    shacl:name "geldig van"@nl;
    shacl:path schemas:validFrom
  ], [
    a shacl:PropertyShape;
    rdfs:label "gesloten"@nl;
    rdfs:comment "Sluitingsuur van de plaats of dienst op de opgegeven dag vd week."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Openingsurenspecificatie.Gesloten>;
    shacl:datatype xsd:time;
    shacl:description "Sluitingsuur van de plaats of dienst op de opgegeven dag vd week."@nl;
    shacl:maxCount "1";
    shacl:name "gesloten"@nl;
    shacl:path schemas:closes
  ], [
    a shacl:PropertyShape;
    rdfs:label "open"@nl;
    rdfs:comment "Openingsuur van de plaats of dienst op de opgegeven dag vd week."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Openingsurenspecificatie.Open>;
    shacl:datatype xsd:time;
    shacl:description "Openingsuur van de plaats of dienst op de opgegeven dag vd week."@nl;
    shacl:maxCount "1";
    shacl:name "open"@nl;
    shacl:path schemas:opens
  ];
  shacl:targetClass schemas:OpeningHoursSpecification .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als Agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen, etc."@nl;
    rdfs:comment "Contactgegevens die al dan niet publiek zijn."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Organisatie.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Contactgegevens die al dan niet publiek zijn."@nl;
    shacl:maxCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ];
  shacl:targetClass org:Organization .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#ParkeercapaciteitShape> a shacl:NodeShape;
  rdfs:label "Parkeercapaciteit"@nl;
  rdfs:comment "Capaciteit van een civiele structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "totale capaciteit"@nl;
    rdfs:comment "Geeft de capaciteit van een hulpbron aan. Bijvoorbeeld: parkeervoorziening, auto, fiets etc."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Parkeercapaciteit.TotaleCapaciteit>;
    shacl:datatype xsd:integer;
    shacl:description "Geeft de capaciteit van een hulpbron aan. Bijvoorbeeld: parkeervoorziening, auto, fiets etc."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "totale capaciteit"@nl;
    shacl:path <http://schema.mobivoc.org/#totalCapacity>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geldig voor voertuig"@nl;
    <http://purl.org/vocab/vann/usageNote> "Kan een auto, fiets, step zijn… Capaciteit van een parkeerplaats kan voor het ene voertuig anders zijn dan een ander, bijvoorbeeld: er kunnen 6 fietsen gestald worden op dezelfde parkeerplaats als 1 auto."@nl;
    rdfs:comment "Soort voertuig waarvoor de parkeercapiciteit geldig is voor is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Parkeercapaciteit.GeldigVoorVoertuig>;
    shacl:class schemas:Vehicle;
    shacl:description "Soort voertuig waarvoor de parkeercapiciteit geldig is voor is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geldig voor voertuig"@nl;
    shacl:path <http://schema.mobivoc.org/#validForVehicle>
  ];
  shacl:targetClass <http://schema.mobivoc.org/#Capacity> .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#PeriodeShape> a shacl:NodeShape;
  rdfs:label "Periode"@nl;
  rdfs:comment "TemporeleEntiteit waarvan de omvang en duurtijd verschilt van nul, ttz waarvoor de begin- en eindwaarde verschillend zijn."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "in EDTF"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik <a href=\"http://id.loc.gov/datatypes/edtf/EDTF\">http://id.loc.gov/datatypes/edtf/EDTF</a> als datatype van de Literal en een String in EDTF-formaat als waarde. EDTF is en uitgebreide set van notaties voor het vastleggen van datums, tijden en tijdsintervallen, inclusief onzekere of benaderde datums, herhalende datums en open tijdsintervallen. Voorbeelden: 1980/1984 (periode 1980-1984), 1984? (jaar onzeker), 1984~ (jaar bij benadering), 19XX (20ste eeuw), /1980 (periode met onbekend begin), 1984 (ergens in 1984). Zie <a href=\"https://www.loc.gov/standards/datetime/\">EDTF</a> voor meer info."@nl;
    rdfs:comment "Periode uitgedrukt in EDTF."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Periode.InEdtf>;
    shacl:description "Periode uitgedrukt in EDTF."@nl;
    shacl:maxCount "1";
    shacl:name "in EDTF"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <https://periodo.github.io/edtf-ontology/edtfo.ttl#hasEDTFDateTimeDescription>
  ], [
    a shacl:PropertyShape;
    rdfs:label "tot"@nl;
    rdfs:comment "Einde van de TemporeleEntiteit."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Periode.Tot>;
    shacl:class <http://www.w3.org/2006/time#Instant>;
    shacl:description "Einde van de TemporeleEntiteit."@nl;
    shacl:maxCount "1";
    shacl:name "tot"@nl;
    shacl:path <http://www.w3.org/2006/time#hasEnd>
  ], [
    a shacl:PropertyShape;
    rdfs:label "van"@nl;
    rdfs:comment "Start van de TemporeleEntiteit."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Periode.Van>;
    shacl:class <http://www.w3.org/2006/time#Instant>;
    shacl:description "Start van de TemporeleEntiteit."@nl;
    shacl:maxCount "1";
    shacl:name "van"@nl;
    shacl:path <http://www.w3.org/2006/time#hasBeginning>
  ];
  shacl:targetClass <http://www.w3.org/2006/time#ProperInterval> .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen, etc."@nl;
    rdfs:comment "Contactgegevens die al dan niet publiek zijn."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Persoon.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Contactgegevens die al dan niet publiek zijn."@nl;
    shacl:maxCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#PlaatsShape> a shacl:NodeShape;
  rdfs:label "Plaats"@nl;
  rdfs:comment "Een ruimtelijk gebied of benoemde plaats."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "plaatsnaam"@nl;
    rdfs:comment "Naam van de plaats of van het gebied."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Plaats.Plaatsnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van de plaats of van het gebied."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "plaatsnaam"@nl;
    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "Geometrie van de plaats of het gebied."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Plaats.Geometrie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "Geometrie van de plaats of het gebied."@nl;
    shacl:maxCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass dc:Location .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#PlaatsbeschrijvingShape> a shacl:NodeShape;
  rdfs:label "Plaatsbeschrijving"@nl;
  rdfs:comment "Gedetailleerd document dat de staat van een onroerend goed beschrijft op een bepaald moment."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Details van de plaatsbeschrijving."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Plaatsbeschrijving.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Details van de plaatsbeschrijving."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "tijdstip"@nl;
    rdfs:comment "Tijdstip waarop de plaatsbeschrijving heeft plaatsgevonden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Plaatsbeschrijving.Tijdstip>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de plaatsbeschrijving heeft plaatsgevonden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "tijdstip"@nl;
    shacl:path <http://www.w3.org/2006/time#hasTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "document"@nl;
    rdfs:comment "Verwijzing naar het document van de plaatsbeschrijving."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Plaatsbeschrijving.Document>;
    shacl:class foaf:Document;
    shacl:description "Verwijzing naar het document van de plaatsbeschrijving."@nl;
    shacl:name "document"@nl;
    shacl:path dc:references
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/zaalreservatie#Plaatsbeschrijving> .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#PubliekeDienstverleningShape> a shacl:NodeShape;
  rdfs:label "Publieke Dienstverlening"@nl;
  <http://purl.org/vocab/vann/usageNote> "De dienstverlening vormt een aanbod (dat dus niet noodzakelijk wordt gebruikt). Ze houdt niet noodzakelijk het opnemen van een recht in,de dienstverlening kan de gebruiker ook toelaten een verplichting te vervullen."@nl;
  rdfs:comment "Een publieke dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen hiervan."@nl;
  shacl:closed false;
  shacl:targetClass <http://purl.org/vocab/cpsv#PublicService> .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#PubliekeOrganisatieShape> a shacl:NodeShape;
  rdfs:label "Publieke Organisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "De overheids- en semioverheidsorganisaties die tot men zo tot de publieke sector kan rekenen worden in Europese richtlijn 2003/98/EG \"openbaar lichaam\" genoemd en gedefinieerd als: \"de staat, zijn territoriale lichamen, publiekrechtelijke instellingen, en verenigingen gevormd door een of meer van deze lichamen of een of meer van deze publiekrechtelijke instellingen\". En onder een publiekrechtelijke instelling verstaat men \" iedere instelling die a) is opgericht met het specifieke doel te voorzien in behoeften van algemeen belang die niet van industriële of commerciële aard zijn, en b) rechtspersoonlijkheid heeft, en c) waarvan hetzij de activiteiten in hoofdzaak door de staat of zijn territoriale lichamen of andere publiekrechtelijke instellingen worden gefinancierd, hetzij het beheer is onderworpen aan toezicht door deze laatste, hetzij de leden van het bestuursorgaan, het leidinggevend orgaan of het toezichthoudend orgaan voor meer dan de helft door de staat, zijn territoriale lichamen of andere publiekrechtelijke instellingen zijn aangewezen.\"."@nl;
  rdfs:comment "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector,ongeacht het bestuursniveau waarop dat kader van kracht is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#PubliekeOrganisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Adres vd vestiging."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#PubliekeOrganisatie.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Adres vd vestiging."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path <http://data.europa.eu/m8g/hasContactPoint>
  ], [
    a shacl:PropertyShape;
    rdfs:label "werkingsgebied"@nl;
    rdfs:comment "Administratief gebied dat de Publieke Organisatie dekt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#PubliekeOrganisatie.Werkingsgebied>;
    shacl:class dc:Location;
    shacl:description "Administratief gebied dat de Publieke Organisatie dekt."@nl;
    shacl:name "werkingsgebied"@nl;
    shacl:path dc:spatial
  ];
  shacl:targetClass <http://data.europa.eu/m8g/PublicOrganisation> .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#ReservatieShape> a shacl:NodeShape;
  rdfs:label "Reservatie"@nl;
  rdfs:comment "Activiteit waarbij een bepaalde dienst, ruimte, of object vooraf wordt gereserveerd voor toekomstig gebruik."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Reservatie> .

