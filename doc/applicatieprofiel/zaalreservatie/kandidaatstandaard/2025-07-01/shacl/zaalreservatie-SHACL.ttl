    shacl:description "Beschrijving vd publieke dienstverlening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "trefwoord"@nl;
    rdfs:comment "Sleutelwoord, term, begrip dat de publieke dienst beschrijft."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.Trefwoord>;
    shacl:datatype rdf:langString;
    shacl:description "Sleutelwoord, term, begrip dat de publieke dienst beschrijft."@nl;
    shacl:name "trefwoord"@nl;
    shacl:path dcat:keyword
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb bescherming, gezondheid, recreatie, cultuur en religie, economische zaken."@nl;
    rdfs:comment "Soort publieke dienstverlening."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.Type>;
    shacl:class skos:Concept;
    shacl:description "Soort publieke dienstverlening."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "taal"@nl;
    rdfs:comment "Taal waarin een publieke dienstverlening wordt aangeboden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.Taal>;
    shacl:class skos:Concept;
    shacl:description "Taal waarin een publieke dienstverlening wordt aangeboden."@nl;
    shacl:name "taal"@nl;
    shacl:path dc:language
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "Geeft aan of een publieke dienstverlening actief, inactief, in ontwikkeling etc is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.Status>;
    shacl:class skos:Concept;
    shacl:description "Geeft aan of een publieke dienstverlening actief, inactief, in ontwikkeling etc is."@nl;
    shacl:maxCount "1";
    shacl:name "status"@nl;
    shacl:path <http://www.w3.org/ns/adms#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ruimtelijke dekking"@nl;
    <http://purl.org/vocab/vann/usageNote> "Typisch het werkingsgebied van de verantwoordelijke publieke organisatie."@nl;
    rdfs:comment "Gebied waarin de publieke dienstverlening beschikbaar is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.RuimtelijkeDekking>;
    shacl:class dc:Location;
    shacl:description "Gebied waarin de publieke dienstverlening beschikbaar is."@nl;
    shacl:name "ruimtelijke dekking"@nl;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft contactpunt"@nl;
    <http://purl.org/vocab/vann/usageNote> "Verschillend van de informatie waarmee de publieke organisatie kan worden gecontacteerd."@nl;
    rdfs:comment "Informatie waarmee de publieke dienstverlening kan worden gecontacteerd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.HeeftContactpunt>;
    shacl:class schemas:ContactPoint;
