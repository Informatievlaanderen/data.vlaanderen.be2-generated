    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Toegankelijkheid.Niveau>;
    shacl:class skos:Concept;
    shacl:description "De graad van toegankelijkheid van een infrastructuur."@nl;
    shacl:maxCount "1";
    shacl:name "niveau"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Toegankelijkheid.niveau>
  ], [
    a shacl:PropertyShape;
    rdfs:label "onderdeel"@nl;
    rdfs:comment "Deel van de dienst of infrastructuur waarop de Toegankelijkheid betrekking heeft.."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Toegankelijkheid.Onderdeel>;
    shacl:class skos:Concept;
    shacl:description "Deel van de dienst of infrastructuur waarop de Toegankelijkheid betrekking heeft.."@nl;
    shacl:name "onderdeel"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#onderdeel>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Toegankelijkheid> .

<https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#UriShape> a shacl:NodeShape;
  rdfs:label "URI";
  shacl:closed false;
