    shacl:description "Officiële naam van de publieke dienstverlening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieve label"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: commerciële naam, informele naam, etc."@nl;
    rdfs:comment "Andere naam waaronder de dienstverlening bekend is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Infrastructuurreservatiedienst.AlternatieveLabel>;
