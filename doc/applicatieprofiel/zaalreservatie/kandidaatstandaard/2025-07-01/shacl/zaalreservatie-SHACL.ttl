    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/zaalreservatie/kandidaatstandaard/2025-07-01#Voertuig.Voertuigtype>;
    shacl:class skos:Concept;
    shacl:description "Het soort voertuig."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voertuigtype"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass schemas:Vehicle .
