{
  "title": "AddressPresentation",
  "type": "object",
  "description": "More readable presentation with only the basic data of the address, intended for the use of an address as an attribute of another object.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse AddressPresentation)",
      "pattern": "^AddressPresentation$"
    },
    "administrativeUnitLevel1": {
      "$ref": "#/components/schemas/AddressPresentation.administrativeUnitLevel1"
    },
    "administrativeUnitLevel2": {
      "$ref": "#/components/schemas/AddressPresentation.administrativeUnitLevel2"
    },
    "addressArea": {
      "$ref": "#/components/schemas/AddressPresentation.addressArea"
    },
    "boxNumber": {
      "$ref": "#/components/schemas/AddressPresentation.boxNumber"
    },
    "municipalityName": {
      "$ref": "#/components/schemas/AddressPresentation.municipalityName"
    },
    "houseNumber": {
      "$ref": "#/components/schemas/AddressPresentation.houseNumber"
    },
    "country": {
      "$ref": "#/components/schemas/AddressPresentation.country"
    },
    "locationIndicator": {
      "type": "array",
      "description": "Alphanumeric code that uniquely identifies the address locator within the street, administrative unit etc. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/AddressPresentation.locationIndicator"
      },
      "minItems": 1
    },
    "locationName": {
      "type": "array",
      "description": "Name or description of the geographical object that the address locator denotes. Lijst van LangString items.",
      "items": {
        "$ref": "#/components/schemas/AddressPresentation.locationName"
      },
      "minItems": 1
    },
    "p.O.Box": {
      "$ref": "#/components/schemas/AddressPresentation.p.O.Box"
    },
    "postalCode": {
      "$ref": "#/components/schemas/AddressPresentation.postalCode"
    },
    "postName": {
      "$ref": "#/components/schemas/AddressPresentation.postName"
    },
    "streetName": {
      "$ref": "#/components/schemas/AddressPresentation.streetName"
    },
    "fullAddress": {
      "$ref": "#/components/schemas/AddressPresentation.fullAddress"
    },
    "description": {
      "$ref": "#/components/schemas/AddressPresentation.description"
    },
    "address": {
      "$ref": "#/components/schemas/AddressPresentation"
    }
  },
  "required": [
    "@type",
    "description",
    "address"
  ]
}