{
  "title": "LocationDescription",
  "type": "object",
  "description": "Detailed document describing the condition of a property at a given time.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse LocationDescription)",
      "pattern": "^LocationDescription$"
    },
    "description": {
      "$ref": "#/components/schemas/LocationDescription.description"
    },
    "time": {
      "$ref": "#/components/schemas/LocationDescription.time"
    },
    "document": {
      "type": "array",
      "description": "Reference to the inventory of fixtures and fittings document. Lijst van Document items.",
      "items": {
        "$ref": "#/components/schemas/Document"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "description",
    "time"
  ]
}