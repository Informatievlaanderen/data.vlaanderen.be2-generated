{
  "title": "KwantitatieveWaarde",
  "type": "object",
  "description": "Aanduiding van de kwantiteit van een bepaald kenmerk van een object.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse KwantitatieveWaarde)",
      "pattern": "^KwantitatieveWaarde$"
    },
    "waarde": {
      "$ref": "#/components/schemas/KwantitatieveWaarde.waarde"
    },
    "eenheid": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Concept"
        },
        {
          "$ref": "#/components/schemas/Eenheid"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Concept": "#/components/schemas/Concept",
          "Eenheid": "#/components/schemas/Eenheid"
        }
      }
    }
  },
  "required": [
    "@type",
    "waarde"
  ]
}