{
  "title": "Plaatsbeschrijving",
  "type": "object",
  "description": "Gedetailleerd document dat de staat van een onroerend goed beschrijft op een bepaald moment.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Plaatsbeschrijving)",
      "pattern": "^Plaatsbeschrijving$"
    },
    "beschrijving": {
      "$ref": "#/components/schemas/Plaatsbeschrijving.beschrijving"
    },
    "tijdstip": {
      "$ref": "#/components/schemas/Plaatsbeschrijving.tijdstip"
    },
    "document": {
      "type": "array",
      "description": "Verwijzing naar het document van de plaatsbeschrijving. Lijst van Document items.",
      "items": {
        "$ref": "#/components/schemas/Document"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "beschrijving",
    "tijdstip"
  ]
}