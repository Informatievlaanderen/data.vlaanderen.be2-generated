<https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#ActiviteitShape> a shacl:NodeShape;
  rdfs:label "Activiteit"@nl;
  rdfs:comment "De gelegenheid of bezigheid waarvoor de Infrastructuur wordt gebruikt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "De soort activiteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#Activiteit.Type>;
    shacl:class skos:Concept;
    shacl:description "De soort activiteit."@nl;
    shacl:name "type"@nl;
    shacl:path <https://data.vlaanderen.be/ns/doelgericht-digitaal-transformeren#Gebruik.activiteit>
  ];
  shacl:targetClass crm:E7_Activity .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#ActiviteittypeShape> a shacl:NodeShape;
