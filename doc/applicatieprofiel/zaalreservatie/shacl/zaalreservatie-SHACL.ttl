    shacl:maxCount "1";
    shacl:name "laatste openbaar vervoer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Bereikbaarheid.laasteOpenbaarVervoer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "mobiscore"@nl;
    rdfs:comment "Een index die aangeeft hoe goed een locatie scoort op vlak van mobiliteit."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#Bereikbaarheid.Mobiscore>;
    shacl:datatype xsd:integer;
    shacl:description "Een index die aangeeft hoe goed een locatie scoort op vlak van mobiliteit."@nl;
    shacl:maxCount "1";
    shacl:name "mobiscore"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Bereikbaarheid.mobiscore>
  ], [
    a shacl:PropertyShape;
    rdfs:label "parkeercapaciteit"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit omvat zowel reguliere parkeerplaatsen als speciale parkeerplaatsen, zoals die voor mindervaliden, elektrische voertuigen of fietsen."@nl;
    rdfs:comment "Het aantal voertuigen dat in een specifieke parkeervoorziening kan worden ondergebracht"@nl;
