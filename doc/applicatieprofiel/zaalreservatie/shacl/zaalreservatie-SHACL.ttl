<https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Contactgegevens die al dan niet publiek zijn."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#Agent.Contactinfo>;
    shacl:class schema:ContactPoint;
    shacl:description "Contactgegevens die al dan niet publiek zijn."@nl;
    shacl:maxCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path schema:ContactPoint
  ];
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#BereikbaarheidShape> a shacl:NodeShape;
  rdfs:label "Bereikbaarheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "De bereikbaarheid betreft de mogelijkheden die er zijn om tot een bestemming te komen."@nl;
  rdfs:comment "De mate waarin een plaats te bereiken is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "laatste openbaar vervoer"@nl;
    rdfs:comment "Het tijdstip waarop het openbaar vervoer ten laatste gebruikt kan worden op de bestemming."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#Bereikbaarheid.LaatsteOpenbaarVervoer>;
