    shacl:name "parkeercapaciteit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#parkeercapaciteit>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Bereikbaarheid> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#BeschikbaarheidShape> a shacl:NodeShape;
  rdfs:label "Beschikbaarheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv uren waarin een dienst wordt aangeboden of openingsuren van een gebouw."@nl;
  rdfs:comment "De mate waarin de infrastructuur gebruikt kan worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "openingsuren"@nl;
    <http://purl.org/vocab/vann/usageNote> "Syntax volgens schema.org voor openingsuren. Bv als contact kan worden opgenomen tussen 8 en 20u maandag tot zaterdag en tussen 8 en 18u op zondag wordt dit gecodeerd als Ma-za 08:00-20:00, zo 08:00-18:00."@nl;
    rdfs:comment "Het tijdstip waarop de infrastructuur beschikbaar is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#Beschikbaarheid.Openingsuren>;
    shacl:datatype rdfs:Literal;
    shacl:description "Het tijdstip waarop de infrastructuur beschikbaar is."@nl;
    shacl:maxCount "1";
    shacl:name "openingsuren"@nl;
    shacl:path schema:openingHours
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruiker"@nl;
    rdfs:comment "Het type gebruiker dat over de infrastructuur mag beschikken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#Beschikbaarheid.Gebruiker>;
    shacl:class skos:Concept;
    shacl:description "Het type gebruiker dat over de infrastructuur mag beschikken."@nl;
    shacl:maxCount "1";
    shacl:name "gebruiker"@nl;
    shacl:path <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Beschikbaarheid.gebruiker>
  ], [
    a shacl:PropertyShape;
    rdfs:label "periode"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv startdatum zonder einddatum voor dienstverlening die nog actief is of een aanduiding van het seizoen waarin de dienstverlening wordt aangeboden. Een ingevulde einddatum geeft aan wanneer de dienstverlening werd beëindigd. Begin- en einddatum volgens ISO8601 syntax."@nl;
    rdfs:comment "Het tijdsinterval waarin een infrastructuur beschikbaar is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#Beschikbaarheid.Periode>;
    shacl:class schema:OpeningHoursSpecification;
    shacl:description "Het tijdsinterval waarin een infrastructuur beschikbaar is."@nl;
    shacl:maxCount "1";
    shacl:name "periode"@nl;
    shacl:path <http://data.europa.eu/m8g/PeriodOfTime>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Beschikbaarheid> .

