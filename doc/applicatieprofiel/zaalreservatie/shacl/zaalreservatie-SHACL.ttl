    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "adres"@nl;
    shacl:path org:siteAddress
  ];
  shacl:targetClass dc:Location,
    prov:Location .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/zaalreservatie/ontwerpstandaard/2025-04-18#OpeningsurenspecificatieShape> a shacl:NodeShape;
