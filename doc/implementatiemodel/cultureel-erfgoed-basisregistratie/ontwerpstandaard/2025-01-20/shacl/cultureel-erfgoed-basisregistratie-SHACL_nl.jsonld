    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Gebruik deze klasse om informatie over het ontstaan (de Productie) van een Materieel Mensgemaakt Ding uit te wisselen (in dit model vertegenwoordigd door Mensgemaakt Object). Niet te verwarren met de klasse Creatie, die enkel gebruikt mag worden voor Conceptuele Objecten zoals Sets en InformatieObjecten."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Activiteit die leidt tot en slaagt in het ontstaan van een Materieel Ding."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Productie"
      }
