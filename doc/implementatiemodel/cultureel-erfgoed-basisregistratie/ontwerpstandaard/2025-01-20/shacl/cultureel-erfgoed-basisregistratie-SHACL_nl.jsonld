    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Sets zijn niet materieel omdat ze anders samen met de objecten die er deel van uit maken zouden kunnen worden vernietigd. Een Set kan nul items bevatten. Bruikbaar bvb voor het beschrijven van museale collecties of lijsten met favoriete objecten. Kan indien gewenst voor archieven gemapt worden op Recordset of Record uit <a href=\"https://www.ica.org/standards/RiC/RiC-O_1-0-2.html\">RiC-O</a>."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Conceptuele groepering van Entiteiten."
      }
