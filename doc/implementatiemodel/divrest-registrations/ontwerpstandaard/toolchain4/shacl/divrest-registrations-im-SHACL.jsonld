  },
  {
    "@id": "https://data.dev-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#FormeleOrganisatieShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Bvb een bedrijf,een vzw,een overheidsorgaan,een kerkgemeenschap."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een erkende organisatie, erkend in brede zin of  meer specifiek in juridische zin met bijbehorende rechten en plichten."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Formele Organisatie"
      }
    ],
