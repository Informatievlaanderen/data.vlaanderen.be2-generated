        "@language": "nl",
        "@value": "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."
      }
    ],
