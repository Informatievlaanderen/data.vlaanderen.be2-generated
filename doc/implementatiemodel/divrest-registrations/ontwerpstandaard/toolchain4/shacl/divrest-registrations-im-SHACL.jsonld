    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Bvb '20170901' als string en 'datum' als type. Laat automatische interpretatie vd string toe."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Combinatie van een string en het type van wat de string voorstelt."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
