<https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#AdresvoorstellingShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.busnummer>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#gemeentenaam>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.huisnummer>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#Adresvoorstelling.Land>;
    shacl:datatype rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#Adresvoorstelling.Straatnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Straatnaam vh adres."@nl;
    shacl:maxCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#ContactinfoShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:targetClass schemas:ContactPoint .

<https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#FormeleOrganisatieShape> a shacl:NodeShape;
