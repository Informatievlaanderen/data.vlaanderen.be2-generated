    shacl:path skos:prefLabel
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#Organisatie.Type>;
    shacl:class skos:Concept;
    shacl:description "Soort organisatie."@nl;
    shacl:name "type"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgType>
  ];
