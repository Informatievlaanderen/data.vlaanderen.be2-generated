  shacl:targetClass org:FormalOrganization .

<https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#GeregistreerdPersoonShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#GeregistreerdPersoon.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificatiecode vd persoon ih register."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#registratie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatieShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Rechtsvorm>;
    shacl:class skos:Concept;
    shacl:description "Juridisch statuut van de geregistreerde organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "rechtsvorm"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#rechtsvorm>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#GeregistreerdeOrganisatie.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator dat de organisatie verkreeg bij registratie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ];
  shacl:targetClass <http://www.w3.org/ns/regorg#RegisteredOrganization> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/divrest-registrations/ontwerpstandaard/toolchain4#GetypeerdeStringShape> a shacl:NodeShape;
