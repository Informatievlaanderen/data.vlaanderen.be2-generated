{
  "title": "ActiviteitDossier",
  "type": "object",
  "description": "Handeling van bepaalde duur op of met entiteiten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse ActiviteitDossier)",
      "pattern": "^ActiviteitDossier$"
    },
    "einddatum": {
      "type": "object",
      "description": "De einddatum van de activiteit.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "naam": {
      "type": "object",
      "description": "De naam van de activiteit.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "startdatum": {
      "type": "object",
      "description": "De startdatum van de activiteit.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "dossierType": {
      "$ref": "#/components/schemas/Activiteittype"
    },
    "vindtPlaatsTijdens": {
      "type": "array",
      "description": "Lijst van Zaak items.",
      "items": {
        "$ref": "#/components/schemas/Zaak"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "einddatum",
    "naam",
    "startdatum",
    "dossierType"
  ]
}