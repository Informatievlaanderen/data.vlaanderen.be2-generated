    shacl:path dc:Agent
  ], [
    a shacl:PropertyShape;
    rdfs:label "indiener"@nl;
    rdfs:comment "Agent die de Melding heeft aangemaakt en/of ingediend."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/geluidsmeldingen-en-geluidsmetingen/ontwerpstandaard/2026-05-20#Melding.Indiener>;
    shacl:class dc:agent;
    shacl:description "Agent die de Melding heeft aangemaakt en/of ingediend."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "indiener"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#indiener>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft doelwit"@nl;
    rdfs:comment "De relatie tussen de Melding en het doelwit, het Meldingsobject waarop de melding slaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/geluidsmeldingen-en-geluidsmetingen/ontwerpstandaard/2026-05-20#Melding.HeeftDoelwit>;
    shacl:description "De relatie tussen de Melding en het doelwit, het Meldingsobject waarop de melding slaat."@nl;
    shacl:name "heeft doelwit"@nl;
    shacl:or ([shacl:class <http://www.w3.org/ns/sosa/FeatureOfInterest>] [shacl:class dcmitype:Collection] [shacl:class <http://www.w3.org/ns/sosa/ObservationCollection>] [shacl:class <https://data.vlaanderen.be/ns/melding#Melding>] [shacl:class <https://data.vlaanderen.be/ns/omgevingsvergunning#Vergunning>] [shacl:class prov:Activity] [shacl:class schemas:Event] [shacl:class <https://data.vlaanderen.be/ns/waterkwaliteit#Meetpunt>]);
    shacl:path oa:hasTarget
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/melding#Melding> .

