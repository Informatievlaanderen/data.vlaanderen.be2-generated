    shacl:description "Aard van het Bemonsteringsobject."@nl;
    shacl:maxCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "Geometrie van het Meetpunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/geluidsmeldingen-en-geluidsmetingen/ontwerpstandaard/2026-05-20#Meetpunt.Geometrie>;
    shacl:class <http://www.opengis.net/ont/sf#Point>;
    shacl:description "Geometrie van het Meetpunt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "geometrie"@nl;
    shacl:path <http://www.opengis.net/ont/geosparql#hasGeometry>
  ], [
