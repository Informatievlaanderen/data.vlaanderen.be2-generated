{
  "title": "Gebeurtenis",
  "type": "object",
  "description": "Iets dat gebeurt of plaatsvindt,doorgaans iets van enig belag.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Gebeurtenis)",
      "pattern": "^Gebeurtenis$"
    },
    "beschrijving": {
      "type": "object",
      "description": "Beschrijving van de gebeurtenis.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "naam": {
      "type": "object",
      "description": "Naam van de gebeurtenis.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "tijd": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/TemporeleEntiteit"
        },
        {
          "$ref": "#/components/schemas/Moment"
        },
        {
          "$ref": "#/components/schemas/Periode"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "TemporeleEntiteit": "#/components/schemas/TemporeleEntiteit",
          "Moment": "#/components/schemas/Moment",
          "Periode": "#/components/schemas/Periode"
        }
      }
    },
    "plaats": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Locatie"
        },
        {
          "$ref": "#/components/schemas/Plaats"
        },
        {
          "$ref": "#/components/schemas/BelgischAdres"
        },
        {
          "$ref": "#/components/schemas/GeografischeNaam"
        },
        {
          "$ref": "#/components/schemas/Adresvoorstelling"
        },
        {
          "$ref": "#/components/schemas/Geometrie"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Locatie": "#/components/schemas/Locatie",
          "Plaats": "#/components/schemas/Plaats",
          "BelgischAdres": "#/components/schemas/BelgischAdres",
          "GeografischeNaam": "#/components/schemas/GeografischeNaam",
          "Adresvoorstelling": "#/components/schemas/Adresvoorstelling",
          "Geometrie": "#/components/schemas/Geometrie"
        }
      }
    },
    "type": {
      "$ref": "#/components/schemas/Domeinobjecttype"
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "$ref": "#/components/schemas/Observatie"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "tijd",
    "plaats"
  ]
}