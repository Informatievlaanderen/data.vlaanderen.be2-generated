{
  "title": "Locatie",
  "type": "object",
  "description": "Aanduiding van een geografische positie,dmv coördinaten,een toponiem,een adreslabel,een verwijzing naar een plaats/regio of verwijzing naar een adres.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Locatie)",
      "pattern": "^Locatie$"
    },
    "type": {
      "$ref": "#/components/schemas/Domeinobjecttype"
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "$ref": "#/components/schemas/Observatie"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}