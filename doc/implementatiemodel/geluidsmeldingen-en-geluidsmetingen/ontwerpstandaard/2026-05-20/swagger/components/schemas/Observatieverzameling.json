{
  "title": "Observatieverzameling",
  "type": "object",
  "description": "Collectie van Observaties met dezelfde kenmerken.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Observatieverzameling)",
      "pattern": "^Observatieverzameling$"
    },
    "resultaattijd": {
      "type": "object",
      "description": "De resultaattijd van de Observaties.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "fenomeentijd": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/TemporeleEntiteit"
        },
        {
          "$ref": "#/components/schemas/Moment"
        },
        {
          "$ref": "#/components/schemas/Periode"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "TemporeleEntiteit": "#/components/schemas/TemporeleEntiteit",
          "Moment": "#/components/schemas/Moment",
          "Periode": "#/components/schemas/Periode"
        }
      }
    },
    "gebruikteProcedure": {
      "$ref": "#/components/schemas/Observatieprocedure"
    },
    "geobserveerdKenmerk": {
      "$ref": "#/components/schemas/Kenmerktype"
    },
    "geobserveerdObject": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Object"
        },
        {
          "$ref": "#/components/schemas/Verzameling"
        },
        {
          "$ref": "#/components/schemas/Melding"
        },
        {
          "$ref": "#/components/schemas/Vergunning"
        },
        {
          "$ref": "#/components/schemas/Activiteit"
        },
        {
          "$ref": "#/components/schemas/Gebeurtenis"
        },
        {
          "$ref": "#/components/schemas/Meetpunt"
        },
        {
          "$ref": "#/components/schemas/Locatie"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Object": "#/components/schemas/Object",
          "Verzameling": "#/components/schemas/Verzameling",
          "Melding": "#/components/schemas/Melding",
          "Vergunning": "#/components/schemas/Vergunning",
          "Activiteit": "#/components/schemas/Activiteit",
          "Gebeurtenis": "#/components/schemas/Gebeurtenis",
          "Meetpunt": "#/components/schemas/Meetpunt",
          "Locatie": "#/components/schemas/Locatie"
        }
      }
    },
    "uitgevoerdMetsensor": {
      "$ref": "#/components/schemas/Sensor"
    },
    "heeftLid": {
      "type": "array",
      "description": "Lijst van Object items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Object"
          },
          {
            "$ref": "#/components/schemas/Verzameling"
          },
          {
            "$ref": "#/components/schemas/Melding"
          },
          {
            "$ref": "#/components/schemas/Vergunning"
          },
          {
            "$ref": "#/components/schemas/Activiteit"
          },
          {
            "$ref": "#/components/schemas/Gebeurtenis"
          },
          {
            "$ref": "#/components/schemas/Meetpunt"
          },
          {
            "$ref": "#/components/schemas/Locatie"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Object": "#/components/schemas/Object",
            "Verzameling": "#/components/schemas/Verzameling",
            "Melding": "#/components/schemas/Melding",
            "Vergunning": "#/components/schemas/Vergunning",
            "Activiteit": "#/components/schemas/Activiteit",
            "Gebeurtenis": "#/components/schemas/Gebeurtenis",
            "Meetpunt": "#/components/schemas/Meetpunt",
            "Locatie": "#/components/schemas/Locatie"
          }
        }
      },
      "minItems": 1
    },
    "type": {
      "$ref": "#/components/schemas/Domeinobjecttype"
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "$ref": "#/components/schemas/Observatie"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "heeftLid"
  ]
}