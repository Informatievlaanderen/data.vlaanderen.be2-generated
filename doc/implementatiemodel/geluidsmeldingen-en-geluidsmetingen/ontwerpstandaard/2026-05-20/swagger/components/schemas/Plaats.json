{
  "title": "Plaats",
  "type": "object",
  "description": "Een ruimtelijk gebied of benoemde plaats.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Plaats)",
      "pattern": "^Plaats$"
    },
    "plaatsnaam": {
      "type": "array",
      "description": "Lijst van GeografischeNaam items.",
      "items": {
        "type": "object",
        "description": "Naam van de plaats of van het gebied.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "geometrie": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Geometrie"
        },
        {
          "$ref": "#/components/schemas/Punt"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Geometrie": "#/components/schemas/Geometrie",
          "Punt": "#/components/schemas/Punt"
        }
      }
    },
    "type": {
      "$ref": "#/components/schemas/Domeinobjecttype"
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "$ref": "#/components/schemas/Observatie"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "plaatsnaam"
  ]
}