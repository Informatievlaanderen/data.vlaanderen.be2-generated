{
  "title": "Resource",
  "type": "object",
  "description": "Entiteit waarvan alle entiteiten zijn afgeleid.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Resource)",
      "pattern": "^Resource$"
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "identificator"
  ]
}