{
  "title": "Sensor",
  "type": "object",
  "description": "Toestel of Agent (incl Personen of software) waarmee Observaties gemaakt worden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Sensor)",
      "pattern": "^Sensor$"
    },
    "type": {
      "type": "array",
      "description": "Lijst van Systeemtype items.",
      "items": {
        "$ref": "#/components/schemas/Systeemtype"
      },
      "minItems": 1
    },
    "ligging": {
      "type": "array",
      "description": "Lijst van Locatie items.",
      "items": {
        "$ref": "#/components/schemas/Locatie"
      },
      "minItems": 1
    },
    "uitgevoerdeObservatie": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "$ref": "#/components/schemas/Observatie"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}