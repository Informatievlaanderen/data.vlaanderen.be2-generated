{
  "title": "Meetpunt",
  "type": "object",
  "description": "Plaats waar Observaties plaatsvinden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Meetpunt)",
      "pattern": "^Meetpunt$"
    },
    "identificator": {
      "type": "array",
      "description": "Verwijzing naar de informatie die het Bemonsteringsobject uniek identificeert. Bijvoorbeeld het uniek nummer dat aan een Monster wordt toegekend of het nummer van een meetstation. Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "type": {
      "$ref": "#/components/schemas/Domeinobjecttype"
    },
    "geometrie": {
      "$ref": "#/components/schemas/Punt"
    },
    "bemonsterdObject": {
      "type": "array",
      "description": "Verwijzing naar het Object dat men wil bemonsteren. Verwijzing naar het Object dat men wil bemonsteren. Lijst van Object items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Object"
          },
          {
            "$ref": "#/components/schemas/Verzameling"
          },
          {
            "$ref": "#/components/schemas/Melding"
          },
          {
            "$ref": "#/components/schemas/Vergunning"
          },
          {
            "$ref": "#/components/schemas/Activiteit"
          },
          {
            "$ref": "#/components/schemas/Gebeurtenis"
          },
          {
            "$ref": "#/components/schemas/Meetpunt"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Object": "#/components/schemas/Object",
            "Verzameling": "#/components/schemas/Verzameling",
            "Melding": "#/components/schemas/Melding",
            "Vergunning": "#/components/schemas/Vergunning",
            "Activiteit": "#/components/schemas/Activiteit",
            "Gebeurtenis": "#/components/schemas/Gebeurtenis",
            "Meetpunt": "#/components/schemas/Meetpunt"
          }
        }
      },
      "minItems": 1
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Observaties die op het Object gebeuren. Lijst van Observatie items.",
      "items": {
        "$ref": "#/components/schemas/Observatie"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "identificator",
    "geometrie",
    "bemonsterdObject"
  ]
}