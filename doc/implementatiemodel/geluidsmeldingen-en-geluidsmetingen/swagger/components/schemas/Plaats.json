{
  "title": "Plaats",
  "type": "object",
  "description": "Een ruimtelijk gebied of benoemde plaats.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Plaats)",
      "pattern": "^Plaats$"
    },
    "plaatsnaam": {
      "type": "array",
      "description": "Naam van de plaats of van het gebied. Lijst van GeografischeNaam items.",
      "items": {
        "$ref": "#/components/schemas/Plaats.plaatsnaam"
      },
      "minItems": 1
    },
    "geometrie": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Geometrie"
        },
        {
          "$ref": "#/components/schemas/Punt"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Geometrie": "#/components/schemas/Geometrie",
          "Punt": "#/components/schemas/Punt"
        }
      }
    }
  },
  "required": [
    "@type",
    "plaatsnaam"
  ]
}