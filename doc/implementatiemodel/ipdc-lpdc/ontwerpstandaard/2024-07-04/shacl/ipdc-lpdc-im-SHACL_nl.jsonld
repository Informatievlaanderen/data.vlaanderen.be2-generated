      {
        "@id": "https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regelgeving"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_2_16"
      },
      {
        "@id": "_:df_2_20"
      },
