    shacl:description "Text field in which exceptions to procedures, cost prices, ... can be indicated"@en;
    shacl:maxCount 1;
    shacl:name "Exceptions"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#exception>
  ], [
    a shacl:PropertyShape;
    rdfs:label "yourEuropeCategories"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "YourEurope category under the Single Digital Gateway Regulation. Only services that fall within one of these categories should be forwarded to SDG. The categories and subcategories were determined by the European Parliament. These were translated by the IPDC - LPDC team into a code list in the absence of a European code list."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.YourEuropeCategories>;
    shacl:description "YourEurope category under the Single Digital Gateway Regulation. Only services that fall within one of these categories should be forwarded to SDG. The categories and subcategories were determined by the European Parliament. These were translated by the IPDC - LPDC team into a code list in the absence of a European code list."@en;
    shacl:name "yourEuropeCategories"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#yourEuropeCategory>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Publishing channels"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column. When a draft has the YourEurope publication channel, at least one value must be entered in the yourEuropeCategory field."@en;
    rdfs:comment "Publication channel of a public service describes on which places the service will be visible. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.PublishingChannels>;
    shacl:description "Publication channel of a public service describes on which places the service will be visible. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Publishing channels"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#publicationMedium>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Tags"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Concept tag for a public service concept. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Tags>;
    shacl:description "Concept tag for a public service concept. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Tags"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#conceptTag>
  ], [
