    shacl:description "Links to the implementing organisations"@en;
    shacl:name "executiveGovernments"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#hasExecutingAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Procedures"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Procedures>;
    shacl:class <http://purl.org/vocab/cpsv#Rule>;
    shacl:name "Procedures"@en;
    shacl:path <http://purl.org/vocab/cpsv#follows>
  ], [
