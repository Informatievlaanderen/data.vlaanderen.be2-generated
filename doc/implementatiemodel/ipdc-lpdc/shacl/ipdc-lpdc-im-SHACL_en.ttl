    shacl:class <http://data.europa.eu/m8g/Requirement>;
    shacl:description "Textual description of the conditions for using the service."@en;
    shacl:name "Conditions"@en;
    shacl:path <http://vocab.belgif.be/ns/publicservice#hasRequirement>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isVersionOf"@en;
    rdfs:comment "Reference to the instance from which this snapshot was taken at a certain point in time."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.IsVersionOf>;
    shacl:class <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#InstancePublicServiceSnapshot>;
    shacl:description "Reference to the instance from which this snapshot was taken at a certain point in time."@en;
    shacl:minCount 1;
    shacl:name "isVersionOf"@en;
