    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#additionalDescription>
  ], [
    a shacl:PropertyShape;
    rdfs:label "executiveGovernments"@en;
    rdfs:comment "Links to the implementing organisations"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.ExecutiveGovernments>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "Links to the implementing organisations"@en;
    shacl:name "executiveGovernments"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#hasExecutingAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Websites"@en;
    rdfs:comment "moreInfo refers to online locations where additional information about something specifically related to public service is listed"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Websites>;
    shacl:class schema:WebSite;
    shacl:description "moreInfo refers to online locations where additional information about something specifically related to public service is listed"@en;
    shacl:name "Websites"@en;
    shacl:path rdfs:seeAlso
  ], [
    a shacl:PropertyShape;
    rdfs:label "Regulations"@en;
    rdfs:comment "The Has Legal Resource property links a Public Service to a Legal Resource. It indicates the Legal Resource (e.g. legislation) to which the Public Service relates, operates or has its legal basis."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Regulations>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "The Has Legal Resource property links a Public Service to a Legal Resource. It indicates the Legal Resource (e.g. legislation) to which the Public Service relates, operates or has its legal basis."@en;
    shacl:name "Regulations"@en;
    shacl:path <http://data.europa.eu/m8g/hasLegalResource>
  ], [
