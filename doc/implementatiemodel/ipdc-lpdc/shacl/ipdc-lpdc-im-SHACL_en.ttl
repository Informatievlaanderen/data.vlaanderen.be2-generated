    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.FinancialBenefits>;
    shacl:class <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#FinancialAdvantage>;
    shacl:name "FinancialBenefits"@en;
    shacl:path <http://purl.org/vocab/cpsv#produces>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Costs"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Costs>;
    shacl:class <http://data.europa.eu/m8g/Cost>;
    shacl:name "Costs"@en;
    shacl:path <http://data.europa.eu/m8g/hasCost>
  ], [
    a shacl:PropertyShape;
    rdfs:label "linkedConcept"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.LinkedConcept>;
    shacl:class <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#InstancePublicService>;
    shacl:name "linkedConcept"@en;
