<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#IntegerShape> a shacl:NodeShape;
  rdfs:label "Integer";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Integer>;
  shacl:closed false;
  shacl:targetClass xsd:integer .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ProcedureShape> a shacl:NodeShape;
  rdfs:label "Procedure"@en;
  rdfs:comment "The Rule class represents a document that sets out the specific rules, guidelines or procedures that the Public Service follows. It includes the terms of service, licence, and authentication requirements of the Public Service. Instances of the Rule class are FRBR (Functional Requirements for Bibliographic Records) Expressions, that is, a concrete expression such as a document, of the more abstract concept of the rules themselves. This model does not envisage instances of the Rule class as machine-readable business rules. Detailed modelling of the rules related to Public Services is out of scope of this model."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Procedure>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Order"@en;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@en;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Procedure.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Order"@en;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "Description"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "This property represents a free text Description of the Rule."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Procedure.Description>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text Description of the Rule."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Description"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "This property represents the Name of the Rule."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Procedure.Name>;
    shacl:class rdf:langString;
    shacl:description "This property represents the Name of the Rule."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "Websites"@en;
    rdfs:comment "Link to online location where the procedure can be started."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Procedure.Websites>;
    shacl:class schema:WebSite;
    shacl:description "Link to online location where the procedure can be started."@en;
    shacl:name "Websites"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#hasWebsite>
  ];
  shacl:targetClass <http://purl.org/vocab/cpsv#Rule> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ProofShape> a shacl:NodeShape;
  rdfs:label "Proof"@en;
  <http://purl.org/vocab/vann/usageNote> "Although the wording of the definition is different, the semantics are an exact match for CPSV's Input class which it replaces. Evidence can be any resource - document, artefact - anything needed for executing the Public Service."@en;
  rdfs:comment "The Evidence class is defined in the Core Criterion and Core Evidence vocabulary (CCCEV) as any resource that can document or support a response. It contains information that proves that a normal requirement exists or is true."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Proof>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Description"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "Describes the required input"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Proof.Description>;
    shacl:class rdf:langString;
    shacl:description "Describes the required input"@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Description"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "This property represents the official Name of the Evidence."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Proof.Name>;
    shacl:class rdf:langString;
    shacl:description "This property represents the official Name of the Evidence."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ];
  shacl:targetClass <http://data.europa.eu/m8g/Evidence> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#PublicOrganizationShape> a shacl:NodeShape;
  rdfs:label "PublicOrganization"@en;
  <http://purl.org/vocab/vann/usageNote> "Link to the organisation register (guide) based on the OVO code or link to the organisation portal. Where possible, IPDC tries to establish links to the organization register. When IPDC receives a link to the organisation portal, it tries to look up the organisation in the organisation register. When this is found, the link to the organization register will be saved, otherwise the link to the organization portal will be retained."@en;
  rdfs:comment "An organisation that belongs to the public sector according to a legal framework, regardless of the level of government at which that framework is in force."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#PublicOrganization>;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/m8g/PublicOrganisation> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#RegulationsShape> a shacl:NodeShape;
  rdfs:label "Regulations"@en;
  <http://purl.org/vocab/vann/usageNote> "Link to the Flemish Codex or another legislative register - The definition and properties of the Legal Resource class in the CPSV-AP are aligned with the ontology included in \"Council conclusions inviting the introduction of the European Legislation Identifier (ELI)\". For describing the attributes of a Legal Resource (labels, preferred labels, alternative labels, definition ...) we refer to the ELI ontology."@en;
  rdfs:comment "This class represents the legislation, policy or policies that lie behind the Rules that govern the service."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regulations>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Order"@en;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@en;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regulations.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Order"@en;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "URL"@en;
    <http://purl.org/vocab/vann/usageNote> "Legal resource location must conform to the format described in RFC1738: https://datatracker.ietf.org/doc/html/rfc1738#section-3.3"@en;
    rdfs:comment "The URL of the legal resource"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regulations.URL>;
    shacl:datatype xsd:string;
    shacl:description "The URL of the legal resource"@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "URL"@en;
    shacl:path schema:url
  ], [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "This property represents the name of the legal resource."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regulations.Name>;
    shacl:class rdf:langString;
    shacl:description "This property represents the name of the legal resource."@en;
    shacl:maxCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "Description"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "This property represents a free text description of the legal resource."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regulations.Description>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text description of the legal resource."@en;
    shacl:maxCount 1;
    shacl:name "Description"@en;
    shacl:path dc:description
  ];
  shacl:targetClass <http://data.europa.eu/eli/ontology#LegalResource> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#String>;
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#WebsiteShape> a shacl:NodeShape;
  rdfs:label "Website"@en;
  rdfs:comment "A WebSite is a set of related web pages and other items typically served from a single web domain and accessible via a URL."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Website>;
