    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Costs>;
    shacl:class <http://data.europa.eu/m8g/Cost>;
    shacl:name "Costs"@en;
    shacl:path <http://data.europa.eu/m8g/hasCost>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Procedures"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Procedures>;
    shacl:class <http://purl.org/vocab/cpsv#Rule>;
    shacl:name "Procedures"@en;
    shacl:path <http://purl.org/vocab/cpsv#follows>
  ], [
    a shacl:PropertyShape;
    rdfs:label "executiveGovernments"@en;
    rdfs:comment "Links to the implementing organisations"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.ExecutiveGovernments>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "Links to the implementing organisations"@en;
    shacl:name "executiveGovernments"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#hasExecutingAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "competent authorities"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.CompetentAuthorities>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:name "competent authorities"@en;
    shacl:path <http://data.europa.eu/m8g/hasCompetentAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isVersionOf"@en;
    rdfs:comment "Reference to the concept of which this snapshot was made at a certain moment in time."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.IsVersionOf>;
    shacl:class <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#ConceptualPublicService>;
    shacl:description "Reference to the concept of which this snapshot was made at a certain moment in time."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "isVersionOf"@en;
    shacl:path dc:isVersionOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "Regulations"@en;
    rdfs:comment "The Has Legal Resource property links a Public Service to a Legal Resource. It indicates the Legal Resource (e.g. legislation) to which the Public Service relates, operates or has its legal basis."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Regulations>;
    shacl:class <http://data.europa.eu/eli/ontology#LegalResource>;
    shacl:description "The Has Legal Resource property links a Public Service to a Legal Resource. It indicates the Legal Resource (e.g. legislation) to which the Public Service relates, operates or has its legal basis."@en;
    shacl:name "Regulations"@en;
    shacl:path <http://data.europa.eu/m8g/hasLegalResource>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Conditions"@en;
    rdfs:comment "Textual description of the conditions for using the service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Conditions>;
    shacl:class <http://data.europa.eu/m8g/Requirement>;
    shacl:description "Textual description of the conditions for using the service."@en;
    shacl:name "Conditions"@en;
    shacl:path <http://vocab.belgif.be/ns/publicservice#hasRequirement>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Websites"@en;
    rdfs:comment "moreInfo refers to online locations where additional information about something specifically related to public service is listed"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Websites>;
    shacl:class schema:WebSite;
    shacl:description "moreInfo refers to online locations where additional information about something specifically related to public service is listed"@en;
    shacl:name "Websites"@en;
    shacl:path rdfs:seeAlso
  ];
  shacl:targetClass <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#ConceptualPublicServiceSnapshot> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConditionShape> a shacl:NodeShape;
  rdfs:label "Condition"@en;
  <http://purl.org/vocab/vann/usageNote> "Not all public services are needed or usable by everyone. For example, the visa service operated by European countries is not needed by European citizens but is needed by some citizens from elsewhere, or public services offering unemployment benefits and grants are targeting specific societal groups. This model reuses the Core Criterion and Core Evidence Vocabulary for this class. The CCCEV provides more details but the Requirement class has three mandatory properties."@en;
  rdfs:comment "A normal requirement is an atomic requirement. Some criteria can be expressed with several atomic requirements. A normal requirement can specify the expected value that the requirement response has to contain, or a range of threshold values within which the requirement response has to fit in. The normal requirement may apply to a certain period of time. It also can provide a list of candidate evidences that the responder can use to prove the normal requirement."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Condition>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Order"@en;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@en;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Condition.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Order"@en;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "Description"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "A short explanation about the nature, attributes, uses or any other additional information that helps clarify the understanding of the Requirement being instantiated."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Condition.Description>;
    shacl:class rdf:langString;
    shacl:description "A short explanation about the nature, attributes, uses or any other additional information that helps clarify the understanding of the Requirement being instantiated."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Description"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "This property represents the official Name of the Requirement."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Condition.Name>;
    shacl:class rdf:langString;
    shacl:description "This property represents the official Name of the Requirement."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "Proof"@en;
    rdfs:comment "The Evidence that supplies information (proof, support) for this Requirement."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Condition.Proof>;
    shacl:class <http://data.europa.eu/m8g/Evidence>;
    shacl:description "The Evidence that supplies information (proof, support) for this Requirement."@en;
    shacl:maxCount 1;
    shacl:name "Proof"@en;
    shacl:path <http://data.europa.eu/m8g/hasSupportingEvidence>
  ];
  shacl:targetClass <http://data.europa.eu/m8g/Requirement> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ContactDetailsShape> a shacl:NodeShape;
  rdfs:label "Contact details"@en;
  <http://purl.org/vocab/vann/usageNote> "At least one of the attributes must be filled in with a non-empty value."@en;
  rdfs:comment "This class represents the contact information for a Public Service, Channel, Public Organization, etc. It is defined in the Core Public Organization Vocabulary and is provided as a schema:ContactPoint. Like Channel, a Contact Point may have regular opening hours that are then overridden by, for example, public holidays, using the Opening Hours Specification class."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ContactDetails>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Email"@en;
    <http://purl.org/vocab/vann/usageNote> "Email address must conform to the format described in RFC2822: https://datatracker.ietf.org/doc/html/rfc2822#section-3.4.1"@en;
    rdfs:comment "A property through which an e-mail address for the Public Organization, or a representative of it, can be contacted."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ContactDetails.Email>;
    shacl:datatype xsd:string;
    shacl:description "A property through which an e-mail address for the Public Organization, or a representative of it, can be contacted."@en;
    shacl:maxCount 1;
    shacl:name "Email"@en;
    shacl:path schema:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "Opening hours"@en;
    <http://purl.org/vocab/vann/usageNote> "Days are specified using two-letter combinations: Mo, Tu, We, Th, Fr, Sa, Su. For example, if the contact point is open Monday-Friday, 9 -5, the value of the openingHours property would be Mo-Fr 09:00-17:00. If the Contact Point is only available on Tuesday and Thursday between 6 and 8pm, the value would be Tu,Th 16:00-20:00."@en;
    rdfs:comment "The value of this property is structured text that gives the hours at which the contact point is normally available."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ContactDetails.OpeningHours>;
    shacl:datatype xsd:string;
    shacl:description "The value of this property is structured text that gives the hours at which the contact point is normally available."@en;
    shacl:maxCount 1;
    shacl:name "Opening hours"@en;
    shacl:path schema:openingHours
  ], [
    a shacl:PropertyShape;
    rdfs:label "Phone number"@en;
    rdfs:comment "A property through which a phone number for the Public Organization, or a representative of it, can be contacted."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ContactDetails.PhoneNumber>;
    shacl:datatype xsd:string;
    shacl:description "A property through which a phone number for the Public Organization, or a representative of it, can be contacted."@en;
    shacl:maxCount 1;
    shacl:name "Phone number"@en;
    shacl:path schema:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "URL"@en;
    <http://purl.org/vocab/vann/usageNote> "Website location must conform to the format described in RFC1738: https://datatracker.ietf.org/doc/html/rfc1738#section-3.3"@en;
    rdfs:comment "The URL of the website"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ContactDetails.URL>;
    shacl:datatype xsd:string;
    shacl:description "The URL of the website"@en;
    shacl:maxCount 1;
    shacl:name "URL"@en;
    shacl:path schema:url
  ], [
    a shacl:PropertyShape;
    rdfs:label "Order"@en;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@en;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ContactDetails.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Order"@en;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "Address"@en;
    rdfs:comment "Address that can be written to or visited."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ContactDetails.Address>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Address that can be written to or visited."@en;
    shacl:maxCount 1;
    shacl:name "Address"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#address>
  ];
  shacl:targetClass schema:ContactPoint .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#CostShape> a shacl:NodeShape;
  rdfs:label "Cost"@en;
  rdfs:comment "The Cost class represents any costs related to the execution of a Public Service that the Agent consuming it needs to pay."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Cost>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Order"@en;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@en;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Cost.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Order"@en;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "Description"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "This property represents a free text description of the Cost."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Cost.Description>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text description of the Cost."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Description"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "This property represents the name of the cost."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Cost.Name>;
    shacl:class rdf:langString;
    shacl:description "This property represents the name of the cost."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ];
  shacl:targetClass <http://data.europa.eu/m8g/Cost> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#DateTimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#DateTime>;
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#FinancialBenefitShape> a shacl:NodeShape;
  rdfs:label "Financial Benefit"@en;
  rdfs:comment "We provide a subclass 'FinancialAdvantage' with 'Output'. This describes the premium amounts/subsidy amounts that are the result of the service."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#FinancialBenefit>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Order"@en;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@en;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#FinancialBenefit.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Order"@en;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "Description"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "This property represents a free text Description of the Output."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#FinancialBenefit.Description>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text Description of the Output."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Description"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "This property represents the official Name of the Output."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#FinancialBenefit.Name>;
    shacl:class rdf:langString;
    shacl:description "This property represents the official Name of the Output."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ];
  shacl:targetClass <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#FinancialAdvantage> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshotShape> a shacl:NodeShape;
  rdfs:label "InstanceSnapshot"@en;
  <http://purl.org/vocab/vann/usageNote> "The instance data recordings are made available by IPDC using a linked data event stream (LDES). This LDES makes the full history of all instance changes available to connectors. More info about LDES is available here: https://semiceu.github.io/LinkedDataEventStreams"@en;
  rdfs:comment "An instance snapshot shows what an instance looked like at a particular point in time. Each time a functional change is made, a new instance snapshot will be created. In this way, the complete editorial history of an instance is recorded."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshot>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "generatedAtTime"@en;
    rdfs:comment "Time when the snapshot of the instance was taken."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshot.GeneratedAtTime>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time when the snapshot of the instance was taken."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "generatedAtTime"@en;
    shacl:path prov:generatedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "archived"@en;
    rdfs:comment "Value that indicates whether the instance is archived."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshot.Archived>;
    shacl:datatype xsd:boolean;
    shacl:description "Value that indicates whether the instance is archived."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "archived"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#isArchived>
  ], [
    a shacl:PropertyShape;
    rdfs:label "lastModified"@en;
    rdfs:comment "Time when the instance was last modified by an editor."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshot.LastModified>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time when the instance was last modified by an editor."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "lastModified"@en;
    shacl:path schema:dateModified
  ], [
    a shacl:PropertyShape;
    rdfs:label "Product number"@en;
    <http://purl.org/vocab/vann/usageNote> "When creating a new instance, no product number can be passed to IPDC or LPDC. The product numbers are managed by IPDC and when a new instance is created, a unique product number will be assigned in IPDC. As a result, when IPDC is read, a product number will always be available on each instance."@en;
    rdfs:comment "Identification number to uniquely identify an instance or concept."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshot.ProductNumber>;
    shacl:datatype xsd:string;
    shacl:description "Identification number to uniquely identify an instance or concept."@en;
    shacl:maxCount 1;
    shacl:name "Product number"@en;
    shacl:path schema:productID
  ], [
    a shacl:PropertyShape;
    rdfs:label "Creation"@en;
    rdfs:comment "Time when the instance was created by an editor."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshot.Creation>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time when the instance was created by an editor."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Creation"@en;
    shacl:path schema:dateCreated
  ], [
    a shacl:PropertyShape;
    rdfs:label "endServiceProvision"@en;
    <http://purl.org/vocab/vann/usageNote> "An empty end date is interpreted as no end date when determining the activity of the public service."@en;
    rdfs:comment "Date on which the public service was or will be discontinued"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshot.EndServiceProvision>;
    shacl:class <https://www.w3.org/2001/XMLSchema#dateTime>;
    shacl:description "Date on which the public service was or will be discontinued"@en;
    shacl:maxCount 1;
    shacl:name "endServiceProvision"@en;
    shacl:path schema:endDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "geographicalAreas of application"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Geographical scope of a public service: Flemish provinces and municipalities."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshot.GeographicalAreasOfApplication>;
    shacl:description "Geographical scope of a public service: Flemish provinces and municipalities."@en;
    shacl:minCount 1;
    shacl:name "geographicalAreas of application"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
