    shacl:path <http://data.europa.eu/m8g/hasCompetentAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "executiveGovernments"@en;
    rdfs:comment "Links to the implementing organisations"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshot.ExecutiveGovernments>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "Links to the implementing organisations"@en;
    shacl:name "executiveGovernments"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#hasExecutingAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "createdBy"@en;
    rdfs:comment "Link to the organization that created the instance"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshot.CreatedBy>;
