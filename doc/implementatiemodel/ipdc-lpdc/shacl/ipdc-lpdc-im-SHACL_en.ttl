    shacl:class <http://data.europa.eu/m8g/Cost>;
    shacl:name "Costs"@en;
    shacl:path <http://data.europa.eu/m8g/hasCost>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Websites"@en;
    rdfs:comment "moreInfo refers to online locations where additional information about something specifically related to public service is listed"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Websites>;
    shacl:class schema:WebSite;
    shacl:description "moreInfo refers to online locations where additional information about something specifically related to public service is listed"@en;
    shacl:name "Websites"@en;
    shacl:path rdfs:seeAlso
  ], [
    a shacl:PropertyShape;
    rdfs:label "FinancialBenefits"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.FinancialBenefits>;
    shacl:class <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#FinancialAdvantage>;
    shacl:name "FinancialBenefits"@en;
