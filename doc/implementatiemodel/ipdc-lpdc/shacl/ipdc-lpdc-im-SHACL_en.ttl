<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshotShape> a shacl:NodeShape;
  rdfs:label "ConceptSnapshot"@en;
  <http://purl.org/vocab/vann/usageNote> "The concept snapshots are made available by IPDC on the basis of a linked data event stream (LDES). This LDES makes the full history of all concept changes available to connectors. More info about LDES is available here: https://semiceu.github.io/LinkedDataEventStreams"@en;
  rdfs:comment "A concept snapshot depicts what a concept looked like at a certain point in time. Each time a functional change is made, a new concept snapshot will be created. In this way, the complete editorial history of a concept is recorded."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "generatedAtTime"@en;
    rdfs:comment "Time when the snapshot of the concept was taken."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.GeneratedAtTime>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time when the snapshot of the concept was taken."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "generatedAtTime"@en;
    shacl:path prov:generatedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "lastModified"@en;
    rdfs:comment "Time when the draft was last modified by an editor."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.LastModified>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time when the draft was last modified by an editor."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "lastModified"@en;
    shacl:path schema:dateModified
  ], [
    a shacl:PropertyShape;
    rdfs:label "Creation"@en;
    rdfs:comment "Time when the draft was created by an editor."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Creation>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time when the draft was created by an editor."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Creation"@en;
    shacl:path schema:dateCreated
  ], [
    a shacl:PropertyShape;
    rdfs:label "archived"@en;
    rdfs:comment "Value that indicates whether the draft is archived."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Archived>;
    shacl:datatype xsd:boolean;
    shacl:description "Value that indicates whether the draft is archived."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "archived"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#isArchived>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Product number"@en;
    <http://purl.org/vocab/vann/usageNote> "When creating a new draft, no product number can be passed on to IPDC or LPDC. The product numbers are managed by IPDC and when a new concept is created, a unique product number will be assigned in IPDC. As a result, when IPDC is read, a product number will always be available for each concept."@en;
    rdfs:comment "Identification number to uniquely identify an instance or concept."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.ProductNumber>;
    shacl:datatype xsd:string;
    shacl:description "Identification number to uniquely identify an instance or concept."@en;
    shacl:maxCount 1;
    shacl:name "Product number"@en;
    shacl:path schema:productID
  ], [
    a shacl:PropertyShape;
    rdfs:label "Description"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "This property represents a free text Description of the Public Service. The description is likely to be the text that potential users of the Public Service see in any public service catalogue. Public administrations are encouraged to include a reasonable level of detail in the description, for instance including basic eligibility requirements for the particular Public Service and contact information."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Description>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text Description of the Public Service. The description is likely to be the text that potential users of the Public Service see in any public service catalogue. Public administrations are encouraged to include a reasonable level of detail in the description, for instance including basic eligibility requirements for the particular Public Service and contact information."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Description"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "Competent levels of government"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Competent level of government of a public service. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.CompetentLevelsOfGovernment>;
    shacl:description "Competent level of government of a public service. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Competent levels of government"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#competentAuthorityLevel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Target groups"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Target group to which a public service is focused. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.TargetGroups>;
    shacl:description "Target group to which a public service is focused. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Target groups"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#targetAudience>
  ], [
    a shacl:PropertyShape;
    rdfs:label "endServiceProvision"@en;
    <http://purl.org/vocab/vann/usageNote> "An empty end date is interpreted as no end date when determining the activity of the public service."@en;
    rdfs:comment "Date on which the public service was or will be discontinued"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.EndServiceProvision>;
    shacl:class <https://www.w3.org/2001/XMLSchema#dateTime>;
    shacl:description "Date on which the public service was or will be discontinued"@en;
    shacl:maxCount 1;
    shacl:name "endServiceProvision"@en;
    shacl:path schema:endDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "This property represents the official Name of the Public Service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Name>;
    shacl:class rdf:langString;
    shacl:description "This property represents the official Name of the Public Service."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "Publishing channels"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column. When a draft has the YourEurope publication channel, at least one value must be entered in the yourEuropeCategory field."@en;
    rdfs:comment "Publication channel of a public service describes on which places the service will be visible. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.PublishingChannels>;
    shacl:description "Publication channel of a public service describes on which places the service will be visible. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Publishing channels"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#publicationMedium>
  ], [
    a shacl:PropertyShape;
    rdfs:label "RegulationsText"@en;
    <http://purl.org/vocab/vann/usageNote> """Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls.
Preferably use the relationship 'follows(Rule)' to refer to the relevant legislation."""@en;
    rdfs:comment "Text field in which the regulations on which the public service is based can be described."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.RegulationsText>;
    shacl:class rdf:langString;
    shacl:description "Text field in which the regulations on which the public service is based can be described."@en;
    shacl:maxCount 1;
    shacl:name "RegulationsText"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#regulation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "startServiceProvision"@en;
    <http://purl.org/vocab/vann/usageNote> "When determining whether the public service is active, an empty start date is interpreted as a start date very far in the past."@en;
    rdfs:comment "Date on which the public service was/will be actively provided"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.StartServiceProvision>;
    shacl:class <https://www.w3.org/2001/XMLSchema#dateTime>;
    shacl:description "Date on which the public service was/will be actively provided"@en;
    shacl:maxCount 1;
    shacl:name "startServiceProvision"@en;
    shacl:path schema:startDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "Tags"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Concept tag for a public service concept. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Tags>;
    shacl:description "Concept tag for a public service concept. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Tags"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#conceptTag>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Themes"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Theme of a public service. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Themes>;
    shacl:description "Theme of a public service. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Themes"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <http://data.europa.eu/m8g/thematicArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Type"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Type of a public service. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Type>;
    shacl:description "Type of a public service. This code list is managed by the IPDC - LPDC team."@en;
    shacl:maxCount 1;
    shacl:name "Type"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "executiveLevels of governance"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Executive level of a public service. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.ExecutiveLevelsOfGovernance>;
    shacl:description "Executive level of a public service. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "executiveLevels of governance"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#executingAuthorityLevel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Exceptions"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "Text field in which exceptions to procedures, cost prices, ... can be indicated"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.Exceptions>;
