<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#BooleanShape> a shacl:NodeShape;
  rdfs:label "Boolean";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Boolean>;
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptShape> a shacl:NodeShape;
  rdfs:label "Concept"@en;
  <http://purl.org/vocab/vann/usageNote> "A good example of a concept is marriage. Although the description and conditions of a marriage are largely the same for the different municipalities, there may still be local differences, such as the location and price, which can be found in the respective authorities."@en;
  rdfs:comment "The services provided by local authorities are often based on Flemish, federal or European legislation, which is translated to a local level. This means that the basis is the same for every local government, but that there may be flexibility for the local interpretation. Because we want to get and keep IPDC well stocked and up to date, with a limited administrative burden, we provide the concept. A draft is a template that editors of the Flemish government prepare for local authorities. It contains a general interpretation of a government service, which can also be applicable in most local contexts. Local authorities can consult these concepts and decide to register their own services on the basis of a concept. At that moment, a concept is cloned to an authority. The local government can then fully adapt this body and tailor it to the local context. In this way, a concept also groups together all the different local variations of a similar service."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Product number"@en;
    <http://purl.org/vocab/vann/usageNote> "When creating a new draft, no product number can be passed on to IPDC or LPDC. The product numbers are managed by IPDC and when a new concept is created, a unique product number will be assigned in IPDC. As a result, when IPDC is read, a product number will always be available for each concept."@en;
    rdfs:comment "Identification number to uniquely identify an instance or concept."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.ProductNumber>;
    shacl:datatype xsd:string;
    shacl:description "Identification number to uniquely identify an instance or concept."@en;
    shacl:maxCount 1;
    shacl:name "Product number"@en;
    shacl:path schema:productID
  ], [
    a shacl:PropertyShape;
    rdfs:label "Creation"@en;
    rdfs:comment "Time when the draft was created by an editor."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Creation>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time when the draft was created by an editor."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Creation"@en;
    shacl:path schema:dateCreated
  ], [
    a shacl:PropertyShape;
    rdfs:label "lastModified"@en;
    rdfs:comment "Time when the draft was last modified by an editor."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.LastModified>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time when the draft was last modified by an editor."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "lastModified"@en;
    shacl:path schema:dateModified
  ], [
    a shacl:PropertyShape;
    rdfs:label "archived"@en;
    rdfs:comment "Value that indicates whether the draft is archived."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Archived>;
    shacl:datatype xsd:boolean;
    shacl:description "Value that indicates whether the draft is archived."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "archived"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#isArchived>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Description"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "This property represents a free text Description of the Public Service. The description is likely to be the text that potential users of the Public Service see in any public service catalogue. Public administrations are encouraged to include a reasonable level of detail in the description, for instance including basic eligibility requirements for the particular Public Service and contact information."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Description>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text Description of the Public Service. The description is likely to be the text that potential users of the Public Service see in any public service catalogue. Public administrations are encouraged to include a reasonable level of detail in the description, for instance including basic eligibility requirements for the particular Public Service and contact information."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Description"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "endServiceProvision"@en;
    <http://purl.org/vocab/vann/usageNote> "An empty end date is interpreted as no end date when determining the activity of the public service."@en;
    rdfs:comment "Date on which the public service was or will be discontinued"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.EndServiceProvision>;
    shacl:class <https://www.w3.org/2001/XMLSchema#dateTime>;
    shacl:description "Date on which the public service was or will be discontinued"@en;
    shacl:maxCount 1;
    shacl:name "endServiceProvision"@en;
    shacl:path schema:endDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "Search terms"@en;
    <http://purl.org/vocab/vann/usageNote> "There may be multiple terms per language. This is in contrast to all other fields of the type TaalString."@en;
    rdfs:comment "This property represents a keyword, term or phrase to describe the Public Service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.SearchTerms>;
    shacl:class rdf:langString;
    shacl:description "This property represents a keyword, term or phrase to describe the Public Service."@en;
    shacl:name "Search terms"@en;
    shacl:path dcat:keyword
  ], [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "This property represents the official Name of the Public Service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Name>;
    shacl:class rdf:langString;
    shacl:description "This property represents the official Name of the Public Service."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "RegulationsText"@en;
    <http://purl.org/vocab/vann/usageNote> """Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls.
Preferably use the relationship 'follows(Rule)' to refer to the relevant legislation."""@en;
    rdfs:comment "Text field in which the regulations on which the public service is based can be described."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.RegulationsText>;
    shacl:class rdf:langString;
    shacl:description "Text field in which the regulations on which the public service is based can be described."@en;
    shacl:maxCount 1;
    shacl:name "RegulationsText"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#regulation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "startServiceProvision"@en;
    <http://purl.org/vocab/vann/usageNote> "When determining whether the public service is active, an empty start date is interpreted as a start date very far in the past."@en;
    rdfs:comment "Date on which the public service was/will be actively provided"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.StartServiceProvision>;
    shacl:class <https://www.w3.org/2001/XMLSchema#dateTime>;
    shacl:description "Date on which the public service was/will be actively provided"@en;
    shacl:maxCount 1;
    shacl:name "startServiceProvision"@en;
    shacl:path schema:startDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "Target groups"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Target group to which a public service is focused. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.TargetGroups>;
    shacl:description "Target group to which a public service is focused. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Target groups"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#targetAudience>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Themes"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Theme of a public service. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Themes>;
    shacl:description "Theme of a public service. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Themes"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <http://data.europa.eu/m8g/thematicArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Type"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Type of a public service. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Type>;
    shacl:description "Type of a public service. This code list is managed by the IPDC - LPDC team."@en;
    shacl:maxCount 1;
    shacl:name "Type"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "Exceptions"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "Text field in which exceptions to procedures, cost prices, ... can be indicated"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Exceptions>;
