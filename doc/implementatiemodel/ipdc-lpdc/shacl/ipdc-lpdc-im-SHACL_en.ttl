    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#FinancialBenefitShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#RegulationsShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshotShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstanceSnapshotShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#AddressShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ProcedureShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConditionShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ProofShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#PublicOrganizationShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#StringShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#DateTimeShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#BooleanShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#IntegerShape> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#AddressShape> a shacl:NodeShape;
  rdfs:label "Address"@en;
  <http://purl.org/vocab/vann/usageNote> "At least one of the attributes must be filled in with a non-empty value."@en;
  rdfs:comment "Address that can be written to or visited."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Address>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "House number"@en;
    rdfs:comment "Alphanumeric code officially assigned to building units, berths, stands or plots."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Address.HouseNumber>;
    shacl:datatype xsd:string;
    shacl:description "Alphanumeric code officially assigned to building units, berths, stands or plots."@en;
    shacl:maxCount 1;
    shacl:name "House number"@en;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Box number"@en;
    rdfs:comment "Officially assigned alphanumeric code that is added to the house number to distinguish several building units, pitches, berths or plots that have the same house number."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Address.BoxNumber>;
    shacl:datatype xsd:string;
    shacl:description "Officially assigned alphanumeric code that is added to the house number to distinguish several building units, pitches, berths or plots that have the same house number."@en;
    shacl:maxCount 1;
    shacl:name "Box number"@en;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Postal code"@en;
    rdfs:comment "Code that designates the geographical area that groups the addresses for postal purposes."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Address.PostalCode>;
    shacl:datatype xsd:string;
    shacl:description "Code that designates the geographical area that groups the addresses for postal purposes."@en;
    shacl:maxCount 1;
    shacl:name "Postal code"@en;
    shacl:path <https://data.vlaanderen.be/ns/adres#postcode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Country"@en;
    rdfs:comment "Country in which the address is located."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Address.Country>;
    shacl:class rdf:langString;
    shacl:description "Country in which the address is located."@en;
    shacl:maxCount 1;
    shacl:name "Country"@en;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Municipality name"@en;
    rdfs:comment "Municipality name of the address."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Address.MunicipalityName>;
    shacl:class rdf:langString;
    shacl:description "Municipality name of the address."@en;
    shacl:maxCount 1;
    shacl:name "Municipality name"@en;
    shacl:path <https://data.vlaanderen.be/ns/adres#gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "street name"@en;
    rdfs:comment "Address component with the name officially assigned to a street (lane, passageway, square) or to a hamlet and to which addresses may be linked."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Address.StreetName>;
    shacl:class rdf:langString;
    shacl:description "Address component with the name officially assigned to a street (lane, passageway, square) or to a hamlet and to which addresses may be linked."@en;
    shacl:maxCount 1;
    shacl:name "street name"@en;
    shacl:path <https://data.vlaanderen.be/ns/adres#Straatnaam>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#AuthorityShape> a shacl:NodeShape;
  rdfs:label "Authority"@en;
  rdfs:comment "Institutions are the actual interpretation of a product or service. The competent authority can vary: federal, Flemish, provincial,... And the service can be provided by another government such as a local government. A government service is a mandatory or optional set of activities that are or may be carried out by or on behalf of a public organisation, publicly funded and arising from public policy. Services may benefit an individual, an organisation or association, a company or other public authority, or groups of any of these parties. A service exists regardless of whether it is used or not. According to the revised European Interoperability Framework, a European public service includes any service provided by public authorities in Europe, or by other organisations on their behalf, to businesses, citizens or other public authorities."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Product number"@en;
    <http://purl.org/vocab/vann/usageNote> "When creating a new instance, no product number can be passed to IPDC or LPDC. The product numbers are managed by IPDC and when a new instance is created, a unique product number will be assigned in IPDC. As a result, when IPDC is read, a product number will always be available on each instance."@en;
    rdfs:comment "Identification number to uniquely identify an instance or concept."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.ProductNumber>;
    shacl:datatype xsd:string;
    shacl:description "Identification number to uniquely identify an instance or concept."@en;
    shacl:maxCount 1;
    shacl:name "Product number"@en;
    shacl:path schema:productID
  ], [
    a shacl:PropertyShape;
    rdfs:label "lastModified"@en;
    rdfs:comment "Time when the instance was last modified by an editor."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.LastModified>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time when the instance was last modified by an editor."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "lastModified"@en;
    shacl:path schema:dateModified
  ], [
    a shacl:PropertyShape;
    rdfs:label "Creation"@en;
    rdfs:comment "Time when the instance was created by an editor."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Creation>;
    shacl:datatype xsd:dateTime;
    shacl:description "Time when the instance was created by an editor."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Creation"@en;
    shacl:path schema:dateCreated
  ], [
    a shacl:PropertyShape;
    rdfs:label "archived"@en;
    rdfs:comment "Value that indicates whether the instance is archived."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Archived>;
    shacl:datatype xsd:boolean;
    shacl:description "Value that indicates whether the instance is archived."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "archived"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#isArchived>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Description"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "This property represents a free text Description of the Public Service. The description is likely to be the text that potential users of the Public Service see in any public service catalogue. Public administrations are encouraged to include a reasonable level of detail in the description, for instance including basic eligibility requirements for the particular Public Service and contact information."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Description>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text Description of the Public Service. The description is likely to be the text that potential users of the Public Service see in any public service catalogue. Public administrations are encouraged to include a reasonable level of detail in the description, for instance including basic eligibility requirements for the particular Public Service and contact information."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Description"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "endServiceProvision"@en;
    <http://purl.org/vocab/vann/usageNote> "An empty end date is interpreted as no end date when determining the activity of the public service."@en;
    rdfs:comment "Date on which the public service was or will be discontinued"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.EndServiceProvision>;
    shacl:class <https://www.w3.org/2001/XMLSchema#dateTime>;
    shacl:description "Date on which the public service was or will be discontinued"@en;
    shacl:maxCount 1;
    shacl:name "endServiceProvision"@en;
    shacl:path schema:endDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "Exceptions"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "Text field in which exception to procedures, cost prices, ... can be indicated"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Exceptions>;
    shacl:class rdf:langString;
    shacl:description "Text field in which exception to procedures, cost prices, ... can be indicated"@en;
    shacl:maxCount 1;
    shacl:name "Exceptions"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#exception>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Search terms"@en;
    <http://purl.org/vocab/vann/usageNote> "There may be multiple terms per language. This is in contrast to all other fields of the type TaalString."@en;
    rdfs:comment "This property represents a keyword, term or phrase to describe the Public Service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.SearchTerms>;
    shacl:class rdf:langString;
    shacl:description "This property represents a keyword, term or phrase to describe the Public Service."@en;
    shacl:name "Search terms"@en;
    shacl:path dcat:keyword
  ], [
    a shacl:PropertyShape;
    rdfs:label "Languages"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values within the ipdc-lpdc implementation model are: NLD, FRA, DEU, ENG. The language concept URIs use the http protocol."@en;
    rdfs:comment "Language in which public service is offered. This code list is managed by the Publications Office of the European Union."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Languages>;
    shacl:description "Language in which public service is offered. This code list is managed by the Publications Office of the European Union."@en;
    shacl:name "Languages"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:language
  ], [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "This property represents the official Name of the Public Service."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Name>;
    shacl:class rdf:langString;
    shacl:description "This property represents the official Name of the Public Service."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "RegulationsText"@en;
    <http://purl.org/vocab/vann/usageNote> """Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls.
Preferably use the relationship 'follows(Rule)' to refer to the relevant legislation."""@en;
    rdfs:comment "Text field in which the regulations on which the public service is based can be described."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.RegulationsText>;
    shacl:class rdf:langString;
    shacl:description "Text field in which the regulations on which the public service is based can be described."@en;
    shacl:maxCount 1;
    shacl:name "RegulationsText"@en;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#regulation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "yourEuropeCategories"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "YourEurope category under the Single Digital Gateway Regulation. Only services that fall within one of these categories should be forwarded to SDG. The categories and subcategories were determined by the European Parliament. These were translated by the IPDC - LPDC team into a code list in the absence of a European code list."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.YourEuropeCategories>;
    shacl:description "YourEurope category under the Single Digital Gateway Regulation. Only services that fall within one of these categories should be forwarded to SDG. The categories and subcategories were determined by the European Parliament. These were translated by the IPDC - LPDC team into a code list in the absence of a European code list."@en;
    shacl:name "yourEuropeCategories"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#yourEuropeCategory>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geographicalAreas of application"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Geographical scope of a public service: Flemish provinces and municipalities."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.GeographicalAreasOfApplication>;
    shacl:description "Geographical scope of a public service: Flemish provinces and municipalities."@en;
    shacl:minCount 1;
    shacl:name "geographicalAreas of application"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "startServiceProvision"@en;
    <http://purl.org/vocab/vann/usageNote> "When determining whether the public service is active, an empty start date is interpreted as a start date very far in the past."@en;
    rdfs:comment "Date on which the public service was/will be actively provided"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.StartServiceProvision>;
    shacl:class <https://www.w3.org/2001/XMLSchema#dateTime>;
    shacl:description "Date on which the public service was/will be actively provided"@en;
    shacl:maxCount 1;
    shacl:name "startServiceProvision"@en;
    shacl:path schema:startDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "Target groups"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Target group to which a public service is focused. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.TargetGroups>;
    shacl:description "Target group to which a public service is focused. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Target groups"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#targetAudience>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Themes"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Theme of a public service. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Themes>;
    shacl:description "Theme of a public service. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Themes"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <http://data.europa.eu/m8g/thematicArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Type"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Type of a public service. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Type>;
    shacl:description "Type of a public service. This code list is managed by the IPDC - LPDC team."@en;
    shacl:maxCount 1;
    shacl:name "Type"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "Publishing channels"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column. When a draft has the YourEurope publication channel, at least one value must be entered in the yourEuropeCategory field."@en;
    rdfs:comment "Publication channel of a public service describes on which places the service will be visible. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.PublishingChannels>;
    shacl:description "Publication channel of a public service describes on which places the service will be visible. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Publishing channels"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#publicationMedium>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Tags"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column. Currently there are no valid values."@en;
    rdfs:comment "Instance tag for a public service. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.Tags>;
    shacl:description "Instance tag for a public service. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Tags"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#instanceTag>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Competent levels of government"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Competent level of government of a public service. This code list is managed by the IPDC - LPDC team."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.CompetentLevelsOfGovernment>;
    shacl:description "Competent level of government of a public service. This code list is managed by the IPDC - LPDC team."@en;
    shacl:name "Competent levels of government"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#competentAuthorityLevel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "executiveLevels of governance"@en;
    <http://purl.org/vocab/vann/usageNote> "The valid values can be found in the ttl file on the link in the code list column."@en;
    rdfs:comment "Executive level of a public service. This code list is managed by the IPDC - LPDC team."@en;
