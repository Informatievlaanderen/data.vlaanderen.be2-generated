    shacl:class schema:ContactPoint;
    shacl:name "Contact details"@en;
    shacl:path <http://data.europa.eu/m8g/hasContactPoint>
  ], [
    a shacl:PropertyShape;
    rdfs:label "linkedConcept"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority.LinkedConcept>;
