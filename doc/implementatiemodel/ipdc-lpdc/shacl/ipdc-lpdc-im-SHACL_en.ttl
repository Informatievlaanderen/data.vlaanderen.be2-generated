    a shacl:PropertyShape;
    rdfs:label "URL"@en;
    <http://purl.org/vocab/vann/usageNote> "Website location must conform to the format described in RFC1738: https://datatracker.ietf.org/doc/html/rfc1738#section-3.3"@en;
    rdfs:comment "The URL of the website"@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Website.URL>;
    shacl:datatype xsd:string;
    shacl:description "The URL of the website"@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "URL"@en;
    shacl:path schema:url
  ], [
    a shacl:PropertyShape;
    rdfs:label "Order"@en;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@en;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Website.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Order"@en;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "This property represents the name of the website."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Website.Name>;
    shacl:class rdf:langString;
    shacl:description "This property represents the name of the website."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "Description"@en;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls."@en;
    rdfs:comment "This property represents a free text description of the Website."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Website.Description>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text description of the Website."@en;
    shacl:maxCount 1;
    shacl:name "Description"@en;
    shacl:path dc:description
  ];
  shacl:targetClass schema:WebSite .
