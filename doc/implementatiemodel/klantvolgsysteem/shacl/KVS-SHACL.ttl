<https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een Organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "alternatieveNaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: commerciële naam, informele naam, etc."@nl;
    rdfs:comment "Andere naam waaronder de Organisatie bekend is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Alternatievenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Andere naam waaronder de Organisatie bekend is."@nl;
    shacl:name "alternatieveNaam"@nl;
    shacl:path skos:altLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Textuele beschrijving van de organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Beschrijving>;
    shacl:datatype rdf:langString;
    shacl:description "Textuele beschrijving van de organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "doel"@nl;
    rdfs:comment "Bestaansreden van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Doel>;
    shacl:datatype rdf:langString;
    shacl:description "Bestaansreden van de Organisatie."@nl;
    shacl:name "doel"@nl;
    shacl:path org:purpose
  ], [
    a shacl:PropertyShape;
    rdfs:label "homepage"@nl;
    rdfs:comment "Adres van de homepage van de website van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Homepage>;
    shacl:datatype xsd:anyURI;
    shacl:description "Adres van de homepage van de website van de Organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "homepage"@nl;
    shacl:path foaf:homepage
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "activiteit"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van het attribuut classificatie (naast type & status)."@nl;
    rdfs:comment "Type activiteit die door de organisatie wordt uitgeoefend."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Activiteit>;
    shacl:class skos:Concept;
    shacl:description "Type activiteit die door de organisatie wordt uitgeoefend."@nl;
    shacl:maxCount "1";
    shacl:name "activiteit"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgActivity>
  ], [
    a shacl:PropertyShape;
    rdfs:label "classificatie"@nl;
    rdfs:comment "Rangschikking van de Organisatie in een classificatiesysteem."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Classificatie>;
    shacl:class skos:Concept;
    shacl:description "Rangschikking van de Organisatie in een classificatiesysteem."@nl;
    shacl:name "classificatie"@nl;
    shacl:path org:classification
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "logo"@nl;
    rdfs:comment "Verwijzing naar het logo van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Logo>;
    shacl:class schemas:MediaObject;
    shacl:description "Verwijzing naar het logo van de Organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "logo"@nl;
    shacl:path schemas:logo
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van classificatie (naast type & activiteit)."@nl;
    rdfs:comment "Toestand van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Status>;
    shacl:class skos:Concept;
    shacl:description "Toestand van de Organisatie."@nl;
    shacl:name "status"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgStatus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van classificatie (naast activiteit & status)."@nl;
    rdfs:comment "Soort Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Organisatie.Type>;
    shacl:class skos:Concept;
    shacl:description "Soort Organisatie."@nl;
    shacl:name "type"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgType>
  ];
  shacl:targetClass org:Organization .

<https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#OutputShape> a shacl:NodeShape;
