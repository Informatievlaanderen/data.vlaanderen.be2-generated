<https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#GeregistreerdpersoonShape> a shacl:NodeShape;
  rdfs:label "GeregistreerdPersoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb naam en voornaam) en de Verblijfplaats vd persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."@nl;
  rdfs:comment "Persoon waarvan de gegevens zijn ingeschreven in een register."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    rdfs:comment "Identificatiecode van de persoon in het register."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Geregistreerdpersoon.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificatiecode van de persoon in het register."@nl;
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#registratie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#GezinShape> a shacl:NodeShape;
  rdfs:label "Gezin"@nl;
  <http://purl.org/vocab/vann/usageNote> "Ruimer begrip dan familie waar het Gezin louter bestaat uit nabije bloedverwanten, bijvoorbeeld een Eenpersoonsgezin of een Living Together Apart Gezin. Gezinsleden hebben doorgaans dezelfde Verblijfplaats."@nl;
  rdfs:comment "Samenwerkingsvorm die een herkenbare sociale eenheid vormt (bijvoorbeeld ten gevolge van een huwelijk), met al dan niet verwante personen die duurzame banden hebben en elkaar onderling steun en verzorging verlenen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gezinsadres"@nl;
    <http://purl.org/vocab/vann/usageNote> "Vaak een criterium om te bepalen of personen deel uitmaken van eenzelfde Gezin."@nl;
    rdfs:comment "Verblijfplaats van het Gezin."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Gezin.Gezinsadres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Verblijfplaats van het Gezin."@nl;
    shacl:maxCount "1";
    shacl:name "gezinsadres"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#gezinsadres>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gezinslid"@nl;
    rdfs:comment "Personen waaruit het Gezin bestaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Gezin.Gezinslid>;
    shacl:class <http://www.w3.org/ns/person#Person>;
    shacl:description "Personen waaruit het Gezin bestaat."@nl;
    shacl:minCount 1;
    shacl:name "gezinslid"@nl;
    shacl:path org:hasMember
  ], [
    a shacl:PropertyShape;
    rdfs:label "gezinshoofd"@nl;
    rdfs:comment "De standaard vertegenwoordiger van het Gezin."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Gezin.Gezinshoofd>;
    shacl:class <http://www.w3.org/ns/person#Person>;
    shacl:description "De standaard vertegenwoordiger van het Gezin."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "gezinshoofd"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#gezinshoofd>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Gezin> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#GezinsrelatieShape> a shacl:NodeShape;
  rdfs:label "Gezinsrelatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: echtgenoot,zoon,schoonmoeder."@nl;
  rdfs:comment "Relatie tussen leden van eenzelfde gezin."@nl;
  shacl:closed false;
