    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Ishoofdvan>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Gezin>;
    shacl:description "Persoon die standaard het Gezin vertegenwoordigt."@nl;
    shacl:maxCount "1";
    shacl:name "isHoofdVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#isHoofdVan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftRelatieMet"@nl;
    rdfs:comment "Persoon waarmee de Persoon gerelateerd is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Heeftrelatiemet>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Gezinsrelatie>;
    shacl:description "Persoon waarmee de Persoon gerelateerd is."@nl;
    shacl:name "heeftRelatieMet"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#heeftRelatieMet>
  ], [
