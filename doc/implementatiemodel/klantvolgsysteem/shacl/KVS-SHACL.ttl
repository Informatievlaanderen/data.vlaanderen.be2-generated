    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Deeltraject.Trajecttype>;
    shacl:class <http://todo.com/Trajecttype>;
    shacl:maxCount "1";
    shacl:name "trajecttype";
    shacl:path <http://todo.com/trajecttype>
