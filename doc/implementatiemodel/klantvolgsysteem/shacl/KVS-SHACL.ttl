    rdfs:label "inwonerschap";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Inwonerschap>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Inwonerschap>;
    shacl:name "inwonerschap";
    shacl:path <http://todo.com/inwonerschap>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Het soort Persoon."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Type>;
    shacl:class <http://todo.com/PersoonType>;
    shacl:description "Het soort Persoon."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "isLidVan";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Islidvan>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Gezin>;
    shacl:name "isLidVan";
    shacl:path <http://todo.com/isLidVan>
  ], [
