<https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "alternatieveNaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld pseudoniem."@nl;
    rdfs:comment "Alternatief voor de volledige naam van de Persoon."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Alternatievenaam>;
    shacl:datatype xsd:string;
    shacl:description "Alternatief voor de volledige naam van de Persoon."@nl;
    shacl:name "alternatieveNaam"@nl;
    shacl:path dc:alternative
  ], [
    a shacl:PropertyShape;
    rdfs:label "achternaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Achternaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount "1";
    shacl:name "achternaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "geboortenaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "De namen van een persoon kunnen in de loop van de tijd wijzigen, bijvoorbeeld: de achternaam kan wijzigen door een huwelijk. De oorspronkelijke naam wordt echter vaak ook nog gebruikt."@nl;
    rdfs:comment "Volledige naam van de Persoon bij geboorte."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Geboortenaam>;
    shacl:datatype xsd:string;
    shacl:description "Volledige naam van de Persoon bij geboorte."@nl;
    shacl:maxCount "1";
    shacl:name "geboortenaam"@nl;
    shacl:path <http://www.w3.org/ns/person#birthName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruikteVoornaam"@nl;
    rdfs:comment "Belangrijkste van de voornamen van een Persoon."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Gebruiktevoornaam>;
    shacl:datatype xsd:string;
    shacl:description "Belangrijkste van de voornamen van een Persoon."@nl;
    shacl:maxCount "1";
    shacl:name "gebruikteVoornaam"@nl;
    shacl:path <http://todo.com/gebruikteVoornaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volledigeNaam"@nl;
    rdfs:comment "De volledige naam van de Persoon, doorgaans de combinatie van voornamen en achternaam."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Volledigenaam>;
    shacl:datatype xsd:string;
    shacl:description "De volledige naam van de Persoon, doorgaans de combinatie van voornamen en achternaam."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "volledigeNaam"@nl;
    shacl:path <http://todo.com/volledigeNaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "voornaam"@nl;
    rdfs:comment "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Voornaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie."@nl;
    shacl:name "voornaam"@nl;
    shacl:path foaf:givenName
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon, ... die toelaat de Persoon te contacteren."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Informatie zoals email, telefoon, ... die toelaat de Persoon te contacteren."@nl;
    shacl:maxCount "1";
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "geslacht"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het geslacht van een Persoon is sterk afhankelijk van de manier waarop dit gedefinieerd is, dit kan op basis van de biologische kenmerken maar ook op basis van gender, genderindentiteit, genderexpressie, etc. Voor meer informatie zie <a href=\"https://www.vlaanderen.be/dienst-diversiteitsbeleid/begrippen-rond-gender-en-seksuele-diversiteit\">Begrippen rond gender- en seksuele diversiteit</a>."@nl;
    rdfs:comment "De uiting van een Persoon's indentiteit, expressie en sociale rol."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Geslacht>;
    shacl:class skos:Concept;
    shacl:description "De uiting van een Persoon's indentiteit, expressie en sociale rol."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "geslacht"@nl;
    shacl:path <http://data.europa.eu/m8g/gender>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftGeboorte";
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Persoon.Heeftgeboorte>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Geboorte>;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "heeftGeboorte";
    shacl:path <http://todo.com/heeftGeboorte>
  ], [
