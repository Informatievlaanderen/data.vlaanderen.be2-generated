    rdfs:comment "Aard van de relatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Gezinsrelatie.Gezinsrelatietype>;
