    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/klantvolgsysteem/ontwerpstandaard/2025-10-27#Publiekedienstverlening.Produceert>;
    shacl:class <http://data.europa.eu/m8g/Input>;
