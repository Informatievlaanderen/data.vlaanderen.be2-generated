{
  "title": "Activeringstraject",
  "type": "object",
  "description": "Een Activeringstraject is een specifiekere variant van een Traject dat moet aansporen om de Werkzoekende te activeren naar werk.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Activeringstraject)",
      "pattern": "^Activeringstraject$"
    },
    "naam": {
      "$ref": "#/components/schemas/Activeringstraject.naam"
    },
    "startdatum": {
      "$ref": "#/components/schemas/Activeringstraject.startdatum"
    },
    "einddatum": {
      "$ref": "#/components/schemas/Activeringstraject.einddatum"
    },
    "status": {
      "$ref": "#/components/schemas/Trajectstatustype"
    },
    "deeltraject": {
      "type": "array",
      "description": "De Deeltrajecten gelinkt aan dit Traject. Lijst van Deeltraject items.",
      "items": {
        "$ref": "#/components/schemas/Deeltraject"
      },
      "minItems": 1
    },
    "heeftParticipatie": {
      "type": "array",
      "description": "De Agenten die deelnemen aan het Activeringstraject. Lijst van Participatie items.",
      "items": {
        "$ref": "#/components/schemas/Participatie"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "naam"
  ]
}