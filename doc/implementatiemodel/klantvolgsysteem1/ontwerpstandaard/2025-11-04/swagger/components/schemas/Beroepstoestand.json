{
  "title": "Beroepstoestand",
  "type": "object",
  "description": "Voorkeur voor een bepaald beroep.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Beroepstoestand)",
      "pattern": "^Beroepstoestand$"
    },
    "naam": {
      "type": "object",
      "description": "Naam van het beroep. Bijvoorbeeld: Loodgieter, Dakwerker, etc.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "voorkeur": {
      "$ref": "#/components/schemas/Voorkeurtype"
    }
  },
  "required": [
    "@type"
  ]
}