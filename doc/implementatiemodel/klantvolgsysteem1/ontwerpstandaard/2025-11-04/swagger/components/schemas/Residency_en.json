{
  "title": "Residency",
  "type": "object",
  "description": "The fact that a Person resides in a place or country.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Residency)",
      "pattern": "^Residency$"
    },
    "hasPlaceOfResidence": {
      "type": "array",
      "description": "Place where a person resides. Lijst van Residence items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Residence"
          },
          {
            "$ref": "#/components/schemas/Domicile"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Residence": "#/components/schemas/Residence",
            "Domicile": "#/components/schemas/Domicile"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}