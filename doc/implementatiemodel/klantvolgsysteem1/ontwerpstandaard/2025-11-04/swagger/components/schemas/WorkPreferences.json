{
  "title": "WorkPreferences",
  "type": "object",
  "description": "The Job Seeker's preferences when looking for work.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse WorkPreferences)",
      "pattern": "^WorkPreferences$"
    },
    "profession": {
      "type": "array",
      "description": "Preferences for certain professions. Lijst van OccupationalStatus items.",
      "items": {
        "$ref": "#/components/schemas/OccupationalStatus"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}