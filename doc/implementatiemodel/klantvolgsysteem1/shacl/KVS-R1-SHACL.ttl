<https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#ActiveringstrajectShape> a shacl:NodeShape;
  rdfs:label "Activeringstraject"@nl;
  rdfs:comment "Een Activeringstraject is een specifiekere variant van een Traject dat moet aansporen om de Werkzoekende te activeren naar werk."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De naam van een Traject."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Activeringstraject.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van een Traject."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "startdatum"@nl;
    rdfs:comment "De datum waarop het Traject start."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Activeringstraject.Startdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop het Traject start."@nl;
    shacl:maxCount "1";
    shacl:name "startdatum"@nl;
    shacl:path schemas:startDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "De datum waarop het Traject eindigt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Activeringstraject.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop het Traject eindigt."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path schemas:endDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "De status van het Traject."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Activeringstraject.Status>;
    shacl:class skos:Concept;
    shacl:description "De status van het Traject."@nl;
    shacl:maxCount "1";
    shacl:name "status"@nl;
    shacl:path <http://www.w3.org/ns/adms#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "deeltraject"@nl;
    rdfs:comment "De Deeltrajecten gelinkt aan dit Traject."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Activeringstraject.Deeltraject>;
    shacl:class <https://data.vlaanderen.be/ns/klantvolgsysteem1/Deeltraject>;
    shacl:description "De Deeltrajecten gelinkt aan dit Traject."@nl;
    shacl:name "deeltraject"@nl;
    shacl:path dc:hasPart
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftParticipatie"@nl;
    rdfs:comment "De Agenten die deelnemen aan het Activeringstraject."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Activeringstraject.Heeftparticipatie>;
    shacl:class <http://data.europa.eu/m8g/Participation>;
    shacl:description "De Agenten die deelnemen aan het Activeringstraject."@nl;
    shacl:name "heeftParticipatie"@nl;
    shacl:path <http://data.europa.eu/m8g/hasParticipation>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/klantvolgsysteem1/Activeringstraject> .

<https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld als attribuut van een persoon of gebouw, ... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding ten behoeve van Belgische adressen."@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam van het adres."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatcode"@nl;
    rdfs:comment "De NIS code van de straat."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Adresvoorstelling.Straatcode>;
    shacl:datatype xsd:string;
    shacl:description "De NIS code van de straat."@nl;
    shacl:maxCount "1";
    shacl:name "straatcode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#straatcode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentecode"@nl;
    rdfs:comment "De NIS code van de gemeente."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Adresvoorstelling.Gemeentecode>;
    shacl:datatype xsd:string;
    shacl:description "De NIS code van de gemeente."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentecode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#gemeentecode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding tbv Belgische adressen."@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Adresvoorstelling.Land>;
    shacl:datatype rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postnaam"@nl;
    rdfs:comment "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Adresvoorstelling.Postnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#postName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Straatnaam van het adres."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Adresvoorstelling.Straatnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Straatnaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te vervangen door een niet-abstracte klasse."@nl;
  rdfs:comment "Een agent zoals een Persoon, groep, software of fysiek artifact."@nl;
  shacl:closed false;
  shacl:targetClass foaf:Agent .

<https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#BeroepstoestandShape> a shacl:NodeShape;
  rdfs:label "Beroepstoestand"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: voorkeur of afkeur voor een bepaald beroep."@nl;
  rdfs:comment "Voorkeur voor een bepaald beroep."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: Loodgieter, Dakwerker, etc."@nl;
    rdfs:comment "Naam van het beroep."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Beroepstoestand.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van het beroep."@nl;
    shacl:maxCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorkeur"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: te verkennen, uitgesloten, etc."@nl;
    rdfs:comment "De soort voorkeur voor een bepaald beroep."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Beroepstoestand.Voorkeur>;
    shacl:class skos:Concept;
    shacl:description "De soort voorkeur voor een bepaald beroep."@nl;
    shacl:maxCount "1";
    shacl:name "voorkeur"@nl;
    shacl:path <https://data.vlaanderen.be/ns/klantvolgsysteem1/voorkeur>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/klantvolgsysteem1/Beroepstoestand> .

<https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#ContactpuntShape> a shacl:NodeShape;
  rdfs:label "Contactpunt"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen, etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Contactpunt.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schemas:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Contactpunt.Telefoon>;
    shacl:datatype xsd:string;
    shacl:description "Telefoonnummer waarop men kan bellen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schemas:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Contactpunt.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven of bezoeken."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ];
  shacl:targetClass schemas:ContactPoint .

<https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#DeeltrajectShape> a shacl:NodeShape;
  rdfs:label "Deeltraject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: een opleiding."@nl;
  rdfs:comment "Een Deeltraject is een onderdeel van een Traject dat een specfiek onderdeel uitwerkt van een Traject."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "De datum waarop het Traject eindigt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Deeltraject.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop het Traject eindigt."@nl;
    shacl:maxCount "1";
    shacl:name "einddatum"@nl;
    shacl:path schemas:endDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De naam van een Traject."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Deeltraject.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van een Traject."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "startdatum"@nl;
    rdfs:comment "De datum waarop het Traject start."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Deeltraject.Startdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop het Traject start."@nl;
    shacl:maxCount "1";
    shacl:name "startdatum"@nl;
    shacl:path schemas:startDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    rdfs:comment "De status van het Traject."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Deeltraject.Status>;
    shacl:class skos:Concept;
    shacl:description "De status van het Traject."@nl;
    shacl:maxCount "1";
    shacl:name "status"@nl;
    shacl:path <http://www.w3.org/ns/adms#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: Opleiding, Interview, etc."@nl;
    rdfs:comment "Het soort Traject."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/klantvolgsysteem1/ontwerpstandaard/2025-11-04#Deeltraject.Type>;
    shacl:class skos:Concept;
    shacl:description "Het soort Traject."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftParticipatie"@nl;
    rdfs:comment "De Agenten die deelnemen aan het Deeltraject."@nl;
