{
  "title": "ActivationProcess",
  "type": "object",
  "description": "An Activation Pathway is a more specific variant of a Pathway that should encourage the Job Seeker to activate to work.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse ActivationProcess)",
      "pattern": "^ActivationProcess$"
    },
    "name": {
      "$ref": "#/components/schemas/ActivationProcess.name"
    },
    "startDate": {
      "$ref": "#/components/schemas/ActivationProcess.startDate"
    },
    "endDate": {
      "$ref": "#/components/schemas/ActivationProcess.endDate"
    },
    "status": {
      "$ref": "#/components/schemas/Trajectstatustype"
    },
    "partialTrajectory": {
      "type": "array",
      "description": "The Sub-Trajectories linked to this Trajectory. Lijst van PartialTrajectory items.",
      "items": {
        "$ref": "#/components/schemas/PartialTrajectory"
      },
      "minItems": 1
    },
    "hasParticipation": {
      "type": "array",
      "description": "The Agents participating in the Activation Pathway. Lijst van Participation items.",
      "items": {
        "$ref": "#/components/schemas/Participation"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "name"
  ]
}