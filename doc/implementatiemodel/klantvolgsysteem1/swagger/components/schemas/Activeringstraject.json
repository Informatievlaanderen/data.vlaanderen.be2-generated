{
  "title": "Activeringstraject",
  "type": "object",
  "description": "Een Activeringstraject is een specifiekere variant van een Traject dat moet aansporen om de Werkzoekende te activeren naar werk.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Activeringstraject)",
      "pattern": "^Activeringstraject$"
    },
    "naam": {
      "type": "object",
      "description": "De naam van een Traject.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "startdatum": {
      "type": "object",
      "description": "De datum waarop het Traject start.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "einddatum": {
      "type": "object",
      "description": "De datum waarop het Traject eindigt.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "status": {
      "$ref": "#/components/schemas/Trajectstatustype"
    },
    "deeltraject": {
      "type": "array",
      "description": "Lijst van Deeltraject items.",
      "items": {
        "$ref": "#/components/schemas/Deeltraject"
      },
      "minItems": 1
    },
    "heeftParticipatie": {
      "type": "array",
      "description": "Lijst van Participatie items.",
      "items": {
        "$ref": "#/components/schemas/Participatie"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "naam"
  ]
}