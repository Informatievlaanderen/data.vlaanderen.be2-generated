{
  "title": "Deeltraject",
  "type": "object",
  "description": "Een Deeltraject is een onderdeel van een Traject dat een specfiek onderdeel uitwerkt van een Traject.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Deeltraject)",
      "pattern": "^Deeltraject$"
    },
    "einddatum": {
      "$ref": "#/components/schemas/Deeltraject.einddatum"
    },
    "naam": {
      "$ref": "#/components/schemas/Deeltraject.naam"
    },
    "startdatum": {
      "$ref": "#/components/schemas/Deeltraject.startdatum"
    },
    "status": {
      "$ref": "#/components/schemas/Trajectstatustype"
    },
    "type": {
      "$ref": "#/components/schemas/Deeltrajecttype"
    },
    "heeftParticipatie": {
      "type": "array",
      "description": "De Agenten die deelnemen aan het Deeltraject. Lijst van Participatie items.",
      "items": {
        "$ref": "#/components/schemas/Participatie"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "naam"
  ]
}