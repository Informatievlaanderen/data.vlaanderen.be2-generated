{
  "title": "PartialTrajectory",
  "type": "object",
  "description": "A Partial Trajectory is a part of a Trajectory that elaborates a specific part of a Trajectory.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse PartialTrajectory)",
      "pattern": "^PartialTrajectory$"
    },
    "endDate": {
      "$ref": "#/components/schemas/PartialTrajectory.endDate"
    },
    "name": {
      "$ref": "#/components/schemas/PartialTrajectory.name"
    },
    "startDate": {
      "$ref": "#/components/schemas/PartialTrajectory.startDate"
    },
    "status": {
      "$ref": "#/components/schemas/Trajectstatustype"
    },
    "type": {
      "$ref": "#/components/schemas/Deeltrajecttype"
    },
    "hasParticipation": {
      "type": "array",
      "description": "The Agents participating in the Sharing Pathway. Lijst van Participation items.",
      "items": {
        "$ref": "#/components/schemas/Participation"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "name"
  ]
}