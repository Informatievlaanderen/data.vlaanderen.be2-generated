{
  "title": "Participation",
  "type": "object",
  "description": "The role in which an Agent participates in the Public Service.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Participation)",
      "pattern": "^Participation$"
    },
    "role": {
      "type": "array",
      "description": "The Agent's role in participating. Lijst van Participatietype items.",
      "items": {
        "$ref": "#/components/schemas/Participatietype"
      },
      "minItems": 1
    },
    "hasParticipant": {
      "type": "array",
      "description": "The Agents who participate. Lijst van Agent items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/RegisteredPerson"
          },
          {
            "$ref": "#/components/schemas/Person"
          },
          {
            "$ref": "#/components/schemas/RegisteredOrganization"
          },
          {
            "$ref": "#/components/schemas/PublicOrganization"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "RegisteredPerson": "#/components/schemas/RegisteredPerson",
            "Person": "#/components/schemas/Person",
            "RegisteredOrganization": "#/components/schemas/RegisteredOrganization",
            "PublicOrganization": "#/components/schemas/PublicOrganization"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}