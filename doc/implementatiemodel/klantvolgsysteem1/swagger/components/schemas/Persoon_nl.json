{
  "title": "Persoon",
  "type": "object",
  "description": "Natuurlijk persoon.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Persoon)",
      "pattern": "^Persoon$"
    },
    "achternaam": {
      "$ref": "#/components/schemas/Persoon.achternaam"
    },
    "voornaam": {
      "type": "array",
      "description": "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Persoon.voornaam"
      },
      "minItems": 1
    },
    "heeftGeboorte": {
      "$ref": "#/components/schemas/Geboorte"
    },
    "inwonerschap": {
      "type": "array",
      "description": "Jurisdictie waarbinnen het Inwonerschap van de Persoon is gedefinieerd. Lijst van Inwonerschap items.",
      "items": {
        "$ref": "#/components/schemas/Inwonerschap"
      },
      "minItems": 1
    },
    "contactinfo": {
      "$ref": "#/components/schemas/Contactpunt"
    }
  },
  "required": [
    "@type",
    "contactinfo"
  ]
}