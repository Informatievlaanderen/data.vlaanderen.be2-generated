{
  "title": "PubliekeOrganisatie",
  "type": "object",
  "description": "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector, ongeacht het bestuursniveau waarop dat kader van kracht is.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse PubliekeOrganisatie)",
      "pattern": "^PubliekeOrganisatie$"
    },
    "voorkeursnaam": {
      "type": "object",
      "description": "Naam waarmee de Organisatie bij voorkeur wordt aangeduid.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "contactinfo": {
      "type": "array",
      "description": "Lijst van Contactpunt items.",
      "items": {
        "$ref": "#/components/schemas/Contactpunt"
      },
      "minItems": 1
    },
    "type": {
      "type": "array",
      "description": "Lijst van OrganisatieType items.",
      "items": {
        "$ref": "#/components/schemas/OrganisatieType"
      },
      "minItems": 1
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    }
  },
  "required": [
    "@type",
    "voorkeursnaam",
    "identificator"
  ]
}