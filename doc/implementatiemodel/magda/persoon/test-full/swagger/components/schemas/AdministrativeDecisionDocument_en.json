{
  "title": "AdministrativeDecisionDocument",
  "type": "object",
  "description": "Document that records the decision of a government.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse AdministrativeDecisionDocument)",
      "pattern": "^AdministrativeDecisionDocument$"
    },
    "date": {
      "$ref": "#/components/schemas/AdministrativeDecisionDocument.date"
    },
    "administration": {
      "$ref": "#/components/schemas/AdministrationType"
    },
    "place": {
      "$ref": "#/components/schemas/Location"
    },
    "description": {
      "$ref": "#/components/schemas/AdministrativeDecisionDocument.description"
    },
    "identifier": {
      "type": "array",
      "description": "Document identifier. Lijst van Identifier items.",
      "items": {
        "$ref": "#/components/schemas/Identifier"
      },
      "minItems": 1
    },
    "subject": {
      "type": "array",
      "description": "That which the Document relates to. Lijst van Resource items.",
      "items": {
        "$ref": "#/components/schemas/Resource"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}