{
  "title": "Akte",
  "type": "object",
  "description": "Officieel document dat een feit vaststelt of registreert.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Akte)",
      "pattern": "^Akte$"
    },
    "datum": {
      "$ref": "#/components/schemas/Akte.datum"
    },
    "beschrijving": {
      "$ref": "#/components/schemas/Akte.beschrijving"
    },
    "identificator": {
      "type": "array",
      "description": "Identificator van de Akte. Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "register": {
      "$ref": "#/components/schemas/Register"
    },
    "onderwerp": {
      "type": "array",
      "description": "Datgene waarop het Document betrekking heeft. Lijst van Resource items.",
      "items": {
        "$ref": "#/components/schemas/Resource"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}