{
  "title": "AlternativeName",
  "type": "object",
  "description": "Name that refers to the same Person as the official name but differs in usage, spelling, identity, etc.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse AlternativeName)",
      "pattern": "^AlternativeName$"
    },
    "name": {
      "$ref": "#/components/schemas/AlternativeName.name"
    },
    "startDate": {
      "$ref": "#/components/schemas/AlternativeName.startDate"
    },
    "endDate": {
      "$ref": "#/components/schemas/AlternativeName.endDate"
    },
    "type": {
      "$ref": "#/components/schemas/AlternativeNameType"
    },
    "birth": {
      "$ref": "#/components/schemas/Birth"
    },
    "nationality": {
      "$ref": "#/components/schemas/Nationality"
    }
  },
  "required": [
    "@type",
    "startDate"
  ]
}