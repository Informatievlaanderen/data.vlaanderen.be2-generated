{
  "title": "Document",
  "type": "object",
  "description": "Information stored on a data carrier.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Document)",
      "pattern": "^Document$"
    },
    "description": {
      "$ref": "#/components/schemas/Document.description"
    },
    "identifier": {
      "type": "array",
      "description": "Document identifier. Lijst van Identifier items.",
      "items": {
        "$ref": "#/components/schemas/Identifier"
      },
      "minItems": 1
    },
    "subject": {
      "type": "array",
      "description": "That which the Document relates to. Lijst van Resource items.",
      "items": {
        "$ref": "#/components/schemas/Resource"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}