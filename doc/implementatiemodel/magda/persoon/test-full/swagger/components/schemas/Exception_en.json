{
  "title": "Exception",
  "type": "object",
  "description": "Deviation from a general rule.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Exception)",
      "pattern": "^Exception$"
    },
    "date": {
      "$ref": "#/components/schemas/Exception.date"
    },
    "diagnosis": {
      "$ref": "#/components/schemas/Exception.diagnosis"
    },
    "origin": {
      "$ref": "#/components/schemas/ExceptionOrigin"
    },
    "type": {
      "$ref": "#/components/schemas/ExceptionType"
    },
    "circumstance": {
      "$ref": "#/components/schemas/Circumstance"
    },
    "annotation": {
      "type": "array",
      "description": "Reference to annotations associated with the Exception. Lijst van Annotation items.",
      "items": {
        "$ref": "#/components/schemas/Annotation"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}