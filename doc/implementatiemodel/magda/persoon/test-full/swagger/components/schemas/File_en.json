{
  "title": "File",
  "type": "object",
  "description": "Official document that establishes or records a fact.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse File)",
      "pattern": "^File$"
    },
    "date": {
      "$ref": "#/components/schemas/File.date"
    },
    "register": {
      "$ref": "#/components/schemas/Register"
    },
    "description": {
      "$ref": "#/components/schemas/File.description"
    },
    "identifier": {
      "type": "array",
      "description": "Document identifier. Lijst van Identifier items.",
      "items": {
        "$ref": "#/components/schemas/Identifier"
      },
      "minItems": 1
    },
    "subject": {
      "type": "array",
      "description": "That which the Document relates to. Lijst van Resource items.",
      "items": {
        "$ref": "#/components/schemas/Resource"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}