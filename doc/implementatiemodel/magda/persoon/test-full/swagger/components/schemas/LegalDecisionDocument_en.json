{
  "title": "LegalDecisionDocument",
  "type": "object",
  "description": "Document recording the decision of a judicial authority.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse LegalDecisionDocument)",
      "pattern": "^LegalDecisionDocument$"
    },
    "date": {
      "$ref": "#/components/schemas/LegalDecisionDocument.date"
    },
    "court": {
      "$ref": "#/components/schemas/DistrictCourt"
    },
    "place": {
      "$ref": "#/components/schemas/Location"
    },
    "description": {
      "$ref": "#/components/schemas/LegalDecisionDocument.description"
    },
    "identifier": {
      "type": "array",
      "description": "Document identifier. Lijst van Identifier items.",
      "items": {
        "$ref": "#/components/schemas/Identifier"
      },
      "minItems": 1
    },
    "subject": {
      "type": "array",
      "description": "That which the Document relates to. Lijst van Resource items.",
      "items": {
        "$ref": "#/components/schemas/Resource"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}