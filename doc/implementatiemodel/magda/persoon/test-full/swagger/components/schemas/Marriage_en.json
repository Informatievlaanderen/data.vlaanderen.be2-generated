{
  "title": "Marriage",
  "type": "object",
  "description": "A form of cohabitation between two persons regulated by civil or religious law.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Marriage)",
      "pattern": "^Marriage$"
    },
    "date": {
      "$ref": "#/components/schemas/Marriage.date"
    },
    "place": {
      "$ref": "#/components/schemas/Location"
    },
    "file": {
      "$ref": "#/components/schemas/File"
    },
    "pronunciation": {
      "$ref": "#/components/schemas/LegalDecisionDocument"
    },
    "transfer": {
      "$ref": "#/components/schemas/Transfer"
    },
    "startDate": {
      "$ref": "#/components/schemas/Marriage.startDate"
    },
    "endDate": {
      "$ref": "#/components/schemas/Marriage.endDate"
    },
    "ofPerson": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Person"
        },
        {
          "$ref": "#/components/schemas/RegisteredPerson"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Person": "#/components/schemas/Person",
          "RegisteredPerson": "#/components/schemas/RegisteredPerson"
        }
      }
    },
    "withPerson": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Person"
        },
        {
          "$ref": "#/components/schemas/RegisteredPerson"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Person": "#/components/schemas/Person",
          "RegisteredPerson": "#/components/schemas/RegisteredPerson"
        }
      }
    }
  },
  "required": [
    "@type",
    "startDate",
    "ofPerson",
    "withPerson"
  ]
}