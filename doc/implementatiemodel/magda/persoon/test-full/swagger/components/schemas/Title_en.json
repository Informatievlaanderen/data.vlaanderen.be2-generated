{
  "title": "Title",
  "type": "object",
  "description": "Official, hereditary, or acquired designation added to a person's name indicating their social status, nobility, office, profession, or educational qualifications obtained.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Title)",
      "pattern": "^Title$"
    },
    "description": {
      "$ref": "#/components/schemas/Title.description"
    },
    "startDate": {
      "$ref": "#/components/schemas/Title.startDate"
    },
    "endDate": {
      "$ref": "#/components/schemas/Title.endDate"
    },
    "type": {
      "$ref": "#/components/schemas/NobleTitle"
    }
  },
  "required": [
    "@type",
    "startDate"
  ]
}