          "@type": "https://schema.org/ContactPoint"
        },
        "heeftLid": {
          "@container": "@set",
          "@id": "http://www.w3.org/ns/org#hasMembership",
          "@type": "http://www.w3.org/ns/org#Membership"
        },
        "lid": {
          "@container": "@set",
          "@id": "http://www.w3.org/ns/org#hasMember",
          "@type": "http://xmlns.com/foaf/0.1/Agent"
        },
        "status": {
          "@container": "@set",
          "@id": "http://www.w3.org/ns/regorg#orgStatus",
          "@type": "http://www.w3.org/2004/02/skos/core#Concept"
        },
        "type": {
          "@container": "@set",
          "@id": "http://www.w3.org/ns/regorg#orgType",
          "@type": "http://www.w3.org/2004/02/skos/core#Concept"
        },
        "voorkeursnaam": {
          "@id": "http://www.w3.org/2004/02/skos/core#prefLabel",
          "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
        }
      },
      "@id": "http://www.w3.org/ns/org#Organization"
    },
    "Plaats": {
      "@context": {
        "geometrie": {
          "@id": "http://www.w3.org/ns/locn#geometry",
          "@type": "http://www.w3.org/ns/locn#Geometry"
        },
        "plaatsnaam": {
          "@id": "http://www.w3.org/2000/01/rdf-schema#label",
          "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
        }
      },
      "@id": "http://purl.org/dc/terms/Location"
    },
    "String": {
      "@id": "http://www.w3.org/2001/XMLSchema#string"
    },
    "Time": {
      "@id": "http://www.w3.org/2001/XMLSchema#time"
    },
    "URI": {
      "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
    }
  }
}
