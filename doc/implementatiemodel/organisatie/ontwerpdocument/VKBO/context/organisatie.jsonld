          "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
        }
      },
      "@id": "http://www.w3.org/ns/adms#Identifier"
    },
    "LangString": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
    },
    "Lidmaatschap": {
      "@context": {
        "isLidBij": {
          "@id": "http://www.w3.org/ns/org#organization",
          "@type": "http://xmlns.com/foaf/0.1/Agent"
        },
        "lid": {
          "@id": "http://www.w3.org/ns/org#member",
          "@type": "http://www.w3.org/ns/org#Organization"
        },
        "lidVanTot": {
          "@id": "http://www.w3.org/ns/org#memberDuring",
          "@type": "http://www.w3.org/2006/time#ProperInterval"
        },
        "rol": {
          "@id": "http://www.w3.org/ns/org#role",
          "@type": "http://www.w3.org/ns/org#Role"
        }
      },
      "@id": "http://www.w3.org/ns/org#Membership"
    },
    "Literal": {
      "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
    },
    "Locatie": {
      "@context": {
        "beschrijving": {
          "@id": "http://purl.org/dc/terms/description",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      },
      "@id": "http://www.w3.org/ns/prov#Location"
    },
    "Openingsurenspecificatie": {
      "@context": {
        "dagVanDeWeek": {
          "@id": "https://schema.org/dayOfWeek",
          "@type": "http://www.w3.org/2001/XMLSchema#anyURI"
        },
        "geldigTot": {
          "@id": "https://schema.org/validThrough",
          "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
        },
        "geldigVan": {
          "@id": "https://schema.org/validFrom",
          "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
        },
        "gesloten": {
          "@id": "https://schema.org/closes",
          "@type": "http://www.w3.org/2001/XMLSchema#time"
        },
        "open": {
          "@id": "https://schema.org/opens",
          "@type": "http://www.w3.org/2001/XMLSchema#time"
        }
      },
      "@id": "https://schema.org/OpeningHoursSpecification"
    },
    "Organisatie": {
      "@context": {
        "activiteit": {
          "@id": "http://www.w3.org/ns/regorg#orgActivity",
          "@type": "http://www.w3.org/2004/02/skos/core#Concept"
        },
        "alternatieveNaam": {
          "@container": "@set",
          "@id": "http://www.w3.org/2004/02/skos/core#altLabel",
          "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
        },
        "contactinfo": {
          "@container": "@set",
