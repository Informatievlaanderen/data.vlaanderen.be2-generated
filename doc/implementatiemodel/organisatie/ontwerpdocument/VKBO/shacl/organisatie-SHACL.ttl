<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld als attribuut van een persoon of gebouw, ... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 1"@nl;
    rdfs:comment "Hoogste Administratieve eenheid van het adres, doorgaans een land."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.AdministratieveEenheidNiveau1>;
    shacl:datatype rdf:langString;
    shacl:description "Hoogste Administratieve eenheid van het adres, doorgaans een land."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 1"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL1>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 2"@nl;
    rdfs:comment "De regio van het adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.AdministratieveEenheidNiveau2>;
    shacl:datatype rdf:langString;
    shacl:description "De regio van het adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 2"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL2>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adresgebied"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb de naam van het gehucht waarin het adres ligt."@nl;
    rdfs:comment "Naam van een geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Adresgebied>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van een geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is."@nl;
    shacl:maxCount "1";
    shacl:name "adresgebied"@nl;
    shacl:path <http://www.w3.org/ns/locn#addressArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding ten behoeve van Belgische adressen."@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam van het adres."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding tbv Belgische adressen."@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Land>;
    shacl:datatype rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatieaanduiding"@nl;
    rdfs:comment "Alfanumerieke code die de adreslocator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Locatieaanduiding>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code die de adreslocator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    shacl:name "locatieaanduiding"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorDesignator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatienaam"@nl;
    rdfs:comment "Naam of omschrijving van het het geografisch object dat de adreslocator aanduidt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Locatienaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam of omschrijving van het het geografisch object dat de adreslocator aanduidt."@nl;
    shacl:name "locatienaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postbus"@nl;
    rdfs:comment "Postbusnummer in een postkantoor."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Postbus>;
    shacl:datatype xsd:string;
    shacl:description "Postbusnummer in een postkantoor."@nl;
    shacl:maxCount "1";
    shacl:name "postbus"@nl;
    shacl:path <http://www.w3.org/ns/locn#poBox>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postnaam"@nl;
    rdfs:comment "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Postnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#postName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Straatnaam van het adres."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Straatnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Straatnaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volledigAdres"@nl;
    <http://purl.org/vocab/vann/usageNote> "Vermijdt fouten ten gevolge van het opsplitsen van een adres in zijn onderdelen. Geeft de voorgeschreven volgorde van de verschillende onderdelen weer."@nl;
    rdfs:comment "Het complete adres in één string, al dan niet geformatteerd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Adresvoorstelling.Volledigadres>;
    shacl:datatype rdf:langString;
    shacl:description "Het complete adres in één string, al dan niet geformatteerd."@nl;
    shacl:maxCount "1";
    shacl:name "volledigAdres"@nl;
    shacl:path <http://www.w3.org/ns/locn#fullAddress>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te vervangen door een niet-abstracte klasse."@nl;
  rdfs:comment "Een agent zoals een Persoon, groep, software of fysiek artifact."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "isLidVan"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dekt elk type aansluiting of betrokkenheid van een Agent bij een Organisatie, niet enkel formeel lidmaatschap. Kan eventueel verder gespecialiseerd worden. Het lidmaatschap wordt meer in detail beschreven met de entiteit Lidmaatschap (door middel van associatieklasse modellering)."@nl;
    rdfs:comment "Niet nader bepaald lidmaatschap van een Agent van een Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Agent.Islidvan>;
    shacl:description "Niet nader bepaald lidmaatschap van een Agent van een Organisatie."@nl;
    shacl:name "isLidVan"@nl;
    shacl:or ([shacl:class org:Organization] [shacl:class org:FormalOrganization] [shacl:class <http://www.w3.org/ns/regorg#RegisteredOrganization>]);
    shacl:path org:memberOf
  ];
  shacl:targetClass foaf:Agent,
    org:Organization,
    org:FormalOrganization,
    <http://www.w3.org/ns/regorg#RegisteredOrganization> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#ContactpuntShape> a shacl:NodeShape;
  rdfs:label "Contactpunt"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen, etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Contactpunt.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schemas:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Contactpunt.Telefoon>;
    shacl:datatype xsd:string;
    shacl:description "Telefoonnummer waarop men kan bellen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schemas:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "plaats"@nl;
    rdfs:comment "Geografische locatie van het Contactpunt."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Contactpunt.Plaats>;
    shacl:class dc:Location;
    shacl:description "Geografische locatie van het Contactpunt."@nl;
    shacl:maxCount "1";
    shacl:name "plaats"@nl;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Contactpunt.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven of bezoeken."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ];
  shacl:targetClass schemas:ContactPoint .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#FormeleorganisatieShape> a shacl:NodeShape;
  rdfs:label "FormeleOrganisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een bedrijf, een vzw, een overheidsorgaan, een kerkgemeenschap."@nl;
  rdfs:comment "Een erkende Organisatie, erkend in brede zin of  meer specifiek in juridische zin met bijbehorende rechten en plichten."@nl;
  shacl:closed false;
  shacl:targetClass org:FormalOrganization,
    <http://www.w3.org/ns/regorg#RegisteredOrganization> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#GeografischenaamShape> a shacl:NodeShape;
  rdfs:label "GeografischeNaam"@nl;
  rdfs:comment "Benaming toegekend aan of gebruikt voor een geografisch object."@nl;
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#GeometrieShape> a shacl:NodeShape;
  rdfs:label "Geometrie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijft deze kenmerken door middel van punten, lijnen, polygonen en coördinaten."@nl;
  rdfs:comment "Vorm- en positiekenmerken van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gml"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#gmlLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in GML-formaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Geometrie.Gml>;
    shacl:description "Geometrie uitgedrukt in GML-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "gml"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.opengis.net/ont/geosparql#asGML>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wkt"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#wktLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in WKT-formaat."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Geometrie.Wkt>;
    shacl:description "Geometrie uitgedrukt in WKT-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "wkt"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.opengis.net/ont/geosparql#asWKT>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Geometry> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#GeregistreerdeorganisatieShape> a shacl:NodeShape;
  rdfs:label "GeregistreerdeOrganisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "In België moeten onder andere volgende Organisaties zich registreren: vennootschap (NV, BV, etc), eenmanszaak, overheidsorgaan, stichting, … Bij registratie krijgt de Organisatie een ondernemingsnummer en worden zijn gegevens ingevoerd in de Kruispuntbank van Ondernemingen (KBO)."@nl;
  rdfs:comment "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een FormeleOrganisatie waarbij dit statuut ook op een andere manier verkregen kan zijn."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "wettelijke naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Evt in verschillende talen."@nl;
    rdfs:comment "Wettelijk geregistreerde naam vd organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Geregistreerdeorganisatie.WettelijkeNaam>;
    shacl:datatype rdf:langString;
    shacl:description "Wettelijk geregistreerde naam vd organisatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "wettelijke naam"@nl;
    shacl:path <http://www.w3.org/ns/regorg#legalName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtspersoonlijkheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Rechtspersoonlijkheid betekent dat men een rechtssubject is, dit wil zeggen drager van rechten en plichten. Natuurlijke personen hebben vanzelf rechtspersoonlijkheid, rechtspersonen (bvb venootschappen) moeten die van rechtswege toegekend krijgen."@nl;
    rdfs:comment "Aard van de rechtspersoonlijkheid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Geregistreerdeorganisatie.Rechtspersoonlijkheid>;
    shacl:class skos:Concept;
    shacl:description "Aard van de rechtspersoonlijkheid."@nl;
    shacl:maxCount "1";
    shacl:name "rechtspersoonlijkheid"@nl;
    shacl:path <http://www.w3.org/ns/regorg#rechtspersoonlijkheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtstoestand"@nl;
    <http://purl.org/vocab/vann/usageNote> "Stemt in de KBO overeen met de rechtstoestand van de Organisatie, bijvoorbeeld normale toestand, gerechtelijk akkoord, opening faillissement etc."@nl;
    rdfs:comment "Status van een GeregistreerdeOrganisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Geregistreerdeorganisatie.Rechtstoestand>;
    shacl:class skos:Concept;
    shacl:description "Status van een GeregistreerdeOrganisatie."@nl;
    shacl:maxCount "1";
    shacl:name "rechtstoestand"@nl;
    shacl:path <http://www.w3.org/ns/regorg#rechtstoestand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtsvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Stemt in de KBO overeen met rechtsvorm, bvb NV, VZW, Stad/Gemeente, OCMW etc."@nl;
    rdfs:comment "Juridisch statuut van de geregistreerde organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Geregistreerdeorganisatie.Rechtsvorm>;
    shacl:class skos:Concept;
    shacl:description "Juridisch statuut van de geregistreerde organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "rechtsvorm"@nl;
    shacl:path <http://www.w3.org/ns/regorg#rechtsvorm>
  ], [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    <http://purl.org/vocab/vann/usageNote> "In de KBO is dit het ondernemingsnummer."@nl;
    rdfs:comment "Identificator dat de organisatie verkreeg bij registratie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Geregistreerdeorganisatie.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator dat de organisatie verkreeg bij registratie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ];
  shacl:targetClass <http://www.w3.org/ns/regorg#RegisteredOrganization> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type vd string slaat op het identificatiesysteem (incl de versie ervan), de string zelf op de eigenlijke identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Identificator.Identificator>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount "1";
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendOp"@nl;
    rdfs:comment "Tijdstip waarop de identificator werd uitgegeven."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Identificator.Toegekendop>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekendOp"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendDoor"@nl;
    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Identificator.Toegekenddoor>;
    shacl:class dc:Agent;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekendDoor"@nl;
    shacl:path dc:creator
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#LangstringShape> a shacl:NodeShape;
  rdfs:label "LangString";
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#LidmaatschapShape> a shacl:NodeShape;
  rdfs:label "Lidmaatschap"@nl;
  rdfs:comment "Geeft de kenmerken weer van het Lidmaatschap van een Agent van een Organisatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "lidVanTot"@nl;
    rdfs:comment "Periode waarin de agent lid was van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Lidmaatschap.Lidvantot>;
    shacl:class <http://www.w3.org/2006/time#ProperInterval>;
    shacl:description "Periode waarin de agent lid was van de Organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "lidVanTot"@nl;
    shacl:path org:memberDuring
  ], [
    a shacl:PropertyShape;
    rdfs:label "rol"@nl;
    rdfs:comment "Rol die de Agent vervult als lid van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Lidmaatschap.Rol>;
    shacl:class org:Role;
    shacl:description "Rol die de Agent vervult als lid van de Organisatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "rol"@nl;
    shacl:path org:role
  ], [
    a shacl:PropertyShape;
    rdfs:label "lid"@nl;
    rdfs:comment "Lidmaatschap van een Agent (van een Organisatie)."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Lidmaatschap.Lid>;
    shacl:description "Lidmaatschap van een Agent (van een Organisatie)."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "lid"@nl;
    shacl:or ([shacl:class org:Organization] [shacl:class org:FormalOrganization] [shacl:class <http://www.w3.org/ns/regorg#RegisteredOrganization>]);
    shacl:path org:member
  ], [
    a shacl:PropertyShape;
    rdfs:label "isLidBij"@nl;
    rdfs:comment "Organisatie waarop het Lidmaatschap (van een Agent) betrekking heeft."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Lidmaatschap.Islidbij>;
    shacl:description "Organisatie waarop het Lidmaatschap (van een Agent) betrekking heeft."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "isLidBij"@nl;
    shacl:or ([shacl:class foaf:Agent] [shacl:class org:Organization] [shacl:class org:FormalOrganization] [shacl:class <http://www.w3.org/ns/regorg#RegisteredOrganization>]);
    shacl:path org:organization
  ];
  shacl:targetClass org:Membership .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#LocatieShape> a shacl:NodeShape;
  rdfs:label "Locatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet direct gewerkt worden met Geometrie, GeografischeNaam, Adres, etc."@nl;
  rdfs:comment "Een locatie kan een identificeerbare geografische locatie zijn (ISO 19112), maar deze locatie kan ook een niet-geografische locatie zijn, zoals een directory, rij of kolom. Als zodanig zijn er talloze manieren waarop locatie kan worden uitgedrukt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Schriftelijke weergave van kenmerken van iets of iemand."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Locatie.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Schriftelijke weergave van kenmerken van iets of iemand."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ];
  shacl:targetClass dc:Location,
    prov:Location,
    <http://www.w3.org/ns/locn#Address> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#OpeningsurenspecificatieShape> a shacl:NodeShape;
  rdfs:label "Openingsurenspecificatie"@nl;
  rdfs:comment "Informatie over de openingsuren van een plaats of dienst."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "dagVanDeWeek"@nl;
    <http://purl.org/vocab/vann/usageNote> "Zie https://schema.org/DayOfWeek voor lijst van mogelijke waarden."@nl;
    rdfs:comment "Dag van de week waarvoor de openingsuren geldig zijn."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Openingsurenspecificatie.Dagvandeweek>;
    shacl:datatype xsd:anyURI;
    shacl:description "Dag van de week waarvoor de openingsuren geldig zijn."@nl;
    shacl:maxCount "1";
    shacl:name "dagVanDeWeek"@nl;
    shacl:path schemas:dayOfWeek
  ], [
    a shacl:PropertyShape;
    rdfs:label "geldigTot"@nl;
    rdfs:comment "Datum tot wanneer de opgegeven openingsuren gelden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Openingsurenspecificatie.Geldigtot>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum tot wanneer de opgegeven openingsuren gelden."@nl;
    shacl:maxCount "1";
    shacl:name "geldigTot"@nl;
    shacl:path schemas:validThrough
  ], [
    a shacl:PropertyShape;
    rdfs:label "geldigVan"@nl;
    rdfs:comment "Datum vanaf wanneer de opgegeven openingsuren gelden."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Openingsurenspecificatie.Geldigvan>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum vanaf wanneer de opgegeven openingsuren gelden."@nl;
    shacl:maxCount "1";
    shacl:name "geldigVan"@nl;
    shacl:path schemas:validFrom
  ], [
    a shacl:PropertyShape;
    rdfs:label "gesloten"@nl;
    rdfs:comment "Sluitingsuur van de plaats of dienst op de opgegeven dag van de week."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Openingsurenspecificatie.Gesloten>;
    shacl:datatype xsd:time;
    shacl:description "Sluitingsuur van de plaats of dienst op de opgegeven dag van de week."@nl;
    shacl:maxCount "1";
    shacl:name "gesloten"@nl;
    shacl:path schemas:closes
  ], [
    a shacl:PropertyShape;
    rdfs:label "open"@nl;
    rdfs:comment "Openingsuur van de plaats of dienst op de opgegeven dag van de week."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Openingsurenspecificatie.Open>;
    shacl:datatype xsd:time;
    shacl:description "Openingsuur van de plaats of dienst op de opgegeven dag van de week."@nl;
    shacl:maxCount "1";
    shacl:name "open"@nl;
    shacl:path schemas:opens
  ];
  shacl:targetClass schemas:OpeningHoursSpecification .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een Organisatie heeft dikwijls een hiërarchische structuur."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Organisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieveNaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: commerciële naam, informele naam, etc."@nl;
    rdfs:comment "Andere naam waaronder de Organisatie bekend is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Organisatie.Alternatievenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Andere naam waaronder de Organisatie bekend is."@nl;
    shacl:name "alternatieveNaam"@nl;
    shacl:path skos:altLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "activiteit"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van het attribuut classificatie (naast type & status)."@nl;
    rdfs:comment "Type activiteit die door de organisatie wordt uitgeoefend."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Organisatie.Activiteit>;
    shacl:class skos:Concept;
    shacl:description "Type activiteit die door de organisatie wordt uitgeoefend."@nl;
    shacl:maxCount "1";
    shacl:name "activiteit"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgActivity>
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Organisatie.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van classificatie (naast type & activiteit)."@nl;
    rdfs:comment "Toestand van de Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Organisatie.Status>;
    shacl:class skos:Concept;
    shacl:description "Toestand van de Organisatie."@nl;
    shacl:name "status"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgStatus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van classificatie (naast activiteit & status)."@nl;
    rdfs:comment "Soort Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Organisatie.Type>;
    shacl:class skos:Concept;
    shacl:description "Soort Organisatie."@nl;
    shacl:name "type"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgType>
  ], [
    a shacl:PropertyShape;
    rdfs:label "lid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dekt elk type aansluiting of betrokkenheid van een Agent bij een Organisatie, niet enkel formeel lidmaatschap. Kan eventueel verder gespecialiseerd worden. Het lidmaatschap wordt meer in detail beschreven met de entiteit Lidmaatschap (door middel van associatieklasse modellering)."@nl;
    rdfs:comment "Agent die lid is (van een Organisatie)."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Organisatie.Lid>;
    shacl:description "Agent die lid is (van een Organisatie)."@nl;
    shacl:name "lid"@nl;
    shacl:or ([shacl:class foaf:Agent] [shacl:class org:Organization] [shacl:class org:FormalOrganization] [shacl:class <http://www.w3.org/ns/regorg#RegisteredOrganization>]);
    shacl:path org:hasMember
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftLid"@nl;
    rdfs:comment "Lidmaatschap van een Agent van een Organisatie."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#Organisatie.Heeftlid>;
    shacl:class org:Membership;
    shacl:description "Lidmaatschap van een Agent van een Organisatie."@nl;
    shacl:name "heeftLid"@nl;
    shacl:path org:hasMembership
  ];
  shacl:targetClass org:Organization,
    org:FormalOrganization,
    <http://www.w3.org/ns/regorg#RegisteredOrganization> .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#PlaatsShape> a shacl:NodeShape;
  rdfs:label "Plaats"@nl;
  rdfs:comment "Een ruimtelijk gebied of benoemde plaats."@nl;
  shacl:closed false;
