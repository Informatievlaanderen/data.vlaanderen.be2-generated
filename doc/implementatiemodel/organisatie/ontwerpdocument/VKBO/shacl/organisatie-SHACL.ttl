    shacl:description "Geometrie van de plaats of het gebied."@nl;
    shacl:maxCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass dc:Location .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#TimeShape> a shacl:NodeShape;
  rdfs:label "Time";
  shacl:closed false;
  shacl:targetClass xsd:time .

<https://data.test-vlaanderen.be/doc/implementatiemodel/organisatie/ontwerpdocument/VKBO#UriShape> a shacl:NodeShape;
  rdfs:label "URI";
  shacl:closed false;
  shacl:targetClass xsd:anyURI .
