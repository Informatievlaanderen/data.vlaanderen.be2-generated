    shacl:description "De Zaak die de Agent behandelt."@nl;
    shacl:name "zaak"@nl;
    shacl:path dbo:Case
  ];
  shacl:targetClass dc:Agent .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#AnyShape> a shacl:NodeShape;
  rdfs:label "Any"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te substitueren door een geschikte klasse of datatype."@nl;
  rdfs:comment "Instanties van  om het even welk type."@nl;
  shacl:closed false;
  shacl:targetClass rdfs:Resource .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#BenoemdewaardeShape> a shacl:NodeShape;
  rdfs:label "BenoemdeWaarde"@nl;
  <http://purl.org/vocab/vann/usageNote> "In essentie een waarde en de naam vh type van de waarde. Bv een temperatuur van 21graden Celcius (waarde = 21 graden Celcius, naam = temperatuur)."@nl;
  rdfs:comment "Generieke, zwak getypeerde waarde."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam vh type van de waarde."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Benoemdewaarde.Naam>;
    shacl:description "Naam vh type van de waarde."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path schemas:name
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "Kwalitatieve of kwantitatieve invulling van de waarde."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Benoemdewaarde.Waarde>;
    shacl:class rdfs:Resource;
    shacl:description "Kwalitatieve of kwantitatieve invulling van de waarde."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "waarde"@nl;
    shacl:path schemas:value
  ];
  shacl:targetClass schemas:StructuredValue .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#ConceptShape> a shacl:NodeShape;
  rdfs:label "Concept"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bedoeld om kennis te organiseren, bijvoorbeeld in een codelijst of taxonomie (een zogenaamde ConceptScheme). Zie <a href=\"https://www.w3.org/TR/skos-reference/\">SKOS</a> voor meer informatie."@nl;
  rdfs:comment "Idee of begrip."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#DateShape> a shacl:NodeShape;
  rdfs:label "Date";
  shacl:closed false;
  shacl:targetClass xsd:date .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#GeometrieShape> a shacl:NodeShape;
  rdfs:label "Geometrie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijft deze kenmerken door middel van punten, lijnen, polygonen en coördinaten."@nl;
  rdfs:comment "Vorm- en positiekenmerken van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gml"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#gmlLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in gml-formaat."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Geometrie.Gml>;
    shacl:description "Geometrie uitgedrukt in gml-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "gml"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.opengis.net/ont/geosparql#asGML>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wkt"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#wktLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in wkt-formaat."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Geometrie.Wkt>;
    shacl:description "Geometrie uitgedrukt in wkt-formaat."@nl;
    shacl:maxCount "1";
    shacl:name "wkt"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://www.opengis.net/ont/geosparql#asWKT>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Geometry> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type vd string slaat op het identificatiesysteem (incl de versie ervan), de string zelf op de eigenlijke identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Identificator.Identificator>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount "1";
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door (String)"@nl;
    rdfs:comment "Naam vd agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Identificator.ToegekendDoor(string)>;
    shacl:datatype xsd:string;
    shacl:description "Naam vd agent die de identificator heeft toegekend."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend door (String)"@nl;
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend op"@nl;
    rdfs:comment "Tijdstip waarop de identificator werd uitgegeven."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Identificator.ToegekendOp>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend op"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door"@nl;
    <http://purl.org/vocab/vann/usageNote> "Te gebruiken als naar de agent kan worden verwezen dmv een uri. Gebruik anders het attribuut \"toegekendDoor(String)\"."@nl;
    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Identificator.ToegekendDoor>;
    shacl:class dc:Agent;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekend door"@nl;
    shacl:path dc:creator
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#InputShape> a shacl:NodeShape;
  rdfs:label "Input"@nl;
  rdfs:comment "Informatie die door een procedure wordt gebruikt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "referentie"@nl;
    rdfs:comment "Verwijzing naar originele Input."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Input.Referentie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Verwijzing naar originele Input."@nl;
    shacl:maxCount "1";
    shacl:name "referentie"@nl;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de input."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Input.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de input."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <http://www.w3.org/ns/ssn/Input> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#KenmerktypeShape> a shacl:NodeShape;
  rdfs:label "Kenmerktype"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de context van Observaties en Metingen is dit een kenmerk van het geobseveerdObject (of van het bemonsterdObject of een onderdeel daarvan) en in principe van alle instanties van dat type geobserveerdObject. Bv Lichaamstemperatuur, Lithologie, ChemischeSamenstelling (resp van een Persoon, een GeologischeEenheid en - meer indirect - van een Monster genomen op een bepaalde plek in een Rivier). Substitueren door een <a href=\"https://www.w3.org/TR/skos-reference/#Concept\">skos:Concept</a> OF een instantie van een equivalente klasse bvb <a href=\"https://qudt.org/schema/qudt/QuantityKind\">qudt:QuantityKind</a> OF eigen subklasse."@nl;
  rdfs:comment "Klasse die kenmerken van instanties van om het even welk type vertegenwoordigt."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/sosa/Property> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#KwaliteitselementShape> a shacl:NodeShape;
  rdfs:label "Kwaliteitselement"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijft een bepaald aspect van de  datakwaliteit, bvb PositioneleNauwkeurigheid, LogischeConsistentie, Volledigheid etc. OPMERKING: Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/datakwaliteit/\">OSLO Datakwaliteit</a>."@nl;
  rdfs:comment "Component van datakwaliteit."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/dqv#QualityMeasurement> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#LangstringShape> a shacl:NodeShape;
  rdfs:label "LangString";
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#LocatieShape> a shacl:NodeShape;
  rdfs:label "Locatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet dit datatype gesubstitueerd worden door klassen of datatypes zoals Geometrie, GeografischeNaam, Adres etc. OPMERKING: Meer info over deze klassen/datatypes in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/\">OSLO Generiek - basis</a>."@nl;
  rdfs:comment "Aanduiding van een geografische positie, door middel van coördinaten, een toponiem, een adreslabel, een verwijzing naar een plaats/regio of verwijzing naar een adres."@nl;
  shacl:closed false;
  shacl:targetClass prov:Location .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#MeldingShape> a shacl:NodeShape;
  rdfs:label "Melding"@nl;
  <http://purl.org/vocab/vann/usageNote> "De Melding kan gebruikt worden voor het capteren van feedback met betrekking tot concrete informatievelden (bv. foutieve of ontbrekende informatie wordt weergegeven) of feedback dat slaat op reële wereld objecten zoals een put in de weg of sluikstort."@nl;
  rdfs:comment "Beschrijft de melding van een probleem of een vaststelling die mogelijks aanleiding geeft tot een actie van de overheid."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "samenvatting"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap kan gebruikt worden als een tekstveld om de Melding en de informatie die eraan gekoppeld is samen te vatten en de behandeling ervan te vergemakkelijken."@nl;
    rdfs:comment "Een samenvatting van de Melding."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Melding.Samenvatting>;
    shacl:datatype rdf:langString;
    shacl:description "Een samenvatting van de Melding."@nl;
    shacl:maxCount "1";
    shacl:name "samenvatting"@nl;
    shacl:path as:summary
  ], [
    a shacl:PropertyShape;
    rdfs:label "titel"@nl;
    rdfs:comment "De titel van de Melding."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Melding.Titel>;
    shacl:datatype rdf:langString;
    shacl:description "De titel van de Melding."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "titel"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "webpagina"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap kan gebruikt worden om een gebruiker door te verwijzen naar een applicatie waar de actuele status van de Melding kan geraadpleegd worden."@nl;
    rdfs:comment "Een doorverwijzing naar een webpagina over deze Melding."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Melding.Webpagina>;
    shacl:datatype xsd:anyURI;
    shacl:description "Een doorverwijzing naar een webpagina over deze Melding."@nl;
    shacl:maxCount "1";
    shacl:name "webpagina"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#webpagina>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De identificator die de Melding uniek identificeert."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Melding.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "De identificator die de Melding uniek identificeert."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft body"@nl;
    rdfs:comment "Het object van deze associatie is een resource die de body van de Melding beschrijft (MeldingBody)."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Melding.HeeftBody>;
    shacl:class <https://data.vlaanderen.be/ns/melding#MeldingBody>;
    shacl:description "Het object van deze associatie is een resource die de body van de Melding beschrijft (MeldingBody)."@nl;
    shacl:name "heeft body"@nl;
    shacl:path oa:hasBody
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft status"@nl;
    rdfs:comment "De Status verbonden aan de Melding."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Melding.HeeftStatus>;
    shacl:class <https://data.vlaanderen.be/ns/melding#Meldingstatus>;
    shacl:description "De Status verbonden aan de Melding."@nl;
    shacl:name "heeft status"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#heeftStatus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "meldingstype"@nl;
    <http://purl.org/vocab/vann/usageNote> "Er wordt verwacht dat het meldingstype gedefinieerd is in een codelijst. Het bepalen en ontlsuiten van deze codelijst kan applicatie-specifiek worden ingevuld."@nl;
    rdfs:comment "De relatie tussen de Melding en het Meldingstype dat gebruikt worden om de melding te categoriseren."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Melding.Meldingstype>;
    shacl:class skos:Concept;
    shacl:description "De relatie tussen de Melding en het Meldingstype dat gebruikt worden om de melding te categoriseren."@nl;
    shacl:minCount "1";
    shacl:name "meldingstype"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft doelwit"@nl;
    rdfs:comment "De relatie tussen de Melding en het doelwit, het Meldingsobject waarop de melding slaat."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Melding.HeeftDoelwit>;
    shacl:class <http://www.w3.org/ns/sosa/FeatureOfInterest>;
    shacl:description "De relatie tussen de Melding en het doelwit, het Meldingsobject waarop de melding slaat."@nl;
    shacl:name "heeft doelwit"@nl;
    shacl:path oa:hasTarget
  ], [
    a shacl:PropertyShape;
    rdfs:label "behandelaar"@nl;
    rdfs:comment "Agent die werd aangewezen om de melding op te volgen en af te handelen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Melding.Behandelaar>;
    shacl:class dc:Agent;
    shacl:description "Agent die werd aangewezen om de melding op te volgen en af te handelen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "behandelaar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#behandelaar>
  ], [
    a shacl:PropertyShape;
    rdfs:label "indiener"@nl;
    rdfs:comment "Agent die de Melding heeft aangemaakt en/of ingediend."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Melding.Indiener>;
    shacl:class dc:Agent;
    shacl:description "Agent die de Melding heeft aangemaakt en/of ingediend."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "indiener"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#indiener>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/melding#Melding> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#MeldingbodyShape> a shacl:NodeShape;
  rdfs:label "MeldingBody"@nl;
  rdfs:comment "De body van de Melding, deze omvat relevante informatie voor de verdere afhandeling van een melding."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Deze eigenschap kan gebruikt worden om extra beschrijvende tekst mee te geven over het Meldingsobject."@nl;
    rdfs:comment "Een tekstuele beschrijving van de melding."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Meldingbody.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Een tekstuele beschrijving van de melding."@nl;
    shacl:maxCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "bijlage"@nl;
    <http://purl.org/vocab/vann/usageNote> "Via deze eigenschap is het mogelijk om bv. Foto's of PDF documenten te koppelen aan de Melding."@nl;
    rdfs:comment "Identificeert een resource die aan de MeldingsBody verbonden is en mogelijks speciale verwerking vraagt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Meldingbody.Bijlage>;
    shacl:datatype xsd:anyURI;
    shacl:description "Identificeert een resource die aan de MeldingsBody verbonden is en mogelijks speciale verwerking vraagt."@nl;
    shacl:maxCount "1";
    shacl:name "bijlage"@nl;
    shacl:path as:attachment
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Wanneer een Agent een Melding aanmaakt kan deze bv. een bounding box tekenen op een map. De geometrie hiervan kan weegegeven worden via de eigenschap geometrie van MeldingBody."@nl;
    rdfs:comment "De relatie tussen de MeldingBody en een geometrie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Meldingbody.Geometrie>;
    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "De relatie tussen de MeldingBody en een geometrie."@nl;
    shacl:maxCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/melding#MeldingBody> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#MeldingstatusShape> a shacl:NodeShape;
  rdfs:label "Meldingstatus"@nl;
  <http://purl.org/vocab/vann/usageNote> "De Melding kan gelinkt zijn aan meerdere Status objecten, elk ervan geeft de status op een bepaald tijdstip weer."@nl;
  rdfs:comment "De Status van de Melding in het verwerkingsproces op een bepaald tijdstip."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    rdfs:comment "Een beschrijving van de Status."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Meldingstatus.Beschrijving>;
    shacl:datatype xsd:string;
    shacl:description "Een beschrijving van de Status."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "statusdatum"@nl;
    rdfs:comment "De datum van een Status."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Meldingstatus.Statusdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum van een Status."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "statusdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#statusdatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Er wordt verwacht dat het status type gedefinieerd is in een codelijst. Het bepalen en ontlsuiten van deze codelijst kan applicatie-specifiek worden ingevuld."@nl;
    rdfs:comment "Het type van de Status."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Meldingstatus.StatusType>;
    shacl:class skos:Concept;
    shacl:description "Het type van de Status."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "status type"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#statuswaarde>
  ], [
    a shacl:PropertyShape;
    rdfs:label "statuswijziging door"@nl;
    rdfs:comment "De Agent die deze status heeft geactiveerd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Meldingstatus.StatuswijzigingDoor>;
    shacl:class dc:Agent;
    shacl:description "De Agent die deze status heeft geactiveerd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "statuswijziging door"@nl;
    shacl:path <https://data.vlaanderen.be/ns/melding#statuswijzigingDoor>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/melding#Meldingstatus> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#MobiliteitshinderShape> a shacl:NodeShape;
  rdfs:label "Mobiliteitshinder"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dit is het werkelijk geobserveerdObject. Als rechtstreeks observeren niet kan observeren we een representatief staal, het zgn Bemonsteringsobject. In dat geval is het Domeinobject het bemonsterdObject. OPMERKING: Deze klasse is louter informatief, in praktijk moet ze gesubstitueerd worden door een klasse uit het domein. Bv in het domein Waterkwaliteit zou het domeinobject een instantie vd klasse Rivier kunnen zijn. Meer info over deze klasse in applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/besluit-mobiliteit/\">Besluit Mobiliteit</a>."@nl;
  rdfs:comment "Verstoring van de normale mobiliteit op het openbaar domein of privé domein met openbaar karakter."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit#Mobiliteitshinder> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#MomentShape> a shacl:NodeShape;
  rdfs:label "Moment"@nl;
  rdfs:comment "Moment met omvang en duur nul."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "in XSD datumTijd"@nl;
    rdfs:comment "Positie in de tijd uitgedrukt dmv xsd:dateTime."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Moment.InXsdDatumtijd>;
    shacl:datatype xsd:dateTime;
    shacl:description "Positie in de tijd uitgedrukt dmv xsd:dateTime."@nl;
    shacl:maxCount "1";
    shacl:name "in XSD datumTijd"@nl;
    shacl:path <http://www.w3.org/2006/time#inXSDDateTime>
  ];
  shacl:targetClass <http://www.w3.org/2006/time#Instant> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#ObjectShape> a shacl:NodeShape;
  rdfs:label "Object"@nl;
  rdfs:comment "Klasse die instanties van om het even welk type vertegenwoordigt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van het Domeinobject."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Object.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van het Domeinobject."@nl;
    shacl:maxCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "waardeverschaffer"@nl;
    rdfs:comment "Observaties die op het Object gebeuren."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Object.Waardeverschaffer>;
    shacl:class <http://www.w3.org/ns/sosa/Observation>;
    shacl:description "Observaties die op het Object gebeuren."@nl;
    shacl:name "waardeverschaffer"@nl;
    shacl:path <http://www.w3.org/ns/sosa/isFeatureOfInterestOf>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/FeatureOfInterest> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#ObservatieShape> a shacl:NodeShape;
  rdfs:label "Observatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Het gaat om schattingen van de waarde, met andere woorden op de waarde zit een zekere foutmarge. Voorbeelden zijn temperatuur, klasse, kleur. Dit is verschillend van waarden die zijn toegekend en dus geen schattingen zijn zoals naam of prijs."@nl;
  rdfs:comment "Het vaststellen van de waarde van een bepaald kenmerk van een Object op een bepaald tijdstip of tussen twee tijdstippen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "fenomeentijd"@nl;
    <http://purl.org/vocab/vann/usageNote> "Typisch het moment waarop geobserveerd of bemonsterd werd. Als de Observatie temporeel is en het moment waarop iets plaatsvindt wordt geregistreerd dan is dit meteen ook de fenomeentijd."@nl;
    rdfs:comment "Het moment waarop het resultaat van de Observatie van toepassing was."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.Fenomeentijd>;
    shacl:class <http://www.w3.org/2006/time#TemporalEntity>;
    shacl:description "Het moment waarop het resultaat van de Observatie van toepassing was."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "fenomeentijd"@nl;
    shacl:path <http://www.w3.org/ns/sosa/phenomenonTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geldigeTijd"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv nuttig voor weersvoorspellingen."@nl;
    rdfs:comment "Periode waarvoor het resultaat van de Observatie geldt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.Geldigetijd>;
    shacl:class <http://www.w3.org/2006/time#ProperInterval>;
    shacl:description "Periode waarvoor het resultaat van de Observatie geldt."@nl;
    shacl:maxCount "1";
    shacl:name "geldigeTijd"@nl;
    shacl:path <http://www.w3.org/ns/sosa/oms/validTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De persoon of het ding dat dient om de observatie vast te stellen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "De persoon of het ding dat dient om de observatie vast te stellen."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "parameter"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het gaat hier niet om kenmerken van het geobserveerdObject (die worden al beschreven door het geobserveerdKenmerk) of om parameters geassocieerd met het observatieproces (zoals een instelling van een instrument). Het gaat hier bv om omgevingsparameters die het resultaat kunnen beïnvloeden en van belang zijn om het resultaat correct te interpreteren.  Een voorbeeld is de diepte in een waterput waarop de waterkwaliteit is gemeten of de omgevingstemperatuur bij het meten van de vochtigheidsgraad."@nl;
    rdfs:comment "Willekeurig gegeven gassocieerd met het gebeuren van de Observatie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.Parameter>;
    shacl:class schemas:StructuredValue;
    shacl:description "Willekeurig gegeven gassocieerd met het gebeuren van de Observatie."@nl;
    shacl:name "parameter"@nl;
    shacl:path dbo:influencedBy
  ], [
    a shacl:PropertyShape;
    rdfs:label "resultaat"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het resultaat kan van om het even welk type zijn aangezien om het even welk Kenmerk van om het even welk type Object kan worden geobserveerd. CONSTRAINT: Het type van het resultaat van de Observatie moet kloppen met het geobserveerdKenmerk en de verkregen waarde moet binnen het bereik vallen van het geobserveerdKenmerk."@nl;
    rdfs:comment "De waarde van het geobserveerdeKenmerk als resultaat van de Observatie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.Resultaat>;
    shacl:class rdfs:Resource;
    shacl:description "De waarde van het geobserveerdeKenmerk als resultaat van de Observatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "resultaat"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasResult>
  ], [
    a shacl:PropertyShape;
    rdfs:label "resultaatkwaliteit"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het gaat hier om gegevens die eigen zijn aan de Observatie en complementair aan de beschrijving van de procedure die bij de Observatie is gevolgd (analysemethode edm, zie klasse Proces) wat op zich ook al iets zegt over de kwaliteit van het resultaat."@nl;
    rdfs:comment "Mate waarin het resultaat van de Observatie voldoet aan de vereisten of verwachtingen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.Resultaatkwaliteit>;
    shacl:class <http://www.w3.org/ns/dqv#QualityMeasurement>;
    shacl:description "Mate waarin het resultaat van de Observatie voldoet aan de vereisten of verwachtingen."@nl;
    shacl:name "resultaatkwaliteit"@nl;
    shacl:path <http://www.w3.org/ns/sosa/resultQuality>
  ], [
    a shacl:PropertyShape;
    rdfs:label "resultaattijd"@nl;
    <http://purl.org/vocab/vann/usageNote> "Is voor sommige Observaties gelijk aan de fenomeentijd maar kan ook verschillen, bv bij het uitvoeren van een analyse op een Monster dat eerder (en doorgaans dan ook eders) werd genomen of bij sensormetingen die pas later worden verwerkt. Ook bruikbaar om herhaalde Observaties bv op eenzelfde Monster uiteen te houden. Is het resultaat een voorspelling dan is de fenomeentijd het moment waarop deze van toepassing zou moeten zijn."@nl;
    rdfs:comment "Tijdstip waarop het resultaat van de Observatie werd bekomen."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.Resultaattijd>;
    shacl:class <http://www.w3.org/2006/time#Instant>;
    shacl:description "Tijdstip waarop het resultaat van de Observatie werd bekomen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "resultaattijd"@nl;
    shacl:path <http://www.w3.org/ns/sosa/resultTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Het type van observatie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.Type>;
    shacl:class skos:Concept;
    shacl:description "Het type van observatie."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdDoor"@nl;
    rdfs:comment "Agent die de Observatie heeft uitgevoerd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.Uitgevoerddoor>;
    shacl:class dc:Agent;
    shacl:description "Agent die de Observatie heeft uitgevoerd."@nl;
    shacl:name "uitgevoerdDoor"@nl;
    shacl:path dc:contributor
  ], [
    a shacl:PropertyShape;
    rdfs:label "geobserveerd kenmerk"@nl;
    <http://purl.org/vocab/vann/usageNote> "Kan een proxy zijn vh kenmerk dat men werkelijk wil observeren, bvb kleurreflectie op het aardoppervlak als subsituut voopr vegetatie. CONSTRAINT: Het geobserveerdKenmerk moet werkelijk een kenmerk zijn van het geobserveerdObject of van een (onder)deel ervan. Bv de zuurtegraad van een Bron is eigenlijk de zuurtegraad van het Waterlichaam van de Aquifer die door de Bron is aangeboord."@nl;
    rdfs:comment "Kenmerk dat men observeert vh geobserveerdObject."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.GeobserveerdKenmerk>;
    shacl:class <http://www.w3.org/ns/sosa/Property>;
    shacl:description "Kenmerk dat men observeert vh geobserveerdObject."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "geobserveerd kenmerk"@nl;
    shacl:path <http://www.w3.org/ns/sosa/observedProperty>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geobserveerd object"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dat kan het Object zelf zijn of een proxy ervan, ttz een Bemonsteringsobject. OPMERKING: In dat laatste geval weet men soms pas na het observeren welke real-world Objecten men juist geobserveerd heeft."@nl;
    rdfs:comment "Object dat men observeert."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.GeobserveerdObject>;
    shacl:class <http://www.w3.org/ns/sosa/FeatureOfInterest>;
    shacl:description "Object dat men observeert."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "geobserveerd object"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasFeatureOfInterest>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerd met"@nl;
    rdfs:comment "De Sensor waarmee de Verkeersmeting werd uitgevoerd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.UitgevoerdMet>;
    shacl:class <http://www.w3.org/ns/sosa/Sensor>;
    shacl:description "De Sensor waarmee de Verkeersmeting werd uitgevoerd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "uitgevoerd met"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeBySensor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruikteProcedure"@nl;
    rdfs:comment "Procedure gebruikt voor de Verkeersmeting."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatie.Gebruikteprocedure>;
    shacl:class <http://www.w3.org/ns/sosa/Procedure>;
    shacl:description "Procedure gebruikt voor de Verkeersmeting."@nl;
    shacl:name "gebruikteProcedure"@nl;
    shacl:path <http://www.w3.org/ns/sosa/usedProcedure>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Observation> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#ObservatieprocedureShape> a shacl:NodeShape;
  rdfs:label "Observatieprocedure"@nl;
  <http://purl.org/vocab/vann/usageNote> "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bv de correcte plaatsing van een windmeter (op een welbepaalde hoogte boven het grondoppervlak, bv 10m voor meteorologische waarnemingen). De procedures zijn doorgaans bedoeld om bij meer dan één Bemonstering te worden toegepast."@nl;
  rdfs:comment "Een workflow, protocol, plan, algoritme, of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "specificatie"@nl;
    rdfs:comment "Verwijzing naar een document dat de Observatieprocedure beschrijft."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieprocedure.Specificatie>;
    shacl:datatype xsd:anyURI;
    shacl:description "Verwijzing naar een document dat de Observatieprocedure beschrijft."@nl;
    shacl:name "specificatie"@nl;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "input"@nl;
    rdfs:comment "Verwijzing naar de Input die de procedure vereist."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieprocedure.Input>;
    shacl:class <http://www.w3.org/ns/ssn/Input>;
    shacl:description "Verwijzing naar de Input die de procedure vereist."@nl;
    shacl:name "input"@nl;
    shacl:path <http://www.w3.org/ns/ssn/hasInput>
  ], [
    a shacl:PropertyShape;
    rdfs:label "output"@nl;
    rdfs:comment "Verwijzing naar de Output die de Procedure genereert."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieprocedure.Output>;
    shacl:class schemas:StructuredValue;
    shacl:description "Verwijzing naar de Output die de Procedure genereert."@nl;
    shacl:name "output"@nl;
    shacl:path <http://www.w3.org/ns/ssn/hasOutput>
  ], [
    a shacl:PropertyShape;
    rdfs:label "parameter"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv een parameter die een aspect van de Observatieprocedure beschrijft (bv de vereiste hoogte voor het observeren van windsnelheid) of een noodzakelijke omgevingsparameter (bv temperatuurbereik waarbinnen een labo-analyse moet plaatsvinden)."@nl;
    rdfs:comment "Willekeurig gegeven geassocieerd met de Observatieprocedure."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieprocedure.Parameter>;
    shacl:class schemas:StructuredValue;
    shacl:description "Willekeurig gegeven geassocieerd met de Observatieprocedure."@nl;
    shacl:name "parameter"@nl;
    shacl:path dbo:influencedBy
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de Observatieprocedure."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieprocedure.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard van de Observatieprocedure."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Procedure> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#ObservatieverzamelingShape> a shacl:NodeShape;
  rdfs:label "Observatieverzameling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv Observaties die op hetzelfde tijdstip plaatsvonden of hetzelfde Object observeren of door dezelfde sensor zijn gemaakt."@nl;
  rdfs:comment "Collectie van Observaties met dezelfde kenmerken."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "resultaattijd"@nl;
    rdfs:comment "De resultaattijd van de Observaties."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieverzameling.Resultaattijd>;
    shacl:datatype xsd:dateTime;
    shacl:description "De resultaattijd van de Observaties."@nl;
    shacl:maxCount "1";
    shacl:name "resultaattijd"@nl;
    shacl:path <http://www.w3.org/ns/sosa/resultTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geobserveerdKenmerk"@nl;
    rdfs:comment "Het Kenmerk dat de Observaties observeerden."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieverzameling.Geobserveerdkenmerk>;
    shacl:class <http://www.w3.org/ns/sosa/Property>;
    shacl:description "Het Kenmerk dat de Observaties observeerden."@nl;
    shacl:maxCount "1";
    shacl:name "geobserveerdKenmerk"@nl;
    shacl:path <http://www.w3.org/ns/sosa/observedProperty>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geobserveerdObject"@nl;
    rdfs:comment "Het Object dat werd geobserveerd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieverzameling.Geobserveerdobject>;
    shacl:class <http://www.w3.org/ns/sosa/FeatureOfInterest>;
    shacl:description "Het Object dat werd geobserveerd."@nl;
    shacl:maxCount "1";
    shacl:name "geobserveerdObject"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasFeatureOfInterest>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerdMetsensor"@nl;
    rdfs:comment "De sensor waarmee de Observaties in de collectie zijn uitgevoerd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieverzameling.Uitgevoerdmetsensor>;
    shacl:class <http://www.w3.org/ns/sosa/Sensor>;
    shacl:description "De sensor waarmee de Observaties in de collectie zijn uitgevoerd."@nl;
    shacl:maxCount "1";
    shacl:name "uitgevoerdMetsensor"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeBySensor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "fenomeentijd"@nl;
    rdfs:comment "De fenomeentijd vd Observaties."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieverzameling.Fenomeentijd>;
    shacl:class <http://www.w3.org/2006/time#TemporalEntity>;
    shacl:description "De fenomeentijd vd Observaties."@nl;
    shacl:maxCount "1";
    shacl:name "fenomeentijd"@nl;
    shacl:path <http://www.w3.org/ns/sosa/phenomenonTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruikteProcedure"@nl;
    rdfs:comment "De Procedure die de Observaties gebruikten."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieverzameling.Gebruikteprocedure>;
    shacl:class <http://www.w3.org/ns/sosa/Procedure>;
    shacl:description "De Procedure die de Observaties gebruikten."@nl;
    shacl:maxCount "1";
    shacl:name "gebruikteProcedure"@nl;
    shacl:path <http://www.w3.org/ns/sosa/usedProcedure>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft lid"@nl;
    rdfs:comment "Observatie die deel uitmaakt van de collectie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Observatieverzameling.HeeftLid>;
    shacl:class <http://www.w3.org/ns/sosa/Observation>;
    shacl:description "Observatie die deel uitmaakt van de collectie."@nl;
    shacl:minCount 1;
    shacl:name "heeft lid"@nl;
    shacl:path <http://www.w3.org/ns/sosa/hasMember>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/ObservationCollection> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#OutputShape> a shacl:NodeShape;
  rdfs:label "Output"@nl;
