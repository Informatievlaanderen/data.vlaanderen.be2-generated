  ];
  shacl:targetClass rdfs:Resource .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#SensorShape> a shacl:NodeShape;
  rdfs:label "Sensor"@nl;
  <http://purl.org/vocab/vann/usageNote> "Sensoren genereren een resultaat op basis van een Stimulus, ttz een verandering in de omgeving, of op basis van resultaten van andere Observaties. Ze worden typisch gehost door een Platform. Voorbeelden zijn snelheidsmeters, gyroscopen, barometers, magnetometers gemonteerd op een smart phone. Ook bv het menselijk oog kan beschouwd worden als een sensor."@nl;
  rdfs:comment "Toestel of Agent (incl Personen of software) waarmee Observaties gemaakt worden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "ligging"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb de coördinaten of het adres of een verwijzing naar een meetpunt of ander Bemonsteringsobject. Meerdere verschillende types van locaties kunnen worden opgegeven (bvb adres èn coördinaten). Als de Sensor een meetinstallatie is evt de verschillende meetpunten die worden omvat of een omschrijvende polygoon. OPGELET: De locatie van de Sensor is niet noodzakelijk de positie waar de Observatie gebeurt, die wordt in de eerste plaats gegeven door de ligging vh Bemonsteringsobject of het Domeinobject. Dit attribuut laat vooral toe om posities van Sensoren te beschrijven los vd metingen die er gebeuren."@nl;
    rdfs:comment "Locatie van de Sensor."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Sensor.Ligging>;
    shacl:class prov:Location;
    shacl:description "Locatie van de Sensor."@nl;
    shacl:name "ligging"@nl;
    shacl:path <https://data.vlaanderen.be/ns/verkeersmetingen#ligging>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard vh Systeem."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Sensor.Type>;
    shacl:class skos:Concept;
    shacl:description "Aard vh Systeem."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgevoerde observatie"@nl;
    rdfs:comment "Verkeersmeting die met de Sensor is uitgevoerd."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Sensor.UitgevoerdeObservatie>;
    shacl:class <http://www.w3.org/ns/sosa/Observation>;
    shacl:description "Verkeersmeting die met de Sensor is uitgevoerd."@nl;
    shacl:name "uitgevoerde observatie"@nl;
    shacl:path <http://www.w3.org/ns/sosa/madeObservation>
  ];
  shacl:targetClass <http://www.w3.org/ns/sosa/Sensor> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#TemporeleentiteitShape> a shacl:NodeShape;
  rdfs:label "TemporeleEntiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Die temporele objecten zijn temporele geometrische primitieven zoals Moment of Periode. OPMERKING: Dit datatype is Abstract, gebruik een van de subklassen."@nl;
  rdfs:comment "Abstracte klasse voor temporele objecten."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/2006/time#TemporalEntity> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#UriShape> a shacl:NodeShape;
  rdfs:label "URI";
  shacl:closed false;
  shacl:targetClass xsd:anyURI .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#VerkeersmetingShape> a shacl:NodeShape;
  rdfs:label "Verkeersmeting"@nl;
  <http://purl.org/vocab/vann/usageNote> "Verkeer wordt gedefinieerd als de verplaatsing van objecten zoals personen, vracht, data etc over media zoals land, water, lucht, kabels. In de context van dit applicatieprofiel bedoelen we met verkeer het wegverkeer. Verkeer kan betrekking hebben op objecten die zichzelf verplaatsen (al dan niet met een vervoermiddel) of objecten die vervoerd worden, maar ook op objecten waarover verkeer plaatsvindt. De meting kan het vaststellen van de waarde van een kenmerk van een individueel Voertuig of Verkeersdeelnemer tijdens zijn verplaatsing zijn (bvb zijn snelheid of nummerplaat) of van een kenmerk van de infrastructuur zoals een Wegsegment of een Rijstrook waarover het verkeer zich beweegt (bv de verkeersintensiteit). Verkeersmetingen  zijn Observaties, maw op de waarde zit een zekere foutmarge door de gebruikte meettechniek. OPMERKING: Meer info over deze klasse in applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/verkeersmetingen\">Verkeersmetingen</a>."@nl;
  rdfs:comment "Het vaststellen van de waarde van een bepaald kenmerk van het verkeer op een bepaald tijdstip of tussen twee tijdstippen."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeting> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#VerkeersobjectShape> a shacl:NodeShape;
  rdfs:label "Verkeersobject"@nl;
  <http://purl.org/vocab/vann/usageNote> "OPGELET: Deze klasse is abstract, ze moet gespecialiseerd worden als Verkeersdomeinobject of als Verkeersbemonsteringsobject. Als Verkeersdomeinobject als de meting direct betrekking heeft op het object dat men wil observeren (bvb een Wegsegment of een Voertuig etc) of als Verkeersbemonsteringsobject als de meting onrechtstreeks gebeurt (bvb via een Verkeersmeetpunt gelegen langs een Wegsegment). OPMERKING: Meer info over deze klasse in applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/verkeersmetingen\">Verkeersmetingen</a>."@nl;
  rdfs:comment "Object waarop of waarlangs zich verkeer voordoet of dat deel uitmaakt vh verkeer."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersobject> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#VerkeerssituatieShape> a shacl:NodeShape;
  rdfs:label "Verkeerssituatie";
  <http://purl.org/vocab/vann/usageNote> "DATEX Verkeerssituatie is de superklasse van alle soorten situaties in het verkeer die de DATEX II standaard beschrijft. Deze kan worden vervangen door o.a. File, Ongeval, etc. Zie <a href =\"https://docs.datex2.eu/\">DATEX II</a> voor meer info."@nl;
  rdfs:comment "Een verzameling van verkeersomstandigheden die een bepaalde situatie in het verkeer verklaren zoals file, ongeval, etc."@nl;
  shacl:closed false;
  shacl:targetClass <http://datex2.eu/vocab/3/Situation#Situation> .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#VerzamelingShape> a shacl:NodeShape;
  rdfs:label "Verzameling"@nl;
  rdfs:comment "Een verzameling van resources."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "heeft lid"@nl;
    rdfs:comment "Domeinobject zoals een Verkeersobject, Verkeerssituatie, etc. dat deel uitmaakt van de collectie."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Verzameling.HeeftLid>;
    shacl:class <http://www.w3.org/ns/sosa/FeatureOfInterest>;
    shacl:description "Domeinobject zoals een Verkeersobject, Verkeerssituatie, etc. dat deel uitmaakt van de collectie."@nl;
    shacl:name "heeft lid"@nl;
    shacl:path dc:hasPart
  ];
  shacl:targetClass dcmitype:Collection .

<https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#ZaakShape> a shacl:NodeShape;
  rdfs:label "Zaak"@nl;
  rdfs:comment "Een zaak is het geheel aan werk gedaan om tot een bestuurlijke of zakelijke beslissing te komen. Een zaak slaat doorgaans neer in een verzameling documenten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De naam van de zaak."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Zaak.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de zaak."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "openingsdatum"@nl;
    rdfs:comment "De openingsdatum van de zaak."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Zaak.Openingsdatum>;
    shacl:datatype xsd:date;
    shacl:description "De openingsdatum van de zaak."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "openingsdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#openingsdatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "sluitingsdatum"@nl;
    rdfs:comment "De sluitingsdatum van de zaak."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Zaak.Sluitingsdatum>;
    shacl:datatype xsd:date;
    shacl:description "De sluitingsdatum van de zaak."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "sluitingsdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#sluitingsdatum>
  ], [
    a shacl:PropertyShape;
    rdfs:label "procedure"@nl;
    rdfs:comment "De naam die verwijst naar de formele definitie van een verzameling stappen die in de juiste volgorde leiden tot de afronding van de zaak."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Zaak.Procedure>;
    shacl:datatype rdf:langString;
    shacl:description "De naam die verwijst naar de formele definitie van een verzameling stappen die in de juiste volgorde leiden tot de afronding van de zaak."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "procedure"@nl;
    shacl:path <https://dbpedia.org/ontology/procedure>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Een identificator voor de zaak."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Zaak.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een identificator voor de zaak."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "behandelt"@nl;
    rdfs:comment "Een zaak behandelt een resource."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Zaak.Behandelt>;
    shacl:class rdfs:Resource;
    shacl:description "Een zaak behandelt een resource."@nl;
    shacl:name "behandelt"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#behandelt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "agent"@nl;
    rdfs:comment "De Agent die de Zaak behandelt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Zaak.Agent>;
    shacl:class dc:Agent;
    shacl:description "De Agent die de Zaak behandelt."@nl;
    shacl:name "agent"@nl;
    shacl:path dc:agent
  ];
  shacl:targetClass dbo:Case .
