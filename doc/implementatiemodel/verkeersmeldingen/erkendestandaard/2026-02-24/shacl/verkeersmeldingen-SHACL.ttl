    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Een identificator voor de resource."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/erkendestandaard/2026-02-24#Resource.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een identificator voor de resource."@nl;
    shacl:minCount "1";
    shacl:name "identificator"@nl;
