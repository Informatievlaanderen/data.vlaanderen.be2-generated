{
  "title": "Object",
  "type": "object",
  "description": "Klasse die instanties van om het even welk type vertegenwoordigt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Object)",
      "pattern": "^Object$"
    },
    "type": {
      "$ref": "#/components/schemas/Domeinobjecttype"
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Observatie"
          },
          {
            "$ref": "#/components/schemas/Verkeersmeting"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Observatie": "#/components/schemas/Observatie",
            "Verkeersmeting": "#/components/schemas/Verkeersmeting"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}