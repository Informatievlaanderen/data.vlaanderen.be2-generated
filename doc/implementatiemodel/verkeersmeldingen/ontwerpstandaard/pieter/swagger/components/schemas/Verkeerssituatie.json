{
  "title": "Verkeerssituatie",
  "type": "object",
  "description": "Een verzameling van verkeersomstandigheden die een bepaalde situatie in het verkeer verklaren zoals file, ongeval, etc.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Verkeerssituatie)",
      "pattern": "^Verkeerssituatie$"
    },
    "type": {
      "$ref": "#/components/schemas/Domeinobjecttype"
    },
    "waardeverschaffer": {
      "type": "array",
      "description": "Lijst van Observatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Observatie"
          },
          {
            "$ref": "#/components/schemas/Verkeersmeting"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Observatie": "#/components/schemas/Observatie",
            "Verkeersmeting": "#/components/schemas/Verkeersmeting"
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}