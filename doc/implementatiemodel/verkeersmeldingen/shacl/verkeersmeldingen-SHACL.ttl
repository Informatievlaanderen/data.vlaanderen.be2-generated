<https://data.test-vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/ontwerpstandaard/2025-06-04#ActiviteitShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/ontwerpstandaard/2025-06-04#Activiteit.Naam>;
    shacl:datatype xsd:string;
    shacl:description "De naam van de activiteit."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/ontwerpstandaard/2025-06-04#Activiteit.Startdatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De startdatum van de activiteit."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "startdatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#Activiteit.startdatum>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/ontwerpstandaard/2025-06-04#Activiteit.Einddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De einddatum van de activiteit."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "einddatum"@nl;
    shacl:path <https://data.vlaanderen.be/ns/dossier#Activiteit.einddatum>
  ], [
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/implementatiemodel/verkeersmeldingen/ontwerpstandaard/2025-06-04#Activiteit.VindtPlaatsTijdens>;
