    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Het gaat hier om gegevens die eigen zijn aan de Observatie en complementair aan de beschrijving van de procedure die bij de Observatie is gevolgd (analysemethode edm, zie klasse Proces) wat op zich ook al iets zegt over de kwaliteit van het resultaat."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Mate waarin het resultaat van de Observatie voldoet aan de vereisten of verwachtingen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
