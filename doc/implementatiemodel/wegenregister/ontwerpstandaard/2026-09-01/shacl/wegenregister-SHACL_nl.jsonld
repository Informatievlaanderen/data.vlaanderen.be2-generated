        "@language": "nl",
        "@value": "Een classificatie gebaseerd op het belang van de\nrol die de weg vervult in het wegennetwerk."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Wegcategorie"
      }
    ],
