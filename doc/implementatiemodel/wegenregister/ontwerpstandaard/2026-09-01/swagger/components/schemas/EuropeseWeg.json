{
  "title": "EuropeseWeg",
  "type": "object",
  "description": "Een verzameling Wegsegmenten of  Weglinksequenties die een route vertegenwoordigt die deel uitmaakt van het internationale E-wegennetwerk, gekenmerkt door het Europese wegummer.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse EuropeseWeg)",
      "pattern": "^EuropeseWeg$"
    },
    "europeesWegnummer": {
      "type": "object",
      "description": "Code die de route in het internationale E-wegennetwerk identificeert. De code begint altijd met een\nletter 'E', gevolgd door een één-, twee- of driecijferig\nnummer.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "geografischeNaam": {
      "type": "object",
      "description": "Naam van het Transportobject.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    },
    "referentie": {
      "type": "array",
      "description": "Lijst van Netwerkreferentie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Netwerkreferentie"
          },
          {
            "$ref": "#/components/schemas/Linkreferentie"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Netwerkreferentie": "#/components/schemas/Netwerkreferentie",
            "Linkreferentie": "#/components/schemas/Linkreferentie"
          }
        }
      },
      "minItems": 1
    },
    "inNetwerk": {
      "type": "array",
      "description": "Lijst van Transportnetwerk items.",
      "items": {
        "$ref": "#/components/schemas/Transportnetwerk"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "europeesWegnummer",
    "inNetwerk"
  ]
}