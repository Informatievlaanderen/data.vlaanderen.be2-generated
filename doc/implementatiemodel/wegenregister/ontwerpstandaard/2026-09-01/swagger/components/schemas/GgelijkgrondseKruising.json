{
  "title": "GgelijkgrondseKruising",
  "type": "object",
  "description": "Geeft de gelijkgrondse kruising van twee Wegsegmenten weer.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GgelijkgrondseKruising)",
      "pattern": "^GgelijkgrondseKruising$"
    },
    "inNetwerk": {
      "type": "array",
      "description": "Lijst van Transportnetwerk items.",
      "items": {
        "$ref": "#/components/schemas/Transportnetwerk"
      },
      "minItems": 1
    },
    "kruisingVan": {
      "type": "array",
      "description": "Lijst van Wegsegment items.",
      "items": {
        "$ref": "#/components/schemas/Wegsegment"
      },
      "minItems": 2
    }
  },
  "required": [
    "@type",
    "inNetwerk"
  ]
}