{
  "title": "Morfologie",
  "type": "object",
  "description": "Een classificatie gebaseerd op de fysieke eigenschappen van de weg.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Morfologie)",
      "pattern": "^Morfologie$"
    },
    "morfologie": {
      "$ref": "#/components/schemas/Morfologietype"
    },
    "voertuigtype": {
      "type": "array",
      "description": "Type voertuig waarvoor de transporteigenschap geldt. Lijst van Voertuigtype items.",
      "items": {
        "$ref": "#/components/schemas/Voertuigtype"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "morfologie"
  ]
}