{
  "title": "Transportnetwerk",
  "type": "object",
  "description": "Verzameling van Netwerkelementen die eenzelfde vervoerswijze vertegenwoordigen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Transportnetwerk)",
      "pattern": "^Transportnetwerk$"
    },
    "geografischeNaam": {
      "type": "object",
      "description": "Naam van het Transportobject.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "type": {
      "$ref": "#/components/schemas/TransportType"
    }
  },
  "required": [
    "@type",
    "type"
  ]
}