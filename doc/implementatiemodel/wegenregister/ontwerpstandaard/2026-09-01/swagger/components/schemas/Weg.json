{
  "title": "Weg",
  "type": "object",
  "description": "Een verzameling Wegsegmenten of  Weglinksequenties die passen binnen hetzelfde thema e/of dezelfde eigenschappen hebben.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Weg)",
      "pattern": "^Weg$"
    },
    "creatiedatum": {
      "$ref": "#/components/schemas/Weg.creatiedatum"
    },
    "modificatiedatum": {
      "$ref": "#/components/schemas/Weg.modificatiedatum"
    },
    "lokaleCode": {
      "$ref": "#/components/schemas/Weg.lokaleCode"
    },
    "nationaleCode": {
      "$ref": "#/components/schemas/Weg.nationaleCode"
    },
    "geografischeNaam": {
      "$ref": "#/components/schemas/Weg.geografischeNaam"
    },
    "bron": {
      "$ref": "#/components/schemas/Organisatie"
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    },
    "link": {
      "type": "array",
      "description": "Link die deel uitmaakt van de Linkset. Lijst van GeneriekeLink items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/GeneriekeLink"
          },
          {
            "$ref": "#/components/schemas/Wegsegment"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "GeneriekeLink": "#/components/schemas/GeneriekeLink",
            "Wegsegment": "#/components/schemas/Wegsegment"
          }
        }
      },
      "minItems": 1
    },
    "referentie": {
      "type": "array",
      "description": "Netwerkreferentie waarnaar het Netwerkelement verwijst. Lijst van Netwerkreferentie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Netwerkreferentie"
          },
          {
            "$ref": "#/components/schemas/Linkreferentie"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Netwerkreferentie": "#/components/schemas/Netwerkreferentie",
            "Linkreferentie": "#/components/schemas/Linkreferentie"
          }
        }
      },
      "minItems": 1
    },
    "inNetwerk": {
      "type": "array",
      "description": "Netwerk waartoe het Netwerkelement behoort. Lijst van Transportnetwerk items.",
      "items": {
        "$ref": "#/components/schemas/Transportnetwerk"
      },
      "minItems": 1
    },
    "@context": {
      "type": "string",
      "description": "URI of the JSON-LD versioned context file for this response.",
      "pattern": "^https:\\/\\/data.test-vlaanderen.be\\/doc\\/implementatiemodel\\/wegenregister\\/ontwerpstandaard\\/2026-09-01\\/context\\/wegenregister.jsonld$"
    }
  },
  "required": [
    "@type",
    "creatiedatum",
    "lokaleCode",
    "nationaleCode",
    "bron",
    "link",
    "inNetwerk"
  ]
}