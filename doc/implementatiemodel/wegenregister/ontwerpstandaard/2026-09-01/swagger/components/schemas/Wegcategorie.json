{
  "title": "Wegcategorie",
  "type": "object",
  "description": "Een classificatie gebaseerd op het belang van de\nrol die de weg vervult in het wegennetwerk.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Wegcategorie)",
      "pattern": "^Wegcategorie$"
    },
    "categorie": {
      "$ref": "#/components/schemas/Wegcategorietype"
    },
    "voertuigtype": {
      "type": "array",
      "description": "Lijst van Voertuigtype items.",
      "items": {
        "$ref": "#/components/schemas/Voertuigtype"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "categorie"
  ]
}