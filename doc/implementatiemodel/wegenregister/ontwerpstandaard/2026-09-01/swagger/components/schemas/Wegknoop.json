{
  "title": "Wegknoop",
  "type": "object",
  "description": "Significante positie in het wegennet die het begin of einde van een Wegsegment markeert.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Wegknoop)",
      "pattern": "^Wegknoop$"
    },
    "creatiedatum": {
      "$ref": "#/components/schemas/Wegknoop.creatiedatum"
    },
    "modificatiedatum": {
      "$ref": "#/components/schemas/Wegknoop.modificatiedatum"
    },
    "geografischeNaam": {
      "$ref": "#/components/schemas/Wegknoop.geografischeNaam"
    },
    "bron": {
      "$ref": "#/components/schemas/Organisatie"
    },
    "type": {
      "$ref": "#/components/schemas/Wegknooptype"
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    },
    "referentie": {
      "type": "array",
      "description": "Netwerkreferentie waarnaar het Netwerkelement verwijst. Lijst van Netwerkreferentie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Netwerkreferentie"
          },
          {
            "$ref": "#/components/schemas/Linkreferentie"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Netwerkreferentie": "#/components/schemas/Netwerkreferentie",
            "Linkreferentie": "#/components/schemas/Linkreferentie"
          }
        }
      },
      "minItems": 1
    },
    "inNetwerk": {
      "type": "array",
      "description": "Netwerk waartoe het Netwerkelement behoort. Lijst van Transportnetwerk items.",
      "items": {
        "$ref": "#/components/schemas/Transportnetwerk"
      },
      "minItems": 1
    },
    "geometrie": {
      "$ref": "#/components/schemas/Punt"
    },
    "@context": {
      "type": "string",
      "description": "URI of the JSON-LD versioned context file for this response.",
      "pattern": "^https:\\/\\/data.test-vlaanderen.be\\/doc\\/implementatiemodel\\/wegenregister\\/ontwerpstandaard\\/2026-09-01\\/context\\/wegenregister.jsonld$"
    }
  },
  "required": [
    "@type",
    "creatiedatum",
    "bron",
    "type",
    "inNetwerk",
    "geometrie"
  ]
}