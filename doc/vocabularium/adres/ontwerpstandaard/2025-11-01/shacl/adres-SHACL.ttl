    shacl:maxCount "1";
    shacl:name "specificatie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#specificatie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek#GeografischePositie> .

