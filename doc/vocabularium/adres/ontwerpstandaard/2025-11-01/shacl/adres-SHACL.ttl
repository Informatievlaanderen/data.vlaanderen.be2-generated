<https://data.test-vlaanderen.be/doc/vocabularium/adres/ontwerpstandaard/2025-11-01#GebouwShape> a shacl:NodeShape;
  rdfs:label "Gebouw"@nl;
  rdfs:comment "Een gesloten en/of overdekt, bovengronds of ondergronds bouwwerk, dat dient of bestemd is, ofwel om mensen, dieren en voorwerpen onder te brengen, ofwel om economische goederen te vervaardigen of diensten te verstrekken. Een gebouw verwijst naar gelijk welke structuur die op blijvende wijze op een terrein opgetrokken of gebouwd wordt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "bestaat uit"@nl;
    rdfs:comment "Gebouweenheid die deel uitmaakt van het gebouw."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/vocabularium/adres/ontwerpstandaard/2025-11-01#Gebouw.BestaatUit>;
    shacl:class <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid>;
    shacl:description "Gebouweenheid die deel uitmaakt van het gebouw."@nl;
    shacl:name "bestaat uit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#bestaatUit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "ligt op"@nl;
    rdfs:comment "Perceel waarop het gebouw gelegen is."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/vocabularium/adres/ontwerpstandaard/2025-11-01#Gebouw.LigtOp>;
    shacl:class <https://data.vlaanderen.be/ns/perceel#Perceel>;
    shacl:description "Perceel waarop het gebouw gelegen is."@nl;
    shacl:name "ligt op"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gebouw#ligtOp>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/gebouw#Gebouw> .

<https://data.test-vlaanderen.be/doc/vocabularium/adres/ontwerpstandaard/2025-11-01#GebouweenheidShape> a shacl:NodeShape;
  rdfs:label "Gebouweenheid"@nl;
  rdfs:comment "De kleinste eenheid binnen een gebouw die geschikt is voor woon-, bedrijfsmatige, of recreatieve doeleinden en die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde circulatieruimte. Een gebouweenheid is in functioneel opzicht zelfstandig. Daarnaast kan een gebouweenheid ook een gemeenschappelijk deel zijn."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/gebouw#Gebouweenheid> .

<https://data.test-vlaanderen.be/doc/vocabularium/adres/ontwerpstandaard/2025-11-01#GemeenteShape> a shacl:NodeShape;
  rdfs:label "Gemeente"@nl;
  rdfs:comment "Officiële administratieve zone van het Belgisch grondgebied. De gemeente is het kleinste administratieve deel van het Belgisch grondgebied waarvan de grenzen enkel door de wetgever kunnen worden gewijzigd."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek#Gemeente> .

<https://data.test-vlaanderen.be/doc/vocabularium/adres/ontwerpstandaard/2025-11-01#GemeentenaamShape> a shacl:NodeShape;
  rdfs:label "Gemeentenaam"@nl;
  rdfs:comment "Adrescomponent die verwijst naar de naam ve gemeente, ttz het kleinste administratieve deel van het Belgisch grondgebied waarvan de grenzen enkel door de wetgever kunnen worden gewijzigd."@nl;
  shacl:closed false;
