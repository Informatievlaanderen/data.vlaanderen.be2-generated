    rdfs:comment "De manier waarop het punt werd bepaald."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/vocabularium/adres/ontwerpstandaard/2025-11-01#GeografischePositie.Methode>;
    shacl:class skos:Concept;
    shacl:description "De manier waarop het punt werd bepaald."@nl;
    shacl:maxCount "1";
    shacl:name "methode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/generiek#methode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "specificatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb perceel, gebouw..."@nl;
    rdfs:comment "Het type object op basis waarvan het punt werd bepaald."@nl;
