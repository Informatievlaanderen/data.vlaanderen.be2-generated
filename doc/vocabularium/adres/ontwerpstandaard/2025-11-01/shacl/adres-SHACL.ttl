    rdfs:comment "Naam vd gemeente."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/vocabularium/adres/ontwerpstandaard/2025-11-01#Gemeentenaam.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam vd gemeente."@nl;
