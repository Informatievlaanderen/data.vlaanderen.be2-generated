    <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#string>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Link naar het arrest van de schorsing"@nl;
    <http://www.w3.org/ns/adms#status> <https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard>.
<https://data.vlaanderen.be/ns/bedrijventerrein#geschorst> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
    <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://data.vlaanderen.be/ns/bedrijventerrein>;
    <http://www.w3.org/2000/01/rdf-schema#domain> <https://data.vlaanderen.be/ns/bedrijventerrein#SchorsingInfo>;
    <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#boolean>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Geeft aan of het plan al dan niet geschorst is."@nl;
    <http://www.w3.org/ns/adms#status> <https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard>.
<https://data.vlaanderen.be/ns/bedrijventerrein#schorsingOpmerking> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
    <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://data.vlaanderen.be/ns/bedrijventerrein>;
