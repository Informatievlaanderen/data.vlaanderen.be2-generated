<https://data.test-vlaanderen.be/doc/vocabularium/klantvolgsysteem1/ontwerpstandaard/2025-10-30#PubliekedienstverleningShape> a shacl:NodeShape;
  rdfs:label "PubliekeDienstverlening"@nl;
  <http://purl.org/vocab/vann/usageNote> "De dienstverlening vormt een aanbod (dat dus niet noodzakelijk wordt gebruikt). Ze houdt niet noodzakelijk het opnemen van een recht in,de dienstverlening kan de gebruiker ook toelaten een verplichting te vervullen."@nl;
  rdfs:comment "Een publieke dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De naam van de Publieke Dienstverlening."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/vocabularium/klantvolgsysteem1/ontwerpstandaard/2025-10-30#Publiekedienstverlening.Naam>;
    shacl:datatype rdf:langString;
    shacl:description "De naam van de Publieke Dienstverlening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftVerantwoordelijke"@nl;
    rdfs:comment "De Publieke Organisatie die verantwoordelijk is voor de Publieke Dienstverlening."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/vocabularium/klantvolgsysteem1/ontwerpstandaard/2025-10-30#Publiekedienstverlening.Heeftverantwoordelijke>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "De Publieke Organisatie die verantwoordelijk is voor de Publieke Dienstverlening."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "heeftVerantwoordelijke"@nl;
    shacl:path <http://data.europa.eu/m8g/hasCompetentAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "finaliteit"@nl;
    rdfs:comment "Wettelijk kader waarvoor de informatie wordt bevraagd."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/vocabularium/klantvolgsysteem1/ontwerpstandaard/2025-10-30#Publiekedienstverlening.Finaliteit>;
    shacl:class <https://data.vlaanderen.be/ns/klantvolgsysteem/FinaliteitType>;
    shacl:description "Wettelijk kader waarvoor de informatie wordt bevraagd."@nl;
    shacl:maxCount "1";
    shacl:name "finaliteit"@nl;
    shacl:path <https://data.vlaanderen.be/ns/klantvolgsysteem/finaliteit>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: Orientatie, Begeleiding, etc."@nl;
    rdfs:comment "Het soort Publieke Dienstverlening."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/vocabularium/klantvolgsysteem1/ontwerpstandaard/2025-10-30#Publiekedienstverlening.Type>;
    shacl:class <https://data.vlaanderen.be/ns/klantvolgsysteem/PubliekeDienstverleningtype>;
    shacl:description "Het soort Publieke Dienstverlening."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "gebruikt"@nl;
    rdfs:comment "Referenties naar alle Inputs die de Publieke Dienstverlening gebruikt om een of meerdere Outputs te produceren."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/vocabularium/klantvolgsysteem1/ontwerpstandaard/2025-10-30#Publiekedienstverlening.Gebruikt>;
    shacl:class <https://data.vlaanderen.be/ns/klantvolgsysteem/Werkzoekendeprofiel>;
    shacl:description "Referenties naar alle Inputs die de Publieke Dienstverlening gebruikt om een of meerdere Outputs te produceren."@nl;
    shacl:name "gebruikt"@nl;
    shacl:path <http://purl.org/vocab/cpsv#hasInput>
  ], [
    a shacl:PropertyShape;
    rdfs:label "produceert"@nl;
    rdfs:comment "De referenties naar alle resources die de Publieke Dienstverlening produceert."@nl;
    rdfs:seeAlso <https://data.test-vlaanderen.be/doc/vocabularium/klantvolgsysteem1/ontwerpstandaard/2025-10-30#Publiekedienstverlening.Produceert>;
