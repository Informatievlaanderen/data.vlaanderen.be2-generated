    <http://www.w3.org/2000/01/rdf-schema#domain> <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon>;
    <http://www.w3.org/2000/01/rdf-schema#range> <https://test.data.vlaanderen.be/ns/magda/persoon#AdministratiefBeheerder>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Verwijzing naar de Adminstratiefbeheerder van het dossier van de persoon."@nl;
    <http://www.w3.org/ns/adms#status> <https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard>.
<https://test.data.vlaanderen.be/ns/magda/persoon#heeftToekomstigBeheerder> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
    <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://test.data.vlaanderen.be/ns/magda/persoon>;
    <http://www.w3.org/2000/01/rdf-schema#domain> <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon>;
    <http://www.w3.org/2000/01/rdf-schema#range> <https://test.data.vlaanderen.be/ns/magda/persoon#AdministratiefBeheerder>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Verwijzing naar de toekomstig Adminstratiefbeheerder van het dossier van de persoon."@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit is tijdelijk het geval bij verhuizing van een persoon."@nl;
