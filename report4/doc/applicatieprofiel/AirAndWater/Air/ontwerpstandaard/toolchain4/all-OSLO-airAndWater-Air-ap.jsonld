      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Datatype can be a URI or a TypedString. In the first case, reference is made to units of measure published on the web, preferable those from qudt, eg http://qudt.org/vocab/unit/M for meter. In the case of a TypedString, preference is given to UCUM codes, eg \"km/h\"^^http://w3id.org/lindt/custom_datatypes#ucumunit."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Datatype can be a URI or a TypedString. In the first case, reference is made to units of measure published on the web, preferable those from qudt, eg http://qudt.org/vocab/unit/M for meter. In the case of a TypedString, preference is given to UCUM codes, eg \"km/h\"^^http://w3id.org/lindt/custom_datatypes#ucumunit."
        }
      ],
