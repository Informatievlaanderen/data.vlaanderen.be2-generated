          "@value": "Observation intended to estimate the overall quality of the Air, expressed as a single number."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Basically the aggregation of the results of a predetermined set of AirPollutantObservations over an averaging period and of substances that are considered critical for AirQuality. The result is a single number that acts as an indicator for AirQuality."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Basically the aggregation of the results of a predetermined set of AirPollutantObservations over an averaging period and of substances that are considered critical for AirQuality. The result is a single number that acts as an indicator for AirQuality."
        }
