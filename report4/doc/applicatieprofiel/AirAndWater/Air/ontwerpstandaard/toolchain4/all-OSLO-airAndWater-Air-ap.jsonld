      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Basically a Classification of the result of an AirQualityIndexObservation according to certain threshold values. For example if the index exceeds a certain value, the AirQuality could be labeled as \"unhealthy\"."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
