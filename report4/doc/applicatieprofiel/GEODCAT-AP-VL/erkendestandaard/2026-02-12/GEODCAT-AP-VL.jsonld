          "oslo:key": {
            "@language": "nl",
            "@value": "class-usage-scope"
          },
          "oslo:value": {
            "@language": "nl",
            "@value": "main"
          }
        },
        {
          "@type": "oslo:extension",
          "oslo:key": {
            "@language": "nl",
            "@value": "property-usage-scope"
          },
          "oslo:value": {
            "@language": "nl",
            "@value": "mandatory"
          }
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
