      "apLabel": [
        {
          "@language": "nl",
          "@value": "geografische dekking"
        },
        {
          "@language": "en",
          "@value": "geographical coverage"
        }
      ],
      "diagramLabel": [
        {
          "@value": "geografischedekking"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "A geographic region that is covered by the Dataset Series."
        },
        {
          "@language": "nl",
          "@value": "Het geografische gebied waarover de Dataset Serie informatie heeft."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Wanneer geografische dekking een dimensie is in de Dataset Serie moet de geografische dekking van elke dataset in de collectie deel uitmaken van de geografisch dekking. Er wordt een waarde met een open einde aanbevolen, b.v. EU of een alomvattende bouding box dat de verwachte waarden bevat."
        },
        {
          "@language": "en",
          "@value": "When spatial coverage is a dimension in the Dataset Serie then the spatial coverage of each dataset in the collection should be part of the spatial coverage. In that case, an open ended value is recommended, e.g. EU or a broad bounding box covering the expected values."
        }
      ],
