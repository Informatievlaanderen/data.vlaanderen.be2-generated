    },
    {
      "@id": "urn:oslo-toolchain:54a7ddd4c3c7dc2547739b83ee70c9fe4699114dccb3b72cef0ce248a6403891",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/dcat#DatasetSeries",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Dataset Series"
        },
        {
          "@language": "nl",
          "@value": "Dataset Serie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DatasetSerie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A collection of datasets that are published separately,but share some characteristics that group them."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een verzameling die onafhankelijk gepubliceerde datasets groepeert rond gedeelde eigenschappen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "It is recommended to avoid Dataset Series without a dataset in the collection. Therefore at least one Dataset should refer to a Dataset Series using the property in series (dcat:inSeries)."
        },
        {
          "@language": "nl",
          "@value": "In DCAT-AP VL 3.0 worden Dataset Serie opgevat in hun zuivere betekenis: een verzameling van datasets die dezelfde specificaties delen, waarbij de enige variërende eigenschap typisch ruimte of tijd/versie is. Dit sluit nauw aan bij ISO 19115-1 en INSPIRE, waar een datasetserie wordt gedefinieerd als een collectie datasets met een gemeenschappelijke productspecificatie. Deze zuivere vorm wordt in DCAT-AP VL 3.0 volledig ondersteund. \r\n<br/>\r\nDaarnaast bestaan in de praktijk verschillende tussenvormen - zoals verzamelingen van datasets over eenzelfde thema, verzamelingen van datasets, series en services, of collecties gebaseerd op bron- of eigenschapsgelijkheid. Deze structuren hebben een grotere “vrijheidsgraad” (variatie in versie, gebied, specificaties, brontypes of eigenschappen) en voldoen daardoor niet aan de formele definitie van Dataset Serie. Deze tussenvormen worden daarom niet als Dataset Serie ondersteund, maar wel vindbaar gemaakt via passende DCAT-structuren (bv. thema-gebaseerde groepering of catalogusstructuren). \r\n<br/>\r\nVoor complexe of expliciet gestructureerde groeperingen is de correcte representatie een (sub)catalogus, waarbij de verbindende eigenschap expliciet door de catalogus zelf wordt bepaald. Subcatalogi worden wél ondersteund in DCAT-AP VL 3.0."
        }
      ],
      "extensions": [
        {
          "@type": "oslo:extension",
          "oslo:key": {
            "@language": "nl",
            "@value": "GEODCATAP"
          },
          "oslo:value": {
            "@language": "nl",
            "@value": "https://semiceu.github.io/GeoDCAT-AP/drafts/3.1.0/#DatasetSeries"
          }
        },
        {
          "@type": "oslo:extension",
          "oslo:key": {
            "@language": "nl",
            "@value": "reuse"
          },
          "oslo:value": {
            "@language": "nl",
            "@value": "profile"
          }
        },
        {
