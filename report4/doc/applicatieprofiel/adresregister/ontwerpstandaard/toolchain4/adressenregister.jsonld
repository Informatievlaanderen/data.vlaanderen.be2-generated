    {
      "@id": "urn:oslo-toolchain:05863a370358bb9e6533ce51b537a4bb0c7888e00219c4269bb25ad6895902bd",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/adres#Postinfo",
      "vocLabel": [
