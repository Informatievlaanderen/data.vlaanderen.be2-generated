    },
    {
      "@id": "urn:oslo-toolchain:af6802abe8e82759b8b16013614b7fc1177261025d37a003e67e893bc5add4c1",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
