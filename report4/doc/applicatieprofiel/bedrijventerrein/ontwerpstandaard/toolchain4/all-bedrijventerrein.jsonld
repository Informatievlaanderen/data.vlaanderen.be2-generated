  "classes": [
    {
      "@id": "urn:oslo-toolchain:736fa099d69094c8fc34d8f94af2b36b114aa77f6e448eba1266855ffc51f100",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bedrijventerrein#Planningszone",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Planningszone"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Planningszone"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een gebied dat gelegen is binnen een bepaalde vastgelegde ruimtelijke bestemming en dat zich in een ruimtelijke bestemmingsprocedure bevindt. De oorspronkelijke vastgelegde bestemming kan door de bestemmingsprocedure gewijzigd of hernomen worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6059c482b504166bd63bdc17b88684afc046c6f5431f0d91d827540c184d1654"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:6059c482b504166bd63bdc17b88684afc046c6f5431f0d91d827540c184d1654",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/perceel#RuimtelijkeEenheid",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Ruimtelijke Eenheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "RuimtelijkeEenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Eén gebied (of meerdere gebieden) van land en/of water, of één enkel volume (of meerdere volumes) ruimte, afgebakend voor een bepaald doel."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Definitie conform ISO 19152 - Land Administration Domain Model."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:ea7be638a884463e398ba7a90bdb7ed9198562133785ae9194327803b86ad347",
