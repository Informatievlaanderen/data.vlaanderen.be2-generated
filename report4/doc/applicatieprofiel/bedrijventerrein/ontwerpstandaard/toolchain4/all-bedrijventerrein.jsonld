    },
    {
      "@id": "urn:oslo-toolchain:fce3c00e79896ae0c69cd5dae77669afa484c96e69e74a5b262116c25df1243e",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bedrijventerrein#EconomischGebied",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Economisch Gebied"
        }
      ],
      "diagramLabel": [
        {
          "@value": "EconomischGebied"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een economisch gebied is een gebied dat afgebakend wordt op basis van dichtheid van hoofdzakelijk bebouwde percelen met economische activiteiten, waarbij de dichtheid wordt uitgedrukt in nabijheid of de afstand tussen deze percelen. De afstand tussen deze percelen, de mix van economische activiteiten en het voorkomen van een gedeelde infrastructuur zijn bepalend voor de differentiatie tussen de types economische gebieden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6059c482b504166bd63bdc17b88684afc046c6f5431f0d91d827540c184d1654"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:988b666487d67294a8001fda8e21e32fde5a86144840024ee8d012e8d7bd1133",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bedrijventerrein#Bedrijventerreinperceel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bedrijventerreinperceel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bedrijventerreinperceel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een ruimtelijke eenheid binnen een Bedrijventerrein met eenzelfde gebruik, functie of eigenaar."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit kunnen business centra, KMO units, aaneengesloten bebouwing, meerdere kadastrale of aktepercelen, ... omvatten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6059c482b504166bd63bdc17b88684afc046c6f5431f0d91d827540c184d1654"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:2e934d0246fd8ed982455b95b877641a0d8e6c1798462d087b41370d1870dab6",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bedrijventerrein#Bedrijventerrein",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bedrijventerrein"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bedrijventerrein"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Som van alle ruimtelijke eenheden uit de ruimtelijke planningsprocedure en met een economische bestemming vanaf de dossierfase Publicatie in Belgisch Staatsblad. Een bedrijventerrein is altijd de unie van de percelen die ertoe behoren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6059c482b504166bd63bdc17b88684afc046c6f5431f0d91d827540c184d1654"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:bd52771bd3882ea5bd7c6f34a365666e8b2a406d9237342728d4b1b459c23940",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bedrijventerrein#OntwikkelbareBedrijvenzone",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Ontwikkelbare Bedrijvenzone"
        }
      ],
      "diagramLabel": [
        {
          "@value": "OntwikkelbareBedrijvenzone"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een (deel van) een Bedrijventerrein vanaf de mijlpaal publicatie in het Belgisch Staatsblad tot aan de oplevering van de nutsvoorzieningen en infrastructuur. Deze zones kunnen nieuwe terreinen zijn of herontwikkelingstrajecten. Wanneer een (her)ontwikkeling in meerdere fasen gebeurt, dan wordt de ontwikkelbare zone opgesplitst volgens deze fasen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6059c482b504166bd63bdc17b88684afc046c6f5431f0d91d827540c184d1654"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
