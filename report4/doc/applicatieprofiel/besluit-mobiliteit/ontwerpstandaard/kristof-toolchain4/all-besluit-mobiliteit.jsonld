    {
      "@id": "urn:oslo-toolchain:64fa7fc3ebc521e608202fd9db2a8a58edec393ad975236451c38c5160cace0b",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verkeersteken"
        },
        {
          "@language": "en",
          "@value": "Traffic sign"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Verkeersteken"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De voorstelling van een aanwijzing ten behoeve van de weggebruikers die verbonden wordt aan het aankondigen of opleggen van een bepaalde verkeersmaatregel zoals bepaald in de wegcode."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit kan een verkeersbord,verkeerslicht of wegmarkering zijn. Merk op: het gaat hier om de conceptuele weergave en niet om de fysieke wegsignalisatie op het openbaar domein."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
