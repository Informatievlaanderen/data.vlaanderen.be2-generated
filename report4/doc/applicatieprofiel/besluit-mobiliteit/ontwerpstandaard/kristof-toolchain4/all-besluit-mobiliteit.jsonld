    },
    {
      "@id": "urn:oslo-toolchain:4547bd201b552b5dbae26d7b26a30af8996ba52b3c87c14ea975a56b982148cd",
      "@type": "Class",
      "assignedURI": "http://data.vlaanderen.be/ns/besluit#AanvullendReglement",
