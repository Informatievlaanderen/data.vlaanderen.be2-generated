        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een aanvullend reglement op de politie van het wegverkeer met een tijdelijke geldigheid."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de praktijk wordt Besluit getypeerd met https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9 ."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
