    {
      "@id": "urn:oslo-toolchain:cccc4d1701a888ea45c0de18092a670f229212c2aba42b09932e5e535e1af5ae",
      "@type": "Class",
      "assignedURI": "http://inspire.ec.europa.eu/ont/ad#PostalDescriptor",
      "vocLabel": [
        {
          "@language": "fr",
          "@value": "Infos de la poste"
        },
        {
          "@language": "nl",
          "@value": "Post informatie"
        },
        {
          "@language": "de",
          "@value": "Informationen zur Post"
        },
        {
          "@language": "en",
          "@value": "Post office information"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PostalInfo"
        }
      ],
      "vocDefinition": [
        {
          "@language": "fr",
          "@value": "Identification d’un groupe d’adresses définies pour la distribution du courrier postal. Dans la plupart des cas, ce groupe correspond à une commune ou à une ville, mais ce n’est pas toujours le cas."
        },
        {
          "@language": "nl",
          "@value": "Identificatie van een subset van adressen gecreëerd voor postbedeling. \nIn de meeste gevallen valt de postal code samen met de gemeente of stad, maar dit is niet altijd het geval."
        },
        {
          "@language": "en",
          "@value": "Identification of a subset of addresses  created for postal purposes. \nIn most cases, the postal code coincides with the municipality, but this is not always the case."
        },
        {
          "@language": "de",
          "@value": "Identifizierung einer Gruppe von Adressen, die für Zwecke der Postverteilung definiert ist. In den meisten Fällen entspricht diese Gruppe einer Gemeinde oder Stadt, jedoch ist dies nicht immer der Fall."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "en",
          "@value": "Only Flanders provides postalInfo. The name is a concatenation of all names of (part of) municipalities valid for the same postcode and is present in at least 1 language, example:"
        },
        {
          "@language": "de",
          "@value": "Nur Flandern bietet Postleitzahlinformationen an. Der Name setzt sich aus der Verkettung aller Namen von  von (Teil-)Gemeinden zusammen, die für dieselbe Postleitzahl gelten, und ist in mindestens einer Sprache verfügbar, z. B."
        },
        {
          "@language": "fr",
          "@value": "Seulement la flandre fournit postalInfo.Le nom consiste en une concaténation des noms de toutes les (sous)communes valable pour le même code postal et est disponible dans au moins 1 langue:"
        },
        {
          "@language": "nl",
          "@value": "Enkel Vlaanderen stelt postalInfo ter beschikking: de naam bestaat uit een aaneenschakeling van alle namen van (deel)gemeentes geldig voor dezelfde postcode en is beschikbaar in tenminste 1 taal, bijv."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f7d379d32f7ad08af678f3cdd513b08c162ea3530641b0038a8c807aaa628672",
      "@type": "Class",
      "assignedURI": "http://todo.com/MunicipalityHistory",
      "diagramLabel": [
        {
          "@value": "MunicipalityHistory"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "This history table links two historically related entities. Each record contains: predecessor, successor and eventDate. (constructed by BOSA based on mutations processed on the BeSt Address database)"
        },
        {
          "@language": "de",
          "@value": "Diese Verlaufstabelle verknüpft zwei historisch zusammenhängende Entitäten.\nJede historische Entität hat dieselbe Struktur: Vorgänger, Nachfolger und Ereignisdatum (von BOSA anhand der Mutationen verarbeitet in der BeSt Address Datenbank)."
        },
        {
          "@language": "fr",
          "@value": "Cette table d'historique relie deux entités historiquement liées. Chaque donnée contient:  prédécesseur, successeur et date d'événement. (Construit par BOSA basé sur les mutations traitées dans la base de données BeSt Address)"
        },
        {
          "@language": "nl",
          "@value": "Deze historiek tabel koppelt twee historisch gerelateerde entiteiten.\nElke historische entiteit heeft dezelfde structuur: voorganger, opvolger en eventDate. (opgebouwd door BOSA op basis van mutaties verwerkt in de BeSt Address databank)"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:eda1e4c97d20845b459a2c2abeb200f3dfaef84736d5f6cf6ab2e06e7f4d16c2",
      "@type": "Class",
      "assignedURI": "http://todo.com/Pos",
      "diagramLabel": [
        {
          "@value": "pos"
        }
      ],
      "vocDefinition": [
        {
          "@language": "fr",
          "@value": "La position exprimée dans Lambert72 et la notation Lambert08\nLa notation Lambert est un point dont les propriétés X et Y sont doubles (réelles)."
        },
        {
          "@language": "en",
          "@value": "Position expressed in Lambert72 and the Lambert08 notation. \nIn Lambert notation, a location is defined with X and Y coordinates (doubles) that specify the distance from a chosen reference point"
        },
        {
          "@language": "nl",
          "@value": "De positie uitgedrukt in Lambert72 en de Lambert08-notatie.\nIn Lambert-notatie is een locatie gedefinieerd met een X- en Y-coördinaat (dubbels) die de afstand aangeven van een gekozen referentiepunt"
        },
        {
          "@language": "de",
          "@value": "Die Position, ausgedrückt in der Lambert72- und der Lambert08-Notation.\nDie Lambert-Notation beschreibt einen Punkt mit doppelten (reellen) X- und Y-Eigenschaften."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
