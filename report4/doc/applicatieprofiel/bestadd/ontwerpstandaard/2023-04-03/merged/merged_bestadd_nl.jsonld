      "vocDefinition": [
        {
          "@language": "de",
          "@value": "Transormation (mit fürhenden Nullen) des Haus und Briefkastennummers für Sortierungszwecke"
        },
        {
          "@language": "fr",
          "@value": "Transformation (avec zéros non significatifs) des numéros de maison et de boîte afin de pouvoir trier cette valeur"
        },
        {
          "@language": "en",
          "@value": "Transformation of the house number and the box number (eg. By adding leading 0’s) so this value can be sorted"
        },
        {
          "@language": "nl",
          "@value": "Transformatie van het huisnummer en busnummer (toevoeging van leading 0's) zodat deze waarde kan gesorteerd worden."
        }
      ],
      "domain": {
