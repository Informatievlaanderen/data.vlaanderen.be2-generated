  "datatypes": [
    {
      "@id": "urn:oslo-toolchain:32df5535ec28cf58bf23bd33730d83cd7b393d156db896f498922c22b08678d0",
      "@type": "Datatype",
      "assignedURI": "http://todo.com/GeographicalName",
      "diagramLabel": [
        {
          "@value": "GeographicalName"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Names like municipalities are multi-lingual in Belgium. A special class is used to express this multi-lingual situation. \nThe GeographicalName consists of the following subelements: spelling and languages."
        },
        {
          "@language": "de",
          "@value": "Namen wie Gemeinden sind in Belgien mehrsprachig. Um diese Mehrsprachigkeit auszudrücken, wird eine spezielle Klasse verwendet.\nDer GeographicalName besteht aus den folgenden Unterelementen: Schreibweise und Sprachen."
        },
        {
          "@language": "fr",
          "@value": "En Belgique, les noms de communes sont multilingues. Une classe spécifique est utilisée pour exprimer ce multilinguisme.\n\nLe nom géographique se compose des sous-éléments suivants : orthographe et langues."
        },
        {
          "@language": "nl",
          "@value": "Namen zoals gemeentenamen zijn meertalig in België. Er wordt een speciale klasse gebruikt om deze meertalige situatie uit te drukken.\nDe GeographicalName bestaat uit de volgende subelementen: spelling en talen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
