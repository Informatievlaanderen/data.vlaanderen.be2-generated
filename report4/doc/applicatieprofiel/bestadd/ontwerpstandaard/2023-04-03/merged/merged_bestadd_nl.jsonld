      "@id": "urn:oslo-toolchain:3b47ec4f2693e9c2fe74d2d9271274c7bb2d91c1d7ec80ef2ad648361cc41d1e",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
