      "vocDefinition": [
        {
          "@language": "de",
          "@value": "Alphanumerischer Code, der offiziell Gebäudeeinheiten (Hausnummern), Liegeplätzen, Stellplätzen oder Parzellen zugewiesen wird."
        },
        {
          "@language": "en",
          "@value": "Alphanumeric code officially assigned to building units (house number), mooring places, stands or parcels."
        },
        {
          "@language": "fr",
          "@value": "Code alphanumérique attribué officiellement à des unités de bâtiment, postes d’amarrage, emplacements ou parcelles."
        },
        {
          "@language": "nl",
          "@value": "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."
        }
      ],
