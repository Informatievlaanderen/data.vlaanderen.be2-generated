    {
      "@id": "urn:oslo-toolchain:9469603aa6327557dd5e268b176fa19c1a217d67a4c753722e05ffa2df5ac3df",
      "@type": "Class",
      "assignedURI": "http://vocab.belgif.be/ns/location#Municipality",
      "vocLabel": [
        {
          "@language": "de",
          "@value": "Gemeinde"
        },
        {
          "@language": "en",
          "@value": "Municipality"
        },
        {
          "@language": "fr",
          "@value": "Commune"
        },
        {
          "@language": "nl",
          "@value": "Gemeente"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Municipality"
        }
      ],
      "vocDefinition": [
        {
          "@language": "de",
          "@value": "Offizielle Verwaltungszone des belgischen Staatsgebiets. Die Gemeinde (Dorf oder Stadt) ist der kleinste Verwaltungsteil des belgischen Staatsgebiets, dessen Grenzen nur vom Gesetzgeber geändert werden können."
        },
        {
          "@language": "en",
          "@value": "Official administrative zone of the Belgian territory. The municipality (Village or town) is the smallest administrative unit of the Belgian territory whose boundaries can only be changed by the legislator."
        },
        {
          "@language": "fr",
          "@value": "Zone administrative officielle du territoire belge. La commune (ville ou commune) est la plus petite unité administrative du territoire belge dont les limites ne peuvent être modifiées que par le législateur."
        },
        {
          "@language": "nl",
          "@value": "Officiële administratieve zone van het Belgisch grondgebied. De gemeente is het kleinste administratieve deel van het Belgisch grondgebied waarvan de grenzen enkel door de wetgever kunnen worden gewijzigd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e0cc606a1ac6df6192b3ebabd36c8156f8df62c99585a6e2906ddf9d44f3323c",
      "@type": "Class",
      "assignedURI": "http://todo.com/LanguageCodeValue",
      "vocLabel": [
        {
          "@language": "de",
          "@value": "Sprachcodewert"
        },
        {
          "@language": "en",
          "@value": "Language code value"
        },
        {
          "@language": "fr",
          "@value": "Valeur du code langue"
        },
        {
          "@language": "nl",
          "@value": "Taalcodewaarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LanguageCodeValue"
        }
      ],
      "vocDefinition": [
        {
          "@language": "de",
          "@value": "Gibt an in welcher Sprache der Name der Gemeinde geschrieben ist"
        },
        {
          "@language": "en",
          "@value": "Specifies in what language the name of the municipality is written"
        },
        {
          "@language": "fr",
          "@value": "Indique dans quelle langue le nom de la commune a été écrite"
        },
        {
          "@language": "nl",
          "@value": "Geeft aan in welke taal de naam van de gemeente werd geschreven."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:0efbf094fb190e9c2ac5047ca38e5af7180b1ee8f9f9be29e8a2bffd6ea64667",
      "@type": "Class",
      "assignedURI": "http://inspire.ec.europa.eu/ont/ad#Address",
      "vocLabel": [
        {
          "@language": "de",
          "@value": "Adresse"
        },
        {
          "@language": "en",
          "@value": "Address"
        },
        {
          "@language": "fr",
          "@value": "Adresse"
        },
        {
          "@language": "nl",
          "@value": "Adres"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Address"
        }
      ],
      "vocDefinition": [
        {
          "@language": "de",
          "@value": "Eine Adresse identifiziert, für Menschen lesbar, den festen Standort eines räumliches Objektes (Gebäude, Grundstück, Anliegeplatz usw.). Zu diesem Zweck verfügt eine Adresse über eine Kennung, z. B. eine Hausnummer, die es dem Nutzer ermöglicht, sie von b"
        },
        {
          "@language": "en",
          "@value": "An address identifies a human readable way a fixed location of a spatial object  (building, parcel, mooring place etc.). For this purpose, an address has an identifier, f.i. a house number, which enables a user to distinguish it from the neighbor addresse"
        },
        {
          "@language": "fr",
          "@value": "Une adresse identifie, de manière lisible par l'homme, l'emplacement fixe d'un objet spatial (bâtiment, parcelle, amarrage etc.). À cette fin, une adresse possède un identifiant, par exemple un numéro de police, qui permet à l'utilisateur de la distinguer"
        },
        {
          "@language": "nl",
          "@value": "Een adres identificeert op een voor mensen leesbare manier de vaste locatie van een ruimtelijk object  (gebouw, perceel, standplaats, ligplaats)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:bc1937042d8b5462f043df3fcb191eb34ee7d1d72bb38a0ed511efa9850ce1df",
