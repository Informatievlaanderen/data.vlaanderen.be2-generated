      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "assignedURI": "http://www.w3.org/ns/locn#locatorDesignator",
      "vocLabel": [
        {
          "@language": "fr",
          "@value": "Numéro de boite"
        },
        {
          "@language": "nl",
          "@value": "Busnummer"
        },
        {
          "@language": "en",
          "@value": "Box number"
        },
        {
          "@language": "de",
          "@value": "Briefkasten Nummer"
        }
      ],
      "diagramLabel": [
        {
          "@value": "boxNumber"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die hetzelfde huisnummer hebben."
        },
        {
          "@language": "en",
          "@value": "An officially assigned alphanumeric code that is added to the house number to distinguish multiple building units, mooring places, stands or parcels that have the same house number."
        },
        {
          "@language": "fr",
          "@value": "Code alphanumérique, attribué officiellement, qui s’ajoute au numéro de la maison pour distinguer plusieurs unités de bâtiment, postes d’amarrage, emplacements ou parcelles qui portent le même numéro de la maison."
        },
        {
          "@language": "de",
          "@value": "Ein amtlich vergebener alphanumerischer Code, der der Hausnummer hinzugefügt wird, um mehrere Gebäudeeinheiten, Liegeplätze, Standplätze oder Parzellen mit der gleichen Hausnummer zu unterscheiden."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:25a6895101a8acc7895b84b84a0950cfcb7f2a4d073e043599a8b3db2f76ea62"
