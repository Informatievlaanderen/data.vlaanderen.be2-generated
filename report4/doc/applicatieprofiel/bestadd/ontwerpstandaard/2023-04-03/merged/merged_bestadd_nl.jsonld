      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "assignedURI": "http://vocab.belgif.be/ns/location#homonymAddition",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "homonymAddition"
        },
        {
          "@language": "nl",
          "@value": "Homoniemtoevoeging"
        },
        {
          "@language": "fr",
          "@value": "Addition homonyme"
        },
        {
          "@language": "de",
          "@value": "HomonymAddition"
        }
      ],
      "diagramLabel": [
        {
          "@value": "homonymAddition"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Toevoeging aan de straatnaam om een onderscheid te maken tussen 2 straten die dezelfde naam hebben binnen dezelfde gemeente, bijv. e.g. Groenstraat (ANBO), Groenstraat (HOWI)"
        },
        {
          "@language": "en",
          "@value": "Addition to the streetname in order to distinguish between 2 streets with the same name in the same municipality, e.g. Groenstraat (ANBO), Groenstraat (HOWI)"
        },
        {
          "@language": "fr",
          "@value": "Suffix au nom d'une rue afin de distinguer entre deux rues qui sont situées dans la même commune et qui ont le même nom, p.e. Groenstraat (ANBO), Groenstraat (HOWI)"
        },
        {
          "@language": "de",
          "@value": "Ein Suffix, das an einen Straßennamen angehängt wird, um zwei Straßen in derselben Gemeinde mit demselben Namen zu unterscheiden., z.b. Groenstraat (ANBO), Groenstraat (HOWI)"
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:d33c882481a8b0dd4a5a23a9a92f38186d1847876b9971b708188cc581a0e559"
