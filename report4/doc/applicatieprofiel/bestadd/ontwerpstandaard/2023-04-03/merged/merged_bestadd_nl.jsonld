  "attributes": [
    {
      "@id": "urn:oslo-toolchain:4a2907cd0d6d0393d3b343062f01c9c877e898dd42fc18124ff948b4aa1cb27e",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "assignedURI": "http://www.w3.org/ns/locn#locatorDesignator",
      "vocLabel": [
        {
          "@language": "fr",
          "@value": "Numéro de la maison"
        },
        {
          "@language": "nl",
          "@value": "Huisnummer"
        },
        {
          "@language": "en",
          "@value": "House number"
        },
        {
          "@language": "de",
          "@value": "Hausnummer"
        }
      ],
      "diagramLabel": [
        {
          "@value": "houseNumber"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."
        },
        {
          "@language": "fr",
          "@value": "Code alphanumérique attribué officiellement à des unités de bâtiment, postes d’amarrage, emplacements ou parcelles."
        },
        {
          "@language": "en",
          "@value": "Alphanumeric code officially assigned to building units (house number), mooring places, stands or parcels."
        },
        {
          "@language": "de",
          "@value": "Alphanumerischer Code, der offiziell Gebäudeeinheiten (Hausnummern), Liegeplätzen, Stellplätzen oder Parzellen zugewiesen wird."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:25a6895101a8acc7895b84b84a0950cfcb7f2a4d073e043599a8b3db2f76ea62"
      },
