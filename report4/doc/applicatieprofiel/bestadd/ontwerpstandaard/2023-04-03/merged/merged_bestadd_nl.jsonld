      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Positie uitgedrukt volgens de WGS84 standaard (World Geodetic System 1984 op basis van lengtegraad en breedtegraad)"
        },
        {
          "@language": "en",
          "@value": "Position expressed according to WGS84 standard (World Geodetic System 1984 using longitude and latitude)"
        },
        {
          "@language": "de",
          "@value": "Position auf basis des WGS84-Standards (World Geodetic System 1984 unter Verwendung von Längen- und Breitengraden)"
        },
        {
          "@language": "fr",
          "@value": "Positions exprimée selon la norme WGS84 (World Geodetic System 1984 utilisant longitude et latitude)"
        }
      ],
