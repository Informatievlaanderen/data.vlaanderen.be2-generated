    {
      "@id": "urn:oslo-toolchain:4b83d440ab5da16aec4723b044f22533869009b2165224946c306db6b6f56ad4",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "assignedURI": "http://vocab.belgif.be/ns/location#endLifespanVersion",
      "vocLabel": [
        {
