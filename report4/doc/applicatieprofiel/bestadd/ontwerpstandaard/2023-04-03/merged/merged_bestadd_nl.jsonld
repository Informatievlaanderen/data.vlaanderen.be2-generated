  "classes": [
    {
      "@id": "urn:oslo-toolchain:d33c882481a8b0dd4a5a23a9a92f38186d1847876b9971b708188cc581a0e559",
      "@type": "Class",
      "assignedURI": "http://inspire.ec.europa.eu/ont/ad#ThoroughfareName",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "StreetName"
        },
        {
          "@language": "fr",
          "@value": "Nom de la rue"
        },
        {
          "@language": "nl",
          "@value": "Straatnaam"
        },
        {
          "@language": "de",
          "@value": "Straßenname"
        }
      ],
      "diagramLabel": [
        {
          "@value": "StreetName"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "An address component that represents the name of a passage or way through from one location to another."
        },
        {
          "@language": "fr",
          "@value": "Un composant d'adresse qui est le nom d'un passage ou d'une route passant d'un endroit à un autre."
        },
        {
          "@language": "nl",
          "@value": "Een adrescomponent die de naam is van een passage of een weg van de ene locatie naar een andere."
        },
        {
          "@language": "de",
          "@value": "Eine Adresskomponente, die den Namen einer Passage oder eines Durchgangs von einem Ort zu einem anderen darstellt."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "fr",
          "@value": "Il arrive parfois qu'une même commune comporte deux rues portant le même nom (par exemple, suite à la fusion de deux communes). En Wallonie, ces rues sont distinguées par un identifiant différent et rattachées à une partie de commune différente."
        },
        {
          "@language": "nl",
          "@value": "Het kan voorkomen dat één gemeente twee straten met dezelfde naam heeft (bijvoorbeeld na de fusie van twee gemeenten). In Wallonië worden dergelijke straten onderscheiden door een andere identifier en zijn ze gekoppeld aan een ander gemeentedeel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8358edb3c4f98357d9891d4874d9911eeacc2a30a416f099c6260e3ba9c74efa",
      "@type": "Class",
      "assignedURI": "http://vocab.belgif.be/ns/location#Municipality",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Municipality"
        },
        {
          "@language": "nl",
          "@value": "Gemeente"
        },
        {
          "@language": "fr",
          "@value": "Commune"
        },
        {
          "@language": "de",
          "@value": "Gemeinde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Municipality"
        }
      ],
      "vocDefinition": [
        {
          "@language": "fr",
          "@value": "Zone administrative officielle du territoire belge. La commune (ville ou commune) est la plus petite unité administrative du territoire belge dont les limites ne peuvent être modifiées que par le législateur."
        },
        {
          "@language": "nl",
          "@value": "Officiële administratieve zone van het Belgisch grondgebied. De gemeente is het kleinste administratieve deel van het Belgisch grondgebied waarvan de grenzen enkel door de wetgever kunnen worden gewijzigd."
        },
        {
          "@language": "en",
          "@value": "Official administrative zone of the Belgian territory. The municipality (Village or town) is the smallest administrative unit of the Belgian territory whose boundaries can only be changed by the legislator."
        },
        {
          "@language": "de",
          "@value": "Offizielle Verwaltungszone des belgischen Staatsgebiets. Die Gemeinde (Dorf oder Stadt) ist der kleinste Verwaltungsteil des belgischen Staatsgebiets, dessen Grenzen nur vom Gesetzgeber geändert werden können."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:25a6895101a8acc7895b84b84a0950cfcb7f2a4d073e043599a8b3db2f76ea62",
