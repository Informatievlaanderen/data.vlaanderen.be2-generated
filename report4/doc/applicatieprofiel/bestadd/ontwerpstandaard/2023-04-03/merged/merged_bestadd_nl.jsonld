      "vocUsageNote": [
        {
          "@language": "en",
          "@value": "A versionIdentifier could be a datetimestamp (as is used by Flanders) or a number (as is used by Wallonia and Brussels)."
        },
        {
          "@language": "de",
          "@value": "Ein Versionsbezeichner könnte ein Datums-/Zeitstempel (wie in Flandern verwendet) oder eine Zahl (wie in Wallonien und Brüssel verwendet) sein."
        },
        {
          "@language": "fr",
          "@value": "Un versionIdentifier peut être un horodatage (comme celui utilisé par la Flandre) ou un numéro (comme celui utilisé par la Wallonie et Bruxelles)."
        },
        {
          "@language": "nl",
          "@value": "Een versionIdentifier kan een datum/tijdstempel zijn (zoals in Vlaanderen) of een nummer (zoals in Wallonië en Brussel)."
        }
      ],
