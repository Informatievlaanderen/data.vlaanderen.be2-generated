    {
      "@id": "urn:oslo-toolchain:82ca6f6c16afafb0b6e82030a735dd42e2918ee0a9cdc574feeb94a7ba55bf58",
      "@type": "Class",
      "assignedURI": "http://vocab.belgif.be/ns/location#AddressableObject",
      "vocLabel": [
        {
          "@language": "de",
          "@value": "AdressierbaresObjekt"
        },
        {
          "@language": "en",
          "@value": "AddressableObject"
        },
        {
          "@language": "fr",
          "@value": "Objet addressable"
        },
        {
          "@language": "nl",
          "@value": "Adresseerbaar object"
        }
      ],
      "diagramLabel": [
        {
          "@value": "AddressableObject"
        }
      ],
      "vocDefinition": [
        {
          "@language": "de",
          "@value": "Räumlicher Objekttyp, dem eine Adresse zugewiesen werden kann. Die häufigsten adressierbaren Objekte sind Grundstücke, Katasterparzellen, Gebäude, Gebäudeeingänge, Wohnungen, Appartements, Eigentumswohnungeninnerhalb eines Gebäudes usw."
        },
        {
          "@language": "en",
          "@value": "Spatial object type to which an address can be assigned. Most common addressable objects are real properties, cadastral parcels, buildings, entrances to \r\nbuildings, dwellings, flats, condominiums/common holds etc., inside a building. Addressable objects"
        },
        {
          "@language": "fr",
          "@value": "Type d’objet spatial auquel une adresse peut être attribuée. Les objets adressables les plus courants sont les biens immobiliers, les parcelles cadastrales, les bâtiments, les entrées de bâtiments, les logements, les appartements, les copropriétés, etc.,"
        },
        {
          "@language": "nl",
          "@value": "Ruimtelijk object waaraan een adres kan worden toegekend. De meest voorkomende adresseerbare objecten zijn gebouwen, percelen, gebouwingangen, gemene delen binnen een gebouw enzovoort."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
