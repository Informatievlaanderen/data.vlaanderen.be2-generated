          "@value": "Specificies the geometry method that was used to determine the position"
        },
        {
          "@language": "fr",
          "@value": "Indique la méthode de géométrie utilisée pour déterminer la position"
        },
        {
          "@language": "nl",
          "@value": "Geeft aan welke geometrie methode werd gebruikt om de positie te bepalen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:fa493c438763d5db86a7e5e23a26cf7cbbad87ed703620f8cf59f9d8b6ef3acc",
