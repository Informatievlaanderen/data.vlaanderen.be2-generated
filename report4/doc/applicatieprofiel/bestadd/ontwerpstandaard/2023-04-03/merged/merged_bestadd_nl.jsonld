    {
      "@id": "urn:oslo-toolchain:7cea36740f366e36d330469e84cc4497a79a7910fdf34e6c5dcb2f5755966c77",
      "@type": "Class",
      "assignedURI": "http://todo.com/AddressHistory",
      "diagramLabel": [
        {
          "@value": "AddressHistory"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "This history table links two historically related entities. Each record contains: predecessor, successor and eventDate. (constructed by BOSA based on mutations processed on the BeSt Address database)"
        },
        {
          "@language": "de",
          "@value": "Diese Verlaufstabelle verknüpft zwei historisch zusammenhängende Entitäten.\nJede historische Entität hat dieselbe Struktur: Vorgänger, Nachfolger und Ereignisdatum (von BOSA anhand der Mutationen verarbeitet in der BeSt Address Datenbank)."
        },
        {
          "@language": "fr",
          "@value": "Cette table d'historique relie deux entités historiquement liées. Chaque donnée contient:  prédécesseur, successeur et date d'événement. (Construit par BOSA basé sur les mutations traitées dans la base de données BeSt Address)"
        },
        {
          "@language": "nl",
          "@value": "Deze historiek tabel koppelt twee historisch gerelateerde entiteiten.\nElke historische entiteit heeft dezelfde structuur: voorganger, opvolger en eventDate. (opgebouwd door BOSA op basis van mutaties verwerkt in de BeSt Address databank)"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:9f1a1e9a5b8e837f038993b4d077c889e539495c8f3ed39fa5e8f107af2dd55d",
      "@type": "Class",
      "assignedURI": "http://todo.com/Status",
      "diagramLabel": [
        {
          "@value": "Status"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "The status contains the status value and the validity period (date validFrom and validTo)"
        },
        {
          "@language": "de",
          "@value": "Der Status enthält den Statuswert und den Gültigkeitszeitraum (Datum von und Datum bis)."
        },
        {
          "@language": "fr",
          "@value": "L'état contient une valeur pour l'état et également la durée de validité."
        },
        {
          "@language": "nl",
          "@value": "De status bevat de status waarde en de geldigheidsperiode (datum van en datum tot)"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
