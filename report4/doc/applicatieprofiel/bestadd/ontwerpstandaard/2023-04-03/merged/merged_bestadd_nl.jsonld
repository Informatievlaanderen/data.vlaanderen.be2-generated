    {
      "@id": "urn:oslo-toolchain:a81da906734fd30242a04add1a315146fb1dc8a14c932408af1d926b4a35a13e",
      "@type": "Class",
      "assignedURI": "http://vocab.belgif.be/ns/location#AddressableObject",
      "vocLabel": [
        {
          "@language": "fr",
          "@value": "Objet addressable"
        },
        {
          "@language": "nl",
          "@value": "Adresseerbaar object"
        },
        {
          "@language": "en",
          "@value": "AddressableObject"
        },
        {
          "@language": "de",
          "@value": "AdressierbaresObjekt"
        }
      ],
      "diagramLabel": [
        {
          "@value": "AddressableObject"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Ruimtelijk object waaraan een adres kan worden toegekend. De meest voorkomende adresseerbare objecten zijn gebouwen, percelen, gebouwingangen, gemene delen binnen een gebouw etc."
        },
        {
          "@language": "de",
          "@value": "Räumlicher Objekttyp, dem eine Adresse zugewiesen werden kann. Die häufigsten adressierbaren Objekte sind Grundstücke, Katasterparzellen, Gebäude, Gebäudeeingänge, Wohnungen, Appartements, Eigentumswohnungeninnerhalb eines Gebäudes usw."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
