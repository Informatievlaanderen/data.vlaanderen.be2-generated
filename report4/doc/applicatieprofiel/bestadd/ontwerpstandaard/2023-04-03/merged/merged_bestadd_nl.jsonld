          "@value": "endLifespanVersion"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geeft aan wanneer het record werd gearchiveerd in de databank van de authentieke bron."
        },
        {
          "@language": "fr",
