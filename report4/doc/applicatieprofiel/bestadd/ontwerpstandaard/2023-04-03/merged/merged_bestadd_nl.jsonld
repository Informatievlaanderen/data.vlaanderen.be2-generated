    {
      "@id": "urn:oslo-toolchain:f8f6a2fc9047f3dbe07d82b95171339ee02223798dcd263cc0b9486557f05361",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "assignedURI": "http://todo.com/officiallyAssigned",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Officially assigned"
        },
        {
          "@language": "fr",
          "@value": "Attribué officiellement"
        },
        {
          "@language": "nl",
          "@value": "Officieel toegekend"
        },
        {
          "@language": "de",
          "@value": "offiziel erteilt"
        }
      ],
      "diagramLabel": [
        {
          "@value": "officiallyAssigned"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geeft aan of het adres is toegekend door een officiële instantie (gewoonlijk de gemeente) (True)."
        },
        {
          "@language": "fr",
          "@value": "Indique si l'adresse a été attributé par une instance officielle (True)."
        },
        {
          "@language": "en",
          "@value": "States whether the address has been granted \nofficially by the municipality"
        },
        {
          "@language": "de",
          "@value": "Gibt an, ob die Adresse offiziel erteilt wurde von den Behörden (True)."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "en",
          "@value": "In case of a breach of law, the municipality can change the value to \"False\"."
        },
        {
          "@language": "de",
          "@value": "Bei Gesetzverstoss kann die Gemeinde die Wert ändern in \"False\"."
        },
        {
          "@language": "fr",
          "@value": "Indique si l'adresse a été attributé par une instance officielle (True). Si une infraction a été constaté, la commune peut changer la valeur en \"False\""
        },
        {
          "@language": "nl",
          "@value": "Als een afwijking wordt vastgesteld, kan de gemeente ambtenaar dit aanpassen naar \"False\"."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:25a6895101a8acc7895b84b84a0950cfcb7f2a4d073e043599a8b3db2f76ea62"
      },
