    {
      "@id": "urn:oslo-toolchain:4dc220d097bd1ca91295cfb4647d977da8bca537e60533b2c25b2147ca64cfa4",
      "@type": "Class",
      "assignedURI": "http://vocab.belgif.be/ns/location#PartOfMunicipality",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "PartOfMunicipality"
        },
        {
          "@language": "nl",
          "@value": "Deelgemeente"
        },
        {
          "@language": "fr",
          "@value": "Sous-commune"
        },
        {
          "@language": "de",
          "@value": "Untergemeinde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PartOfMunicpality"
        }
      ],
      "vocDefinition": [
        {
          "@language": "fr",
          "@value": "Une partie du territoire d’une commune, telle qu’une ancienne commune (préalable à la fusion des communes) ou un quartier."
        },
        {
          "@language": "nl",
          "@value": "Een deel van een gemeente, zoals een voormalige gemeente (voorafgaand aan de fusie van de gemeenten) of een wijk."
        },
        {
          "@language": "en",
          "@value": "A part of a municipality, such as a former municipality (prior to the merger of the municipalities) or a neighborhood."
        },
        {
          "@language": "de",
          "@value": "Ein Teil einer Gemeinde, z.b. eine ehemalige Gemeinde (vor der Fusion der Gemeinden) oder ein Stadtteil."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
