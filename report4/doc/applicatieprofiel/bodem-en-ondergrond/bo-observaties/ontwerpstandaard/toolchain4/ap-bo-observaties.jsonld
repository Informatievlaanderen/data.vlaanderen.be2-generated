      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#Meetreekswaarde",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Meetreekswaarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Meetreekswaarde"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een waardepaar in een Meetreeks met een waarde voor de het geobserveerdKenmerk en een waarde voor de parameter."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bv als de Meetreeks observeert hoe de lengte van iets varieert met de temperatuur dan omvat een Meetreekswaarde een waarde voor de lengte en één voor de temeratuur."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
