    {
      "@id": "urn:oslo-toolchain:740a15893df61aec3c4a1911394cd3794b6c1d45cb03f67f4bd6be4f8cd7ab0d",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Specimen#SF_Specimen",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Monster"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Monster"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Fysiek staal genomen van een object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bedoeld om ex situ te worden geobserveerd, bv in een labo, omdat de vereiste meetaparatuur niet ter plaatse kan worden gebracht of omdat het werkelijk te observeren Object niet kan worden verplaatst of niet rechtstreeks bereikbaar is.OPMERKING: Meer info over deze klasse in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/observaties-en-metingen\">AP Observaties en Metingen</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ec4c327b26dfc3cc1983958c6d529e5d8e8e246678cc22a3c0dbc48cafb7a8ad",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#Fractiemeting",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Fractiemeting"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Fractiemeting"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Meetreeks waarbij het aandeel van iets varieert in functie van iets anders."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dat aandeel wordt \"fractie\" genoemd. Vb is de statistische verdeling van onderwijsniveaus over de bevolking of de verdeling van korreldiameters in een bodemstaal. OPMERKING: Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/\">Bodem en Ondergrond</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:2bce9b024d3afa93431ec0cfa60f02d24b815bee75b32a1b9bc423f7a054ac1e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:2bce9b024d3afa93431ec0cfa60f02d24b815bee75b32a1b9bc423f7a054ac1e",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#Meetreeks",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Meetreeks"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Meetreeks"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie waarbij wordt nagegaan hoe een bepaald kenmerk verandert in functie van een ander kenmerk."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bv hoe de lengte van een Object verandert met de temperatuur (door uitzetting). We kunnen dit uitdrukken als y=f(x) waarbij in het vb y de lengte is en x de temperatuur. De variabele x noemen we de meetpuntparameter en y is de meetwaardeparameter. De meetwaardeparameter is in feite het geobserveerdKenmerk. Sommige types van Meetreeksen zijn zo specifiek dat we ze apart hebben gemodelleerd, bvb de DiscreetBereikobservatie waarbij een geobserveerdKenmerk varieert volgens positie of tijd.OPMERKING: Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/\">Bodem en Ondergrond</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ab6f856b36aacc32d65650df27a8bbfd28b3a8f0e14553955aa61008dfdded74",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/observaties#Samendrukbaarheidsproefresultaat",
