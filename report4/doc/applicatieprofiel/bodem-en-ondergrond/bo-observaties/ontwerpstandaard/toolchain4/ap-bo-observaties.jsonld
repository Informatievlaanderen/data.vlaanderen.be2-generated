      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Cohesie op een gedraineerd monster."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Waarbij cohesie staat voor de kritische schuifspanning zonder normaalspanning, ttz wanneer de grond spontaan afschuift. Op een gedraineerd monster speelt enkel de korrelspanning een rol, waterspanning kan het resultaat niet beïnvloeden."
        }
      ],
