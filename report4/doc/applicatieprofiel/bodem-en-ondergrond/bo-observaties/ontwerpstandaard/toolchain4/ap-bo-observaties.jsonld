          "@value": "Schuifweerstandsmeting"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Schuifweerstandsmeting"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Resultaat van een Schuifweerstandsproef."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Daarbij worden typisch de minimale hoofdspanning sigma3 en maximale hoofdspanning sigma 3 bepaald per deelmonster. Deze laten toe om middels een cirkel van Mohr de Cohesie en Wrijvingshoek te bepalen (zie Schuifweerstandkarakteristieken)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:253e208b37b597a2c480b147ed9d107a1be60f71d6962c3e0db086f133ce5011",
      "@type": "Datatype",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/observaties#Schuifweerstandskarakteristiek",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Schuifweerstandskarakteristiek"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Schuifweerstandskarakteristiek"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Resultaat van een Observatie waarbij karakteristieken van de Schuifweerstand worden berekend."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kenmerkende waarden zijn de cohesie en de wrijvingshoek, op basis waarvan een formule voor de kritische schuifspanning kan worden opgesteld (wet van Coulomb). De kritische schuifspanning is de spanning waarbij de grond afschuift bij een bepaalde normaalspanning."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
