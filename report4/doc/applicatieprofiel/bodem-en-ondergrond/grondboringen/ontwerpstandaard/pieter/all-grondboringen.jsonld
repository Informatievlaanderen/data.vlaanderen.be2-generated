        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijving van de Boormethode voor een bepaald diepte-interval."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Specialisatie van een CurveWaardepaar, dit is een Curve en de waarde die eraan is toegekend. De waarde is hier de beschrijving van de Boormethode van een Grondboring, terwijl de Curve aangeeft op welke dieptes deze beschrijving geldig is. De Curve van de Grondboring wordt hierbij als referentiesysteem gebruikt. OPGELET: Als de Curve van de Grondboring niet recht in de grond werd geboord zijn de opgegeven dieptes eerder afstanden langs deze Curve."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:bbdd72140fd8c802eb43cb060d1e1ec1d682842cbb5ae11ff08c72f1db21ee0a"
