          "@value": "Boormethode"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Methode waarmee geboord werd in functie van de diepte."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het verloop van de methode wordt voorgesteld als een DiscreetCurvebereik, dwz dat ze verandert in discrete stappen (intervallen) in functie van de diepte."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
