          "@language": "nl",
          "@value": "Boorgat"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Boorgat"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Curve ontstaan door het boren van een gat in een vast medium."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Laat toe om bijvoorbeeld de variatie van een bepaald fenomeen langs die curve te observeren, bijvoorbeeld de gelaagdheid van de ondergrond (typisch op basis van de boorkern of stalen daaruit genomen)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7ff39b9c879a8cfe8de6e5ea9b88ecf6e66e4e67b55625ce2bcb67e65057a9b1"
