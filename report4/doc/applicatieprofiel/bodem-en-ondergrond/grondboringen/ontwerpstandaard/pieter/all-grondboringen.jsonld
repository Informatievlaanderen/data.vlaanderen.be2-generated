          "@value": "LegaleVerschijningsvorm"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een legale verschijningsvorm is een intellectuele realisatie van een Rechtsgrond onder de vorm van een opeenvolging van tekens (meestal alphanumerieke tekens)."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld een Besluit dat is genomen op basis van een Wet."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:1c27433fba08d5dc709df2c0b6c78fac0faf8dc0123facdcb1cbc8b984d3c1f7",
      "@type": "Class",
      "assignedURI": "https://data.europa.eu/eli/ontology#LegalResource",
