        {
          "@language": "nl",
          "@value": "Erkenning"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Erkenning"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Officiële toelating toegekend aan een Persoon of Organisatie om een bepaald soort activiteiten uit te oefenen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld de toelating aan een boormaatschappij om Boringen uit te voeren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
