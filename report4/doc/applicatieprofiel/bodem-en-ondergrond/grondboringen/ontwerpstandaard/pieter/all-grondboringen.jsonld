    {
      "@id": "urn:oslo-toolchain:db5c1c1130e9cc9f189597fd9df439b0f903e4d35169d2155bc2d930bae34c7c",
      "@type": "Class",
      "assignedURI": "https://www.w3.org/TR/vocab-ssn/#ssn-system",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Systeem"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Systeem"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Systeem"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Samenhangend geheel van componenten die samen één of meer functies vervullen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze componenten kunnen Systemen op zich zijn. In deze context zijn het Systemen die een Observatieprocedure realiseren (typisch een Sensor) of waarmee een Bemonsteringsprocedure wordt uitgevoerd (bijvoorbeeld een Boorinstallatie). OPMERKING: Meer info over deze klasse in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering\">AP Sensoren en Bemonstering</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:636a8b4cb9f8c9cdf1650eadb76d3ad7dfa3219378b3acee546f9f1a80b38f6d",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/besluit#Besluit",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Besluit"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Besluit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Besluit"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De authentieke schriftelijke neerslag van een beslissing van een bestuursorgaan. Deze beslissing houdt een rechtshandeling in waarbij sprake is van een beoogd rechtsgevolg."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld het Besluit dat wordt genomen om een boorder een Erkenning te verlenen. OPMERKING: Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/besluit-publicatie/\">OSLO Besluit Publicatie</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    }
  ],
