        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:101495b421432e12b3062b8afd83262f45fdfc13984bad7559e0ab8e1b30e749",
      "@type": "Class",
