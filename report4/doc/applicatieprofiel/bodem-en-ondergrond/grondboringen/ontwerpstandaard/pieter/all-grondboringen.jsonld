      "@id": "urn:oslo-toolchain:1dc2b2a67d7b2b988640532ff43d2e45cc6576d3d3e22fd09551082e87156990",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/grondboringen#Grondobject",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Grondobject"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Grondobject"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Object in of mbt de grond."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld geologische laag, grondwaterlichaam, bodem... Eventueel te substitueren door een subklasse. Onder \"grond\" wordt het deel van de aardkorst onder het aardoppervlak verstaan."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
