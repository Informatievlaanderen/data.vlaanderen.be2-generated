          "@language": "nl",
          "@value": "Rechtsgrond"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Rechtsgrond"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een legaal concept dat los staat van een bepaalde vorm (het achterliggende idee)."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een rechtsgrond kan zowel een geheel (bijvoorbeeld: wet,besluit) voorstellen als een onderdeel eruit (bijvoorbeeld: artikel)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
