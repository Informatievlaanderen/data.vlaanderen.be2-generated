        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat hier over zaken als de manier van Bemonstering (Bemonsteringsprocedure) en het daarbij gebruikte instrumentarium (Bemonsteraar)."
        }
      ],
