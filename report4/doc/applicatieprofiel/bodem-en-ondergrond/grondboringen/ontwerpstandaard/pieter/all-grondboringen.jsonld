      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een RuimtelijkBemonsteringsobject dat de vorm aanneemt van een Curve."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Van het Object dat men wil observeren wordt in dat geval een representatief lijnvormig deel beschouwd. Voorbeelden zijn trajecten, boorgaten, profielen, intervallen etc. Dikwijls specialiseert de Curve zich tot Lijnstring. OPMERKING: Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/observaties-en-metingen/\">OSLO Observaties en Metingen</a> ."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
