      "diagramLabel": [
        {
          "@value": "Grondmonster"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Monster genomen uit de grond voor observatie ex situ."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze context beperken we ons tot Grondmonsters verkregen door middel van een Grondboring. De observatie gebeurt doorgaans in een labo."
        }
      ],
