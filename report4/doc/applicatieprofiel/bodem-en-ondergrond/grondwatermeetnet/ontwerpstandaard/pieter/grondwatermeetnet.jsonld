        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Procedure"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Procedure"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Vastgelegde of officiële manier om iets te doen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze context het uitvoeren van Observaties, Bemonstering of de Bediening van Actuators. Neemt in praktijk de vorm aan van een workflow, protocol, plan, algoritme, berekeningswijze etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
