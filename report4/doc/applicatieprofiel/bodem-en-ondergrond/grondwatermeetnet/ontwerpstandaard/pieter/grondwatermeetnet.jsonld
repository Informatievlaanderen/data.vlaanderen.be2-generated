        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Willekeurig gegeven gassocieerd met het Bemonsteringsobject."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld een parameter die een aspect van de Bemonstering beschrijft (bijvoorbeeld hoogte bij een luchtopname) of een belangrijke omgevingsparameter (bijvoorbeeld het waterpeil bij een boring)."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:7ff39b9c879a8cfe8de6e5ea9b88ecf6e66e4e67b55625ce2bcb67e65057a9b1"
