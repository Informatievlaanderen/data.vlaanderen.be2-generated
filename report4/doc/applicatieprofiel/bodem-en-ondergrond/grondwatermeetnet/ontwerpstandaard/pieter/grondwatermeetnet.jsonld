        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "RuimtelijkBemonsteringsobject met bijkomende kenmerken relevant voor het domein Bodem en Ondergrond."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat over kenmerken die typisch zijn in de context van Bemonstering bijvoorbeeld bij Boringen het maaiveld en de diepte."
        }
      ],
