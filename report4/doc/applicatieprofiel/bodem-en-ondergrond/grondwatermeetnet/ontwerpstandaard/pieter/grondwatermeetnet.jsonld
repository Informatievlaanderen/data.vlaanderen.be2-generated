  "datatypes": [
    {
      "@id": "urn:oslo-toolchain:5dd1495ae247da1af02aa7fb3f5bc64bca9a604008d250a41ce7060cf1ef3d0b",
      "@type": "Datatype",
      "assignedURI": "http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Period",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Periode"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Periode"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Periode"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 1-dimensionele geometrische primitieve in de tijd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Vergelijkbaar met een Curve in de ruimte, maar ipv een interval tussen twee punten in de ruimte gaat het hier over een interval tussen twee punten op de tijdsas. De bijbehorende tijdsduur is de temporele afstand tussen die twee punten (vergelijkbaar met de afstand tussen twee punten in de ruimte). OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bijvoorbeeld time:Interval uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:973f246ea8e9fe8a5815f2d1a3ec9e79cdd172ce710655ca740bec74ad656736"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:70d6f802eec03bf220ff3ca7875f73bdf9080077ef8a578b75ffbdd63ede75e9",
      "@type": "Datatype",
      "assignedURI": "http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Instant",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Moment"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Moment"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Moment"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 0-dimensionele geometrische primitieve in de tijd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Vergelijkbaar met een Punt in de ruimte, maar ipv een positie in een ruimtelijk referentiesysteem gaat het hier over een punt op de tijdsas. OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bijvoorbeeld time:Instant uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:67f9d9ee6cce9e9161804f0624439d75f4825f7def472d5fa312e88fdacc4bb7",
      "@type": "Datatype",
      "assignedURI": "http://def.isotc211.org/iso19103/2005/Names#GenericName",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "GeneriekeNaam"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "GeneriekeNaam"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GeneriekeNaam"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte klasse van alle namen in een naamruimte."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Subtypes zijn LokaleNaam en NaamInNaamruimte (resp een naam zonder en een naam met vermelding van een naamruimte). Datatype van LokaleNaam is bijvoorbeeld String of Taalstring, datatype van NaamInNaamruimte is bijvoorbeeld URI. OPMERKING: Meer info over dit datatype in <a href=\"https://www.iso.org/standard/56734.html\">ISO 19103 Geographic Information - Conceptual schema language</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:abed29c313575624489e10887cd47ba4aacfd1f1f6b9da52739b6af9d4e426f9",
      "@type": "Datatype",
      "assignedURI": "http://www.opengis.net/ont/sf#Curve",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Curve"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Curve"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Curve"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 1-dimensionele geometrische primitieve."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dimensie is te verstaan in wiskundige zin: het minimum aantal coördinaten nodig om een willekeurig punt voor te stellen dat deel uitmaakt van de primitieve. In het coördinaatsysteem dat door een Curve zelf gevormd wordt volstaat 1 coördinaat om een punt op de Curve te lokaliseren, bijvoorbeeld de afstand langs de Curve vanaf het vertrekpunt. Een Curve heeft dus een lengte maar geen breedte of hoogte, wat niet wegneemt dat ze door de 3D ruimte kan kronkelen. Curves worden doorgaans voorgesteld door polylijnen, dit zijn sets van opeenvolgende punten waarbij de tussenliggende punten van de Curve bekomen worden door middel van interpolatie. Als de interpolatiemethode lineair is krijg je een Lijnstring (een hoekige lijn die de opeenvolgende punten verbindt middels een rechte lijn), andere manieren om te interpoleren resulteren in circulaire bogen, cubic splines, Bézier curves etc (waarbij de controlepunten niet noodzakelijk op de Curve liggen). Een Curve wordt begrensd door zijn begin- en eindpunt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:87f67117aa830380b1907b8c88542fbf0f9fd5d4412c659363482e46be4f93ae"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
