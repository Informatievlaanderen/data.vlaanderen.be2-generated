      "vocLabel": [
        {
          "@language": "nl",
          "@value": "TaalString"
        }
      ],
      "diagramLabel": [
        {
          "@value": "TaalString"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Combinatie van een string en de taal waarin de inhoud ervan is gesteld."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld 'Rue Mercator' als string en 'fr' als taal. Te implementeren als Langstring."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5bf3ac9409fc3c91515e08c3e5524ccd394bcc91da6890f8576ef8ddf2bddce6",
      "@type": "Datatype",
      "assignedURI": "http://www.w3.org/ns/adms#Identifier",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Identificator"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Identificator"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Identificator"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie gebruikt om een object uniek te identificeren."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:4d52c935122f1abb9a38d27f510392df404596194a4d112a930d137d3d113cdb",
      "@type": "Datatype",
      "assignedURI": "https://schema.org/QuantitativeValue",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "KwantitatieveWaarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KwantitatieveWaarde"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld de hoogte van een object,het gewicht,de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog,laag en dergelijke vallen hier dus niet onder."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:78d2f42c93a0f41b58dcfbefb82e536e586387d943973fd2d9f297f295e330b9",
