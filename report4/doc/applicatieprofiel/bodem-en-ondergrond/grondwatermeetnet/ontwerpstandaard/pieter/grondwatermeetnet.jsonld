    },
    {
      "@id": "urn:oslo-toolchain:9b860db2fffc00768260cf52d2eb3e45b3a9674df8882fea300b0088e869e5be",
      "@type": "Datatype",
      "assignedURI": "https://data.vlaanderen.be/ns/generiek#StandaardEenheid",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "StandaardEenheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "StandaardEenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Eenheid vastgelegd door een standaardiserende organisatie."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Datatype kan een URI zijn of een GetypeerdeString. In het eerste geval wordt verwezen naar op het web gepubliceerde eenheden, bij voorkeur deze van qudt, bijvoorbeeld. voor <a href=\"http://qudt.org/vocab/unit/M\">meter</a>. In het geval van een GetypeerdeString gaat de voorkeur naar de UCUM-codes, bijvoorbeeld <a href=\"http://w3id.org/lindt/custom_datatypes#ucumunit\">km/h</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5293e6d6b601cb0b75af8ecf180b98a5dce5803473804f08c3a01a45cf1fdba1",
      "@type": "Datatype",
      "assignedURI": "http://www.opengis.net/ont/sf#Point",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Punt"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Punt"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 0-dimensionele geometrische primitieve."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dimensie is te verstaan in wiskundige zin: het minimum aantal coördinaten nodig om een willekeurig punt voor te stellen dat deel uitmaakt van de primitieve. In het coördinaatsysteem dat door een Punt zelf gevormd wordt is geen enkele coördinaat nodig, er is immers maar 1 punt. Een Punt heeft daarom geen breedte, lengte of diepte. OPGELET: dat betekent niet dat een Punt geen coördinaten kan hebben in een ander coördinaatysteem, bijvoorbeeld xyz-coördinaten in en 3-assig orthogonaal coördinaatsysteem.\n."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:87f67117aa830380b1907b8c88542fbf0f9fd5d4412c659363482e46be4f93ae"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6d7693f9274bdd2c0c04a1ddb7b22b4c7465ffff58a73ffd26d00d8213a18dca",
      "@type": "Datatype",
      "assignedURI": "https://data.vlaanderen.be/ns/generiek#DirectePositie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "DirectePositie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DirectePositie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Houder van de coördinaten van een positie in een coördinaatreferentiesysteem."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch gebruikt om de geometrie van een ruimtelijk object te beschrijven of de geometrische primitieven (bijvoorbeeld punt, Lijn, Vlak...) waaruit dat object is samengesteld. Een DirectePositie kan echter ook op zichzelf staan om een positie in de ruimte te beschrijven. De positie wordt gegeven in een coördinaatreferentiesysteem. Dat referentiesysteem wordt expliciet bij de DirectePositie opgegeven, tenzij deze deel uitmaakt van een ruimtelijk object (bijvoorbeeld een geometrische primitieve) waar al een referentiesysteem wordt vermeld. Ter info: Een coördinaatreferentiesysteem verschilt van een indirect ruimtelijk referentiesysteem in die zin dat posities direct door middel van coördinaten worden opgegeven ipv indirect door een adres of plaatsnaam."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:bbdd72140fd8c802eb43cb060d1e1ec1d682842cbb5ae11ff08c72f1db21ee0a",
      "@type": "Datatype",
      "assignedURI": "http://def.isotc211.org/iso19123/2005/CoverageCore#CV_CurveValuePair",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "CurveWaardepaar"
        }
      ],
      "diagramLabel": [
        {
          "@value": "CurveWaardepaar"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Element van een DiscreetCurveBereik."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een CurveWaardepaar beschrijft de geometrie van een stuk van de ruimte voorgesteld door een Curve en de waarde van een continu variërend fenomeen die men voor die Curve heeft vastgesteld. Bijvoorbeeld de straatnaam langs een stuk van een wegsegment of de stratigrafie van een diepteinterval bij een boring."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d69906cfb7cda969c5c265ad0e6ef71ee4685afff42c070e250bb2ff9415bddc"
        }
