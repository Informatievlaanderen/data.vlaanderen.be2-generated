        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Proces geassocieerd met het maken van een Bemonsteringsobject."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat hier over zaken als de manier van Bemonstering (Bemonsteringsprocedure) en het daarbij gebruikte instrumentarium (Bemonsteraar)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:1a204e0b0e92e775ad11006c222b9eda03e99e798f44863fc1aafdb0dcff6cf7",
