          "@value": "Getal"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Getal"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van een hoeveelheid."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "OPMERKING: Te substitueren door de primitieve datatypes waarmee een hoeveelheid kan worden aangeduid. Zie <a href=\"https://www.w3.org/TR/xmlschema-2/\">xsd datatypes</a> Integer, Float, Decimal, Double etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6586a948418b0300c08cc22ff842dca475060f6229b0ad3db5506b943e33c0a5",
      "@type": "Datatype",
      "assignedURI": "http://www.w3.org/ns/prov#Location",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Locatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Locatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van een geografische positie, door middel van coördinaten, een toponiem, een adreslabel, een verwijzing naar een plaats/regio of verwijzing naar een adres."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet dit datatype gesubstitueerd worden door klassen of datatypes zoals Geometrie, GeografischeNaam, Adres etc. OPMERKING: Meer info over deze klassen/datatypes in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/\">OSLO Generiek - basis</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:973f246ea8e9fe8a5815f2d1a3ec9e79cdd172ce710655ca740bec74ad656736"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6479920541f7c863b1cc42472664087bccd5319717bf2e0bb688a01571984d37",
      "@type": "Datatype",
      "assignedURI": "http://data.europa.eu/m8g/PeriodOfTime",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Periode"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Periode"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Min of meer afgebakende tijdsduur."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch volgt de duur uit het opgeven van een begin- en eindtijdstip."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:973f246ea8e9fe8a5815f2d1a3ec9e79cdd172ce710655ca740bec74ad656736"
        }
