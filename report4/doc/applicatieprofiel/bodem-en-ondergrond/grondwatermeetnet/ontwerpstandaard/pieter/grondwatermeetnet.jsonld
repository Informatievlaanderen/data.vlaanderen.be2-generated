    {
      "@id": "urn:oslo-toolchain:6711682c64d8adf9d924a5e5e3d020a8cf32cd56ad224612b71fd2ba73e38688",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.parameter",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "parameter"
        }
      ],
      "diagramLabel": [
        {
          "@value": "parameter"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Willekeurig gegeven gassocieerd met het gebeuren van de Observatie."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat hier niet om kenmerken van het geobserveerdObject (die worden al beschreven door het geobserveerdKenmerk) of om parameters geassocieerd met het observatieproces (zoals een instelling van een instrument). Het gaat hier bijvoorbeeld om omgevingsparameters die het resultaat kunnen beïnvloeden en van belang zijn om het resultaat correct te interpreteren. Een voorbeeld is de diepte in een waterput waarop de waterkwaliteit is gemeten of de omgevingstemperatuur bij het meten van de vochtigheidsgraad."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
      },
      "range": {
        "@id": "urn:oslo-toolchain:5f3653b9cbfa0c903ccb29b79b4833b70e3b8e1e765b98566e74da8c1661286e"
      },
      "minCount": {
        "@value": "0",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "maxCount": {
        "@value": "*",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:498956bda415cdc823c6f91b8ffa811739c528f7866777726d74a53e119cfbe0",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.phenomenonTime",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "fenomeentijd"
        }
      ],
      "diagramLabel": [
        {
          "@value": "fenomeentijd"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het moment waarop het resultaat van de Observatie van toepassing was."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch het moment waarop geobserveerd of bemonsterd werd. Als de Observatie temporeel is en het moment waarop iets plaatsvindt wordt geregistreerd dan is dit meteen ook de fenomeentijd."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
      },
      "range": {
        "@id": "urn:oslo-toolchain:b57de249b37c0de681e1078697f10e5629f212bb3025b3946220720583cda3d3"
      },
      "minCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "maxCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:cf6a3721123be992077d7e901c2e9314f4e77ff07629b6789da064f9c3380680",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.resultTime",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "resultaattijd"
        }
      ],
      "diagramLabel": [
        {
          "@value": "resultaattijd"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Tijdstip waarop het resultaat van de Observatie werd bekomen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Is voor sommige Observaties gelijk aan de fenomeentijd maar kan ook verschillen, bijvoorbeeld bij het uitvoeren van een analyse op een Monster dat eerder (en doorgaans dan ook en dergelijkeers) werd genomen of bij sensormetingen die pas later worden verwerkt. Ook bruikbaar om herhaalde Observaties bijvoorbeeld op eenzelfde Monster uiteen te houden. Is het resultaat een voorspelling dan is de fenomeentijd het moment waarop deze van toepassing zou moeten zijn."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
      },
      "range": {
        "@id": "urn:oslo-toolchain:70d6f802eec03bf220ff3ca7875f73bdf9080077ef8a578b75ffbdd63ede75e9"
      },
      "minCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "maxCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
