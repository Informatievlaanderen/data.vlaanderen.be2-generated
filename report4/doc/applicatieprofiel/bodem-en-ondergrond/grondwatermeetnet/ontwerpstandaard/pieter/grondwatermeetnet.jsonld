    {
      "@id": "urn:oslo-toolchain:7d4dbef0b721545f332b4217717ead54b5932115ad186c7c54573ed66e8c76ef",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/sosa/Sampler",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bemonsteraar"
        }
      ],
