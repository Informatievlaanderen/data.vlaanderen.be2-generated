        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kenmerkende waarden zijn de cohesie en de wrijvingshoek, op basis waarvan een formule voor de kritische schuifspanning kan worden opgesteld (wet van Coulomb). De kritische schuifspanning is de spanning waarbij de grond afschuift bij een bepaalde normaalspanning."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
