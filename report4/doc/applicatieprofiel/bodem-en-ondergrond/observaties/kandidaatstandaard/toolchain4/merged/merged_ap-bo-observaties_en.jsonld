    {
      "@id": "urn:oslo-toolchain:a075656625c98b3ef12f56366ae836c95d85ddb4548ce4fb4c0f529de193c44c",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/observaties#Schuifweerstandproef",
      "diagramLabel": [
        {
          "@value": "Schuifweerstandproef"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        },
        {
          "@id": "urn:oslo-toolchain:ed68676f86773d17b53977d048340a6843d9fd76567e9603de707c9c58673c95"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Labotest op een deelmonster om waarden te bepalen noodzakelijk voor het berekenen van de Schuifweerstandskarakteristieken."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Schuifweerstandsproef"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Getest wordt onder welke druk de grond in een monster bezwijkt (afschuift, breekt). Dit gebeurt in zeer gecontroleerde omstandigheden bvb bij de triaxaalproef door het monster op te sluiten in een container zodanig dat het overal dezelfde druk ervaart en er dan van bovenaf druk op uit te oefenen tot de breuk optreedt.Typisch wordt een van de procedures (waaronder de triaxaal procedure) toegepast beschreven in <a href=\"https://www.iso.org/search.html?PROD_isoorg_en%5Bquery%5D=17892\">ISO 17892-7 tot 10</a>. Door de proef enkele keren te herhalen op deelmonsters bij verschillende basisdrukken kunnen op basis van de vastgestelde drukwaarden (ook spanningen genoemd) karakteristieken worden bepaald (zie klasse Schuifweerstandkarakteristieken) op basis waarvan de kritische schuifspanning kan worden berekend, ttz de spanning waarbij de grond bezwijkt onder een bepaalde druk."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
