    {
      "@id": "urn:oslo-toolchain:254b81307680e062ad8fa2f25119da8224f25ac703b22fe9d399454257839e84",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een workflow, protocol, plan, algoritme of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Observatieprocedure"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bv de correcte plaatsing van een windmeter (op een welbepaalde hoogte boven het grondoppervlak, bv 10m voor meteorologische waarnemingen). De procedures zijn doorgaans bedoeld om bij meer dan één Bermonstering te worden toegepast."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://www.w3.org/ns/sosa/om#ObservationProcedure",
      "diagramLabel": [
