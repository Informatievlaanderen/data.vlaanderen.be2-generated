      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie waarbij de mate waarin een Grondmonster water doorlaat wordt bepaald dmv constant verval."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
