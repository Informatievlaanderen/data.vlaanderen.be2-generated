      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Resultaat van een Observatie waarbij karakteristieken van de Schuifweerstand worden berekend."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
