    {
      "@id": "urn:oslo-toolchain:f8265d948cdaad60609797d9ff5c4e84c9269923286770a24217a1da97878df7",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Klasse die kenmerken van instanties van om het even welk type vertegenwoordigt."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Kenmerktype"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van Observaties en Metingen is dit een kenmerk van het geobseveerdObject (of van het bemonsterdObject of een onderdeel daarvan) en in principe van alle instanties van dat type geobserveerdObject. Bv Lichaamstemperatuur, Lithologie, ChemischeSamenstelling (resp van een Persoon, een GeologischeEenheid en - meer indirect - van een Monster genomen op een bepaalde plek in een Rivier). Substitueren door een <a href=\"https://www.w3.org/TR/skos-reference/#Concept\">skos:Concept</a> OF een instantie van een equivalente klasse bvb <a href=\"https://qudt.org/schema/qudt/QuantityKind\">qudt:QuantityKind</a> OF eigen subklasse."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19109/2005/GeneralFeatureModel#GF_PropertyType",
      "diagramLabel": [
        {
          "@value": "Kenmerktype"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kenmerktype"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het vaststellen van de waarde van een bepaald kenmerk van een Object op een bepaald tijdstip of tussen twee tijdstippen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat om schattingen van de waarde, maw op de waarde zit een zekere foutmarge. Voorbeelden zijn temperatuur, klasse, kleur. Dit is verschillend van waarden die zijn toegekend en dus geen schattingen zijn zoals naam of prijs."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation",
