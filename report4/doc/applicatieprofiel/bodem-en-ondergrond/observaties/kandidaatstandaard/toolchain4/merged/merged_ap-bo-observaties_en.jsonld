          "@value": "Berekening van waarden op basis waarvan de kritische schuifspanning kan worden bepaald."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Schuifweerstandskarakteristieken"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Komt neer op het berekenen van de cohesie en de wrijvingshoek zodat de formule van Coulomb kan worden toegepast die voor een bepaalde normaalspanning aangeeft wat de kritische schuifspanning is, ttz de schuifspanning waarbij de grond afschuift."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
