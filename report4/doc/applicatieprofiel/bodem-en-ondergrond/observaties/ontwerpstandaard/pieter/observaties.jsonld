        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Cohesie op een gedraineerd monster."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Waarbij cohesie staat voor de kritische schuifspanning zonder normaalspanning, het is te zeggen wanneer de grond spontaan afschuift. Op een gedraineerd monster speelt enkel de korrelspanning een rol, waterspanning kan het resultaat niet beïnvloeden."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:253e208b37b597a2c480b147ed9d107a1be60f71d6962c3e0db086f133ce5011"
