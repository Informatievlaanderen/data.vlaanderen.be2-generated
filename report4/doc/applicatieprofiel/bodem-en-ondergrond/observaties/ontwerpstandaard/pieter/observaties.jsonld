    {
      "@id": "urn:oslo-toolchain:b6b5125fc101c92ad728598eb90057120808195e94fe7b5d340db9047e284409",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/DomainSpecificSamplingFeatures#Borehole",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Boorgat"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Boorgat"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Curve ontstaan door het boren van een gat in een vast medium."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Laat toe om bijvoorbeeld de variatie van een bepaald fenomeen langs die curve te observeren, bijvoorbeeld de gelaagdheid van de ondergrond (typisch op basis van de boorkern of stalen daaruit genomen). OPMERKING: Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/grondboringen/\">Grondboringen</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:254b81307680e062ad8fa2f25119da8224f25ac703b22fe9d399454257839e84",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/sosa/om#ObservationProcedure",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Observatieprocedure"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Observatieprocedure"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Observatieprocedure"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een workflow, protocol, plan, algoritme of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bijvoorbeeld de correcte plaatsing van een windmeter (op een welbepaalde hoogte boven het grondoppervlak, bijvoorbeeld 10m voor meteorologische waarnemingen). De procedures zijn doorgaans bedoeld om bij meer dan één Bermonstering te worden toegepast."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:bf102d45f93c751819aecbc32a8e4bf911c0e90dc55dc361be567ec5ba544a87"
        },
        {
          "@id": "urn:oslo-toolchain:1a204e0b0e92e775ad11006c222b9eda03e99e798f44863fc1aafdb0dcff6cf7"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e96decfd19892d6de7cbfa4e851615308e99cfe70684d799da6958f9ea057dfc",
      "@type": "Class",
      "assignedURI": "https://www.w3.org/ns/sosa/Sensor",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sensor"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Sensor"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Sensor"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Toestel of Agent (inclusief Personen of software) waarmee Observaties gemaakt worden."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Sensoren genereren een resultaat op basis van een Stimulus, het is te zeggen een verandering in de omgeving, of op basis van resultaten van andere Observaties. Ze worden typisch gehost door een Platform. Voorbeelden zijn snelheidsmeters, gyroscopen, barometers, magnetometers gemonteerd op een smart phone. Ook bijvoorbeeld het menselijk oog kan beschouwd worden als een Sensor."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:bf102d45f93c751819aecbc32a8e4bf911c0e90dc55dc361be567ec5ba544a87"
        },
        {
          "@id": "urn:oslo-toolchain:493ee4e854d9838456475a944184338c908b9bddd82eae6790398fcf4b58fcee"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:db5c1c1130e9cc9f189597fd9df439b0f903e4d35169d2155bc2d930bae34c7c",
      "@type": "Class",
      "assignedURI": "https://www.w3.org/TR/vocab-ssn/#ssn-system",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Systeem"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Systeem"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Systeem"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Samenhangend geheel van componenten die samen één of meer functies vervullen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze componenten kunnen Systemen op zich zijn. In deze context zijn het Systemen die een Observatieprocedure realiseren (typisch een Sensor) of waarmee een Bemonsteringsprocedure wordt uitgevoerd (bijvoorbeeld een Boorinstallatie). OPMERKING: Meer info over deze klasse in het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering\">AP Sensoren en Bemonstering</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e33056a54d1e5b3503cf91cd3b412af4af4ccd0d8e28fc93e4921302ea11432b",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/grondboringen#Grondmonster",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Grondmonster"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Grondmonster"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Monster genomen uit de grond voor observatie ex situ."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "OPMERKING: Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond/grondboringen/\">Grondboringen</a>."
        }
      ],
