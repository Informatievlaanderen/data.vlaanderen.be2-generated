      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Berekening van waarden op basis waarvan de kritische schuifspanning kan worden bepaald."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Komt neer op het berekenen van de cohesie en de wrijvingshoek zodat de formule van Coulomb kan worden toegepast die voor een bepaalde normaalspanning aangeeft wat de kritische schuifspanning is, het is te zeggen de schuifspanning waarbij de grond afschuift."
        }
      ],
