    {
      "@id": "urn:oslo-toolchain:f204a10cf864d342db42c5198739b1a46bae6e2e0359754035e7a5a559fef869",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/observaties#DoorlatendheidsproefCV",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "DoorlatendheidsproefCv"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DoorlatendheidsproefCV"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie waarbij de mate waarin een Grondmonster water doorlaat wordt bepaald door middel van constant verval."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Getest wordt hoeveel water in welke tijd infiltreert in het monster. Bij constant verval wordt het waterniveau daarbij steeds aangevuld. Doordat het water wordt aangevuld tijdens de proef is het verval, het is te zeggen het verschil tussen het hoogste en het laagste waterpeil, constant. Deze Observatie is een Meetreeks, waarbij de doorlatendheid varieert met de dichtheid van het Monster. Typisch wordt de procedure toegepast beschreven in <a href=\"https://www.iso.org/standard/72016.html\">ISO 17892-11</a> of afgeleiden daarvan."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        },
        {
          "@id": "urn:oslo-toolchain:4616a5bf3e5de29536c17281106ad6c0d2ec92dbc2cb20dc1a16754af3313a6e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:14bbb1431e84376c4d7d604bc2c047a03ccbd78e7ab0a351260f2e76216c6df2",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/observaties#DoorlatendheidsproefHVV",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "DoorlatendheidsproefHvv"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DoorlatendheidsproefHVV"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie waarbij de mate waarin een Grondmonster water horizontaal doorlaat wordt bepaald door middel van veranderlijk verval."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Getest wordt hoeveel water in welke tijd infiltreert in het monster. Bij veranderlijk verval wordt het waterniveau daarbij niet aangevuld. Deze Observatie is een Meetreeks, waarbij de doorlatendheid varieert met de druk. Druk die het resultaat is van het verval, het is te zeggen het verschil tussen het hoogste en het laagste waterpeil. Dat verschil varieert tijdens de proef naarmate dat verschil toe- of afneemt. Typisch wordt de procedure toegepast beschreven in <a href=\"https://www.iso.org/standard/72016.html\">ISO 17892-11</a> of afgeleiden daarvan."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        },
