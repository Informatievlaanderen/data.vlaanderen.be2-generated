    },
    {
      "@id": "urn:oslo-toolchain:d69906cfb7cda969c5c265ad0e6ef71ee4685afff42c070e250bb2ff9415bddc",
      "@type": "Datatype",
      "assignedURI": "http://def.isotc211.org/iso19123/2005/CoverageCore#CV_GeometryValuePair",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "GeometrieWaardepaar"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GeometrieWaardepaar"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Element van een DiscreetRuimtelijkBereik."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een GeometrieWaardepaar beschrijft de geometrie van een stuk van de ruimte (Punt, Lijn, Vlak etc.) of de tijd (Moment, Periode etc.) en de waarde van een continu variërend fenomeen die men voor dat stuk heeft vastgesteld. Bijvoorbeeld de waarde van een pixel in een luchtfoto of de temperatuur in een meetstation op een bepaald tijdstip."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
