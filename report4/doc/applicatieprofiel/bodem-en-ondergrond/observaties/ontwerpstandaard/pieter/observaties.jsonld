    {
      "@id": "urn:oslo-toolchain:627b1899067dae96eaefe81563463fdc73e3ad8bb358ba65bfbf1183a35b054c",
      "@type": "Datatype",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#Fractiemetingwaarde",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Fractiemetingwaarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Fractiemetingwaarde"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een Meetreekswaarde met een waarde voor de fractie en een waarde voor de parameter."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Een fractie (in de betekenis van \"aandeel\") houdt in dat een range wordt opgegeven voor de waarde van het meetpunt, vandaar de attributen meetpuntOndergrens en meetpuntBovengrens. De ondergrens kan daarbij ook gefixeerd worden, bijvoorbeeld bij een cummulatieve Korrelverdeling waar fractie=f(maximum korreldiameter) en bij oplopende range van korrelgrootte (=diameter van de zeefopeningen) een oplopende fractie krijgt, bijvoorbeeld korreldiameter 0-0.42mm=0%, 0-0.149mm=25% en 0-0.076mm=100%."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:4af73939b598e9d354473e3e4b9aa257015179262234da948894583bf7b1effd"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
