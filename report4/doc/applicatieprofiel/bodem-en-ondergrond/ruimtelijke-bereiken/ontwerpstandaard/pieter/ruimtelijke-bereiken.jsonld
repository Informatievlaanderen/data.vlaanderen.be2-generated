          "@language": "nl",
          "@value": "Vorm- en positiekenmerken van een object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:bf5b0bff98b6cc4074abc127ea8352c4253a3ed57fbd37cee7e28d52b334194a",
      "@type": "Datatype",
      "assignedURI": "http://def.isotc211.org/iso19123/2005/DiscreteCoverages#CV_Domainobject",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Domeinobject"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Domeinobject"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Stuk van ruimte of tijd waarvoor attribuutwaarden zijn bepaald."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In praktijk één of meerdere geometrieën of punten in de tijd waarvoor een waarde is bepaald. Bijvoorbeeld de polygoon of polygonen met hetzelfde landgebruik. OPMERKING: Enkel de ruimtelijkeSamenstelling van het Domeinobject is hier momenteel weergegeven, niet de temporeleSamenstelling."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d69906cfb7cda969c5c265ad0e6ef71ee4685afff42c070e250bb2ff9415bddc",
      "@type": "Datatype",
      "assignedURI": "http://def.isotc211.org/iso19123/2005/CoverageCore#CV_GeometryValuePair",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "GeometrieWaardepaar"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GeometrieWaardepaar"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Element van een DiscreetRuimtelijkBereik."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een GeometrieWaardepaar beschrijft de geometrie van een stuk van de ruimte (Punt, Lijn, Vlak etc.) of de tijd (Moment, Periode etc.) en de waarde van een continu variërend fenomeen die men voor dat stuk heeft vastgesteld. Bijvoorbeeld de waarde van een pixel in een luchtfoto of de temperatuur in een meetstation op een bepaald tijdstip."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
