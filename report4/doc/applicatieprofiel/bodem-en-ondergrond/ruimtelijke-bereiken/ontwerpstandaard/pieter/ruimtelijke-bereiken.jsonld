  "classes": [
    {
      "@id": "urn:oslo-toolchain:6167d48cf2aee61b179b3d0f9b2ca8336bca710cfbf9e01c746df075714456a1",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19123/2005/DiscreteCoverages#CV_DiscreteCoverage",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "DiscreetBereik"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DiscreetBereik"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Stapsgewijze variatie van een fenomeen in ruimte of tijd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In tegenstelling tot een ContinueBereik waarbij voor elk punt binnen het onderzocht gebied of voor elk punt op de tijdsas een waarde kan worden vastgesteld, is bij een DiscreetBereik de waarde enkel gekend voor een eindige set van punten of deelgebieden. Bijvoorbeeld bij remote sensing is de waarde gekend voor de pixels van het beeld (waarbij de vastgestelde waarde, bijvoorbeeld de reflectiegraad, dezelfde is voor elk punt binnen eenzelfde pixel). De opdeling kan kunstmatig zijn (zoals het geval met de pixels of bijvoorbeeld bij sampling van een gebied door middel van meetpunten) of natuurlijk (bijvoorbeeld aantal inwoners per gemeente, waarbij het aantal inwoners constant is binnen de gemeentegrens). Door middel van interpolatie kan een DiscreetBereik worden omgezet in een ContinueBereik, de meetpunten vormen dan ahw de controlepunten van de interpolatiefunctie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c9c7ff9960d5cdb1ef0e0c003cf3260d310aff3690c09bec81b74a4c5a2b3f0"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5c9c7ff9960d5cdb1ef0e0c003cf3260d310aff3690c09bec81b74a4c5a2b3f0",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19123/2005/CoverageCore#CV_Coverage",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bereik"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bereik"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Variatie van een fenomeen in ruimte of tijd."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Variatie van een fenomeen in ruimte of tijd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Voor situaties waarbij een fenomeen geen constante als waarde oplevert (bijvoorbeeld kleur), maar eerder hoe het fenomeen varieert in functie van locatie of tijd (bijvoorbeeld de temperatuur binnen een bepaald gebied of binnen een bepaalde periode)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7711a904afa347467bc931f9be5cf1bb1dafa55a44a5b4c7b3994d5a4f7df51c",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19103/2005/RecordsAndClassMetadata#Record",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Record"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Record"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Basis datastructuur bestaande uit een collectie van velden van mogelijk verschillende datatypes, typisch een vast aantal in een bepaalde volgorde."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:3404f4984065b52502e3eb27e1fad962920ad00e4af3e9ecb138edb176576c1a",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19123/2005/DiscreteCoverages#CV_DiscretePointCoverage",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "DiscreetPuntbereik"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DiscreetPuntbereik"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "DiscreetBereik waarbij het fenomeen puntgewijs varieert in de ruimte."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het fenomeen komt enkel voor op bepaalde puntlocaties in een gebied (bijvoorbeeld exemplaren van een bepaalde plantensoort) of werd enkel bepaald voor een welgekozen set van puntlocaties (bijvoorbeeld reflectiegraad op een regelmatig rooster van meetpunten)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6167d48cf2aee61b179b3d0f9b2ca8336bca710cfbf9e01c746df075714456a1"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
