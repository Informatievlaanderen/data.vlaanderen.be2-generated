        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Basis datastructuur bestaande uit een collectie van velden van mogelijk verschillende datatypes, typisch een vast aantal in een bepaalde volgorde."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
