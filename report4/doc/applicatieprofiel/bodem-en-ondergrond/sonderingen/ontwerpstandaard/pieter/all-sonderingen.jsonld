          "@language": "nl",
          "@value": "BenoemdeWaarde"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "BenoemdeWaarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "BenoemdeWaarde"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Generieke, zwak getypeerde waarde."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In essentie een waarde en de naam van het type van de waarde. In deze context gaat het over zaken zoals operator, omgevingstemperatuur etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
