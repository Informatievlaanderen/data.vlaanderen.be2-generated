      "apDefinition": [
        {
          "@language": "nl",
          "@value": "DiscreetBereik waarbij het fenomeen puntgewijs varieert in de ruimte."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het fenomeen komt enkel voor op bepaalde puntlocaties in een gebied (bv exemplaren van een bepaalde plantensoort) of werd enkel bepaald voor een welgekozen set van puntlocaties (bv reflectiegraad op een regelmatig rooster van meetpunten)."
        }
