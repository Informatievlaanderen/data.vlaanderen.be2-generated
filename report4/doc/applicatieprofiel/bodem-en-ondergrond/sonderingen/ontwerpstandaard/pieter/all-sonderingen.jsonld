    {
      "@id": "urn:oslo-toolchain:493ee4e854d9838456475a944184338c908b9bddd82eae6790398fcf4b58fcee",
      "assignedURI": "http://www.w3.org/ns/ssn/System",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Systeem"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Systeem"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Systeem"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Samenhangend geheel van componenten die samen één of meer functies vervullen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze componenten kunnen Systemen op zich zijn. In deze context zijn het Systemen die een Observatieprocedure realiseren (typisch een Sensor) of waarmee een Bemonsteringsprocedure wordt uitgevoerd (bv een Boorinstallatie)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:1dc2b2a67d7b2b988640532ff43d2e45cc6576d3d3e22fd09551082e87156990",
      "@type": "http://www.w3.org/2002/07/owl#Class"
    },
    {
      "@id": "urn:oslo-toolchain:15fca31d3138abcb3dbfbefb59d1f691e55ec7acf63656ce25a562a62ec34217",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/GeneralFeatureInstance#GFI_DomainFeature",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Domeinobject"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Domeinobject"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Domeinobject"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Object uit de reële wereld dat geen Bemonsteringsobject is."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is het werkelijk geobserveerdObject. Als rechtstreeks observeren niet kan observeren we een representatief staal, het zgn Bemonsteringsobject. In dat geval is het Domeinobject het bemonsterdObject. OPMERKING: Deze klasse is louter informatief, in praktijk moet ze gesubstitueerd worden door een klasse uit het domein. Bijvoorbeeld in het domein Waterkwaliteit zou het domeinobject een instantie van de klasse Rivier kunnen zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8dbd65e4f2e78e7e3acd09b9db983a0c92a5daeec0d5da84f9b0cf130710093b",
