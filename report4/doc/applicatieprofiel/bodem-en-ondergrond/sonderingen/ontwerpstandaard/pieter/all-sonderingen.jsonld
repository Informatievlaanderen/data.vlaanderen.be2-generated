    {
      "@id": "urn:oslo-toolchain:4d52c935122f1abb9a38d27f510392df404596194a4d112a930d137d3d113cdb",
      "@type": "Datatype",
      "assignedURI": "https://schema.org/QuantitativeValue",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "KwantitatieveWaarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KwantitatieveWaarde"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld de hoogte van een object,het gewicht,de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog,laag en dergelijke vallen hier dus niet onder."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:78d2f42c93a0f41b58dcfbefb82e536e586387d943973fd2d9f297f295e330b9",
      "@type": "Datatype",
      "assignedURI": "https://schema.org/Number",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Getal"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Getal"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van een hoeveelheid."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "OPMERKING: Te substitueren door de primitieve datatypes waarmee een hoeveelheid kan worden aangeduid. Zie <a href=\"https://www.w3.org/TR/xmlschema-2/\">xsd datatypes</a> Integer, Float, Decimal, Double etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6586a948418b0300c08cc22ff842dca475060f6229b0ad3db5506b943e33c0a5",
      "@type": "Datatype",
      "assignedURI": "http://www.w3.org/ns/prov#Location",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Locatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Locatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van een geografische positie, door middel van coördinaten, een toponiem, een adreslabel, een verwijzing naar een plaats/regio of verwijzing naar een adres."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet dit datatype gesubstitueerd worden door klassen of datatypes zoals Geometrie, GeografischeNaam, Adres etc. OPMERKING: Meer info over deze klassen/datatypes in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/\">OSLO Generiek - basis</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:973f246ea8e9fe8a5815f2d1a3ec9e79cdd172ce710655ca740bec74ad656736"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:9b860db2fffc00768260cf52d2eb3e45b3a9674df8882fea300b0088e869e5be",
      "@type": "Datatype",
      "assignedURI": "https://data.vlaanderen.be/ns/generiek#StandaardEenheid",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "StandaardEenheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "StandaardEenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Eenheid vastgelegd door een standaardiserende organisatie."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Datatype kan een URI zijn of een GetypeerdeString. In het eerste geval wordt verwezen naar op het web gepubliceerde eenheden, bij voorkeur deze van qudt, bijvoorbeeld. voor <a href=\"http://qudt.org/vocab/unit/M\">meter</a>. In het geval van een GetypeerdeString gaat de voorkeur naar de UCUM-codes, bijvoorbeeld <a href=\"http://w3id.org/lindt/custom_datatypes#ucumunit\">km/h</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5293e6d6b601cb0b75af8ecf180b98a5dce5803473804f08c3a01a45cf1fdba1",
      "@type": "Datatype",
      "assignedURI": "http://www.opengis.net/ont/sf#Point",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Punt"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Punt"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 0-dimensionele geometrische primitieve."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dimensie is te verstaan in wiskundige zin: het minimum aantal coördinaten nodig om een willekeurig punt voor te stellen dat deel uitmaakt van de primitieve. In het coördinaatsysteem dat door een Punt zelf gevormd wordt is geen enkele coördinaat nodig, er is immers maar 1 punt. Een Punt heeft daarom geen breedte, lengte of diepte. OPGELET: dat betekent niet dat een Punt geen coördinaten kan hebben in een ander coördinaatysteem, bijvoorbeeld xyz-coördinaten in en 3-assig orthogonaal coördinaatsysteem.\n."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:87f67117aa830380b1907b8c88542fbf0f9fd5d4412c659363482e46be4f93ae"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6d7693f9274bdd2c0c04a1ddb7b22b4c7465ffff58a73ffd26d00d8213a18dca",
      "@type": "Datatype",
      "assignedURI": "https://data.vlaanderen.be/ns/generiek#DirectePositie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "DirectePositie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DirectePositie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Houder van de coördinaten van een positie in een coördinaatreferentiesysteem."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch gebruikt om de geometrie van een ruimtelijk object te beschrijven of de geometrische primitieven (bijvoorbeeld punt, Lijn, Vlak...) waaruit dat object is samengesteld. Een DirectePositie kan echter ook op zichzelf staan om een positie in de ruimte te beschrijven. De positie wordt gegeven in een coördinaatreferentiesysteem. Dat referentiesysteem wordt expliciet bij de DirectePositie opgegeven, tenzij deze deel uitmaakt van een ruimtelijk object (bijvoorbeeld een geometrische primitieve) waar al een referentiesysteem wordt vermeld. Ter info: Een coördinaatreferentiesysteem verschilt van een indirect ruimtelijk referentiesysteem in die zin dat posities direct door middel van coördinaten worden opgegeven ipv indirect door een adres of plaatsnaam."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
