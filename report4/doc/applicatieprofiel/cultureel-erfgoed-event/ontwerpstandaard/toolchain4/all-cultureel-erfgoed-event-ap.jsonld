    {
      "@id": "urn:oslo-toolchain:6568f539a78bc7fff07cc7ba5b3bb294808a20fd69718c371203543f250c0a32",
      "@type": "Datatype",
      "assignedURI": "http://www.w3.org/ns/prov#Location",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Locatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Locatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een locatie kan een identificeerbare geografische locatie zijn (ISO 19112),maar deze locatie kan ook een niet-geografische locatie zijn,zoals een directory,rij of kolom. Als zodanig zijn er talloze manieren waarop locatie kan worden uitgedrukt,zoals d"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van een geografische positie,dmv coordinaten,een toponiem,een adreslabel,een verwijzing naar een plaats/regio of verwijzing naar een adres."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet direct gewerkt worden met Geometrie,GeografischeNaam,Adres etc. Opmerking: een beschrijving van deze mogelijkheden is te vinden in het AP OSLO-Generiek."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
