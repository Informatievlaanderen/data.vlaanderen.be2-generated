    {
      "@id": "urn:oslo-toolchain:6e39954a6bde09de175a7b25c607a3e238ea989845ae99011dc5dfebb04bcbc6",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F21",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Opnamewerk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Opnamewerk"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Werk gericht op het vastleggen van verschijnselen die plaatsvinden in een bepaald tijdsbestek."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Eventueel worden daarbij andere Werken geregistreerd maar die maken geen deel uit van het Opnamewerk, ze zijn net als bij een Containerwerk (ttz een Publicatiewerk, Voorstelling of Aggregatiewerk) hoogstens deel van de overeenkomstige Opname(expressie). Foto's of film registreren niet noodzakelijk iets (bv animatiefilm) in welk geval het gewone Werken en geen Opnamewerken zijn. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:fcb9d53bb5e5d748bae1de1662695c9fe1180eae7bd69353eb9e45fd4917ec12"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
