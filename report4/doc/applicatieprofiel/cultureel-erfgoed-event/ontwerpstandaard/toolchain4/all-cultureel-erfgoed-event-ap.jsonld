        }
      ],
      "diagramLabel": [
        {
          "@value": "Verhuis"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Wijziging in de fysieke locatie van een MensgemaaktObject."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": ""
        }
