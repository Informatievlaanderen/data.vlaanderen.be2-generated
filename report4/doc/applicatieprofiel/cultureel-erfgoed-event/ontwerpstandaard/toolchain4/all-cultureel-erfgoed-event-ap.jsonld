          "@language": "nl",
          "@value": "Type Conditie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "TypeConditie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "TO DO"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "TO DO"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d0238d50a4f5c415bb74248d5c34b63c6130b727b5bfd2b751976933ec40141f",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F31",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Voorstelling"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Voorstelling"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het tonen van een artistieke expressie aan een publiek, bv theater, dans, muziek..."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Hierbij wordt in principe een Voorstellingsplan gevolgd (dat in meer of mindere mate is uitgewerkt en mogelijk enkel improvisatie voorziet). Het is mogelijk om elke individuele Voorstelling apart te beschrijven of deze te beschrijven als één Voorstelling."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5abbf9f9c341f54a7bc6b0431ead7cbd68e5cba66e84d26b057109967ed96582"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:95b54122dc844147e48f22c50d490a705299340a964da4a9ca4bd122760d8752",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F28",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Expressie Creatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ExpressieCreatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Activiteit die leidt tot het ontstaan van een ZelfstandigeExpressie van een Werk."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Tevens subklasse van Productie. We gaan er hier immers van uit dat de ExpressieCreatie iets materieel achterlaat, bv het manuscript van een tekst of een tape met muziek. Gevallen waar dit niet zo is (bv bij orale tradities zoals het doorvertellen van verhalen) worden buiten beschouwing gelaten (maar kunnen nog steeds als Werk worden geregistreerd)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b861dbb217e9f80ccdba0dd2296b673865ea853ee5a3e78da8bf24619d1fb086"
        },
        {
          "@id": "urn:oslo-toolchain:fd03d7c7c19074595c3fe0aaac35988a9a3d9f7a598de334037dc35d2f1b1d73"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5085250c232cf9e97e09263cfefa29846dd75cd2dafa7554372e80fca26da46a",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F29",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Opnamesessie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Opnamesessie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het vastleggen van verschijnselen die plaatsvinden in een bepaald tijdsbestek, bv de live opname van een voorstelling, het filmen van een documentaire."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Eventueel wordt hierbij een opnameplan gevolgd. De sessie is inclusief eventuele postproductie. De ZelfstandigeExpressie die onstaat is vh type Opname en realiseert een Opnamewerk."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:95b54122dc844147e48f22c50d490a705299340a964da4a9ca4bd122760d8752"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8ad51a0352226c30517a9ecd146b5e0b5f89b0c3ca8d78e18df3c1cddb92d7bc",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F30",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Publicatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Publicatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Activiteit die betrekking heeft op het publiceren, ttz het verspreiden van expressies naar een groot publiek, bv in boekvorm of op het web."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Er zijn twee vormen van publiceren: fysiek en electronisch. In het eerste geval worden op grote schaal MensgemaakteObjecten geproduceerd (bv boeken), in het tweede geval MensgemaakteKenmerken (een gedownloade copie op een harde schijf)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:95b54122dc844147e48f22c50d490a705299340a964da4a9ca4bd122760d8752"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e63db095d9fbe0fee0067659570bccb17b217ed52d963ed7fd277d6c73c6d71b",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F27",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Conceptie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Conceptie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Activiteit die het ontstaan van een Werk markeert."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Begin van de evolutie van het Werk, tot de laatste Expressie ervan. Komt niet noodzakelijk overeen met het werkelijk begin maar bv met het moment waarop een eerste versie van het Werk klaar was."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:fd03d7c7c19074595c3fe0aaac35988a9a3d9f7a598de334037dc35d2f1b1d73"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:1c343094c7fdacfbed199de19452a1bbaac8e10c3bec512294c9def4037698db",
      "@type": "Class",
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E2_Temporal_Entity",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Temporele Entiteit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "TemporeleEntiteit"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Fenomenen die plaatsvinden in een bepaalde tijdspanne."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bv Gebeurtenis, Activiteit..."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:1d28906603179a587cd0d8c3348bed73c2a39508cf6201a56e6f80663674faa8",
      "@type": "Class",
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E6_Destruction",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Vernietiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Vernietiging"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis waarbij een MaterieelDing dusdanig wordt aangetast dat het ophoudt te bestaan."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit kan intentioneel door mensen worden veroorzaakt of volledig los staan van menselijke activiteit. In het eerste geval is de Gebeurtenis een Activiteit. Eventueel blijft bij de Vernietiging materie behouden waaruit een nieuw MaterieelDing ontstaat. Blijft ondanks de beschadiging het object toch bewaard dan spreken we eerder van een Wijziging."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:8a8ebf309db02673c2d9587fa91f0e5305d7cd3dfc46f576d1c09749bcea2da5"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:3bf02c594f8d4791db7d9d278dd049f2675bc8ebbfde749f47181bce2ed3cb38",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F22",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Zelfstandige Expressie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ZelfstandigeExpressie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De immateriële realisatie van een Individueel Werk op een bepaald moment dat als een compleet geheel kan worden beschouwd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een Werk kan gerealiseerd worden door meerdere ZelfstandigeExpressies, maar achter elke ZelfstandigeExpressie zit in principe een Individueel Werk. Bv een Aggregatiewerk vh type muziekalbum bevat meerdere ZelfstandigeExpressies die elk een Individueel Werk vh type \"song\" realiseren. Onder \"zelfstandig\" of \"compleet\" verstaan we dat de creator deze intentie had, zelfs al heeft hij de expressie misschien nooit volledig afgewerkt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:afd65134eea05c8538d75982ea062e0c552ffda6301359e3246da269db7b19a1"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:85a34766e7b4a8af9d3a0fcf2791993b55cdc1273efa35def3ba7e44ef8d10cc",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F1",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Werk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Werk"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Idee of combinatie van ideeën achter één of meer artistieke of intellectuele Expressies."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typische voorbeelden van Werken zijn gedichten, verhalen, muziekcomposities. Een Werk kan uit meerdere Werken bestaan maar het kan ook de uitingen van andere Werken omvatten (is bv het geval bij een Publicatiewerk). Soms zijn de artistieke/intellectuele uitingen slechts indirect bewijs voor het idee of de ideëen achter een Werk, ze vormen ahw een snapshot van een Werk op een bepaald moment. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:40bf779310115cc2f8d66a1bb86ae29924b51ae1230decd50f4664bbe81dd45a"
        },
        {
          "@id": "urn:oslo-toolchain:97ea8cf35ba80eec0171b14dffffb877d9cfad03d74c9e10d18ec1f9294b020e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a4b443043182ee3946ba8bacc4e322276377dfa39571ac319311f519efbc836c",
      "@type": "Class",
