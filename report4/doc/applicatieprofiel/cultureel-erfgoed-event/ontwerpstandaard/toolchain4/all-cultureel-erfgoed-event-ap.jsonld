    {
      "@id": "urn:oslo-toolchain:2156261bbb65375009aaf282b3dfaae4ee200bddcd903b0371c599e613ed6682",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F25",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Voorstellingsplan"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Voorstellingsplan"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Set van instructies waaraan individuele uitvoeringen van een Voorstelling moeten voldoen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch de aanwijzingen nodig voor theatrale, choreografische of muziekvoorstellingen. Kan bv gaan over aangepaste tekst van een toneelstuk, choregorafische bewegingen volgens een bepaalde notatie, de muzikale partituur of software-instructies. Het resultaat van een Voorstelling kan in meer of mindere mate uit het Voorstellingsplan worden afgeleid hoewel de instructies beperkt kunnen zijn (en bv louter improvisatie voorzien). Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:59d4aa68fd1fc9b647f9f15386ec427f4354b449ee0300407a7858fffe12849a"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:cf54389e7fa24b82b5a64ff316b9ff4494f6974d98c764a555d0ca0d63093e03",
      "@type": "Class",
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E78_Collection",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Gecureerde Collectie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GecureerdeCollectie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Verzameling MateriëleDingen die voor een specifiek doel en een bepaald publiek en volgens een ontwikkelingsplan door één of meer personen of organisaties wordt samengesteld en onderhouden (\"gecureerd\" en \"bewaard\" in museumtermen)."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typische voorbeelden zijn museumcollecties, archieven, bibliotheekcollecties, digitale bibliotheken. Samengestelde objecten zoals meerluiken of schaaksets die een fysiek of functioneel geheel vormen zijn geen GecureerdeCollecties. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:40bf779310115cc2f8d66a1bb86ae29924b51ae1230decd50f4664bbe81dd45a"
        },
        {
          "@id": "urn:oslo-toolchain:ce74fc3a70f56dd5624f211740ec133b4e0fce41e632d39ebf4c4ca6a2a8e544"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ce74fc3a70f56dd5624f211740ec133b4e0fce41e632d39ebf4c4ca6a2a8e544",
      "@type": "Class",
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Materieel Ding"
        },
        {
          "@language": "nl",
          "@value": "Materieel Ding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "MaterieelDing"
        },
        {
          "@value": "MaterieelDing"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Persistent fysiek item met een relatief stabiele vorm, kan mensgemaakt zijn of natuurlijk."
        },
        {
          "@language": "nl",
          "@value": "Persistent fysiek item met een relatief stabiele vorm, kan mensgemaakt zijn of natuurlijk."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Kunnen fysieke objecten zijn maar ook fysieke kenmerken. Het onderscheid tussen beide is gebaseerd op de natuurlijke begrenzing van het ding. De meeste fysieke objecten (zoals MensgemaaktObject) kunnen verplaatst worden, voor kenmerken (zoals MensgemaaktKenmerk) geldt dat niet, deze zitten vast aan het omliggend materiaal. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        },
        {
          "@language": "nl",
          "@value": "Kunnen fysieke objecten zijn maar ook fysieke kenmerken. Het onderscheid tussen beide is gebaseerd op de natuurlijke begrenzing van het ding. De meeste fysieke objecten (zoals MensgemaaktObject) kunnen verplaatst worden, voor kenmerken (zoals MensgemaaktKenmerk) geldt dat niet, deze zitten vast aan het omliggend materiaal. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
