    {
      "@id": "urn:oslo-toolchain:fd03d7c7c19074595c3fe0aaac35988a9a3d9f7a598de334037dc35d2f1b1d73",
      "@type": "Class",
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E65_Creation",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Creatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Creatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Activiteit die leidt tot het onstaan van een ConceptueelDing, bv een gedicht, tekst, muziek, beelden, films etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5abbf9f9c341f54a7bc6b0431ead7cbd68e5cba66e84d26b057109967ed96582"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:949bacd2a0694507fd857a494bb2f1e3de4a880e9c41789dcd7ce94e40314688",
      "@type": "Class",
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E13_Attribute_Assignment",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Toekenning"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Toekenning"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het vaststellen van de waarde van een kenmerk (attribuut of associatie) van een Entiteit."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Toekenning kan gaan over een Meting, Classificatie of Conditiebeoordeling (de subklassen van deze Activiteit), maar andere mogelijkheden zijn bv het vaststellen van het eigenaarschap, het dateren van het object..."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5abbf9f9c341f54a7bc6b0431ead7cbd68e5cba66e84d26b057109967ed96582"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:97ea8cf35ba80eec0171b14dffffb877d9cfad03d74c9e10d18ec1f9294b020e",
      "@type": "Class",
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E28_Conceptual_Object",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Conceptueel Ding"
        },
        {
          "@language": "nl",
          "@value": "Conceptueel Ding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ConceptueelDing"
        },
        {
          "@value": "ConceptueelDing"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Niet-materiële voortbrengselen van de geest of andere door mensen geproduceerde gegevens."
        },
        {
          "@language": "nl",
          "@value": "Niet-materiële voortbrengselen van de geest of andere door mensen geproduceerde gegevens."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan geproduceerd zijn met technologische middelen zoals camera's of computers. Typisch gecreëerd, uitgevonden of bedacht door iemand en dan gedocumenteerd of doorgegeven. Kunnen op meerdere dragers tegelijk bestaan, bv papier, audio, foto, harde schijf, canvas, menselijk geheugen. Een ConceptueelDing kan niet worden vernietigd, het bestaan ervan stopt pas als het op geen enkele drager nog voorkomt. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        },
        {
          "@language": "nl",
          "@value": "Kan geproduceerd zijn met technologische middelen zoals camera's of computers. Typisch gecreëerd, uitgevonden of bedacht door iemand en dan gedocumenteerd of doorgegeven. Kunnen op meerdere dragers tegelijk bestaan, bv papier, audio, foto, harde schijf, canvas, menselijk geheugen. Een ConceptueelDing kan niet worden vernietigd, het bestaan ervan stopt pas als het op geen enkele drager nog voorkomt. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:603d57f360551f74265a181de0a6a15ea31dafa6f0e9a3b6815a5c1bfd755c48"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f76cdb6fc9757a4ae1b80832c0633e2ea6552911f262a947b17b9b0c60ff4092",
      "@type": "Class",
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Informatie Object"
        }
      ],
      "diagramLabel": [
        {
          "@value": "InformatieObject"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Immaterieel object dat informatie omvat, ttz gegevens of data waaraan op één of andere manier betekenis is gegeven. Een Informatieobject gaat ergens over (het is propositioneel) en brengt dat over dmv symbolen (karakters, tekens etc.) of aggregaties daarvan."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Voorbeelden: gedichten, datasets, afbeeldingen, teksten, multimedia-objecten, ontwerpen of procedures, computerprogrammacode, algoritmes of wiskundige formules, kennisgraphs... Kan los van een drager bestaan of op één of meer dragers voorkomen. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:40bf779310115cc2f8d66a1bb86ae29924b51ae1230decd50f4664bbe81dd45a"
        },
        {
          "@id": "urn:oslo-toolchain:97ea8cf35ba80eec0171b14dffffb877d9cfad03d74c9e10d18ec1f9294b020e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:c5571916064bcd29946be9e771ba1eb5afc2c835073883e8f036f08b15eb2c75",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F24",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Publicatie Expressie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PublicatieExpressie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Geheel van zaken die uitdrukking geven aan de beslissingen van uitgevers mbt de selectie van de inhoud en de lay-out van publicaties."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch wordt wat oorspronkelijk louter tekst was grafisch en typografisch vormgegeven en worden illustraties en andere inhoud toegevoegd. Als zodanig bevat een instantie van een PublicatieExpressie alle Expressies nodig voor de uiteindelijke weergave van de publicatie, of die nu visueel, audio of tactiel is. Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:59d4aa68fd1fc9b647f9f15386ec427f4354b449ee0300407a7858fffe12849a"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:741c0c5686366f2c41c31b23f789957c626a1e6ff1ccc998d242da7e755635e2",
      "@type": "Class",
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F19",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Publicatiewerk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Publicatiewerk"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Werk bedoeld om verspreid te worden voor een groter publiek, in materiële of elektronische vorm en gericht op het weergeven van de Expressies van andere Werken."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typische voorbeelden zijn boeken, tijdschriften, naslagwerken, e-boeken, podcasts, blogs... Is net als een Aggregatiewerk of een Voorstellingswerk een Containerwerk, di een Werk waarvan de Expressie uit Expressies van andere Werken bestaat, bv teksten, foto's... Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:fcb9d53bb5e5d748bae1de1662695c9fe1180eae7bd69353eb9e45fd4917ec12"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5c8765c789252abac4dc4bfceb5b77bd0ded8a83ea6bf8dd24fda36b225cce19",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "apLabel": [
