    {
      "@id": "urn:oslo-toolchain:8637101f85ace7f6067d58d62fb523d55e1ef8bf1825dbc7d2da6131cf9f635c",
      "@type": "Class",
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E14_Condition_Assessment",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Conditiebeoordeling"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Conditiebeoordeling"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het vaststellen van de staat van een MaterieelDing."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit kan bv door inspectie of meting. Standaard attributen zijn conditie en een verwijzing naar het MaterieelDing, maar overgeërfde attributen van Gebeurtenis of Activiteit laten toe om de kwaliteit van de beoordeling te bepalen (bv wanneer werd ze uitgevoerd en door wie)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:949bacd2a0694507fd857a494bb2f1e3de4a880e9c41789dcd7ce94e40314688"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:acb3406ba25a7af03c163eaf31cbb6e2221398eea2bc8b75e779538e19bd0da0",
      "@type": "Class",
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E16_Measurement",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Meting"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Meting"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Vaststelling van kwantitatieve, fysische of andere kenmerken van een Entiteit die systematisch bepaald kunnen worden dmv een objectieve procedure of door directe observatie."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Voorbeelden zijn het vaststellen van de afmetingen van een van een schilderij of het bepalen van zijn geldwaarde of het meten van de looptijd van een film of het tellen van het aantal woorden in een tekst. Naast de standaard attributen (waarmee kan worden aangegeven van welke Entiteit iets wordt gemeten en de vastgestelde Dimensie), zijn ook hier van Gebeurtenis en Activiteit overgeërfde attributen van belang, bv het tijdstip waarop de Meting plaatsvond. Onder Meting valt niet het afleiden van informatie uit bestaande data, gebruik hiervoor de superklasse Toekenning."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:949bacd2a0694507fd857a494bb2f1e3de4a880e9c41789dcd7ce94e40314688"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    }
  ],
