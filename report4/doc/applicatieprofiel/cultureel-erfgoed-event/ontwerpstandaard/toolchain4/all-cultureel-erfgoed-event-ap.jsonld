        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Kwantificeerbare eigenschap van een Entiteit."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De eigenschap is meetbaar met een zekere precisie en kan voorgesteld worden door een waarde,ttz een punt of gebied in een wiskundige of conceptuele ruimte,zoals een natuurlijk of reëel getal,een RGB-waarde..."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
