      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Expressie die het resultaat is van een Opnamesessie, bedoeld om wat daarbij geregistreerd werd over te brengen en te bewaren."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Opmerking: een meer uitgebreide beschrijving is te vinden in het AP OSLO-CultureelErfgoed-Object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
