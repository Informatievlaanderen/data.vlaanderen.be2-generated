    {
      "@id": "urn:oslo-toolchain:172a87294b9f6c1ba29d4ea18087f816339f8e906ffbc9fe0afc572c14560aaf",
      "@type": "Datatype",
      "assignedURI": "http://id.loc.gov/datatypes/edtf/EDTF",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Periode"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Periode"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Min of meer afgebakende tijdsduur."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch volgt de duur uit het opgeven ve begin- en eindtijd maar ook een individuele tijd heeft een duur (bv 2020 loopt van 1/1/2020 tot 31/12/2020). Tijden worden dmv een String weergegeven volgens EDTF-formaat, wat toelaat om te gaan met lagere precisie (bv enkel het jaartal is gekend), negatieve tijden (x aantal jaar geleden), vastliggende periodes (seizoenen, kwartalen etc), onzekerheid (circa), open intervallen etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:84696c6f88486a1207f7cce98bf3c9b697a7f09f68325a0c3536d295b21d8fbf",
      "@type": "Datatype",
      "assignedURI": "https://data.vlaanderen.be/ns/generiek#StandaardEenheid",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Standaard Eenheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "StandaardEenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Eenheid vastgelegd door een standaardiserende organisatie."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Datatype kan een URI zijn of een GetypeerdeString. In het eerste geval wordt verwezen naar op het web gepubliceerde eenheden, bij voorkeur deze van qudt, bv http://qudt.org/vocab/unit/M voor meter. In het geval van een  GetypeerdeString gaat de voorkeur naar de UCUM-codes, bv \"km/h\"^^http://w3id.org/lindt/custom_datatypes#ucumunit."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:9063f8a0259b880e493974ebfadcd4479c0573b9ef8a7e770e5bcab454ee89d0",
      "@type": "Datatype",
      "assignedURI": "http://schema.org/ContactPoint",
