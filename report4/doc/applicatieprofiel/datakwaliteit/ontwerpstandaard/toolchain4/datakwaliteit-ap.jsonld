      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Record is a indexed set of objects. It can be associated to a RecordType in such a manner that the class of an indexed value object is of the class specified by the RecordType's correspondingly indexed TypeName. A Record  is a NameSpace for its included attributes."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Basis datastructuur bestaande uit een collectie van velden van mogelijk verschillende datatypes, typisch een vast aantal in een bepaalde volgorde."
        }
      ],
