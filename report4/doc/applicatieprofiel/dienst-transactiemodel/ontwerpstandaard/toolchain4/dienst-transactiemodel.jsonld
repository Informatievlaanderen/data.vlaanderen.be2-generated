      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een dossier is het geheel aan werk gedaan om tot een bestuurlijke of zakelijke beslissing te komen. Een dossier slaat doorgaans neer in een verzameling documenten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te gebruiken als logische bundeling van documenten binnen een bepaalde publieke dienstverlening."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
