    {
      "@id": "urn:oslo-toolchain:b8219b9a11b00e29684641265a20d39e75e31a1f465867d8353c3be62aa2d9be",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/RequirementResponse",
