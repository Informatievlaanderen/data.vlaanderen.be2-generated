      ],
      "diagramLabel": [
        {
          "@value": "Agent"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
