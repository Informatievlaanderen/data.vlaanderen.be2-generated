          "@value": "status Vlaamse fase"
        }
      ],
      "diagramLabel": [
        {
          "@value": "statusVlaamsFase"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Is het eerste veld van 2 verplichte velden (Fase+Status) die samen de 'Generieke Vlaamse status' specifiëren. De StatusVlaamsFase vormt de eerste en hogere indeling van het dossierverloop (in aanvraag, in behandeling, in beroep, in uitvoering enz). Verdere precisering binnen de Fase gebeurt dan in het veld StatusVlaamsCode."
        }
      ],
      "apDefinition": [
