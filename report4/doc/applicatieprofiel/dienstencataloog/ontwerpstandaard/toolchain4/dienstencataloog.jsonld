    {
      "@id": "urn:oslo-toolchain:df232fa39c765977cf1996a78c975639905762ba1a15c47966f2acdef1761dd8",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/Event",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gebeurtenis"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis die leidt tot, gebruik maakt van of gerelateerd is met een publieke dienstverlening."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Wordt gebruikt om een specifieke publieke dienstverlening op te zoeken in een dienstencataloog (bv erkenning van percentage invaliditeit na het stellen ve bepaalde diagnose) of een groep van publieke dienstverleningen (bv alle diensverlening die betrekking heeft op het starten van een eigen zaak)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpdocumentInOntwikkeling"
    },
