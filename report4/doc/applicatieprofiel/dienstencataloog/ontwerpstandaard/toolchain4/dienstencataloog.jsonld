      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/BusinessEvent",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bedrijfsgebeurtenis"
        }
      ],
      "diagramLabel": [
        {
          "@value": "BedrijfsGebeurtenis"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Situatie of gebeurtenis die een specifieke behoefte of (wettelijke) vereiste vh bedrijf op een bepaald moment in zijn levenscyclus weergeeft welke vervuld kan worden door het consumeren ve bepaalde publieke dienstverlening."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
