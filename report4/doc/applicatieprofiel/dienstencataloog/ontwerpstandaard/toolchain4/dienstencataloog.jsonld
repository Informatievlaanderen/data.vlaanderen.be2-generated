    {
      "@id": "urn:oslo-toolchain:f5faa1672b437a49588031f96e9f6f8e4ba46e4deca95fec27aa0bf443959642",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/CriterionRequirement",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Criteriumvereiste"
        }
      ],
      "diagramLabel": [
        {
          "@value": "CriteriumVereiste"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Criterium dat toelaat te bepalen of een gebruiker recht heeft op een dienstverlening of deze mag gebruiken."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Niet elke publieke dienstverlening is voor iedereen noodzakelijk of nuttig. Bv werkloosheidsuitkeringen zijn enkel noodzakelijk voor werklozen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpdocumentInOntwikkeling"
    },
    {
      "@id": "urn:oslo-toolchain:7d281893970e715592886633c38fd20985f06d8e847048c37a9689596febbb3e",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/LifeEvent",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Levensgebeurtenis"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LevensGebeurtenis"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Belangrijke gebeurtenis of situatie in het leven van een persoon waarvoor hij/zij een publieke dienstverlening nodig heeft."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Enkel gebeurtenissen die geassocieerd kunnen worden met een publieke dienstverlening worden hier bedoeld. Bv niet de verloving van twee personen met elkaar maar wel het feit dat ze huwen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
