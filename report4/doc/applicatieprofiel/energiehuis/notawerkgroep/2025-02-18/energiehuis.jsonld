      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het ondersteunen van een Agent door stapsgewijs te helpen bij het ondernemen van acties of het doorlopen van langdurige trajecten, al dan niet met regelmatige contactmomenten."
        }
