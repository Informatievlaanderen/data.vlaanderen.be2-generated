      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het verstrekken van algemene, laagdrempelige kennis en richtlijnen via diverse middelen zoals websites, video’s, brochures, telefoon, mail, en loket, op grote schaal. Interesse opwekken is gericht op het creëren van bewustwording en het trekken van de aandacht van een breed publiek, zodat zij op de hoogte zijn van iets."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het verstrekken van algemene, laagdrempelige kennis en richtlijnen via diverse middelen zoals websites, video’s, brochures, telefoon, mail, en loket, op grote schaal. Interesse opwekken is gericht op het creëren van bewustwording en het trekken van de aandacht van een breed publiek, zodat zij op de hoogte zijn van iets."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit kan bijvoorbeeld gaan over het verspreiden van flyers, deelnemen aan informatiemarkten, en het onderhouden van een informatieve website om een breed publiek te informeren over de diensten van een energiehuis."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit kan bijvoorbeeld gaan over het verspreiden van flyers, deelnemen aan informatiemarkten, en het onderhouden van een informatieve website om een breed publiek te informeren over de diensten van een energiehuis."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
