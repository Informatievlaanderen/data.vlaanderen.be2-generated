      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Kwantificeerbare eigenschap van een Entiteit."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Kwantificeerbare eigenschap van een Entiteit."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De eigenschap is meetbaar met een zekere precisie en kan voorgesteld worden door een waarde,ttz een punt of gebied in een wiskundige of conceptuele ruimte,zoals een natuurlijk of reëel getal,een RGB-waarde, etc. In tegensteling tot een 'meting' hoeft deze Dimensie zich niet te beperken tot Materiële Dingen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De eigenschap is meetbaar met een zekere precisie en kan voorgesteld worden door een waarde, ttz een punt of gebied in een wiskundige of conceptuele ruimte, zoals een natuurlijk of reëel getal, een RGB-waarde, etc. Van toepassing op Dingen, dus indirect zowel op Conceptuele als Materiële Dingen."
        }
      ],
