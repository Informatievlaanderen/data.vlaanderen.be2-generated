      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een geldbedrag dat een partij aan een andere partij geeft, op voorwaarde dat die laatste op termijn het geld terugbetaalt. Vaak gaat de terugbetaling van het geleende bedrag gepaard met de betaling van een vergoeding (rente)."
        }
      ],
      "apDefinition": [
