      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Kanaal waarlangs een agent kan interageren met een publieke dienstverlening."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typische voorbeelden: online,telefoon,kantoor…"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
