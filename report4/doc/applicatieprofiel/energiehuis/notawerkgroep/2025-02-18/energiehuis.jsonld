      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het ondersteunen van een Agent door stapsgewijs te helpen bij het ondernemen van acties of het doorlopen van langdurige trajecten, al dan niet met regelmatige contactmomenten."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Begeleiding kan enkel gegeven worden aan burgers uit inkomenscategorieën 2 en 3. De informatieoverdracht in deze fase is strikt persoonlijk, als ook pandgebonden, en niet vrij beschikbaar voor alle burgers. Deze fase is de overkoepelende fase voor 3 subfases."
        }
      ],
