        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het stadium in een verbouwingsproject waarin de Agent besluit verder te gaan met de verbouwing en de voorbereidingen voor de uitvoering worden getroffen."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het stadium in een verbouwingsproject waarin de Agent besluit verder te gaan met de verbouwing en de voorbereidingen voor de uitvoering worden getroffen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze fase omvat activiteiten zoals:\nopvragen en vergelijken van offertes, het gedetailleerd uitwerken van de financiële aspecten, het aanvragen en analyseren van eventuele leningen. De fase wordt afgesloten met de ondertekening van de gekozen offerte(s) door de klant en, indien van toepassing, de ondertekening van een leningsakte."
        }
      ],
      "apUsageNote": [
        {
