      "assignedURI": "https://data.vlaanderen.be/ns/energiehuis#Energiehuis.aantalBeschikbareLoketuren",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "aantal beschikbare loketuren"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "aantal beschikbare loketuren"
        }
      ],
      "diagramLabel": [
        {
          "@value": "aantalBeschikbareLoketuren"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het totaal aantal loketuren, berekend door het aantal loketten te vermenigvuldigen met het aantal openingsuren van de respectievelijke loketten en het aantal medewerkers beschikbaar als aanspreekpunt."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het totaal aantal loketuren, berekend door het aantal loketten te vermenigvuldigen met het aantal openingsuren van de respectievelijke loketten en het aantal medewerkers beschikbaar als aanspreekpunt."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: voor een energiehuis met 3 loketten met respectievelijk 15, 23 en 30 loketuren per week, met respectievelijk 1, 1 en 2 medewerkers, is het totaal aantal beschikbare loketuren gelijk aan 15*1+20*1+30*2=95 per week"
        }
      ],
      "apUsageNote": [
