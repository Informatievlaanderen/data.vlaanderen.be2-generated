          "@value": "Woon- en Energieloket"
        }
      ],
      "diagramLabel": [
        {
          "@value": "WoonEnEnergieloket"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een integrale dienst die inwoners van een gemeente ondersteunt bij een breed scala aan onderwerpen met betrekking tot wonen en energie (o.a. wonen, verhuren, bouwen, woningkwaliteit, klimaatadaptatie, energie)."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een integrale dienst die inwoners van een gemeente ondersteunt bij een breed scala aan onderwerpen met betrekking tot wonen en energie (o.a. wonen, verhuren, bouwen, woningkwaliteit, klimaatadaptatie, energie)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
