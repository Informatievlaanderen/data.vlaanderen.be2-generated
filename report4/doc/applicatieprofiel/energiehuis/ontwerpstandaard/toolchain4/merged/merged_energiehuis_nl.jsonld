    {
      "@id": "urn:oslo-toolchain:b8335084c3f852840b7c07519f0a40aeaf2b2d35ab0669e09774fc1931ef1f66",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/energiehuis#WoonEnEnergieloket",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Woon- en Energieloket"
        }
      ],
      "apLabel": [
