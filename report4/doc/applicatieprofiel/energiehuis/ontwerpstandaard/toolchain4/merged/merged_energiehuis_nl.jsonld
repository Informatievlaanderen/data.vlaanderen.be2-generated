          "@value": "Energiehuis"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een instantie die op het niveau van één of meer gemeenten diensten inzake energie en woningkwaliteit aanbiedt aan de klant."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een instantie die op het niveau van één of meer gemeenten diensten inzake energie en woningkwaliteit aanbiedt aan de klant."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
