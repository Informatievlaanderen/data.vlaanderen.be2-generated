      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het proces waarin de geplande activiteiten en werkzaamheden daadwerkelijk worden gerealiseerd om een project of taak te voltooien, vaak volgens vooraf opgestelde plannen en specificaties."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het proces waarin de geplande activiteiten en werkzaamheden daadwerkelijk worden gerealiseerd om een project of taak te voltooien, vaak volgens vooraf opgestelde plannen en specificaties."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze fase omvat activiteiten (vanuit het standpunt van Energiehuizen), zoals:\nwerfbezoek, aanspreekpunt voor derden, doorverwijzing bij conflict, risico’s tijdens de uitvoering analyseren en signaleren (bv. een aannemer die slechte reputatie heeft, bv. slechte uitvoering van een bepaald werk), eerste schijf van MVL opvragen, aanlevering en betaling van de facturen, ondersteuning van premie-aanvraag."
        }
      ],
      "apUsageNote": [
