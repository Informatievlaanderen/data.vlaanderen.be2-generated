          "@value": "Bestuurlijke Rechtshandeling"
        }
      ],
      "diagramLabel": [
        {
          "@value": "BestuurlijkeRechtshandeling"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Handeling, uitgaande van een bestuur, die de rechtstoestand wijzigt, dan wel belet dat deze wordt gewijzigd."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Voorbeelden van eenzijdige bestuurlijke rechtshandelingen zijn: besluiten van algemene strekking, uitvaardiging van voorschriften, beschikkingen zoals erkenningen en vergunningen en aktenamen. Breid deze klasse uit met de nodige specilisaties of typeringen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
