        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een collectie is een entiteit die structuur geeft aan sommige bestanddelen,die zelf entiteiten zijn. Deze bestanddelen zouden deel uitmaken van de collecties."
        }
      ],
