        {
          "@language": "nl",
          "@value": "Eenheid Van Werk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "EenheidVanWerk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze entiteit is bedoeld om de notie van een hoeveelheid werk over te brengen. Het verschilt van Activiteit in die zin dat het een duidelijk einde heeft en gemeten wordt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
