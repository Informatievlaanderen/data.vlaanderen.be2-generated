      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een formele handeling die in het kader van een Zaak wordt uitgevoerd."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het kan gaan om Rechtshandelingen, maar ook administratieve handelingen. In casemanagement systemen die CMMN implementeren komt deze entiteit overeen met een PlanItem."
        }
