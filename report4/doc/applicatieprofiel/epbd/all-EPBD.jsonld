      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een agent is iets dat een of andere vorm van verantwoordelijkheid draagt voor een activiteit die plaatsvindt,voor het bestaan van een entiteit of voor de activiteit van een andere agent."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
