          "@value": "Zaak"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een zaak is het geheel aan werk gedaan om tot een bestuurlijke of zakelijke beslissing te komen. Een zaak slaat doorgaans neer in een verzameling documenten."
        }
      ],
