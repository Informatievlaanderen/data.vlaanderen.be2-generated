  "classes": [
    {
      "@id": "urn:oslo-toolchain:98099f58865e20a18b05db30d7b3a846d8415da920a3413a5d37dd3ff7dc3a2b",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Wegsignalisatie aangebracht op een element op het openbaar domein (paal, gevel, portiek...) om het verkeer op de openbare weg te regelen en die geen verkeerslicht of wegmarkering zijn."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Verkeersbord",
      "diagramLabel": [
        {
          "@value": "Verkeersbord"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:74a19680a00c44e20b225bccc75a930615779ff076bacbde1cb4954e805d4f72"
        },
