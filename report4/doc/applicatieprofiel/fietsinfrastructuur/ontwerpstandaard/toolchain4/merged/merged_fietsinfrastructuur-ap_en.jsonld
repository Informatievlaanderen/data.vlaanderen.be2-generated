    {
      "@id": "urn:oslo-toolchain:4b7881aadd53b5ecf4c0c527c64ede1432d275fdc5dc974b2932baf544a200fb",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Richting van de link waarop de referentie van toepassing is."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb is de snelheidsbeperking geldig voor de ene richting of voor de andere of in beide richtingen. Om de ene richting te onderscheiden van de andere staat \"gelijklopend\" voor de richting die gelijkloopt met de digitalisatierichting van het lineair netwerkelement en \"tegengesteld\" voor de richting die tegengesteld is aan de digitalisatierichting. In het geval de referentie niet slaat op de richting van de link, maar op een fenomeen langs de link (bvb een fietspad of straatverlichting), komt \"gelijklopend\" overeen met de rechterkant en \"tegengesteld\" met de linkerkant."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/netwerk#toepassingsrichting",
      "diagramLabel": [
