        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:74a19680a00c44e20b225bccc75a930615779ff076bacbde1cb4954e805d4f72",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Materieel onderdeel van een infrastructuur."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Hier gaat het over elementen van een fietsinfrastructuur zoals een verkeerslicht voor fietsers of een Fietsstalling en in principe ook de wegbaan waarover kan worden gefietst. Een infrastructuur kan ook niet-materiële aspecten hebben, bvb Verkeersintensiteit of RichtingVerkeer. Tussen beide bestaat een verband, bvb ToegestaneSnelheid (een eigenschap) en de Verkeersborden om die af te dwingen (Infrastructuurelementen). Van de wegen zelf wordt typisch het niet-materiële aspect voorgesteld, dus niet de wegbaan maar het transportnetwerk dat ze vormen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infrastructuurelement",
      "diagramLabel": [
        {
          "@value": "Infrastructuurelement"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:c1a31d58e7da091d9e99366ab2917d0e818df1684e869cc6f519282ae1ecfc33"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Infrastructuurelement"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:6b1f5a188a0402a85262d2c518977c1130e5242c7dc648c645846ec823aa0735",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het geheel aan palen en/of verankeringspunten van een constructie bestemd voor het vastmaken van fietsen."
        },
