    {
      "@id": "urn:oslo-toolchain:cd93d6b6acdc0004e74ddfddf0729f26cdb2bc0dec9c2f8807ebbda9689dbdbf",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/gebouw#Gebouw",
