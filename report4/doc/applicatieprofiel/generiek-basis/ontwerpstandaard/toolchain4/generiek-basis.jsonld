      "assignedURI": "https://data.vlaanderen.be/ns/generiek#perSetpositie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "per setpositie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "perSetpositie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "N-de keer dat iets plaatsvindt uit de verzameling van mogelijke tijdstippen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bv als iets maandelijks plaatsvindt op maandag om te zeggen dat het bv de eerste maandag is vd maand. Frequentie is dan maandelijks, perDag is Maandag en de perSetpositie is dan 1. Ook negatieve cijfers zijn mogelijk, bv -1 zou aangeven dat het op de laatste maandag vd maand plaatsvindt."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:726cb75d16baed32a29185149b3d1c5480d82d845f3e4066ae0f3aefbc0df77e"
