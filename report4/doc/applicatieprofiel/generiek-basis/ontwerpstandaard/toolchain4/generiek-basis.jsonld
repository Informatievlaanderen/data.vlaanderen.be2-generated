      "@id": "urn:oslo-toolchain:8bb021fe416038ac2fe24eab4bf36b229940bb93d2f4dc47358e7a4bd2d7ec41",
      "@type": "Datatype",
      "assignedURI": "https://schema.org/QuantitativeValue",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kwantitatieve Waarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KwantitatieveWaarde"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bv de hoogte van een object,het gewicht,de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog,laag ed vallen hier dus niet onder."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/conceptscheme/ZonderStatus"
    },
    {
      "@id": "urn:oslo-toolchain:c4c6cb29358f99700aedca9548ed2ff86a689a4a555db81ae3060e28980ab012",
      "@type": "Datatype",
      "assignedURI": "http://www.opengis.net/ont/sf#LineString",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Lijnstring"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LijnString"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Curve met lineaire interpolatie tussen de punten. Elk opeenvolgend paar punten vormt een lijnsegment. De lijnstring heeft ten minste twee punten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een curve is een 1-dimensioneel geometrisch object gedefinieerd als een sequentie van punten. De interpolatie kan op verschillende manieren gebeuren (bv lineair bij een lijnstring)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:fbeb17d98378782b9e09a46d7da8fc82a798572cfdd429894e125682e097273c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/conceptscheme/ZonderStatus"
    },
    {
      "@id": "urn:oslo-toolchain:ecb0f61d23d4d5afe6341f17bca2c7bf1658adf82e29076fc7a5bf934d794916",
