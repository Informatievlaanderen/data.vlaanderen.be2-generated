      ],
      "diagramLabel": [
        {
          "@value": "Creatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het voltooien vd productie ve nieuwe entiteit dmv een activiteit."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De entiteit bestond niet voorafgaand aan de creatie en is daarna beschikbaar voor gebruik."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/conceptscheme/ZonderStatus"
    },
