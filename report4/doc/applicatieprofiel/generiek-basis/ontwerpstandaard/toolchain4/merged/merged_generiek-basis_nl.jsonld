      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hoedanigheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Hoedanigheid"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Agent met een Functie."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Laat een Functie toe om te handelen, bv ihkv een Dienstverlening (bv diversiteitsplan wordt opgemaakt door diverseteitsambtenaar)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
