    {
      "@id": "urn:oslo-toolchain:f15e3727395648ca559acdc4451e157f7fbb2d1748c487ed63763972dc1cf0bc",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon",
