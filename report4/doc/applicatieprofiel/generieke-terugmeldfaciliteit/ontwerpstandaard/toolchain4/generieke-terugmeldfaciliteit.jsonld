          "@value": "GeregistreerdPersoon"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon waarvan de gegevens zijn ingeschreven in een register."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb naam en voornaam) en de Verblijfplaats vd persoon en op belangrijke levensgebeurtenissen zoals geboor"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
