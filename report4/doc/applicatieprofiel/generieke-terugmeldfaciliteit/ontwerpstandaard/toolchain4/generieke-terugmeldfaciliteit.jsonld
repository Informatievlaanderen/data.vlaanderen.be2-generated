      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het Meldingsobject identificeert een resource,een specifiek deel van een resource,een bepaalde representatie van een resource of een combinatie hiervan welke gebruikt wordt binnen de Melding."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het Meldingsobject identificeert een resource,een specifiek deel van een resource,een bepaalde representatie van een resource of een combinatie hiervan welke gebruikt wordt binnen de Melding."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het model beschrijft geen attributen voor het Meldingsobject. In de praktijk kan het Meldingsobject beschreven worden aan de hand van instanties van de klasse Eigenschap."
