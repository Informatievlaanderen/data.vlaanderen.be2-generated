        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De nauwkeurigheid waarmee objecten opgemeten worden hangt af van de meetmethode (terrestrisch of via luchtfotogrammetrie) en van de precisie waarmee objecten op het terrein kunnen aangeduid worden. Het GRB definieert 6 nauwkeurigheidsklassen van A tot en met F. Daarnaast werden op basis van het IMKL datamodel ook nog de waarden 'tot 50cm' en 'tot 100cm' opgenomen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
