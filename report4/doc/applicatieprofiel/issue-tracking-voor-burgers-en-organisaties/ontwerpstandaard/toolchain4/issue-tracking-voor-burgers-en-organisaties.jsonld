    },
    {
      "@id": "urn:oslo-toolchain:a2b165b404d158f723cb596aabfff6f56cc4f0873b2d65bf95b9082f273b60b2",
      "@type": "Class",
      "assignedURI": "https://www.w3.org/ns/org#Organization",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Organisatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Organisatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaanreden die de individuele leden ervan overstijgt en kan handelen als Agent. Een organisatie heeft dikwijls een hiërarchische structuur."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:df2b599df36e5aaa38a946f4ab7ff13ef5c1fac7b7c8c57fd805284adc2156fa"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:378b044bd5628e603f54f1ba57f50770ec3de871f7e5fe36ee800f7fb53f7328",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#OrganizationalUnit",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Organisatie-eenheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "OrganisatieEenheid"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een organisatie zoals een afdeling of dienst die deel uitmaakt van de grotere organisatie en zijn bestaansreden daaraan ontleent. Heeft geen juridische status op zich."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a2b165b404d158f723cb596aabfff6f56cc4f0873b2d65bf95b9082f273b60b2"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:cc691464591aa1a98388e7c99ab3c6e3d7808644fa44f04c53e6ff3324454a15",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/PublicOrganisation",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Publieke Organisatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PubliekeOrganisatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector,ongeacht het bestuursniveau waarop dat kader van kracht is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a2b165b404d158f723cb596aabfff6f56cc4f0873b2d65bf95b9082f273b60b2"
        }
      ],
