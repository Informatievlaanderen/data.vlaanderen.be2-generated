    {
      "@id": "urn:oslo-toolchain:7f5b56f0f39bb2462b11d7933fcbdfc420f614f3f525db93126a0b18df6b7d65",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/melding#Melding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Melding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Melding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijft de melding van een probleem of een vaststelling die mogelijks aanleiding geeft tot een actie van de overheid."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijft de melding van een probleem of een vaststelling die mogelijks aanleiding geeft tot een actie van de overheid."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Een melding kan gebruikt worden voor vaststellingen in de echte wereld,bijvoorbeeld het melden van een put in de weg of sluikstort,of voor het melden van fouten of onvolledigheden in digitale gegevensbronnen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De Melding kan gebruikt worden voor het capteren van feedback dat slaat op reële wereld objecten zoals een put in de weg of sluikstort."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:bbc206de98de853661cd793b1313eba106b20df354e38806d5de3210f617d39e",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/organisatie#Hoedanigheid",
      "vocLabel": [
        {
