      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Element in een Nutsvoorzieningnetwerk dat daarin een functie van belang vervult."
        },
        {
          "@language": "en",
          "@value": "Abstract base type representing an utility network element in an utility network. Every element in an utility network provides some function that is of interest in the utility network."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Element in een Nutsvoorzieningnetwerk dat daarin een functie van belang vervult."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "OPMERKING: is abstract, moet gespecialiseerd worden (bvb als Electriciteitskabel, Riooolpijp, Mangat, Kast etc)."
        },
        {
          "@language": "en",
          "@value": "NOTE: is abstract, must be specialized (For example as Electricity Cable, Sewer, Manhole, Cabinet etc)."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
