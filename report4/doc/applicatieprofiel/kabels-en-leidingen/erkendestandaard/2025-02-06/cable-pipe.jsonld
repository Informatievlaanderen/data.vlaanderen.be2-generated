      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Puntvormig ruimtelijk object dat een rol van belang vervult in een Nutsvoorzieningnetwerk."
        },
        {
          "@language": "en",
          "@value": "Point-shaped spatial object that plays an important role in a Utility Network."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Puntvormig ruimtelijk object dat een rol van belang vervult in een Nutsvoorzieningnetwerk."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan op zichzelf staan of begin of einde vormen van een Nutsvoorzieninglink. OPMERKING: is abstract, moet verder gespecialiseerd worden als Toebehoren of een subklasse daarvan."
        },
        {
          "@language": "en",
          "@value": "Can stand alone or form beginning or end of a Utility Link. NOTE: is abstract, should be further specialised as Appurtenance or a subclass thereof."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
