    {
      "@id": "urn:oslo-toolchain:93b037b054f6fa763958254386a03a25628699597d9a4873c83b4571af3cf8f4",
      "@type": "Class",
      "assignedURI": "https://vocab.belgif.be/ns/generic#ActivityComplex",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Activiteitencomplex"
        },
        {
          "@language": "en",
          "@value": "Activity Complex"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Activiteitencomplex"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Activiteitencomplex"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Technical and economic unit managed by the same operator where certain activities regarding production and services take place."
        },
        {
          "@language": "nl",
          "@value": "Technische en economische eenheid beheerd door eenzelfde operator waar bepaalde activiteiten plaatsvinden mbt productie en dienstverlening."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Technische en economische eenheid beheerd door eenzelfde operator waar bepaalde activiteiten plaartsvinden mbt productie en dienstverlening."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In praktijk een site, plot, faciliteit, installatie, gebouw waar de activiteit plaatsvindt. In de context van kabels en leidingen gaat het over bvb een electriciteitscentrale, een pompstation, een zuiveringsinstallatie etc. Omvat de infrastructuur, uitrusting en het materieel die daar voor nodig is. Kan meerdere locaties omvatten voor zover deze deel uitmaken van hetzelfde complex. De activiteit wordt bij voorkeur aangeduid dmv NACE codes."
        },
        {
          "@language": "en",
          "@value": "In practice, a site, plot, facility, installation, building where the activity takes place. In the context of cables and pipes, it refers to For example a power plant, a pumping station, a sewage treatment plant, etc. Includes the infrastructure, equipment and material required for it. May include several sites as long as they are part of the same complex. The activity is preferably identified by NACE codes."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In praktijk een site, plot, faciliteit, installatie, gebouw waar de activiteit plaatsvindt. In de context van kabels en leidingen gaat het over bvb een electriciteitscentrale, een pompstation, een zuiveringsinstallatie etc. Omvat de infrastructuur, uitrusting en het materieel die daar voor nodig is. Kan meerdere locaties omvatten voor zover deze deel uitmaken van hetzelfde complex. De activiteit wordt bij voorkeur aangeduid dmv NACE codes."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
