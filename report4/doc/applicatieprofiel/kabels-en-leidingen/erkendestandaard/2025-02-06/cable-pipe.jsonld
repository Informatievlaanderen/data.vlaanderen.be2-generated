        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een onvertakt doorlopend pad in het Nutsvoorzieningnetwerk."
        },
        {
          "@language": "en",
          "@value": "An unbranched continuous path in the Utility Network."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een onvertakt doorlopend pad in het Nutsvoorzieningnetwerk."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In feite een route in het netwerk, bvb een waterleiding in de stroomrichting. Routes hebben een richting, daarom is de Linksequentie samengesteld uit GerichteLinks."
        },
        {
          "@language": "en",
          "@value": "In fact, a route in the network, for example a water pipe in the flow direction. Routes have a direction, which is why the Link Sequence is composed of Directed Links."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
