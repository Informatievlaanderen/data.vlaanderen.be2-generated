      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Collectie lineaire ruimtelijke objecten met een specifieke functie of belang in het Nutsvoorzieningnetwerk."
        },
        {
          "@language": "en",
          "@value": "An abstract utility network class which groups common properties of Cable, Pipe and Duct featureTypes."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Collectie lineaire ruimtelijke objecten met een specifieke functie of belang in het Nutsvoorzieningnetwerk."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In praktijk een collectie van Nutsvoorzieninglinksequenties en/of Nutsvoorzieninglinks. OPMERKING: is abstract, moet verder gespecialiseerd worden bvb als Electriciteitskabel, Rioolpijp etc."
        },
        {
          "@language": "en",
          "@value": "This class also extends the Link Set featureType, which allows Cable, Pipe and Duct classes to use either the (more complex) Link Sequence or (more simple) Link class."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In praktijk een collectie van Nutsvoorzieninglinksequenties en/of Nutsvoorzieninglinks. OPMERKING: is abstract, moet verder gespecialiseerd worden bvb als Electriciteitskabel, Rioolpijp etc."
        }
      ],
