      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een korte uitleg of notitie toegevoegd aan een Object."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze context typisch Maataanduiding op een kabel- of leidingenkaart, bvb de afstand van een kabel tov een gevel. Kan bestaan uit onderdelen (bvb maatvoeringslijn, maatvoeringshulplijn, twee pijlen) die op zich ook Annotaties zijn."
        },
        {
          "@language": "en",
          "@value": "In this context, typically a Dimension on a cable or pipe map, for example the distance of a cable to a facade. Can consist of parts (For example dimensioning line, dimensioning guideline, two arrows) that are also Annotations in themselves."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze context typisch Maataanduiding op een kabel- of leidingenkaart, bvb de afstand van een kabel tov een gevel. Kan bestaan uit onderdelen (bvb maatvoeringslijn, maatvoeringshulplijn, twee pijlen) die op zich ook Annotaties zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
