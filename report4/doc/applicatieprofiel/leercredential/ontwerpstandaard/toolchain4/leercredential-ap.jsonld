          "@language": "nl",
          "@value": "Toekenningsproces"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Toekenningsproces"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het proces waarbij een organisatie een leerprestatie toekent aan een persoon op basis van een leerspecificatie (bv. een kwalificatie). Het wordt gebruikt om de organisatie te specificeren die de leerspecificatie aan de persoon heeft toegekend, het land of de regio waar de leerspecificatie werd toegekend, en optioneel de datum van toekenning."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
