    {
      "@id": "urn:oslo-toolchain:92954bfae8c5a512c9af056935d5f90cc2b82589b7931b71944dc6df17fd2f57",
      "@type": "Class",
      "assignedURI": "https://data.europa.eu/snb/model#EuropeanDigitalCredential",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Europees Digitaal Credential"
        }
      ],
      "diagramLabel": [
        {
          "@value": "EuropeesDigitaalCredential"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een reeks beweringen die door een uitgever in Europa worden gemaakt, gebruikmakend van Europese standaarden. Een Europees Digitaal Credential is een reeks van een of meer beweringen die kunnen worden gebruikt om aan te tonen dat de eigenaar bepaalde vaardigheden bezit of bepaalde leeruitkomsten heeft bereikt door middel van formeel, niet-formeel of informeel leren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b1f2aa7d06e8e1e2154c657812ce480d8281bb80d4ae4bb3cca44b05a4d2f99e"
        },
        {
          "@id": "urn:oslo-toolchain:5007a5d7ca75216199bbdb1e40590d5ae26d05c0b310977be5baa8d08a65807b"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5007a5d7ca75216199bbdb1e40590d5ae26d05c0b310977be5baa8d08a65807b",
      "@type": "Class",
      "assignedURI": "https://w3.org/2018/credentials#VerifiableCredential",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verifieerbare Credential"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VerifieerbareCredential"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een verifieerbare credential is een fraudebestendige credential met auteurschap dat cryptografisch kan worden geverifieerd. Verifieerbare credentials kunnen worden gebruikt om verifieerbare presentaties te maken, die ook cryptografisch kunnen worden geverifieerd. De claims in een credential kunnen over verschillende onderwerpen gaan."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:0c6d4b61f9f14b31eef52940e8e0a91286d2ccbda8367e05c7f51f6ceed9c20d"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:4a67e7da37a8c7db0d1b5db78efa59ddd513faa91f50005b0f0ad351e8599b74",
      "@type": "Class",
      "assignedURI": "https://data.europa.eu/snb/model#LearningOutcome",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Leeruitkomst"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Leeruitkomst"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een verklaring over wat een leerling weet, begrijpt en kan doen na voltooiing van een leerproces, dat wordt gedefinieerd in termen van kennis, vaardigheden, verantwoordelijkheden en autonomie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
