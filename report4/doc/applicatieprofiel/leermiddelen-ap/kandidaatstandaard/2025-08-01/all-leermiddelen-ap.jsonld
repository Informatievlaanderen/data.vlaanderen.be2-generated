      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Elk hulpmiddel dat wordt ingezet om het leerproces te ondersteunen, doelen te bereiken en zo kennis, vaardigheden en attitudes bij te brengen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze definitie is een specificatie gebaseerd op de definitie van de kwaliteitsalliantie, i.e.: Het overkoepelende begrip voor zowel papieren als digitale producten, al dan niet in combinatie, ongeacht wie ze ontwikkelt: leraren, niet-commerciële en commerciële aanbieders."
        }
      ],
