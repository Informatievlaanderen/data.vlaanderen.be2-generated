      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De specificatie van een proces dat leidt tot het verwerven van kennis,vaardigheden of verantwoordelijkheid en autonomie."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De specificatie van een proces dat leidt tot het verwerven van kennis,vaardigheden of verantwoordelijkheid en autonomie."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het opleidingsaanbod geformaliseerd volgens een bepaalde specificatie,zoals de ECTS. Zowel een opleidingsonderdeel als een programma kunnen op deze manier gespecifieerd worden."
        }
      ],
