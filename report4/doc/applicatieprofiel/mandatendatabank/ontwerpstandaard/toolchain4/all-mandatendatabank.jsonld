    {
      "@id": "urn:oslo-toolchain:1f5d7e91222aec4a4db9cd28813604485861ccc114d1bb8dce3d44d3ef409634",
      "@type": "Class",
      "assignedURI": "http://data.vlaanderen.be/ns/mandaat#Fractie",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Parliamentary Group"
        },
        {
          "@language": "nl",
          "@value": "Fractie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Fractie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A parliamentary group is a part of a directly elected representative body whose members wish to work together on a substantive and logistical level. The formal framework defines who can form a parliamentary group, usually it consists of representatives representing the same political party or flow."
        },
        {
          "@language": "nl",
          "@value": "Een fractie is een deel van een rechtstreeks verkozen volksvertegenwoordigend orgaan waarvan de leden op inhoudelijk en logistiek vlak willen samenwerken. Het formeel kader bepaalt wie samen een fractie kan vormen, doorgaans bestaat ze uit volksvertegenwoordigers die tot dezelfde politieke partij of stroming behoren."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als Agent. Een organisatie heeft dikwijls een hiërarchische structuur."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:8c0476ec59238b69e396fe2b51dcf89e95fb1b40d0c55628e60971a885d0d40f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
