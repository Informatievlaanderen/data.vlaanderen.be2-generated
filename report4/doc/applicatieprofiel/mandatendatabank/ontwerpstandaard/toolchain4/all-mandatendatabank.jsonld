      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "The regulations,legal act and/or policy choice which (temporarily) appoints one or more mandates to a person starting from a specific date."
        },
        {
          "@language": "nl",
          "@value": "De regelgeving,rechtshandeling en/of beleidskeuze waardoor de invulling van een of meerdere mandaten door een persoon vanaf een bepaalde datum (tijdelijk) start."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
