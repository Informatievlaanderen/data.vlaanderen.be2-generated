    {
      "@id": "urn:oslo-toolchain:d88070ad4ae3d22153a7260421a479b03a800a92c3d08cd506585dbf69fda130",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 0-dimensionele geometrische primitieve in de tijd."
        },
        {
          "@language": "en",
          "@value": "A 0-dimensional geometric primitive in time."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Vergelijkbaar met een Punt in de ruimte, maar ipv een positie in een ruimtelijk referentiesysteem gaat het hier over een punt op de tijdsas. OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bv time:Instant uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."
        },
        {
          "@language": "en",
          "@value": "Similar to a Point in space, but instead of a position in a spatial reference system, this is about a point on the time axis. NOTE: More info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitution with a simpler equivalent e.g. time:Instant from the <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is recommended."
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Instant",
      "diagramLabel": [
        {
          "@value": "Moment"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Moment"
        },
        {
          "@language": "en",
          "@value": "Moment"
        }
      ]
    }
