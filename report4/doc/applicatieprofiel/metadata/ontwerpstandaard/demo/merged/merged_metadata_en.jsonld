      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Activiteit waarbij een FinancieelRapport officieel wordt ingediend."
        },
        {
          "@language": "en",
          "@value": "Activity in which a Financial Report is officially submitted."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Neerlegging"
        },
        {
          "@language": "en",
          "@value": "Filing"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat typisch om een wettelijke verplichting,bvb de Neerlegging van een Jaarrekening bij de Nationale Bank van België,bedoeld om inzicht te geven in de financiële positie van de Organisatie waarmee men omgaat."
        },
        {
          "@language": "en",
          "@value": "It is typically a legal obligation, e.g. the filing of annual accounts with the National Bank of Belgium, intended to provide insight into the financial position of the Organization with which one is dealing."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:5dd3fa1b34de93910bc1f602a4f3797f52b051a164c6a70e66c41546d182e944",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een organisatie heeft dikwijls een hiërarchische structuur."
        },
        {
          "@language": "en",
          "@value": "A number of people organized into a community or other social, commercial, or political structure. The group has a common goal or raison d'être that transcends its individual members and can act as an agent. An organization often has a hierarchical structure."
        }
      ],
      "assignedURI": "http://www.w3.org/ns/org#Organization",
      "diagramLabel": [
        {
          "@value": "Organisatie"
        }
      ],
