    {
      "@id": "urn:oslo-toolchain:7c4bf16d4f75d05b21a8f7f90de546e50c1041323c38022f51ad0ee16bedaabc",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Handeling waarbij een bepaalde Bemonsteringsprocedure wordt uitgevoerd om één of meer Bemonsteringsobjecten te bekomen of waarbij deze worden bewerkt."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Bemonstering"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bv het breken van een rotsmonster, het graven van een profielput, het verdelen van een site in kwadranten, bloed trekken bij een patient, een meetpunt opzetten voor bv milieumonitoring, een luchtfoto nemen, een bodemmonster zeven, een deelpopulatie selecteren, een boorkern bemonsteren etc."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://www.w3.org/ns/sosa/Sampling",
      "diagramLabel": [
        {
          "@value": "Bemonstering"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bemonstering"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:d0695cbacd454b369ad61e26cb1a35d45e9daef6f8dc9920fef4bb8bdf5305d0",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een workflow, protocol, plan, algoritme of berekeningswijze waarin wordt gespecifieerd hoe de Bemonstering moet worden uitgevoerd."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Bemonsteringsprocedure"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bv hoe boringen moeten plaatsvinden of peilbuizen moeten worden geplaatst of hoe precies bodem- of grondwaterstalen moeten worden genomen of bewerkt. De procedures zijn doorgaans bedoeld om bij meer dan één Bermonstering te worden toegepast."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://www.w3.org/ns/sosa/oms/SamplingProcedure",
      "diagramLabel": [
        {
          "@value": "Bemonsteringsprocedure"
        }
      ],
      "parent": [
