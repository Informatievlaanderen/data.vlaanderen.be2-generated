    {
      "@id": "urn:oslo-toolchain:6711682c64d8adf9d924a5e5e3d020a8cf32cd56ad224612b71fd2ba73e38688",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Willekeurig gegeven gassocieerd met het gebeuren van de Observatie."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat hier niet om kenmerken van het geobserveerdObject (die worden al beschreven door het geobserveerdKenmerk) of om parameters geassocieerd met het observatieproces (zoals een instelling van een instrument). Het gaat hier bv om omgevingsparameters die het resultaat kunnen beïnvloeden en van belang zijn om het resultaat correct te interpreteren.  Een voorbeeld is de diepte in een waterput waarop de waterkwaliteit is gemeten of de omgevingstemperatuur bij het meten van de vochtigheidsgraad."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://fixme.com/",
      "diagramLabel": [
        {
          "@value": "parameter"
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
      },
      "maxCount": "*",
      "minCount": "0",
      "range": {
        "@id": "urn:oslo-toolchain:5f3653b9cbfa0c903ccb29b79b4833b70e3b8e1e765b98566e74da8c1661286e"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "parameter"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:498956bda415cdc823c6f91b8ffa811739c528f7866777726d74a53e119cfbe0",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het moment waarop het resultaat van de Observatie van toepassing was."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch het moment waarop geobserveerd of bemonsterd werd. Als de Observatie temporeel is en het moment waarop iets plaatsvindt wordt geregistreerd dan is dit meteen ook de fenomeentijd."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://www.w3.org/ns/sosa/phenomenonTime",
      "diagramLabel": [
        {
          "@value": "fenomeentijd"
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
      },
      "maxCount": "1",
      "minCount": "1",
      "range": {
        "@id": "urn:oslo-toolchain:b57de249b37c0de681e1078697f10e5629f212bb3025b3946220720583cda3d3"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "fenomeentijd"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:cf6a3721123be992077d7e901c2e9314f4e77ff07629b6789da064f9c3380680",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Tijdstip waarop het resultaat van de Observatie werd bekomen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Is voor sommige Observaties gelijk aan de fenomeentijd maar kan ook verschillen, bv bij het uitvoeren van een analyse op een Monster dat eerder (en doorgaans dan ook eders) werd genomen of bij sensormetingen die pas later worden verwerkt. Ook bruikbaar om herhaalde Observaties bv op eenzelfde Monster uiteen te houden. Is het resultaat een voorspelling dan is de fenomeentijd het moment waarop deze van toepassing zou moeten zijn."
        },
