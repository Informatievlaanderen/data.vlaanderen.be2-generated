        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:c0ce6a9bae278b4ed5aa3c9ed27eadb582e88421b1dce791544f689d06e3d0e9",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Deel van het Object dat men wil observeren en dat representatief is voor dat Object."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Bemonsteringsobject"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het deel waarvan sprake kan fysiek zijn (een Monster) of ruimtelijk (een RuimtelijkBemonsteringsobject). Men observeert een Bemonsteringsobject ipv het werkelijk Object als dat laatste niet in zijn geheel geobserveerd kan worden (bv omdat exhaustieve observatie onpraktisch zou zijn). Het Bemonsteringsobject vormt samen met het Proces dat voor observatie is gebruikt het zgn observatieprotocol. OPGELET: deze klasse is abstract, ze moet gespecialiseerd worden in functie van het applicatiedomein."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://www.w3.org/ns/sosa/Sample",
      "diagramLabel": [
        {
          "@value": "Monster"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:28436ca796dc7b47d128ca145c32da19b0da42134c61e10b67d1acbccd9d294e"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bemonsteringsobject"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:28436ca796dc7b47d128ca145c32da19b0da42134c61e10b67d1acbccd9d294e",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Klasse die instanties van om het even welk type vertegenwoordigt."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van Observaties en Metingen is dit het geobserveerdObject waarvan een kenmerk wordt geobserveerd. Het geobserveerdObject kan ook een Object zijn dat de werkelijkheid bemonstert (subklasse Bemonsteringsobject). OPGELET: deze klasse is abstract, ze moet gespecialiseerd worden in functie van het applicatiedomein."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
