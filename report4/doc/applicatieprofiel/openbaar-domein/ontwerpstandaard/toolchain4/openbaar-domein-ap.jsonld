          "@value": "talud"
        }
      ],
      "diagramLabel": [
        {
          "@value": "talud"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een talud is het kunstmatig gedeelte van een vlak van de wegbaan, dijken, spoorbanen, vestingswerken, ... dat een helling (min. 20%, max 80% voor kunstmatig verharde taluds) vertoont en bedoeld voor het opvangen van een hoogteverschil."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een talud is het kunstmatig gedeelte van een vlak van de wegbaan, dijken, spoorbanen, vestingswerken, ... dat een helling (min. 20%, max 80% voor kunstmatig verharde taluds) vertoont en bedoeld voor het opvangen van een hoogteverschil."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Naar GRB-skeletaanvulling detail - WTO1: Teen verharde talud; WTO2: Kruin verharde talud; WTO3: Teen onverharde talud; WTO4: Kruin onverharde talud"
        }
      ],
      "apUsageNote": [
