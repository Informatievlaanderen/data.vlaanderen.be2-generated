      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het type nutsvoorzieningnetwerk of het thema van het nutsvoorzieningnetwerk."
        },
        {
          "@language": "en",
          "@value": "The type of utility network or the utility network theme."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het type nutsvoorzieningnetwerk of het thema van het nutsvoorzieningnetwerk."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "en",
          "@value": "Uses the Utility Network Type code list to describe the possible utility networks. This also includes the 'crossTheme' value to be used for utility networks that may contain cables or pipes from different themes, typically used by utility network providers that supply pipes."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Gebruikt de codelijst \"Nutsvoorzieningnetwerktype\" om de mogelijke nutsvoorzieningnetwerken te beschrijven. Dit bevat ook de waarde 'crossTheme' die moet worden gebruikt voor nutsvoorzieningnetwerken die kabels of leidingen uit verschillende thema's kunnen bevatten, die doorgaans worden gebruikt door aanbieders van nutsvoorzieningnetwerken die leidingen leveren."
        }
      ],
