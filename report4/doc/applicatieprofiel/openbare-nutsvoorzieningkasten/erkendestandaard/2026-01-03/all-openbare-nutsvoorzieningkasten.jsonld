      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Capaciteiten ve Systeem."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Slaat op zaken als Meetbereik, Nauwkeurigheid, Afwijking, Resolutie, Responstijd etc. en de eventuele Condities waaronder die specificaties gelden, bv een Nauwkerigheid van 1mm is gegarandeerd voor afstanden onder de 100meter."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
