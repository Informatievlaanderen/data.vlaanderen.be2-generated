          "@value": "StopzettingType"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Reden waarom een Organisatie is stopgezet."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: pensionering, faillissement, …"
        }
      ],
