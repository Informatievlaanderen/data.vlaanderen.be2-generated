    },
    {
      "@id": "urn:oslo-toolchain:706d3d5267a24496125b987d1005965dcc8513755ade19c33c8f063490c8e393",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#ChangeEvent",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Veranderingsgebeurtenis"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Veranderingsgebeurtenis"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis waardoor een Organisatie een belangrijke wijziging ondergaat zoals een fusie of een herstructurering."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Is bedoeld voor situaties waarbij de de resulterende Organisatie zodanig verschilt van de oorspronkelijke dat ze beschouwd kan worden als een nieuwe Organisatie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpdocumentInOntwikkeling"
    },
    {
      "@id": "urn:oslo-toolchain:b87b2ef5477c603c863706951a90a4fadcc9d3612a642f8d484bf4ad3ebaa369",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#FormalOrganization",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "FormeleOrganisatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "FormeleOrganisatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een erkende Organisatie, erkend in brede zin of  meer specifiek in juridische zin met bijbehorende rechten en plichten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld een bedrijf, een vzw, een overheidsorgaan, een kerkgemeenschap."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6904f7825bae92c50503930e955bab6f5ba0012723ee041c9d79b168b574f5ba"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpdocumentInOntwikkeling"
    },
    {
      "@id": "urn:oslo-toolchain:6904f7825bae92c50503930e955bab6f5ba0012723ee041c9d79b168b574f5ba",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Organization",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Organisatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Organisatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een Organisatie heeft dikwijls een hiërarchische structuur."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpdocumentInOntwikkeling"
    },
    {
      "@id": "urn:oslo-toolchain:f8fc7ebd318f31d8af4d31257fe95687a7323c90a0c566780ab52ce6d021eb7c",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Site",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Vestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Vestiging"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een kantoor of ander pand waar een Organisatie gevestigd is. Organisaties kunnen over meerdere Vestigingen verspreid zijn en Vestigingen kunnen op meerdere locaties slaan."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Meestal zal de Vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten, bijvoorbeeld een virtueel kantoor met bijbehorend postnummer en telefonische receptie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpdocumentInOntwikkeling"
    },
    {
      "@id": "urn:oslo-toolchain:8c8c33a2e48e5662c4bed691f7ec59582d3ebe2ddf18fc8ace76f6180dc7a015",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Membership",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Lidmaatschap"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Lidmaatschap"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Geeft de kenmerken weer vh lidmaatschap van een agent van een organisatie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpdocumentInOntwikkeling"
    },
    {
      "@id": "urn:oslo-toolchain:a2dbb5c86bd9e33997a65f7c973b10e6bb79d52268c9bb646fb2b9cb018d6cfc",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "diagramLabel": [
        {
          "@value": "Rechtspersoonlijkheidtype"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aard van de rechtspersoonlijkheid."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Rechtspersoonlijkheid betekent dat men een rechtssubject is, dit wil zeggen drager van rechten en plichten. Natuurlijke personen hebben vanzelf rechtspersoonlijkheid, rechtspersonen (bijvoorbeeld venootschappen) moeten die van rechtswege toegekend krijgen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpdocumentInOntwikkeling"
    },
