      "diagramLabel": [
        {
          "@value": "Positie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Functie binnen een organisatie, kan bestaan los vd persoon of personen die ze invult."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Laat ook toe om ambsthalve posities weer te geven. Zo is een minister automatisch lid vd regering,ongeacht door welke persoon deze functie wordt uitgeoefend."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpdocumentInOntwikkeling"
    },
