  "classes": [
    {
      "@id": "urn:oslo-toolchain:37758f620570ae3250e13327509c97bb62f84fdf4e5afbb1e44106694d9a7e77",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/organisatie#Splitsing",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Splitsing"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Splitsing"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis waarbij uit één Organisatie twee Organisaties worden gevormd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
