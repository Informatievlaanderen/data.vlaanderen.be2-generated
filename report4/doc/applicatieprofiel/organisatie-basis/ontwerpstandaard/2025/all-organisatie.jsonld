          "@value": "Lidmaatschap"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Geeft de kenmerken weer van het Lidmaatschap van een Agent van een Organisatie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
