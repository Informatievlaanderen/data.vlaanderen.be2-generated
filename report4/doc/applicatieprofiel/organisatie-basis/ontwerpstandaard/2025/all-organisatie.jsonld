    {
      "@id": "urn:oslo-toolchain:8efe4d2e55ae333e5eea4a43336168a028c18fa467255b54c301a5b0f436a3b9",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Site",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Vestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Vestiging"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een kantoor of ander pand waar een Organisatie gevestigd is. Organisaties kunnen over meerdere Vestigingen verspreid zijn en Vestigingen kunnen op meerdere locaties slaan."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Meestal zal de Vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten, bijvoorbeeld een virtueel kantoor met bijbehorend postnummer en telefonische receptie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:4842f50f60e07dd0cf376158a4e474e5cdce07e15353211c98cc558bb3d555d1"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpdocumentInOntwikkeling"
    },
    {
      "@id": "urn:oslo-toolchain:6c73b2530500041cff053065297e0184f27db76637fe7f6fb509003fc9a04f96",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#OrganizationalCollaboration",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Samenwerkingsverband"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Samenwerkingsverband"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Samenwerking tussen twee of meer Organisaties bijvoorbeeld voor een project."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Is normaal gezien geen formele organisatie en ook geen organisatie-eenheid. Heeft doorgaans een kortere levensduur dan de organisaties in het verband. Alternatieve benamingen: project, consortium."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
