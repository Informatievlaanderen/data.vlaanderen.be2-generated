    {
      "@id": "urn:oslo-toolchain:c8bc6b8e4d980ce3000fdfb3972dbd45392f8550c4f5bb8a9ddc1f8765179650",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#TijdelijkInwoner",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "TijdelijkInwoner"
        }
      ],
      "diagramLabel": [
        {
          "@value": "TijdelijkInwoner"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon die tijdelijk in een plaats of land woont."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Is een verblijfsrecht dat in principe enkel wordt toegekend omwille van een zeer specifieke reden bijvoorbeeld werken of studeren. Exclusief personen met kort verblijf, bijvoorbeeld als toerist."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:9ef40bef48619d7b0f9e59ff9b5b67d87ae63f8dfe784d628dfa997173834ab5"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e0a011e671dd27d6931466814c46a0971056905eb38b0f2fd1fe0b6e9ad0765a",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Afstamming",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Afstamming"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Afstamming"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Afstamming is de dalende lijn van bloedverwantschap tussen verschillende generaties."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De afstamming kan ook niet-biologisch zijn, bijvoorbeeld adoptie. Afstamming kan ook in opgaande lijn worden bekeken. Het begrip is enger dan verwantschap dat onder andere ook Huwelijk inhoudt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:222510f99c43dea02ae1b181756d194d46ffca2a6bea6b51a02b625ef6606f5a"
        }
      ],
