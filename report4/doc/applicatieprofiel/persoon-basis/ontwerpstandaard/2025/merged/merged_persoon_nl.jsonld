          "@id": "urn:oslo-toolchain:8739004dc9dd396cd4fcce65c585a46f9364b107ef2cf44a7eb376ecec18bdb6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
