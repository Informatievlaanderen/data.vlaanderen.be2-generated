    {
      "@id": "urn:oslo-toolchain:93c7a1658c710bbdcecf5baefebe58bd2dbcf20839e029e55f4a9c0c01830cad",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Vreemdeling",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vreemdeling"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Vreemdeling"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon die niet de Nationaliteit bezit van het land waar hij verblijft."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Daardoor kan de Persoon geen Staatsburger worden genoemd. In praktijk geniet de Vreemdeling als Inwoner een subset van de burgerrechten die een Staatsbutger wel heeft. Bijvoorbeeld wel godsdienstvrijheid maar geen stemrecht."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:f04f1c41c4a5e33a1779a76ea2dac7091917c15316896211113295ed1a411bcf"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f04f1c41c4a5e33a1779a76ea2dac7091917c15316896211113295ed1a411bcf",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Staatsburgerschap",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Staatburgerschap"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Staatsburgerschap"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Juridische band van een Persoon met een staat, waaraan bepaalde rechten en plichten verbonden zijn."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Vloeit meestal voort uit de Nationaliteit van een Persoon. De rechten en plichten waarvan sprake zijn burgerrechten (bijvoorbeeld godsdienstvrijheid) of van politieke (bijvoorbeeld stemrecht) of sociale aard (bijvoorbeeld recht op een uitkering)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
