        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een Agent is verantwoordelijk voor een bepaalde Activiteit, bestaan van een Object, of een Activiteit van een andere Agent."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
