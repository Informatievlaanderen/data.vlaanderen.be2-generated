        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:b4d3edc2d5cae39bd9884e0cfabf1c2f5ff219be6e7cc784c3c2254ba0dd0a11",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Huwelijk",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Huwelijk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Huwelijk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een door burgerlijk of religieus recht geregelde samenlevingsvorm van twee personen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan, net als bijvoorbeeld Samenwonen, de basis vormen van een Gezin."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:af47e72f4d91d3656c3d823cf640f006917f4cda00bf2b1b43c4872dc6739c03"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:768d7a2e6bd15184f32d54cff090b639edff403f94e348990cb7cd3b7b214b40",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Nationaliteit",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Nationaliteit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Nationaliteit"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De relatie tussen een Persoon en een staat, cultuur, of loyaliteit."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Merk op dat dit begrip ruimer is dan Staatsburgerschap (dat zich beperkt tot de relatie met een staat). Wie de nationaliteit ve bepaald land heeft is er doorgaans ook automatisch Staatsburger van. Nationaliteit wordt doorgaans automatisch verkregen door geboorte: men krijgt hetzij de nationaliteit van zijn ouders of men krijgt deze vh land waar men Inwoner van is. Men kan een bepaalde nationaliteit ook verkrijgen door naturalisatie. In principe verliest men dan zijn oorspronkelijke nationaliteit, maar dat is niet altijd zo (meervoudige nationaliteit)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:2aef05d2f4ca8a378b7d32e3bd7263d09ff062912c665f3874e81183c63fbd29"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8d5271dc6eb66636909302b39a25d421342eedf817b4a8eb768706d10b9f2d13",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Samenwonen",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Samenwonen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Samenwonen"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Regeling waarbij twee personen die niet getrouwd zijn samenleven."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan, net als bijvoorbeeld een Huwelijk, de basis vormen van een Gezin."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:af47e72f4d91d3656c3d823cf640f006917f4cda00bf2b1b43c4872dc6739c03"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:049f67bada60371d33ced22151c1239e736d13f3d6bfbb6150c4b730e843d802",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "GeregistreerdPersoon"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GeregistreerdPersoon"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon waarvan de gegevens zijn ingeschreven in een register."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb naam en voornaam) en de Verblijfplaats vd persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:8d4ae396a7accda1df0e7980384187a50011bf1c4cec77a3d1962d7a9ca64303"
        },
        {
          "@id": "http://www.w3.org/ns/person#Person"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:b8252e149a7aed49717b2a6a54b2d61eea6b3f9ef9e032b01d03f37a5547f0d0",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Domicilie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Domicilie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Domicilie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Hoofdverblijfplaats van een Persoon."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Plaats waar de Persoon het grootste deel van de tijd verblijft binnen de jurisdictie waarvan hij Inwoner is. Dit wordt doorgaans officieel vastgesteld en geregistreerd ih bevolkingsregister. Kan in praktijk verschillend zijn van de feitelijke verblijfplaats."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6dfd1ee16286d327f5a76f4fc402f9fd2d24ab0957b4abcc32f9e8ba86eca19f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
