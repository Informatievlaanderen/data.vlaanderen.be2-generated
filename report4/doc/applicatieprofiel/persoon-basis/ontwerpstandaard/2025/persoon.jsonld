    {
      "@id": "urn:oslo-toolchain:ddcd65b815f8ea0e8486f6d67ca0994f74698640ad02520b7934ab872f12a970",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/prov#Agent",
