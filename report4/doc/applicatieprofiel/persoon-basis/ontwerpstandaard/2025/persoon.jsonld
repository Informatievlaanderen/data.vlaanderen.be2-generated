    {
      "@id": "urn:oslo-toolchain:93eb7c49b25d1f8bb0d7604ad280725ee0a5bf9a3d8caa523b61615ed3b6bf67",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Vreemdeling",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vreemdeling"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Vreemdeling"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon die niet de Nationaliteit bezit van het land waar hij verblijft."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Daardoor kan de Persoon geen Staatsburger worden genoemd. In praktijk geniet de Vreemdeling als Inwoner een subset van de burgerrechten die een Staatsbutger wel heeft. Bijvoorbeeld wel godsdienstvrijheid maar geen stemrecht."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:808934e052b26454ab8cedcf869096939245985912303243ac395edd7ddb0349"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:808934e052b26454ab8cedcf869096939245985912303243ac395edd7ddb0349",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Staatsburgerschap",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Staatburgerschap"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Staatsburgerschap"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Juridische band van een Persoon met een staat, waaraan bepaalde rechten en plichten verbonden zijn."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Vloeit meestal voort uit de Nationaliteit ve Persoon. De rechten en plichten waarvan sprake zijn burgerrechten (vb godsdienstvrijheid) of van politieke (vb stemrecht) of sociale aard (bv recht op een uitkering)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
