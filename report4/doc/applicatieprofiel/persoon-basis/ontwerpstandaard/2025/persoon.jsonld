    {
      "@id": "urn:oslo-toolchain:2716f3c11bbe94f00564ee2042dbda47ebab217bf6b83026d33efffe51fc00c1",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Samenwonen",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Samenwonen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Samenwonen"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Regeling waarbij twee personen die niet getrouwd zijn samenleven."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan, net als bijvoorbeeld een Huwelijk, de basis vormen van een Gezin."
        }
      ],
