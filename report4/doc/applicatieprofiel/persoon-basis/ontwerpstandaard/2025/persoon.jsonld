    {
      "@id": "urn:oslo-toolchain:bd9a03b58e86e6cdd804e4e305a027b6b127aae86ab6177ae08aa8c6f031e219",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#TijdelijkInwoner",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "TijdelijkInwoner"
        }
      ],
      "diagramLabel": [
        {
          "@value": "TijdelijkInwoner"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon die tijdelijk in een plaats of land woont."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Is een verblijfsrecht dat in principe enkel wordt toegekend omwille van een zeer specifieke reden bijvoorbeeld werken of studeren. Exclusief personen met kort verblijf, bijvoorbeeld als toerist."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10bd159080a1febc9e455350c52ae068ab1f31718ba5566977242209b24eec91"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:3062fa9c948837f594bb3c79ffbf495fa3eb724537c3821edb05b36e84c72bfb",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Afstamming",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Afstamming"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Afstamming"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Afstamming is de dalende lijn van bloedverwantschap tussen verschillende generaties."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De afstamming kan ook niet-biologisch zijn, bijvoorbeeld adoptie. Afstamming kan ook in opgaande lijn worden bekeken. Het begrip is enger dan verwantschap dat onder andere ook Huwelijk inhoudt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:52c5b2cf2888c526d591b378496153e5441800f30f1935fce3b6b8c44de5e61b"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
