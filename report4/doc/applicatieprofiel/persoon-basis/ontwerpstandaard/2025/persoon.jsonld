          "@value": "Voogdij"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Situatie waarbij een Persoon die optreedt als voogd van een ander Persoon en in die hoedanigheid instaat voor deze Persoon en zijn goederen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is bijvoorbeeld het geval voor minderjarigen die hun ouders zijn verloren of voor meerderjarigen die hun verstandelijke vermogens zijn verloren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
