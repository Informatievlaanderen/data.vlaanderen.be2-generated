      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Plaats waar een Persoon al dan niet tijdelijk woont of logeert."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
