    {
      "@id": "urn:oslo-toolchain:31fc94cd5e4d4aa7e82cfc236a5871373ce3e764508b2a099729a2e9e7bb71f8",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#TijdelijkInwoner",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "TijdelijkInwoner"
        }
      ],
      "diagramLabel": [
