        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e6c52f626b0e3a4d665f20449186e5d7f14703d045ac986bc2d0efeac45a1efb",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/prov#Agent",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Agent"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Agent"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een Agent is verantwoordelijk voor een bepaalde Activiteit, bestaan van een Object, of een Activiteit van een andere Agent."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te vervangen door een niet-abstracte klasse."
        }
      ],
