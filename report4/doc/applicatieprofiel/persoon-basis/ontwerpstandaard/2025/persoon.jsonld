        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een Persoon is een Agent die een menselijk wezen voorsteld."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te vervangen door een niet-abstracte klasse zoals W3C Persoon."
        }
      ],
