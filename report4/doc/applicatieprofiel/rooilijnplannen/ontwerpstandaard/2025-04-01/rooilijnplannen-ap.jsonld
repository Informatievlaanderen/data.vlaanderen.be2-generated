    },
    {
      "@id": "urn:oslo-toolchain:7a0aea541cc36adacbfeca994d8889436611dff41fae59813ffb9ccb1508bd09",
      "@type": "Class",
      "assignedURI": "http://data.vlaanderen.be/ns/besluit#Besluit",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Resolution"
        },
        {
          "@language": "nl",
          "@value": "Besluit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Besluit"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "The authentic written summary of a decision of a governing body. This decision involves a legal act with an intended legal effect."
        },
        {
          "@language": "nl",
          "@value": "De authentieke schriftelijke neerslag van een beslissing van een bestuursorgaan. Deze beslissing houdt een rechtshandeling in waarbij sprake is van een beoogd rechtsgevolg."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De beslissingen waarvan sprake zijn rechtshandelingen met beoogd rechtsgevolg. Hetzij individueel (bvb toekennen van een subsidie) of voor een groep (bvb een verkeersregel). In deze context gaat het om Besluiten waarin Rooilijnen worden vastgelegd. Voor meer info over de klasse Besluit, zie het applicatieprofiel OSLO-Besluit."
        },
        {
          "@language": "en",
          "@value": "This includes both individual resolutions (legal acts with an individual character such as grants) and general resolutions (decisions of general rules that are aimed at a group rather than individuals, such as the traffic rules)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:1783fb717d604679e39bc7e716703154234fd3496a6a6810c8006e5be59cac2e"
        },
        {
          "@id": "urn:oslo-toolchain:46d1278083ef9dda62a2a9dd336d61e2cf4272506dcdbe8660b721672c7c1ddb"
        },
        {
          "@id": "urn:oslo-toolchain:8ecf89cc058fd3da9b969754b2a6b4b3592e32f590ab1665310c975ef311f0a0"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:48b7fc2d425cc087fd904057ba389ebca70de75a12b4d15be8d50c7c88435acd",
      "@type": "Class",
      "assignedURI": "http://todo.com/RuimtelijkuitvoeringsPlan",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "RuimtelijkuitvoeringsPlan"
        }
      ],
      "diagramLabel": [
        {
          "@value": "RuimtelijkuitvoeringsPlan"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Plan waarin de overheid de bestemming van de ruimte en de geldende regels of voorschriften vastlegt."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Onder bestemming wordt verstaan voor welke functies de ruimte mag worden gebruikt bvb wonen, kantoren, verkeer, groen etc. Dat wordt dmv een grafisch plan weergegeven. Daarnaast bevat een RuimtelijkUitvoeringsplan de regels en voorschriften die voor elke bestemming van toepassing zijn, bvb hoe hoog er gebouwd mag worden, hoever van de straat etc. In deze context gaat het over RuimtelijkeUitvoeringsplannen waarin Rooilijnen worden vastgelegd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:0f43fdddad32828a7a0673d5f17aaad7addec75ad00ea26dfb23e9ff138e3837",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Omgevingsvergunning"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Omgevingsvergunning"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Officiële toestemming om een bepaalde activiteit te verrichten in de fysieke leefomgeving."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat over activiteiten die potentieel hinderlijk zijn voor mens en milieu en daarom door de overheid vergund moeten worden, bvb het oprichten van een bouwwerk, het uitvoeren van een bedrijfsactiviteit, het verkavelen van een grond etc. In deze context gaat het over Omgevingsvergunningen waarin Rooilijnen worden vastgelegd. Meer info over deze klasse in het applicatieprofiel OSLO-Omgevingsvergunningen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:eaf7c873f6bf76e8acfde86f454b36200e55100cd24cb67fea71f8a6652275aa"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:595c4bfa246c5b55651bbfc019e6f7abdc6ef8f2c2881c3bd21b7e40c7d4c0ec",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijnen#Rooilijninventaris",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Rooilijninventaris"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Rooilijninventaris"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Oplijsting van de OpenbareWegen of AangelandeEigendommen die door de Rooilijn worden getroffen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch loopt een OntworpenRooilijn door bestaande AangelandeEigendommen of OpenbareWeg, dit zijn de door deze Rooilijn getroffen percelen of wegen. De Rooilijninventaris heeft tot doel om de impact daarvan weer te geven: welke delen van percelen zullen worden onteigend en/of welke delen van de weg komen in privaat bezit. Dat gebeurt oa door een opsomming van de getroffen percelen en/of wegen, evt met vermelding van eigenaars en getroffen oppervlakte en/of aanduiding van de geometrie van het totaal getroffen oppervlak en oppervlakte."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:e8a32aff317840796cb15ac6ef85e16553cc7bab6df19408fb3999ab91a749e6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
