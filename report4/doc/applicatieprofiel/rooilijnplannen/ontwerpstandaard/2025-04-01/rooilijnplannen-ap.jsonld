    {
      "@id": "urn:oslo-toolchain:c7152f09ca546dee68215c45d0638da5f71f495993805eb72fcb1c9d67063a9b",
      "assignedURI": "http://test.data.vlaanderen.be/ns/openbaardomein#Wegbaan",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Wegbaan"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Wegbaan"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De wegbaan (Wbn) is de voorstelling van de wegcorridor in het GRB. De wegbaan wordt overlangs opgedeeld in verschillende arbitrair afgebakende wegbaanelementen. Er zijn twee types wegbaanelementen: een kruispuntzone komt overeen met een kruispunt; een wegsegment komt overeen met een wegvak."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De wegbaan (Wbn) is de voorstelling van de wegcorridor in het GRB. De wegbaan wordt overlangs opgedeeld in verschillende arbitrair afgebakende wegbaanelementen. Er zijn twee types wegbaanelementen: een kruispuntzone komt overeen met een kruispunt; een wegsegment komt overeen met een wegvak."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Naar GRB-basis - WBN: Rand van de wegbaan"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Naar GRB-basis - WBN: Rand van de wegbaan"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e5c4528ceea70f4fb2d58ccf50f1eb218b4413a039e5cb569c037ea24299c1a1",
      "assignedURI": "https://data.vlaanderen.be/ns/perceel#KadastraalPatrimoniumperceel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kadastraal Patrimoniumperceel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KadastraalPatrimoniumperceel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een onroerend goed of onroerend recht dat in hoofde van één of meerdere titularissen van een zakelijk recht onderworpen is aan een bepaald eigendomsstatuut."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een onroerend goed of onroerend recht dat in hoofde van één of meerdere titularissen van een zakelijk recht onderworpen is aan een bepaald eigendomsstatuut."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze definitie is gealigneerd met de definitie van de Algemene Administratie van de PatrimoniumDocumentatie (AAPD). Kadastraal Patrimoniumperceel komt overeen met de entiteit BasicPropertyUnit uit INSPIRE Cadastral Parcel."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze definitie is gealigneerd met de definitie van de Algemene Administratie van de PatrimoniumDocumentatie (AAPD). Kadastraal Patrimoniumperceel komt overeen met de entiteit BasicPropertyUnit uit INSPIRE Cadastral Parcel. De identificator die gedefinieerd kan worden voor een Kadastraal patrimoniumperceel komt overeen met de PatKey. Ter informatie: de PatKey is samengesteld uit de CaPaKey en het partitienummer. Bijvoorbeeld: in Patkey 11111A2222/33B444_P0000 is 11111A2222/33B444 de CaPaKey en P0000 het partitienummer."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
