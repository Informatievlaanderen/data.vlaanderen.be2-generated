    {
      "@id": "urn:oslo-toolchain:8e799e28312ea092786dd438253d0f6b04d03db0f21fa08f356e67785aae91d0",
      "@type": "Class",
      "assignedURI": "https://qudt.org/schema/qudt/Unit",
      "vocLabel": [
