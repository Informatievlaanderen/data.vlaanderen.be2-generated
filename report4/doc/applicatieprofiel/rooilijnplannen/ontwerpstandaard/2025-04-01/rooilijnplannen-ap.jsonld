        }
      ],
      "diagramLabel": [
        {
          "@value": "Eenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Maat waarin een hoeveelheid van een bepaalde grootheid wordt uitgedrukt."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Maat waarin een hoeveelheid van een bepaalde grootheid wordt uitgedrukt."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te gebruiken ipv Concept als een voorgedefinieerde eenheid van QUDT beschikbaar is, bvb <a href=\"http://qudt.org/vocab/unit/M\">meter</a>. Zie <a href=\"https://www.qudt.org/doc/DOC_VOCAB-UNITS.html\">QUDT-units</a> voor meer info."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
