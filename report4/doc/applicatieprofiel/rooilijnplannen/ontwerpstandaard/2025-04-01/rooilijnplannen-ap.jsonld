  "classes": [
    {
      "@id": "urn:oslo-toolchain:e2d5a984af1a0f388cb5d575bf9b165c96210c5971bef2c63acc13033ae96356",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijnen#Rooilijn",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Rooilijn"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Rooilijn"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Lijn die de grens aangeeft tussen de OpenbareWeg en de AangelandeEigendommen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan worden vastgelegd in een Rooilijnplan als het om een OntworpenRooilijn gaat. Als het gaat om het verleggen van bestaande wegen wordt op dat plan ook de FeitelijkeRooilijn aangegeven. Rooilijnen worden oa beschreven in het Decreet gemeentewegen en het Decreet vaststelling en realisatie van gewestelijke rooilijnen. Een Rooilijn is niet enkel een Lijn, het is ook een Grens, ttz aan beide kanten bevindt zich een ander gebied, hier OpenbareWeg aan de ene kant en AangelandeEigendommen aan de andere kant. Een Rooilijn kan bestaan zonder Rooilijnplan waarop het expliciet is vastgesteld, bvb de Rooilijnen van de vroegere buurtwegen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:f247a5ff67c9203f1d326924c6f82dd8fa52765b7f04def743719ac6e8dd8b46"
        },
        {
          "@id": "urn:oslo-toolchain:e8a32aff317840796cb15ac6ef85e16553cc7bab6df19408fb3999ab91a749e6"
        },
        {
          "@id": "urn:oslo-toolchain:6c183cb23162714b8f5f36e90044e2f998ef9ad3faa7ce09ca81545794305c97"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e8a32aff317840796cb15ac6ef85e16553cc7bab6df19408fb3999ab91a749e6",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijnen#Rooilijnplanelement",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Rooilijnplanelement"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Rooilijnplanelement"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onderdeel van een Rooilijnplan."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Omvat verplichte objecten zoals Rooilijnen en een Rooilijninventaris, maar ook Bouwlijnen of objecten die nodig zijn voor de interpretatie van het plan (voor zover deze geen deel uitmaken van een ander object zoals info mbt de GetroffenOppervlakte dat deel uitmaakt vd Rooilijninventaris)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e0f21057d3ba08dcc4f88035ddf7a5f4a0cc7fcc6d127d8d8220adb125a1230e",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijnen#Bouwlijn",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bouwlijn"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bouwlijn"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Lijn die de grens aangeeft tussen de zone waar niet en waar wel mag gebouwd worden."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van Rooilijnplannen is het de lijn die in de AangelandeEigendommen van een Rooilijn ligt en gerekend vanaf deze Rooilijn de strook afbakent waarbinnen niet mag gebouwd worden (ook Achteruitbouwstrook genoemd). Heeft in principe een Geometrie maar kan ook de vorm van een voorschrift aannemen, bvb geen bebouwing toegelaten op minder dan 8m van de Rooilijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:f247a5ff67c9203f1d326924c6f82dd8fa52765b7f04def743719ac6e8dd8b46"
        },
        {
          "@id": "urn:oslo-toolchain:e8a32aff317840796cb15ac6ef85e16553cc7bab6df19408fb3999ab91a749e6"
        },
        {
          "@id": "urn:oslo-toolchain:6c183cb23162714b8f5f36e90044e2f998ef9ad3faa7ce09ca81545794305c97"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:b0394819235dd9d04d8bece8fff340fe6f2b21d013581abd295ac45dc3c9e88a",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijnen#Rooilijnplan",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Rooilijnplan"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Rooilijnplan"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Verordenend grafisch plan dat de begrenzing van OpenbareWegen bepaalt."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Die grenzen zijn de zgn Rooilijnen die de ligging en breedte van de OpenbareWeg vastleggen. Het plan bevat ten minste een OntworpenRooilijn, maar bijkomend kan ook de FeitelijkeRooilijn worden aangegeven, doorgaans in het geval waarbij een bestaande weg wordt verplaatst. Gevallen van Rooilijnplannen zijn de gemeentelijke Rooilijnplannen en de Gewestelijke Rooilijnplannen, resp beschreven in het Decreet gemeentewegen en het Decreet vaststelling en realisatie van gewestelijke rooilijnen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
