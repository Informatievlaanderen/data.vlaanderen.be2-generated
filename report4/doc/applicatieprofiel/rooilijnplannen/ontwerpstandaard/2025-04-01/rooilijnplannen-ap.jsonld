      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Objectreferentie die verwijst naar een object dat de OpenbareWeg voorstelt eventueel aangevuld met het gedeelte ervan dat door de Rooilijn wordt getroffen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb de Wegbaan of het Wegsegment en zijn breedte dat de OpenbareWeg voorstelt en optioneel het oppervlak dat daarvan overblijft na toepassing van een OntworpenRooilijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
