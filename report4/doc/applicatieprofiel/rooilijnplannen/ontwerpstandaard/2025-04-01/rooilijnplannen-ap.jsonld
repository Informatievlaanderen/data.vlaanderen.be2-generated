      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Rooilijnkenmerk dat zich aan de rechterkant van de Rooilijn bevindt."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In het geval van een Rooilijn is dat kenmerk hetzij OpenbareWeg, hetzij AangelandeEigendommen. Rechts is de kant rechts van de Rooilijn kijkend in de digitalisatierichting, di de richting waarin de lijn loopt."
        }
      ],
