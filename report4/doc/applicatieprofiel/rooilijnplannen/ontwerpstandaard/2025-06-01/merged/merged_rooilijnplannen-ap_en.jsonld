          "@value": "RuimtelijkUitvoeringsplan"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Onder bestemming wordt verstaan voor welke functies de ruimte mag worden gebruikt bvb wonen, kantoren, verkeer, groen etc. Dat wordt dmv een grafisch plan weergegeven. Daarnaast bevat een RuimtelijkUitvoeringsplan de stedenbouwkundige voorschriften over inrichting en/of het beheer die van toepassing zijn, bvb hoe hoog er gebouwd mag worden, hoever van de straat etc. In deze context gaat het over RuimtelijkeUitvoeringsplannen waarin Rooilijnen worden vastgelegd."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:0f43fdddad32828a7a0673d5f17aaad7addec75ad00ea26dfb23e9ff138e3837",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijn#Omgevingsvergunning",
      "diagramLabel": [
        {
          "@value": "Omgevingsvergunning"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:1783fb717d604679e39bc7e716703154234fd3496a6a6810c8006e5be59cac2e"
        },
