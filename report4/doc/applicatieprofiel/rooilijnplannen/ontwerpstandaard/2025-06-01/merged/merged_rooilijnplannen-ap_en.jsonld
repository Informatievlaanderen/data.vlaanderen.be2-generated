    {
      "@id": "urn:oslo-toolchain:5adf7ba7776badaa4e85e934acb94a0cac4f765e4e4e08b491a93cf6b7308b8d",
      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
