      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Eigendommen die grenzen aan of doorkruist worden door de OpenbareWeg."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "AangelandeEigendommen"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Eigendommen kunnen juridisch zowel privaat als publiek zijn. Onder eigendommen worden in praktijk KadastralePatrimoniumPercelen verstaan. Het doorkruisen van AangelandeEigendommen door een OpenbareWeg doet zich voor wanneer de ondergrond privaat eigendom is en de openbare weg op het privaat perceel wordt aangelegd. OPGELET: Subklasse van Rooilijnkenmerk en dus stelt deze klasse niet de AangelandeEigendommen als object maar als kenmerk (van een Rooilijn) voor."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
