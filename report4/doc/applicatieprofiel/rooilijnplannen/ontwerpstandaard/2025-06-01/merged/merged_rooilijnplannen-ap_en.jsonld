  "branchtag": "kandidaat_2025-07-01_v0.0.5",
  "classes": [
    {
      "@id": "urn:oslo-toolchain:e2d5a984af1a0f388cb5d575bf9b165c96210c5971bef2c63acc13033ae96356",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijn#Rooilijn",
      "diagramLabel": [
        {
          "@value": "Rooilijn"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:f247a5ff67c9203f1d326924c6f82dd8fa52765b7f04def743719ac6e8dd8b46"
        },
        {
          "@id": "urn:oslo-toolchain:00abebbdfcddaedd032037af793f44887140b746f663058eb8dd651a6a56883d"
        },
        {
          "@id": "urn:oslo-toolchain:6c183cb23162714b8f5f36e90044e2f998ef9ad3faa7ce09ca81545794305c97"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Lijn die de huidige of toekomstige grens aangeeft tussen de OpenbareWeg en de AangelandeEigendommen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Rooilijn"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan worden vastgelegd in een Rooilijnplan. Als de rooilijn op een plan staat kan deze constitutief (de toekomstige grens) of declaratief (samenvallend met de huidige grens) zijn. Rooilijnen worden oa beschreven in het <a href=\"https://codex.vlaanderen.be/PrintDocument.ashx?id=1032035&datum=&geannoteerd=true&print=false\">Decreet gemeentewegen</a> en het <a href=\"https://codex.vlaanderen.be/Portals/Codex/documenten/1018076.html\">Decreet vaststelling en realisatie van gewestelijke rooilijnen</a>. Een Rooilijn is niet enkel een Lijn, het is ook een Grens, ttz aan beide kanten bevindt zich een ander gebied, in het geval van een declaratieve lijn: de OpenbareWeg aan de ene kant en AangelandeEigendommen aan de andere kant. Een Rooilijn kan bestaan zonder Rooilijnplan waarop het expliciet is vastgesteld, deze rooilijn valt dan samen met de huidige grens van de openbare weg, we spreken van een Feitelijke Rooilijn."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:00abebbdfcddaedd032037af793f44887140b746f663058eb8dd651a6a56883d",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijn#Planelement",
      "diagramLabel": [
        {
          "@value": "Planelement"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onderdeel van een Plan."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Planelement"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb straten, gebouwen, wegenis maar ook titel, schaal, legende, noordpijl etc. In het geval ve Rooilijnplan gaat het om objecten zoals Rooilijnen, een Rooilijninventaris, Bouwlijnen en GetroffenOppervlakken maar ook om ondersteunende objecten zoals Percelen, Wegbanen etc."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:e0f21057d3ba08dcc4f88035ddf7a5f4a0cc7fcc6d127d8d8220adb125a1230e",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijn#Bouwlijn",
      "diagramLabel": [
        {
          "@value": "Bouwlijn"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:f247a5ff67c9203f1d326924c6f82dd8fa52765b7f04def743719ac6e8dd8b46"
        },
        {
          "@id": "urn:oslo-toolchain:00abebbdfcddaedd032037af793f44887140b746f663058eb8dd651a6a56883d"
        },
        {
          "@id": "urn:oslo-toolchain:6c183cb23162714b8f5f36e90044e2f998ef9ad3faa7ce09ca81545794305c97"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Lijn die de grens aangeeft tussen de zone waar niet en waar wel mag gebouwd worden."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bouwlijn"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van Rooilijnplannen is het de lijn die in de AangelandeEigendommen van een Rooilijn ligt en gerekend vanaf deze Rooilijn de strook afbakent waarbinnen niet mag gebouwd worden (ook Achteruitbouwstrook genoemd). Een Bouwlijn heeft in principe een Geometrie maar kan ook de vorm van een voorschrift aannemen, bijvoorbeeld geen bebouwing toegelaten op minder dan 8m van de Rooilijn."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:31d8fa0e564182dde67c6a2b80068d0ff620d692783fbb00e033be1c819cf170",
