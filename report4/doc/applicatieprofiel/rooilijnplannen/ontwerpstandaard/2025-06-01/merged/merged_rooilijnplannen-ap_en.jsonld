          "@id": "urn:oslo-toolchain:eaf7c873f6bf76e8acfde86f454b36200e55100cd24cb67fea71f8a6652275aa"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Officiële toestemming om een bepaalde activiteit te verrichten in de fysieke leefomgeving."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Omgevingsvergunning"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat over activiteiten die oa hinderlijk zijn voor mens en milieu of met ruimtelijke implicaties en daarom door de overheid vergund moeten worden, bvb het oprichten van een bouwwerk, het uitvoeren van een bedrijfsactiviteit, het verkavelen van een grond etc. In deze context gaat het over Omgevingsvergunningen waarbij Rooilijnen worden vastgelegd. Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/omgevingsvergunning/\">OSLO-Omgevingsvergunningen</a>."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:acd2a2f153a69511e4b0c22bf28e8acdefc11e7f428035994f263a729af558b8",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijn#Rooilijnplaninventaris",
      "diagramLabel": [
        {
          "@value": "Rooilijnplaninventaris"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:00abebbdfcddaedd032037af793f44887140b746f663058eb8dd651a6a56883d"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Oplijsting van de OpenbareWegen of AangelandeEigendommen die door een toekomstige Rooilijn op een Rooilijnplan worden getroffen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Rooilijnplaninventaris"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch loopt een constitutieve Rooilijn door bestaande AangelandeEigendommen of OpenbareWeg, dit zijn de door deze Rooilijn getroffen percelen of wegen. Het Rooilijnplaninventaris heeft tot doel om de impact van alle Rooilijnen op het Rooilijnplan weer te geven: welke delen van percelen zullen worden onteigend en/of welke delen van de weg komen in privaat bezit. Dat gebeurt oa door een opsomming van de getroffen percelen en/of wegen, evt met vermelding van eigenaars en de in totaal getroffen oppervlakte en/of aanduiding van de geometrie van het totaal getroffen oppervlak."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
