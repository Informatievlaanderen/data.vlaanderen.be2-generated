      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e5c4528ceea70f4fb2d58ccf50f1eb218b4413a039e5cb569c037ea24299c1a1",
