    },
    {
      "@id": "urn:oslo-toolchain:f826d079a3ee7d3361cd347f16022f28afce13dcdc30fcc6464a4477bba3101b",
      "@type": "Datatype",
      "assignedURI": "http://www.w3.org/ns/adms#Identifier",
      "vocLabel": [
        {
