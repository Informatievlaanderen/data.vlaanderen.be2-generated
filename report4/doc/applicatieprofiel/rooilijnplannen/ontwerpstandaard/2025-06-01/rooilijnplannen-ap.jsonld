        }
      ],
      "diagramLabel": [
        {
          "@value": "ZakelijkRecht"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een recht dat rust op een zaak of goed."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze context gaat het over rechten zoals eigenaarschap, vruchtgebruik, recht van opstal, etc. op onroerende goederen en met name kadastrale percelen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e7bb4c663a94303a10f655cfd4edc857de533fe567c6cb3c189170e67de9268a",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Kadastraal Planperceel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KadastraalPlanperceel"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een gedeelte van het Belgische grondgebied, geografische afgebakend en geïdentificeerd door de AAPD op het kadastraal percelenplan, dat overeenstemt met het grondoppervlak van één of meerdere kadastrale patrimoniale percelen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Kadastraal Planperceel komt overeen met de entiteit CadastralParcel uit INSPIRE Cadastral Parcel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:03a032964f739fcab57a9f49bccca125ebb4afe5afa696f335bfdfc7a0ec68c3"
        }
