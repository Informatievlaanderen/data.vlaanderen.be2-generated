        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In praktijk een verwijzing naar het KadastraalPartrimoniumPerceel dat de AangelandeEigendom voorstelt en indien toepasselijk het oppervlak dat daarvan overblijft na toepassing van een toekomstige Rooilijn."
        }
      ],
