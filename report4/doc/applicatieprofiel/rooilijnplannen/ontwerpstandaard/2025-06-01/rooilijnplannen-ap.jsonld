        }
      ],
      "diagramLabel": [
        {
          "@value": "Wegsegment"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Lineair ruimtelijk object dat de geometrie en connectiviteit beschrijft tussen twee punten in een Wegennetwerk."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Meer info over deze klasse in het AP <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/wegenregister/\">OSLO-Wegenregister</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
