    {
      "@id": "urn:oslo-toolchain:5adf7ba7776badaa4e85e934acb94a0cac4f765e4e4e08b491a93cf6b7308b8d",
      "@type": "Datatype",
      "assignedURI": "https://schema.org/QuantitativeValue",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "KwantitatieveWaarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KwantitatieveWaarde"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bv de hoogte van een object, het gewicht, de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog, laag ed vallen hier dus niet onder."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
