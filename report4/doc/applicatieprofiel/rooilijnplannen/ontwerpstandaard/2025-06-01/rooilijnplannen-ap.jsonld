    {
      "@id": "urn:oslo-toolchain:b0394819235dd9d04d8bece8fff340fe6f2b21d013581abd295ac45dc3c9e88a",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijn#Rooilijnplan",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Rooilijnplan"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Rooilijnplan"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Verordenend grafisch plan dat de huidige of de toekomstige grens tussen de AangelandeEigendommen en de OpenbareWegen vastlegt."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Die grenzen zijn de zgn Rooilijnen die de huidige of de toekomstige ligging en breedte van de OpenbareWeg vastleggen. Het plan bevat een Rooilijn die declaratief, indien deze samenvalt met de huidige grens van de openbare weg, zijn of constitutief, als het over een toekomstige grens gaat. Bijkomend kan op een rooilijnplan ook de oude af te schaffen rooilijn worden aangegeven, wanneer het plan een wettelijke rooilijn vervangt. Gevallen van Rooilijnplannen zijn de gemeentelijke Rooilijnplannen en de Gewestelijke Rooilijnplannen, resp beschreven in het <a href=\"https://codex.vlaanderen.be/PrintDocument.ashx?id=1032035&datum=&geannoteerd=true&print=false\">Decreet gemeentewegen</a> en het <a href=\"https://codex.vlaanderen.be/Portals/Codex/documenten/1018076.html\">Decreet vaststelling en realisatie van gewestelijke rooilijnen</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:baf05adb2c9c3c991a31f3cc336ee41894f8903d6b76b0d4626f666f2ed778fe"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
