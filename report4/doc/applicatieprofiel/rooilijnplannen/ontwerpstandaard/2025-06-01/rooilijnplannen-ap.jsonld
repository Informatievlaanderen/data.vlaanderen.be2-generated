      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Kenmerk dat aan een Lijn is verbonden."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb om het deel ve Lijn aan te geven dat wordt opgeheven of dat ondergronds ipv bovengronds ligt etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:da4b1c89061bb3199d03d4f8c2d67d169356b843a2b372eb5e6eb16776f09a44",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijn#OpenbareWeg",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "OpenbareWeg"
        }
      ],
      "diagramLabel": [
        {
          "@value": "OpenbareWeg"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Weg die vrij voor iedereen toegankelijk is."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Impliceert in principe een onbelemmerd, vrij gebruik voor alle verkeersdeelnemers op alle denkbare momenten. Staat los van openbaar of privaat eigendom, een weg kan op een privaat eigendom liggen maar toch openbaar zijn, bvb trage wegen (nu gemeentewegen, zie <a href=\"https://codex.vlaanderen.be/PrintDocument.ashx?id=1032035&datum=&geannoteerd=true&print=false\">Decreet gemeentewegen</a>). OPGELET: Subklasse van Rooilijnkenmerk en dus stelt deze klasse niet de OpenbareWeg als object maar als kenmerk (van een Rooilijn) voor."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:414edd3556dc98805ceb46e7bd325a8c7812e465b80c20bb82889b3d75307eee"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8e44a81b4e971b478e584ac73c5ad9dcb298f719230147066a834fdf3b851748",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/rooilijn#AangelandeEigendommen",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "AangelandeEigendommen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "AangelandeEigendommen"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Private eigendommen die grenzen aan of doorkruist worden door de OpenbareWeg."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Onder private eigendommen worden in praktijk KadastralePartrimoniumPercelen verstaan. Het doorkruisen van AangelandeEigendommen door een OpenbareWeg doet zich voor wanneer de ondergrond privaat eigendom is en de openbare weg op het privaat perceel wordt aangelegd. OPGELET: Subklasse van Rooilijnkenmerk en dus stelt deze klasse niet de AangelandeEigendommen als object maar als kenmerk (van een Rooilijn) voor."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:414edd3556dc98805ceb46e7bd325a8c7812e465b80c20bb82889b3d75307eee"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
