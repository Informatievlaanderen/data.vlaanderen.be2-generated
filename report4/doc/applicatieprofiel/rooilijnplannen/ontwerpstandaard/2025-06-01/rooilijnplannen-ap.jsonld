    {
      "@id": "urn:oslo-toolchain:c7152f09ca546dee68215c45d0638da5f71f495993805eb72fcb1c9d67063a9b",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Wegbaan",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Wegbaan"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Wegbaan"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De wegbaan (Wbn) is de voorstelling van de wegcorridor in het GRB. De wegbaan wordt overlangs opgedeeld in verschillende arbitrair afgebakende wegbaanelementen. Er zijn twee types wegbaanelementen: een kruispuntzone komt overeen met een kruispunt; een wegsegment komt overeen met een wegvak. Meer info over deze klasse in het VOC <a href=\"https://data.vlaanderen.be/doc/vocabularium/openbaardomein/terreindeel/\">OSLO-OpenbaarDomein</a>."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Naar GRB-basis - WBN: Rand van de wegbaan"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:977347ff1bf31ee6b71091644ea87de132aec11d751afb986c87198e16e5025a",
      "@type": "Class",
