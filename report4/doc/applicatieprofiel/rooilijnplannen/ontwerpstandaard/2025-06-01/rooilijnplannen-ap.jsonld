          "@id": "urn:oslo-toolchain:93201f0c4eefa6311c988bcfd6baa0ecafeadb4ff3df48ae14fc16595a8e86c6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
