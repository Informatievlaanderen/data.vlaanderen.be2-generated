    {
      "@id": "urn:oslo-toolchain:34148bc014f3b3f6ca2b18666a937ee9d998665a370a36269a47b82567bb53eb",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19109/2005/GeneralFeatureModel#GF_PropertyType",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kenmerktype"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Kenmerktype"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Kenmerktype"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Klasse die kenmerken van instanties van om het even welk type vertegenwoordigt."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van Observaties en Metingen is dit een kenmerk van het geobseveerdObject (of van het bemonsterdObject of een onderdeel daarvan) en in principe van alle instanties van dat type geobserveerdObject. Bv Lichaamstemperatuur, Lithologie, ChemischeSamenstelling (resp van een Persoon, een GeologischeEenheid en - meer indirect - van een Monster genomen op een bepaalde plek in een Rivier)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:461a5523f4a2aca718d75c5d354f511d197d80010dd0610e6895dda7a155d561",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19156/2011GeneralFeatureInstance#GFI_DomainFeature",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Domeinobject"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Domeinobject"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Domeinobject"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Object uit de reële wereld dat geen Bemonsteringsobject is."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is het werkelijk geobserveerdObject. Als rechtstreeks observeren niet kan observeren we een representatief staal, het zgn Bemonsteringsobject. In dat geval is het Domeinobject het bemonsterdObject. OPMERKING: Deze klasse is louter informatief, in praktijk moet ze gesubstitueerd worden door een klasse uit het domein. Bv in het domein Waterkwaliteit zou het domeinobject een instantie vd klasse Rivier kunnen zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:429d98af7527134f9b055de0f0546d45edc64d9fb27513116ed83835c42b1f98",
