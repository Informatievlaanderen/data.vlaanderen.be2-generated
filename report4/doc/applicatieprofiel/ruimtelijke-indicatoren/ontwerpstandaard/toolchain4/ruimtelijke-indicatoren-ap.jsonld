          "@value": "Observatieprocedure"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Observatieprocedure"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een workflow, protocol, plan, algoritme of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd."
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "A workflow,protocol,plan,algorithm,or computational method specifying how to make an Observation."
        },
        {
          "@language": "nl",
          "@value": "Een workflow, protocol, plan, algoritme of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "The procedure explains which steps must be performed to obtain a reproducible result. E.g. the correct placement of an anemometer (at a specific height above the ground surface, e.g. 10m for meteorological observations). The procedures are generally intended to be applied to more than one Observation."
        },
        {
          "@language": "nl",
          "@value": "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bv de correcte plaatsing van een windmeter (op een welbepaalde hoogte boven het grondoppervlak, bv 10m voor meteorologische waarnemingen). De procedures zijn doorgaans bedoeld om bij meer dan één Bemonstering te worden toegepast."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
