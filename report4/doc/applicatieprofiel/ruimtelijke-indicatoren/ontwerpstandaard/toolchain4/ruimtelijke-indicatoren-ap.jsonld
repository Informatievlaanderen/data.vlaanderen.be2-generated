    {
      "@id": "urn:oslo-toolchain:e8bcf8d9bb09bd70ac5c5a96f6cd04259c47fb5eccdc5a30041a33a3eeee4f36",
      "@type": "Datatype",
      "assignedURI": "http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Period",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Periode"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Periode"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Periode"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een 1-dimensionele geometrische primitieve in de tijd."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 1-dimensionele geometrische primitieve in de tijd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Vergelijkbaar met een Curve in de ruimte, maar ipv een interval tussen twee punten in de ruimte gaat het hier over een interval tussen twee punten op de tijdsas. De bijbehorende tijdsduur is de temporele afstand tussen die twee punten (vergelijkbaar met de afstand tussen twee punten in de ruimte). OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bv time:Interval uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:503b6929d80342535e0cbddb3268a36b37bcc2ce7758b5d3fc30b6d1772654b6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:503b6929d80342535e0cbddb3268a36b37bcc2ce7758b5d3fc30b6d1772654b6",
      "@type": "Datatype",
      "assignedURI": "http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Object",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "TemporeleEntiteit"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "TemporeleEntiteit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "TemporeleEntiteit"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte klasse voor temporele objecten."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte klasse voor temporele objecten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Die temporele objecten zijn temporele geometrische primitieven zoals Moment of Periode. Of het zijn composieten van temporele primitieven, bv om de geschiedenis van een fenomeen weer te geven (bv de opeenvolgende Periodes dat het fenomeen zich voordeed). Te gebruiken wanneer bvb beide temporele geometrische primitieven mogelijk zijn. OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bv time:TemporalEntity uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
