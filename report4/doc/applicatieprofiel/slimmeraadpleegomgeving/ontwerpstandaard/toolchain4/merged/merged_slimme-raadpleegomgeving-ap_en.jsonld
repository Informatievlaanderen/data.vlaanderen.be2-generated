    {
      "@id": "urn:oslo-toolchain:2b15089744e2865f7d31e42134768f8a9c1c5df9ba9042006be3e953fb63bbee",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Deze klasse vertegenwoordigt de openbare dienst zelf, zoals beschreven in een catalogus van openbare diensten. Een overheidsdienst is een verplichte of discretionaire reeks activiteiten die worden uitgevoerd of kunnen worden uitgevoerd door of namens een overheidsorganisatie, die door de overheid worden gefinancierd en die voortvloeien uit overheidsbeleid. Diensten kunnen ten goede komen aan een individu, een bedrijf of een andere overheidsinstantie, of groepen van deze. Een dienst bestaat ongeacht of er gebruik van wordt gemaakt, en de term \"voordeel\" kan van toepassing zijn in de zin van het mogelijk maken van het nakomen van een verplichting. Zoals gedefinieerd in de herziene versie van het Europese Interoperabiliteitskader, omvat een Europese overheidsdienst elke dienst die wordt geleverd door overheidsinstellingen in Europa, of door andere organisaties namens hen, aan bedrijven, burgers of andere overheidsinstellingen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Instantie publieke dienstverlening"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#InstancePublicService",
      "diagramLabel": [
        {
          "@value": "InstantiePubliekeDienstverlening"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
