    {
      "@id": "urn:oslo-toolchain:1864fea4f096422415344a9bce223a6ef7423af07893bfa4f9fa2a72a9ef5482",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een activiteit die plaatsvindt in een juridische context, hetzij in wetgevende organen zoals parlementen of uitvoerende organen zoals regeringen of de Europese Commissie."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Legale activiteit"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit kan het maken van een document inhouden, of worden getriggerd door een document dat door een eerdere activiteit is gemaakt.\r\n\r\nDit kan gebruikt worden om activiteiten op een willekeurig nauwkeurigheidsniveau te beschrijven: macro-activiteiten, zoals het lezen van tekst in een kamer, of kleinschalige activiteiten, zoals stemmen om de voorzitter van een commissie te kiezen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://data.europa.eu/eli/eli-draft-legislation-ontology#LegislativeActivity",
