    },
    {
      "@id": "urn:oslo-toolchain:b0996ef67c6a796f5f5ab9c1eb7218a72e6bd7bd1a12dcaaa1eac208ab04207f",
      "@type": "Class",
      "assignedURI": "http://data.vlaanderen.be/ns/besluit#Besluit",
      "diagramLabel": [
        {
          "@value": "Besluit"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a616584e2ade820c5c8d5baf11ee81a260fc44f552b1f755fdd788f36171a0b9"
        },
