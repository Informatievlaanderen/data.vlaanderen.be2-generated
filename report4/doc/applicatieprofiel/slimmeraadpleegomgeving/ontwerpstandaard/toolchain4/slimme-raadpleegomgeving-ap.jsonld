    {
      "@id": "urn:oslo-toolchain:afcddb5d9c9a2e346821f22fa632168722a1dc093ef94c499b87e6781fa49e2b",
      "assignedURI": "https://data.vlaanderen.be/ns/omgevingsvergunning#JuridischeKwalificatie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Juridische Kwalificatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "JuridischeKwalificatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Kwalificatie van de aard van de activiteit in termen van juridisch vastgelegde typeringen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Onder Juridische Categorie verstaan we rubrieken, klasseringen of juridisch-verankerde typeringen. De kwalificatie gebeurt aan de hand van Juridische Verwijzingen, en meer bepaald verwijzingen naar Juridische Werken of Juridische Categorieën. Het attribuut 'kwalificatietype' laat toe om een juridische kwalificatie op verschillende dimensies (bv. een activiteit kwalificeren op vlak van indelingsrubrieken en op vlak van Sevezo-regelgeving) te doen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:0264417df59ffb0c2ce2cbbec225ac04e2b01acf465a5344f28dc9b7731fd3fe",
