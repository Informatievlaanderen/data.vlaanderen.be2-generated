        {
          "@language": "nl",
          "@value": "Een URI die technisch als een klasse wordt voorgesteld in RDF,maar in het gebruik een literal is."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "en",
          "@value": "This datatype is to be used in case one do not want to introduce placeholder classes or datatypes."
        },
        {
          "@language": "nl",
          "@value": "Een zinvolle toepassing van dit datatype is het vermijden van de introductie van placeholder klassen. Een andere toepassing is om compliancy te bekomen met de bereik definitie van eigenschappen."
        }
      ],
