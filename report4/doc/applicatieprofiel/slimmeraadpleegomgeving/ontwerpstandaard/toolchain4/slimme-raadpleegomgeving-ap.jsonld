        }
      ],
      "diagramLabel": [
        {
          "@value": "Inhoud"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dat wat een rechtshandeling inhoudt."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan een verzoek zijn, een melding, een vaststelling, een normatieve bepaling, een procedurele beslissing, enzovoort. Eén rechtshandeling kan meerdere inhoudelijke punten inhouden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
