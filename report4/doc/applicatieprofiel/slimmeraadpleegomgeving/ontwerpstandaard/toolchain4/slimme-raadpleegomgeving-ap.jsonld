    {
      "@id": "urn:oslo-toolchain:61ab251fef873a5ef5cbfe2d9efbbc882075a02682b01b5e8edf5700e7468410",
      "@type": "Class",
      "assignedURI": "https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#ConceptualPublicService",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Conceptueel publieke dienstverlening"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ConceptueelPubliekeDienstverlening"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een conceptuele publieke service beschrijft een mogelijke dienstverlening (Public Service) die door besturen kan aangeboden worden. Het kan gebruikt worden als sjabloon om een public service vast te leggen. Daarnaast wordt het gebruikt om verschillende gelijkaardige public services te groeperen. Vele lokale besturen bieden bijvoorbeeld een vorm van een terrasvergunning aan. De conceptuele public service kan gebruikt worden om al deze terrasvergunningen te groeperen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
