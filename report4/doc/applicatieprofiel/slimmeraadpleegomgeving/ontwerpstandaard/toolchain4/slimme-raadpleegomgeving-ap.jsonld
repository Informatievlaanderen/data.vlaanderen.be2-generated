      "vocLabel": [
        {
          "@language": "nl",
          "@value": "TijdsInterval"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Tijdsinterval"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De tijdsperiode tussen twee momenten in de tijd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": ""
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
