      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch te specialiseren als Persoon of Organisatie, zie applicatieprofielen <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/persoon-basis/\">OSLO Persoon</a> en <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/persoon-basis/\">OSLO Organisatie</a> voor meer details."
