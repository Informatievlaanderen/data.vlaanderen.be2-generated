    {
      "@id": "urn:oslo-toolchain:1864fea4f096422415344a9bce223a6ef7423af07893bfa4f9fa2a72a9ef5482",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/eli/eli-draft-legislation-ontology#LegislativeActivity",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Legale activiteit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LegaleActiviteit"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een activiteit die plaatsvindt in een juridische context, hetzij in wetgevende organen zoals parlementen of uitvoerende organen zoals regeringen of de Europese Commissie."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit kan het maken van een document inhouden, of worden getriggerd door een document dat door een eerdere activiteit is gemaakt.\r\n\r\nDit kan gebruikt worden om activiteiten op een willekeurig nauwkeurigheidsniveau te beschrijven: macro-activiteiten, zoals het lezen van tekst in een kamer, of kleinschalige activiteiten, zoals stemmen om de voorzitter van een commissie te kiezen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:b0996ef67c6a796f5f5ab9c1eb7218a72e6bd7bd1a12dcaaa1eac208ab04207f",
      "@type": "Class",
      "assignedURI": "http://data.vlaanderen.be/ns/besluit#Besluit",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Resolution"
        },
        {
          "@language": "nl",
          "@value": "Besluit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Besluit"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "The authentic written summary of a decision of a governing body. This decision involves a legal act with an intended legal effect."
        },
        {
          "@language": "nl",
          "@value": "De authentieke schriftelijke neerslag van een beslissing van een bestuursorgaan. Deze beslissing houdt een rechtshandeling in waarbij sprake is van een beoogd rechtsgevolg."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Hieronder vallen zowel individuele besluiten (rechtshandelingen met een individueel karakter zoals het toekennen van een subsidie) als besluiten van algemene strekking (beslissingen van algemene reglementaire strekking die niet gericht zijn op een individu maar op een groep, zoals de verkeersregels)."
        },
        {
          "@language": "en",
          "@value": "This includes both individual resolutions (legal acts with an individual character such as grants) and general resolutions (decisions of general rules that are aimed at a group rather than individuals, such as the traffic rules)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
