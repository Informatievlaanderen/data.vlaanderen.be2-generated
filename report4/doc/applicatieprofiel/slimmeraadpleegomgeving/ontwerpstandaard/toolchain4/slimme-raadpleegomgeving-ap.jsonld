    {
      "@id": "urn:oslo-toolchain:e992af5b01112b564cdd30c2fd5a66f6366858dd51c3afb53b89c3cde0e5b87a",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/omgevingsvergunning#Recht",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Recht"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Recht"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De toestemming om een bepaalde activiteit uit te voeren op een bepaalde locatie, waarvoor, op het moment van aanvraag of melding, een specifieke vergunning of melding vereist is volgens de geldende regelgeving op het gebied van ruimtelijke ordening en milieu."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:ed07f4801302c3447daa0b7cd33f1cd9558e0517d5be4c2c108aceff74c9ea13"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ed07f4801302c3447daa0b7cd33f1cd9558e0517d5be4c2c108aceff74c9ea13",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/omgevingsvergunning#NormatieveBepaling",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Normatieve Bepaling"
        }
      ],
      "diagramLabel": [
        {
          "@value": "NormatieveBepaling"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een bepaling die een rechtsnorm in het leven roept, wijzigt, beëindigt of bevestigt."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan van algemene en individuele strekking zijn. Het kan gaan om een recht of verbintenis."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:9a8f1d3a9160201174e041255347a43bc646b0aa2897a421ac3a77978cc1767b"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:50094ef19f7c6fb70a17e2e5efc1e9064cecdb5f1dce82abee2759b061dcacc1",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/omgevingsvergunning#Activiteit",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Activiteit"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Activiteit (Omgevingsvergunning)"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Activiteit"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geheel van handelingen die een of meerdere Rechtssubjecten binnen een welbepaald tijdsbestek en op een welbepaalde locatie ten uitvoer (willen) (laten) brengen en die gezien hun aard te kwalificeren zijn en dus geregeld zijn onder één of meer welbepaalde Juridische Categorieën."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Maakt het voorwerp uit van vergunningsaanvragen, meldingen, vergunningsbesluiten, vaststellingen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
