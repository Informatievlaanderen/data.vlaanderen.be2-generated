        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Inlichting over een recht dat op het vastgoed van toepassing is."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "e.g. Voorkooprecht."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
