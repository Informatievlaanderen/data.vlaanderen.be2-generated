    {
      "@id": "urn:oslo-toolchain:187942fe12e1c279761b8ddae9d78304a184ca696ac7d1e986efcab0b213cf8b",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://data.vlaanderen.be/ns/vastgoed#gebouw",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "gebouw"
        }
      ],
      "diagramLabel": [
        {
          "@value": "gebouw"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een gesloten en/of overdekt, bovengronds of ondergronds bouwwerk, dat dient of bestemd is, ofwel om mensen, dieren en voorwerpen onder te brengen, ofwel om economische goederen te vervaardigen of diensten te verstrekken. Een gebouw verwijst naar gelijk welke structuur die op blijvende wijze op een terrein opgetrokken of gebouwd wordt."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:bfa25a53ad23608488200ff4f13a8c631b002953a8b87a02791ae25d7d64a64b"
      },
      "range": {
        "@id": "urn:oslo-toolchain:8e3ac6378a4a7856b8ff1a411a5405e2080a82688618d0ffdfc302e1037ee5a4"
      },
      "minCount": "0",
      "maxCount": "*",
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:eea93698317b40298479ca6093e4219344f8b782cb5a0733589997687129f9f7",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://data.vlaanderen.be/ns/vastgoed#gebouweenheid",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "gebouweenheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "gebouweenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De kleinste eenheid binnen een gebouw die geschikt is voor woon-, bedrijfsmatige, of recreatieve doeleinden en die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde circulatieruimte. Een gebouweenheid is in functioneel opzicht zelfstandig. Daarnaast kan een gebouweenheid ook een gemeenschappelijk deel zijn."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:bfa25a53ad23608488200ff4f13a8c631b002953a8b87a02791ae25d7d64a64b"
      },
