    {
      "@id": "urn:oslo-toolchain:7f4d6516242f56e7c581cab10e300fe4a1ff7c7f30d15ec30c28cf89cb054c6a",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/vastgoed#Aanvrager",
