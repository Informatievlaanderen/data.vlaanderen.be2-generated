      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De conditie beoordeeld volgens de kronenstructuur van Dr. A. Roloff, gelet op de scheutlengte ontwikkeling en vorming van dood hout."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De conditie beoordeeld volgens de kronenstructuur van Dr. A. Roloff, gelet op de scheutlengte ontwikkeling en vorming van dood hout."
