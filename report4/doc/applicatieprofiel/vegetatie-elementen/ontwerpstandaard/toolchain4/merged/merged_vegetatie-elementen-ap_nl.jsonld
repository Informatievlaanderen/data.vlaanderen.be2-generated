    {
      "@id": "urn:oslo-toolchain:45bdc793d4afdabda4ea7d28372b83db2cee8b2f9f68ea320ad6dafef1378a06",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/openbaardomein/vegetatie#OpgaandeBoom",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Opgaande boom"
        }
      ],
      "diagramLabel": [
        {
          "@value": "OpgaandeBoom"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een opgaande boom is een boom waarvan de vorm van de kruin overeenkomt met zijn natuurlijke, soortgebonden habitus. Opgaande bomen kunnen een hoge, lage, brede, smalle of een afwijkende groeivorm hebben, zoals zuil- en treurvormen. De boom kan zich op volstrekt natuurlijke wijze uitgezaaid hebben en zijn groeivorm kan bepaald zijn door de natuurlijke groeiomstandigheden (bv. natuurlijke snoei). Ontstond de boom in kunstmatige omstandigheden, dan is de groeivorm bepaald door de jeugdsnoei in de kwekerij en is het eindbeeld van de boom bepaald door de begeleidingssnoei die wordt uitgevoerd vanaf het planten."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een opgaande boom is een boom waarvan de vorm van de kruin overeenkomt met zijn natuurlijke, soortgebonden habitus. Opgaande bomen kunnen een hoge, lage, brede, smalle of een afwijkende groeivorm hebben, zoals zuil- en treurvormen. De boom kan zich op volstrekt natuurlijke wijze uitgezaaid hebben en zijn groeivorm kan bepaald zijn door de natuurlijke groeiomstandigheden (bv. natuurlijke snoei). Ontstond de boom in kunstmatige omstandigheden, dan is de groeivorm bepaald door de jeugdsnoei in de kwekerij en is het eindbeeld van de boom bepaald door de begeleidingssnoei die wordt uitgevoerd vanaf het planten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
