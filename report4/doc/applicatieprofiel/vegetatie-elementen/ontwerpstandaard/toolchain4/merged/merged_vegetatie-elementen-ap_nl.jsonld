        {
          "@language": "nl",
          "@value": "boomplaat"
        }
      ],
      "diagramLabel": [
        {
          "@value": "boomplaat"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden. Boomplaten die aangewend worden voor bomen beschikken over extra openingen in de plaat voor het aanbrengen van een boompalen."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden. Boomplaten die aangewend worden voor bomen beschikken over extra openingen in de plaat voor het aanbrengen van een boompalen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Geeft aan of een boomplaat al dan niet aanwezig is. Naar AWV SB250."
        }
      ],
