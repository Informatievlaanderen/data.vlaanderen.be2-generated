    {
      "@id": "urn:oslo-toolchain:75b934359a02a60f02da75bd0f7046c4e0f70c174e2f6870ad88ff182f8c70a1",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/openbaardomein/vegetatie#Leiboom",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Leiboom"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Leiboom"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een leiboom is een boom waarvan alle gesteltakken in één verticaal vlak worden geleid. Soms worden de geleide bomen tegen een muur geleid of wordt er in een leidconstructie voorzien."
        }
      ],
      "apDefinition": [
