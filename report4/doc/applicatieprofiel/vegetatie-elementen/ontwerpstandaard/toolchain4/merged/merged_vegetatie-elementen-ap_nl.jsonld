      "assignedURI": "https://data.vlaanderen.be/ns/openbaardomein/vegetatie#takvrijeStamlengte",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "takvrije stamlengte"
        }
      ],
      "diagramLabel": [
        {
          "@value": "takvrijeStamlengte"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De lengte in meters, gemeten vanop het aardoppervlak, van het gedeelte van de stam dat takvrij dient gehouden te worden. Alle takken die lager zitten dan de uiteindelijke takvrije stamlengte behoren tot de tijdelijke kroon en zullen gesnoeid worden in verschillende fasen gespreid over verschillende jaren."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De lengte in meters, gemeten vanop het aardoppervlak, van het gedeelte van de stam dat takvrij dient gehouden te worden. Alle takken die lager zitten dan de uiteindelijke takvrije stamlengte behoren tot de tijdelijke kroon en zullen gesnoeid worden in verschillende fasen gespreid over verschillende jaren."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Definitie vrij naar Ecopedia: https://www.ecopedia.be/encyclopedie/begeleidingssnoei-bij-bomen"
        }
      ],
