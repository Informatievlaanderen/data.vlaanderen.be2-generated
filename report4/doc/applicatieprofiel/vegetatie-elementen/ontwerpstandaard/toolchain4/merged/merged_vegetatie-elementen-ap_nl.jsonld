    {
      "@id": "urn:oslo-toolchain:efaf901b68d328ced4b93a7e726591a54c3ce72c6ac48f22507484ad6bfe7dff",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://data.vlaanderen.be/ns/openbaardomein/vegetatie#conditiewaarde",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "conditiewaarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "conditiewaarde"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De conditiewaarde van een boom is een coëfficiënt die iets vertelt over de gezondheidstoestand (vitaliteit, conditie) en de levensverwachting van een boom. Een dode boom heeft een conditiewaarde nul. Een kerngezonde boom met zeer hoge levensverwachting heeft een conditiewaarde 1."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De conditiewaarde van een boom is een coëfficiënt die iets vertelt over de gezondheidstoestand (vitaliteit, conditie) en de levensverwachting van een boom. Een dode boom heeft een conditiewaarde nul. Een kerngezonde boom met zeer hoge levensverwachting heeft een conditiewaarde 1."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De conditiewaarde is te gebruiken in de context van de waardebepaling van bomen zoals vooropgesteld door de vereniging voor openbaar groen: http://www.vvog.info/default.asp?page=47"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
