          "@value": "Meer"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een meer is een door land omringde watervlakte. De meeste meren hebben een of meer voedende en afwaterende rivieren."
        }
      ],
      "apDefinition": [
        {
