          "@value": "Vijver"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een vijver is een door de mens aangelegd waterlichaam met beperkte oppervlakte en wordt geassocieerd met visvangst of een sierfunctie."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
