          "@value": "Poel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een poel is een meestal door de mens uitgegraven waterpartij in een grasland, bedoeld als drinkplaats voor het vee. Het zijn meestal kleine, ondiepe waterpartijen in grasland."
        }
      ],
      "apDefinition": [
