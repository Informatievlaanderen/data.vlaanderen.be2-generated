      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie die de biologische kwaliteit van water beoordeelt op basis van de algehele toestand van indicatiesoorten."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "BioIndicatorObservatie"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze soorten, ook BioIndicatoren genoemd, zijn levende organismen zoals planten, plankton, dieren, microben etc. Meer specifiek worden biochemische, fysiologische, gedragsmatige of populatieveranderingen gemonitord."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het vaststellen van de waarde van een bepaald kenmerk van een Object op een bepaald tijdstip of tussen twee tijdstippen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat om schattingen van de waarde, maw op de waarde zit een zekere foutmarge. Voorbeelden zijn temperatuur, klasse, kleur. Dit is verschillend van waarden die zijn toegekend en dus geen schattingen zijn zoals naam of prijs."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
