    {
      "@id": "urn:oslo-toolchain:7ff39b9c879a8cfe8de6e5ea9b88ecf6e66e4e67b55625ce2bcb67e65057a9b1",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Deel van het Object dat men wil observeren en dat representatief is voor dat Object."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het deel waarvan sprake kan zijn: fysiek (een Monster) of ruimtelijk (een Ruimtelijk Bemonsteringsobject). Men observeert een Bemonsteringsobject i.p.v. het werkelijk Object als dat laatste niet in zijn geheel geobserveerd kan worden (bv. omdat exhaustieve observatie onpraktisch zou zijn). Het Bemonsteringsobject vormt samen met het Proces dat voor observatie is gebruikt het z.g.n. observatieprotocol. OPGELET: deze klasse is abstract, ze moet gespecialiseerd worden in functie van het applicatiedomein."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeature",
