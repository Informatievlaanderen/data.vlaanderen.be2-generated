    {
      "@id": "urn:oslo-toolchain:955a5ca670e050d56c4472cbf7272082aa1769ec14597bff02b6ef2e22176cf3",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Observation that assesses the biological Quality of Water on a certain scale based on what organisms are present in the Water and in what quantities."
        },
        {
          "@language": "nl",
          "@value": "Observatie die de biologische kwaliteit van water op een bepaalde schaal beoordeelt, op basis van welke organismen in het water aanwezig zijn en in welke hoeveelheden."
        },
        {
          "@language": "en",
          "@value": "Observation that assesses the biological Quality of Water on a certain scale based on what organisms are present in the Water and in what quantities."
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "BioticIndexObservation"
        },
        {
          "@language": "nl",
          "@value": "BiotischeIndexObservatie"
        },
        {
          "@language": "en",
          "@value": "BioticIndexObservation"
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "In practice this comes down to counting specimens of certain species of macro-invertebrates like worms, snails, flies, clams etc present in the Water, weighted by the extent to which they tolerate Water pollution and combined into a single WaterqQuality score."
        },
        {
          "@language": "nl",
          "@value": "In de praktijk komt dit neer op het tellen van exemplaren van bepaalde soorten macro-ongewervelde dieren zoals wormen, slakken, vliegen, mosselen etc. die in het water aanwezig zijn, gewogen met de mate waarin ze watervervuiling tolereren en gecombineerd tot één waterkwaliteitscore."
        },
        {
          "@language": "en",
          "@value": "In practice this comes down to counting specimens of certain species of macro-invertebrates like worms, snails, flies, clams etc present in the Water, weighted by the extent to which they tolerate Water pollution and combined into a single WaterqQuality score."
        }
      ],
      "assignedURI": "https://purl.eu/ns/air-and-water/water#BioticIndexObservation",
      "diagramLabel": [
        {
          "@value": "BiotischeIndexObservatie"
        }
      ],
