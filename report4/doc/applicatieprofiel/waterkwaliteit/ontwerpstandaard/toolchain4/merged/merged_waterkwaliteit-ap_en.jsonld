    {
      "@id": "urn:oslo-toolchain:498956bda415cdc823c6f91b8ffa811739c528f7866777726d74a53e119cfbe0",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het moment waarop het resultaat van de Observatie van toepassing was."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch het moment waarop geobserveerd of bemonsterd werd. Als de Observatie temporeel is en het moment waarop iets plaatsvindt wordt geregistreerd dan is dit meteen ook de fenomeentijd."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.phenomenonTime",
      "diagramLabel": [
        {
          "@value": "fenomeentijd"
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
      },
      "maxCount": "1",
      "minCount": "1",
      "range": {
        "@id": "urn:oslo-toolchain:b57de249b37c0de681e1078697f10e5629f212bb3025b3946220720583cda3d3"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "fenomeentijd"
