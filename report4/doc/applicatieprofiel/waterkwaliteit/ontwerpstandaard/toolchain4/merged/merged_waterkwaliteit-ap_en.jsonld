  "branchtag": "master",
  "classes": [
    {
      "@id": "urn:oslo-toolchain:6d226b90737c1198df1ac6a120e7683fa2373349f3e52b4a2e16f8acf0dd9544",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Real-world Object related to Water."
        },
        {
          "@language": "nl",
          "@value": "Object uit de reële wereld gerelateerd aan water."
        },
        {
          "@language": "en",
          "@value": "Real-world Object related to Water."
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "WaterFeature"
        },
        {
          "@language": "nl",
          "@value": "WaterObject"
        },
        {
          "@language": "en",
          "@value": "WaterFeature"
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "It is the featureOfInterest, the Object of which some property is observed to assess WaterQuality. This can be for example a waterbody like the Canal Brussels-Charleroi. The Waterfeature can be typed via the \"type\" attribute (value would be \"waterbody-canal\" for example), but substitution by a typed instance (eg an instance of type \"Canal\", subclass of a class \"Waterbody\") is also allowed. In either case, the observedProperty must be a phenomenon related to the WaterFeature type. If the WaterFeature is not observed directly, but rather indirectly by sampling it, the WaterFeature is the sampledObject and the sample assumes the role of featureOfInterest."
        },
        {
          "@language": "nl",
          "@value": "Dit is het geobserveerd- of bemonsterdObject, het object waarvan een eigenschap wordt geobserveerd om de waterkwaliteit te beoordelen. Dit kan bijvoorbeeld een waterlichaam zijn zoals het Kanaal Brussel-Charleroi. Verdere specificatie van het Waterobject kan dmv het attribuut type of door Waterobject te subklassen (bvb dmv een subklasse Kanaal)."
        },
        {
          "@language": "en",
          "@value": "It is the featureOfInterest, the Object of which some property is observed to assess WaterQuality. This can be for example a waterbody like the Canal Brussels-Charleroi. The Waterfeature can be typed via the \"type\" attribute (value would be \"waterbody-canal\" for example), but substitution by a typed instance (eg an instance of type \"Canal\", subclass of a class \"Waterbody\") is also allowed. In either case, the observedProperty must be a phenomenon related to the WaterFeature type. If the WaterFeature is not observed directly, but rather indirectly by sampling it, the WaterFeature is the sampledObject and the sample assumes the role of featureOfInterest."
        }
      ],
      "assignedURI": "https://purl.eu/ns/air-and-water/water#WaterFeature",
      "diagramLabel": [
        {
          "@value": "WaterObject"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:28436ca796dc7b47d128ca145c32da19b0da42134c61e10b67d1acbccd9d294e"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Object uit de reële wereld gerelateerd aan water."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "WaterObject"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is het geobserveerdObject, het object waarvan een eigenschap wordt geobserveerd om de waterkwaliteit te beoordelen. Dit kan bijvoorbeeld een waterlichaam zijn zoals het Kanaal Brussel-Charleroi. Het Waterobject kan worden getypeerd via het attribuut type (bvb met als waarde “kanaal”), maar vervanging door een gespecialiseerd object (bijvoorbeeld van het type Kanaal) is ook mogelijk."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:28436ca796dc7b47d128ca145c32da19b0da42134c61e10b67d1acbccd9d294e",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Klasse die instanties van om het even welk type vertegenwoordigt."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van Observaties en Metingen is dit het geobserveerdObject waarvan een kenmerk wordt geobserveerd. Het geobserveerdObject kan ook een Object zijn dat de werkelijkheid bemonstert (subklasse Bemonsteringsobject). OPGELET: deze klasse is abstract, ze moet gespecialiseerd worden in functie van het applicatiedomein."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/GeneralFeatureInstance#GFI_Feature",
      "diagramLabel": [
        {
          "@value": "Object"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Object"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:67ec9f1b61b10e598787226aac8600fd6d6b26d265e02ef8945954ea2eac21de",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Observation that assesses the biological Quality of Water based on the overall condition of indicator species."
        },
        {
          "@language": "nl",
          "@value": "Observatie die de biologische kwaliteit van water beoordeelt op basis van de algehele toestand van indicatiesoorten."
        },
        {
          "@language": "en",
          "@value": "Observation that assesses the biological Quality of Water based on the overall condition of indicator species."
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "BioIndicatorObservation"
        },
        {
          "@language": "nl",
          "@value": "BioIndicatorObservatie"
        },
        {
          "@language": "en",
          "@value": "BioIndicatorObservation"
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "These species,also called BioIndicators,are living organisms such as plants,planktons,animals,microbes… More specifically,biochemical,physiological,behavioural or population changes are monitored."
        },
        {
          "@language": "nl",
          "@value": "Deze soorten, ook BioIndicatoren genoemd, zijn levende organismen zoals planten, plankton, dieren, microben etc. Meer specifiek worden biochemische, fysiologische, gedragsmatige of populatieveranderingen gemonitord."
        },
        {
          "@language": "en",
          "@value": "These species,also called BioIndicators,are living organisms such as plants,planktons,animals,microbes… More specifically,biochemical,physiological,behavioural or population changes are monitored."
        }
      ],
      "assignedURI": "https://purl.eu/ns/air-and-water/water#BioIndicatorObservation",
      "diagramLabel": [
        {
          "@value": "BioIndicatorObservatie"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        }
      ],
