      "@type": "Class",
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Observation to assess  the chemical Quality of Water by estimating the concentration of a harmful or unsuitable substance."
        },
        {
          "@language": "nl",
          "@value": "Observatie om de chemische kwaliteit van water te beoordelen door de concentratie van een schadelijke of ongeschikte stof te schatten."
        },
        {
          "@language": "en",
          "@value": "Observation to assess  the chemical Quality of Water by estimating the concentration of a harmful or unsuitable substance."
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "ChemicalAgentConcentrationObservation"
        },
        {
          "@language": "nl",
          "@value": "ChemischAgensConcentratieObservatie"
        },
        {
          "@language": "en",
          "@value": "ChemicalAgentConcentrationObservation"
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Actually the Measurement of the amount of the substance in the Water,usually over some averaging period. Result is how much of the substance is found eg in milligrams-per-liter."
        },
        {
          "@language": "nl",
          "@value": "Eigenlijk de meting van de hoeveelheid van de stof in het water, meestal uitgemiddeld over een bepaalde periode. Het resultaat is hoeveel van de stof wordt aangetroffen, bijvoorbeeld in milligram per liter."
        },
