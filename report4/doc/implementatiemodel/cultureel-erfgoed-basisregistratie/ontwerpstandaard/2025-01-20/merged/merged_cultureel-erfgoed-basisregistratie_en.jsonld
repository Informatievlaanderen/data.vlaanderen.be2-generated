      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Niet-materiële voortbrengselen van de geest of andere door mensen geproduceerde gegevens."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Conceptueel Object"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Overkoepelende klasse voor immateriële objecten. Gecreëerd, uitgevonden of bedacht door iemand en dan gedocumenteerd of mondeling doorgegeven. Een Conceptueel Object kan niet worden vernietigd, het bestaan ervan stopt pas als het op geen enkele drager nog voorkomt. OPMERKING: Indirecte subklasse van Entiteit. Abstracte klasse, gebruik de indirecte subklassen Set of InformatieObject."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
