      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Plaats waar Observaties plaatsvinden."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Maakt typisch deel uit van een Meetnet. OPMERKING: Strikt genomen hoeven deze Observaties geen Metingen te zijn, ook andere types Observaties zijn mogelijk (bv. Tellingen). OPMERKING: De plaatsen waar geobserveerd wordt hebben niet noodzakelijk een puntgeometrie (hoewel dat in praktijk het meest voorkomende geval is)."
        }
