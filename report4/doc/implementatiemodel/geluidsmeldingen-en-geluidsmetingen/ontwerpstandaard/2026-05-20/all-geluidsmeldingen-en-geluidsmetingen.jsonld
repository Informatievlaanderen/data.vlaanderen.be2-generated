        {
          "@language": "nl",
          "@value": "Generieke,zwak getypeerde waarde."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "In essence,a value and the name of the type of the value. E.g.  temperature of 21 degrees Celcius (value = 21 degrees Celcius,name = temperature)."
        },
        {
          "@language": "nl",
          "@value": "In essentie een waarde en de naam vh type van de waarde. Bv een temperatuur van 21graden Celcius (waarde = 21 graden Celcius,naam = temperatuur)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
