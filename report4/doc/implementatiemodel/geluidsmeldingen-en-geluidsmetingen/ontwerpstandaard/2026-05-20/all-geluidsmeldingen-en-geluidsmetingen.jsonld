        {
          "@language": "nl",
          "@value": "Activiteit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "wasGeassocieerdMet"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een activiteitassociatie is het toekennen van verantwoordelijkheid aan een agent voor een activiteit, waarbij wordt aangegeven dat de agent een rol had in die activiteit.$ea_notes=Een activiteitassociatie is het toekennen van verantwoordelijkheid aan een agent voor een activiteit, waarbij wordt aangegeven dat de agent een rol had in die activiteit. Het maakt het bovendien mogelijk een plan te specificeren, namelijk het plan dat door de agent wordt beoogd om bepaalde doelstellingen te bereiken in de context van deze activiteit."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:1f0b984f704c86c6a2e3e7b50d22b12d0f3a7129011aad7c830f6b2a97f08a95"
      },
