    {
      "@id": "urn:oslo-toolchain:34393d251eba287f22ecdee0a06098a7ca917178a657672629a4ce6bbedd9bf5",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/sosa/Sensor",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sensor"
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "Sensor"
        },
        {
          "@language": "nl",
          "@value": "Sensor"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Sensor"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Toestel of Agent (incl Personen of software) waarmee Observaties gemaakt worden."
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Device or Agent (including Persons or software) with which Observations are made."
        },
        {
          "@language": "nl",
          "@value": "Toestel of Agent (incl Personen of software) waarmee Observaties gemaakt worden."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Sensoren genereren een resultaat op basis van een Stimulus, ttz een verandering in de omgeving, of op basis van resultaten van andere Observaties. Ze worden typisch gehost door een Platform. Voorbeelden zijn snelheidsmeters, gyroscopen, barometers, magnetometers gemonteerd op een smart phone. Ook bv het menselijk oog kan beschouwd worden als een sensor."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Sensors generate a result based on a stimulus, i.e. a change in the environment, or based on results from other Observations. They are typically hosted by a Platform. Examples are speedometers, gyroscopes, barometers, magnetometers mounted on a smart phone. The human eye, for example, can also be regarded as a Sensor."
        },
        {
          "@language": "nl",
          "@value": "Sensoren genereren een resultaat op basis van een Stimulus, ttz een verandering in de omgeving, of op basis van resultaten van andere Observaties. Ze worden typisch gehost door een Platform. Voorbeelden zijn snelheidsmeters, gyroscopen, barometers, magnetometers gemonteerd op een smart phone. Ook bv het menselijk oog kan beschouwd worden als een sensor."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:8ade6c0bd633e5874b95fec1646900f732371c1025b39b51b58c2c721c2b7b31"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:0204c69cc6e798cc31029d3b4c2983295498b39b5b374010003b251916f2f1f3",
      "@type": "Class",
      "assignedURI": "https://www.w3.org/ns/sosa/Procedure",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Observatieprocedure"
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "ObservationProcedure"
        },
        {
          "@language": "nl",
          "@value": "Observatieprocedure"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Observatieprocedure"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "A workflow,protocol,plan,algorithm,or computational method specifying how to make an Observation."
        },
        {
          "@language": "nl",
          "@value": "Een workflow,protocol,plan,algoritme,of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "The procedure explains which steps must be performed to obtain a reproducible result. E.g. the correct placement of an anemometer (at a specific height above the ground surface, e.g. 10m for meteorological observations). The procedures are generally intended to be applied to more than one Observation."
        },
        {
          "@language": "nl",
          "@value": "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bv de correcte plaatsing van een windmeter (op een welbepaalde hoogte boven het grondoppervlak, bv 10m voor meteorologische waarnemingen). De procedures zijn doorgaans bedoeld om bij meer dan één Bemonstering te worden toegepast."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:139318c3be445c679828a76faa26e321b457085cd61c9494a321eb27d91f0b9e",
      "@type": "Class",
