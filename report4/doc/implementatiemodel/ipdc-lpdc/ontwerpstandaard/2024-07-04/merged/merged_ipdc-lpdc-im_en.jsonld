      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Publicatiekanaal van een publieke dienst beschrijft op welke plaaten de dienst zichtbaar zal zijn. Deze codelijst is in het beheer van het IPDC - LPDC team."
        },
        {
          "@language": "en",
          "@value": "Publication channel of a public service describes on which places the service will be visible. This code list is managed by the IPDC - LPDC team."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "publicatiekanalen"
        },
        {
          "@language": "en",
          "@value": "Publishing channels"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De geldige waardes zijn te vinden in het ttl bestand op de link in de codelijst kolom. Wanneer een concept het publicatiekanaal YourEurope heeft moet er in het veld yourEuropeCategory minstens één waarde ingevuld zijn."
        },
        {
          "@language": "en",
          "@value": "The valid values can be found in the ttl file on the link in the code list column. When a draft has the YourEurope publication channel, at least one value must be entered in the yourEuropeCategory field."
        }
      ]
    },
