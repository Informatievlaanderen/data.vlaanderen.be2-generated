    {
      "@id": "urn:oslo-toolchain:add5605cd8b471f2c7d1e0f4e3df609fe73b87f17a0a7393e17076361eb981d9",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "assignedURI": "http://schema.org/productID",
      "diagramLabel": [
        {
          "@value": "productnummer"
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:0cad3ac9dcac98e4bff97ea9d8bcee797fc5a61337d1782ea9c59fa2619099d2"
      },
      "maxCount": {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": "1"
      },
      "minCount": {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": "0"
      },
      "range": {
        "@id": "urn:oslo-toolchain:487667944"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Identificatienummer om op een unieke manier een instantie of concept te identificeren."
        },
        {
          "@language": "en",
          "@value": "Identification number to uniquely identify an instance or concept."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "productnummer"
        },
        {
          "@language": "en",
          "@value": "Product number"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bij het aanmaken van een nieuwe instantie kan geen productnummer doorgegeven worden aan IPDC of LPDC. De productnummers worden beheerd door IPDC en bij creatie van een nieuwe instantie zal een uniek productnummer toegekend worden in IPDC. Hierdoor zal bij het uitlezen van IPDC steeds een productnummer beschikbaar zijn op elke instantie."
        },
        {
          "@language": "en",
          "@value": "When creating a new instance, no product number can be passed to IPDC or LPDC. The product numbers are managed by IPDC and when a new instance is created, a unique product number will be assigned in IPDC. As a result, when IPDC is read, a product number will always be available on each instance."
        }
      ]
    },
