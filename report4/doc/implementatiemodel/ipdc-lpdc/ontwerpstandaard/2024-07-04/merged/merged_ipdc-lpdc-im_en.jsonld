      "range": {
        "@id": "urn:oslo-toolchain:487667944"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Identificatienummer om op een unieke manier een instantie of concept te identificeren."
        },
        {
          "@language": "en",
          "@value": "Identification number to uniquely identify an instance or concept."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "productnummer"
        },
        {
          "@language": "en",
          "@value": "Product number"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bij het aanmaken van een nieuw concept kan geen productnummer doorgegeven worden aan IPDC of LPDC. De productnummers worden beheerd door IPDC en bij creatie van een nieuw concept zal een uniek productnummer toegekend worden in IPDC. Hierdoor zal bij het uitlezen van IPDC steeds een productnummer beschikbaar zijn op elk concept."
        },
        {
          "@language": "en",
          "@value": "When creating a new draft, no product number can be passed on to IPDC or LPDC. The product numbers are managed by IPDC and when a new concept is created, a unique product number will be assigned in IPDC. As a result, when IPDC is read, a product number will always be available for each concept."
        }
      ]
    },
