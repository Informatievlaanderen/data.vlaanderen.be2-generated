    {
      "@id": "urn:oslo-toolchain:3b846ca60ddb8d62f56dc7083ee6305fdf9d30ff3c18fe87364cf4f0763aad1c",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "assignedURI": "http://schema.org/productID",
      "diagramLabel": [
        {
          "@value": "productnummer"
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:f268d6c3913b8f6a0bf1c768ecaa6efd0811b005343d47cd8f87ee2fcf86aa4b"
      },
      "maxCount": {
