          "@value": "regelgevingTekst"
        },
        {
          "@language": "en",
          "@value": "RegulationsText"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Rich Text (HTML) is toegestaan. Opgelet: mag geen uitvoerbare (JavaScript) code en anchor tags met relatieve urls bevatten.\r\nGebruik bij voorkeur de relatie 'follows(Rule)' om te verwijzen naar de relevante wetgeving."
        },
        {
          "@language": "en",
          "@value": "Rich Text (HTML) is allowed. Note: must not contain executable (JavaScript) code and anchor tags with relative urls.\r\nPreferably use the relationship 'follows(Rule)' to refer to the relevant legislation."
        }
      ]
    },
