      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "A property through which an e-mail address for the Public Organization, or a representative of it, can be contacted."
        },
        {
          "@language": "en",
          "@value": "A property through which an e-mail address for the Public Organization, or a representative of it, can be contacted."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "email"
        },
        {
          "@language": "en",
          "@value": "Email"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Email adres moet voldoen aan het formaat beschreven in RFC2822: https://datatracker.ietf.org/doc/html/rfc2822#section-3.4.1"
        },
        {
          "@language": "en",
          "@value": "Email address must conform to the format described in RFC2822: https://datatracker.ietf.org/doc/html/rfc2822#section-3.4.1"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:d1821989940faa94eef795f1cc27d14077a598dfc19b83be6e793c43eb89ae2a",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "assignedURI": "http://schema.org/openingHours",
      "diagramLabel": [
        {
          "@value": "openingsuren"
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:2c16d05a20ba2c39afc594556de01621a3f03ac0db72d09172d9338828427b34"
      },
      "maxCount": {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": "1"
      },
      "minCount": {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
