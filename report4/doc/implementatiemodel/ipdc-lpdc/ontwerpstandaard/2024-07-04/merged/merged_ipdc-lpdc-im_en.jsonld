    {
      "@id": "urn:oslo-toolchain:5665cb81e0cf738fd04cfe1426549c7ebbbe0afa46d686c4baa38e966f8accb1",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "diagramLabel": [
        {
          "@value": "YourEuropeCategorie"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "YourEurope categorie in het kader van de Single Digital Gateway verordening. Enkel dienstverlening die binnen één van deze categorieen valt moet doorgestuurd worden naar SDG. De categorieen en subcategorieen werden bepaald door het Europees Parlement. Deze werden door het IPDC - LPDC team vertaald naar een codelijst bij gebrek aan een Europese codelijst."
        },
        {
          "@language": "en",
          "@value": "YourEurope category under the Single Digital Gateway Regulation. Only services that fall within one of these categories should be forwarded to SDG. The categories and subcategories were determined by the European Parliament. These were translated by the IPDC - LPDC team into a code list in the absence of a European code list."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "YourEuropeCategorie"
        },
        {
          "@language": "en",
          "@value": "YourEuropeCategory"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De geldige waardes zijn te vinden in het ttl bestand op de link in de codelijst kolom."
        },
        {
          "@language": "en",
          "@value": "The valid values can be found in the ttl file on the link in the code list column."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:4012050da21518b8827a90aa8206287fe631c9f7600c775749f3b73fb12873b0",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "diagramLabel": [
        {
          "@value": "TaalDienstverlening"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
