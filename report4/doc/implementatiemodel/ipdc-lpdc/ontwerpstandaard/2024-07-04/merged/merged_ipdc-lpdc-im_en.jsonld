          "@language": "en",
          "@value": "yourEuropeCategories"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De geldige waardes zijn te vinden in het ttl bestand op de link in de codelijst kolom."
        },
        {
          "@language": "en",
          "@value": "The valid values can be found in the ttl file on the link in the code list column."
        }
      ]
    },
