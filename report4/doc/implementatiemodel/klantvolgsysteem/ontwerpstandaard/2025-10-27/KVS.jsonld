        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het profiel van een werkzoekende dat weergeeft welke competenties, kwalificaties, en ervaring de werkzoekende bezit. Daarnaast ook de persoonlijke voorkeuren en eventuele handicaps voor bepaalde jobs. Dossierstukken zoals CVs, diplomas, etc. staven dit profiel."
        }
      ],
