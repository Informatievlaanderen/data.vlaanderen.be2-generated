    {
      "@id": "urn:oslo-toolchain:333febbd79bd88416105d3335c4c8502b8423073080bb8c8f9bc07e3cb90d75e",
      "@type": "Class",
      "assignedURI": "https://publications.europa.eu/resource/authority/Taalcode",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Taal"
        }
      ],
