      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:bb8f9ffb4f67f96b7a5716f5ea6f64c3a546ddb867ba0998a1a976d5e62ee555",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Domicilie",
      "diagramLabel": [
        {
          "@value": "Domicilie"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:69541edab103f9ac8141e94644252c6e933e92f30861a7f4bb74659f9f1754f1"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Hoofdverblijfplaats van een Persoon."
        },
        {
          "@language": "en",
          "@value": "Person's primary residence."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Domicilie"
        },
        {
          "@language": "en",
          "@value": "Domicile"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Plaats waar de Persoon het grootste deel van de tijd verblijft binnen de jurisdictie waarvan hij Inwoner is. Dit wordt doorgaans officieel vastgesteld en geregistreerd ih bevolkingsregister. Kan in praktijk verschillend zijn van de feitelijke verblijfplaats."
        },
        {
          "@language": "en",
          "@value": "Place where the Person resides most of the time within the jurisdiction of which he is a Resident. This is usually officially established and registered in the population register. In practice, it may be different from the actual place of residence."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:89d54c9cf862cd83e7631a79373d0a3a4edd877682e7714ca1bea09ebf951057",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Natuurlijk persoon."
        },
        {
          "@language": "en",
          "@value": "Natural person."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."
        },
        {
          "@language": "en",
          "@value": "In case law, it concerns a person (in the legal sense, i.e. with its own legal personality) of the human species, i.e. a physical person. Counterpart is the legal entity, a legal construction that gives a private or public organization the same legal personality as a natural person (e.g. can also have debts, conclude contracts, be sued, etc.)."
        }
      ],
      "assignedURI": "http://www.w3.org/ns/person#Person",
      "diagramLabel": [
        {
          "@value": "Persoon"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b954552fd64a110b7edc2539cd01dee3687f9bb38e0fb0fd6c9ae68249b2406d"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Persoon"
        },
        {
          "@language": "en",
          "@value": "Person"
        }
      ]
    },
    {
