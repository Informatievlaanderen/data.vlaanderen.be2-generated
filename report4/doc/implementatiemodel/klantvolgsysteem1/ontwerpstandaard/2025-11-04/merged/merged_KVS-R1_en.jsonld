    {
      "@id": "urn:oslo-toolchain:f59bbf9085f552b332bb7960f6d7215dbf82fe1a3ec10f9d33a33653719b8690",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/klantvolgsysteem1/Activeringstraject",
      "diagramLabel": [
        {
          "@value": "Activeringstraject"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:79a176236964bafa9776d3abe8e8a2548de5051589fa42e9ea6f38a5e1886dc8"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een Activeringstraject is een specifiekere variant van een Traject dat moet aansporen om de Werkzoekende te activeren naar werk."
        },
        {
          "@language": "en",
          "@value": "An Activation Pathway is a more specific variant of a Pathway that should encourage the Job Seeker to activate to work."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Activeringstraject"
        },
        {
          "@language": "en",
          "@value": "Activation process"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:f87a934b403eae4bb15f4f55885d7d53b68103adcd814c47c0b75b45eb3b04ba",
      "@type": "Class",
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: een opleiding."
        },
        {
          "@language": "en",
          "@value": "For example: a study programme."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/klantvolgsysteem1/Deeltraject",
      "diagramLabel": [
        {
          "@value": "Deeltraject"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:79a176236964bafa9776d3abe8e8a2548de5051589fa42e9ea6f38a5e1886dc8"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een Deeltraject is een onderdeel van een Traject dat een specfiek onderdeel uitwerkt van een Traject."
        },
        {
          "@language": "en",
          "@value": "A Partial Trajectory is a part of a Trajectory that elaborates a specific part of a Trajectory."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Deeltraject"
        },
        {
          "@language": "en",
          "@value": "Partial trajectory"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:00ce2e972f4fc32705be1f51218aee12b33184f3b015ac3b7b07dbe8b3aa93ef",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een FormeleOrganisatie waarbij dit statuut ook op een andere manier verkregen kan zijn."
        },
        {
          "@language": "en",
          "@value": "Organization with a legal status established by registration. Compare with a Formal Organization where this status can also be obtained in another way."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "GeregistreerdeOrganisatie"
        },
        {
          "@language": "en",
          "@value": "Registered Organization"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In België moeten onder andere volgende Organisaties zich registreren: vennootschap (NV, BV, etc), eenmanszaak, overheidsorgaan, stichting, … Bij registratie krijgt de Organisatie een ondernemingsnummer en worden zijn gegevens ingevoerd in de Kruispuntbank van Ondernemingen (KBO)."
        },
        {
          "@language": "en",
          "@value": "In Belgium, the following organisations, among others, must register: company (NV, BV, etc), sole proprietorship, government body, foundation, ... Upon registration, the Organisation receives a company number and its data is entered into the Crossroads Bank for Enterprises (CBE)."
        }
      ],
      "assignedURI": "http://www.w3.org/ns/regorg#RegisteredOrganization",
      "diagramLabel": [
        {
          "@value": "GeregistreerdeOrganisatie"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b954552fd64a110b7edc2539cd01dee3687f9bb38e0fb0fd6c9ae68249b2406d"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:c72f59f8d3fcebdebf32c8e5f5c0f40390e271b0becde64d562779120e39f3db",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een Organisatie die volgens een wettelijk kader behoort tot de publieke sector, ongeacht het bestuursniveau waarop dat kader van kracht is."
        },
        {
          "@language": "en",
          "@value": "An Organisation that belongs to the public sector according to a legal framework, regardless of the level of government at which that framework is in force."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "PubliekeOrganisatie"
        },
        {
          "@language": "en",
          "@value": "PublicOrganization"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De overheids- en semioverheidsorganisaties die tot men zo tot de publieke sector kan rekenen worden in Europese richtlijn 2003/98/EG \"openbaar lichaam\" genoemd en gedefinieerd als: \"de staat, zijn territoriale lichamen, publiekrechtelijke instellingen, en verenigingen gevormd door een of meer van deze lichamen of een of meer van deze publiekrechtelijke instellingen\". En onder een publiekrechtelijke instelling verstaat men \" iedere instelling die a) is opgericht met het specifieke doel te voorzien in behoeften van algemeen belang die niet van industriële of commerciële aard zijn, en b) rechtspersoonlijkheid heeft, en c) waarvan hetzij de activiteiten in hoofdzaak door de staat of zijn territoriale lichamen of andere publiekrechtelijke instellingen worden gefinancierd, hetzij het beheer is onderworpen aan toezicht door deze laatste, hetzij de leden van het bestuursorgaan, het leidinggevend orgaan of het toezichthoudend orgaan voor meer dan de helft door de staat, zijn territoriale lichamen of andere publiekrechtelijke instellingen zijn aangewezen.\"."
        },
        {
          "@language": "en",
          "@value": "The public and semi-public organisations that can be classified as public sector are referred to in European Directive 2003/98/EC as \"public bodies\" and defined as: \"the State, regional or local authorities, bodies governed by public law, associations formed by one or more of such bodies or one or more of such bodies governed by public law\". And a body governed by public law means 'any body which (a) has been established for the specific purpose of meeting needs in the general interest, not having an industrial or commercial character, and (b) has legal personality, and (c) the activities of which are financed, for the most part, by the State, regional or local authorities or by other bodies governed by public law,  either the management is subject to supervision by the latter, or more than half of the members of the administrative, managerial or supervisory board are appointed by the State, regional or local authorities or other bodies governed by public law.';"
        }
      ],
      "assignedURI": "http://data.europa.eu/m8g/PublicOrganisation",
      "diagramLabel": [
        {
          "@value": "PubliekeOrganisatie"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b954552fd64a110b7edc2539cd01dee3687f9bb38e0fb0fd6c9ae68249b2406d"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:132869bbcca79d7380ce27f3d36f3b33249be46d6db0ab4b60c6d0f2fb913023",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een publieke dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen."
        },
        {
          "@language": "en",
          "@value": "A public service is a set of mandatory or optionally performed or implementable actions by or in the name of a public organisation. The service is for the benefit of an individual, a company, another public organization or groups."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "PubliekeDienstverlening"
        },
        {
          "@language": "en",
          "@value": "Public Services"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De dienstverlening vormt een aanbod (dat dus niet noodzakelijk wordt gebruikt). Ze houdt niet noodzakelijk het opnemen van een recht in,de dienstverlening kan de gebruiker ook toelaten een verplichting te vervullen."
        },
        {
          "@language": "en",
          "@value": "The service constitutes an offer (which is therefore not necessarily used). It does not necessarily imply the inclusion of a right, the service may also allow the user to fulfil an obligation."
        }
      ],
      "assignedURI": "http://purl.org/vocab/cpsv#PublicService",
      "diagramLabel": [
        {
          "@value": "PubliekeDienstverlening"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:36e49157a1e6cdf420adf00f611b59963b23ef7c0d510806928958a901ec7862",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het ter wereld komen van een Persoon."
        },
        {
          "@language": "en",
          "@value": "The coming into the world of a Person."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Geboorte"
        },
        {
          "@language": "en",
          "@value": "Birth"
        }
      ],
      "assignedURI": "http://purl.org/vocab/bio/0.1/Birth",
      "diagramLabel": [
        {
          "@value": "Geboorte"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    }
  ],
