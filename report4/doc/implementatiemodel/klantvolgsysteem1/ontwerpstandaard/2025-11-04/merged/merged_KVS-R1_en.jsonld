      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Verblijfplaats",
      "diagramLabel": [
        {
          "@value": "Verblijfplaats"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Plaats waar een Persoon al dan niet tijdelijk woont of logeert."
        },
        {
          "@language": "en",
          "@value": "Place where a Person lives or stays, temporarily or otherwise."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verblijfplaats"
        },
        {
          "@language": "en",
          "@value": "Residence"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:92607a4802f2d1e74b18cdfa61849c2fa3f310a0a59c69a4ef8ba9e64b51e1db",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Inwonerschap",
      "diagramLabel": [
        {
          "@value": "Inwonerschap"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het feit dat een Persoon verblijf houdt in een plaats of land."
        },
        {
          "@language": "en",
          "@value": "The fact that a Person resides in a place or country."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Inwonerschap"
        },
        {
          "@language": "en",
          "@value": "Residency"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:66bcc61cd2cd05f365bc924932cccb2d9a0eba7d7680ce7b928ecb1b5f1c69c5",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon",
      "diagramLabel": [
        {
          "@value": "GeregistreerdPersoon"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b954552fd64a110b7edc2539cd01dee3687f9bb38e0fb0fd6c9ae68249b2406d"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon waarvan de gegevens zijn ingeschreven in een register."
        },
        {
          "@language": "en",
          "@value": "Person whose data is registered in a register."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "GeregistreerdPersoon"
        },
        {
          "@language": "en",
          "@value": "Registered Person"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb naam en voornaam) en de Verblijfplaats vd persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."
        },
        {
          "@language": "en",
          "@value": "Usually this register is a population register, but it can also be an electoral register, for example. The registered data relate to the identity (e.g. surname and first name) and the place of residence of the person and to important life events such as birth, marriage, death, etc. These data are typically recorded by the government, they provide legal protection to the registered person and allow the government to compile basic statistics on its population."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:b954552fd64a110b7edc2539cd01dee3687f9bb38e0fb0fd6c9ae68249b2406d",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een agent zoals een Persoon, groep, software of fysiek artifact."
        },
        {
          "@language": "en",
          "@value": "An agent such as a Person, group, software, or physical artifact."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Agent"
        },
        {
          "@language": "en",
          "@value": "Agent"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te vervangen door een niet-abstracte klasse."
        },
        {
          "@language": "en",
          "@value": "To be replaced by a non-abstract class."
        }
      ],
      "assignedURI": "http://xmlns.com/foaf/0.1/Agent",
      "diagramLabel": [
        {
          "@value": "Agent"
        }
      ],
