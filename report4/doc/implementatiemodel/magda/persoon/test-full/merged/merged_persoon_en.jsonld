    {
      "@id": "urn:oslo-toolchain:c89683060c9db3e114cdd14753c2c61cece2a2d276b4789ddbaa605db0876189",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Naam van een geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is."
        },
        {
          "@language": "en",
          "@value": "Name of a geographic area or place that groups a number of addressable objects to address them without the area or place being an administrative unit."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "adresgebied"
        },
        {
          "@language": "en",
          "@value": "address area"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: de naam van het gehucht waarin het adres ligt."
        },
        {
          "@language": "en",
          "@value": "For example: the name of the hamlet where the address is located."
        }
      ],
      "assignedURI": "http://www.w3.org/ns/locn#addressArea",
      "diagramLabel": [
        {
          "@value": "adresgebied"
