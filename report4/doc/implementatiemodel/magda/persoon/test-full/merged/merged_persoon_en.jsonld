          "@value": "JuridischStatuut"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:17de93a5e2797574b23a426c5d32f290ca11553c3ee0ba1fa63f21dd9d2b0d3d"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De juridisch vastgestelde toestand van een persoon die bepaalt in welke mate die persoon zelfstandig bepaalde rechtshandelingen of handelingen met rechtsgevolgen kan stellen."
        },
        {
          "@language": "en",
          "@value": "The legally established status of a person that determines the extent to which that person can independently perform certain legal acts or acts with legal consequences."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "JuridischStatuut"
        },
        {
          "@language": "en",
          "@value": "Legal Status"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Typische toestanden zijn ontvoogd (voor minderjarigen) en beschermd (voor meerderjarigen)."
        },
        {
          "@language": "en",
          "@value": "Typical situations are emancipation (for minors) and protected (for adults)."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:04d20b2fa8fcaf936c9d4f4f00eb62f68e1dda10ddd79a28edc92350c43319bd",
