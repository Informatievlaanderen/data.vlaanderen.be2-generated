      "diagramLabel": [
        {
          "@value": "PersoonEnvelop"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5aa5525842ed2206492e21e533fbc85152556c18f7cfbf6f230d09dee746adee"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Enveloppe om Persoon en bijhorende validatiewaarschuwingen uit te wisselen."
        },
        {
          "@language": "en",
          "@value": "Envelope to exchange Person and associated validation alerts."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "PersoonEnvelop"
        },
