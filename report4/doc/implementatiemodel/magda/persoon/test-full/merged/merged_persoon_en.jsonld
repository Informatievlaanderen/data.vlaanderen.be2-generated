        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Verblijfplaats van een Persoon die tijdelijk afwezig is."
        },
        {
          "@language": "en",
          "@value": "Residence of a Person who is temporarily absent."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Afwezig"
        },
        {
          "@language": "en",
          "@value": "Absent"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is in principe met behoud van Domicilie."
        },
        {
          "@language": "en",
          "@value": "This is basically with retention of domicile."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:dd97adcde3614bee583df5b066f908019290c9cb364d011ad3fe06416c0302ed",
