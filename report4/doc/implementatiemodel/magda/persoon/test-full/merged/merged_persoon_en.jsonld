  "branchtag": "master",
  "classes": [
    {
      "@id": "urn:oslo-toolchain:edfcac56a241620ce740b3a0aa12e8c908fbbfcfe4d1e98aa813227f3f19c862",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Natuurlijk persoon."
        },
        {
          "@language": "en",
          "@value": "Natural person."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Persoon"
        },
        {
          "@language": "en",
          "@value": "Person"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, het is te zeggen met eigen rechtspersoonlijkheid) van de menselijke soort, het is te zeggen een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bijvoorbeeld ook schulden hebben, contracten afsluiten, aangeklaagd worden, etc.)."
        },
        {
          "@language": "en",
          "@value": "In case law, it concerns a person (in the legal sense, that is, with their own legal personality) of the human species, that is, a physical person. The counterpart is the legal person, a legal construct that gives a private or public organization the same legal personality as a natural person (for example, it can also have debts, conclude contracts, be sued, etc.)."
        }
      ],
      "assignedURI": "http://www.w3.org/ns/person#Person",
      "diagramLabel": [
        {
          "@value": "Persoon"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:4d59dba1a9ad9490758b915162ec431da00d5d3f2f2b1ca7585bebcf4b971eb1"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
