        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan verschillende vormen aannemen, bijvoorbeeld een vonnis, arrest, beschikking."
        },
        {
          "@language": "en",
          "@value": "Can take various forms, for example a judgment, ruling, or order."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:062fed9f8b840a43dda89ba7f9f11fab79012ec83c16e4a08293b19432ddc3af",
