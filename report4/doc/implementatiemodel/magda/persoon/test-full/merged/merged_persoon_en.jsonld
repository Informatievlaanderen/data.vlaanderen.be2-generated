      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Verblijplaats in het buitenland."
        },
        {
          "@language": "en",
          "@value": "Vacation home abroad."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "VerblijfplaatsBuitenland"
        },
        {
          "@language": "en",
          "@value": "Place of residenceAbroad"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Persoon in het buitenland met nog een hoofdverblijfplaats in België en dus daar tijdelijk afwezig."
        },
        {
          "@language": "en",
          "@value": "Person abroad with a main residence in Belgium and thus temporarily absent there."
        }
      ]
    },
