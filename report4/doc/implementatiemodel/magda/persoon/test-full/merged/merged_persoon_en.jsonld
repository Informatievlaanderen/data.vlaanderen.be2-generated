      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:30947190c0dcc55e46dcc8e7bf6abab0ea4531f0d4d181198b8e4435707ac417"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoonsrelatie waarbij de ene Persoon huisvesting verleent aan de andere Persoon."
        },
        {
          "@language": "en",
          "@value": "Personal relationship in which one Person provides accommodation to the other Person."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Huisvestingsrelatie"
        },
        {
          "@language": "en",
          "@value": "Housing relationship"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch om aan te geven bij welke ouder een kind deeltijds nog woont naast de ouder op wiens domicilie-adres het is ingeschreven.Of omgekeerd om aan te geven dat men een kind huisvest dat op het domicilie-adres van de andere ouder is ingeschreven."
        },
        {
          "@language": "en",
          "@value": "Typically to indicate with which parent a child still lives part-time alongside the parent whose domicile address they are registered with. Or conversely to indicate that a child is housed who is registered at the domicile address of the other parent."
        }
      ]
    },
