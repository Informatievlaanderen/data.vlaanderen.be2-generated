    {
      "@id": "urn:oslo-toolchain:d3ad25f3c46c75157660dcaa5160e08bdcd9243635d637bdbaf0ff7377ec88cc",
      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/magda/persoon#Bewindvoering",
      "diagramLabel": [
        {
          "@value": "Bewindvoering"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:30947190c0dcc55e46dcc8e7bf6abab0ea4531f0d4d181198b8e4435707ac417"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Bewindvoering is een juridische beschermings- en vertegenwoordigingsregeling waarbij een bewindvoerder wordt aangesteld om een meerderjarige persoon bij te staan of te vertegenwoordigen bij het beheer van diens persoonlijke en/of vermogensrechtelijke belangen, wanneer die persoon daartoe geheel of gedeeltelijk niet in staat is."
        },
        {
          "@language": "en",
          "@value": "Guardianship is a legal protection and representation arrangement whereby a guardian is appointed to assist or represent an adult in managing their personal and/or property interests when that person is wholly or partially unable to do so."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bewindvoering"
        },
        {
          "@language": "en",
          "@value": "Administration"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Concreet geeft de Persoonsrelatie aan welke Persoon de bewindvoerderis, m.a.w. de Persoon die de Bewindvoering over de Persoon uitoefent."
        },
        {
          "@language": "en",
          "@value": "Specifically, the Personal Relationship indicates which Person is the guardian, i.e., the Person who exercises Guardianship over the Person."
        }
      ]
    },
