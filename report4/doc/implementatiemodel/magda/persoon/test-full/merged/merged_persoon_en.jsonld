      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."
        },
        {
          "@language": "en",
          "@value": "Information such as email, phone, address that allows contacting someone or something."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Contactinfo"
        },
        {
          "@language": "en",
          "@value": "Contact info"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen, etc."
        },
        {
          "@language": "en",
          "@value": "For example: a person or organization or service... Possible forms of contact: calling, emailing, etc."
        }
      ],
      "assignedURI": "https://schema.org/ContactPoint",
