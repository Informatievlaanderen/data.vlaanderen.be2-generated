        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."
        },
        {
          "@language": "en",
          "@value": "Also called a family name because the surname indicates a family relationship."
        }
      ]
    },
