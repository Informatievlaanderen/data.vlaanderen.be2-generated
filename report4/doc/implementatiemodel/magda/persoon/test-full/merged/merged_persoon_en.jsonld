        {
          "@language": "nl",
          "@value": "Postadres van de verblijfplaats van een persoon."
        },
        {
          "@language": "en",
          "@value": "Postal address of the person's place of residence."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Postadres"
        },
        {
          "@language": "en",
          "@value": "Postal address"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch een adres in het buitenland."
        },
        {
          "@language": "en",
          "@value": "Typical of an address abroad."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:644f2365a204b7b8a732390e25ffb05fa1e3b51d9bb7e6f8ec6a47f32d7e6ecf",
      "@type": "Class",
