      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Formele opname van een juridisch document in een officieel Register."
        },
        {
          "@language": "en",
          "@value": "Formal registration of a legal document in an official register."
        }
      ],
      "vocLabel": [
