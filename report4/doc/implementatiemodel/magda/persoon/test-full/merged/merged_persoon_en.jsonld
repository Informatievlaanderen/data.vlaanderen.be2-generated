      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Hoofdverblijplaats in het buitenland."
        },
        {
          "@language": "en",
          "@value": "Main place of residence abroad."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "VerblijfplaatsBuitenlandDomicilie"
        },
        {
          "@language": "en",
          "@value": "Place of residenceAbroadDomicile"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Persoon in het buitenland gedomicilieerd bij een diplomatieke post in plaats van op een BelgischAdres, het is te zeggen zonder nog een hoofdverblijfplaats in België en dus ook niet daar tijdelijk afwezig."
        },
        {
          "@language": "en",
          "@value": "A person domiciled abroad at a diplomatic post instead of at a Belgian address, meaning without a main residence in Belgium and therefore not temporarily absent there."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:024ca88aa63b0c6017d9264dc0bb69788d4cb4ce1c80d1bbf40065c96e50b6c9",
