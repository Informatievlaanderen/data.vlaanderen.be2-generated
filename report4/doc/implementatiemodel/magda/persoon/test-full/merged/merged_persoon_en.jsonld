        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Wordt typisch bepaald ten opzichte van het gezinshoofd. Bijvoorbeeld als de vader gezinshoofd en een gezinslid is zoon, dan zou als de grootvader gezinshoofd zou zijn datzelfde gezinslid kleinzoon."
        },
        {
          "@language": "en",
          "@value": "Is typically determined with respect to the head of the household. For example, if the father is head of household and a family member is son, then if the grandfather were head of household, that same family member would be grandson."
        }
