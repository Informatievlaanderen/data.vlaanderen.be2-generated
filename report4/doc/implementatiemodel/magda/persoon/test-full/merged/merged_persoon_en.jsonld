    {
      "@id": "urn:oslo-toolchain:2f8dae4c92cddcc3c768b6d369d283dff8b5c63e28be1792b4f7f991a158bcb7",
      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een locatie kan een identificeerbare geografische locatie zijn (ISO 19112), maar deze locatie kan ook een niet-geografische locatie zijn, zoals een directory, rij of kolom. Als zodanig zijn er talloze manieren waarop locatie kan worden uitgedrukt."
        },
        {
          "@language": "en",
          "@value": "A location can be an identifiable geographic location (ISO 19112), but this location can also be a non-geographic location, such as a directory, row, or column. As such, there are countless ways location can be expressed."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Locatie"
        },
        {
          "@language": "en",
          "@value": "Location"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet direct gewerkt worden met Geometrie, GeografischeNaam, Adres, etc."
        },
        {
          "@language": "en",
          "@value": "To be used if the way the geographic position is indicated will only be established upon implementation. If this method is already known, then you must immediately work with Geometry, Geographic Name, Address, etc."
        }
      ],
      "assignedURI": "http://www.w3.org/ns/prov#Location",
      "diagramLabel": [
        {
          "@value": "Locatie"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f85a3c25f6c860235dacfdfef8633eaa0ad5e80954371a85d354d87b9377d270",
      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie gebruikt om een object uniek te identificeren."
        },
        {
          "@language": "en",
          "@value": "Information used to uniquely identify an object."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Identificator"
        },
        {
          "@language": "en",
          "@value": "identifier"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."
        },
        {
          "@language": "en",
          "@value": "The starting point here is that this string is assigned by an organization and that this happens according to a specific system."
        }
      ],
      "assignedURI": "http://www.w3.org/ns/adms#Identifier",
      "diagramLabel": [
        {
          "@value": "Identificator"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:3d365cc072e9352bf900b780534d1fc6b1dacde60373737554fbf112577ee220",
      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."
        },
        {
          "@language": "en",
          "@value": "More readable representation with only the basic data of the address, intended for using an address as an attribute of another object."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Adresvoorstelling"
        },
        {
          "@language": "en",
          "@value": "Address representation"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld als attribuut van een persoon of gebouw, ... De Adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."
        },
        {
          "@language": "en",
          "@value": "For example, as an attribute of a person or building, ... The Address Representation does not only relate to Belgian addresses; it can be used to display foreign addresses (where other address designations than house number or bus number may be used, or where address components such as address areas occur)."
        }
      ],
      "assignedURI": "http://www.w3.org/ns/locn#Address",
      "diagramLabel": [
        {
          "@value": "Adresvoorstelling"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:2f8dae4c92cddcc3c768b6d369d283dff8b5c63e28be1792b4f7f991a158bcb7"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
