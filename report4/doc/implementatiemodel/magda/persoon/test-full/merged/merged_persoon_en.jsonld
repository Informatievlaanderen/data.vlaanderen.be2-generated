        {
          "@language": "nl",
          "@value": "Document dat een uiting van wil, kennisname of bevestiging door één of meer personen vastlegt."
        },
        {
          "@language": "en",
          "@value": "Document that records an expression of intent, acknowledgment, or confirmation by one or more persons."
        }
      ],
