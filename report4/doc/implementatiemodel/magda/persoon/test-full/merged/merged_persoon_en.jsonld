        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Volg de REST richtlijnen van Digitaal Vlaanderen bij het gebruik van deze klasse binnen VDIP."
        },
        {
          "@language": "en",
          "@value": "Follow the REST guidelines of Digital Flanders when using this class within VDIP."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:94e3e1672e17217f7086f5f6fb1b6de3e251f757fd2c501a6a783c434a5430e8",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Data die vertrouwelijk is en daardoor niet mag meegedeeld worden."
        },
        {
          "@language": "en",
          "@value": "Data that is confidential and therefore may not be shared."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "NietMededeelbaar"
        },
        {
          "@language": "en",
          "@value": "Non-Communicable"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: Niet mededeelbaar adres."
        },
        {
          "@language": "en",
          "@value": "For example: Non-communicable address."
        }
      ],
      "assignedURI": "https://w3id.org/dpv#ConfidentialData",
      "diagramLabel": [
        {
          "@value": "NietMededeelbaar"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7ef6f04b456484b349adf2e4f1cc52b9d4f05e59a03cec6fde80930e96918584",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De relatie tussen een Persoon en een staat, cultuur, of loyaliteit."
        },
        {
          "@language": "en",
          "@value": "The relationship between a Person and a state, culture, or loyalty."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Nationaliteit"
        },
        {
          "@language": "en",
          "@value": "Nationality"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Ruimer begrip dan Staatsburgerschap dat zich beperkt tot de relatie met een staat en bijhorende rechten en plichten. Wie de Nationaliteit van een bepaald land heeft is er doorgaans ook automatisch staatsburger van. Het wordt doorgaans automatisch verkregen door geboorte: men krijgt hetzij de nationaliteit van zijn ouders of men krijgt deze van het land waar men Inwoner van is. Maar men kan een nationaliteit ook verkrijgen door naturalisatie. In principe verliest men dan zijn oorspronkelijke nationaliteit, maar dat is niet altijd zo (meervoudige nationaliteit)."
        },
        {
          "@language": "en",
          "@value": "A broader concept than citizenship is limited to the relationship with a state and associated rights and obligations. Anyone who holds the nationality of a particular country is usually automatically a citizen of it. It is usually acquired automatically by birth: one either receives the nationality of one's parents or one obtains it of the country of which one is a resident. But one can also acquire nationality through naturalization. In principle, one then loses their original nationality, but that is not always the case (multiple nationality)."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Nationaliteit",
      "diagramLabel": [
        {
          "@value": "Nationaliteit"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:17de93a5e2797574b23a426c5d32f290ca11553c3ee0ba1fa63f21dd9d2b0d3d"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a51e682a6fede4d41f66ffb22d96a5ab96144723c99357496dcb090b7787b1eb",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het feit dat een Persoon verblijf houdt in een plaats of land."
        },
        {
          "@language": "en",
          "@value": "The fact that a Person resides in a place or country."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Inwonerschap"
        },
        {
          "@language": "en",
          "@value": "Population"
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Inwonerschap",
      "diagramLabel": [
        {
          "@value": "Inwonerschap"
        }
      ],
      "parent": [
