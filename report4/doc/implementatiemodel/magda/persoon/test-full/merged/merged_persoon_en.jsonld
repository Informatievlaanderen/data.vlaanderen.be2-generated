          "@language": "nl",
          "@value": "Detailinformatie die meegegeven is bij een Uitzondering."
        },
        {
          "@language": "en",
          "@value": "Detailed information provided with an Exception."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Annotatie"
        },
        {
          "@language": "en",
          "@value": "Annotation"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:eb8646fd8e56fbb2b27da532bee85f7ce8ec9f13f4b0c40355ea7fe6ddd594d7",
      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/generiek#Problemdetail",
      "diagramLabel": [
        {
          "@value": "Problemdetail"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Meer gedetailleerde beschrijving van de fout in een HTTP response."
        },
        {
          "@language": "en",
          "@value": "More detailed description of the error in an HTTP response."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Problemdetail"
        },
        {
          "@language": "en",
          "@value": "Problem details"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit ter aanvulling van een HTTP statuscode,bijvoorbeeld bij een 400 (Bad request) statuscode om aan te geven waarom de request slecht was. Gebaseerd op <a href=\"https://www.rfc-editor.org/rfc/rfc7807\">RFC7807</a>."
        },
        {
          "@language": "en",
          "@value": "This is to supplement an HTTP status code, for example with a 400 (Bad request) status code to indicate why the request was bad. Based on <a href=\"https://www.rfc-editor.org/rfc/rfc7807\">RFC7807</a>."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:ec91107137b5c3445e4b22e4178314e7e7007d790b908b49241acdc9b4a04e78",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het gebied waarover de rechtsmacht van een overheid zich uitstrekt."
        },
        {
          "@language": "en",
          "@value": "The area over which the jurisdiction of a government extends."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Jurisdictie"
        },
        {
          "@language": "en",
          "@value": "Jurisdiction"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Doorgaans een land of deelstaat."
        },
        {
          "@language": "en",
          "@value": "Usually a country or state."
        }
      ],
      "assignedURI": "http://purl.org/dc/terms/Jurisdiction",
      "diagramLabel": [
