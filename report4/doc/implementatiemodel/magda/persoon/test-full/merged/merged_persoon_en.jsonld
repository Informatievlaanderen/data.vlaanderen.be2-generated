    },
    {
      "@id": "urn:oslo-toolchain:af8fedb0d5238bc38958f7d21100e4e885fc8a98957a8d3455111c98594506e6",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Samenwerkingsvorm die een herkenbare sociale eenheid vormt (bijvoorbeeld ten gevolge van een huwelijk), met al dan niet verwante personen die duurzame banden hebben en elkaar onderling steun en verzorging verlenen."
        },
        {
          "@language": "en",
          "@value": "A form of cooperation that forms a recognizable social unit (for example, as a result of marriage), with related or unrelated persons who have lasting bonds and provide mutual support and care."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Gezin"
        },
        {
          "@language": "en",
          "@value": "Family"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Ruimer begrip dan familie waar het Gezin louter bestaat uit nabije bloedverwanten, bijvoorbeeld een Eenpersoonsgezin of een Living Together Apart Gezin. Gezinsleden hebben doorgaans dezelfde Verblijfplaats."
        },
        {
          "@language": "en",
          "@value": "Broader concept than family where the family consists solely of close blood relatives, for example a single-person family or a living together separate family. Family members usually have the same place of residence."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Gezin",
      "diagramLabel": [
        {
          "@value": "Gezin"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:17de93a5e2797574b23a426c5d32f290ca11553c3ee0ba1fa63f21dd9d2b0d3d"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f10ec190562139b84c132165b23db430c002a16b0575ee8730adfc0415940c7d",
      "@type": "Class",
      "apDefinition": [
