      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:de099dc1385d817cf323fe0e3f42c68714378ca9a8014d48935f334518528536"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Adres van een andere persoon of rechtspersoon voor personen zonder vaste verblijfplaats."
        },
        {
          "@language": "en",
          "@value": "Address of another person or legal entity for persons without a fixed residence."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Referentieadres"
        },
        {
          "@language": "en",
          "@value": "Reference address"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld in het geval van mobiele woning (tytpisch binnenscheepvaart), dakloosheid, hechtenis (zonder woonst), opdracht in het buitenland (typuisch voor militairen) en dergelijke meer."
        },
        {
          "@language": "en",
          "@value": "For example, in the case of mobile housing (typical inland shipping), homelessness, detention (without housing), assignments abroad (typical for military personnel), and so on."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:6c8563199f6c094897abf06663e474fe4c1384cdf11d7d7f7c3c14dfedd6d22c",
      "@type": "Class",
