      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Verwijzing naar de Adminstratiefbeheerder van het dossier van de persoon."
        },
        {
          "@language": "en",
          "@value": "Referral to the Administrative Administrator of the person's file."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "beheerder"
        },
        {
          "@language": "en",
          "@value": "administrator"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Normaal is er maar 1 beheerder aanwezig bij een persoon, maar in uitzonderlijke gevallen kunnen er meerdere beheerders zijn. Bijvoorbeeld: de persoon heeft een adres in het buitenland, is aan het verhuizen tussen gemeenten, etc."
        },
        {
          "@language": "en",
          "@value": "Normally, there is only one administrator present at a person's place, but in exceptional cases, there can be multiple administrators. For example: the person has an address abroad, is moving between municipalities, etc."
        }
      ]
    },
