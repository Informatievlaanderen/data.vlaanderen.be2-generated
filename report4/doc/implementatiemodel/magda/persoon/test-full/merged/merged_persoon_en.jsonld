      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:756397aa752da7256cf6a5ffd0ef43fa7dd8ce93f00212b2bfffae59518b7bf6",
      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/magda/persoon#Herkomst",
      "diagramLabel": [
        {
          "@value": "Herkomst"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:17de93a5e2797574b23a426c5d32f290ca11553c3ee0ba1fa63f21dd9d2b0d3d"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Plaats waarvan een Persoon afkomstig is."
        },
        {
          "@language": "en",
          "@value": "Place from which a Person originates."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Herkomst"
        },
        {
          "@language": "en",
          "@value": "Provenance"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Waarbij afkomst bijvoorbeeld bepaald wordt op basis van de nationaliteit van de Persoon of deze van zijn ouders."
        },
        {
          "@language": "en",
          "@value": "Where origin, for example, is determined based on the nationality of the Person or that of their parents."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:caa315f28b865b70a823a1bcc00ef4600fa0ee732636091fc8bc9bf6ff9bf8c3",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Regeling waarbij twee personen die niet getrouwd zijn samenleven."
        },
        {
          "@language": "en",
          "@value": "Arrangement in which two people who are not married live together."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Samenwonen"
        },
        {
          "@language": "en",
          "@value": "Cohabitation"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan, net als bijvoorbeeld een Huwelijk, de basis vormen van een Gezin."
        },
        {
          "@language": "en",
          "@value": "Can, just like a marriage, for example, form the basis of a family."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Samenwonen",
      "diagramLabel": [
        {
          "@value": "Samenwonen"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:30947190c0dcc55e46dcc8e7bf6abab0ea4531f0d4d181198b8e4435707ac417"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7371303fba49763aac9dca5045e5aaff7279bae1097bb085cc4a7c5af02d1cc0",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon waarvan de gegevens zijn ingeschreven in een register."
        },
        {
          "@language": "en",
          "@value": "Person whose data are registered in a register."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "GeregistreerdPersoon"
        },
        {
          "@language": "en",
          "@value": "RegisteredPerson"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Doorgaans is dit register een bevolkingsregister maar het kan bijvoorbeeld ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (voorbeeld: naam en voornaam) en de Verblijfplaats van de persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."
        },
        {
          "@language": "en",
          "@value": "Usually, this register is a population register, but it can also be, for example, an electoral register. The registered data relate to the person's identity (for example: first and last name) and place of residence, as well as important life events such as birth, marriage, death, etc. This data is typically registered by the government, provides the registered person, and allows the government to compile basic statistics about its population."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon",
      "diagramLabel": [
        {
          "@value": "GeregistreerdPersoon"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:edfcac56a241620ce740b3a0aa12e8c908fbbfcfe4d1e98aa813227f3f19c862"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:de099dc1385d817cf323fe0e3f42c68714378ca9a8014d48935f334518528536",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Hoofdverblijfplaats van een Persoon."
        },
        {
          "@language": "en",
          "@value": "Main residence of a person."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Domicilie"
        },
        {
          "@language": "en",
          "@value": "domicile"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Plaats waar de Persoon het grootste deel van de tijd verblijft binnen de Jurisdictie waarvan de persoon Inwoner is. Dit wordt doorgaans officieel vastgesteld en geregistreerd in het bevolkingsregister. Kan in praktijk verschillend zijn van de feitelijke verblijfplaats."
        },
        {
          "@language": "en",
          "@value": "Place where the Person resides most of the time within the Jurisdiction of which the Person is a Resident. This is usually officially established and registered in the population register. May be different in practice from the actual place of residence."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Domicilie",
      "diagramLabel": [
        {
          "@value": "Domicilie"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d7e2610cb34b487f7d46a20db498b5b5e07750db1014d0f145eae62bc38a0425"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d7e2610cb34b487f7d46a20db498b5b5e07750db1014d0f145eae62bc38a0425",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Plaats waar een Persoon al dan niet tijdelijk woont of logeert."
        },
        {
          "@language": "en",
          "@value": "Place where a Person may or may not temporarily reside or stay."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Verblijfplaats"
        },
        {
          "@language": "en",
          "@value": "Residence"
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Verblijfplaats",
      "diagramLabel": [
        {
          "@value": "Verblijfplaats"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
