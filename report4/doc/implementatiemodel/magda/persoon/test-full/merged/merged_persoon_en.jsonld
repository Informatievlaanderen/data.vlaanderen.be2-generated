      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Juridische beschermings- en vertegenwoordigingsregeling waarbij een voogd wordt aangesteld om het gezag over en de belangenbehartiging van een minderjarige uit te oefenen wanneer die niet onder het ouderlijk gezag van zijn ouders staat."
        },
        {
          "@language": "en",
          "@value": "Legal protection and representation arrangement whereby a guardian is appointed to exercise authority over and the protection of a minor when they are not under the parental authority of their parents."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Voogdij"
        },
        {
          "@language": "en",
          "@value": "Guardianship"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Concreet geeft de Persoonsrelatie aan welke Persoon de voogd is, m.a.w. de Persoon die de Voogdij over de Persoon uitoefent."
        },
        {
          "@language": "en",
          "@value": "Specifically, the Personal Relationship indicates which Person is the guardian, i.e., the Person who exercises Guardianship over the Person."
        }
      ]
    }
