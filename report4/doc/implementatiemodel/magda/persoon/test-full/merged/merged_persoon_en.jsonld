        {
          "@language": "en",
          "@value": "Legal Residence"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Voor gevallen waar wettelijk een verblijplaats is bepaald, bijvoorbeeld bij kinderen wanneer de ouders niet meer samenleven. Bedoeld voor wanneer de persoon daar (nog) niet officieel zijn hoofdverblijfplaats heeft."
        },
        {
          "@language": "en",
          "@value": "For cases where a place of residence has been legally determined, for example for children when the parents no longer live together. Intended for when the person does not (yet) officially have their main residence there."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:93f48392851633f7bce3e7a03c0b0ba3a92c09efeb2d289d9277861abd6c8cd1",
      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/magda/persoon#AdministratiefBeheerder",
      "diagramLabel": [
        {
          "@value": "AdministratiefBeheerder"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:17de93a5e2797574b23a426c5d32f290ca11553c3ee0ba1fa63f21dd9d2b0d3d"
        },
        {
          "@id": "urn:oslo-toolchain:0e34584b8338f1d3bbd46336f5a28d799543e80dce6de7b50b1c81e0ba838a77"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Organisatie die het dossier van de persoon in het register beheert."
        },
        {
          "@language": "en",
          "@value": "Organization that manages the person's file in the register."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "AdministratiefBeheerder"
        },
        {
          "@language": "en",
          "@value": "Administrative Manager"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In het Rijksregister doorgaans de gemeente maar kan ook een consulaat zijn voor een persoon in het buitenland of de Dienst Vreemdelingenzaken voor een asielzoeker."
        },
        {
          "@language": "en",
          "@value": "In the National Register, usually the municipality but can also serve as a consulate for a person abroad or the Immigration Office for an asylum seeker."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:3fe693b4d047c97b0118be1310996dbe9e7bf2a0cc993338d39aba464e15bf3e",
