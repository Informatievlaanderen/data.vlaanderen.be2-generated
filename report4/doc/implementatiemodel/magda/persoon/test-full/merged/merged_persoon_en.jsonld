    },
    {
      "@id": "urn:oslo-toolchain:71c28580fbd014b3ab05151064ed239579adc3f5c7ea6d4d56685d63f245311d",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De juridische band tussen een kind en zijn ouder."
        },
        {
          "@language": "en",
          "@value": "The legal bond between a child and their parent."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Afstamming"
        },
        {
          "@language": "en",
          "@value": "Ancestry"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Verder te specialiseren voor dalende (ouder-kind) of stigende lijn (kind-ouder).Slaat op biologische afstamming maar evengoed op adoptie of meemoederschap."
        },
        {
          "@language": "en",
          "@value": "Further to specialize for descending (parent-child) or ascending line (child-parent). Refers to biological descent but equally to adoption or co-motherhood."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Afstamming",
      "diagramLabel": [
        {
          "@value": "Afstamming"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:30947190c0dcc55e46dcc8e7bf6abab0ea4531f0d4d181198b8e4435707ac417"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d9ea7e2c3d18f20d357fce2f43ac5f15f08426b35f87c5c4d433630b3ea2e0b2",
      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/magda/persoon#AangegevenAdres",
      "diagramLabel": [
        {
          "@value": "AangegevenAdres"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:de099dc1385d817cf323fe0e3f42c68714378ca9a8014d48935f334518528536"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Adres dat door een persoon wordt opgegeven als hoofdverblijplaats."
        },
        {
          "@language": "en",
          "@value": "Address provided by a person as the main place of stay."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "AangegevenAdres"
        },
        {
          "@language": "en",
          "@value": "IndicatedAddress"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In het Rijksregister bedoeld voor personen in het Wachtregister, het is te zeggen voor voorlopig in plaats van defintief ingeschreven personen."
        },
        {
          "@language": "en",
          "@value": "In the National Register, intended for persons in the Waiting Register, that is, for provisionally rather than definitively registered persons."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:65c7341316c043f7d540a073205a9c79139dcef0b2f306e1b8fddc0c8a7739b2",
