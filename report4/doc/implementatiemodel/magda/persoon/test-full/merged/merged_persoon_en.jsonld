        {
          "@language": "nl",
          "@value": "Registratietoestand"
        },
        {
          "@language": "en",
          "@value": "Registration status"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Geeft detail over de registratie zelf, bijvoorbeeld of de registratie nog geldig is en eventueel is gevolgd door een nieuwe registratie. Dat laatste gebeurt in het Rijksregister bijvoorbeeld bij fouten in of veranderingen aan de identificator (bijvoorbeeld bij geslachtsverandering) waardoor de registratie opnieuw moet gebeuren."
        },
        {
          "@language": "en",
          "@value": "Provides details about the registration itself, for example whether the registration is still valid and possibly followed by a new registration. The latter is done in the National Register, for example, in cases of errors or changes to the identifier (for example, in case of gender change) that require the registration to be redone."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:6b6064b32324835273bff8abd2e09a7adb5c2f192d315c6dc6d11994635a801f",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Entiteit gedurende een bepaalde periode in de werkelijkheid."
