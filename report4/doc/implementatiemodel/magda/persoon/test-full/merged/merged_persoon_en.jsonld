      "parent": [
        {
          "@id": "urn:oslo-toolchain:de099dc1385d817cf323fe0e3f42c68714378ca9a8014d48935f334518528536"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het domicillie adres voor personen die in het BIS, RAD of RAN register geregistreerd zijn bij KSZ."
        },
        {
          "@language": "en",
          "@value": "The domicile address for persons registered in the BIS, RAD, or RAN register with KSZ."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Contactadres"
        },
        {
          "@language": "en",
          "@value": "Contact address"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Enkel van toepassing voor KSZ als databron."
        },
        {
          "@language": "en",
          "@value": "Only applicable for KSZ as a data source."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:8846f62d95dd14dea2c53f6301e8ddeaf35867cd326f4f81f7a3cd660163a3d2",
      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/generiek#Uitzondering",
      "diagramLabel": [
        {
          "@value": "Uitzondering"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Afwijking van een algemene regel."
        },
        {
          "@language": "en",
          "@value": "Deviation from a general rule."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Uitzondering"
        },
        {
          "@language": "en",
          "@value": "Exception"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In dit geval een niet-kritiek probleem weer bij het uitwisselen van gegevens. Bijvoorbeeld: nieuw INSZ nummer bij het Rijksregister."
        },
        {
          "@language": "en",
          "@value": "In this case, a non-critical problem again when exchanging data. For example: new INSZ number at the National Register."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:0844ae6744c15efd314dabd86bfd02e69737cee89d4b98fd268298309326d58e",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid, een ligplaats, een standplaats of een perceel op basis van een gemeentenaam, een straatnaam, een huisnummer en eventueel een busnummer en een postcode."
        },
        {
          "@language": "en",
          "@value": "Information that allows for a structured and unique reference to a building unit, a mooring place, a pitch, or a plot based on a municipality name, a street name, a house number, and possibly a bus number and a postal code."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Belgisch Adres"
        },
        {
          "@language": "en",
          "@value": "Belgian address"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bijvoorbeeld: ingangaanduiding, trapaanduiding, verdiepaanduiding...) of een gebouwnaam of kamernaam etc. zijn mogelijk door middel van een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren met behulp van het object Adresvoorstelling."
        },
        {
          "@language": "en",
          "@value": "The definition refers to Belgian addresses. In other countries, an address may refer to other geographical objects (not building units or plots) or consist of other designations (different from house number and bus number) or of components other than street name, municipality name, or postal code. Alternative address indications other than house number or bus number (for example: entrance indication, stair indication, floor indication...) or a building name or room name, etc., are possible through association with address expansion. Exchange of foreign addresses must be done using the object Address Representation."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/adres#Adres",
      "diagramLabel": [
        {
          "@value": "Adres"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:52fd5c1f1d45b187a719db411b797936bd10f2a5e153c170bf2082eb7cb0ab94",
      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/generiek#Annotatie",
      "diagramLabel": [
