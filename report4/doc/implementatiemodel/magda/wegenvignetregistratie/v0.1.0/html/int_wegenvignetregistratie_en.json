    {
      "id": "https://schema.org/EngineSpecification",
      "vocabularyLabel": {
        "en": "MotorSpecificatie"
      },
      "applicationProfileLabel": {
        "en": "Engine Specification"
      },
      "applicationProfileDefinition": {
        "en": "Information about the engine or engines of a Vehicle."
      },
      "applicationProfileUsageNote": {
        "en": "An engine specification corresponds to one registered engine in the source and not necessarily to one physical engine. One engine specification can describe a combination of an internal combustion engine and an electric motor, for example in a hybrid vehicle. The number of engine specifications of a vehicle is therefore not a reliable indication of the actual number of engines."
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
