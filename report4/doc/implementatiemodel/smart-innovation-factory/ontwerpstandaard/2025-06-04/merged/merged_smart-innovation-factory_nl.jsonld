      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Mate waarin het resultaat van de Verkeersmeting voldoet aan de vereisten of verwachtingen."
        },
        {
          "@language": "en",
          "@value": "Extent to which the result of the TrafficMeasurement meets the requirements or expectations."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat hier om gegevens die eigen zijn aan de Verkeersmeting en die complementair zijn aan de beschrijving van de procedure die bij de meting is gevolgd (analysemethode, gebruikte Sensor edm, zie klasse Observatieprocedure)."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat hier om gegevens die eigen zijn aan de Verkeersmeting en die complementair zijn aan de beschrijving van de procedure die bij de meting is gevolgd (analysemethode, gebruikte Sensor edm, zie klasse Observatieprocedure)."
        },
        {
          "@language": "en",
          "@value": "This concerns data that is specific to the TrafficMeasurement and that is complementary to the description of the procedure followed during the measurement (analysis method, Sensor used, etc., see class ObservationProcedure)."
        }
      ],
      "domain": {
