    {
      "@id": "urn:oslo-toolchain:57e0db412f3173ce4a94310a9bfaebf4279381e2314b06991ffcc675dec2f556",
      "@type": "Datatype",
      "assignedURI": "http://www.w3.org/ns/prov#Location",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Locatie"
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "Location"
        },
        {
          "@language": "nl",
          "@value": "Locatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Locatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van een geografische positie,dmv coördinaten,een toponiem,een adreslabel,een verwijzing naar een plaats/regio,een verwijzing naar een adres of een verwijzing naar een geografisch object."
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Indication of a geographical position,by using coordinates,a toponym,an address label,a reference to a place/region,a reference to an address or to a geographical object."
        },
        {
          "@language": "nl",
          "@value": "Aanduiding van een geografische positie,dmv coördinaten,een toponiem,een adreslabel,een verwijzing naar een plaats/regio,een verwijzing naar een adres of een verwijzing naar een geografisch object."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Locatie gebruiken als de te gebruiken klasse nog niet gekend is. Anders te substitueren door instanties van Plaats, AdminstratieveEenheid, GeografischeNaam, Adres of een geografisch object zoals een Gebouw, KadastraalPerceel of Weg. Of voor te stellen door Geometrie zoals een punt, Lijnstring of Polygoon. OPMERKING: Meer info over deze klassen/datatypes in het applicatieprofiel OSLO Generiek - basis."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Use location if the applicable Class or datatype is nit yet known. Otherwise t be substituted by an instance of Place, AdministrativeUnit, GeographicalName, Address or other geographical objects like a Building, a Road or a CadastralParcel. Or to be represented by Geometry like Point, LineString, Polygon. REMARK: More info about these classes/datatypes in the application profile <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/\">OSLO-Generics</a>."
        },
        {
          "@language": "nl",
          "@value": "Locatie gebruiken als de te gebruiken klasse nog niet gekend is. Anders te substitueren door instanties van Plaats, AdminstratieveEenheid, GeografischeNaam, Adres of een geografisch object zoals een Gebouw, KadastraalPerceel of Weg. Of voor te stellen door Geometrie zoals een punt, Lijnstring of Polygoon. OPMERKING: Meer info over deze klassen/datatypes in het applicatieprofiel OSLO Generiek - basis."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
