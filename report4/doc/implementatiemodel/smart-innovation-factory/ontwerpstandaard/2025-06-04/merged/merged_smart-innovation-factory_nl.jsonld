      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het moment waarop het resultaat van de Verkeersmeting van toepassing is."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het moment waarop het resultaat van de Verkeersmeting van toepassing is."
        },
        {
          "@language": "en",
          "@value": "The moment at which the result of the TrafficMeasurement was applicable."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch het moment waarop de observatie of bemonstering plaatsvindt. Is het resultaat een voorspelling dan is de fenomeentijd het moment waarop deze voorspelling van toepassing zou moeten zijn."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch het moment waarop de observatie of bemonstering plaatsvindt. Is het resultaat een voorspelling dan is de fenomeentijd het moment waarop deze voorspelling van toepassing zou moeten zijn."
        },
        {
          "@language": "en",
          "@value": "Typically the moment at which the observation or sampling takes place. If the result is a prediction, then the phenomenon time is the moment at which this prediction should apply."
        }
      ],
      "domain": {
