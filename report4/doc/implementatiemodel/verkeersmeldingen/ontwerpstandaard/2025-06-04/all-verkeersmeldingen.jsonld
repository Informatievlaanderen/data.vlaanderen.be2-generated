    {
      "@id": "urn:oslo-toolchain:aee3360ffd1cdf7fa7d25eb302613fe16998beee14a54d99e20c4b51da81fc2d",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeting",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verkeersmeting"
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "TrafficMeasurement"
        },
        {
          "@language": "nl",
          "@value": "Verkeersmeting"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Verkeersmeting"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het vaststellen van de waarde van een bepaald kenmerk van het verkeer op een bepaald tijdstip of tussen twee tijdstippen."
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Determining the value of a certain feature of the traffic at a certain point in time or between two points in time."
        },
        {
          "@language": "nl",
          "@value": "Het vaststellen van de waarde van een bepaald kenmerk van het verkeer op een bepaald tijdstip of tussen twee tijdstippen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Verkeer wordt gedefinieerd als de verplaatsing van objecten zoals personen, vracht, data etc over media zoals land, water, lucht, kabels. In de context van dit applicatieprofiel bedoelen we met verkeer het wegverkeer. Verkeer kan betrekking hebben op objecten die zichzelf verplaatsen (al dan niet met een vervoermiddel) of objecten die vervoerd worden, maar ook op objecten waarover verkeer plaatsvindt. De meting kan het vaststellen van de waarde van een kenmerk van een individueel Voertuig of Verkeersdeelnemer tijdens zijn verplaatsing zijn (bvb zijn snelheid of nummerplaat) of van een kenmerk van de infrastructuur zoals een Wegsegment of een Rijstrook waarover het verkeer zich beweegt (bv de verkeersintensiteit). Verkeersmetingen  zijn Observaties, maw op de waarde zit een zekere foutmarge door de gebruikte meettechniek."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Traffic is defined as the movement of objects such as people, freight, data, etc. over modes such as land, water, air, cables. In the context of this application profile, by traffic we mean road traffic. Traffic can refer to objects that move themselves (with or without a means of transport) or objects that are transported, but also to objects over which traffic takes place. The measurement can be the determination of the value of a feature of an individual Vehicle or TrafficParticipant during its movement (e.g. its speed or license plate) or of a feature of the infrastructure such as a RoadSegment or a Lane over which the traffic moves (e.g. the traffic intensity ). TrafficMeasurements are Observations, in other words there is a certain margin of error on the value due to the measuring technique used."
        },
        {
          "@language": "nl",
          "@value": "Verkeer wordt gedefinieerd als de verplaatsing van objecten zoals personen, vracht, data etc over media zoals land, water, lucht, kabels. In de context van dit applicatieprofiel bedoelen we met verkeer het wegverkeer. Verkeer kan betrekking hebben op objecten die zichzelf verplaatsen (al dan niet met een vervoermiddel) of objecten die vervoerd worden, maar ook op objecten waarover verkeer plaatsvindt. De meting kan het vaststellen van de waarde van een kenmerk van een individueel Voertuig of Verkeersdeelnemer tijdens zijn verplaatsing zijn (bvb zijn snelheid of nummerplaat) of van een kenmerk van de infrastructuur zoals een Wegsegment of een Rijstrook waarover het verkeer zich beweegt (bv de verkeersintensiteit). Verkeersmetingen  zijn Observaties, maw op de waarde zit een zekere foutmarge door de gebruikte meettechniek. OPMERKING: Meer info over deze klasse in applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/verkeersmetingen\">Verkeersmetingen</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:4003b79e21603e1229273e0c500f0b31b29d880bfb80ad2c543ff90d252d68f3"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:4003b79e21603e1229273e0c500f0b31b29d880bfb80ad2c543ff90d252d68f3",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/sosa/Observation",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Observatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Observatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het vaststellen van de waarde van een bepaald kenmerk van een Object op een bepaald tijdstip of tussen twee tijdstippen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat om schattingen van de waarde, met andere woorden op de waarde zit een zekere foutmarge. Voorbeelden zijn temperatuur, klasse, kleur. Dit is verschillend van waarden die zijn toegekend en dus geen schattingen zijn zoals naam of prijs."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:928a3cd63ead8eef8cbf928f5c3df5b374d0cba02cbab9e6eabdeaa7023d90bf",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/sosa/Sensor",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sensor"
        }
      ],
      "apLabel": [
        {
          "@language": "en",
