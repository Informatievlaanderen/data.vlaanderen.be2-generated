          "@value": "location"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ligging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Locatie van de Sensor."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Locatie van de Sensor."
        },
        {
          "@language": "en",
          "@value": "Location of the Sensor."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb de coördinaten of het adres of een verwijzing naar een meetpunt of ander Bemonsteringsobject. Meerdere verschillende types van locaties kunnen worden opgegeven (bvb adres èn coördinaten). Als de Sensor een meetinstallatie is evt de verschillende meetpunten die worden omvat of een omschrijvende polygoon. OPGELET: De locatie van de Sensor is niet noodzakelijk de positie waar de Observatie gebeurt, die wordt in de eerste plaats gegeven door de ligging vh Bemonsteringsobject of het Domeinobject. Dit attribuut laat vooral toe om posities van Sensoren te beschrijven los vd metingen die er gebeuren."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb de coördinaten of het adres of een verwijzing naar een meetpunt of ander Bemonsteringsobject. Meerdere verschillende types van locaties kunnen worden opgegeven (bvb adres èn coördinaten). Als de Sensor een meetinstallatie is evt de verschillende meetpunten die worden omvat of een omschrijvende polygoon. OPGELET: De locatie van de Sensor is niet noodzakelijk de positie waar de Observatie gebeurt, die wordt in de eerste plaats gegeven door de ligging vh Bemonsteringsobject of het Domeinobject. Dit attribuut laat vooral toe om posities van Sensoren te beschrijven los vd metingen die er gebeuren."
        },
        {
          "@language": "en",
          "@value": "For example, the coordinates or the address or a reference to a measuring point or other SamplingObject. Several different types of locations can be specified (e.g. address and coordinates). If the Sensor is a measuring installation, possibly the various measuring points that are included or a descriptive polygon. NOTE: The location of the Sensor is not necessarily the position where the Observation takes place, which is primarily given by the location of the SamplingObject or DomainObject. This attribute mainly allows you to describe the positions of sensors, regardless of the measurements that take place."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:928a3cd63ead8eef8cbf928f5c3df5b374d0cba02cbab9e6eabdeaa7023d90bf"
