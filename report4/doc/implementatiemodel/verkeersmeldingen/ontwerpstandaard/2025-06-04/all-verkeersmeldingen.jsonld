        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een mogelijke waarde voor de Eigenschap."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het is aangeraden de mogelijke waarden voor de stellen als een <a href=\"https://www.w3.org/TR/skos-primer/\">skos:ConceptScheme</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:fb3b4d557da5e71029da8087f0caede01d2f8c7cad1d0e74ba667e6b4a2ff6c5",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/melding#Melding",
