      ],
      "diagramLabel": [
        {
          "@value": "busnummer"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."
        },
        {
          "@language": "en",
          "@value": "Officially assigned alphanumeric code added to the house number to distinguish multiple building units, pitches, moorings or plots that have the same house number."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Specialisatie van Adresvoorstelling.locatieaanduiding tbv Belgische adressen."
        },
