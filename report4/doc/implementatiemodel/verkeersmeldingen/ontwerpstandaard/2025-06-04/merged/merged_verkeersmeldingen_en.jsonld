  "datatypes": [
    {
      "@id": "urn:oslo-toolchain:0537ae47064ae19156eb45c4e4c44e9668f5fe209fc2c36388d3881e89381248",
      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 1-dimensionele geometrische primitieve in de tijd."
        },
        {
          "@language": "en",
          "@value": "A 1-dimensional geometric primitive in time."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Periode"
        },
        {
          "@language": "en",
          "@value": "Period"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Vergelijkbaar met een Curve in de ruimte, maar ipv een interval tussen twee punten in de ruimte gaat het hier over een interval tussen twee punten op de tijdsas. De bijbehorende tijdsduur is de temporele afstand tussen die twee punten (vergelijkbaar met de afstand tussen twee punten in de ruimte). OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bv time:Interval uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."
        },
        {
          "@language": "en",
          "@value": "Similar to a Curve in space, but instead of an interval between two points in space, this is an interval between two points on the time axis. The corresponding length of time is the temporal distance between those two points (comparable to the distance between two points in space). NOTE: More info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitution with a simpler equivalent e.g. time:Interval from the <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is recommended."
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Period",
      "diagramLabel": [
        {
          "@value": "Periode"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Periode"
        },
        {
          "@language": "en",
          "@value": "Period"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:7ebd1b7ecd5cefcbf118ea2381537f1ff197b7c44dc8118f3db4037343754fdd",
