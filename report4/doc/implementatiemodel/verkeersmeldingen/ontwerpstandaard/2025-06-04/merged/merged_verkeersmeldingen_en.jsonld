    {
      "@id": "urn:oslo-toolchain:8b8cbc29aa7b5461f63ca271f4744760fab2a98d0c7b6b1fa3884941aecfb191",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Kenmerk dat men observeert vh geobserveerdObject."
        },
        {
          "@language": "en",
          "@value": "Characteristic that one observes of the observed object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Kan een proxy zijn vh kenmerk dat men werkelijk wil observeren, bvb kleurreflectie op het aardoppervlak als subsituut voopr vegetatie. CONSTRAINT: Het geobserveerdKenmerk moet werkelijk een kenmerk zijn van het geobserveerdObject of van een (onder)deel ervan. Bv de zuurtegraad van een Bron is eigenlijk de zuurtegraad van het Waterlichaam van de Aquifer die door de Bron is aangeboord."
        },
        {
          "@language": "en",
          "@value": "Can be a proxy of the characteristic that one really wants to observe, e.g. color reflection on the earth's surface as a substitute for vegetation. CONSTRAINT: The observed Characteristic must really be a characteristic of the observed Object or of a part of it. For example, the acidity of a Source is actually the acidity of the Water Body of the Aquifer that has been tapped by the Source."
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.observedProperty",
      "diagramLabel": [
        {
          "@value": "geobserveerdKenmerk"
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:4003b79e21603e1229273e0c500f0b31b29d880bfb80ad2c543ff90d252d68f3"
      },
      "maxCount": "1",
      "minCount": "1",
      "range": {
        "@id": "urn:oslo-toolchain:130e6383e8cbc25acbf09c99a5dadb7c85eac421a63a2f5b80156cc5f693b550"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "geobserveerd kenmerk"
        },
        {
          "@language": "en",
          "@value": "Observed characteristic"
        }
      ]
    },
