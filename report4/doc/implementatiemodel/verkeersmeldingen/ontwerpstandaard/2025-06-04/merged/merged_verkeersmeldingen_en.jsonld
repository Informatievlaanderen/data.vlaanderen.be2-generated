    {
      "@id": "urn:oslo-toolchain:fb3b4d557da5e71029da8087f0caede01d2f8c7cad1d0e74ba667e6b4a2ff6c5",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijft de melding van een probleem of een vaststelling die mogelijks aanleiding geeft tot een actie van de overheid."
        },
        {
          "@language": "en",
          "@value": "Describes the report of a problem or a finding that may give rise to government action."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De Melding kan gebruikt worden voor het capteren van feedback met betrekking tot concrete informatievelden (bv. foutieve of ontbrekende informatie wordt weergegeven) of feedback dat slaat op reële wereld objecten zoals een put in de weg of sluikstort."
        },
        {
          "@language": "en",
          "@value": "The Notification can be used to capture feedback with regard to concrete information fields (e.g. incorrect or missing information is displayed) or feedback that relates to real world objects such as a pothole in the road or illegal dumping."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/melding#Melding",
      "diagramLabel": [
        {
          "@value": "Melding"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:c03be8a6cb31eaf3a661d6b0c5c5da28d48df28bcf09ce41ef1e2e2c90917cb9"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijft de melding van een probleem of een vaststelling die mogelijks aanleiding geeft tot een actie van de overheid."
        },
        {
          "@language": "en",
          "@value": "Describes the report of a problem or a finding that may give rise to government action."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Melding"
        },
        {
          "@language": "en",
          "@value": "Notification"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Een melding kan gebruikt worden voor vaststellingen in de echte wereld,bijvoorbeeld het melden van een put in de weg of sluikstort,of voor het melden van fouten of onvolledigheden in digitale gegevensbronnen."
        },
        {
          "@language": "en",
          "@value": "A report can be used for real-world findings, for example reporting a pit in the road or illegal dumping, or for reporting errors or omissions in digital data sources."
        }
      ]
    },
