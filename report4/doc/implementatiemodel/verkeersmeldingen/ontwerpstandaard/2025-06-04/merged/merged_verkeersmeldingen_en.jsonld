    {
      "@id": "urn:oslo-toolchain:e797f5ab415387e643b81a0628e301a05483c7e12505b597452386c52a5743a3",
      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De Status van de Melding in het verwerkingsproces op een bepaald tijdstip."
        },
        {
          "@language": "en",
          "@value": "The Status of the Notification in the processing process at a certain point in time."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Meldingstatus"
        },
        {
          "@language": "en",
          "@value": "Notification status"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De Melding kan gelinkt zijn aan meerdere Status objecten,elk ervan geeft de status op een bepaald tijdstip weer."
        },
        {
          "@language": "en",
          "@value": "The Notification can be linked to several Status objects, each of which indicates the status at a certain time."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/melding#Meldingstatus",
      "diagramLabel": [
