    },
    {
      "@id": "urn:oslo-toolchain:60edb2a53e274cde1ebb5c5514e4a620a7d664bece1b37fb87b9e9d47d651c2e",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een mogelijke waarde voor de Eigenschap."
        },
        {
          "@language": "en",
          "@value": "A possible value for the Property."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het is aangeraden de mogelijke waarden voor de stellen als een <a href=\"https://www.w3.org/TR/skos-primer/\">skos:ConceptScheme</a>."
        },
        {
          "@language": "en",
          "@value": "It is recommended to set the possible values for the sets as a <a href=\"https://www.w3.org/TR/skos-primer/\">skos:ConceptScheme</a>."
        }
      ],
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
