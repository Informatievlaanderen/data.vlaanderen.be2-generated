        }
      ],
      "diagramLabel": [
        {
          "@value": "Straatnaam"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Adrescomponent met de naam die officieel werd toegekend aan een straat (baan, doorgang, plein) of aan een gehucht en waaraan adressen kunnen zijn gekoppeld."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
