        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:254b81307680e062ad8fa2f25119da8224f25ac703b22fe9d399454257839e84",
      "@type": "http://www.w3.org/2002/07/owl#Class"
    },
    {
      "@id": "urn:oslo-toolchain:bf102d45f93c751819aecbc32a8e4bf911c0e90dc55dc361be567ec5ba544a87",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Opeenvolgende acties of stappen noodzakelijk om een resultaat te bekomen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze contextde manier waarop het resultaat van een Observatie is verkregen. Dat kan dmv een instrument of een sensor zijn; maar het kan ook een menselijke observator zijn of een simulatie of een verwerking of algoritme toegepast op meer primitieve resultaten. Het Proces vormt samen met het Bemonsteringsobject dat is gebruikt het zgn observatieprotocol. OPGELET: deze klasse is abstract, ze moet gespecialiseerd worden in functie van het applicatiedomein. OPMERKING: Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/observaties-en-metingen/\">OSLO Observaties en Metingen</a>."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Process",
      "diagramLabel": [
        {
          "@value": "Proces"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Proces"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:1a204e0b0e92e775ad11006c222b9eda03e99e798f44863fc1aafdb0dcff6cf7",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Vastgelegde of officiële manier om iets te doen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Procedure"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze context het uitvoeren van Observaties, Bemonstering of de Bediening van Actuators. Neemt in praktijk de vorm aan van een workflow, protocol, plan, algoritme, berekeningswijze etc."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://www.w3.org/ns/sosa/Procedure",
