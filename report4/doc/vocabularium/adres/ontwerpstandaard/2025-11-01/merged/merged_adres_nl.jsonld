    {
      "@id": "urn:oslo-toolchain:9bccef066a53000551d5cea1de644245d53338e3e46558ae8eab4e8a8499485d",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/adres#Ligplaats",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Ligplaats"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Ligplaats"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een door het bevoegde gemeentelijke orgaan als zodanig aangewezen plaats in het water al dan niet aangevuld met een op de oever aanwezig terrein of een gedeelte daarvan, die bestemd is voor het permanent afmeren van een voor woon-, bedrijfsmatige of recreatieve doeleinden geschikt vaartuig."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld plaats voor woonboot."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
