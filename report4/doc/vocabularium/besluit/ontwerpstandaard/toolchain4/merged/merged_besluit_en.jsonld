      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Handeling van bepaalde duur op of met entiteiten."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
