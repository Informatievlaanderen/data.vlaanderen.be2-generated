        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7711a904afa347467bc931f9be5cf1bb1dafa55a44a5b4c7b3994d5a4f7df51c",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19103/2005/RecordsAndClassMetadata#Record",
