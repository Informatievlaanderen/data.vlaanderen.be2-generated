  "classes": [
    {
      "@id": "urn:oslo-toolchain:60a6b7205a65ecf15467ba855311ff2073ab4dced98a5a27ae716a77ae0a9dad",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#Interpretatie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Interpretatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Interpretatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoonlijk beredeneerd oordeel over de betekenis van iets."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van Observaties en Metingen is een Interpretatie het resultaat van het toepassen van bestaande kennis op bestaande Observaties. Het onderscheid tussen een Interpretatie en een \"gewone\" Observatie is niet absoluut, in beide gevallen gaat het over het schatten van de waarde van een kenmerk. In het geval van een Interpretatie heeft de Observatie echter meer betekenis (meer \"semantische lading\") omdat er meer theorie en/of verwerking aan te pas komt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:da2dd4d9364034f17b55aeed6eafb81d5bbeb5c5da9d69b7905b9b7b9d44f86c",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
