        {
          "@language": "nl",
          "@value": "Fractiemeting"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Fractiemeting"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Meetreeks waarbij het aandeel van iets varieert in functie van iets anders."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dat aandeel wordt \"fractie\" genoemd. Vb is de statistische verdeling van onderwijsniveaus over de bevolking of de verdeling van korreldiameters in een bodemstaal."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
