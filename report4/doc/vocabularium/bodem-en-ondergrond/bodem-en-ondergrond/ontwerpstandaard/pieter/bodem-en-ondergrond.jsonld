    {
      "@id": "urn:oslo-toolchain:9cad3c0fef10d65d988676f422946a5a3abf030db665bed4f9064c4133e14cea",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#Fractiemeting",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Fractiemeting"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Fractiemeting"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Meetreeks waarbij het aandeel van iets varieert in functie van iets anders."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dat aandeel wordt \"fractie\" genoemd. Bijvoorbeeld is de statistische verdeling van onderwijsniveaus over de bevolking of de verdeling van korreldiameters in een bodemstaal."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        },
        {
          "@id": "urn:oslo-toolchain:4616a5bf3e5de29536c17281106ad6c0d2ec92dbc2cb20dc1a16754af3313a6e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:80b085f34be0e59c4eb4ea029d2efe485e45f8e7c9bc026c98cf5d57f6529f0a",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#Boring",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Boring"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Boring"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het aanbrengen van een gat in iets door middel van een boor."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In het vocabularium Bodem & Ondergrond gebruiken we deze klasse louter als generalisatie van Grondboringen en Bodemboringen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6cc36fb228052d9330331780fd2c0e41cd91d02680984e07db6aac90905713e8",
      "@type": "Class",
      "assignedURI": "http://purl.org/dc/terms/Agent",
