  "classes": [
    {
      "@id": "urn:oslo-toolchain:60a6b7205a65ecf15467ba855311ff2073ab4dced98a5a27ae716a77ae0a9dad",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#Interpretatie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Interpretatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Interpretatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoonlijk beredeneerd oordeel over de betekenis van iets."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van Observaties en Metingen is een Interpretatie het resultaat van het toepassen van bestaande kennis op bestaande Observaties. Het onderscheid tussen een Interpretatie en een \"gewone\" Observatie is niet absoluut, in beide gevallen gaat het over het schatten van de waarde van een kenmerk. In het geval van een Interpretatie heeft de Observatie echter meer betekenis (meer \"semantische lading\") omdat er meer theorie en/of verwerking aan te pas komt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:da2dd4d9364034f17b55aeed6eafb81d5bbeb5c5da9d69b7905b9b7b9d44f86c",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Erkenningtype"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Erkenningtype"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Erkenningtype"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e3011dcd1a26a3a6368f84fb32f21a40dd21eadfa367309ad7f0b2a9223e416c",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19103/2005/UnitsOfMeasure#Measure",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Maat"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Maat"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Maat"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een (af)gemeten hoeveelheid van een bepaalde grootheid, uitgedrukt in een bepaalde eenheid."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Implementeren zoals beschreven in <a href=\"https://www.iso.org/standard/56734.html\">ISO19103</a> of substitueren door een <a href=\"https://schema.org/QuantitativeValue\">schema.org:QuantitativeValue</a> of <a href=\"https://qudt.org/schema/qudt/QuantityValue\">qudt:QuantityValue</a>. Waarde en eenheid moeten afzonderlijk worden beschreven, de eenheid door middel van een Literal (bijvoorbeeld <a href=\"https://ci.mines-stetienne.fr/lindt/v4/custom_datatypes#ucumunit\">ucum:ucumunit</a> of <a href=\"https://def.isotc211.org/ontologies/iso19103/2015/MeasureTypes.rdf\">iso:UnitOfMeasure.uomIdentifier</a>) of door een <a href=\"https://qudt.org/schema/qudt/Unit\">qudt:Unit</a> of <a href=\"http://www.w3.org/2004/02/skos/core#Concept\">skos:Concept</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f8265d948cdaad60609797d9ff5c4e84c9269923286770a24217a1da97878df7",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19109/2005/GeneralFeatureModel#GF_PropertyType",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kenmerktype"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Kenmerktype"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Kenmerktype"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Klasse die kenmerken van instanties van om het even welk type vertegenwoordigt."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van Observaties en Metingen is dit een kenmerk van het geobseveerdObject (of van het bemonsterdObject of een onderdeel daarvan) en in principe van alle instanties van dat type geobserveerdObject. Bijvoorbeeld Lichaamstemperatuur, Lithologie, ChemischeSamenstelling (resp van een Persoon, een GeologischeEenheid en - meer indirect - van een Monster genomen op een bepaalde plek in een Rivier). Substitueren door een <a href=\"https://www.w3.org/TR/skos-reference/#Concept\">skos:Concept</a> OF een instantie van een equivalente klasse bijvoorbeeld <a href=\"https://qudt.org/schema/qudt/QuantityKind\">qudt:QuantityKind</a> OF eigen subklasse."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7ff39b9c879a8cfe8de6e5ea9b88ecf6e66e4e67b55625ce2bcb67e65057a9b1",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeature",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bemonsteringsobject"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Bemonsteringsobject"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bemonsteringsobject"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Deel van het Object dat men wil observeren en dat representatief is voor dat Object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het deel waarvan sprake kan fysiek zijn (een Monster) of ruimtelijk (een RuimtelijkBemonsteringsobject). Men observeert een Bemonsteringsobject ipv het werkelijk Object als dat laatste niet in zijn geheel geobserveerd kan worden (bijvoorbeeld omdat exhaustieve observatie onpraktisch zou zijn). Het Bemonsteringsobject vormt samen met het Proces dat voor observatie is gebruikt het zgn observatieprotocol. OPGELET: deze klasse is abstract, ze moet gespecialiseerd worden in functie van het applicatiedomein."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:28436ca796dc7b47d128ca145c32da19b0da42134c61e10b67d1acbccd9d294e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a84bec9cadbc4934173d2ad5726502dd0b62b046a182fbb26f98d158e4350e2e",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/SpatialSamplingFeature#SF_SpatialSamplingFeature",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "RuimtelijkBemonsteringsobject"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "RuimtelijkBemonsteringsobject"
        }
      ],
      "diagramLabel": [
        {
          "@value": "RuimtelijkBemonsteringsobject"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Ruimtelijk begrensd deel van het Object dat men observeert en dat representatief wordt geacht voor dat Object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Wordt gebruikt als het geobserveerd Object een zekere omvang heeft waardoor het niet in zijn geheel geobserveerd kan worden. Afhankelijk van de toegankelijkheid van het Object en de aard van de variatie van het geobserveerd Kenmerk binnen het Object, wordt gekozen voor een RuimtelijkBemonsteringsobject in 1, 2 of 3 dimensies."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7ff39b9c879a8cfe8de6e5ea9b88ecf6e66e4e67b55625ce2bcb67e65057a9b1"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7711a904afa347467bc931f9be5cf1bb1dafa55a44a5b4c7b3994d5a4f7df51c",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19103/2005/RecordsAndClassMetadata#Record",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Record"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Record"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Basis datastructuur bestaande uit een collectie van velden van mogelijk verschillende datatypes, typisch een vast aantal in een bepaalde volgorde."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:bf102d45f93c751819aecbc32a8e4bf911c0e90dc55dc361be567ec5ba544a87",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Process",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Proces"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Proces"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Opeenvolgende acties of stappen noodzakelijk om een resultaat te bekomen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze contextde manier waarop het resultaat van een Observatie is verkregen. Dat kan door middel van een instrument of een sensor zijn; maar het kan ook een menselijke observator zijn of een simulatie of een verwerking of algoritme toegepast op meer primitieve resultaten. Het Proces vormt samen met het Bemonsteringsobject dat is gebruikt het zgn observatieprotocol. OPGELET: deze klasse is abstract, ze moet gespecialiseerd worden in functie van het applicatiedomein."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:4616a5bf3e5de29536c17281106ad6c0d2ec92dbc2cb20dc1a16754af3313a6e",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#Meetreeks",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Meetreeks"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Meetreeks"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie waarbij wordt nagegaan hoe een bepaald kenmerk verandert in functie van een ander kenmerk."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld hoe de lengte van een Object verandert met de temperatuur (door uitzetting). We kunnen dit uitdrukken als y=f(x) waarbij in het bijvoorbeeld y de lengte is en x de temperatuur. De variabele x noemen we de meetpuntparameter en y is de meetwaardeparameter. De meetwaardeparameter is in feite het geobserveerdKenmerk. Sommige types van Meetreeksen zijn zo specifiek dat ze apart werden gemodelleerd, bijvoorbeeld een Bereikobservatie waarbij een geobserveerdKenmerk varieert volgens positie of tijd (zie het <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/observaties-en-metingen/\">AP Observaties & Metingen</a> voor meer info over deze klasse)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:00c347313161b995c2a21c0104a6c334b7d6d2af352e9e4956699bb3ea7a12ef",
