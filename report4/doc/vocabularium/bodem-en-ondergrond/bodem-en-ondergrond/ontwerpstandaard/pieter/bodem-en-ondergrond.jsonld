          "@value": "Maaiveld"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het grondoppervlak, waarvan de hoogte vaak opgegeven wordt ten opzichte van een nationaal nul-niveau."
        }
      ],
