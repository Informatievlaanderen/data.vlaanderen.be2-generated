    {
      "@id": "urn:oslo-toolchain:da6135f5dbbf46779edecc13c1ceb1f8f5e0b84a36bce6ea96933d417c7089b5",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#BO_RuimtelijkBemonsteringsobject",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "BoRuimtelijkBemonsteringsobject"
        }
      ],
      "diagramLabel": [
        {
          "@value": "BO_RuimtelijkBemonsteringsobject"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "RuimtelijkBemonsteringsobject met bijkomende kenmerken relevant voor het domein Bodem en Ondergrond."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat over kenmerken die typisch zijn in de context van Bemonstering in het domein Bodem en Ondergrond. Bijvoorbeeld bij Boringen, Sonderingen en dergelijkem is er de noodzaak om precies het maaiveld te definiëren. OPMERKING: Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/bodem-en-ondergrond\">OSLO Bodem en Ondergrond</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:53c5dc6f2dd53b2aba3c694134999b4554b513cbe1c434f6da304ca2a8b63e41",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem#Bodemlaag",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bodemlaag"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bodemlaag"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deel van de bodem met een zekere verticale omvang, min of meer evenwijdig aan het maaiveld, dat niet bepaald wordt door pedogene processen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit object is bedoeld voor lagen die niet ontwikkeld zijn door pedogene processen. Deze laag is in het veld niet noodzakelijk visueel of op andere manier onderscheidbaar en hoeft niet op basis van observaties gedefiniëerd te worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:eaa31c665416597082f6cc1cabf87b148aed0b2e1ab08257fabfe1f8d7a1ca0e"
        },
        {
          "@id": "urn:oslo-toolchain:50cf6e994c125f9a273df8dfbd051de35dcbd7ef66a61da65d9282752c16ccba"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7c4bf16d4f75d05b21a8f7f90de546e50c1041323c38022f51ad0ee16bedaabc",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/sosa/Sampling",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bemonstering"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Bemonstering"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bemonstering"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Handeling waarbij een bepaalde Bemonsteringsprocedure wordt uitgevoerd om één of meer Bemonsteringsobjecten te bekomen of waarbij deze worden bewerkt."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld het breken van een rotsmonster, het graven van een profielput, het verdelen van een site in kwadranten, bloed trekken bij een patient, een meetpunt opzetten voor bijvoorbeeld milieumonitoring, een luchtfoto nemen, een bodemmonster zeven, een deelpopulatie selecteren, een boorkern bemonsteren etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d0695cbacd454b369ad61e26cb1a35d45e9daef6f8dc9920fef4bb8bdf5305d0",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/sosa/om#SamplingProcedure",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bemonsteringsprocedure"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Bemonsteringsprocedure"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bemonsteringsprocedure"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een workflow, protocol, plan, algoritme of berekeningswijze waarin wordt gespecifieerd hoe de Bemonstering moet worden uitgevoerd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bijvoorbeeld hoe boringen moeten plaatsvinden of peilbuizen moeten worden geplaatst of hoe precies bodem- of grondwaterstalen moeten worden genomen of bewerkt. De procedures zijn doorgaans bedoeld om bij meer dan één Bermonstering te worden toegepast."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:db2e78dbd6254347b8ef1cf5efe7b4bb512638c780dc9bff84e4205f39e698d1"
        },
