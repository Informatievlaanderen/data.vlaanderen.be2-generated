      "vocLabel": [
        {
          "@language": "nl",
          "@value": "fenomeentijd"
        }
      ],
      "diagramLabel": [
        {
          "@value": "fenomeentijd"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het moment waarop het resultaat van de Observatie van toepassing was."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch het moment waarop geobserveerd of bemonsterd werd. Als de Observatie temporeel is en het moment waarop iets plaatsvindt wordt geregistreerd dan is dit meteen ook de fenomeentijd."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
      },
