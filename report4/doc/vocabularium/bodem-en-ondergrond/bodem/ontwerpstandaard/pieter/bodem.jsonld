      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Laag in de bodem met een zekere verticale omvang, min of meer evenwijdig aan het maaiveld en homogeen voor de meeste morfologische en analytische kenmerken en onstaan door pedogene processen."
        }
      ],
      "vocUsageNote": [
