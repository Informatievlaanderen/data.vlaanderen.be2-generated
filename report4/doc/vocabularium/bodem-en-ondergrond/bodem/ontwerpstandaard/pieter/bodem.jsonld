        {
          "@language": "nl",
          "@value": "ExtraBodemklasse"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ExtraBodemklasse"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijving van een bodem volgens een bijkomend bodemclassificatiesysteem."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Hieronder verstaan we een classificatiesysteem anders dan de Belgische bodemclassificatie of de WRB bodemclassificatie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
