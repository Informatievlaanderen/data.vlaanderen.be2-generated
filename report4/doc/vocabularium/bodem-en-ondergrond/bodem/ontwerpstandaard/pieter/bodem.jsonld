        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:498956bda415cdc823c6f91b8ffa811739c528f7866777726d74a53e119cfbe0",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
