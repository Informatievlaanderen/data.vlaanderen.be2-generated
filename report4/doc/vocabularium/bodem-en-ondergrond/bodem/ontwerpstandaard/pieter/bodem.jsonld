        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze context het uitvoeren van Observaties, Bemonstering of de Bediening van Actuators. Neemt in praktijk de vorm aan van een workflow, protocol, plan, algoritme, berekeningswijze etc."
        }
      ],
