      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Plaats waar het Monster werd genomen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Als het Monster een geassocieerdBemonsteringsobject heeft dat ondubbelzinnig gelocaliseerd is dan is dit attribuut overbodig. Uitzondering in dat geval is wanneer de plaats tov het Bemonsteringsobject daarbij van belang is, bijvoorbeeld de diepte waarop een bodemmonster is genomen bij een boring. Datatype is Geometrie om naast puntlocaties ook een ruimere begrenzing te kunnen opgeven (bijvoorbeeld een diepte-interval in het geval van een bodemmonster)."
        }
      ],
      "domain": {
