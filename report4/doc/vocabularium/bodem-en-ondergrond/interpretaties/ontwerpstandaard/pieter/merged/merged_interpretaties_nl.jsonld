  "classes": [
    {
      "@id": "urn:oslo-toolchain:fbb5ffd8f224b9b4d16a9b9b26072db9c3508712ad7c20e8f258efaa1ad04af6",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/interpretaties#FormeleStratigrafieBereikInterpretatie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "FormeleStratigrafieBereikInterpretatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "FormeleStratigrafieBereikInterpretatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie van de opeenvolgende gesteentelagen waarbij de lagen worden aangeduid volgens een welbepaalde standaard."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is een Interpretatie omdat ze gebaseerd is op een combinatie van andere Observaties en bestaande kennis. Die andere Observaties zijn in dit geval typisch Observaties van de lithologie van aangeboord materiaal. Een StratigrafischeInterpretatie is een DiscreetBereikObservatie omdat de stratigrafie (logischerwijs) varieert met de diepte."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:60a6b7205a65ecf15467ba855311ff2073ab4dced98a5a27ae716a77ae0a9dad"
        },
        {
          "@id": "urn:oslo-toolchain:946f17dc11353bf39304d5836899f8a04250206d52d2078ffb10b1667d26b859"
        },
        {
          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Observatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Observatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het vaststellen van de waarde van een bepaald kenmerk van een Object op een bepaald tijdstip of tussen twee tijdstippen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat om schattingen van de waarde, maw op de waarde zit een zekere foutmarge. Voorbeelden zijn temperatuur, klasse, kleur. Dit is verschillend van waarden die zijn toegekend en dus geen schattingen zijn zoals naam of prijs."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:12792aaed5914808177ddb48950daef2835441b457d7444d354d5ea7c7f1fcf0",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/interpretaties#GecodeerdeLithologieBereikInterpretatie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "GecodeerdeLithologieBereikInterpretatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GecodeerdeLithologieBereikInterpretatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie van de aard van de gesteenten die opeenvolgend in de grond voorkomen waarbij de aard wordt aangeduid adhv een gestandaardiseerde codelijst."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is een Interpretatie omdat ze gebaseerd is op een combinatie van andere Observaties en bestaande kennis. Die andere Observaties zijn in dit geval typisch kenmerken van het aangeboord materiaal zoals textuur, materiaal, kleur, mineralen, fossielen en dergelijkem. Een LithologischeInterpretatie is een DiscreetBereikObservatie omdat de lithologie varieert met de diepte."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:60a6b7205a65ecf15467ba855311ff2073ab4dced98a5a27ae716a77ae0a9dad"
        },
        {
          "@id": "urn:oslo-toolchain:946f17dc11353bf39304d5836899f8a04250206d52d2078ffb10b1667d26b859"
        },
        {
          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:c3e52de92326f9d62b0d698c3904ee6318548cb5fad35bcfa0135ff3f684b830",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/interpretaties#HydrostratigrafieBereikInterpretatie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "HydrostratigrafieBereikInterpretatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "HydrostratigrafieBereikInterpretatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie over de stroming van water in de grond."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is een Interpretatie omdat ze gebaseerd is op een combinatie van andere Observaties en bestaande kennis. Die andere Observaties zijn in dit geval typisch de bestaande lithologie en stratigrafie. Een HydrogeologischeInterpretatie is een DiscreetBereikObservatie omdat de geohydrologische kenmerken variëren met de diepte."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
