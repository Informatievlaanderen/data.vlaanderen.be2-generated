        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "DiscreetBereik waarbij het fenomeen curvegewijs varieert in de ruimte."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het fenomeen komt enkel voor langs bepaalde lijnen in een gebied (bv straatnamen van wegsegmenten of bodemlagen in een boorgat) of werd enkel bepaald voor een welgekozen set van curves (bv regelmatige intervallen langs een traject of een profiel)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
