          "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:27320ac2997d249e0937a651be4c4e903f79af34abd279dd088c13a9ccdab997",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/interpretaties#AntropogeneKenmerkenBereikInterpretatie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "AntropogeneKenmerkenBereikInterpretatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "AntropogeneKenmerkenBereikInterpretatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie van door de mens geïntroduceerde kenmerken van bodem en ondergrond."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld stratigrafische gevolgen bijvoorbeeld lagen met sporen van olie of dunnere sedimentlagen ten gevolge van afdamming van rivieren of zgn technofossielen (mensgemaakte objecten zoals plastic flessen of mobiele telefoons)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:60a6b7205a65ecf15467ba855311ff2073ab4dced98a5a27ae716a77ae0a9dad"
        },
