        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Formele beschrijving van opeenvolgende gesteentelagen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Met formeel bedoelen we dat de lagen zijn toegekend volgens een welbepaalde standaard."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
