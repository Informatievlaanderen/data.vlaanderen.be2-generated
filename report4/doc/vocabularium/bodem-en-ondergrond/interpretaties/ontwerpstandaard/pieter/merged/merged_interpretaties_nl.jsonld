        }
      ],
      "diagramLabel": [
        {
          "@value": "QuartairStratigrafielaag"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Formele beschrijving van een stratigrafische laag uit het Quartair."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Specialisatie van een CurveWaardepaar, dit is een Curve en de waarde die eraan is toegekend. De waarde is hier de formele beschrijving van de stratigrafie, terwijl de Curve aangeeft op welke dieptes deze beschrijving geldig is. De dieptes worden gegeven volgens een verticaal referentiesysteem OF tov de Curve van de Grondboring als deze recht in de grond is geboord."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
