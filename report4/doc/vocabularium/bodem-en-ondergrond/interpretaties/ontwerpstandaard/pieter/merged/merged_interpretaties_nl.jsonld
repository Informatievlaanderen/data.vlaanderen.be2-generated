    {
      "@id": "urn:oslo-toolchain:ee933c0c6b8e3662c4c2daee0d9b809ba5fb77cbf1adbaf57c8da22d2303ccd8",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation",
