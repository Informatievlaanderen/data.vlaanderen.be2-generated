      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#ObservationContext.relatedObservation",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "geassocieerdeObservatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "geassocieerdeObservatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Observaties waarvan de resultaten op een of andere manier samenhangen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat om samenhang die van belang is om het resultaat van individuele Observaties te begrijpen, bijvoorbeeld biotische relaties (dier A is roofdier en is aanwezig omdat dier B prooi voorkomt). Dergelijke relaties vereisen expliciet te worden beschreven (in tegenstelling tot relaties zoals het samenvallen van resultaten van Observaties in ruimte of tijd die impliciet mogen blijven). Ook nuttig voor relaties waarbij de output van Observatie A de input vormt voor Observatie B."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
      },
