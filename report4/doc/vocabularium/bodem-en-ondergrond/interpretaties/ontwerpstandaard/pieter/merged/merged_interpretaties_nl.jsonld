        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoonlijk beredeneerd oordeel over de betekenis van iets."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van Observaties en Metingen is een Interpretatie het resultaat van het toepassen van bestaande kennis op bestaande Observaties. Het onderscheid tussen een Interpretatie en een \"gewone\" Observatie is niet absoluut, in beide gevallen gaat het over het schatten van de waarde van een kenmerk. In het geval van een Interpretatie heeft de Observatie echter meer betekenis (meer \"semantische lading\") omdat er meer theorie en/of verwerking aan te pas kwam."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
