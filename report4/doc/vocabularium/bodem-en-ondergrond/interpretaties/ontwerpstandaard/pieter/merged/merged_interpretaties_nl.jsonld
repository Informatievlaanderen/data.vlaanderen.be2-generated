    {
      "@id": "urn:oslo-toolchain:8e591d1f4379d1216afe78a4d6a71be0fd47bacdb8e5b9fa993f8993f967b839",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/interpretaties#InformeleStratigrafieBereik",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "InformeleStratigrafieBereik"
        }
      ],
      "diagramLabel": [
        {
          "@value": "InformeleStratigrafieBereik"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Informele beschrijving van de opeenvolgende gesteentelagen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Met informeel bedoelen we dat de beschrijving niet gebeurt volgens een welbepaalde standaard of gebeurt adhv een verouderde of niet-aanvaarde standaard."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
