    {
      "@id": "urn:oslo-toolchain:88decbef5016f4086d9cb8b1e388a741bb9cfc2b82c0c818a3c719344b2d6ca7",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/interpretaties#FormeleStratigrafieBereik",
