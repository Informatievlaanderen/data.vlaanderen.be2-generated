    {
      "@id": "urn:oslo-toolchain:167402ed2cbf0bb6406e094c8620b9163be72d1caf6f9353e2e83d7557a64efe",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/interpretaties#GeotechnischeCoderingBereikInterpretatie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "GeotechnischeCoderingBereikInterpretatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GeotechnischeCoderingBereikInterpretatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie van de eigenschappen van de grond voor bouwkundige toepassingen waarbij de deze worden aangeduid adhv een gestandaardiseerde codelijst."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is een Interpretatie omdat ze gebaseerd is op een combinatie van andere Observaties en bestaande kennis. Die andere Observaties zijn in dit geval typisch andere Interpretaties zoals LithologischeInterpretaties, analyses van Grondmonsters (bijvoorbeeld Korrelgrootteverdeling en grondsoort), de Observaties die doorgaans bij Sonderingen plaatsvinden etc). Een Geotechnischeinterpretatie is een DiscreetBereikObservatie omdat de geotechnische kenmerken variëren met de diepte."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:60a6b7205a65ecf15467ba855311ff2073ab4dced98a5a27ae716a77ae0a9dad"
