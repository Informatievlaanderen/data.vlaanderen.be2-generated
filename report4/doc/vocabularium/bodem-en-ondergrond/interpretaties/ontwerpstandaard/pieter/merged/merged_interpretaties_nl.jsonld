    {
      "@id": "urn:oslo-toolchain:e3ac6fb5500b1c0f644d3f4d729dd3adc6405c34fd38b2ed64e3e632b3185e7e",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/bodem-en-ondergrond/interpretaties#QuartairStratigrafieBereikInterpretatie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "QuartairStratigrafieBereikInterpretatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "QuartairStratigrafieBereikInterpretatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie van de opeenvolgende gesteentelagen uit het Quartair waarbij de lagen worden aangeduid volgens een welbepaalde standaard."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is een Interpretatie omdat ze gebaseerd is op een combinatie van andere Observaties en bestaande kennis. Die andere Observaties zijn in dit geval typisch Observaties van de lithologie van aangeboord materiaal. Een StratigrafischeInterpretatie is een DiscreetBereikObservatie omdat de stratigrafie (logischerwijs) varieert met de diepte."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
