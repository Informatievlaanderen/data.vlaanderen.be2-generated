    {
      "@id": "urn:oslo-toolchain:6d7693f9274bdd2c0c04a1ddb7b22b4c7465ffff58a73ffd26d00d8213a18dca",
      "@type": "Datatype",
      "assignedURI": "https://data.vlaanderen.be/ns/generiek#DirectePositie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "DirectePositie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DirectePositie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Houder van de coördinaten van een positie in een coördinaatreferentiesysteem."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch gebruikt om de geometrie van een ruimtelijk object te beschrijven of de geometrische primitieven (bijvoorbeeld punt, Lijn, Vlak...) waaruit dat object is samengesteld. Een DirectePositie kan echter ook op zichzelf staan om een positie in de ruimte te beschrijven. De positie wordt gegeven in een coördinaatreferentiesysteem. Dat referentiesysteem wordt expliciet bij de DirectePositie opgegeven, tenzij deze deel uitmaakt van een ruimtelijk object (bijvoorbeeld een geometrische primitieve) waar al een referentiesysteem wordt vermeld. Ter info: Een coördinaatreferentiesysteem verschilt van een indirect ruimtelijk referentiesysteem in die zin dat posities direct door middel van coördinaten worden opgegeven ipv indirect door een adres of plaatsnaam."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
