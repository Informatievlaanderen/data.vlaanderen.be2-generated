        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Gecodeerde beschrijving van een lithologische laag."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Specialisatie van een CurveWaardepaar, dit is een Curve en de waarde die eraan is toegekend. De waarde is hier de gecodeerde beschrijving van de lithologie, terwijl de Curve aangeeft op welke dieptes deze beschrijving geldig is. De dieptes worden gegeven volgens een eendimensionaal verticaal referentiesysteem OF tov de Curve van de Grondboring als deze recht in de grond is geboord."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b6d3ed9011785d95369170806a19f3b9b7fbb4c537826ac63ae18993337f3cce"
