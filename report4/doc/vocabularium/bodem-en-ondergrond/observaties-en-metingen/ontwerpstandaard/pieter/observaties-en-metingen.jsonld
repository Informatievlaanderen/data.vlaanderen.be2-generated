          "@value": "Classificatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie waarbij het resultaat categorisch is."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch bij Observaties waarbij getracht wordt de geobserveerdeObjecten in te delen volgens een bepaald classificatiesysteem. Bijvoorbeeld het determineren van een plant, het bepalen van het bodemtype, het klasseren op kleur. Datatype van het resultaat is een <a href=\"http://www.w3.org/2004/02/skos/core#Concept\">skos:Concept</a>, maw een waarde uit een codelijst."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
