        }
      ],
      "diagramLabel": [
        {
          "@value": "PuntBereikObservatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "DiscreetBereikObservatie waarbij het fenomeen puntgewijs varieert in de ruimte."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het kan gaan om de observatie van een fenomeen dat werkelijk enkel voorkomt op bepaalde punten in het onderzochte gebied (bijvoorbeeld exemplaren van een bepaalde plantensoort) of een fenomeen waarvan de waarde enkel gemeten werd op bepaalde representatieve punten (bijvoorbeeld reflectiegraad volgens een regelmatig rooster van meetpunten). Resultaat van een PuntbereikObservatie is een DiscreetPuntbereik, concreet is dit een set van PuntWaardeparen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
