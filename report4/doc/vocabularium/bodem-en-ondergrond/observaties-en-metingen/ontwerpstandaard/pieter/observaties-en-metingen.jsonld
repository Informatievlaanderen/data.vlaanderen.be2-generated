      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie waarbij het resultaat complex is."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het resultaat van een Observatie kan soms niet voorgesteld worden door middel van een primitief datatype zoal een Integer of een URI, soms is een meer complexe structuur nodig. Bijvoorbeeld de opsomming van stoffen waaruit een monster is samengesteld bij een spectrometrie. Datatype is een Record en kan dus diverse vormen aannemen al naargelang het geval."
        }
      ],
