    {
      "@id": "urn:oslo-toolchain:76bf889fd01d53447d2f4eeeb3ee779f14309595cddb60504023aa2e25084d2c",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19115/2006/MetadataEntitySetInformation#MD_Metadata",
      "vocLabel": [
