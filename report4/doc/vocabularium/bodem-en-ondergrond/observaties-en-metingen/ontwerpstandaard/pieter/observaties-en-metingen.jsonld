      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Van het Object dat men wil observeren wordt in dat geval een representatief vlakvormig deel beschouwd. Voorbeelden zijn kwadranten, scties, stroken, scenes etc."
        }
      ],
