        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Observatie waarbij het resultaat booleaans is."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Normaal gezien bij Observaties waar gekeken wordt of een bepaald fenomeen zich al dan niet voordoet. Bijvoorbeeld het voorkomen van een bedreigde diersoort, de aanwezigheid van een defect. Datatype van het resultaat is een Boolean."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
