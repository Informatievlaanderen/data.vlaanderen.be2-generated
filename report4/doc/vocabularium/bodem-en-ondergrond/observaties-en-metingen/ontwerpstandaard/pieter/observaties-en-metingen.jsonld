      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Verwijzing naar het Object dat men wil bemonsteren."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld een profiel bemonstert een water- of atmosferische kolom, een peilput bemonstert het water in een watervoerende laag, een weefselstaal bemonstert een deel van een organisme."
        }
      ],
