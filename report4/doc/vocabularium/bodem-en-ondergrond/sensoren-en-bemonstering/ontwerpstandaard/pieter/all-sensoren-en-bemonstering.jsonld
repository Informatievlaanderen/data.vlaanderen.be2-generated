      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Process",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Proces"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Proces"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Opeenvolgende acties of stappen noodzakelijk om een resultaat te bekomen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze contextde manier waarop het resultaat van een Observatie is verkregen. Dat kan dmv een instrument of een sensor zijn; maar het kan ook een menselijke observator zijn of een simulatie of een verwerking of algoritme toegepast op meer primitieve resultaten. Het Proces vormt samen met het Bemonsteringsobject dat is gebruikt het zgn observatieprotocol. OPGELET: deze klasse is abstract, ze moet gespecialiseerd worden in functie van het applicatiedomein."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
