      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Entiteit die fungeert als basis voor andere Entiteiten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze context zijn deze andere entiteiten typisch Sensoren, Bemonsteraars of Actuators. Voorbeelden van Platformen zijn palen, boeien, voertuigen, schepen, vliegtuigen, gsm's en zelfs mensen en dieren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:208fcf245dbbee77e901559a6348bd03af1dc3b7eecd3c93634cc05adf2483f0",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/ssn/systems/SystemCapacity",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Systeemvermogen"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Systeemvermogen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Systeemvermogen"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Capaciteiten van een Systeem."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Slaat op zaken als Meetbereik, Nauwkeurigheid, Afwijking, Resolutie, Responstijd etc. en de eventuele Condities waaronder die specificaties gelden, bijvoorbeeld een Nauwkerigheid van 1mm is gegarandeerd voor afstanden onder de 100meter."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:09610193b3d68d9a2c27c08c2c10bce0582b4bd74e2b24a4e8ee41fbcc693a55",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/ssn/systems/SurvivalRange",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Overlevingscapaciteit"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Overlevingscapaciteit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Overlevingscapaciteit"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Levensduur van een Systeem."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Slaat op de levensduur van het Systeem als geheel of van cruciale delen ervan zoals de batterij en de Condities waaronder die kenmerken gelden. Bijvoorbeeld de batterij van het systeem gaat 3 weken mee alvorens ze opnieuw moet worden opgeladen op voorwaarde dat de temperatuur tussen -5 en +35 graden ligt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:570d290f07fff31bd8e01d275cfb8549f37608bc4232342efce0468ff7369d14",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/ssn/systems/OperatingRange",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Werkingsbereik"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Werkingsbereik"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Werkingsbereik"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Vereisten opdat een Systeem normaal functioneert."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Slaat op zaken als onderhoud of de vereiste netspanning en de eventuele bijkomende condities, bijvoorbeeld om de 3 weken is onderhoud nodig (door een gespecialiseerde firma) of de spanning op het net voor de voeding van het Systeem moet tussen 110 en 230 Volt liggen (bij normaal verbruik)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:254b81307680e062ad8fa2f25119da8224f25ac703b22fe9d399454257839e84",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/sosa/om#ObservationProcedure",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Observatieprocedure"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Observatieprocedure"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Observatieprocedure"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een workflow, protocol, plan, algoritme of berekeningswijze waarin wordt gespecifieerd hoe een Observatie moet worden uitgevoerd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De procedure legt uit welke stappen uitgevoerd moeten worden om een reproduceerbaar resultaat te krijgen. Bijvoorbeeld de correcte plaatsing van een windmeter (op een welbepaalde hoogte boven het grondoppervlak, bijvoorbeeld 10m voor meteorologische waarnemingen). De procedures zijn doorgaans bedoeld om bij meer dan één Bermonstering te worden toegepast."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:1a204e0b0e92e775ad11006c222b9eda03e99e798f44863fc1aafdb0dcff6cf7"
        },
        {
          "@id": "urn:oslo-toolchain:bf102d45f93c751819aecbc32a8e4bf911c0e90dc55dc361be567ec5ba544a87"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e96decfd19892d6de7cbfa4e851615308e99cfe70684d799da6958f9ea057dfc",
      "@type": "Class",
      "assignedURI": "https://www.w3.org/ns/sosa/Sensor",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sensor"
