    {
      "@id": "urn:oslo-toolchain:cf6a3721123be992077d7e901c2e9314f4e77ff07629b6789da064f9c3380680",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.resultTime",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "resultaattijd"
        }
      ],
      "diagramLabel": [
        {
          "@value": "resultaattijd"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Tijdstip waarop het resultaat van de Observatie werd bekomen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Is voor sommige Observaties gelijk aan de fenomeentijd maar kan ook verschillen, bijvoorbeeld bij het uitvoeren van een analyse op een Monster dat eerder (en doorgaans dan ook en dergelijkeers) werd genomen of bij sensormetingen die pas later worden verwerkt. Ook bruikbaar om herhaalde Observaties bijvoorbeeld op eenzelfde Monster uiteen te houden. Is het resultaat een voorspelling dan is de fenomeentijd het moment waarop deze van toepassing zou moeten zijn."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:7bd306fd2f558b2cd90df76701954fd77437f22a41eefe25bfe933615d28c5af"
