        }
      ],
      "diagramLabel": [
        {
          "@value": "Systeem"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Samenhangend geheel van componenten die samen één of meer functies vervullen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze componenten kunnen Systemen op zich zijn. In deze context zijn het Systemen die een Observatieprocedure realiseren (typisch een Sensor) of waarmee een Bemonsteringsprocedure wordt uitgevoerd (bijvoorbeeld een Boorinstallatie)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
