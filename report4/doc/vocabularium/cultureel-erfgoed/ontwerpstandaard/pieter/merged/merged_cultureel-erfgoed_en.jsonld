    {
      "@id": "urn:oslo-toolchain:204a947cb4eafec00b5dfb252c2181fdb3d83c74698a5d5e9e9f40b5ae957a4f",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Werk dat uit andere Werken is samengesteld."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "ComplexWerk"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Die andere Werken zijn bijvoorbeeld adaptaties of vertalingen of publicaties van een oorspronkelijk Werk. Ze kunnen parallel of apart daarvan evolueren maar delen hetzelfde achterliggend idee. De sterkte van dat idee bepaalt de samenhang van de samenstellende Werken van een ComplexWerk.  Daardoor is bijvoorbeeld een vertaling van een oorspronkelijk Werk deel van hetzelfde ComplexWerk, zelfs als is het een Individueel Werk op zich. Het feit dat een Werk Expressies omvat van andere Werken (zie bijvoorbeeld Aggregatiewerk) maakt het niet complex, bijvoorbeeld een bloemlezing waarvan één versie bestaat is geen ComplexWerk."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F15",
      "diagramLabel": [
        {
          "@value": "ComplexWerk"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:effe9475cc292876e02a5d366fb48de828be1644e01fab1c3b85d91a58b553dc"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "ComplexWerk"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:fa18f4f533d1636be9cee565b191342459c4eb70f62cbcfdf86e73cb797d5aab",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Gedocumenteerd plan voor het uitvoeren van acties met het oog op het bekomen van een resultaat van een bepaalde kwaliteit, vorm of inhoud."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "OntwerpOfProcedure"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het resultaat is een gevolg van doelbewuste menselijke activiteit en kan zowel materieel als immaterieel zijn. Het kan een procedure zijn te volgen bij het uitvoeren van een bepaalde activiteit, het kan een ontwerpschema zijn van een bepaald product, het kan ook een louter intellectuele oefening zijn (maw een ontwerp dat nooit is uitgevoerd)."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure",
      "diagramLabel": [
        {
          "@value": "OntwerpOfProcedure"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:1da0240ba97fc3851ef892f33fa73f0dba5fbdbaa59897da95b7ee8810265951"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "OntwerpOfProcedure"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:c1a7086d685565422cc2fe79c8260bea5d6ba3b645d78305d979dee1d1affd1f",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Geheel van zaken die uitdrukking geven aan de beslissingen van uitgevers mbt de selectie van de inhoud en de lay-out van publicaties."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "PublicatieExpressie"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch wordt wat oorspronkelijk louter tekst was grafisch en typografisch vormgegeven en worden illustraties en andere inhoud toegevoegd. Als zodanig bevat een instantie van een PublicatieExpressie alle Expressies nodig voor de uiteindelijke weergavan een van de publicatie, of die nu visueel, audio of tactiel is."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F24",
