          "@id": "urn:oslo-toolchain:1da0240ba97fc3851ef892f33fa73f0dba5fbdbaa59897da95b7ee8810265951"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Document"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:1da0240ba97fc3851ef892f33fa73f0dba5fbdbaa59897da95b7ee8810265951",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Immaterieel object dat informatie omvat, het is te zeggen gegevens of data waaraan op één of andere manier betekenis is gegeven. Een Informatieobject gaat ergens over (het is propositioneel) en brengt dat over dmv symbolen (karakters, tekens etc.) of aggregaties daarvan."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "InformatieObject"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Voorbeelden: gedichten, datasets, afbeeldingen, teksten, multimedia-objecten, ontwerpen of procedures, computerprogrammacode, algoritmes of wiskundige formules, kennisgraphs... Kan los van een drager bestaan of op één of meer dragers voorkomen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object",
      "diagramLabel": [
        {
          "@value": "InformatieObject"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:4868006bbd855fb00c3ff13b231e0485aa02c11a7e748853d19d7e623f4e8d49"
        },
        {
          "@id": "urn:oslo-toolchain:1b89b3291873937cb24038263e7fad44283647fb077f30e41e656b799055ff32"
        },
        {
          "@id": "urn:oslo-toolchain:de798f9f7cafbcdd5cde09a8ad104efdaaa76babc04fa6fbd5a06219c9fef71e"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "InformatieObject"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:1ab7d31d571f9c664ee9e7e1c39e74876d6414fb9b2bbac90558f8c2f0549f31",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De immateriële uitdrukking van een Werk, bijvoorbeeld dmv tekst, muziek, beeld, die op een bepaald moment een geheel vormt."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "ZelfstandigeExpressie"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een Werk kan gerealiseerd worden door meerdere ZelfstandigeExpressies, maar een ZelfstandigeExpressie geeft uitdrukking aan maximaal één Werk. Bijvoorbeeld een Aggregatiewerk van het type muziekalbum bevat meerdere ZelfstandigeExpressies die elk een Individueel Werk van het type \"song\" realiseren. Onder \"zelfstandig\" of \"compleet\" verstaan we dat de creator deze intentie had, zelfs al heeft hij de expressie misschien nooit volledig afgewerkt."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F22",
      "diagramLabel": [
        {
          "@value": "ZelfstandigeExpressie"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:1da0240ba97fc3851ef892f33fa73f0dba5fbdbaa59897da95b7ee8810265951"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "ZelfstandigeExpressie"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:effe9475cc292876e02a5d366fb48de828be1644e01fab1c3b85d91a58b553dc",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Idee of combinatie van ideeën achter één of meer artistieke of intellectuele Expressies."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Werk"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typische voorbeelden van Werken zijn gedichten, verhalen, muziekcomposities. Een Werk kan uit meerdere Werken bestaan maar het kan ook de uitingen van andere Werken omvatten (is bijvoorbeeld het geval bij een Publicatiewerk). Soms zijn de artistieke/intellectuele uitingen slechts indirect bewijs voor het idee of de ideëen achter een Werk, ze vormen ahw een snapshot van een Werk op een bepaald moment."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://www.iflastandards.info/fr/frbr/frbroo#F1",
      "diagramLabel": [
        {
          "@value": "Werk"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:4868006bbd855fb00c3ff13b231e0485aa02c11a7e748853d19d7e623f4e8d49"
        },
        {
          "@id": "urn:oslo-toolchain:1b89b3291873937cb24038263e7fad44283647fb077f30e41e656b799055ff32"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Werk"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
