      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Overdracht van de eigendomstitel van een MaterieelDing van de ene Agent naar de andere,bijvoorbeeld door een verkoop of een erfenis."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
