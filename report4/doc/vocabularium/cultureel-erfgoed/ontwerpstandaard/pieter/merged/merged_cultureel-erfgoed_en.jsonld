        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Eventueel worden daarbij andere Werken geregistreerd maar die maken geen deel uit van het Opnamewerk, ze zijn net als bij een Containerwerk (het is te zeggen een Publicatiewerk, Voorstelling of Aggregatiewerk) hoogstens deel van de overeenkomstige Opname(expressie). Foto's of film registreren niet noodzakelijk iets (bijvoorbeeld animatiefilm) in welk geval het gewone Werken en geen Opnamewerken zijn."
        },
