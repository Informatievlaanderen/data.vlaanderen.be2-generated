      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Criteriumvereiste"
        }
      ],
      "diagramLabel": [
        {
          "@value": "CriteriumVereiste"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Criterium dat toelaat te bepalen of een gebruiker recht heeft op een dienstverlening of deze mag gebruiken."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Niet elke Publieke Dienstverlening is voor iedereen noodzakelijk of nuttig. Bv werkloosheidsuitkeringen zijn enkel noodzakelijk voor werklozen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
