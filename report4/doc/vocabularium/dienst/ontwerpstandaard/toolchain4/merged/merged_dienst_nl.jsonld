      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Vertegenwoordigt de regels, richtlijnen of procedures gevolgd door de Publieke Dienstverlening."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Omvat gebruiksvoorwaarden, licentie- en authenticatievereisten van de Publieke Dienstverlening."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:066072431fffe9bb5c37df4c224b3a5ba99fb8ccd93999c9a2d13828135b96d0",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/Evidence",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bewijs"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bewijs"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Elk stuk waarmee kan worden aangetoond dat men aan een CriteriumVereiste voldoet."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In het kader van publieke dienstverlening gaat het meestal om administratieve documenten of ingevulde aanvraagformulieren. Zonder het nodige Bewijs kan de dienstverlening niet worden afgeleverd. Soms levert de Output van een Publieke Dienstverlening het Bewijs nodig voor een andere Publieke Dienstverlening."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:28939ea94f7c963b883a75c5ed5a644e4e3e3d5bdba708b4ca687c69dc42a2cf",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "diagramLabel": [
        {
          "@value": "OutputType"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:85301f1f7db38b8e6ded123bc98a61ec65eefab14ad2bc93951e3841e28e9cfd",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/Output",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Output"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Output"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Resultaat van een Publieke Dienstverlening."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bv toelating verstrekt door of in naam van de bevoegde instantie (Publieke Organisatie) dat een Agent  toelaat om iets bepaald te ondernemen. Eventueel vormt deze Output het noodzakelijk Bewijs, voor te leggen om gebruik te kunnen maken van een Andere Dienstverlening. Dit kan verder gedocumenteerd worden in de Richtlijn geassocieerd met de Publieke Dienstverlening."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:89ba6dfdea37f7481ada000e19ebe4efe886d68373a4fdc5cfcf0f9844d56da6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
