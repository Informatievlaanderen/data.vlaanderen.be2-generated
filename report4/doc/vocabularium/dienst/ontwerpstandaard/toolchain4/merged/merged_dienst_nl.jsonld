      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Kanaal waarlangs een Agent kan interageren met een Publieke Dienstverlening."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Typische voorbeelden: online, telefoon, kantoor…"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
