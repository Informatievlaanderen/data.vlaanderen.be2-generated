      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:30b071411e69d72ffa132bed511cd7cccf88f3f99220022625286772958cd702",
      "@type": "Class",
