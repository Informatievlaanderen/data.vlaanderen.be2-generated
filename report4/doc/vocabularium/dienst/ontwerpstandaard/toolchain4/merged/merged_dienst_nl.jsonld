      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:9dd690724450208820196ddac7e85645b8482e1182266b9a755feaa0aee8f834",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/LifeEvent",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Levensgebeurtenis"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LevensGebeurtenis"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Belangrijke gebeurtenis of situatie in het leven van een persoon waarvoor hij/zij een Publieke Dienstverlening nodig heeft."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Enkel gebeurtenissen die geassocieerd kunnen worden met een Publieke Dienstverlening worden hier bedoeld. Bv niet de verloving van twee personen met elkaar maar wel het feit dat ze huwen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:219878ec2b1e21f544cc493cfdfbb24ca5e7bbe15c1577e02396aaa39709793e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:25a31891e18c76589911744edff27ad85fbe719b14269e2e8e534e7c4d50e662",
      "@type": "Class",
      "assignedURI": "http://purl.org/vocab/cpsv#PublicService",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Publieke Dienstverlening"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PubliekeDienstverlening"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een Publieke Dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen hiervan."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De dienstverlening vormt een aanbod (dat dus niet noodzakelijk wordt gebruikt). Ze houdt niet noodzakelijk het opnemen van een recht in, de dienstverlening kan de gebruiker ook toelaten een verplichting te vervullen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:89ba6dfdea37f7481ada000e19ebe4efe886d68373a4fdc5cfcf0f9844d56da6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:9847b84c181a2c9f24230691c90d3948d23256be791ade1a69d7f950434a9bb3",
      "@type": "Class",
      "assignedURI": "http://purl.org/dc/terms/Agent",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Agent"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Agent"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."
