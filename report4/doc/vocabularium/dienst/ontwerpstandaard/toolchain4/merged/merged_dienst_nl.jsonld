    {
      "@id": "urn:oslo-toolchain:219878ec2b1e21f544cc493cfdfbb24ca5e7bbe15c1577e02396aaa39709793e",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/Event",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gebeurtenis"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis die leidt tot, gebruik maakt van of gerelateerd is met een Publieke Dienstverlening."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Wordt gebruikt om een specifieke Publieke Dienstverlening op te zoeken in een dienstencataloog (bv erkenning van percentage invaliditeit na het stellen ve bepaalde diagnose) of een groep van Publieke Dienstverleningen (bv alle diensverlening die betrekking heeft op het starten van een eigen zaak)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:3893ca182e8701bf7ce9fc4a5153beeafe57878b8d67065977a3eee53f0e7e8d",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/BusinessEvent",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bedrijfsgebeurtenis"
        }
      ],
      "diagramLabel": [
        {
          "@value": "BedrijfsGebeurtenis"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Situatie of gebeurtenis die een specifieke behoefte of (wettelijke) vereiste vh bedrijf op een bepaald moment in zijn levenscyclus weergeeft welke vervuld kan worden door het consumeren ve bepaalde Publieke Dienstverlening."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:219878ec2b1e21f544cc493cfdfbb24ca5e7bbe15c1577e02396aaa39709793e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
