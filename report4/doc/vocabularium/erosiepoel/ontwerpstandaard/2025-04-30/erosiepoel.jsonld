  "datatypes": [
    {
      "@id": "urn:oslo-toolchain:34596398d25ad30cf6d878c00d41cc3683c0e4af557e0548e23bb0f8d613c353",
      "@type": "Datatype",
      "assignedURI": "http://www.w3.org/ns/prov#Location",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Locatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Locatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een locatie kan een identificeerbare geografische locatie zijn (ISO 19112), maar deze locatie kan ook een niet-geografische locatie zijn, zoals een directory, rij of kolom. Als zodanig zijn er talloze manieren waarop locatie kan worden uitgedrukt, zoals d"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van een geografische positie, dmv coordinaten, een toponiem, een adreslabel, een verwijzing naar een plaats/regio of verwijzing naar een adres."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te gebruiken als de manier waarop de geografische positie wordt aangeduid pas zal worden vastgelegd bij implementatie. Is deze manier nu al gekend dan moet direct gewerkt worden met Geometrie, GeografischeNaam, Adres etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    }
  ],
