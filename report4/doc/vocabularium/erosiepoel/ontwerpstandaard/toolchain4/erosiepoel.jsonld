      "diagramLabel": [
        {
          "@value": "Platform"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Entiteit die fungeert als basis voor andere Entiteiten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In deze context zijn deze andere entiteiten typisch Sensoren, Bemonsteraars of Actuators. Voorbeelden van Platformen zijn palen, boeien, voertuigen, schepen, vliegtuigen, gsm's en zelfs mensen en dieren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:819be9fadf01701f97d4cae37aa232e8e69daf1852e9d46bf612eba061230dcc",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/sosa/ObservableProperty",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Geobserveerdkenmerk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GeobserveerdKenmerk"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een kwaliteit van een entiteit. Een aspect van een entiteit dat intrinsiek is aan en niet kan bestaan zonder de entiteit."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Voorbeelden van instanties van deze klasse zijn infiltratiesnelheid, densiteit, vruchtbaarheid, vochtigheid, bodemtype, organisch materiaal, koolstof, grondwaterpeil, vegetatie, en teelt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e96decfd19892d6de7cbfa4e851615308e99cfe70684d799da6958f9ea057dfc",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/sosa/Sensor",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sensor"
