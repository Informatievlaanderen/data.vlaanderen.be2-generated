  "branchtag": "master",
  "classes": [
    {
      "@id": "urn:oslo-toolchain:639060b72a58ca6124d83aadc0cf4e2f820ec7665e40d250de58f91756eba165",
      "@type": "Class",
      "assignedURI": "https://dcjm.data.vlaanderen.be/ns/financiele-data/taxonomie#Code70",
      "diagramLabel": [
        {
          "@value": "Omzet"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5d043f6488aa9ec50974d1272af1ed458a07d0a4e4556d2897694a39a27096d6"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "\"Onder omzet wordt verstaan het bedrag van de verkoop van goederen en de levering van diensten aan derden, in het kader van de gewone bedrijfsuitoefening van de VZW, IVZW of stichting, onder aftrek van de op de verkoopprijs in de handel toegestane kortingen (afslag, ristorno, rabat); dit bedrag omvat niet de belasting over de toegevoegde waarde, noch enige andere rechtstreeks met de omzet verbonden belasting.\n\nOnder die post moeten eveneens worden opgenomen de tegemoetkomingen van de overheid in het kader van een tariferingspolitiek als compensatie voor lagere ontvangsten. Voor de natuurlijke personen die zelfstandig een beroepsactiviteit uitoefenen, omvat de omzet ook de onttrekkingen in natura anders dan ten behoeve van hun bedrijf.\""
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Omzet"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:5d043f6488aa9ec50974d1272af1ed458a07d0a4e4556d2897694a39a27096d6",
      "@type": "Class",
      "assignedURI": "https://dcjm.data.vlaanderen.be/ns/financiele-data/taxonomie#Code70/76A",
      "diagramLabel": [
        {
          "@value": "Bedrijfsopbrengsten"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:24400611467109767797a7f1a12958a0401b091b35254c6f9034c87df4f608eb"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onder de bedrijfsopbrengsten wordt verstaan de opbrengsten die voortvloeien uit de normale exploitatie of uitbating van de organisatie."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
