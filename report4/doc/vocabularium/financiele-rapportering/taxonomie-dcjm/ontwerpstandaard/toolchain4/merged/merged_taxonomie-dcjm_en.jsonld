    {
      "@id": "urn:oslo-toolchain:82a85c9890fd27bdd566f5d6f351015e38334739c1898dda2a7ee4413b699d1a",
      "@type": "Class",
      "assignedURI": "https://dcjm.data.vlaanderen.be/ns/financiele-data/taxonomie#Code700",
      "diagramLabel": [
        {
          "@value": "InkomgeldenEnVergoedingen"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:639060b72a58ca6124d83aadc0cf4e2f820ec7665e40d250de58f91756eba165"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze rubriek bevat alle opbrengsten die tot de omzet behoren en die voortvloeien uit activiteiten die de VZW, IVZW of stichting organiseert en waarbij ze deze opbrengsten ook zelf rechtstreeks ontvangt van de participant/eindgebruiker van deze activiteit. Het gaat hier onder andere om ontvangsten via abonnementen, inschrijvingsgelden en ticketverkoop, auteurs- en naburige rechten, royalty's, uitkoopsommen, distributeursvergoeding, donaties met tegenprestatie."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Inkomgelden en vergoedingen uit eigen activiteiten"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:f3dd57e0879257b883f27c29dbc67bf0868190d65a12d679442a77e64e7880c9",
      "@type": "Class",
      "assignedURI": "https://dcjm.data.vlaanderen.be/ns/financiele-data/taxonomie#Code7001",
      "diagramLabel": [
        {
          "@value": "InschrijvingsgeldenEnTicketverkoop"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:82a85c9890fd27bdd566f5d6f351015e38334739c1898dda2a7ee4413b699d1a"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze rubriek bevat alle opbrengsten die tot de omzet behoren en die voortvloeien uit inschrijvingsgelden en ticketverkoop voor activiteiten die de VZW, IVZW of stichting organiseert en waarbij ze deze opbrengsten ook zelf rechtstreeks ontvangt van de participant/eindgebruiker van deze activiteit."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
