      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Kader waarin een Feit moet geïnterpreteerd worden."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Context"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb de Periode waarin het Feit geldig is (typisch het huidig boekjaar) of andere Dimensies van het Feit zoals het Product of de Regio waarop het Feit van toepassing is, bvb de Omzet van Product X of Y. Slaat op een individueel Feit of is van toepassing op een FinancieelRapport (en dus op de Feiten in dat rapport)."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:6fe87d209195dab46e9c359f07ce8aae12fb2b23b3c4bca8db040117ea8bd3a5",
      "assignedURI": "https://data.vlaanderen.be/ns/financiele-rapportering#Feit",
      "diagramLabel": [
        {
          "@value": "Feit"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een individueel stuk informatie in een FinancieelRapport."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Feit"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Typisch  de waarde in valuta van één bepaald  financieel kenmerk van een Organisatie (bv Omzet, Kosten etc) beschouwd in een specifieke Context (bvb het huidig boekjaar en Dimensies zoals het Product en/of de Regio waarop het Feit betrekking heeft). Feiten vormen de atomaire onderdelen van het FinancieelRapport, beschouwen we het rapport als een multidimensionele gegevenskubus (zie Hypercube) dan vertegenwoordigt een individueel Feit één cel in die kubus."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
