    {
      "@id": "urn:oslo-toolchain:f7a69f66b2e97781120cc691988b01aea24e3812656abb186fef6726f2adc99b",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/gebouw#Gebouweenheid",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gebouweenheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gebouweenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De kleinste eenheid binnen een gebouw die geschikt is voor woon-, bedrijfsmatige, of recreatieve doeleinden en die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde circulatieruimte. Een gebouweenheid is in functioneel opzicht zelfstandig. Daarnaast kan een gebouweenheid ook een gemeenschappelijk deel zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
