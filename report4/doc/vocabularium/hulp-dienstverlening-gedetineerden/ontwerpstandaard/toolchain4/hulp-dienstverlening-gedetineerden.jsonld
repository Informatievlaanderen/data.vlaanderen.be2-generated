    },
    {
      "@id": "urn:oslo-toolchain:1d3f63861fbbc25aceab72ca3ea6b3eb179c4896a708e1c72bb9c7956bd4cd18",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Site",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Vestiging"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een kantoor of ander pand waar een Organisatie gevestigd is. Organisaties kunnen over meerdere vestigingen verspreid zijn en vestigingen kunnen op meerdere locaties slaan."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Meestal zal de Vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten,bv een virtueel kantoor met bijbehorend postnummer en telefonische receptie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
