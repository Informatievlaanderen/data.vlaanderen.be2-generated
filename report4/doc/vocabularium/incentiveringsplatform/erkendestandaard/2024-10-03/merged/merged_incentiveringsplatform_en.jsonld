    {
      "@id": "urn:oslo-toolchain:e09549030b27fc1fa194d98c7a3d8cd489629fa35ed603a35f36ace98373f6ac",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanbod van een stimulans, waarbij een stimulans omschreven wordt als het investeren van een bepaald bedrag om gedrag te stimuleren dat een meerwaarde vormt voor de gemeenschap. Een meerwaarde hoeft niet altijd meetbaar te zijn zoals de verbetering  van de luchtkwaliteit, maar het kan ook bijvoorbeeld een verbetering van de sociale cohesie zijn."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Stimulansaanbod"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een voorbeeld hiervan is de actie waarbij jongeren een Sobercoin kunnen verdienen door een negatieve alcoholtest af te leggen bij aankomst op een fuif."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/incentiveringsplatform#Stimulansaanbod",
      "diagramLabel": [
        {
          "@value": "Stimulansaanbod"
        }
      ],
