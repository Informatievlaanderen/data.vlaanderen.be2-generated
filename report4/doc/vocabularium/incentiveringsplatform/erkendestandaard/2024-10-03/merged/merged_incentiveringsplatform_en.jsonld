    {
      "@id": "urn:oslo-toolchain:fef8fe5b0b0cf4ed6771115780568510eb0ca73e2bfd921901e5211600418abc",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het bewijs dat effectief geleverd wordt bij de consumptie van het Stimulansaanbod door een Agent."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Bewijslevering"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Hier wordt in het geval van consumptie van het Stimulansaanbod door een Agent het effectieve bewijs beschreven. Vertrekkend vanuit ons eerder vermelde voorbeeld is dit het feit dat iemand een negatieve alcoholtest aflegt aan een fuif om zo de Beloningsontvangst te verkrijgen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://data.europa.eu/m8g/Evidence",
      "diagramLabel": [
        {
          "@value": "Bewijslevering "
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
