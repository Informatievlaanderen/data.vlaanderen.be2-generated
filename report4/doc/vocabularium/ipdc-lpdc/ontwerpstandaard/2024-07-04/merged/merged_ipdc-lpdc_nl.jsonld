  "classes": [
    {
      "@id": "urn:oslo-toolchain:158475491ec80030925d10df6a7561bda05be88ec508a41ac45ff1f9a1a70d6c",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/Cost",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kost"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Kost"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "The Cost class represents any costs related to the execution of a Public Service that the Agent consuming it needs to pay."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e0af203eb5deeb3280e6045c7b7dad65567cebe175a2780bb362bcd32ddf11ac",
      "@type": "Class",
      "assignedURI": "https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#FinancialAdvantage",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "FinancieelVoordeel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "FinancieelVoordeel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "We voorzien een subklasse 'FinancialAdvantage' van 'Output'. Deze beschrijft de premiebedragen/subsidiebedragen die het resultaat van de dienstverlening zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7689868eacb354cae9b05a02a4b4978f65b1b0d3704ecec2f7b7c38563cb7373"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a63dd4040bbc75570c61e22de203294f0363bac1d1b5a56c38483cf047c22387",
      "@type": "Class",
      "assignedURI": "http://purl.org/vocab/cpsv#Rule",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Procedure"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Procedure"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "The Rule class represents a document that sets out the specific rules, guidelines or procedures that the Public Service follows. It includes the terms of service, licence, and authentication requirements of the Public Service. Instances of the Rule class are FRBR (Functional Requirements for Bibliographic Records) Expressions, that is, a concrete expression such as a document, of the more abstract concept of the rules themselves.This model does not envisage instances of the Rule class as machine-readable business rules. Detailed modelling of the rules related to Public Services is out of scope of this model."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:2c16d05a20ba2c39afc594556de01621a3f03ac0db72d09172d9338828427b34",
      "@type": "Class",
      "assignedURI": "http://schema.org/ContactPoint",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Contactgegevens"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Contactgegevens"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "This class represents the contact information for a Public Service, Channel, Public Organization, etc. It is defined in the Core Public Organization Vocabulary and is provided as a schema:ContactPoint. Like Channel, a Contact Point may have regular opening hours that are then overridden by, for example, public holidays, using the Opening Hours Specification class."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Minstens één van de attributen moet ingevuld zijn met een niet lege waarde."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:65f9db777476f6a58323e0234513178d7edf3983321c97613f16abf6c3472fbd",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/Evidence",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bewijs"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bewijs"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "The Evidence class is defined in the Core Criterion and Core Evidence vocabulary (CCCEV) as any resource that can document or support a response. It contains information that proves that a normal requirement exists or is true."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Although the wording of the definition is different, the semantics are an exact match for CPSV's Input class which it replaces. Evidence can be any resource - document, artefact - anything needed for executing the Public Service."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f33867b7909bdb8e2eb21af523fe81b58faaa959f4f3643e966cd6b1b27e2291",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/eli/ontology#LegalResource",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Regelgeving"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Regelgeving"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "This class represents the legislation, policy or policies that lie behind the Rules that govern the service."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Link naar de Vlaamse Codex of een ander wetgevingsregister - The definition and properties of the Legal Resource class in the CPSV-AP are aligned with the ontology included in \"Council conclusions inviting the introduction of the European Legislation Identifier (ELI)\". For describing the attributes of a Legal Resource (labels, preferred labels, alternative labels, definition ...) we refer to the ELI ontology."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:3939ea7a2820e603aea4d84c0bd37934b0e4eb31dddb592c897f6383222a8bed",
      "@type": "Class",
      "assignedURI": "http://schema.org/WebSite",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Website"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Website"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "A WebSite is a set of related web pages and other items typically served from a single web domain and accessible via a URL."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6b9039a9a0bdcde097b09f9ed15056a7ff9f56f762d8b6a5057b54e9056b2667",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/Requirement",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Voorwaarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Voorwaarde"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "A normal requirement is an atomic requirement. Some criteria can be expressed with several atomic requirements. A normal requirement can specify the expected value that the requirement response has to contain, or a range of threshold values within which the requirement response has to fit in. The normal requirement may apply to a certain period of time. It also can provide a list of candidate evidences that the responder can use to prove the normal requirement."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Not all public services are needed or usable by everyone. For example, the visa service operated by European countries is not needed by European citizens but is needed by some citizens from elsewhere, or public services offering unemployment benefits and grants are targeting specific societal groups. This model reuses the Core Criterion and Core Evidence Vocabulary for this class. The CCCEV provides more details but the Requirement class has three mandatory properties."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f268d6c3913b8f6a0bf1c768ecaa6efd0811b005343d47cd8f87ee2fcf86aa4b",
      "@type": "Class",
      "assignedURI": "https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#ConceptualPublicService",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Concept"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Concept"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dienstverlening van lokale besturen is vaak gestoeld op Vlaamse, federale of Europese wetgeving, die vertaald wordt naar een lokaal niveau. Dat betekent dat de basis gelijkaardig is voor elk lokaal bestuur, maar dat er mogelijk flexibiliteit bestaat voor de lokale invulling. Omdat we IPDC goed gevuld en up to date willen krijgen en houden, met een beperkte administratieve belasting, voorzien we het concept. Een concept is een sjabloon dat redacteurs van de Vlaamse overheid klaarzetten voor lokale besturen. Het bevat een algemene invulling van een overheidsdienstverlening, die in de meeste lokale contexten ook van toepassing kan zijn. Lokale besturen kunnen deze concepten raadplegen en beslissen om een eigen dienstverlening te registreren op basis van een concept. Op dat moment wordt een concept gekloond naar een instantie. Het lokaal bestuur kan deze instantie vervolgens volledig aanpassen en afstemmen op de lokale context. Op deze manier groepeert een concept ook alle verschillende lokale variaties van een gelijkaardige dienstverlening."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Een goed voorbeeld van een concept is het huwelijk. Hoewel de beschrijving en voorwaarden van een huwelijk grotendeels hetzelfde zijn voor de verschillende gemeentes zijn er mogelijk toch lokale verschillen, zoals de locatie en prijs, die terug te vinden zijn in de respectievelijke instanties."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:11749a62fd847602de65ea768d0fe1f2fa6b0bdb12b7d2f8a9c05b7c68491be9",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/PublicOrganisation",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "PubliekeOrganisatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PubliekeOrganisatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een organisatie die volgens een wettelijk kader behoort tot de publieke sector, ongeacht het bestuursniveau waarop dat kader van kracht is."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Link naar het organisatieregister (wegwijs) op basis van de OVO code of link naar het organisatieportaal. Waar mogeijk probeert IPDC links naar het organisatieregister te leggen. Wanneer IPDC een link naar het organisatieportaal ontvangt probeert het de organisatie op te zoeken in het organisatieregister. Wanneer deze gevonden wordt zal de link naar het organisatieregister bewaard worden anders blijft de link naar het organisatieportaal behouden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:582f84f0db1b7dfeb249e184dee88b1c71ac3d66f045d45e608bcaaff4371fe6",
      "@type": "Class",
      "assignedURI": "https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#InstancePublicService",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Instantie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Instantie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Instanties zijn de werkelijke invulling van een product of dienstverlening. De bevoegde overheid kan variëren: federaal, Vlaams, provinciaal,… en de dienstverlening kan uitgevoerd worden door nog een andere overheid zoals een lokaal bestuur. Een overheidsdienstverlening is een verplichte of optionele reeks activiteiten die (kunnen) worden uitgevoerd door of namens een openbare organisatie, publiekelijk gefinancierd en voortkomend uit het openbaar beleid. Diensten kunnen ten goede komen aan een individu, een organisatie of vereniging, een onderneming of een andere overheidsinstantie, of aan groepen van een van deze partijen. Een dienst bestaat ongeacht of deze wordt gebruikt of niet. Volgens de herziene versie van het Europees Interoperabiliteitskader omvat een Europese openbare dienst elke dienst die wordt verleend door overheidsinstanties in Europa, of door andere organisaties namens hen, aan bedrijven, burgers of andere overheidsinstanties."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:c6c63b0e824f763f7f63723654057afa95f90c7d25d62d8a4e662136d0b47588"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ea4ca7d93b48dcb8c8567659a1e91aa0240363d69c222c1835c6f42337808515",
      "@type": "Class",
      "assignedURI": "https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#ConceptualPublicServiceSnapshot",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "ConceptSnapshot"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ConceptSnapshot"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een conceptsnapshot geeft weer hoe een concept er op een bepaald moment in tijd uitzag. Telkens wanneer een functionele wijziging aangebracht wordt zal een nieuwe conceptsnapshot aangemaakt worden. Op deze manier wordt de volledig redactie historiek van een concept vastgelegd."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De conceptsnapshots worden door IPDC aan de hand van een linked data event stream (LDES) beschikbaar gemaakt. Deze LDES maakt de volledige historiek van alle concept wijzigingen beschikbaar voor aansluiters. Meer info over LDES is hier beschikbaar: https://semiceu.github.io/LinkedDataEventStreams"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:0cad3ac9dcac98e4bff97ea9d8bcee797fc5a61337d1782ea9c59fa2619099d2",
      "@type": "Class",
      "assignedURI": "https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#InstancePublicServiceSnapshot",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "InstantieSnapshot"
        }
      ],
      "diagramLabel": [
        {
          "@value": "InstantieSnapshot"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een instantiesnapshot geeft weer hoe een instantie er op een bepaald moment in tijd uitzag. Telkens wanneer een functionele wijziging aangebracht wordt zal een nieuwe instantiesnapshot aangemaakt worden. Op deze manier wordt de volledig redactie historiek van een instantie vastgelegd."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De instantiesnapshots worden door IPDC aan de hand van een linked data event stream (LDES) beschikbaar gemaakt. Deze LDES maakt de volledige historiek van alle instantie wijzigingen beschikbaar voor aansluiters. Meer info over LDES is hier beschikbaar: https://semiceu.github.io/LinkedDataEventStreams"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:0e9876192c3fd4ee8fa982bceea0080e60263788514d92eb28ae14979543780f",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/locn#Address",
