  "attributes": [
    {
      "@id": "urn:oslo-toolchain:d16707cddbb2848f1b7052f276860ad05ea92493604ff42c648ac2fd1d2bcedd",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
