          "@language": "nl",
          "@value": "Zie de <a href=\"https://publications.europa.eu/resource/authority/language\">codelijst</a> gepubliceerd door de Europese Unie voor mogelijke waarden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
