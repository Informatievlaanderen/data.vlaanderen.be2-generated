    {
      "@id": "urn:oslo-toolchain:ba58dd677350499d5c6c478e3e251f064498a1ebf7ef15d0b1def3ebf46982d5",
      "@type": "Datatype",
      "assignedURI": "http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Object",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "TemporeleEntiteit"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "TemporeleEntiteit"
        }
      ],
      "diagramLabel": [
