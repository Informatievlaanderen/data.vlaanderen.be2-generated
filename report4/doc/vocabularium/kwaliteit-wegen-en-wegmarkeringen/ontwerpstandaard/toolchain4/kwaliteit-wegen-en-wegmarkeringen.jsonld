    {
      "@id": "urn:oslo-toolchain:60c21aa6d3c4d7faaac05ff790c1b91c5c2c7b7ffca07c1fc9912a1512032a31",
      "@type": "Datatype",
      "assignedURI": "http://www.opengis.net/ont/gml#Solid",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "3Dobject"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "3Dobject"
        }
      ],
      "diagramLabel": [
        {
          "@value": "3Dobject"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een 3-dimensionele geometrische primitieve."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 3-dimensionele geometrische primitieve."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dimensie is te verstaan in wiskundige zin: het minimum aantal coördinaten nodig om een willekeurig punt voor te stellen dat deel uitmaakt van de primitieve. Om een willekeurig punt aan te duiden in de ruimte die het 3Dobject inneemt zijn 3 coördinaten nodig. Een 3DObject heeft daarom lengte, breedte en diepte. Analoog aan de polylijn (di een Curve onstaan door interpolatie tussen twee of meer punten) bestaan er ook in 3 dimensies vormen die gedefinieerd worden door sets van controlepunten. Een 3DObject wordt begrensd door meerdere Vlakken (bv kubus) of door 1 gesloten Vlak (bv bol). Bijkomende grensvlakken vormen mogelijks holtes in het 3DObject. Om binnen- en buitengrenzen te kunnen onderscheiden geldt doorgaans de afspraak dat het 3DObject links ligt van het Vlak waardoor het wordt begrensd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dimensie is te verstaan in wiskundige zin: het minimum aantal coördinaten nodig om een willekeurig punt voor te stellen dat deel uitmaakt van de primitieve. Om een willekeurig punt aan te duiden in de ruimte die het 3Dobject inneemt zijn 3 coördinaten nodig. Een 3DObject heeft daarom lengte, breedte en diepte. Analoog aan de polylijn (di een Curve onstaan door interpolatie tussen twee of meer punten) bestaan er ook in 3 dimensies vormen die gedefinieerd worden door sets van controlepunten. Een 3DObject wordt begrensd door meerdere Vlakken (bv kubus) of door 1 gesloten Vlak (bv bol). Bijkomende grensvlakken vormen mogelijks holtes in het 3DObject. Om binnen- en buitengrenzen te kunnen onderscheiden geldt doorgaans de afspraak dat het 3DObject links ligt van het Vlak waardoor het wordt begrensd."
        }
      ],
