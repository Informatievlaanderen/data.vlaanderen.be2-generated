          "@language": "nl",
          "@value": "Eenheid"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Eenheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Eenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een meeteenheid, of eenheid, is een specifieke hoeveelheid die is gekozen als schaal voor het meten van andere hoeveelheden van dezelfde soort (meer in het algemeen van equivalente dimensie)."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een meeteenheid, of eenheid, is een specifieke hoeveelheid die is gekozen als schaal voor het meten van andere hoeveelheden van dezelfde soort (meer in het algemeen van equivalente dimensie)."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld, de meter is een lengte-eenheid die rigoureus is gedefinieerd en gestandaardiseerd door het BIPM (Internationaal Bureau voor Gewichten en Maten). Elke meting van de lengte kan worden uitgedrukt als een getal vermenigvuldigd met de eenheid meter."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld, de meter is een lengte-eenheid die rigoureus is gedefinieerd en gestandaardiseerd door het BIPM (Internationaal Bureau voor Gewichten en Maten). Elke meting van de lengte kan worden uitgedrukt als een getal vermenigvuldigd met de eenheid meter."
        }
      ],
