      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het vaststellen van de waarde van een bepaald kwaliteitskenmerk van een Object op een bepaald tijdstip of tussen twee tijdstippen."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het vaststellen van de waarde van een bepaald kwaliteitskenmerk van een Object op een bepaald tijdstip of tussen twee tijdstippen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat om schattingen van de waarde, maw op de waarde zit een zekere foutmarge. Bijvoorbeeld kleur. Dit is verschillend van waarden die zijn toegekend en dus geen schattingen zijn zoals naam of prijs."
        }
      ],
