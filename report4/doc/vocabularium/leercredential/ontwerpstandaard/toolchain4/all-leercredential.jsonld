      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStatus"
    },
    {
      "@id": "urn:oslo-toolchain:a329a40c3cbcdbd2a04f17e4b95fc7081fa9b414e9f95f2fbd553735cbee41ff",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/snb/model/elm/LearningOpportunity",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Leeropportuniteit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Leeropportuniteit"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een opportuniteit om een bepaalde set leerresultaten te realiseren via een leeractiviteit en/of toetsing."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het opleidingsaanbod dat beschikbaar is voor studenteninschrijvingen in een bepaald academiejaar. Het aanbod is beschikbaar voor individuele inschrijvingen per opleidingsonderdeel of per programma. Deze nesting gebeurt via het elm:hasPart attribuut."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStatus"
    },
    {
      "@id": "urn:oslo-toolchain:b0d2542f76965295c043c431c17e4dbafa9ce692e8682945da687f521b245ebe",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/snb/model/elm/LearningAchievement",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Leerprestatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Leerprestatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verwerving van kennis, vaardigheden of verantwoordelijkheid en zelfstandigheid. Een erkend en/of toegekend geheel van leeruitkomsten van een individu."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:e39ca2c95b5c10ae6ff50aa889ab63d15b2fb85566262a9639c639667f7698c0"
