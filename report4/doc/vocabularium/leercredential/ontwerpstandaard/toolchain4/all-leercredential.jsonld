        }
      ],
      "diagramLabel": [
        {
          "@value": "Kwalificatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een specificatie van een beoordelings- en validatieproces dat wordt verkregen wanneer een bevoegde autoriteit vaststelt dat een individu leeruitkomsten volgens bepaalde normen heeft bereikt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
