        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een tekenreeks die wordt gebruikt om een resource te identificeren. Een identificator is een tekenreeks die wordt gebruikt om één instantie van een object uniek te identificeren binnen een identificatieschema dat wordt beheerd door een organisatie."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het wordt gebruikt om personen en organisaties te identificeren. In deze gevallen, en meer, zal de identificator zelf een soort alfanumerieke string zijn, maar die string heeft alleen betekenis als hij gecontextualiseerd is."
        }
      ],
