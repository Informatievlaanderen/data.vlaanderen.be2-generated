    {
      "@id": "urn:oslo-toolchain:41e09ffbf4f63b180d5ed0e6fab99210b514ba5026917bef0614848c97752200",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/snb/model/elm/LearningActivitySpecification",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Leeractiviteitspecificatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Leeractiviteitspecificatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De specificatie van een proces dat leidt tot het verwerven van kennis, vaardigheden of verantwoordelijkheid en autonomie."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het opleidingsaanbod geformaliseerd volgens een bepaalde specificatie, zoals de ECTS. Zowel een opleidingsonderdeel als een programma kunnen op deze manier gespecifieerd worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:023a19269c02a9187499064b4544255efae3517d8e93457299d8f64100c3f8fe"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStatus"
    },
    {
      "@id": "urn:oslo-toolchain:b3351fbcbcd3be2610266726c44517816bfe47ca93e85c8765053580277b666a",
      "@type": "Class",
      "assignedURI": "https://www.w3.org/2018/credentials#VerifiableCredential",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verifieerbare Credential"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VerifieerbareCredential"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een credential is een set van een of meer claims van een uitgever. Een verifieerbare credential is een fraudebestendige credential die auteurschap heeft dat cryptografisch geverifieerd kan worden ."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
