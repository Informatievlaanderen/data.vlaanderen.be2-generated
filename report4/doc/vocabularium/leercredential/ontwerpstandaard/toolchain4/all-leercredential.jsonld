    {
      "@id": "urn:oslo-toolchain:4939edbfcee961485f32848fb2c813d48b57130e6c38d088d0242266743f3b9c",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/person#Person",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Persoon"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Persoon"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Natuurlijk persoon."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Natuurlijk persoon."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."
        }
      ],
