      "assignedURI": "https://data.vlaanderen.be/ns/leercredential#Leercredential",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Leercredential"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Leercredential"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een reeks van een of meer beweringen over leerervaringen, gemaakt door een uitgever."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Verifieerbare attestering waarvan de authenticiteit cryptografisch kan worden geverifieerd. De payload van de credential wordt uitgewerkt onder het cred:credentialSubject attribuut. Een Leercredential wordt uitgegeven door een verstrekker / issuer."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
