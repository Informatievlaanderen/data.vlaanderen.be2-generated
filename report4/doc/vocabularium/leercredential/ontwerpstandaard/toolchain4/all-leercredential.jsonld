      "assignedURI": "http://data.europa.eu/snb/model/elm/volumeOfLearning",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "leervolume"
        }
      ],
      "diagramLabel": [
        {
          "@value": "leervolume"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het geschatte aantal uren dat de leerling naar verwachting zal uitgeven aan het leren om de toekenning te verdienen. Dit omvat het fictieve aantal uren in groepswerk, praktijken, evenals uren die betrokken zijn bij zelfstudie."
        },
        {
          "@language": "en",
          "@value": "The estimated number of hours the learner is expected to spend engaged in learning to earn the award. This would include the notional number of hours in, in group work, in practicals, as well as hours engaged in self-motivated study."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:1145d8d0cc58602026b05f38826e371c0b0b603bbe3c070448011fc725b6f01d"
      },
      "range": {
