      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een recht, bijvoorbeeld om een beroep uit te oefenen, een leeropportuniteit te volgen of zich aan te sluiten bij een organisatie, als gevolg van de verwerving van kennis, vaardigheden, verantwoordelijkheid en/of autonomie."
        }
      ],
