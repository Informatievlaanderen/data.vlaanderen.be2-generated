      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Elk proces dat leidt tot het verwerven van kennis,vaardigheden of verantwoordelijkheid en zelfstandigheid."
        },
        {
          "@language": "en",
          "@value": "Any process that leads to the acquisition of knowledge, skills or responsibility and independence."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Leeractiviteit"
        },
        {
          "@language": "en",
          "@value": "Learning activity"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze entitieit bevat de datapunten die te maken hebben met de deelname van een lerende aan een welbepaalde Leeropportuniteit."
        },
        {
          "@language": "en",
          "@value": "This entity contains the data points related to a learner's participation in a particular Learning Opportunity."
        }
      ],
      "assignedURI": "http://data.europa.eu/snb/model/elm/LearningActivity",
