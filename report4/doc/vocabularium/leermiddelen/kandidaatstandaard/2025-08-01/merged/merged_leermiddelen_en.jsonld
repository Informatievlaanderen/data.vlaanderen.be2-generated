      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een beschrijving van wat een persoon kan leren door gebruik te maken van de opportuniteit,uitgedrukt als leeruitkomsten. Een specificatie van het leren."
        },
        {
          "@language": "en",
          "@value": "A description of what a person can learn by taking advantage of the opportunity, expressed as learning outcomes. A specification of learning."
