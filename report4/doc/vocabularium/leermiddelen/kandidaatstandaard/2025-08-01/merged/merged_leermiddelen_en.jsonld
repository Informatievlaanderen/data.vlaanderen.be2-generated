    {
      "@id": "urn:oslo-toolchain:ece4cbd1975bb44c707b794518d90fa706b13bd8ea16bb07036f72ff58f00e26",
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een leerclaim is een stelling gemaakt door een onderwijsinstelling t.o.v. een natuurlijke persoon,in de meeste gevallen een student. Deze stelling kan slaan op de ingeschreven opleidingen van de student of de behaalde opleidingen."
        },
        {
          "@language": "en",
          "@value": "A learning claim is a statement made by an educational institution against a natural person, in most cases a student. This statement can refer to the student's enrolled programmes or the programmes obtained."
        }
      ],
      "assignedURI": "http://data.europa.eu/snb/model/elm/Claim",
      "diagramLabel": [
        {
          "@value": "Leerclaim"
        }
