    {
      "@id": "urn:oslo-toolchain:b3e58ee7e1dc892d6fa594062ef7685af0285191d9947e9301cb2e41298075ac",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De specificatie van een proces dat leidt tot het verwerven van kennis,vaardigheden of verantwoordelijkheid en autonomie."
        },
        {
          "@language": "en",
          "@value": "The specification of a process that leads to the acquisition of knowledge, skills or responsibility and autonomy."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Leeractiviteitspecificatie"
        },
        {
          "@language": "en",
          "@value": "Learning Activity Specification"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het opleidingsaanbod geformaliseerd volgens een bepaalde specificatie,zoals de ECTS. Zowel een opleidingsonderdeel als een programma kunnen op deze manier gespecifieerd worden."
        },
        {
          "@language": "en",
          "@value": "The training offer is formalized according to a certain specification, such as the ECTS. Both a course unit and a programme can be specified in this way."
        }
      ],
      "assignedURI": "http://data.europa.eu/snb/model/elm/LearningActivitySpecification",
      "diagramLabel": [
        {
          "@value": "Leeractiviteitspecificatie"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a60bb451216ca120cc984fd5b4192e0dea7d5051acbba31ff72eb8fc27578627"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De specificatie van een proces dat leidt tot het verwerven van kennis,vaardigheden of verantwoordelijkheid en autonomie."
        },
        {
          "@language": "en",
          "@value": "The specification of a process that leads to the acquisition of knowledge, skills or responsibility and autonomy."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Leeractiviteitspecificatie"
        },
        {
          "@language": "en",
          "@value": "Learning Activity Specification"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het opleidingsaanbod geformaliseerd volgens een bepaalde specificatie,zoals de ECTS. Zowel een opleidingsonderdeel als een programma kunnen op deze manier gespecifieerd worden."
        },
        {
          "@language": "en",
          "@value": "The training offer is formalized according to a certain specification, such as the ECTS. Both a course unit and a programme can be specified in this way."
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:96029ebe2ff0152d81257f4b58c836fceefaffe6839163c604ff2cc19c70f6ec",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Elk hulpmiddel dat wordt ingezet om het leerproces te ondersteunen, doelen te bereiken en zo kennis, vaardigheden en attitudes bij te brengen."
        },
        {
          "@language": "en",
          "@value": "Any tool that is used to support the learning process, achieve goals and thus impart knowledge, skills and attitudes."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Leermiddel"
        },
        {
          "@language": "en",
          "@value": "Learning tool"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze definitie is een specificatie gebaseerd op de definitie van de kwaliteitsalliantie, i.e.: Het overkoepelende begrip voor zowel papieren als digitale producten, al dan niet in combinatie, ongeacht wie ze ontwikkelt: leraren, niet-commerciële en commerciële aanbieders."
        },
        {
          "@language": "en",
          "@value": "This definition is a specification based on the definition of the Quality Alliance, i.e.: The umbrella term for both paper and digital products, whether in combination or not, regardless of who develops them: teachers, non-commercial and commercial providers."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/leermiddelen#Leermiddel",
      "diagramLabel": [
        {
          "@value": "Leermiddel"
        }
      ],
