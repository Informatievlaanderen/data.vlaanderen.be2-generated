      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Elk hulpmiddel dat wordt ingezet om het leerproces te ondersteunen, doelen te bereiken en zo kennis, vaardigheden en attitudes bij te brengen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Leermiddel"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze definitie is een specificatie gebaseerd op de definitie van de kwaliteitsalliantie, i.e.: Het overkoepelende begrip voor zowel papieren als digitale producten, al dan niet in combinatie, ongeacht wie ze ontwikkelt: leraren, niet-commerciële en commerciële aanbieders.\r\n\r\nTe substitueren door een meer specifiekere klasse van <a href=\"https://schema.org/CreativeWork\">Schema.org CreativeWork</a>. Bijvoorbeeld: Book in het geval van een boek dat bestaat uit verschillende hoofdstukken."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://schema.org/LearningResource",
      "diagramLabel": [
        {
          "@value": "Leermiddel"
        }
      ],
