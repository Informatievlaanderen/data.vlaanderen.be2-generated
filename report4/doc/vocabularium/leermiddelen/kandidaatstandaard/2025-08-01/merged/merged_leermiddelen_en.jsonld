    {
      "@id": "urn:oslo-toolchain:d4537aa4da17463d4b613c0be4e4d9dae545259d00e88538a07875fbf0d73081",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Elk hulpmiddel dat wordt ingezet om het leerproces te ondersteunen,doelen te bereiken en zo kennis,vaardigheden en attitudes bij te brengen."
        },
        {
          "@language": "en",
          "@value": "Any tool that is used to support the learning process, achieve goals and thus impart knowledge, skills and attitudes."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Leermiddel"
        },
        {
          "@language": "en",
          "@value": "Learning tool"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze definitie is een specificatie gebaseerd op de definitie van de kwaliteitsalliantie, i.e.: Het overkoepelende begrip voor zowel papieren als digitale producten, al dan niet in combinatie, ongeacht wie ze ontwikkelt: leraren, niet-commerciële en commerciële aanbieders."
        },
        {
          "@language": "en",
          "@value": "This definition is a specification based on the definition of the Quality Alliance, i.e.: The umbrella term for both paper and digital products, whether in combination or not, regardless of who develops them: teachers, non-commercial and commercial providers."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/leermiddelen#Leermiddel",
