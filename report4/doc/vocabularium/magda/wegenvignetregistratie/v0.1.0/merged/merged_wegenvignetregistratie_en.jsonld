      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het type motor of motoren dat het voertuig aandrijft."
        },
        {
          "@language": "en",
          "@value": "The type of engine or motors that drive the vehicle."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "motorType"
        },
        {
          "@language": "en",
          "@value": "motorType"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De waarde komt uit de codelijst Motortype: verbrandingsmotor of elektromotor. Een motorSpecificatie kan meerdere motorTypes hebben om aan te geven dat één geregistreerde motorSpecificatie in werkelijkheid betrekking heeft op meerdere fysieke motoren. Tevens kan het motortype ook ontbreken wanneer het niet uit de bron kan worden afgeleid."
        },
        {
          "@language": "en",
          "@value": "The value comes from the code list Engine type: combustion engine or electric motor. An engine Specification can have multiple engine Types to indicate that one registered engine Specification actually relates to multiple physical engines. Also, the engine type may also be missing if it cannot be deduced from the source."
        }
      ],
      "assignedURI": "https://schema.org/engineType",
