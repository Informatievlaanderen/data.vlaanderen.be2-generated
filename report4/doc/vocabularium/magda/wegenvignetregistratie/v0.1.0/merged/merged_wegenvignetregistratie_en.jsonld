        },
        {
          "@language": "en",
          "@value": "emission standard"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: Euro 6d. De waarde komt uit een codelijst, zodat ook andere of toekomstige emissienormen dan de Euronorm uitgedrukt kunnen worden."
        },
        {
          "@language": "en",
          "@value": "For example: Euro 6d. The value comes from a code list, so that other or future emission standards than the Euro standard can also be expressed."
        }
      ],
      "assignedURI": "https://schema.org/meetsEmissionStandard",
      "codelist": "https://data.vlaanderen.be/id/conceptscheme/Euronorm",
