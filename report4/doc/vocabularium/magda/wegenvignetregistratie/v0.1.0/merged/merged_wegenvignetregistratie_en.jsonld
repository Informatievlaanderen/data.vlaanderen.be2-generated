          "@value": "Inschrijving van een Voertuig in een nationaal register."
        },
        {
          "@language": "en",
          "@value": "Registration of a Vehicle in a national register."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Registratie"
        },
        {
          "@language": "en",
          "@value": "Registration"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het Voertuig krijgt daarbij een registratienummer en wordt gekoppeld aan een Persoon of Organisatie (al dan niet eigenaar van het Voertuig). De datum vanaf wanneer de inschrijving geldt wordt vastgelegd. Het registratienummer wordt weergegeven op een Nummerplaat."
        },
        {
          "@language": "en",
          "@value": "The Vehicle is given a registration number and is linked to a Person or Organisation (whether or not the owner of the Vehicle). The date from which the registration is valid will be determined. The registration number is displayed on a License plate."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/voertuigregistratie#Registratie",
