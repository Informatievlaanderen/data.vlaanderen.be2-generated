    {
      "@id": "urn:oslo-toolchain:b333569c8ed1a2bdc76b324fa288264120ea447b85ee847851d09a07662748c9",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De emissienorm waaraan een Voertuig voldoet volgens de referentietabel die de FOD Mobiliteit en Vervoer (DIV) in België gebruikt om de emissienormcode (Euronorm) van voertuigen in de Kruispuntbank Voertuigen te registreren en te koppelen."
        },
        {
          "@language": "en",
          "@value": "The emission standard that a Vehicle complies with according to the reference table used by the FPS Mobility and Transport (DIV) in Belgium to register and link the emission standard code (Euronorm) of vehicles in the Crossroads Bank for Vehicles."
        }
      ],
      "apLabel": [
