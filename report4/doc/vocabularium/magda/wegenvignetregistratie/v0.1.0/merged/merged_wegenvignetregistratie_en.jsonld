    {
      "@id": "urn:oslo-toolchain:f925ad8a7914f922f868fd9e29172277f40183b186465b009fac37ae2eee87aa",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een voertuig is een apparaat dat ontworpen of gebruikt is om mensen of vracht te vervoeren over land, water, lucht, of door de ruimte."
        },
        {
          "@language": "en",
          "@value": "A vehicle is a device designed or used to transport people or cargo by land, water, air, or space."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Voertuig"
        },
        {
          "@language": "en",
          "@value": "Vehicle"
        }
      ],
      "assignedURI": "https://schema.org/Vehicle",
      "diagramLabel": [
        {
          "@value": "Voertuig"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ZonderStatus"
    },
    {
      "@id": "urn:oslo-toolchain:c9cdcadeac08498302dece0e6c221d9d91f64602ecc8a93b593fd32dc55ebd0b",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie over de motor of motoren van een Voertuig."
        },
        {
          "@language": "en",
          "@value": "Information about the engine or engines of a Vehicle."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "MotorSpecificatie"
        },
        {
          "@language": "en",
          "@value": "Engine Specification"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een motorspecificatie komt overeen met één geregistreerde motor in de bron en niet noodzakelijk met één fysieke motor. Eén motorspecificatie kan een combinatie van een verbrandingsmotor en een elektromotor beschrijven, bijvoorbeeld bij een hybride voertuig. Het aantal motorspecificaties van een voertuig is daarom geen betrouwbare aanduiding van het werkelijke aantal motoren."
        },
        {
          "@language": "en",
          "@value": "An engine specification corresponds to one registered engine in the source and not necessarily to one physical engine. One engine specification can describe a combination of an internal combustion engine and an electric motor, for example in a hybrid vehicle. The number of engine specifications of a vehicle is therefore not a reliable indication of the actual number of engines."
        }
      ],
      "assignedURI": "https://schema.org/EngineSpecification",
      "diagramLabel": [
        {
          "@value": "MotorSpecificatie"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ZonderStatus"
    },
    {
      "@id": "urn:oslo-toolchain:5e5115601264f06b468abe9e4a060f0a18e20edefbf7800e770237ddacf55b87",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Inschrijving van een Voertuig voor een wegenvignet, dat het recht geeft om gedurende een bepaalde periode gebruik te maken van het wegennet."
        },
        {
          "@language": "en",
          "@value": "Registration of a Vehicle for a road vignette, which entitles the vehicle to use the road network for a certain period of time."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Wegenvignetregistratie"
        },
        {
          "@language": "en",
          "@value": "Road vignette registration"
        }
      ],
      "apUsageNote": [
