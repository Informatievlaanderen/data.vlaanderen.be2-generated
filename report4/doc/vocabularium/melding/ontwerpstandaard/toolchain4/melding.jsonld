          "@value": "Dataset"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De Dataset klasse beschrijft de gegevensbron waarop de terugmelding betrekking heeft."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:859a73738b0a21a4e0b313b7dc4ec668099afeccd5b8027bfeec8a237c6ba19e",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/melding#Meldingsobject",
