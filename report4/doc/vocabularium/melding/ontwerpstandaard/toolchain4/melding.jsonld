    {
      "@id": "urn:oslo-toolchain:ce774d4dea635b1ec64b18fc30eeec2ac5c31cb61eb8a499425b84ab126326ac",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/melding#Terugmelding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Terugmelding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Terugmelding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijft de terugmelding van fouten of onvolledigheden in digitale gegevensbronnen naar de verantwoordelijke bronbeheerder."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een terugmelding kan gebruikt worden om bijvoorbeeld een foutief adres te melden op een website of een fout in de digitale weergave van een diploma."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6d03ed7822358cf3f833f303a58a284f72d8ff068e3a523cd72a0c852ea49aa8"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:6d03ed7822358cf3f833f303a58a284f72d8ff068e3a523cd72a0c852ea49aa8",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/melding#Melding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Melding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Melding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijft de melding van een probleem of een vaststelling die mogelijks aanleiding geeft tot een actie van de overheid."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijft de melding van een probleem of een vaststelling die mogelijks aanleiding geeft tot een actie van de overheid."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Een melding kan gebruikt worden voor vaststellingen in de echte wereld,bijvoorbeeld het melden van een put in de weg of sluikstort,of voor het melden van fouten of onvolledigheden in digitale gegevensbronnen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De Melding kan gebruikt worden voor het capteren van feedback met betrekking tot concrete informatievelden (bv. foutieve of ontbrekende informatie wordt weergegeven) of feedback dat slaat op reële wereld objecten zoals een put in de weg of sluikstort."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:31d5fd4e567239da9851ef711cec0122a268fbaf1f53e1d48ab14606f13dade6",
      "@type": "Class",
