      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Agent met een positie."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hoedanigheid"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Laat een functie toe om te handelen,bv ihkv een dienstverlening (bv diversiteitsplan wordt opgemaakt door diversiteitsambtenaar)."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:3eaa9c1a53de10e4c3d253f8c9f6efbe23b4ceb912d8668eef4e9a42f07b7195",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon",
      "diagramLabel": [
        {
          "@value": "GeregistreerdPersoon"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7de83ea776c49664af330a12a6e31eff474a12ab509d4d09a833f8f528a96ed5"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon waarvan de gegevens zijn ingeschreven in een register."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Geregistreerd Persoon"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb Naam en Voornaam) en de Verblijfplaats vd Persoon en op belangrijke levensgebeurtenissen zoals Geboorte, Huwelijk, Overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven Persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:7de83ea776c49664af330a12a6e31eff474a12ab509d4d09a833f8f528a96ed5",
      "@type": "Class",
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke Organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://www.w3.org/ns/person#Person",
      "diagramLabel": [
        {
          "@value": "Persoon"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:9847b84c181a2c9f24230691c90d3948d23256be791ade1a69d7f950434a9bb3"
        }
      ],
