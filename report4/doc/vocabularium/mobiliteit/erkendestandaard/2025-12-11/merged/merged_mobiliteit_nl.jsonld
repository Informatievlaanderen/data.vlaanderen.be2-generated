      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit kan een verkeersbord,verkeerslicht of wegmarkering zijn. Merk op: het gaat hier om de conceptuele weergave en niet om de fysieke wegsignalisatie op het openbaar domein."
        }
