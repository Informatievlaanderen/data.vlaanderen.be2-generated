      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Formally defined part of a legal expression,describing one or more of the intended legal effects."
        },
        {
          "@language": "nl",
          "@value": "Formeel afgebakend onderdeel van een besluit,dat een of meer van de beoogde rechtsgevolgen beschrijft."
        }
      ],
