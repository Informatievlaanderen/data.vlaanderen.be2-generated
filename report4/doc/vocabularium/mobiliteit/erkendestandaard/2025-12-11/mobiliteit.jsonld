    {
      "@id": "urn:oslo-toolchain:6dfca6f22592a0e58e8d1ce00c05578a21037078a9c0c19fe1f2ca054f1a3125",
      "@type": "Class",
      "assignedURI": "http://data.vlaanderen.be/ns/besluit#Besluit",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Besluit"
        },
        {
          "@language": "en",
          "@value": "Resolution"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Besluit"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De authentieke schriftelijke neerslag van een beslissing van een bestuursorgaan. Deze beslissing houdt een rechtshandeling in waarbij sprake is van een beoogd rechtsgevolg."
        },
        {
          "@language": "en",
          "@value": "The authentic written summary of a decision of a governing body. This decision involves a legal act with an intended legal effect."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Hieronder vallen zowel individuele besluiten (rechtshandelingen met een individueel karakter zoals het toekennen van een subsidie) als besluiten van algemene strekking (beslissingen van algemene reglementaire strekking die niet gericht zijn op een individu maar op een groep, zoals de verkeersregels)."
        },
        {
          "@language": "en",
          "@value": "This includes both individual resolutions (legal acts with an individual character such as grants) and general resolutions (decisions of general rules that are aimed at a group rather than individuals, such as the traffic rules)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
