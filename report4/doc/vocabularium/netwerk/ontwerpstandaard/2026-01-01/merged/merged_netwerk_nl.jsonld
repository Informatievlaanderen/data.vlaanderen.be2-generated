    {
      "@id": "urn:oslo-toolchain:2b33424ef5adcac18d12c7bd9a007ab5f9c94e8a003867736586570465627d57",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://data.vlaanderen.be/ns/netwerk#toepassingsRichting",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "toepassingsrichting"
        }
      ],
      "diagramLabel": [
        {
          "@value": "toepassingsRichting"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Richting van de link waarop de referentie van toepassing is."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb is een snelheidsbeperking geldig voor de ene richting of voor de andere of in beide richtingen. Om de ene richting te onderscheiden van de andere staat \"gelijklopend\" voor de richting die gelijkloopt met de digitalisatierichting van het lineair netwerkelement en \"tegengesteld\" voor de richting die tegengesteld is aan de digitalisatierichting. In het geval de referentie niet slaat op de richting van de link, maar op een fenomeen langs de link (bvb een fietspad of straatverlichting), komt \"gelijklopend\" overeen met de rechterkant en \"tegengesteld\" met de linkerkant."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:8e6ba9f8d13f6451dd21f4b7e86a0f6f1dff9b6f1ead1485a10b045dd93236e1"
      },
      "range": {
        "@id": "urn:oslo-toolchain:47d39d9a5e36a1e27633fe0456df74254a3f9955400faa7b2dab1e65eda18bd2"
      },
      "minCount": {
        "@value": "0",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      "maxCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
