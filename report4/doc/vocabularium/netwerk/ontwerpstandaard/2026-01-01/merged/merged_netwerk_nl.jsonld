  "referencedEntities": [
    {
      "@id": "urn:oslo-toolchain:44089177c3fcdd5a33e4ce950dc2a6d93aab39ebda01145fd471627dc8387166",
      "assignedURI": "http://www.w3.org/ns/adms#Identifier",
