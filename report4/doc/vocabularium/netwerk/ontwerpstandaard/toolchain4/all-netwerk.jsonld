      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem. Meer uitgebreide beschrijving in het AP OSLO-Generiek."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
