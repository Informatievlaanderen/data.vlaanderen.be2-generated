    {
      "@id": "urn:oslo-toolchain:602a9f655dad6e341d219381bdbcfadd9753cee2fa10579442bc1fcee1e17c94",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een geografisch gebied, dat typisch onder de jurisdictie van een bepaalde publieke administratie valt."
        },
