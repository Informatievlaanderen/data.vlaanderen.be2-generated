      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De vaststelling/bepaling van de vergunde toestand op een bepaald moment in de tijd, op basis van de op dat moment beschikbare informatie over relevante rechtsfeiten (omgevingsvergunning:Gebeurtenissen) die op de vergunde toestand van invloed zijn geweest."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vaststelling Vergunde Toestand"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:a73d220ad7a3d197ea6118e2906f042819899bda3e8dab9f66fa373f56fae59b",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/omgevingsvergunning#Recht",
      "diagramLabel": [
        {
          "@value": "Recht"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:310d5d3a7070ab01232e5d52ff12c4f9fb8a058f2c2beac2924ef8c2c9f972d9"
