        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:54c2efba5d12af804df7ef267b175ce7cd68663c3e82a3e5b93690a4b98887ef",
      "@type": "Class",
      "assignedURI": "http://dbpedia.org/ontology/Case",
      "diagramLabel": [
        {
          "@value": "Zaak"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een Zaak is de uitwerking van een bepaalde overheidsbevoegdheid op een specifieke kwestie of situatie."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Zaak"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De bevoegde overheid geniet daarbij een zekere graad van vrijheid maar is tevens gebonden aan procedurele voorschriften. De overheid heeft bijvoorbeeld de mogelijkheid om aanvragen, verzoeken of klachten samen te voegen en gezamenlijk te behandelen. Op de werkvloer wordt vaak de term dossier afwisselend in deze betekenis gebruikt of in de betekenis van OSLO Dossier zijnde een neerslag van een Zaak in een geheel van stukken. In casemanagement systemen die CMMN implementeren komt deze entiteit overeen met een Case."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:15f702ca632dfe1c63b2f49cfe703bdb4892acab31cda5324ab5ef73ea5a6907",
