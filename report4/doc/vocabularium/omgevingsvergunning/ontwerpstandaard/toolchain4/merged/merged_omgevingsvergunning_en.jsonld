      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een formele handeling die in het kader van een Zaak wordt uitgevoerd."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Zaakhandeling"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het kan gaan om Rechtshandelingen, maar ook administratieve handelingen. In casemanagement systemen die CMMN implementeren komt deze entiteit overeen met een PlanItem."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:5b38d8c0d61984aaaf26bd74d5ea309601e595e7a7fd4f64abf7937148016003",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/omgevingsvergunning#RechterlijkeUitspraak",
