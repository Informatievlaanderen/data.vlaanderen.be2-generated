          "@id": "urn:oslo-toolchain:2eb0251cfec565b5f6d5efb42a1765dfae8181f926c2138d197501f46e7e1cf4"
        },
        {
          "@id": "urn:oslo-toolchain:818ad6439c28c90547a442556023bc28924359cbc79854d72c0453ffe52d10af"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De Rechtshandeling, zijnde een beslissing, die toelating inhoudt voor een Activiteit."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
