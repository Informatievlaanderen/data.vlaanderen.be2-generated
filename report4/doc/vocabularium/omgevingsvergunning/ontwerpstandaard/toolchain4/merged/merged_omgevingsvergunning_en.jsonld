      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De toestemming om een bepaalde activiteit uit te voeren op een bepaalde locatie, waarvoor, op het moment van aanvraag of melding, een specifieke vergunning of melding vereist is volgens de geldende regelgeving op het gebied van ruimtelijke ordening en milieu."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Recht"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:310d5d3a7070ab01232e5d52ff12c4f9fb8a058f2c2beac2924ef8c2c9f972d9",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/omgevingsvergunning#NormatieveBepaling",
      "diagramLabel": [
        {
          "@value": "NormatieveBepaling"
        }
      ],
      "parent": [
