          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://data.europa.eu/eli/ontology#LegalResource",
      "diagramLabel": [
        {
          "@value": "Rechtsgrond"
        }
      ],
      "parent": [
        {
