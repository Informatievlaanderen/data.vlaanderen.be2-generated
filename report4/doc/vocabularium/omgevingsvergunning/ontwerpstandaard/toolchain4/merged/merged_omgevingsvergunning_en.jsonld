          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Een juridische kwalificatie gebeurt aan de hand van juridische verwijzingen, nl. verwijzingen naar Juridische Werken. Het is mogelijk om een juridische kwalificatie op verschillende dimensies (bv. een activiteit kwalificeren op vlak van indelingsrubrieken en op vlak van Sevezo-regelgeving) te doen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
