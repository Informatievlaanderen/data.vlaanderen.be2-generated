      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Heestertype gekenmerkt door een gesloten, massieve structuur, waarbij de individuele heesters moeilijk te onderscheiden zijn."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In functie van bijvoorbeeld de vrije doorgang kan wel beslist worden om een of twee kanten te scheren. Definitie naar het technisch vademecum Heesters van het Agentschap voor Natuur en Bos."
        }
      ],
      "apUsageNote": [
