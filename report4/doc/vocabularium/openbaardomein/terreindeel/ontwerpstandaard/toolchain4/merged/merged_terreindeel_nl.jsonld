      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een lijnvormig prefab inrichtingselement met een breedte kleiner dan 7cm en een minimale lengte van 100cm dat gebruikt wordt voor de duurzame afboording van zones of geleiding van verkeersstromen."
        }
      ],
