    {
      "@id": "urn:oslo-toolchain:07b9bd9395a9f41f8a819f72bc0bfa06b97cec771e3a2a04e64e8531116f0f46",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Wegbaan",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Wegbaan"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Wegbaan"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De wegbaan (Wbn) is de voorstelling van de wegcorridor in het GRB. De wegbaan wordt overlangs opgedeeld in verschillende arbitrair afgebakende wegbaanelementen. Er zijn twee types wegbaanelementen: een kruispuntzone komt overeen met een kruispunt; een wegsegment komt overeen met een wegvak."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "De wegbaan (Wbn) is de voorstelling van de wegcorridor in het GRB. De wegbaan wordt overlangs opgedeeld in verschillende arbitrair afgebakende wegbaanelementen. Er zijn twee types wegbaanelementen: een kruispuntzone komt overeen met een kruispunt; een wegsegment komt overeen met een wegvak."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Naar GRB-basis - WBN: Rand van de wegbaan"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Naar GRB-basis - WBN: Rand van de wegbaan"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
