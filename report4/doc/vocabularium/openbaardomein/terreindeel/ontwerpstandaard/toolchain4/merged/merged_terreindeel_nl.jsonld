    },
    {
      "@id": "urn:oslo-toolchain:8a627bb8815807b82b347387e723c2ee590a0eb84435b214478d669ba786afe4",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/openbaardomein/terreindeel#Rijbaan",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Rijbaan"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Rijbaan"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het deel van de openbare weg dat voor het voertuigenverkeer in het algemeen is ingericht."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het deel van de openbare weg dat voor het voertuigenverkeer in het algemeen is ingericht."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Definitie naar Koninklijk besluit houdende algemeen reglement op de politie van het wegverkeer en van het gebruik van de openbare weg. De rijbaan bestaat in de regel uit het geheel der verharde rijstroken en het aansluitend gelijkgronds verhard fietspad. Zie ook GRB entiteit rand van de rijbaan (Wrb)."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Definitie naar Koninklijk besluit houdende algemeen reglement op de politie van het wegverkeer en van het gebruik van de openbare weg. De rijbaan bestaat in de regel uit het geheel der verharde rijstroken en het aansluitend gelijkgronds verhard fietspad. Zie ook GRB entiteit rand van de rijbaan (Wrb)."
        }
      ],
