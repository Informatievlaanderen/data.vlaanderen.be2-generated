      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een oprit is het gedeelte van een (woon)perceel bedoeld voor het parkeren of stallen van een voertuig, of voor het bereiken van de bij het huis behorende garage. Een oprit is altijd direct bereikbaar vanaf de openbare weg."
        }
      ],
