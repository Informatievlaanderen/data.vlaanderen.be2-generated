    },
    {
      "@id": "urn:oslo-toolchain:38bf20e084264dc2e920f12c0276b3ee63f57cfc35c28f6b673de462bbbbe2d4",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#ChangeEvent",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Veranderingsgebeurtenis"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Veranderingsgebeurtenis"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis waardoor een Organisatie een belangrijke wijziging ondergaat zoals een fusie of een herstructurering."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Is bedoeld voor situaties waarbij de de resulterende Organisatie zodanig verschilt van de oorspronkelijke dat ze beschouwd kan worden als een nieuwe Organisatie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:05045d6b80403e66b18609e8c2b1b6c5a7fd20e54b9627357bd305dd6b0483a6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:07a9fec5a4cf49d52de4dab5e8f826b30ce7e5033cbf66e3f2c3860f5a23803e",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#FormalOrganization",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "FormeleOrganisatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "FormeleOrganisatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een erkende Organisatie, erkend in brede zin of  meer specifiek in juridische zin met bijbehorende rechten en plichten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld een bedrijf, een vzw, een overheidsorgaan, een kerkgemeenschap."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:c44841797c8029b1806e79a46e7ca084af9d0705f774c6af9a52b01f7722a8e8"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:c44841797c8029b1806e79a46e7ca084af9d0705f774c6af9a52b01f7722a8e8",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Organization",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Organisatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Organisatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een Organisatie heeft dikwijls een hiërarchische structuur."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:c80ed1f8970a40fc04f39a1b65e457da0179c264b2eb4b87949840dd98a9db5a"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:35b996a85cc1244bd3c5705544ee01aa31f491a9bad9b45491b104887e1fb42b",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Site",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Vestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Vestiging"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een kantoor of ander pand waar een Organisatie gevestigd is. Organisaties kunnen over meerdere Vestigingen verspreid zijn en Vestigingen kunnen op meerdere locaties slaan."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Meestal zal de Vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten, bijvoorbeeld een virtueel kantoor met bijbehorend postnummer en telefonische receptie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:05045d6b80403e66b18609e8c2b1b6c5a7fd20e54b9627357bd305dd6b0483a6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
