        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis waarbij een organisatie wordt vervangen door een andere."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: doorstart van een bedrijf na technisch faillissement."
        }
      ],
