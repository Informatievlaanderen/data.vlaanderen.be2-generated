        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis waarbij uit één Organisatie twee Organisaties worden gevormd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
