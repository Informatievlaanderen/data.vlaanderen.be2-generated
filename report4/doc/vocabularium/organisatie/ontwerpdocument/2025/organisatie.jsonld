      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Verwijst naar een plek waar de Organisatie op een of andere manier, desnoods indirect, aanwezig is."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Indirect bijvoorbeeld een virtueel kantoor waarvan de locatie niet rechtstreeks achterhaald kan worden (bijvoorbeeld een postbus). In België mogen in de KBO GeregistreerdeOrganisaties enkel fysieke locaties als Vestiging registreren."
        }
      ],
