    {
      "@id": "urn:oslo-toolchain:95e5f5476e48a7e75370d4c8e54776bbac539d6032677220980db9f579cd7b3c",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Site",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Vestiging"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een kantoor of ander pand waar een Organisatie gevestigd is. Organisaties kunnen over meerdere vestigingen verspreid zijn en vestigingen kunnen op meerdere locaties slaan."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Meestal zal de Vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten, bv een virtueel kantoor met bijbehorend postnummer en telefonische receptie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f0b67e102494f6e84b09a65ff03ddb63e03ad5caa69d5e5d8dc2e28a7036b4e6",
