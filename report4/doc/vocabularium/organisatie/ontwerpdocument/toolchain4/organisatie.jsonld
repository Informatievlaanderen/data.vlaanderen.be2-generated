        }
      ],
      "diagramLabel": [
        {
          "@value": "AdresseerbaarObject"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geografisch object dat met een adres kan worden geïdentificeerd."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Geografisch object dat met een adres kan worden geïdentificeerd."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Is abstract, ttz het type adresseerbaar object moet altijd worden opgegeven (vb gebouweenheid, perceel)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
