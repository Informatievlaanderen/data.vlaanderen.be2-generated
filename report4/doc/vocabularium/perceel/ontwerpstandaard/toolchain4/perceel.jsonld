    {
      "@id": "urn:oslo-toolchain:26a86a9f77b5c117ac98321d07ce9d19b1f261beddba67ee12456d7cb39e7d64",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kadastraal Planperceel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KadastraalPlanperceel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een gedeelte van het Belgische grondgebied, geografische afgebakend en geïdentificeerd door de AAPD op het kadastraal percelenplan, dat overeenstemt met het grondoppervlak van één of meerdere kadastrale patrimoniale percelen."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een gedeelte van het Belgische grondgebied, geografische afgebakend en geïdentificeerd door de AAPD op het kadastraal percelenplan, dat overeenstemt met het grondoppervlak van één of meerdere kadastrale patrimoniale percelen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Kadastraal Planperceel komt overeen met de entiteit CadastralParcel uit INSPIRE Cadastral Parcel."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Kadastraal Planperceel komt overeen met de entiteit CadastralParcel uit INSPIRE Cadastral Parcel. De identificator die gedefinieerd kan worden voor een Kadastraal planperceel komt overeen met de CaPaKey (bijvoorbeeld 11111A2222/33B444)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6059c482b504166bd63bdc17b88684afc046c6f5431f0d91d827540c184d1654"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
