          "@value": "RuimtelijkeEenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Eén gebied (of meerdere gebieden) van land en/of water, of één enkel volume (of meerdere volumes) ruimte, afgebakend voor een bepaald doel."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Eén gebied (of meerdere gebieden) van land en/of water, of één enkel volume (of meerdere volumes) ruimte, afgebakend voor een bepaald doel."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Definitie conform ISO 19152 - Land Administration Domain Model."
        }
      ],
