      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Persoon"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:fb1abcbf9067e67e531cef01cafcc9c3a30dfd015c4e8e023ed165f9c6a3cdf0",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#BurgerlijkeStaat",
