      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Burgerrechtelijke toestand van een persoon."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Burgerlijke Staat"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Slaat op huwelijk, partnerregistratie, afstamming, voogdij etc. Is maw de toestand van bepaalde verhoudingen tussen personen."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:235e7d31155a2f9deaa60c7915837b56fcb0e54c1954b52302d83ce8f25b6383",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Vreemdeling",
      "diagramLabel": [
        {
          "@value": "Vreemdeling"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:27e0723b2b02137ab3779b94feb0d9accbb8a34c11518c482762fbc9537403c9"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon die niet de nationaliteit bezit vh land waar hij verblijft."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vreemdeling"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Daardoor kan de persoon geen staatsburger worden genoemd. In praktijk geniet de Vreemdeling als Inwoner een subset vd burgerrechten die een Staatsbutger wel heeft. Bv wel godsdienstvrijheid maar geen stemrecht."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:8524cde7577e6d44792de6730ce7f1354065ab30225b0e71b22d8d6fb66addb4",
      "@type": "Class",
