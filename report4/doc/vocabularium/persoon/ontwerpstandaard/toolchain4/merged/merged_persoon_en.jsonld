    {
      "@id": "urn:oslo-toolchain:85bb7c501bb61b2b834ceb059443dc620bc6e9f872623800a27532f36c4d30c8",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Inwonerschap",
