      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Relatie tussen leden van eenzelfde gezin."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gezinsrelatie"
        },
