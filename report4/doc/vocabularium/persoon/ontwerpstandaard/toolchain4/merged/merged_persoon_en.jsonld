      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Juridische band ve persoon met een staat, waaraan bepaalde rechten en plichten verbonden zijn"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Staatburgerschap"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Vloeit meestal voort uit de nationaliteit ve persoon. De rechten en plichten waarvan sprake zijn burgerrechten (vb godsdienstvrijheid) of van politieke (vb stemrecht) of sociale aard (bv recht op een uitkering)."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:efa590cdeebdbb61cd93679f4fe52b6823ffc837503092f03ad60f844441b661",
      "@type": "Class",
