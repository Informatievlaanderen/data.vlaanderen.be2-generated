  "branchtag": "master",
  "classes": [
    {
      "@id": "urn:oslo-toolchain:6167d48cf2aee61b179b3d0f9b2ca8336bca710cfbf9e01c746df075714456a1",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Stapsgewijze variatie van een fenomeen in ruimte of tijd."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In tegenstelling tot een ContinueBereik waarbij voor elk punt binnen het onderzocht gebied of voor elk punt op de tijdsas een waarde kan worden vastgesteld, is bij een DiscreetBereik de waarde enkel gekend voor een eindige set van punten of deelgebieden. Bv bij remote sensing is de waarde gekend voor de pixels van het beeld (waarbij de vastgestelde waarde, bv de reflectiegraad, dezelfde is voor elk punt binnen eenzelfde pixel). De opdeling kan kunstmatig zijn (zoals het geval met de pixels of bv bij sampling van een gebied dmv meetpunten) of natuurlijk (bv aantal inwoners per gemeente, waarbij het aantal inwoners constant is binnen de gemeentegrens). Dmv interpolatie kan een DiscreetBereik worden omgezet in een ContinueBereik, de meetpunten vormen dan ahw de controlepunten van de interpolatiefunctie."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19123/2005/DiscreteCoverages#CV_DiscreteCoverage",
      "diagramLabel": [
        {
          "@value": "DiscreetBereik"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c9c7ff9960d5cdb1ef0e0c003cf3260d310aff3690c09bec81b74a4c5a2b3f0"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "DiscreetBereik"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:5c9c7ff9960d5cdb1ef0e0c003cf3260d310aff3690c09bec81b74a4c5a2b3f0",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Variatie van een fenomeen in ruimte of tijd."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Voor situaties waarbij een fenomeen geen constante als waarde oplevert (bvb kleur), maar eerder hoe het fenomeen varieert in functie van locatie of tijd (bvb de temperatuur binnen een bepaald gebied of binnen een bepaalde periode)."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19123/2005/CoverageCore#CV_Coverage",
      "diagramLabel": [
        {
          "@value": "Bereik"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
