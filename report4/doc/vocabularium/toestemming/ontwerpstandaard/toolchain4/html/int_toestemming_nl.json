    {
      "id": "https://data.vlaanderen.be/ns/toestemming#Verwerkersovereenkomst",
      "vocabularyLabel": {
        "nl": "Verwerkersovereenkomst"
      },
      "applicationProfileLabel": {
        "nl": "Verwerkersovereenkomst"
      },
      "vocabularyDefinition": {
        "nl": "De overeenkomst die de verhouding tussen de verwerkersverantwoordelijke en de verwerker regelt. In deze overeenkomst wordt onder andere het doel van de verwerking, de beveiliging, geheimhouding, bewaartermijnen, procedures met betrekking tot vergeet-, wijzigings- en portatieverzoeken en de aansprakelijkheidsverdeling geregeld."
      },
      "applicationProfileDefinition": {
        "nl": "De overeenkomst die de verhouding tussen de verwerkersverantwoordelijke en de verwerker regelt. In deze overeenkomst wordt onder andere het doel van de verwerking, de beveiliging, geheimhouding, bewaartermijnen, procedures met betrekking tot vergeet-, wijzigings- en portatieverzoeken en de aansprakelijkheidsverdeling geregeld."
      },
      "vocabularyUsageNote": {
        "nl": "De verwerkersovereenkomst vervangt de ‘bewerkersovereenkomst’ uit de Wet bescherming persoonsgegevens en is verplicht."
      },
      "applicationProfileUsageNote": {
