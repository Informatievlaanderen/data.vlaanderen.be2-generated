      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Laat een functie toe om te handelen,bv ihkv een dienstverlening (bv diversiteitsplan wordt opgemaakt door diversiteitsambtenaar)."
        }
      ],
      "apUsageNote": [
