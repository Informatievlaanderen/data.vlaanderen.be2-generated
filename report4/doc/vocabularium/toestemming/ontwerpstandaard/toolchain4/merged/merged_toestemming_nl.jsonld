    },
    {
      "@id": "urn:oslo-toolchain:3ad0871d65f816bfcb27b4169afe474876b47c0f8c16fcaf5390015f7f5e08ca",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/toestemming#Verwerkingsactiviteit",
