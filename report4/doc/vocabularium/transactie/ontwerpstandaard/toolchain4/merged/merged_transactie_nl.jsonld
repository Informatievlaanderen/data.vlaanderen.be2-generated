    },
    {
      "@id": "urn:oslo-toolchain:f777c08b52c4352e6fd115d21d1d81351a877cb710579c1f272a03b5b59ed42a",
      "@type": "Class",
      "assignedURI": "http://purl.org/vocab/cpsv#PublicService",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Publieke Dienstverlening (aanbod)"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PubliekeDienstverlening (aanbod)"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een publieke dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen hiervan."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De dienstverlening zoals beschreven door het dienstverleningsregister."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:5e96d05a3825bd471bf4fd03b5be564dd897b52b1f3232805bfcc615b0ece6c7",
      "@type": "Class",
      "assignedURI": "http://data.europa.eu/m8g/RequirementResponse",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Criterium antwoord"
        }
      ],
      "diagramLabel": [
        {
          "@value": "CriteriumAntwoord"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een criterium antwoord is een bewering over een bepaald criterium vereiste. Met deze klasse wordt het effectieve antwoord van een agent op een criterium vereiste bedoelt. Een beantwoorde vereiste bestaat uit een specifieke waarde voor de specifieke vereiste en het tijdsinterval waarop de waarde van toepassing is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:9e5e0c767f5217007a01e9bda12791b3efcbb7039bfb8644a83b1f10ad7e0d8e",
      "@type": "Class",
      "assignedURI": "https://lod.milieuinfo.be/ns/dossier",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Case"
        },
        {
          "@language": "nl",
          "@value": "Dossier"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Dossier"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een dossier is het geheel aan werk gedaan om tot een bestuurlijke of zakelijke beslissing te komen. Een dossier slaat doorgaans neer in een verzameling documenten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te gebruiken als logische bundeling van documenten binnen een bepaalde publieke dienstverlening."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    }
