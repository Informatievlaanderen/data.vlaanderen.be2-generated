    {
      "@id": "urn:oslo-toolchain:f7331c667b4b94f53675b567c9ec963163a98a8c789d9e9c732fd77bd8b5011e",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een onroerend goed of onroerend recht dat in hoofde van één of meerdere titularissen van een zakelijk recht onderworpen is aan een bepaald eigendomsstatuut."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze definitie is gealigneerd met de definitie van de Algemene Administratie van de PatrimoniumDocumentatie (AAPD). Kadastraal Patrimoniumperceel komt overeen met de entiteit BasicPropertyUnit uit INSPIRE Cadastral Parcel. De identificator die gedefinieerd kan worden voor een Kadastraal patrimoniumperceel komt overeen met de PatKey. Ter informatie: de PatKey is samengesteld uit de CaPaKey en het partitienummer. Bijvoorbeeld: in Patkey 11111A2222/33B444_P0000 is 11111A2222/33B444 de CaPaKey en P0000 het partitienummer."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/perceel#KadastraalPatrimoniumperceel",
