      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze andere entiteiten zijn typisch Sensoren, Bemonsteraars, Actuators of andere Platformen. In de context van Verkeersmetingen definiëren we de subklasse Toestel als mogelijke basis voor één of meer Sensoren. OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensoren en Bemonstering</a>."
        },
        {
          "@language": "en",
          "@value": "These other entities are typically Sensors, Samplers, Actuators or other Platforms. In the context of TrafficMeasurements, we define the Device subclass as a possible basis for one or more Sensors. REMARK: For more details about this class see <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensors and Sampling</a>."
        },
        {
          "@language": "en",
          "@value": "These other entities are typically Sensors, Samplers, Actuators or other Platforms. In the context of TrafficMeasurements, we define the Device subclass as a possible basis for one or more Sensors. REMARK: For more details about this class see <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensors and Sampling</a>."
        }
      ],
      "assignedURI": "https://www.w3.org/ns/sosa/Platform",
      "diagramLabel": [
        {
          "@value": "Platform"
        }
      ],
