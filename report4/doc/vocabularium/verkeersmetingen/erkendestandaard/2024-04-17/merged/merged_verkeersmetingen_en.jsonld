    {
      "@id": "urn:oslo-toolchain:a16ccea5e174267f5995976d8234c8c9d79db81242e050e38fac265bbc334898",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Punt waarlangs men kenmerken van het voorbijkomend verkeer meet."
        },
