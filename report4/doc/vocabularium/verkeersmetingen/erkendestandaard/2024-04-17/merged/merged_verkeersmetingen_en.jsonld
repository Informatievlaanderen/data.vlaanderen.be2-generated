    {
      "@id": "urn:oslo-toolchain:b547d59b11355724c45921f908152dcf4421c6c29c617a3ee666f9d189c1dff1",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Geeft aan welke op welk Wegdeel het Verkeersmeetpunt gelegen is of betrekking heeft."
        },
        {
          "@language": "en",
          "@value": "Indicates on which road section the TrafficMeasurementPoint is located on or relates to."
        },
        {
          "@language": "en",
          "@value": "Indicates on which road section the TrafficMeasurementPoint is located on or relates to."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "wegdeel"
        },
        {
          "@language": "en",
          "@value": "roadSection"
        },
        {
          "@language": "en",
          "@value": "roadSection"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Alternatief voor of aanvulling op geometrie of netwerkreferentie. Ook noodzakelijk om aan te geven op welk deel van de weg de Voertuigen of Verkeersdeelnemers waarvan men een kenmerk meet zich bevinden, bvb op een bepaalde Rijstrook of op het Fietspad of het Voetpad."
        },
        {
          "@language": "en",
          "@value": "Alternative or supplement to geometry or network reference. Also necessary to indicate on which part of the road the Vehicles or TrafficParticipants, whose characteristic is being measured, are located, for example on a certain Lane or on the BiyclePath or Sidewalk."
        },
        {
          "@language": "en",
          "@value": "Alternative or supplement to geometry or network reference. Also necessary to indicate on which part of the road the Vehicles or TrafficParticipants, whose characteristic is being measured, are located, for example on a certain Lane or on the BiyclePath or Sidewalk."
