    {
      "@id": "urn:oslo-toolchain:b2554e033940232c64476cdf60d597d9bc77be1d4ae66956b64cdb6f017ffd40",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Deel van de wegbaan uitsluitend bedoeld voor fietsverkeer."
        },
        {
          "@language": "en",
          "@value": "Section of roadway intended exclusively for bicycle traffic."
        },
        {
          "@language": "en",
          "@value": "Section of roadway intended exclusively for bicycle traffic."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Fietspad"
        },
        {
          "@language": "en",
          "@value": "BicyclePath"
        },
        {
          "@language": "en",
          "@value": "BicyclePath"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Maakt geen deel uit vd rijbaan (de rijbaan is het deel van de wegbaan ingericht voor het verkeer van Voertuigen), bvb auto's mogen niet op een Fietspad rijden of stationeren. OPGELET: Niet te verwarren met fietssuggestiestroken (wel deel vd rijbaan) of met de zijstroken ve middenrijbaan (geen deel vd rijbaan maar waarop mag gereden worden door auto's om tegenliggers te ontwijken). Fietspaden kunnen aanliggend zijn aan de rijbaan of vrijliggend of zelfs een eigen wegbaan hebben (in dat laatste geval worden ze door een eigen Wegsegment voorgesteld)."
        },
        {
          "@language": "en",
          "@value": "Is not part of the carriageway (the carriageway is the part of the roadarea designed for vehicle traffic), e.g. cars are not allowed to drive or station on a BicyclePath. ATTENTION: Not to be confused with bicycle lanes (part of the carriageway) or with the side lanes of the central carriageway (not part of the carriageway but on which cars may drive to avoid oncoming traffic). BicyclePaths can be adjacent to the carriageway or separate or even have their own road Lane (in the latter case they are represented by their own RoadSegment)."
        },
        {
          "@language": "en",
          "@value": "Is not part of the carriageway (the carriageway is the part of the roadarea designed for vehicle traffic), e.g. cars are not allowed to drive or station on a BicyclePath. ATTENTION: Not to be confused with bicycle lanes (part of the carriageway) or with the side lanes of the central carriageway (not part of the carriageway but on which cars may drive to avoid oncoming traffic). BicyclePaths can be adjacent to the carriageway or separate or even have their own road Lane (in the latter case they are represented by their own RoadSegment)."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/verkeersmetingen#Fietspad",
      "diagramLabel": [
