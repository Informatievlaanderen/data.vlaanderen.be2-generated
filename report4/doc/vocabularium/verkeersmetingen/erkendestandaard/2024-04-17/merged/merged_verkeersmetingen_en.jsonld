    {
      "@id": "urn:oslo-toolchain:48c51c999e9d339d268188a71bb6706041ba5d980f80f57b7b1d39f5077c5386",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Vastgelegde of officiële manier om iets te doen."
        },
        {
          "@language": "en",
          "@value": "A workflow, protocol, plan, algorithm, or computational method specifying how to make an Observation, create a Sample, or make a change to the state of the world (via an Actuator)."
        },
        {
          "@language": "en",
          "@value": "A workflow, protocol, plan, algorithm, or computational method specifying how to make an Observation, create a Sample, or make a change to the state of the world (via an Actuator)."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Procedure"
        },
        {
          "@language": "en",
          "@value": "Procedure"
        },
        {
          "@language": "en",
          "@value": "Procedure"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Slaat op de manier waarop Observaties of Bemonstering worden uitgevoerd of Actuators worden bediend. Neemt in praktijk de vorm aan van een workflow, protocol, plan, algoritme,berekeningswijze etc. OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensoren en Bemonstering</a>."
        },
        {
          "@language": "en",
          "@value": "Refers to the manner in which Observations or Sampling are performed or Actuators are operated. In practice, it takes the form of a workflow, protocol, plan, algorithm, calculation method, etc. REMARK: For more details about this class see <a href=\"https://data.vlaanderen.be/doc/applicationprofiel/sensoren-en -sampling/\">AP Sensors and Sampling</a>."
        },
        {
          "@language": "en",
          "@value": "Refers to the manner in which Observations or Sampling are performed or Actuators are operated. In practice, it takes the form of a workflow, protocol, plan, algorithm, calculation method, etc. REMARK: For more details about this class see <a href=\"https://data.vlaanderen.be/doc/applicationprofiel/sensoren-en -sampling/\">AP Sensors and Sampling</a>."
        }
      ],
      "assignedURI": "http://www.w3.org/ns/sosa/Procedure",
      "diagramLabel": [
        {
          "@value": "Procedure"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
