    {
      "@id": "urn:oslo-toolchain:c42b1383e075230329e9b2502ebc8ef6a7163d195de9d1ed932695f19e5f408d",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Samenhangend geheel van componenten die samen één of meer functies vervullen."
        },
        {
          "@language": "en",
          "@value": "Cohesive set of components that together perform one or more functions"
        },
        {
          "@language": "en",
          "@value": "Cohesive set of components that together perform one or more functions"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Systeem"
        },
        {
          "@language": "en",
          "@value": "System"
        },
        {
          "@language": "en",
          "@value": "System"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze componenten kunnen Systemen op zich zijn. Het zijn Systemen die een Observatieprocedure realiseren (typisch een Sensor) of waarmee een Bemonsteringsprocedure wordt uitgevoerd (bv een boorinstallatie) of het zijn Platformen zoals een Toestel waarop de sensor is gemonteerd. OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensoren en Bemonstering</a>."
        },
        {
          "@language": "en",
          "@value": "These components can be Systems in themselves. They are Systems that realize an ObservationProcedure (typically a Sensor) or with which a Sampling procedure is carried out (e.g. a drilling rig) or they are Platforms like the Device on which the Sensor is mounted. REMARK: For more details about this class see <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensors and Sampling</a>."
        },
        {
          "@language": "en",
          "@value": "These components can be Systems in themselves. They are Systems that realize an ObservationProcedure (typically a Sensor) or with which a Sampling procedure is carried out (e.g. a drilling rig) or they are Platforms like the Device on which the Sensor is mounted. REMARK: For more details about this class see <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensors and Sampling</a>."
        }
      ],
      "assignedURI": "https://www.w3.org/TR/vocab-ssn/#ssn-system",
      "diagramLabel": [
        {
          "@value": "Systeem"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
