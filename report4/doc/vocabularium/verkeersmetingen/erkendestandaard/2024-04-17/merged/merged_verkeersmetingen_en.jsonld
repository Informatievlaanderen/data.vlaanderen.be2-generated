    {
      "@id": "urn:oslo-toolchain:814aae74f7a41bb19ab0dc8795433e725734add10985743bbfd684fce272c870",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Object dat representatief is voor het object waarvan men het Verkeerskenmerk meet."
        },
        {
          "@language": "en",
          "@value": "Object that is representative of the object for which the TrafficFeature is measured."
        },
        {
          "@language": "en",
          "@value": "Object that is representative of the object for which the TrafficFeature is measured."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Verkeersbemonsteringsobject"
        },
        {
          "@language": "en",
          "@value": "TrafficSamplingObject"
        },
        {
          "@language": "en",
          "@value": "TrafficSamplingObject"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Van belang als men dit object niet rechtstreeks kan observeren. Bvb om de snelheid ve Voertuig te bepalen kan men moeilijk dat Voertuig gaan volgen, in plaats daarvan zet men een meetpunt op langs de weg om te zien hoe snel passerende Voertuigen rijden. Gelijkaardig voor bvb verkeersintensiteit: men telt in een meetpunt langs de weg doorkomsten van Voertuigen en gaat ervan uit dat dit cijfer representatief is voor  het Wegsegment (deel van de weg tussen twee opeenvolgende kruispunten). OPGELET: Deze klasse is abstract, ze mag niet geinstantieerd worden. Gebruik in de plaats de subklassen Verkeersmeetpunt of Verkeersmeettraject"
        },
        {
          "@language": "en",
          "@value": "To be used if one cannot observe this object directly. For example, to determine the speed of a Vehicle, it is impossible to track each vehicle. Instead, one sets up a measuring point along the road to see how fast passing Vehicles are driving. Similar to, for example, traffic intensity: the passages of Vehicles are counted at a measuring point along the road and it is assumed that this figure is representative of at least the part of the road between two consecutive intersections (being the corresponding RoadSegment). ATTENTION: This class is abstract, it may not be instantiated. Use the subclasses TrafficMeasurementPoint or TrafficMeasurementSection instead."
        },
        {
          "@language": "en",
          "@value": "To be used if one cannot observe this object directly. For example, to determine the speed of a Vehicle, it is impossible to track each vehicle. Instead, one sets up a measuring point along the road to see how fast passing Vehicles are driving. Similar to, for example, traffic intensity: the passages of Vehicles are counted at a measuring point along the road and it is assumed that this figure is representative of at least the part of the road between two consecutive intersections (being the corresponding RoadSegment). ATTENTION: This class is abstract, it may not be instantiated. Use the subclasses TrafficMeasurementPoint or TrafficMeasurementSection instead."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersbemonsteringsobject",
      "diagramLabel": [
        {
          "@value": "Verkeersbemonsteringsobject"
        }
