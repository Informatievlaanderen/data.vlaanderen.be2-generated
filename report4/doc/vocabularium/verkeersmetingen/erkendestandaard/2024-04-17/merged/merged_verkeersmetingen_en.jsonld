    {
      "@id": "urn:oslo-toolchain:f4d1120a3ce87287740f88e2ea538ddd894680cbb4e0a62c3d817f50c73a2a7a",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Object uit de reële wereld dat geen Bemonsteringsobject is."
        },
        {
          "@language": "en",
          "@value": "Real world object that is not a SamplingObject."
        },
        {
          "@language": "en",
          "@value": "Real world object that is not a SamplingObject."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Domeinobject"
        },
        {
          "@language": "en",
          "@value": "DomainObject"
        },
        {
          "@language": "en",
          "@value": "DomainObject"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is het werkelijk geobserveerdObject. Als rechtstreeks observeren niet kan observeren we een representatief staal, het zgn Bemonsteringsobject. In dat geval is het Domeinobject het bemonsterdObject. OPMERKING: Deze klasse is louter informatief, in praktijk moet ze gesubstitueerd worden door een klasse uit het domein. Bv in het domein Verkeersmetingen zou het domeinobject een instantie van een Wegsegment of een Voertuig kunnen zijn."
        },
        {
          "@language": "en",
          "@value": "This is the actual observedObject. If direct observation is not possible, we observe a representative sample, the so-called SamplingObject. In that case, the DomainObject is the sampledObject. REMARK: This class is purely informative and needs to be substituted in practice by a class from the domain. E.g. in the domain TraficMeasurements, the DomainObject could be an instance of a RoadSegment or a Vehicle."
        },
        {
          "@language": "en",
          "@value": "This is the actual observedObject. If direct observation is not possible, we observe a representative sample, the so-called SamplingObject. In that case, the DomainObject is the sampledObject. REMARK: This class is purely informative and needs to be substituted in practice by a class from the domain. E.g. in the domain TraficMeasurements, the DomainObject could be an instance of a RoadSegment or a Vehicle."
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/GeneralFeatureInstance#GFI_DomainFeature",
      "diagramLabel": [
        {
          "@value": "Domeinobject"
