        },
        {
          "@language": "en",
          "@value": "networkReference"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de context van dit applicatieprofiel is het Netwerkelement een Wegsegment of een Weglinksequentie. De Netwerkreferentie laat ook toe om een Voetpad te specifiëren voor slechts een stuk van de weg of voor één bepaalde wegkant."
        },
        {
          "@language": "en",
          "@value": "In the context of this application profile, the NetworkElement is a RoadSegment or a RoadLin Sequence. The NetworkReference also allows you to specify a Sidewalk for only a section of the road or for one particular road side."
        },
        {
          "@language": "en",
          "@value": "In the context of this application profile, the NetworkElement is a RoadSegment or a RoadLin Sequence. The NetworkReference also allows you to specify a Sidewalk for only a section of the road or for one particular road side."
        }
