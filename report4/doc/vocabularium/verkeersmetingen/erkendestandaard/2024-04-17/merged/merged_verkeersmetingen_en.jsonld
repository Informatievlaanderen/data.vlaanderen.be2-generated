    {
      "@id": "urn:oslo-toolchain:262d1d2d4bf8d587294b7c4cca15840e22dd3f6b03d1c3cc0df463cbeadc03ac",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het vaststellen van de waarde van een bepaald kenmerk van een Object op een bepaald tijdstip of tussen twee tijdstippen."
        },
        {
          "@language": "en",
          "@value": "Determining the value of a certain characteristic of an Object at a certain point in time or between two points in time."
        },
        {
          "@language": "en",
          "@value": "Determining the value of a certain characteristic of an Object at a certain point in time or between two points in time."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Observatie"
        },
        {
          "@language": "en",
          "@value": "Observation"
        },
        {
          "@language": "en",
          "@value": "Observation"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat om schattingen van de waarde, maw op de waarde zit een zekere foutmarge. Voorbeelden zijn temperatuur, klasse, kleur. Dit is verschillend van waarden die zijn toegekend en dus geen schattingen zijn zoals naam of prijs. OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensoren en Bemonstering</a>."
        },
        {
          "@language": "en",
          "@value": "These are estimates of the value, in other words there is a certain margin of error on the value. Examples are temperature, class, color. This is different from values that are attributed and therefore not estimates such as name or price. REMARK: For more details about this class see <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensors and Sampling</a>."
        },
        {
          "@language": "en",
          "@value": "These are estimates of the value, in other words there is a certain margin of error on the value. Examples are temperature, class, color. This is different from values that are attributed and therefore not estimates such as name or price. REMARK: For more details about this class see <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensors and Sampling</a>."
        }
      ],
