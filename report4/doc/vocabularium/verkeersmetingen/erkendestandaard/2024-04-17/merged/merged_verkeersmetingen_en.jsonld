    {
      "@id": "urn:oslo-toolchain:d462c74c79f510560c407b0631fb3a737a3eaf41262657d6f926072312cf8df2",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Instanties van  om het even welk type."
        },
        {
          "@language": "en",
          "@value": "Instance of any type."
        },
        {
          "@language": "en",
          "@value": "Instance of any type."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Any"
        },
        {
          "@language": "en",
          "@value": "nti"
        },
        {
          "@language": "en",
          "@value": "nti"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Te substitueren door een geschikte klasse of datatype of door de klasse Observatie te specialiseren met een resultaat van een opgelegd datatype. Dit kunnen eigen subklassen zijn of standaard specialisaties van de klasse Observatie zoals Meting (waarbij het resultaat een KwantitatieveWaarde is, ttz een waarde en een eenheid), Classificatie (met een kwalitatieve waarde als resultaat),Telling (met een resultaat vh type Integer) of zelfs Observaties met als resultaat een Tijdreeks of RuimtelijkeBereik. OPMERKING: Meer info over deze standaard subklassen van Observatie in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/observaties-en-metingen/\">OSLO Observaties en Metingen</a> ."
        },
        {
          "@language": "en",
          "@value": "To be replaced by a suitable class or data type or by specializing the Observation class with a result of an imposed data type. These can be their own subclasses or standard specializations of the Observation class such as Measurement (where the result is a Quantitative Value, i.e. a value and a unit), Classification (with a qualitative value as a result), Count (with a result of type Integer) or even Observations resulting in a Time Series or Spatial Range. ATTENTION: More info about these standard subclasses of Observation in the application profile <a href=\"https://data.vlaanderen.be/doc/applicationprofile/observations-en-measurements/\">OSLO Observations and Measurements</a> ."
        },
        {
          "@language": "en",
          "@value": "To be replaced by a suitable class or data type or by specializing the Observation class with a result of an imposed data type. These can be their own subclasses or standard specializations of the Observation class such as Measurement (where the result is a Quantitative Value, i.e. a value and a unit), Classification (with a qualitative value as a result), Count (with a result of type Integer) or even Observations resulting in a Time Series or Spatial Range. ATTENTION: More info about these standard subclasses of Observation in the application profile <a href=\"https://data.vlaanderen.be/doc/applicationprofile/observations-en-measurements/\">OSLO Observations and Measurements</a> ."
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19103/2005/RecordsAndClassMetadata#Any",
      "diagramLabel": [
        {
          "@value": "Any"
        }
      ],
