    {
      "@id": "urn:oslo-toolchain:590e9bc96c70302ba2118cc53889d9374e5310dee11ad61d072a534b8d60c3b8",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "In de langsrichting begrensd deel van de rijbaan, bedoeld om de verkeersstroom te geleiden in een bepaalde richting en met doorgaans de breedte van één Voertuig."
        },
        {
          "@language": "en",
          "@value": "Part of the carriageway limited in the longitudinal direction, intended to guide the flow of the traffic in a certain direction and with usually the width of one vehicle."
        },
        {
          "@language": "en",
          "@value": "Part of the carriageway limited in the longitudinal direction, intended to guide the flow of the traffic in a certain direction and with usually the width of one vehicle."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Rijstrook"
        },
        {
          "@language": "en",
          "@value": "Lane"
        },
        {
          "@language": "en",
          "@value": "Lane"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Onder rijbaan verstaan we dat deel van de wegbaan ingericht om met een Voertuig over te rijden. Door de rijbaan op te splitsen krijgt men een meer gecontroleerde verkeersstroom, in de eerste plaats omdat de rijrichtingen of bvb doorgaand en afslaand verkeer gescheiden worden en ook door de breedte te beperken zodat er maar één Voertuig tegelijk doorkan. Rijstroken worden typisch afgebakend dmv wegmarkeringen, bvb een witte doorlopende of onderbroken streep. OPMERKING: Voetpaden of Fietspaden zijn geen Rijstroken aangezien ze niet bedoeld zijn om met een auto over te rijden en dus geen deel zijn van de rijbaan."
        },
        {
          "@language": "en",
          "@value": "The carriageway is the part of the roadarea designed for a Vehicle to drive over. By dividing the carriageway you get a more controlled traffic flow, firstly because the driving directions or, for example, through and turning traffic are separated and also by limiting the width so that only one Vehicle can pass through one time. Lanes are typically designated by road markings, for example a white continuous or interrupted line. NOTE: Sidewalks or BicyclePaths are not Lanes as they are not intended for a car to drive on and are therefore not part of the carriageway."
        },
        {
          "@language": "en",
          "@value": "The carriageway is the part of the roadarea designed for a Vehicle to drive over. By dividing the carriageway you get a more controlled traffic flow, firstly because the driving directions or, for example, through and turning traffic are separated and also by limiting the width so that only one Vehicle can pass through one time. Lanes are typically designated by road markings, for example a white continuous or interrupted line. NOTE: Sidewalks or BicyclePaths are not Lanes as they are not intended for a car to drive on and are therefore not part of the carriageway."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/verkeersmetingen#Rijstrook",
      "diagramLabel": [
        {
          "@value": "Rijstrook"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6def1310f21591ae3af067d0eeb8d170a62479034dbb87b3d671c9bd9e3a8ac8"
        },
        {
          "@id": "urn:oslo-toolchain:21fc7a9eb636d0bdc23e0fbd84138a8b2b5a5b95bdec0f8285a4eaa736463eaf"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "In de langsrichting begrensd deel van de rijbaan, bedoeld om de verkeersstroom te geleiden in een bepaalde richting en met doorgaans de breedte van één Voertuig."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Rijstrook"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Onder rijbaan verstaan we dat deel van de wegbaan ingericht om met een Voertuig over te rijden. Door de rijbaan op te splitsen krijgt men een meer gecontroleerde verkeersstroom, in de eerste plaats omdat de rijrichtingen of bvb doorgaand en afslaand verkeer gescheiden worden en ook door de breedte te beperken zodat er maar één Voertuig tegelijk doorkan. Rijstroken worden typisch afgebakend dmv wegmarkeringen, bvb een witte doorlopende of onderbroken streep. OPMERKING: Voetpaden of Fietspaden zijn geen Rijstroken aangezien ze niet bedoeld zijn om met een auto over te rijden en dus geen deel zijn van de rijbaan."
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
