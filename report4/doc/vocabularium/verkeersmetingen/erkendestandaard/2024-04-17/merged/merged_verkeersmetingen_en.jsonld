    {
      "@id": "urn:oslo-toolchain:67036581759faf65cfd6f3a52d4c28de61499c021a2bde8502ebad6b3689efb1",
      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Gebied of periode waarop de data betrekking heeft."
        },
        {
          "@language": "en",
          "@value": "The spatial or temporal extent of the data."
        },
        {
          "@language": "en",
          "@value": "The spatial or temporal extent of the data."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Dekking"
        },
        {
          "@language": "en",
          "@value": "Extent"
        },
        {
          "@language": "en",
          "@value": "Extent"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een gebied wordt indirect beschreven door te verwijzen naar een Plaats of AdministratieveEenheid of een GeografischeNaam of een geografisch object zoals een Gebouw of een Weg of een Kadastraalperceel of gelijkaardig en direct dmv Geometrie. Een periode kunnen we aanduiden dmv een Interval of als moment dmv een Datum of DateTime. OPMERKING: Te substitueren door Locatie of TemporeleEntiteit of door een meer specifieke klasse of datatype. Voor ruimtelijke dekking zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/\">OSLO-Generiek</a> ven voor temporele dekking <a href=\"https://www.w3.org/TR/owl-time/\">Time Ontology>. Verwijs naar bestaande datasets bvb voor Plaatsen de <a href=\"https://www.getty.edu/research/tools/vocabularies/tgn/index.html\">Getty Thesaurus of Geographic Names</a>."
        },
        {
          "@language": "en",
          "@value": "Spatial extent can be described indirectly by means of a reference to a Place or AdministrativeUnit or GeographicalName or some other geographical object like a Building, a Road or a CadastralParcel or directly by means of Geometry. Temporal extent can be expressed as an Interval or as an Instant by a Date or DateTime. REMARK: To be substituted by Location or TemporalEntity or more specific classes or datatypes. For spatial extent see <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/\">OSLO-Generics</a> and for temporal extent the <a href=\"https://www.w3.org/TR/owl-time/\">Time Ontology</a>. Refer to existing datasets, for example for Places the <a href=\"https://www.getty.edu/research/tools/vocabularies/tgn/index.html\">Getty Thesaurus of Geographic Names</a>."
        },
        {
          "@language": "en",
          "@value": "Spatial extent can be described indirectly by means of a reference to a Place or AdministrativeUnit or GeographicalName or some other geographical object like a Building, a Road or a CadastralParcel or directly by means of Geometry. Temporal extent can be expressed as an Interval or as an Instant by a Date or DateTime. REMARK: To be substituted by Location or TemporalEntity or more specific classes or datatypes. For spatial extent see <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/generiek-basis/\">OSLO-Generics</a> and for temporal extent the <a href=\"https://www.w3.org/TR/owl-time/\">Time Ontology</a>. Refer to existing datasets, for example for Places the <a href=\"https://www.getty.edu/research/tools/vocabularies/tgn/index.html\">Getty Thesaurus of Geographic Names</a>."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/sensoren-en-bemonstering#Dekking",
      "diagramLabel": [
