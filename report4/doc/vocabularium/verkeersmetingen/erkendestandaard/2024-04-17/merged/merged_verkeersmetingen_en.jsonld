      "@id": "urn:oslo-toolchain:fef2078e4969967535cc0a3c06e74085ba93e33ae02b6e42817347a1de1ffc7f",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Toestel of Agent (incl Personen of software) waarmee Observaties gemaakt worden."
        },
        {
          "@language": "en",
          "@value": "Device or Agent (including Persons or software) with which Observations are made."
        },
        {
          "@language": "en",
          "@value": "Device or Agent (including Persons or software) with which Observations are made."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Sensor"
        },
        {
          "@language": "en",
          "@value": "Sensor"
        },
        {
          "@language": "en",
          "@value": "Sensor"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Sensoren genereren een resultaat op basis van een Stimulus, ttz een verandering in de omgeving, of op basis van resultaten van andere Observaties. Ze worden typisch gehost door een Platform. Voorbeelden zijn snelheidsmeters, gyroscopen, barometers, magnetometers gemonteerd op een smart phone. Ook bv het menselijk oog kan beschouwd worden als een sensor."
        },
        {
          "@language": "en",
          "@value": "Sensors generate a result based on a stimulus, i.e. a change in the environment, or based on results from other Observations. They are typically hosted by a Platform. Examples are speedometers, gyroscopes, barometers, magnetometers mounted on a smart phone. The human eye, for example, can also be regarded as a Sensor."
        },
        {
          "@language": "en",
          "@value": "Sensors generate a result based on a stimulus, i.e. a change in the environment, or based on results from other Observations. They are typically hosted by a Platform. Examples are speedometers, gyroscopes, barometers, magnetometers mounted on a smart phone. The human eye, for example, can also be regarded as a Sensor."
        }
      ],
      "assignedURI": "http://www.w3.org/ns/sosa/Sensor",
      "diagramLabel": [
