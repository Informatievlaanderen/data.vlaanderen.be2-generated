    {
      "@id": "urn:oslo-toolchain:333dab6385b249f512fe4dd901b046db9a4dafe4d35cded961b8dc221dbfd5e4",
      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte klasse voor temporele objecten."
        },
        {
          "@language": "en",
          "@value": "Abstract class for temporal objects."
        },
        {
          "@language": "en",
          "@value": "Abstract class for temporal objects."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "TemporeleEntiteit"
        },
        {
          "@language": "en",
          "@value": "TemporalEntity"
        },
        {
          "@language": "en",
          "@value": "TemporalEntity"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Die temporele objecten zijn temporele geometrische primitieven zoals Moment of Periode. Of het zijn composieten van temporele primitieven, bv om de geschiedenis van een fenomeen weer te geven (bv de opeenvolgende Periodes dat het fenomeen zich voordeed). Te gebruiken wanneer de uiteindelijke temporele primitieve nog niet gekend is. OPMERKING: Meer info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitutie door een eenvoudiger equivalent bv time:TemporalEntity uit de <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is aanbevolen."
        },
        {
          "@language": "en",
          "@value": "These temporal entities are temporal geometric primitives like Instant or Interval. Or they are composites of temporal primitives, for example to represent the history of a phenomenon (for example the successive periods during which the phenomenon occurred). To be used when the final temporal primitive is not yet known. REMARK: More info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitution by a simpler equivalent like Data/DateTime/Time or subclasses of time:TemporalEntity from  <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is recommended."
        },
        {
          "@language": "en",
          "@value": "These temporal entities are temporal geometric primitives like Instant or Interval. Or they are composites of temporal primitives, for example to represent the history of a phenomenon (for example the successive periods during which the phenomenon occurred). To be used when the final temporal primitive is not yet known. REMARK: More info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitution by a simpler equivalent like Data/DateTime/Time or subclasses of time:TemporalEntity from  <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is recommended."
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Object",
      "diagramLabel": [
        {
          "@value": "TemporeleEntiteit"
