    {
      "@id": "urn:oslo-toolchain:6def1310f21591ae3af067d0eeb8d170a62479034dbb87b3d671c9bd9e3a8ac8",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Object uit het verkeersdomein waarvan men een Verkeerskenmerk meet."
        },
        {
          "@language": "en",
          "@value": "Object from the traffic domain for which a TrafficFeature is measured."
        },
        {
          "@language": "en",
          "@value": "Object from the traffic domain for which a TrafficFeature is measured."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Verkeersdomeinobject"
        },
        {
          "@language": "en",
          "@value": "TrafficDomainObject"
        },
        {
          "@language": "en",
          "@value": "TrafficDomainObject"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Hieronder verstaan we een real-world object uit het verkeer, ttz een Voertuig of Verkeersdeelnemer of een Wegsegment of gelijkaardig waarover verkeer plaatsvindt. Vallen hier niet onder: Verkeersbemonsteringsobjecten zoals Verkeersmeetpunten of Verkeersmeettrajecten, dat zijn de objecten die het Verkeersdomein bemonsteren. OPGELET: Deze klasse is abstract, ze mag maw niet geinstantieerd worden. Gebruik in de plaats subklassen zoal Wegsegment, Rijstrook, Voertuig etc."
        },
        {
          "@language": "en",
          "@value": "By this is meant a real-world object from traffic, i.e. a Vehicle or TrafficParticipant or a RoadSegment or similar over which traffic takes place. This does not include: TrafficSamplingObjects such as TrafficMeasurementPoints or TrafficMeasurementSections, which are the objects that sample the traffic domain. ATTENTION: This class is abstract, ie it may not be instantiated. Instead, use cubclasses such as RoadSegment, Lane, Vehicle, etc."
        },
        {
          "@language": "en",
          "@value": "By this is meant a real-world object from traffic, i.e. a Vehicle or TrafficParticipant or a RoadSegment or similar over which traffic takes place. This does not include: TrafficSamplingObjects such as TrafficMeasurementPoints or TrafficMeasurementSections, which are the objects that sample the traffic domain. ATTENTION: This class is abstract, ie it may not be instantiated. Instead, use cubclasses such as RoadSegment, Lane, Vehicle, etc."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersdomeinobject",
