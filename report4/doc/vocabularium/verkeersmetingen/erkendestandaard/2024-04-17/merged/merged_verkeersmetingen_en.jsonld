    {
      "@id": "urn:oslo-toolchain:177a8fa27376554faec5b7b3119201a91b7cb8c8380d5152106163d6c6f8d445",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Referentie naar het Netwerkelement waarop of waarlangs het Verkeersmeetpunt ligt of dat door dat punt bemonsterd wordt."
        },
        {
          "@language": "en",
          "@value": "Reference to the NetworkElement on or along which the TrafficMeasurementPoint is located on or that is sampled by that point."
        },
        {
          "@language": "en",
          "@value": "Reference to the NetworkElement on or along which the TrafficMeasurementPoint is located on or that is sampled by that point."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "netwerkreferentie"
        },
        {
          "@language": "en",
          "@value": "networkReference"
        },
        {
          "@language": "en",
          "@value": "networkReference"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Nuttig als men weet langs welk Wegsegment het punt ligt en aan welke kant van de weg en op welke afstand van het beginpunt. Alternatief voor of aanvulling op coördinaten. Ook noodzakelijk om aan te geven over welk Wegsegment en aan welke kant ervan de Voertuigen rijden waarvan men bvb de snelheid meet."
        },
        {
          "@language": "en",
          "@value": "Useful if you know along which RoadSegment the point is located and on which side of the road and at what distance from the starting point. Alternative or addition to coordinates. Also necessary to indicate which RoadSegment and on which side the Vehicles are driving whose speed is measured, for example."
        },
        {
          "@language": "en",
          "@value": "Useful if you know along which RoadSegment the point is located and on which side of the road and at what distance from the starting point. Alternative or addition to coordinates. Also necessary to indicate which RoadSegment and on which side the Vehicles are driving whose speed is measured, for example."
        }
      ],
