          "@value": "Class representing features of instances of any type."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Kenmerktype"
        },
        {
          "@language": "en",
          "@value": "FeatureType"
        },
        {
          "@language": "en",
          "@value": "FeatureType"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit is een kenmerk van het geobseveerdObject (ttz van het DomeinObject of van een proxy daarvan, het Bemonsteringsobject) en in principe van alle instanties van dat type geobserveerdObject. In de context van Verkeersmetingen gaat het om kenmerken zoals Snelheid (van een Voertuig - het geobserveerd Domeinobject) of AantalVoertuigen (dat passeert aan een Meetpunt - het geobserveerd Bemonsteringsobject - langs een Wegsegment - het bemonsterd Domeinobject)."
        },
        {
          "@language": "en",
          "@value": "This is a characteristic of the observedObject (that is, of the DomainObject or of a proxy thereof, the SamplingObject) and in principle of all instances of that type of observedObject. In the context of Traffic Measurements, this concerns characteristics such as Speed (of a Vehicle - the observed Domain Object) or Number of Vehicles (passing a Measuring Point - the observed SamplingObject - along a Road Segment - the sampled Domain Object)."
        },
        {
          "@language": "en",
          "@value": "This is a characteristic of the observedObject (that is, of the DomainObject or of a proxy thereof, the SamplingObject) and in principle of all instances of that type of observedObject. In the context of Traffic Measurements, this concerns characteristics such as Speed (of a Vehicle - the observed Domain Object) or Number of Vehicles (passing a Measuring Point - the observed SamplingObject - along a Road Segment - the sampled Domain Object)."
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19109/2005/GeneralFeatureModel#GF_PropertyType",
