    {
      "@id": "urn:oslo-toolchain:2d8944214142c8ad68638fa9161984bf8ac7b5b3640a3050677d87749016a752",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Deel van het Object dat men wil observeren en dat representatief is voor dat Object."
        },
        {
          "@language": "en",
          "@value": "Part of the Object that one wants to observe and that is representative of that Object."
        },
        {
          "@language": "en",
          "@value": "Part of the Object that one wants to observe and that is representative of that Object."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Bemonsteringsobject"
        },
        {
          "@language": "en",
          "@value": "SamplingObject"
        },
        {
          "@language": "en",
          "@value": "SamplingObject"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Het deel waarvan sprake kan fysiek zijn (een Monster) of ruimtelijk (een RuimtelijkBemonsteringsobject). Men observeert een Bemonsteringsobject ipv het werkelijk Object als dat laatste niet in zijn geheel geobserveerd kan worden (bv omdat exhaustieve observatie onpraktisch zou zijn). Het Bemonsteringsobject vormt samen met het Proces dat voor observatie is gebruikt het zgn observatieprotocol. OPGELET: deze klasse is abstract, ze moet gespecialiseerd worden in functie van het applicatiedomein."
        },
        {
          "@language": "en",
          "@value": "This part can be physical (a Sample) or spatial (a SpatialSamplingObject). One observes a SamplingObject instead of the actual Object if the latter cannot be observed in its entirety (e.g. because exhaustive observation would be impractical). The SamplingObject, together with the Process used for observation, forms the so-called observation protocol. ATTENTION: this class is abstract, it must be specialized according to the application domain."
        },
        {
          "@language": "en",
          "@value": "This part can be physical (a Sample) or spatial (a SpatialSamplingObject). One observes a SamplingObject instead of the actual Object if the latter cannot be observed in its entirety (e.g. because exhaustive observation would be impractical). The SamplingObject, together with the Process used for observation, forms the so-called observation protocol. ATTENTION: this class is abstract, it must be specialized according to the application domain."
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeature",
      "diagramLabel": [
        {
          "@value": "Bemonsteringsobject"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bemonsteringsobject"
        },
        {
          "@language": "en",
          "@value": "Enter your translation here"
        }
      ]
    },
