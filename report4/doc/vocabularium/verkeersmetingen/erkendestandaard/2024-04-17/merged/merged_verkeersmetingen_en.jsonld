      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Is voor sommige metingen gelijk aan de fenomeentijd maar kan ook verschillen, bv bij het uitvoeren van een analyse op een meting die eerder (en doorgaans dan ook elders) werd genomen of bij sensormetingen die pas later worden verwerkt."
        },
        {
          "@language": "en",
          "@value": "Is the same as the phenomenonTime for some measurements, but can also differ, for example when performing an analysis on a measurement that was taken earlier (and usually elsewhere) or on Sensor measurements that are only processed later."
        },
        {
          "@language": "en",
