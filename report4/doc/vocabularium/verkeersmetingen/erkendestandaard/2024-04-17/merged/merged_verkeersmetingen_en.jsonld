      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een RuimtelijkBemonsteringsobject dat de vorm aanneemt van een Curve."
        },
        {
          "@language": "en",
          "@value": "A Spatial SamplingObject that takes the shape of a Curve."
        },
        {
          "@language": "en",
          "@value": "A Spatial SamplingObject that takes the shape of a Curve."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
