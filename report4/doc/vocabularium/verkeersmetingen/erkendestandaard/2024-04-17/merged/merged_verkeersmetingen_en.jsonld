    {
      "@id": "urn:oslo-toolchain:542e07ea537060923a22192388d925995942eb97c7dd12eb05adf6ba5ef7de6e",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Collectie van Verkeersmetingen met dezelfde kenmerken."
        },
        {
          "@language": "en",
          "@value": "Collection of TrafficMeasurements with the same properties"
        },
        {
          "@language": "en",
          "@value": "Collection of TrafficMeasurements with the same properties"
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Verkeersmetingverzameling"
        },
        {
          "@language": "en",
          "@value": "TrafficMeasurementCollection"
        },
        {
          "@language": "en",
          "@value": "TrafficMeasurementCollection"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bv metingen die op hetzelfde tijdstip plaatsvonden of hetzelfde Object of kenmerk observeren of door dezelfde Sensor zijn gemaakt. Bvb de metingen van snelheid, voertuigtype etc in eenzelfde Verkeersmeetpunt of de metingen van verkeersintensiteit per uur op eenzelfde Wegsegment etc."
        },
        {
          "@language": "en",
          "@value": "E.g. measurements that took place at the same time or observed the same object or feature or were made by the same Sensor. For example, the measurements of speed, vehicle type, etc. at the same TrafficMeasurementPoint or the measurements of traffic intensity per hour on the same RoadSegment, etc."
        },
        {
          "@language": "en",
          "@value": "E.g. measurements that took place at the same time or observed the same object or feature or were made by the same Sensor. For example, the measurements of speed, vehicle type, etc. at the same TrafficMeasurementPoint or the measurements of traffic intensity per hour on the same RoadSegment, etc."
        }
      ],
      "assignedURI": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmetingverzameling",
