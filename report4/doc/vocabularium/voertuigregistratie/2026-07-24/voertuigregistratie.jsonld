          "@value": "Nummerplaat"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Fysieke drager van het registratienummer van het Voertuig."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Uitgegeven door de overheid bevoegd voor de inschrijving van het Voertuig."
        }
      ],
