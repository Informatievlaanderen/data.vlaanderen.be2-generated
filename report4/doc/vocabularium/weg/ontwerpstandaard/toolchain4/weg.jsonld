      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Afstand"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Afstand"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Gebruikt als een type voor het retourneren van afstanden en mogelijk lengtes."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Gebruikt als een type voor het retourneren van afstanden en mogelijk lengtes."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Wees voorzichtig bij het gebruik van afstand waarbij lengte wordt bedoeld. De afstand van begin tot einde van een curve is niet de lengte van de curve, maar vertegenwoordigt de lengte van de kortste curve tussen deze twee punten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Wees voorzichtig bij het gebruik van afstand waarbij lengte wordt bedoeld. De afstand van begin tot einde van een curve is niet de lengte van de curve, maar vertegenwoordigt de lengte van de kortste curve tussen deze twee punten."
        }
      ],
