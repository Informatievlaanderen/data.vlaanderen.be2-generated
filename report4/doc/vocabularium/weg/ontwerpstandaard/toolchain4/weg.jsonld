      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Geeft de richting van de verkeersstroom aan in relatie tot de logische richting van het wegsegment."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De logische richting wordt bepaald adhv de begin- en eindknoop. Men kijkt steeds van begin- naar eindknoop. Dit komt niet altijd overeen met de digitalisatiezin van het wegsegment."
        }
      ],
