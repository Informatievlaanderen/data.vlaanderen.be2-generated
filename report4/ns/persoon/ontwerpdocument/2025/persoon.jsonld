          "@language": "nl",
          "@value": "Persoon die niet in een bepaalde plaats of land woont."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Plaats of land wordt hier vertegenwoordigd door de entiteit Jurisdictie."
