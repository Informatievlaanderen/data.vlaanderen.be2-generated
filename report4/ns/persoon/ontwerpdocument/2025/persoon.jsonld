        }
      ],
      "diagramLabel": [
        {
          "@value": "Vreemdeling"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon die niet de Nationaliteit bezit van het land waar hij verblijft."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Daardoor kan de Persoon geen Staatsburger worden genoemd. In praktijk geniet de Vreemdeling als Inwoner een subset van de burgerrechten die een Staatsbutger wel heeft. Bijvoorbeeld wel godsdienstvrijheid maar geen stemrecht."
        }
      ],
