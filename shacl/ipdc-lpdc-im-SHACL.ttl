<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#AdresShape> a shacl:NodeShape;
  rdfs:label "Adres"@nl;
  <http://purl.org/vocab/vann/usageNote> "Minstens één van de attributen moet ingevuld zijn met een niet lege waarde."@nl;
  rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Adres>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Adres.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount 1;
    shacl:name "huisnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Adres.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount 1;
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Adresvoorstelling.busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat de adressen voor postale doeleinden groepeert aanduidt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Adres.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat de adressen voor postale doeleinden groepeert aanduidt."@nl;
    shacl:maxCount 1;
    shacl:name "postcode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#postcode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Adres.Land>;
    shacl:class rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount 1;
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam van het adres."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Adres.Gemeentenaam>;
    shacl:class rdf:langString;
    shacl:description "Gemeentenaam van het adres."@nl;
    shacl:maxCount 1;
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Adrescomponent met de naam die officieel werd toegekend aan een straat (baan, doorgang, plein) of aan een gehucht en waaraan adressen kunnen zijn gekoppeld."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Adres.Straatnaam>;
    shacl:class rdf:langString;
    shacl:description "Adrescomponent met de naam die officieel werd toegekend aan een straat (baan, doorgang, plein) of aan een gehucht en waaraan adressen kunnen zijn gekoppeld."@nl;
    shacl:maxCount 1;
    shacl:name "straatnaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Straatnaam>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#BewijsShape> a shacl:NodeShape;
  rdfs:label "Bewijs"@nl;
  <http://purl.org/vocab/vann/usageNote> "Although the wording of the definition is different, the semantics are an exact match for CPSV's Input class which it replaces. Evidence can be any resource - document, artefact - anything needed for executing the Public Service."@nl;
  rdfs:comment "The Evidence class is defined in the Core Criterion and Core Evidence vocabulary (CCCEV) as any resource that can document or support a response. It contains information that proves that a normal requirement exists or is true."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Bewijs>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is toegestaan. Opgelet: mag geen uitvoerbare (JavaScript) code en anchor tags met relatieve urls bevatten."@nl;
    rdfs:comment "Geeft omschrijving van de vereiste input"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Bewijs.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "Geeft omschrijving van de vereiste input"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "This property represents the official Name of the Evidence."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Bewijs.Naam>;
    shacl:class rdf:langString;
    shacl:description "This property represents the official Name of the Evidence."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ];
  shacl:targetClass <http://data.europa.eu/m8g/Evidence> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#BooleanShape> a shacl:NodeShape;
  rdfs:label "Boolean";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Boolean>;
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptShape> a shacl:NodeShape;
  rdfs:label "Concept"@nl;
  <http://purl.org/vocab/vann/usageNote> "Een goed voorbeeld van een concept is het huwelijk. Hoewel de beschrijving en voorwaarden van een huwelijk grotendeels hetzelfde zijn voor de verschillende gemeentes zijn er mogelijk toch lokale verschillen, zoals de locatie en prijs, die terug te vinden zijn in de respectievelijke instanties."@nl;
  rdfs:comment "Dienstverlening van lokale besturen is vaak gestoeld op Vlaamse, federale of Europese wetgeving, die vertaald wordt naar een lokaal niveau. Dat betekent dat de basis gelijkaardig is voor elk lokaal bestuur, maar dat er mogelijk flexibiliteit bestaat voor de lokale invulling. Omdat we IPDC goed gevuld en up to date willen krijgen en houden, met een beperkte administratieve belasting, voorzien we het concept. Een concept is een sjabloon dat redacteurs van de Vlaamse overheid klaarzetten voor lokale besturen. Het bevat een algemene invulling van een overheidsdienstverlening, die in de meeste lokale contexten ook van toepassing kan zijn. Lokale besturen kunnen deze concepten raadplegen en beslissen om een eigen dienstverlening te registreren op basis van een concept. Op dat moment wordt een concept gekloond naar een instantie. Het lokaal bestuur kan deze instantie vervolgens volledig aanpassen en afstemmen op de lokale context. Op deze manier groepeert een concept ook alle verschillende lokale variaties van een gelijkaardige dienstverlening."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "productnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bij het aanmaken van een nieuw concept kan geen productnummer doorgegeven worden aan IPDC of LPDC. De productnummers worden beheerd door IPDC en bij creatie van een nieuw concept zal een uniek productnummer toegekend worden in IPDC. Hierdoor zal bij het uitlezen van IPDC steeds een productnummer beschikbaar zijn op elk concept."@nl;
    rdfs:comment "Identificatienummer om op een unieke manier een instantie of concept te identificeren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Productnummer>;
    shacl:datatype xsd:string;
    shacl:description "Identificatienummer om op een unieke manier een instantie of concept te identificeren."@nl;
    shacl:maxCount 1;
    shacl:name "productnummer"@nl;
    shacl:path schema:productID
  ], [
    a shacl:PropertyShape;
    rdfs:label "creatie"@nl;
    rdfs:comment "Tijdstip waarop het concept door een redacteur werd aangemaakt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Creatie>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop het concept door een redacteur werd aangemaakt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "creatie"@nl;
    shacl:path schema:dateCreated
  ], [
    a shacl:PropertyShape;
    rdfs:label "laatstGewijzigd"@nl;
    rdfs:comment "Tijdstip waarop het concept door een redacteur laatst werd gewijzigd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.LaatstGewijzigd>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop het concept door een redacteur laatst werd gewijzigd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "laatstGewijzigd"@nl;
    shacl:path schema:dateModified
  ], [
    a shacl:PropertyShape;
    rdfs:label "gearchiveerd"@nl;
    rdfs:comment "Waarde die aangeeft of het concept gearchiveerd is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Gearchiveerd>;
    shacl:datatype xsd:boolean;
    shacl:description "Waarde die aangeeft of het concept gearchiveerd is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "gearchiveerd"@nl;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#isArchived>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is toegestaan. Opgelet: mag geen uitvoerbare (JavaScript) code en anchor tags met relatieve urls bevatten."@nl;
    rdfs:comment "This property represents a free text Description of the Public Service. The description is likely to be the text that potential users of the Public Service see in any public service catalogue. Public administrations are encouraged to include a reasonable level of detail in the description, for instance including basic eligibility requirements for the particular Public Service and contact information."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text Description of the Public Service. The description is likely to be the text that potential users of the Public Service see in any public service catalogue. Public administrations are encouraged to include a reasonable level of detail in the description, for instance including basic eligibility requirements for the particular Public Service and contact information."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "eindeDienstVerlening"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een lege einddatum wordt bij het bepalen van het actief zijn van de publieke dienstverlening geïnterpreteerd als geen einddatum."@nl;
    rdfs:comment "Datum waarop de publieke dienstverlening stopgezet werd/wordt"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.EindeDienstVerlening>;
    shacl:class <https://www.w3.org/2001/XMLSchema#dateTime>;
    shacl:description "Datum waarop de publieke dienstverlening stopgezet werd/wordt"@nl;
    shacl:maxCount 1;
    shacl:name "eindeDienstVerlening"@nl;
    shacl:path schema:endDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "zoektermen"@nl;
    <http://purl.org/vocab/vann/usageNote> "Er mogen meerdere termen per taal zijn. Dit in tegenstelling tot alle andere velden van het type TaalString."@nl;
    rdfs:comment "This property represents a keyword, term or phrase to describe the Public Service."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Zoektermen>;
    shacl:class rdf:langString;
    shacl:description "This property represents a keyword, term or phrase to describe the Public Service."@nl;
    shacl:name "zoektermen"@nl;
    shacl:path dcat:keyword
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "This property represents the official Name of the Public Service."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Naam>;
    shacl:class rdf:langString;
    shacl:description "This property represents the official Name of the Public Service."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "regelgevingTekst"@nl;
    <http://purl.org/vocab/vann/usageNote> """Rich Text (HTML) is toegestaan. Opgelet: mag geen uitvoerbare (JavaScript) code en anchor tags met relatieve urls bevatten.
Gebruik bij voorkeur de relatie 'follows(Rule)' om te verwijzen naar de relevante wetgeving."""@nl;
    rdfs:comment "Tekstveld waarin de regelgeving waarop de public service gebaseerd is kan beschreven worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.RegelgevingTekst>;
    shacl:class rdf:langString;
    shacl:description "Tekstveld waarin de regelgeving waarop de public service gebaseerd is kan beschreven worden."@nl;
    shacl:maxCount 1;
    shacl:name "regelgevingTekst"@nl;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#regulation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "startDienstVerlening"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een lege startdatum wordt bij het bepalen van het actief zijn van de publieke dienstverlening geïnterpreteerd als een startdatum heel ver in het verleden."@nl;
    rdfs:comment "Datum waarop de publieke dienstverlening actief aangeboden werd/wordt"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.StartDienstVerlening>;
    shacl:class <https://www.w3.org/2001/XMLSchema#dateTime>;
    shacl:description "Datum waarop de publieke dienstverlening actief aangeboden werd/wordt"@nl;
    shacl:maxCount 1;
    shacl:name "startDienstVerlening"@nl;
    shacl:path schema:startDate
  ], [
    a shacl:PropertyShape;
    rdfs:label "doelgroepen"@nl;
    <http://purl.org/vocab/vann/usageNote> "De geldige waardes zijn te vinden in het ttl bestand op de link in de codelijst kolom."@nl;
    rdfs:comment "Doelgroep waarop een publieke dienstverlening gericht is. Deze codelijst is in het beheer van het IPDC - LPDC team."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Doelgroepen>;
    shacl:description "Doelgroep waarop een publieke dienstverlening gericht is. Deze codelijst is in het beheer van het IPDC - LPDC team."@nl;
    shacl:name "doelgroepen"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#targetAudience>
  ], [
    a shacl:PropertyShape;
    rdfs:label "themas"@nl;
    <http://purl.org/vocab/vann/usageNote> "De geldige waardes zijn te vinden in het ttl bestand op de link in de codelijst kolom."@nl;
    rdfs:comment "Thema van een publieke dienst. Deze codelijst is in het beheer van het IPDC - LPDC team."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Themas>;
    shacl:description "Thema van een publieke dienst. Deze codelijst is in het beheer van het IPDC - LPDC team."@nl;
    shacl:name "themas"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <http://data.europa.eu/m8g/thematicArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "De geldige waardes zijn te vinden in het ttl bestand op de link in de codelijst kolom."@nl;
    rdfs:comment "Type van een publieke dienst. Deze codelijst is in het beheer van het IPDC - LPDC team."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Type>;
    shacl:description "Type van een publieke dienst. Deze codelijst is in het beheer van het IPDC - LPDC team."@nl;
    shacl:maxCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitzonderingen"@nl;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is toegestaan. Opgelet: mag geen uitvoerbare (JavaScript) code en anchor tags met relatieve urls bevatten."@nl;
    rdfs:comment "Tekstveld waarin uitzonderingen op procedures, kostprijzen, ... kunnen aangegeven worden"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept.Uitzonderingen>;
    shacl:class rdf:langString;
    shacl:description "Tekstveld waarin uitzonderingen op procedures, kostprijzen, ... kunnen aangegeven worden"@nl;
    shacl:maxCount 1;
    shacl:name "uitzonderingen"@nl;
