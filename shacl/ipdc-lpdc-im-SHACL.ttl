    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:name "bevoegdeOverheden"@nl;
    shacl:path <http://data.europa.eu/m8g/hasCompetentAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isVersionOf"@nl;
    rdfs:comment "Verwijzing naar het concept waarvan deze snapshot op een bepaald moment in tijd gemaakt werd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.IsVersionOf>;
    shacl:class <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#ConceptualPublicService>;
