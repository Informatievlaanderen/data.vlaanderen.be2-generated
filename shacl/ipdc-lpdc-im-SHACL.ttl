    shacl:minCount 1;
    shacl:name "url"@nl;
    shacl:path schema:url
  ], [
    a shacl:PropertyShape;
    rdfs:label "order"@nl;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@nl;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Website.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "order"@nl;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "This property represents the name of the website."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Website.Naam>;
    shacl:class rdf:langString;
    shacl:description "This property represents the name of the website."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is toegestaan. Opgelet: mag geen uitvoerbare (JavaScript) code en anchor tags met relatieve urls bevatten."@nl;
    rdfs:comment "This property represents a free text description of the Website."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Website.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text description of the Website."@nl;
    shacl:maxCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ];
  shacl:targetClass schema:WebSite .
