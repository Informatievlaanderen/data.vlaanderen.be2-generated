    rdfs:label "aangemaaktDoor"@nl;
    rdfs:comment "Link naar de organisatie die de instantie aanmaakte"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstantieSnapshot.AangemaaktDoor>;
