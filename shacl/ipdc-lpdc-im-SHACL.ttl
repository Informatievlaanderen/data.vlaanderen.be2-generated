<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#KostShape> a shacl:NodeShape;
  rdfs:label "Kost"@nl;
  rdfs:comment "The Cost class represents any costs related to the execution of a Public Service that the Agent consuming it needs to pay."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Kost>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "order"@nl;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@nl;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Kost.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "order"@nl;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is toegestaan. Opgelet: mag geen uitvoerbare (JavaScript) code en anchor tags met relatieve urls bevatten."@nl;
    rdfs:comment "This property represents a free text description of the Cost."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Kost.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text description of the Cost."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "This property represents the name of the cost."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Kost.Naam>;
    shacl:class rdf:langString;
    shacl:description "This property represents the name of the cost."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ];
  shacl:targetClass <http://data.europa.eu/m8g/Cost> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ProcedureShape> a shacl:NodeShape;
  rdfs:label "Procedure"@nl;
  rdfs:comment "The Rule class represents a document that sets out the specific rules, guidelines or procedures that the Public Service follows. It includes the terms of service, licence, and authentication requirements of the Public Service. Instances of the Rule class are FRBR (Functional Requirements for Bibliographic Records) Expressions, that is, a concrete expression such as a document, of the more abstract concept of the rules themselves.This model does not envisage instances of the Rule class as machine-readable business rules. Detailed modelling of the rules related to Public Services is out of scope of this model."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Procedure>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "order"@nl;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@nl;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Procedure.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "order"@nl;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is toegestaan. Opgelet: mag geen uitvoerbare (JavaScript) code en anchor tags met relatieve urls bevatten."@nl;
    rdfs:comment "This property represents a free text Description of the Rule."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Procedure.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text Description of the Rule."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "This property represents the Name of the Rule."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Procedure.Naam>;
    shacl:class rdf:langString;
    shacl:description "This property represents the Name of the Rule."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "websites"@nl;
    rdfs:comment "Link naar online locatie waar de procedure opgestart kan worden."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Procedure.Websites>;
    shacl:class schema:WebSite;
    shacl:description "Link naar online locatie waar de procedure opgestart kan worden."@nl;
    shacl:name "websites"@nl;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#hasWebsite>
  ];
  shacl:targetClass <http://purl.org/vocab/cpsv#Rule> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#PubliekeOrganisatieShape> a shacl:NodeShape;
  rdfs:label "PubliekeOrganisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Link naar het organisatieregister (wegwijs) op basis van de OVO code of link naar het organisatieportaal. Waar mogeijk probeert IPDC links naar het organisatieregister te leggen. Wanneer IPDC een link naar het organisatieportaal ontvangt probeert het de organisatie op te zoeken in het organisatieregister. Wanneer deze gevonden wordt zal de link naar het organisatieregister bewaard worden anders blijft de link naar het organisatieportaal behouden."@nl;
  rdfs:comment "Een organisatie die volgens een wettelijk kader behoort tot de publieke sector, ongeacht het bestuursniveau waarop dat kader van kracht is."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#PubliekeOrganisatie>;
  shacl:closed false;
  shacl:targetClass <http://data.europa.eu/m8g/PublicOrganisation> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#RegelgevingShape> a shacl:NodeShape;
  rdfs:label "Regelgeving"@nl;
  <http://purl.org/vocab/vann/usageNote> "Link naar de Vlaamse Codex of een ander wetgevingsregister - The definition and properties of the Legal Resource class in the CPSV-AP are aligned with the ontology included in \"Council conclusions inviting the introduction of the European Legislation Identifier (ELI)\". For describing the attributes of a Legal Resource (labels, preferred labels, alternative labels, definition ...) we refer to the ELI ontology."@nl;
  rdfs:comment "This class represents the legislation, policy or policies that lie behind the Rules that govern the service."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regelgeving>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "order"@nl;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@nl;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regelgeving.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "order"@nl;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "url"@nl;
    <http://purl.org/vocab/vann/usageNote> "Legal resource locatie moet voldoen aan het formaat beschreven in RFC1738: https://datatracker.ietf.org/doc/html/rfc1738#section-3.3"@nl;
    rdfs:comment "De url van de legal resource"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regelgeving.Url>;
    shacl:datatype xsd:string;
    shacl:description "De url van de legal resource"@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "url"@nl;
    shacl:path schema:url
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "This property represents the name of the legal resource."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regelgeving.Naam>;
    shacl:class rdf:langString;
    shacl:description "This property represents the name of the legal resource."@nl;
    shacl:maxCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is toegestaan. Opgelet: mag geen uitvoerbare (JavaScript) code en anchor tags met relatieve urls bevatten."@nl;
    rdfs:comment "This property represents a free text description of the legal resource."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Regelgeving.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "This property represents a free text description of the legal resource."@nl;
    shacl:maxCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ];
  shacl:targetClass <http://data.europa.eu/eli/ontology#LegalResource> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#String>;
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#VoorwaardeShape> a shacl:NodeShape;
  rdfs:label "Voorwaarde"@nl;
  <http://purl.org/vocab/vann/usageNote> "Not all public services are needed or usable by everyone. For example, the visa service operated by European countries is not needed by European citizens but is needed by some citizens from elsewhere, or public services offering unemployment benefits and grants are targeting specific societal groups. This model reuses the Core Criterion and Core Evidence Vocabulary for this class. The CCCEV provides more details but the Requirement class has three mandatory properties."@nl;
  rdfs:comment "A normal requirement is an atomic requirement. Some criteria can be expressed with several atomic requirements. A normal requirement can specify the expected value that the requirement response has to contain, or a range of threshold values within which the requirement response has to fit in. The normal requirement may apply to a certain period of time. It also can provide a list of candidate evidences that the responder can use to prove the normal requirement."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Voorwaarde>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "order"@nl;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@nl;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Voorwaarde.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "order"@nl;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschrijving"@nl;
    <http://purl.org/vocab/vann/usageNote> "Rich Text (HTML) is toegestaan. Opgelet: mag geen uitvoerbare (JavaScript) code en anchor tags met relatieve urls bevatten."@nl;
    rdfs:comment "A short explanation about the nature, attributes, uses or any other additional information that helps clarify the understanding of the Requirement being instantiated."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Voorwaarde.Beschrijving>;
    shacl:class rdf:langString;
    shacl:description "A short explanation about the nature, attributes, uses or any other additional information that helps clarify the understanding of the Requirement being instantiated."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "beschrijving"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "This property represents the official Name of the Requirement."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Voorwaarde.Naam>;
    shacl:class rdf:langString;
    shacl:description "This property represents the official Name of the Requirement."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "bewijs"@nl;
    rdfs:comment "The Evidence that supplies information (proof, support) for this Requirement."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Voorwaarde.Bewijs>;
    shacl:class <http://data.europa.eu/m8g/Evidence>;
    shacl:description "The Evidence that supplies information (proof, support) for this Requirement."@nl;
    shacl:maxCount 1;
    shacl:name "bewijs"@nl;
    shacl:path <http://data.europa.eu/m8g/hasSupportingEvidence>
  ];
  shacl:targetClass <http://data.europa.eu/m8g/Requirement> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#WebsiteShape> a shacl:NodeShape;
  rdfs:label "Website"@nl;
  rdfs:comment "A WebSite is a set of related web pages and other items typically served from a single web domain and accessible via a URL."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Website>;
