    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#targetAudience>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eindeDienstVerlening"@nl;
    <http://purl.org/vocab/vann/usageNote> "Een lege einddatum wordt bij het bepalen van het actief zijn van de publieke dienstverlening geïnterpreteerd als geen einddatum."@nl;
    rdfs:comment "Datum waarop de publieke dienstverlening stopgezet werd/wordt"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot.EindeDienstVerlening>;
    shacl:class <https://www.w3.org/2001/XMLSchema#dateTime>;
