<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ContactgegevensShape> a shacl:NodeShape;
  rdfs:label "Contactgegevens"@nl;
  <http://purl.org/vocab/vann/usageNote> "Minstens één van de attributen moet ingevuld zijn met een niet lege waarde."@nl;
  rdfs:comment "This class represents the contact information for a Public Service, Channel, Public Organization, etc. It is defined in the Core Public Organization Vocabulary and is provided as a schema:ContactPoint. Like Channel, a Contact Point may have regular opening hours that are then overridden by, for example, public holidays, using the Opening Hours Specification class."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Contactgegevens>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    <http://purl.org/vocab/vann/usageNote> "Email adres moet voldoen aan het formaat beschreven in RFC2822: https://datatracker.ietf.org/doc/html/rfc2822#section-3.4.1"@nl;
    rdfs:comment "A property through which an e-mail address for the Public Organization, or a representative of it, can be contacted."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Contactgegevens.Email>;
    shacl:datatype xsd:string;
    shacl:description "A property through which an e-mail address for the Public Organization, or a representative of it, can be contacted."@nl;
    shacl:maxCount 1;
    shacl:name "email"@nl;
    shacl:path schema:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "openingsuren"@nl;
    <http://purl.org/vocab/vann/usageNote> "Days are specified using two-letter combinations: Mo, Tu, We, Th, Fr, Sa, Su. For example, if the contact point is open Monday-Friday, 9 -5, the value of the openingHours property would be Mo-Fr 09:00-17:00. If the Contact Point is only available on Tuesday and Thursday between 6 and 8pm, the value would be Tu,Th 16:00-20:00."@nl;
    rdfs:comment "The value of this property is structured text that gives the hours at which the contact point is normally available."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Contactgegevens.Openingsuren>;
    shacl:datatype xsd:string;
    shacl:description "The value of this property is structured text that gives the hours at which the contact point is normally available."@nl;
    shacl:maxCount 1;
    shacl:name "openingsuren"@nl;
    shacl:path schema:openingHours
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoonnummer"@nl;
    rdfs:comment "A property through which a phone number for the Public Organization, or a representative of it, can be contacted."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Contactgegevens.Telefoonnummer>;
    shacl:datatype xsd:string;
    shacl:description "A property through which a phone number for the Public Organization, or a representative of it, can be contacted."@nl;
    shacl:maxCount 1;
    shacl:name "telefoonnummer"@nl;
    shacl:path schema:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "url"@nl;
    <http://purl.org/vocab/vann/usageNote> "Website locatie moet voldoen aan het formaat beschreven in RFC1738: https://datatracker.ietf.org/doc/html/rfc1738#section-3.3"@nl;
    rdfs:comment "De url van de website"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Contactgegevens.Url>;
    shacl:datatype xsd:string;
    shacl:description "De url van de website"@nl;
    shacl:maxCount 1;
    shacl:name "url"@nl;
    shacl:path schema:url
  ], [
    a shacl:PropertyShape;
    rdfs:label "order"@nl;
    <http://purl.org/vocab/vann/usageNote> "Items are sorted in ascending order, for example use 1 for the first, 2 for the second."@nl;
    rdfs:comment "Specifies the relative order of this item compared to its siblings."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Contactgegevens.Order>;
    shacl:datatype xsd:integer;
    shacl:description "Specifies the relative order of this item compared to its siblings."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "order"@nl;
    shacl:path shacl:order
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Contactgegevens.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven of bezoeken."@nl;
    shacl:maxCount 1;
    shacl:name "adres"@nl;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#address>
  ];
  shacl:targetClass schema:ContactPoint .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#DateTimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#DateTime>;
