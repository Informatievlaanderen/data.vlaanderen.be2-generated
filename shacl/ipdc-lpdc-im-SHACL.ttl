<https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstantieSnapshotShape> a shacl:NodeShape;
  rdfs:label "InstantieSnapshot"@nl;
  <http://purl.org/vocab/vann/usageNote> "De instantiesnapshots worden door IPDC aan de hand van een linked data event stream (LDES) beschikbaar gemaakt. Deze LDES maakt de volledige historiek van alle instantie wijzigingen beschikbaar voor aansluiters. Meer info over LDES is hier beschikbaar: https://semiceu.github.io/LinkedDataEventStreams"@nl;
  rdfs:comment "Een instantiesnapshot geeft weer hoe een instantie er op een bepaald moment in tijd uitzag. Telkens wanneer een functionele wijziging aangebracht wordt zal een nieuwe instantiesnapshot aangemaakt worden. Op deze manier wordt de volledig redactie historiek van een instantie vastgelegd."@nl;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstantieSnapshot>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "generatedAtTime"@nl;
    rdfs:comment "Tijdstip waarop de snapshot van de instantie gemaakt werd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstantieSnapshot.GeneratedAtTime>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de snapshot van de instantie gemaakt werd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "generatedAtTime"@nl;
    shacl:path prov:generatedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "gearchiveerd"@nl;
    rdfs:comment "Waarde die aangeeft of de instantie gearchiveerd is."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstantieSnapshot.Gearchiveerd>;
    shacl:datatype xsd:boolean;
    shacl:description "Waarde die aangeeft of de instantie gearchiveerd is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "gearchiveerd"@nl;
    shacl:path <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#isArchived>
  ], [
    a shacl:PropertyShape;
    rdfs:label "laatstGewijzigd"@nl;
    rdfs:comment "Tijdstip waarop de instantie door een redacteur laatst werd gewijzigd."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstantieSnapshot.LaatstGewijzigd>;
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de instantie door een redacteur laatst werd gewijzigd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "laatstGewijzigd"@nl;
    shacl:path schema:dateModified
  ], [
    a shacl:PropertyShape;
    rdfs:label "productnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bij het aanmaken van een nieuwe instantie kan geen productnummer doorgegeven worden aan IPDC of LPDC. De productnummers worden beheerd door IPDC en bij creatie van een nieuwe instantie zal een uniek productnummer toegekend worden in IPDC. Hierdoor zal bij het uitlezen van IPDC steeds een productnummer beschikbaar zijn op elke instantie."@nl;
    rdfs:comment "Identificatienummer om op een unieke manier een instantie of concept te identificeren."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstantieSnapshot.Productnummer>;
    shacl:datatype xsd:string;
    shacl:description "Identificatienummer om op een unieke manier een instantie of concept te identificeren."@nl;
    shacl:maxCount 1;
    shacl:name "productnummer"@nl;
    shacl:path schema:productID
  ], [
    a shacl:PropertyShape;
    rdfs:label "creatie"@nl;
    rdfs:comment "Tijdstip waarop de instantie door een redacteur werd aangemaakt."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#InstantieSnapshot.Creatie>;
