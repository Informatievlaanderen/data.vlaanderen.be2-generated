  {
    "@id": "https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "A good example of a concept is marriage. Although the description and conditions of a marriage are largely the same for the different municipalities, there may still be local differences, such as the location and price, which can be found in the respective authorities."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The services provided by local authorities are often based on Flemish, federal or European legislation, which is translated to a local level. This means that the basis is the same for every local government, but that there may be flexibility for the local interpretation. Because we want to get and keep IPDC well stocked and up to date, with a limited administrative burden, we provide the concept. A draft is a template that editors of the Flemish government prepare for local authorities. It contains a general interpretation of a government service, which can also be applicable in most local contexts. Local authorities can consult these concepts and decide to register their own services on the basis of a concept. At that moment, a concept is cloned to an authority. The local government can then fully adapt this body and tailor it to the local context. In this way, a concept also groups together all the different local variations of a similar service."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Concept"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Concept"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
