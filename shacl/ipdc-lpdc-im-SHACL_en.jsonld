  {
    "@id": "https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#AuthorityShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Institutions are the actual interpretation of a product or service. The competent authority can vary: federal, Flemish, provincial,... And the service can be provided by another government such as a local government. A government service is a mandatory or optional set of activities that are or may be carried out by or on behalf of a public organisation, publicly funded and arising from public policy. Services may benefit an individual, an organisation or association, a company or other public authority, or groups of any of these parties. A service exists regardless of whether it is used or not. According to the revised European Interoperability Framework, a European public service includes any service provided by public authorities in Europe, or by other organisations on their behalf, to businesses, citizens or other public authorities."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Authority"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#Authority"
      }
    ],
