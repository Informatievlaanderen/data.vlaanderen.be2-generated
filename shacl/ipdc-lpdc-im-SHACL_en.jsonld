  {
    "@id": "https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshotShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "The concept snapshots are made available by IPDC on the basis of a linked data event stream (LDES). This LDES makes the full history of all concept changes available to connectors. More info about LDES is available here: https://semiceu.github.io/LinkedDataEventStreams"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A concept snapshot depicts what a concept looked like at a certain point in time. Each time a functional change is made, a new concept snapshot will be created. In this way, the complete editorial history of a concept is recorded."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "ConceptSnapshot"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://data.dev-vlaanderen.be/doc/implementatiemodel/ipdc-lpdc/ontwerpstandaard/2024-07-04#ConceptSnapshot"
      }
