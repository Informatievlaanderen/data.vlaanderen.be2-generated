    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "The instance data recordings are made available by IPDC using a linked data event stream (LDES). This LDES makes the full history of all instance changes available to connectors. More info about LDES is available here: https://semiceu.github.io/LinkedDataEventStreams"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An instance snapshot shows what an instance looked like at a particular point in time. Each time a functional change is made, a new instance snapshot will be created. In this way, the complete editorial history of an instance is recorded."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
