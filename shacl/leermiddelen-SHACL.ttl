    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <https://ec.europa.eu/esco/lod/static/model.html#Skill> .

<https://data.test-vlaanderen.be/doc/applicatieprofiel/leermiddelen/ontwerpstandaard/2025-02-24#CreatiefwerkShape> a shacl:NodeShape;
