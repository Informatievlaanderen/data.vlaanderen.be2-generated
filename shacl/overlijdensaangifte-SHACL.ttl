<https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#PubliekeDienstverlening(aanbod)Shape> a shacl:NodeShape;
  rdfs:label "Publieke Dienstverlening (Aanbod)"@nl;
  <http://purl.org/vocab/vann/usageNote> "De dienstverlening zoals beschreven door het dienstverleningsregister. Idealiter worden de attributen opgenomen op de plaats waar ze het minst verschillen per instantie."@nl;
  rdfs:comment "Een publieke dienstverlening is een geheel van verplichte of optioneel uitgevoerde of uitvoerbare acties door of in naam van een publieke organisatie. De dienstverlening is ten bate van een individu, een bedrijf, een andere publieke organisatie of groepen hiervan."@nl;
  shacl:closed false;
  shacl:targetClass <http://purl.org/vocab/cpsv#PublicService> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#PubliekeDienstverleningShape> a shacl:NodeShape;
  rdfs:label "Publieke Dienstverlening"@nl;
