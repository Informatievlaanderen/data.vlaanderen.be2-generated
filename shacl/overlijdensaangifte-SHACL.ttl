<https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#AardoverlijdenShape> a shacl:NodeShape;
  rdfs:label "AardOverlijden"@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv als attribuut ve persoon of gebouw... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres,bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "speelt rol"@nl;
    rdfs:comment "Participatie van de agent (aan een publieke dienstverlening)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#Agent.SpeeltRol>;
    shacl:class <http://data.europa.eu/m8g/Participation>;
    shacl:description "Participatie van de agent (aan een publieke dienstverlening)."@nl;
    shacl:name "speelt rol"@nl;
    shacl:path <http://data.europa.eu/m8g/playsRole>
  ];
  shacl:targetClass dc:Agent .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#ApgarscoreShape> a shacl:NodeShape;
  rdfs:label "Apgarscore"@nl;
  rdfs:comment "Snelle beoordeling die onmiddellijk na de geboorte wordt uitgevoerd om de fysieke conditie van een pasgeborene te evalueren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "periode"@nl;
    rdfs:comment "De tijdsduur van de meting voor de Apgarscore."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#Apgarscore.Periode>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "De tijdsduur van de meting voor de Apgarscore."@nl;
    shacl:maxCount "1";
    shacl:name "periode"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#periode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "score"@nl;
    rdfs:comment "Een score van 0 tot 10 waarbij 5 aspecten van de pasgeborene worden beoordeeld (hartslag, ademhaling, spiertonus, reflexen en huidskleur)."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#Apgarscore.Score>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Een score van 0 tot 10 waarbij 5 aspecten van de pasgeborene worden beoordeeld (hartslag, ademhaling, spiertonus, reflexen en huidskleur)."@nl;
    shacl:maxCount "1";
    shacl:name "score"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#Apgarscore.score>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/gezondheidstoestand#Apgarscore> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#ArtsShape> a shacl:NodeShape;
  rdfs:label "Arts"@nl;
  rdfs:comment "Een Persoon met de officiële bevoegdheid om de geneeskunde uit te oefenen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    rdfs:comment "Een identificatie dat van toepassing is op deze persoon in deze rol."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#Arts.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Een identificatie dat van toepassing is op deze persoon in deze rol."@nl;
    shacl:maxCount "1";
    shacl:name "registratie"@nl;
    shacl:path <https://hl7.org/fhir/practitioner-definitions.html#Practitioner.identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Het type Arts die betrokken is bij de MedischeObservatie."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#Arts.Type>;
    shacl:class skos:Concept;
    shacl:description "Het type Arts die betrokken is bij de MedischeObservatie."@nl;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "wordt geobserveerd door"@nl;
    rdfs:comment "Wie was verantwoordelijk voor het vaststellen van de waargenomen waarde als \"waar\"?"@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#Arts.WordtGeobserveerdDoor>;
    shacl:class <https://build.fhir.org/observation-definitions.html#Observation>;
    shacl:description "Wie was verantwoordelijk voor het vaststellen van de waargenomen waarde als \"waar\"?"@nl;
    shacl:name "wordt geobserveerd door"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#wordtGeobserveerdDoor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "stelt op"@nl;
    rdfs:comment "De Arts stelt een Medisch Verslag op."@nl;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#Arts.SteltOp>;
    shacl:class <https://www.hl7.org/fhir/diagnosticreport-definitions.html#DiagnosticReport>;
    shacl:description "De Arts stelt een Medisch Verslag op."@nl;
    shacl:name "stelt op"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#steltOp>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/gezondheidstoestand#Arts> .

<https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#ArtstypeShape> a shacl:NodeShape;
  rdfs:label "ArtsType"@nl;
