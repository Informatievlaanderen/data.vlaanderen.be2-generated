    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/applicatieprofiel/overlijdensaangifte/erkendestandaard/2024-12-05#Gebeurtenis.Tijdschema>;
    shacl:class schemas:Schedule;
    shacl:description "Schema volgens hetwelk een gebeurtenis zich herhaalt."@nl;
    shacl:name "tijdschema"@nl;
    shacl:path schemas:eventSchedule
  ];
  shacl:targetClass schemas:Event .

