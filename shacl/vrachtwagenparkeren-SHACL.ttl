    shacl:description "Naam van de aanvullende dienst."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv ticketing, wachtaccomodatie, sanitair, AED…"@nl;
    rdfs:comment "Aard van de aanvullende dienst."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/vrachtwagenparkeren/ontwerpstandaard/2023-11-30#Aanvullendedienst.Type>;
