  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/vrachtwagenparkeren#Bestuurder> .

<https://data.vlaanderen.be/doc/applicatieprofiel/vrachtwagenparkeren/ontwerpstandaard/2023-11-30#BoekingShape> a shacl:NodeShape;
  rdfs:label "Boeking"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bv het aankopen van een treinticket of het reserveren van een zitplaats op de trein."@nl;
  rdfs:comment "Het vastleggen van een Reis door aankoop van een Vervoersbewijs en/of het reserveren van een Resource."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit tijdstip ligt typisch voor het vertrektijdstip van de Reis."@nl;
    rdfs:comment "Tijdstip waarop de Boeking is gebeurd."@nl;
