    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Boeking.status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "reis"@nl;
    rdfs:comment "Reis die geboekt wordt."@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/vrachtwagenparkeren/ontwerpstandaard/2023-11-30#Boeking.Reis>;
    shacl:class schemas:Trip;
