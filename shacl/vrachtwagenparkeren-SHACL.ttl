    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aanbieder"@nl;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/vervoersknooppunten#aanbieder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beschikbaarOpInfrastructuurelement"@nl;
    rdfs:comment "TODO"@nl;
    rdfs:seeAlso <https://data.vlaanderen.be/doc/applicatieprofiel/vrachtwagenparkeren/ontwerpstandaard/2023-11-30#Aanvullendedienst.Beschikbaaropinfrastructuurelement>;
