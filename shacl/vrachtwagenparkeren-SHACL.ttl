    shacl:minCount "1";
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegankelijkheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bv of de Mobiliteitsdienst toegankelijk is voor personen met een beperking."@nl;
    rdfs:comment "Toegankelijkheid van de aanvullende dienst."@nl;
