@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#> rdfs:member <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ProblemDetailShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ExceptionShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#AnnotationShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#RoadVignetteRegistrationShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#VehicleShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#RoadVignetteRegistrationEnvelopeShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#LicensePlateShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#EngineSpecificationShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#RegistrationShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#StringShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#UriShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#IntegerShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#StructuredIdentifierShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#DateTimeShape>,
