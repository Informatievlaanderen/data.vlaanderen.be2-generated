<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#RoadVignetteRegistrationShape> a shacl:NodeShape;
  rdfs:label "Road vignette registration"@en;
  <http://purl.org/vocab/vann/usageNote> "Refers to the Registration of the Vehicle in the national register."@en;
  rdfs:comment "Registration of a Vehicle for a road vignette, which entitles the vehicle to use the road network for a certain period of time."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#RoadVignetteRegistration>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "registrationDate"@en;
    rdfs:comment "Time at which the Road Vignette Registration was drawn up."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#RoadVignetteRegistration.RegistrationDate>;
    shacl:datatype xsd:date;
    shacl:description "Time at which the Road Vignette Registration was drawn up."@en;
    shacl:maxCount 1;
    shacl:name "registrationDate"@en;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasVehicle registration"@en;
    rdfs:comment "The Registration of the Vehicle to which the Road Vignette Registration applies."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#RoadVignetteRegistration.HasVehicleRegistration>;
    shacl:class <https://data.vlaanderen.be/ns/voertuigregistratie#Registratie>;
    shacl:description "The Registration of the Vehicle to which the Road Vignette Registration applies."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "hasVehicle registration"@en;
    shacl:path <https://data.vlaanderen.be/ns/voertuigregistratie#heeftVoertuigregistratie>
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/magda/wegenvignetregistratie#Wegenvignetregistratie> .

