<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#VehicleShape> a shacl:NodeShape;
  rdfs:label "Vehicle"@en;
  rdfs:comment "A vehicle is a device designed or used to transport people or cargo by land, water, air, or space."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Vehicle>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "FirstRegistrationDate"@en;
    rdfs:comment "First date on which the vehicle was registered in a register."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Vehicle.FirstRegistrationDate>;
    shacl:datatype xsd:date;
    shacl:description "First date on which the vehicle was registered in a register."@en;
    shacl:maxCount 1;
    shacl:name "FirstRegistrationDate"@en;
    shacl:path schemas:dateVehicleFirstRegistered
  ], [
    a shacl:PropertyShape;
    rdfs:label "emission standard"@en;
    <http://purl.org/vocab/vann/usageNote> "For example: Euro 6d. The value comes from a code list, so that other or future emission standards than the Euro standard can also be expressed."@en;
    rdfs:comment "The emission standard that the Vehicle meets."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Vehicle.EmissionStandard>;
    shacl:description "The emission standard that the Vehicle meets."@en;
    shacl:maxCount 1;
    shacl:name "emission standard"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path schemas:meetsEmissionStandard
  ], [
    a shacl:PropertyShape;
    rdfs:label "Vin"@en;
    rdfs:comment "The Vehicle Identification Number (VIN) is a unique serial number that has been used in the automotive industry to distinguish individual vehicles from each other."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Vehicle.Vin>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "The Vehicle Identification Number (VIN) is a unique serial number that has been used in the automotive industry to distinguish individual vehicles from each other."@en;
    shacl:maxCount 1;
    shacl:name "Vin"@en;
    shacl:path schemas:vehicleIdentificationNumber
  ], [
    a shacl:PropertyShape;
    rdfs:label "vehicleEngine"@en;
    rdfs:comment "The engine or engines of the Vehicle."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Vehicle.VehicleEngine>;
    shacl:class schemas:EngineSpecification;
    shacl:description "The engine or engines of the Vehicle."@en;
    shacl:name "vehicleEngine"@en;
    shacl:path schemas:vehicleEngine
  ];
  shacl:targetClass schemas:Vehicle .
