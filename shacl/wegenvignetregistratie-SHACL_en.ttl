    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#EuroStandardShape>,
    <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#EngineTypeShape> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#AnnotationShape> a shacl:NodeShape;
  rdfs:label "Annotation"@en;
  rdfs:comment "Detailed information that is provided with an Exception."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Annotation>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Name"@en;
    rdfs:comment "Name of the field."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Annotation.Name>;
    shacl:datatype xsd:string;
    shacl:description "Name of the field."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Name"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "Value"@en;
    rdfs:comment "The value of the field."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Annotation.Value>;
    shacl:datatype xsd:string;
    shacl:description "The value of the field."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Value"@en;
    shacl:path rdf:value
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/generiek#Annotatie> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ConceptShape> shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Code"@en;
    rdfs:comment "Code that indicates the concept within the code list."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Concept.Code>;
    shacl:description "Code that indicates the concept within the code list."@en;
    shacl:maxCount 1;
    shacl:name "Code"@en;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "preferred name"@en;
    rdfs:comment "Name by which the concept is preferably indicated."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Concept.PreferredName>;
    shacl:datatype rdf:langString;
    shacl:description "Name by which the concept is preferably indicated."@en;
    shacl:maxCount 1;
    shacl:name "preferred name"@en;
    shacl:path skos:prefLabel
  ] .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#DateShape> a shacl:NodeShape;
  rdfs:label "Date";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Date>;
  shacl:closed false;
  shacl:targetClass xsd:date .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#DateTimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#DateTime>;
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#EngineSpecificationShape> a shacl:NodeShape;
  rdfs:label "Engine Specification"@en;
  <http://purl.org/vocab/vann/usageNote> "An engine specification corresponds to one registered engine in the source and not necessarily to one physical engine. One engine specification can describe a combination of an internal combustion engine and an electric motor, for example in a hybrid vehicle. The number of engine specifications of a vehicle is therefore not a reliable indication of the actual number of engines."@en;
  rdfs:comment "Information about the engine or engines of a Vehicle."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#EngineSpecification>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "FuelType"@en;
    <http://purl.org/vocab/vann/usageNote> "The value comes from the Fuel Type code list, which adopts the IVI fuel codes. An engine specification can have multiple fuel types, for example, gasoline and LPG."@en;
    rdfs:comment "The type of fuel that is suitable for the vehicle's engine(s)."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#EngineSpecification.FuelType>;
    shacl:description "The type of fuel that is suitable for the vehicle's engine(s)."@en;
    shacl:name "FuelType"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path schemas:fuelType
  ], [
    a shacl:PropertyShape;
    rdfs:label "motorType"@en;
    <http://purl.org/vocab/vann/usageNote> "The value comes from the code list Engine type: combustion engine or electric motor. An engine Specification can have multiple engine Types to indicate that one registered engine Specification actually relates to multiple physical engines. Also, the engine type may also be missing if it cannot be deduced from the source."@en;
    rdfs:comment "The type of engine or motors that drive the vehicle."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#EngineSpecification.MotorType>;
    shacl:description "The type of engine or motors that drive the vehicle."@en;
    shacl:name "motorType"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path schemas:engineType
  ];
  shacl:targetClass schemas:EngineSpecification .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ExceptionShape> a shacl:NodeShape;
  rdfs:label "Exception"@en;
  <http://purl.org/vocab/vann/usageNote> "For example: new INSZ number at the National Register."@en;
  rdfs:comment "Exception shows non-critical issues when exchanging."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Exception>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Date"@en;
    rdfs:comment "The date the Exception was created."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Exception.Date>;
    shacl:datatype xsd:dateTime;
    shacl:description "The date the Exception was created."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Date"@en;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "Diagnosis"@en;
    rdfs:comment "A description of why the Exception was created."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Exception.Diagnosis>;
    shacl:datatype xsd:string;
    shacl:description "A description of why the Exception was created."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Diagnosis"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "Origin"@en;
    <http://purl.org/vocab/vann/usageNote> "Intended to organize knowledge, for example: in a code list or taxonomy (a so-called ConceptScheme). See <a href=\"https://www.w3.org/TR/skos-reference/\">SKOS</a> for more information."@en;
    rdfs:comment "The entity that created the Exception."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Exception.Origin>;
    shacl:description "The entity that created the Exception."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Origin"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:source
  ], [
    a shacl:PropertyShape;
    rdfs:label "Type"@en;
    rdfs:comment "The kind of Exception."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Exception.Type>;
    shacl:description "The kind of Exception."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Type"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "Circumstance"@en;
    <http://purl.org/vocab/vann/usageNote> "The error code of the source that led to the Exception."@en;
    rdfs:comment "The circumstances in which the Exception was created."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Exception.Circumstance>;
    shacl:description "The circumstances in which the Exception was created."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Circumstance"@en;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "Annotation"@en;
    rdfs:comment "Reference to annotations associated with the Exception."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Exception.Annotation>;
    shacl:class <https://implementatie.data.vlaanderen.be/ns/generiek#Annotatie>;
    shacl:description "Reference to annotations associated with the Exception."@en;
    shacl:name "Annotation"@en;
    shacl:path dc:hasPart
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/generiek#Uitzondering> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#IdentifierShape> a shacl:NodeShape;
  rdfs:label "Identifier"@en;
  <http://purl.org/vocab/vann/usageNote> "The starting point here is that this string is assigned by an organization and that this is done according to a specific system."@en;
  rdfs:comment "Information used to uniquely identify an object."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Identifier>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Identifier"@en;
    <http://purl.org/vocab/vann/usageNote> "Type of the string refers to the identification system (including its version), the string itself to the actual identifier."@en;
    rdfs:comment "String used to uniquely identify the object."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Identifier.Identifier>;
    shacl:description "String used to uniquely identify the object."@en;
    shacl:maxCount 1;
    shacl:name "Identifier"@en;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "structuredIdentifier"@en;
    rdfs:comment "Identifier of the object broken down into its parts."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Identifier.StructuredIdentifier>;
    shacl:class <https://data.vlaanderen.be/ns/generiek#GestructureerdeIdentificator>;
    shacl:description "Identifier of the object broken down into its parts."@en;
    shacl:maxCount 1;
    shacl:name "structuredIdentifier"@en;
    shacl:path <https://data.vlaanderen.be/ns/generiek#gestructureerdeIdentificator>
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#IntegerShape> a shacl:NodeShape;
  rdfs:label "Integer";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Integer>;
  shacl:closed false;
  shacl:targetClass xsd:integer .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#LangStringShape> a shacl:NodeShape;
  rdfs:label "LangString";
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#LangString>;
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#LicensePlateShape> a shacl:NodeShape;
  rdfs:label "License plate"@en;
  <http://purl.org/vocab/vann/usageNote> "Issued by the authority competent for the registration of the Vehicle."@en;
  rdfs:comment "Physical carrier of the registration number of the Vehicle."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#LicensePlate>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "Registration number"@en;
    rdfs:comment "The number by which the vehicle is known to the registry."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#LicensePlate.RegistrationNumber>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "The number by which the vehicle is known to the registry."@en;
    shacl:maxCount 1;
    shacl:name "Registration number"@en;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/voertuigregistratie#Nummerplaat> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ProblemDetailShape> a shacl:NodeShape;
  rdfs:label "Problem detail"@en;
  <http://purl.org/vocab/vann/usageNote> "This is in addition to an HTTP status code, for example with a 400 (Bad request) status code to indicate why the request was bad. Based on <a href=\"https://www.rfc-editor.org/rfc/rfc7807\">RFC7807</a>."@en;
  rdfs:comment "More detailed description of the error in an HTTP response."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ProblemDetail>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "detail"@en;
    rdfs:comment "Human-readable description of the error."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ProblemDetail.Detail>;
    shacl:datatype xsd:string;
    shacl:description "Human-readable description of the error."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "detail"@en;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "instance"@en;
    <http://purl.org/vocab/vann/usageNote> "For example: the reference to the request."@en;
    rdfs:comment "Reference to the instance of the object to which the error relates."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ProblemDetail.Instance>;
    shacl:datatype xsd:anyURI;
    shacl:description "Reference to the instance of the object to which the error relates."@en;
    shacl:maxCount 1;
    shacl:name "instance"@en;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "Status"@en;
    <http://purl.org/vocab/vann/usageNote> "As described in <a href=\"https://www.rfc-editor.org/rfc/rfc7231\">RFC7231</a>. For example: 404 for \"Not Found\"."@en;
    rdfs:comment "HTTP error code."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ProblemDetail.Status>;
    shacl:datatype xsd:integer;
    shacl:description "HTTP error code."@en;
    shacl:maxCount 1;
    shacl:name "Status"@en;
    shacl:path <http://www.w3.org/ns/adms#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Title"@en;
    rdfs:comment "Short human-readable description of the error."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ProblemDetail.Title>;
    shacl:datatype xsd:string;
    shacl:description "Short human-readable description of the error."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Title"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "Type"@en;
    rdfs:comment "Nature of the error."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#ProblemDetail.Type>;
    shacl:datatype xsd:anyURI;
    shacl:description "Nature of the error."@en;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "Type"@en;
    shacl:path dc:type
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/generiek#Problemdetail> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#RegistrationShape> a shacl:NodeShape;
  rdfs:label "Registration"@en;
  <http://purl.org/vocab/vann/usageNote> "The Vehicle is given a registration number and is linked to a Person or Organisation (whether or not the owner of the Vehicle). The date from which the registration is valid will be determined. The registration number is displayed on a License plate."@en;
  rdfs:comment "Registration of a Vehicle in a national register."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Registration>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "License plate"@en;
    rdfs:comment "A physical medium that contains the registration number of the vehicle under which the vehicle was registered."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Registration.LicensePlate>;
    shacl:class <https://data.vlaanderen.be/ns/voertuigregistratie#Nummerplaat>;
    shacl:description "A physical medium that contains the registration number of the vehicle under which the vehicle was registered."@en;
    shacl:maxCount 1;
    shacl:name "License plate"@en;
    shacl:path <https://data.vlaanderen.be/ns/voertuigregistratie#nummerplaat>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vehicle"@en;
    rdfs:comment "The vehicle that is linked to the Registration Certificate."@en;
    rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Registration.Vehicle>;
    shacl:class schemas:Vehicle;
    shacl:description "The vehicle that is linked to the Registration Certificate."@en;
    shacl:maxCount 1;
    shacl:name "vehicle"@en;
    shacl:path <https://data.vlaanderen.be/ns/voertuigregistratie#voertuig>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/voertuigregistratie#Registratie> .

<https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#RoadVignetteRegistrationEnvelopeShape> a shacl:NodeShape;
  rdfs:label "Road vignetteRegistrationEnvelope"@en;
  <http://purl.org/vocab/vann/usageNote> "Follow the REST guidelines of Digital Flanders when using this class within VDIP."@en;
  rdfs:comment "Envelope to exchange road vignette registrations and corresponding validation warning."@en;
  rdfs:seeAlso <https://data.dev-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#RoadVignetteRegistrationEnvelope>;
  shacl:closed false;
